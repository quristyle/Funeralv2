{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ============================================================
  // [AI 공급자]
  //
  // 사용자가 환경설정에서 고른 값(jsini · groq)이 요청마다 넘어온다.
  // 로컬 LLM 장비가 자주 꺼져 있어서, 그때 Groq 로 옮겨 쓸 수 있게 둘을 둔다.
  //
  // **키는 이 파일에 넣지 않는다** — appsettings.Local.json 에만 둔다(결정 D1-B).
  // 고친 뒤에는 재기동해야 반영된다(기동 시 한 번만 읽는다).
  // ============================================================
  "AI": {
    // 화면이 값을 안 보낼 때, 그리고 헬스체크가 대표로 볼 공급자.
    "DefaultProvider": "jsini",

    // [접속까지 기다리는 시간]
    //
    // **장비가 꺼져 있을 때 빨리 포기하는 값이다.** 이 설정이 없던 동안에는
    // 운영체제 재시도에 맡겨져, 로컬 LLM 이 꺼져 있으면 21초를 기다린 뒤 실패했다.
    //
    // 연결이 맺어진 뒤에는 적용되지 않는다 — 짧게 잡아도 오래 걸리는 생성이
    // 끊기지 않는다. 그래서 공급자별로 나누지 않았다. 살아 있는 상대는
    // 로컬이든 Groq 든 1초 안에 붙는다.
    //
    // 0 이나 음수를 넣으면 끈다(운영체제 기본에 맡긴다).
    "ConnectTimeoutSeconds": 5,

    // [자동 전환] 결정 D-A3 — 켜기로 정했다.
    //
    // 넘기는 경우는 **둘**이다. 공통점은 "여기서는 더 해 볼 것이 없다" 는 것 —
    // 넘기지 않아도 어차피 실패하므로 넘겨서 잃을 것이 없다.
    //   · 접속 실패          — 상대가 아예 없다(장비 꺼짐 · 주소 오류 · DNS).
    //   · 계정 전체 하루 한도(429) — 기다려도 날짜가 바뀌어야 풀리고, 모델을 바꿔도
    //                          같은 한도를 쓴다. 아래 층의 모델 바꿔치기가 구제하지
    //                          못하는 유일한 429 다.
    //
    // 넘기지 않는 경우:
    //   · 생성 시간 초과     — 느린 답 하나가 양쪽 예산을 다 쓴다.
    //   · 모델 하나가 붐비는 429 — 같은 공급자의 다른 무료 모델은 멀쩡하다.
    //                          공급자가 아니라 **모델을 바꿔** 다시 부른다(FallbackModels).
    //   · 인증 실패(401)     — 설정 문제다. 넘기면 키가 틀렸다는 사실이 안 드러난다.
    //   · 그 밖의 HTTP 오류   — 상대가 응답은 하고 있다. 접속 문제가 아니다.
    //
    // 429 를 두 갈래로 나누는 판단은 공급자가 준 문구로 한다. **확실하지 않으면
    // '모델 한 개' 로 본다** — 그래야 틀렸을 때 잃는 것이 적다.
    //
    // 넘길 수 있는 상대는 **설정이 끝났고 AllowAutoFailover 가 켜진 공급자**뿐이다.
    // 앞은 키를 안 넣은 곳으로 넘기면 '접속 실패' 가 '설정 미완' 으로 바뀌기만 해서고,
    // 뒤는 **돈이 드는 공급자(anthropic)로 조용히 새지 않게** 하기 위해서다.
    //
    // 전환되면 조용히 지나가지 않는다 — 로그에 남고, 스트리밍 답 앞에 한 줄이 붙고,
    // 상태 화면의 AI 공급자 블록에 '최근 자동 전환' 으로 뜬다.
    //
    // 상태 화면의 '정밀 확인' 은 이 설정과 무관하게 전환하지 않는다(진단이므로).
    "FailoverOnConnectFailure": true,
    "Providers": {
      // 로컬 LLM. 이 저장소가 원래 쓰던 것이다.
      //
      // 여기를 비워 두면 아래 옛 `LLM:*` 설정을 그대로 읽는다 — 각 개발 PC 의
      // appsettings.Local.json 을 한꺼번에 고칠 수 없어서 되받기를 남겨 두었다.
      //
      // TimeoutSeconds 는 **생성에 걸리는 시간**이다(접속 실패는 위 ConnectTimeout).
      // 로컬 LLM 은 모델을 메모리에 올리는 데만 수십 초가 걸릴 수 있어 넉넉히 둔다.
      // 짧게 잡으면 정상적으로 오래 걸리는 생성이 끊긴다.
      "jsini": {
        "DisplayName": "JSINI (로컬 LLM)",
        "ApiBase": "",
        "ApiKey": "",
        "Model": "",
        "MaxTokens": 2000,
        "TimeoutSeconds": 120,
        // 사내 장비라 한도가 없다. 자르지 않는다(0 = 무제한).
        "MaxHistoryChars": 0
      },

      // Groq 무료 플랜. 서버에 모델을 설치하지 않아도 되고 무료 한도 안에서 쓴다.
      //
      // [과금되지 않는 근거]
      // 무료 플랜은 결제 수단을 등록하지 않는다. 자동 상향(업그레이드)도 없다 —
      // 유료(Developer)로 올리려면 사람이 결제 수단을 등록하고 직접 올려야 한다.
      // 한도를 넘으면 과금이 아니라 429 로 차단된다. 즉 **'결제 수단을 등록하지
      // 않는 것' 이 과금을 막는 장치**이고, 코드가 보장할 수 있는 일이 아니다.
      //
      // [키]
      // https://console.groq.com/keys 에서 만들어 appsettings.Local.json 에 넣는다.
      // 이 파일에는 자리표시자만 둔다. 자리표시자가 그대로면 부르지 않고
      // '설정이 완료되지 않았습니다' 로 알려 준다(401 로 오해하지 않도록).
      //
      // [모델]
      // openai/gpt-oss-20b 는 처리량이 가장 커서 분당 토큰(TPM) 한도에 잘 걸리지 않는다.
      // 품질을 올리려면 openai/gpt-oss-120b · llama-3.3-70b-versatile 로 바꾼다.
      // 현재 목록: https://console.groq.com/docs/models
      //
      // [MaxTokens]
      // 무료 한도는 분당 토큰으로도 걸린다. 한 답에 크게 잡으면 그 한 번으로
      // 한도를 다 써서 다음 요청이 곧바로 막힌다. 로컬 LLM 보다 낮게 둔다.
      //
      // [MaxRequestsPerDay]
      // 0 이면 우리 쪽에서는 세지 않는다(기본). 공급자의 한도만 적용된다.
      // 숫자를 넣으면 그 횟수에서 우리가 먼저 막는다 — 무료 한도를 다 태워
      // 정작 필요할 때 못 쓰는 것을 줄이는 용도다.
      "groq": {
        "DisplayName": "Groq Free",
        "ApiBase": "https://api.groq.com/openai/v1/chat/completions",
        "ApiKey": "__SET_IN_appsettings.Local.json__",
        "Model": "openai/gpt-oss-20b",
        "MaxTokens": 1024,
        // 클라우드라 로컬처럼 모델 로드를 기다릴 일이 없다. 실측 0.5~0.8초다.
        "TimeoutSeconds": 60,
        "MaxRequestsPerDay": 0,

        // [지난 대화를 몇 글자까지 함께 보낼지]
        //
        // 기록을 보내는 것 자체는 뺄 수 없다 — 이 API 는 상태를 저장하지 않으므로
        // messages 배열이 문맥의 전부다. 보내지 않으면 대화가 이어지지 않는다.
        //
        // **여기만 값을 넣은 이유** — Groq 무료는 분당 토큰(TPM)으로 막힌다.
        // 답 하나에 MaxTokens(1024)를 쓰는데 기록까지 크면 한 번에 분당 몫을
        // 다 태우고 다음 질문이 곧바로 막힌다. 그래서 줄이는 것이 바로 효과가 있다.
        //
        // OpenRouter 는 하루 '요청 수' 가 한도이고 문맥은 수십만 토큰이 들어가므로
        // 줄여도 얻는 것이 없어 0(무제한)으로 둔다. 로컬도 한도가 없어 0 이다.
        //
        // 4000자면 한국어로 대략 대여섯 턴이다. 지시(system)와 지금 물어본 질문은
        // 예산과 무관하게 반드시 보낸다. 자른 사실은 화면에 한 줄로 알린다.
        "MaxHistoryChars": 4000
      },

      // OpenRouter — 무료 모델만 쓴다.
      //
      // [Groq 와 다른 점 · 그래서 장치가 하나 더 있다]
      // Groq 무료 플랜은 결제 수단이 없으면 애초에 청구될 곳이 없다.
      // OpenRouter 는 **같은 API 로 유료 모델도 부를 수 있다.** 모델 이름 하나만
      // 잘못 들어가면 과금 대상 호출이 되고, 여기서는 사용자가 모델을 고르므로
      // 그 값은 믿을 수 없는 입력이다. 그래서 서버가 두 겹으로 막는다.
      //
      //   1. RequireFreeModel — 부르기 전에 확인한다(FreeModelGuard).
      //      · 이름이 ':free' 로 끝나야 하고,
      //      · 카탈로그의 pricing.prompt / completion 이 둘 다 0 이어야 한다.
      //      둘 다 요구하는 이유: 실측(2026-08-27, 417개)에서 ':free' 17개는 전부
      //      실제 무료였지만, **가격 0 인데 접미사가 없는 것이 3개** 있었고 그중
      //      'openrouter/free' 는 자동 라우터다 — 어디로 갈지 알 수 없어 뺀다.
      //
      //   2. 요청 본문의 provider 조건 — 공급자 쪽에서 한 번 더 막는다.
      //      · max_price 를 전부 0 으로 보낸다(백만 토큰당 허용 단가).
      //      · allow_fallbacks 를 끈다. **OpenRouter 기본값이 true** 라서
      //        고른 경로가 막히면 알아서 다른 제공자로 넘기고, 그쪽이 무료라는
      //        보장이 없다. 이것을 끄지 않으면 1번이 무의미해진다.
      //
      // [계정 쪽]
      // 크레딧을 넣지 않고 자동 충전을 켜지 않는다. 잔액이 0 이면 유료 모델은
      // 402 로 막힌다. Groq 와 같은 원칙 — **결제 수단을 두지 않는 것이 최종 방어선**이다.
      //
      // [키] https://openrouter.ai/keys 에서 만들어 appsettings.Local.json 에 넣는다.
      //
      // [무료 한도] 무료 모델은 분당 20회 · 하루 50회(크레딧 $10 미만 기준).
      //
      // [모델] 사용자가 환경설정에서 고른다(AllowModelChoice). 여기 Model 은
      // 고른 값이 없거나 그 모델이 무료 목록에서 사라졌을 때 쓰는 기본값이다.
      "openrouter": {
        "DisplayName": "OpenRouter Free",
        "ApiBase": "https://openrouter.ai/api/v1/chat/completions",
        "ApiKey": "__SET_IN_appsettings.Local.json__",
        // 기본 모델은 **실제로 응답하는 것**으로 둬야 한다. 무료 모델은 상류 제공자가
        // 자주 붐벼서(429 "temporarily rate-limited upstream") 이름만 무료인 것과
        // 실제로 쓸 수 있는 것이 다르다.
        //
        // 2026-08-27 실측 — minimax-m3 는 한국어로 깔끔하게 답했고(GMICloud),
        // gemma-4-31b-it:free · gemma-4-26b-a4b-it:free · glm-5.2:free 는 계속 429,
        // thinkingmachines/inkling:free 는 403 이었다.
        "Model": "minimax/minimax-m3:free",
        "ModelCatalogUrl": "https://openrouter.ai/api/v1/models",
        "RequireFreeModel": true,
        "AllowModelChoice": true,

        // [한도에 걸렸을 때 대신 쓸 모델 — 적힌 순서대로]
        //
        // 사용자가 고른 모델을 **반드시 먼저** 부른다. 그 모델이 429(한도)를 주면
        // 이 목록의 다음 모델로 바꿔 다시 부른다. 답이 나오면 거기서 멈춘다.
        //
        // 왜 카탈로그를 그냥 훑지 않는가 — 지금 무료 모델은 17개인데 **서로 대체할 수
        // 있는 것이 아니다.** 코드 전용(north-mini-code), 안전성 분류
        // (nemotron-3.5-content-safety), 음악 생성이 섞여 있다. 한도에 걸렸다고
        // 분류 모델로 넘기면 답은 나오지만 **쓸 수 없는 답**이 나온다.
        // 조용히 그렇게 되는 것이 "한도 초과" 라고 말하는 것보다 나쁘다.
        //
        // 순서는 2026-08-27 실측을 따랐다 — minimax-m3 가 한국어로 깔끔하게 답했고,
        // nemotron-3-super 는 답하지만 생각 과정이 섞여 나온다. gemma 계열과 glm 은
        // 그날 계속 429 였으므로 뒤에 둔다(혼잡은 시간이 지나면 풀린다).
        //
        // **이 목록을 비우면 바꿔치기를 하지 않는다** — 예전처럼 한도 초과로 끝난다.
        // 즉 이 기능은 설정으로 켜고 끈다.
        //
        // 여기 유료 모델을 잘못 적어도 과금되지 않는다 — RequireFreeModel 이 켜져 있어
        // 부르기 전에 무료 확인(FreeModelGuard)을 다시 통과해야 한다.
        "FallbackModels": [
          "minimax/minimax-m3:free",
          "nvidia/nemotron-3-super-120b-a12b:free",
          "minimax/minimax-m2.7:free",
          "google/gemma-4-31b-it:free",
          "z-ai/glm-5.2:free"
        ],

        // [한 번의 질문에 시도할 모델 수의 상한 — 첫 모델을 포함한다]
        //
        // **시도마다 실제 요청이 나간다.** OpenRouter 무료는 하루 요청 수로도 한도가
        // 걸리므로(50회), 한 번 물어본 것이 5번의 호출이 되면 하루 몫을 다섯 배로
        // 태운다. 사람도 막힌 모델마다 왕복 시간을 기다린다.
        "MaxModelAttempts": 3,

        "MaxTokens": 1024,
        "TimeoutSeconds": 60,
        "MaxRequestsPerDay": 0,

        // 한도가 '하루 요청 수' 이고 문맥은 수십만 토큰이 들어간다. 줄여도 얻는 것이
        // 없으므로 자르지 않는다(0 = 무제한).
        "MaxHistoryChars": 0
      },

      // Gemini 무료 등급 — Google.
      //
      // [설정만으로 붙는다 — 새 코드가 없다]
      // Claude 를 붙일 때는 Messages API 라 전송기(AnthropicTransport)를 따로 만들어야
      // 했지만, Gemini 는 **OpenAI 호환 엔드포인트**를 제공한다. 주소·키·모델 세 줄이면
      // 기존 경로(로컬 LLM · Groq · OpenRouter 와 같은 길)로 그대로 나간다.
      // 그래서 `Protocol` 을 적지 않는다 — 기본값 openai 가 맞다.
      //
      // [과금되지 않는 근거 — Groq 와 같은 모양이다]
      // 신규 계정은 Free Tier 에서 시작하고, 한도를 넘으면 **과금이 아니라 막힌다.**
      // 유료로 가려면 사람이 직접 결제 계정을 연결하고 크레딧을 넣어야 한다.
      // 즉 여기서도 '결제 수단을 등록하지 않는 것' 이 과금을 막는 장치다.
      // (Anthropic 만 무료 등급이 없어서 예외다 — 그쪽 항목의 설명 참고.)
      //
      // [키] https://aistudio.google.com/apikey 에서 만든다.
      //   · **무료 등급 프로젝트의 키**를 쓴다. 결제 계정을 연결한 프로젝트의 키를
      //     넣으면 유료 등급으로 나간다 — 키가 등급을 정하지, 모델 이름이 정하지 않는다.
      //   · Google AI Pro/Ultra 구독으로는 안 된다. 그 구독이 올려 주는 것은
      //     AI Studio 웹 화면의 할당량뿐이고 API 는 별개 청구다.
      "gemini": {
        "DisplayName": "Gemini Free",
        "ApiBase": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "ApiKey": "__SET_IN_appsettings.Local.json__",

        // [모델] 2026-09-13 실측. 아래 다섯 개 모두 한국어로 정확히 답했다.
        //
        //   gemini-3.8-flash       3.0초   ← 기본값 (가장 똑똑한 Flash)
        //   gemini-3.7-flash       1.7초
        //   gemini-3.6-flash       2.8초
        //   gemini-3.5-flash       1.8초
        //   gemini-3.5-flash-lite  1.1초   ← 가장 빠름
        //
        // **2.5 · 2.0 계열은 쓸 수 없다.** 404 와 함께 "no longer available to new
        // users" 를 준다 — 새 프로젝트에는 아예 열리지 않는다. 이름만 보고 옛 모델을
        // 적으면 인증이 아니라 모델에서 막힌다.
        //
        // 속도보다 품질을 택했다. 무료 등급을 묶는 것은 **하루 요청 수**라서
        // 몇 초 빠른 것이 한도를 아껴 주지 않는다. 응답이 급하면 flash-lite 로 바꾼다.
        //
        // 계정마다 열린 모델이 다를 수 있다. 확인은 여기서:
        //   https://aistudio.google.com/rate-limit
        "Model": "gemini-3.8-flash",

        // [한도에 걸렸을 때 대신 쓸 모델 — 적힌 순서대로]
        //
        // **무료 여부를 확인하고 넣은 것이 아니다.** OpenRouter 와 달리 Gemini 는
        // 무료 여부가 모델 이름이 아니라 **키(프로젝트 등급)**에 달려 있어서,
        // 무료 키로 부르면 목록에 무엇이 있든 과금되지 않는다 — 없는 모델이면
        // 그냥 오류가 난다.
        //
        // 계정에서 열리지 않은 모델은 429 가 아니라 404/400 을 주므로 **바꿔치기가
        // 일어나지 않고 그대로 실패한다.** 그래서 2026-09-13 에 실제로 답한 것만 적었다.
        // 순서는 위 실측표와 같다(품질 → 속도).
        "FallbackModels": [
          "gemini-3.8-flash",
          "gemini-3.7-flash",
          "gemini-3.6-flash",
          "gemini-3.5-flash-lite"
        ],

        // 무료 확인을 **끈다.** 이 값은 OpenRouter 전용이다 — 한 주소에 무료·유료
        // 모델이 섞여 있어 카탈로그 가격을 보고 걸러야 하는 경우에만 켠다.
        // Gemini 는 키가 등급을 정하므로 카탈로그를 봐도 얻는 것이 없다.
        "RequireFreeModel": false,

        // 사용자가 고르지 못하게 둔다. 무료 등급에서 열린 모델이 계정마다 달라
        // 브라우저에서 온 이름을 믿으면 엉뚱한 오류만 늘어난다.
        "AllowModelChoice": false,

        // [생각이 이 예산을 같이 쓴다]
        //
        // Claude 와 같은 함정이 여기에도 있다. 실측에서 max_tokens 를 32 로 두자
        // 다섯 모델 중 넷이 **completion_tokens: 0 · finish_reason: "length"** 를
        // 돌려줬다 — 생각하다가 예산을 다 쓰고 답을 한 글자도 못 쓴 것이다.
        // 답 자체는 7토큰이면 끝나는 질문이었다. 넉넉히 둔다.
        "MaxTokens": 4096,

        // 클라우드라 로컬처럼 모델 로드를 기다릴 일이 없다. 실측 1~3초.
        "TimeoutSeconds": 60,

        // 우리 쪽에서는 세지 않는다. 공급자 한도가 곧 차단이라 태울 돈이 없다.
        "MaxRequestsPerDay": 0,

        // [자르지 않는다]
        // 무료 등급을 실제로 묶는 것은 **하루 요청 수(RPD)** 인데, 기록을 줄여도
        // 요청 수는 그대로다 — 얻는 것이 없다. 분당 토큰(TPM)은 넉넉한 편이다.
        // Groq 만 4000 자를 거는 이유가 그쪽은 TPM 이 먼저 막히기 때문이다.
        "MaxHistoryChars": 0
      },

      // Claude — Anthropic Messages API. **이 공급자만 유료다.**
      //
      // [다른 셋과 무엇이 다른가]
      // 로컬 LLM · Groq · OpenRouter 는 "결제 수단을 등록하지 않는 것" 이 과금을 막는
      // 최종 방어선이었다. 한도를 넘으면 청구되는 것이 아니라 429 로 차단된다.
      // **Anthropic 에는 그 장치가 없다.** 무료 등급이 없고 쓴 만큼 청구된다.
      // 그래서 이 항목에는 돈을 막는 설정이 둘 더 붙어 있다(AllowAutoFailover ·
      // MaxRequestsPerDay). 값을 바꾸기 전에 아래 설명을 읽는다.
      //
      // [키]
      // https://console.claude.com 에서 만들어 appsettings.Local.json 에 넣는다.
      // **Claude Code · Claude 앱 구독으로는 안 된다** — 그것은 API 키가 아니다.
      // 콘솔에서 크레딧을 따로 충전해야 한다.
      //
      // [형식이 다르다]
      // 나머지 셋은 OpenAI 호환이라 주소만 바꾸면 됐지만 Claude 는 Messages API 라
      // 요청·응답·스트리밍이 전부 다르다. 공식 SDK 로 부른다(AnthropicTransport).
      // 그래서 `Protocol` 이 필요하다 — 적지 않으면 openai 로 본다.
      "anthropic": {
        "DisplayName": "Claude (Anthropic)",
        "Protocol": "anthropic",

        // 비워 두면 SDK 기본값을 쓴다. 사내 프록시를 거칠 때만 바꾼다.
        // 경로(/v1/messages)는 SDK 가 붙이므로 **호스트까지만** 적는다.
        "ApiBase": "https://api.anthropic.com",
        "ApiKey": "__SET_IN_appsettings.Local.json__",
        "Model": "claude-opus-5",

        // [MaxTokens 를 넉넉히 두는 이유]
        //
        // **생각과 답이 이 예산을 같이 쓴다.** Claude 는 생각이 기본으로 켜져 있어서,
        // 다른 공급자처럼 1024~2000 으로 잡으면 생각하다가 예산을 다 쓰고
        // 답이 중간에 잘린다. 잘린 답은 무료가 아니다 — 태운 토큰은 그대로 청구된다.
        "MaxTokens": 8192,

        // 생각하는 시간이 있어 Groq 보다 오래 걸린다. 60초면 자주 끊긴다.
        "TimeoutSeconds": 180,

        // [생각 깊이] low · medium · high · max. 비우면 공급자 기본값(high)이다.
        //
        // 올리면 답이 좋아지지만 토큰과 시간이 함께 는다. 대화 화면은 사람이
        // 기다리는 자리이고 토큰이 곧 돈이라 medium 에서 시작한다.
        // 어려운 일을 시킬 거면 high 로 올린다.
        "Effort": "medium",

        // [자동 전환으로 여기에 넘어오지 않게 한다] — **돈이 걸린 설정이다.**
        //
        // 켜 두면 로컬 LLM 이 꺼져 있는 동안 모든 대화가 조용히 이쪽으로 넘어온다.
        // 사람이 고른 적이 없는데 요금이 나간다. 그래서 끈다 —
        // **사람이 환경설정에서 직접 고를 때만** 부른다.
        //
        // 반대 방향은 그대로다. 여기가 실패하면 다른 공급자로 넘어간다.
        "AllowAutoFailover": false,

        // [하루 상한] — **여기서는 이것이 지갑을 지키는 장치다.**
        //
        // 다른 공급자에서는 무료 한도를 아껴 쓰려는 용도라 기본이 0(끔)이었다.
        // 여기서는 공급자 쪽 429 가 지켜 주지 않으므로, 고장 난 반복 호출이
        // 밤새 돌아도 피해가 여기서 멈추게 숫자를 넣어 둔다.
        "MaxRequestsPerDay": 50,

        // 사용자가 모델을 고르지 못하게 둔다. 이름 하나가 바뀌면 단가가 몇 배로
        // 뛰는데, 브라우저에서 오는 값은 믿을 수 없다.
        "AllowModelChoice": false,

        // 문맥이 넉넉해서(1M) 줄여도 얻는 것이 거의 없다. 0 = 자르지 않는다.
        "MaxHistoryChars": 0
      }
    }
  },

  // 옛 설정. `AI:Providers:jsini` 가 비어 있을 때 되받기로 읽는다.
  "LLM": {
    "ApiBase": "",
    "ApiKey": "",
    "Model": ""
  }
}
