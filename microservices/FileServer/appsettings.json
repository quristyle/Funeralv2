{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5350"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "a-very-secret-key-that-is-long-enough-for-security",
    "Issuer": "funeralv2-auth",
    "Audience": "funeralv2-services"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Storage": {
    "LocalPath": "/home/lee/funeralv2_storage",
    "FallbackUrl": "https://funeralv2.jsini.co.kr"
  }
}
