        "Args": [
          "Release",
          "Release"
        ],
        "ReportsProgress": false,
        "TimeoutSeconds": 600,
        "VersionUrl": "",
        "EstimatedSeconds": 20
      },
      {
        "Key": "goldb",
        "Name": "goldb 배포",
        "Description": "goldb 시스템 배포",
        "ScriptPath": "/home/lee/projects/wrkScripts/ReleaseGhub.sh",
        "Args": [
          "Release",
          "Release"
        ],
        "ReportsProgress": false,
        "TimeoutSeconds": 600,
