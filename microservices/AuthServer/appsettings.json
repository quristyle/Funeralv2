  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "__SET_IN_appsettings.Local.json__"
  },
  "//DeployStatus": "상태관리>배포 현황 화면용. GithubToken 은 appsettings.Local.json 에만 둔다 (public 저장소라 추적 파일 금지). DockerSocket 은 운영 compose 가 읽기 전용으로 마운트한다 — 없으면 화면에서 docker 부분만 비활성.",
  "DeployStatus": {
    "GithubRepo": "quristyle/Funeralv2",
    "GithubToken": "__SET_IN_appsettings.Local.json__",
    "DockerSocket": "/var/run/docker.sock"
  },
  "//Auth.PasswordExpiryDays": "비밀번호를 며칠마다 바꾸도록 요구할지. 0 이나 음수를 넣으면 정책이 꺼진다. 실제 차단은 게이트웨이가 하므로 ApiGateway 의 같은 설정도 함께 맞춘다.",
  "//Auth.DefaultPassword": "새 계정에 넣을 고정 비밀번호. **비워 두는 것이 기본이고 그때는 계정마다 무작위로 발급한다** (발급값은 등록 응답에 한 번 실려 관리자 화면에 뜬다). 값을 채우면 예전처럼 모든 새 계정이 같은 비밀번호를 갖게 된다 — 되돌리는 길로만 둔 것이지 평소에 쓰는 값이 아니다.",
  "Auth": {
    "PasswordExpiryDays": 90,
    // access token 수명(일). 게이트웨이가 이 토큰을 검증한다.
    "AccessTokenDays": 7,
    // 갱신 토큰 수명(일). 0 이하로 두면 `/auth/refresh` 가 404 를 주고
    // 로그인이 갱신 쿠키를 심지 않는다 — 코드를 고치지 않고 되돌리는 길이다.
    "RefreshTokenDays": 30,

    // 비밀번호 찾기(/password/forgot → 메일 링크 → /password/reset).
    "PasswordReset": {
      // 메일로 보낸 링크의 수명(분). 짧을수록 안전하지만 메일이 늦게 닿는
      // 곳이 있어 30분으로 둔다. 한 번 쓰면 그 자리에서 죽는다.
      "LifetimeMinutes": 30
    },

    // 가입 신청(/signup → 관리자 승인).
    "Signup": {
      // 신청이 들어오면 이 역할의 대표 이메일로 알린다. 관리자 주소를
      // 설정에 직접 적지 않는 이유는 담당자가 바뀔 때 옛 주소가 남기 때문이다.
      "NotifyRole": "SYSTEM_ADMINISTRATOR",
      // 신청자가 정하는 비밀번호의 최소 길이.
      "MinPasswordLength": 8
    },

    // ── 소셜 로그인 · 소셜 회원가입 (구글 · 네이버 · 카카오) ──────
    //
    // **평소에 손댈 칸은 ClientId · ClientSecret 둘뿐이다.** 나머지(주소 넷과
    // 응답 JSON 의 칸 이름 넷)는 공급자가 정해 둔 값이라 여기 적어 두었다.
    // 공급자를 하나 더 붙이고 싶으면 Providers 아래에 같은 모양으로 한 덩이를
    // 더 적으면 된다 — **코드는 건드리지 않는다**(SocialProviderOptions 머리말).
    //
    // 비밀 열쇠는 **여기 적지 않는다.** 이 파일은 추적되는 파일이다.
    //   scripts/secrets.env  →  Auth__Social__Providers__google__ClientSecret=...
    //   또는 appsettings.Local.json (git 제외)
    //
    // ClientId 가 비어 있는 공급자는 **없는 셈 친다** — 로그인 화면에 단추가
    // 아예 안 그려진다. 그래서 값을 안 채워도 지금과 똑같이 동작한다.
    //
    // 공급자 콘솔에 등록할 콜백 주소 (셸이 이 모양으로 만든다):
    //   https://portal.jsini.co.kr/social/google/callback
    //   https://portal.jsini.co.kr/social/naver/callback
    //   https://portal.jsini.co.kr/social/kakao/callback
    // 자세한 것은 docs/social-login.md.
    "Social": {
      // 기능을 통째로 끄는 스위치. 코드를 건드리지 않고 되돌리는 길이다.
      "Enabled": true,

      // 처음 들어온 소셜 계정을 곧바로 쓰게 할 것인가. **기본은 끔** —
      // 아이디·비밀번호 가입이 이미 승인제라, 소셜만 즉시 통과시키면
      // 그 승인제를 우회하는 길이 된다.
      "AutoApprove": false,

      // 공급자가 「확인된 주소」라고 말한 이메일이 기존 계정과 같으면 그 계정에
      // 자동으로 붙일 것인가. **기본은 끔** — 켜면 편하지만, 공급자가 이메일을
      // 제대로 확인하지 않는 순간 남의 계정으로 들어가는 길이 열린다.
      "LinkByVerifiedEmail": false,

      // 새로 만든 계정에 적어 둘 첫 화면. 가입 신청이 넣는 값과 같게 둔다.
      "HomePath": "/workspace",

      "Providers": {
        "google": {
          "DisplayName": "구글",
          "ClientId": "",
          "ClientSecret": "",
          "AuthorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "TokenUrl": "https://oauth2.googleapis.com/token",
          "UserInfoUrl": "https://openidconnect.googleapis.com/v1/userinfo",
          "Scope": "openid email profile",
          "IdPath": "sub",
          "EmailPath": "email",
          "NamePath": "name",
          "EmailVerifiedPath": "email_verified"
        },

        // 네이버는 scope 를 요청에 싣지 않는다 — 받아 올 항목을 개발자센터의
        // [내 애플리케이션 → 제공 정보 선택] 에서 정한다. 이메일을 거기서
        // 켜지 않으면 response.email 이 비어서 온다.
        //
        // 확인 여부를 알려 주는 칸이 없어 EmailVerifiedPath 를 비워 둔다.
        // 그러면 LinkByVerifiedEmail 을 켜도 네이버로는 자동 연결이 되지 않는다 —
        // 모를 때는 안전한 쪽으로 기운다.
        "naver": {
          "DisplayName": "네이버",
          "ClientId": "",
          "ClientSecret": "",
          "AuthorizeUrl": "https://nid.naver.com/oauth2.0/authorize",
          "TokenUrl": "https://nid.naver.com/oauth2.0/token",
          "UserInfoUrl": "https://openapi.naver.com/v1/nid/me",
          "Scope": "",
          "IdPath": "response.id",
          "EmailPath": "response.email",
          "NamePath": "response.name",
          "EmailVerifiedPath": ""
        },

        // 카카오의 ClientId 는 **REST API 키**다(JavaScript 키를 넣으면 인가
        // 화면이 KOE101 로 막힌다). ClientSecret 은 콘솔의 [보안] 에서 켰을
        // 때만 값이 있고, 안 켰으면 비워 둔다 — 빈 값을 실어 보내면 거절당한다.
        //
        // scope 의 두 항목은 콘솔의 [카카오 로그인 → 동의항목] 에서 함께
        // 켜 두어야 한다. 안 켜면 인가 화면이 KOE006 으로 막힌다.
        "kakao": {
          "DisplayName": "카카오",
          "ClientId": "",
          "ClientSecret": "",
          "AuthorizeUrl": "https://kauth.kakao.com/oauth/authorize",
          "TokenUrl": "https://kauth.kakao.com/oauth/token",
          "UserInfoUrl": "https://kapi.kakao.com/v2/user/me",
          "Scope": "account_email profile_nickname",
          "IdPath": "id",
          "EmailPath": "kakao_account.email",
          "NamePath": "kakao_account.profile.nickname",
          "EmailVerifiedPath": "kakao_account.is_email_verified"
        }
      }
    }
  },
  "//WebAuthn": "패스키(지문·얼굴) 로그인. **평소에는 비워 둔다** — RelyingPartyId 와 AllowedOrigins 가 비면 Portal:BaseUrl 에서 호스트와 오리진을 꺼내 쓴다(그 값은 환경마다 이미 맞춰져 있다). 포털과 다른 도메인에서 쓰거나 도메인을 둘 이상 받아야 할 때만 채운다. RequireUserVerification 을 false 로 두면 지문·얼굴·PIN 을 거치지 않은 로그인도 받는다 — 이 기능을 넣은 까닭이 그것이므로 끄지 않는다.",
  "WebAuthn": {
    "RelyingPartyId": "",
    "RelyingPartyName": "JSini 업무 포털",
    "AllowedOrigins": [],
    "RequireUserVerification": true
  },
  "//Portal.BaseUrl": "비밀번호 재설정 메일에 넣을 포털 주소. **운영에서는 반드시 바꾼다** — 안 바꾸면 메일에 localhost 주소가 나가서 아무도 못 연다. 끝의 / 는 있어도 없어도 된다.",
  "Portal": {
    "BaseUrl": "http://localhost:5557"
  },
  "//Notify.BaseUrl": "NotificationServer 주소. 생일 푸시와 계정 안내 메일(재설정·가입)이 쓴다. 없으면 127.0.0.1:5460 으로 본다.",
  "Notify": {
    "BaseUrl": "http://127.0.0.1:5460"
  },
  "//github": "플레이어 릴리스(/system/player-release)가 쓴다. Token 은 appsettings.Local.json(git 제외)에만 둔다 — repo(태그 생성) · workflow(실행 조회) 권한이 필요하다. 값이 없으면 화면이 \"설정이 필요합니다\" 를 띄우고 서버는 정상 기동한다.",
  "GitHub": {
    "Owner": "quristyle",
    "Repo": "Funeralv2",
    "Branch": "main",
    "Token": "__SET_IN_appsettings.Local.json__"
  }
