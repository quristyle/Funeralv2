<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- 이메일은 SMTP 가 아니라 큐에 넣는다. 아래 EmailQueueService 주석 참고. -->
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- 헬프데스크가 쓰는 것과 같은 버전. VAPID 웹푸시 발송. -->
    <PackageReference Include="WebPush" />
    <!-- WebPush 이 끌고 오는 취약한 Newtonsoft.Json 10.0.3 을 덮어쓰기 위한 직접 참조.
         자세한 사정은 Directory.Packages.props 참고. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\JSini.Shared.DTOs\JSini.Shared.DTOs.csproj" />
    <ProjectReference Include="..\Common\JSini.Shared.Domain\JSini.Shared.Domain.csproj" />
    <ProjectReference Include="..\Common\JSini.Shared.Infrastructure\JSini.Shared.Infrastructure.csproj" />
  </ItemGroup>

</Project>
