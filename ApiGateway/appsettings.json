{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "a-very-secret-key-that-is-long-enough-for-security",
    "Issuer": "funeralv2-auth",
    "Audience": "funeralv2-services"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous", 
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "device-code-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/device/code/{code}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },      
      "deceased-build-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/guide/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-kiosk-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/kiosk/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "mediasource-detail-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/source/{id}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "signalr-hub-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/hubs/device/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "funeral-service-route": {
        "ClusterId": "funeral-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/funeral/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "file-download-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/download/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-thumbnail-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/thumbnail/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-medium-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/medium/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-large-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/large/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-resize-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/resize/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 2,
        "Match": {
          "Path": "/api/file/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/ai/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ]
      },
      // 헬프데스크(구 JinRestApi). 서비스 내부 엔드포인트가 모두 /api/... 로 매핑되어 있어
      // 게이트웨이 프리픽스를 떼고 다시 /api 를 붙여준다. (/api/helpdesk/users/login -> /api/users/login)
      //
      // 인증은 헬프데스크가 자체 발급한 토큰(/api/helpdesk/users/login)으로도 이뤄지므로
      // 게이트웨이에서 1차 검증하지 않고 서비스가 직접 검증하도록 Anonymous 로 통과시킨다.
      // (헬프데스크 서비스는 funeralv2-auth 토큰도 함께 수용하도록 구성되어 있다)
      // 헬프데스크는 인증된 요청만 통과시킨다 (결정 D10-A).
      //
      // 예전에는 Anonymous 였다. 헬프데스크가 독자 시스템이던 시절 JinReception 이
      // 자체 토큰으로 인증하고 서버가 그걸 믿는 구조였기 때문인데,
      // 게이트웨이 뒤로 들어오면서 그 전제가 사라졌다.
      // 그 결과 엔드포인트 파일 23개 중 15개의 쓰기 API 가 인증 없이 열려 있었다
      // (POST /api/helpdesk/schedules 가 토큰 없이 201 을 반환하는 것을 확인).
      //
      // 포털 프론트는 모든 헬프데스크 호출에 토큰을 붙이므로 예외 라우트가 필요 없다.
      // 익명이 필요한 경로가 생기면 이 라우트보다 Order 를 낮춘 별도 라우트로 열 것.
      //
      // AuthorizationPolicy 를 지정하지 않으면 Program.cs 의 FallbackPolicy
      // (= 인증 필요) 가 적용된다.
      "helpdesk-route": {
        "ClusterId": "helpdesk-cluster",
        "Match": {
          "Path": "/api/helpdesk/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/helpdesk" },
          { "PathPrefix": "/api" }
        ]
      },
      // 프로젝트관리(구 ProjMngServer / ProjMngWasm).
      // 서비스 내부 엔드포인트가 /api/Proj, /api/Dev, /api/Sys, /api/Media 로 매핑되어 있어
      // 게이트웨이 프리픽스를 떼고 다시 /api 를 붙여 준다.
      // (/api/projmng/Proj -> ProjMngServer 의 /api/Proj)
      //
      // 이 서비스는 저장 프로시저를 이름으로 호출하는 범용 통로다. 익명으로 열 경로가 없으므로
      // AuthorizationPolicy 를 지정하지 않고 Program.cs 의 FallbackPolicy(= 인증 필요)를 따른다.
      // 임의 SQL 실행 경로(/api/projmng/Dev/sql)는 서비스 안에서 역할을 한 번 더 확인한다.
      "projmng-route": {
        "ClusterId": "projmng-cluster",
        "Match": {
          "Path": "/api/projmng/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/projmng" },
          { "PathPrefix": "/api" }
        ]
      },
      // 한주(고객사) OADR 시스템 중계.
      // 헬프데스크의 설비 모니터링·리포트 화면들이 이 외부 시스템을 직접 읽는다.
      // 브라우저에서 직접 부르면 CORS 에 막히므로 게이트웨이가 대신 호출한다.
      "oadr-route": {
        "ClusterId": "oadr-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/oadr/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/oadr" },
          { "PathPrefix": "/oadr" },
          { "RequestHeader": "Origin", "Set": "" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5264" }
        }
      },
      "funeral-cluster": {
        // SignalR(WebSocket) 을 중계하므로 유휴 타임아웃을 넉넉히 준다. 플레이어 keepAlive 는 15초.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5320" }
        }
      },
      "file-cluster": {
        // 최대 500MB 업로드/다운로드를 다루므로 활동 타임아웃을 길게 잡는다.
        "HttpRequest": { "ActivityTimeout": "00:10:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5350" }
        }
      },
      "ai-cluster": {
        // LLM 스트리밍 응답이 길어질 수 있어 여유를 둔다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5029" }
        }
      },
      "helpdesk-cluster": {
        // 첨부파일 업로드/대시보드 집계 쿼리가 있어 여유를 둔다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5400" }
        }
      },
      "projmng-cluster": {
        // 소스 스캔·직접 쿼리 같은 개발자 도구가 있어 한 요청이 길어질 수 있다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5450" }
        }
      },
      "oadr-cluster": {
        // 외부 고객사 시스템이라 응답이 느릴 수 있다. 헬스체크는 걸지 않는다
        // (우리 인프라가 아니고 /health 규약도 따르지 않는다).
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": { "Address": "https://nums.hanjucorp.co.kr" }
        }
      }
    }
  }
}
