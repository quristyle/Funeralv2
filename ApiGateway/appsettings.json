            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5490" }
        }
      },
      // 운영에서는 compose 의 gateway 환경변수가 이 주소를 http://cargo:8080 으로 덮는다.
      "cargotrust-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
