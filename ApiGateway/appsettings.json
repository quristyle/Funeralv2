{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "a-very-secret-key-that-is-long-enough-for-security",
    "Issuer": "funeralv2-auth",
    "Audience": "funeralv2-services"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous", 
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "device-code-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/device/code/{code}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },      
      "deceased-build-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/guide/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-kiosk-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/kiosk/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "mediasource-detail-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/source/{id}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "signalr-hub-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/hubs/device/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "funeral-service-route": {
        "ClusterId": "funeral-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/funeral/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "file-download-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/download/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-thumbnail-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/thumbnail/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-medium-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/medium/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-large-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/large/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-resize-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/resize/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 2,
        "Match": {
          "Path": "/api/file/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/ai/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ]
      },
      // 헬프데스크(구 JinRestApi). 서비스 내부 엔드포인트가 모두 /api/... 로 매핑되어 있어
      // 게이트웨이 프리픽스를 떼고 다시 /api 를 붙여준다. (/api/helpdesk/users/login -> /api/users/login)
      //
      // 인증은 헬프데스크가 자체 발급한 토큰(/api/helpdesk/users/login)으로도 이뤄지므로
      // 게이트웨이에서 1차 검증하지 않고 서비스가 직접 검증하도록 Anonymous 로 통과시킨다.
      // (헬프데스크 서비스는 funeralv2-auth 토큰도 함께 수용하도록 구성되어 있다)
      "helpdesk-route": {
        "ClusterId": "helpdesk-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/helpdesk/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/helpdesk" },
          { "PathPrefix": "/api" }
        ]
      },
      // 한주(고객사) OADR 시스템 중계.
      // 헬프데스크의 설비 모니터링·리포트 화면들이 이 외부 시스템을 직접 읽는다.
      // 브라우저에서 직접 부르면 CORS 에 막히므로 게이트웨이가 대신 호출한다.
      "oadr-route": {
        "ClusterId": "oadr-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/oadr/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/oadr" },
          { "PathPrefix": "/oadr" },
          { "RequestHeader": "Origin", "Set": "" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5264" }
        }
      },
      "funeral-cluster": {
        // SignalR(WebSocket) 을 중계하므로 유휴 타임아웃을 넉넉히 준다. 플레이어 keepAlive 는 15초.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5320" }
        }
      },
      "file-cluster": {
        // 최대 500MB 업로드/다운로드를 다루므로 활동 타임아웃을 길게 잡는다.
        "HttpRequest": { "ActivityTimeout": "00:10:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5350" }
        }
      },
      "ai-cluster": {
        // LLM 스트리밍 응답이 길어질 수 있어 여유를 둔다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5029" }
        }
      },
      "helpdesk-cluster": {
        // 첨부파일 업로드/대시보드 집계 쿼리가 있어 여유를 둔다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5400" }
        }
      },
      "oadr-cluster": {
        // 외부 고객사 시스템이라 응답이 느릴 수 있다. 헬스체크는 걸지 않는다
        // (우리 인프라가 아니고 /health 규약도 따르지 않는다).
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": { "Address": "https://nums.hanjucorp.co.kr" }
        }
      }
    }
  }
}
