{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "__SET_IN_appsettings.Local.json__",
    "Issuer": "funeralv2-auth",
    "Audience": "funeralv2-services"
  },

  // 비밀번호 사용 기간(일). 0 이하면 차단을 끈다. AuthServer 도 같은 설정을 읽는다.
  "Auth": {
    "PasswordExpiryDays": 90
  },
  // 플레이어 장비 토큰 검증(D-M1), 기본 꺼짐. 실제 DeviceTokens 는 비밀이라 appsettings.Local.json 에만 둔다.
  "PlayerAuth": {
    "RequireDeviceToken": false
  },
  // RateLimiterPolicy 는 Program.cs 에서 정의한다: auth-attempts(분당 10), public-write(분당 3), player-read(분당 900).
  // SignalR 허브에는 걸지 않는다. 이 설명을 Routes 안에 // 키로 넣지 마라(YARP 가 키를 라우트로 읽어 기동에 실패한다).
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 잠금화면 비밀번호 확인도 로그인과 같은 시도 제한을 건다. auth-route 보다 Order 가 앞이라 이긴다.
      "auth-verify-password-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/user/verify-password",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 비밀번호 찾기 두 경로는 로그인과 같은 제한(분당 10회)을 건다. 없으면 auth-route 가 제한 없이 받는다.
      "auth-password-forgot-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/password/forgot",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-password-reset-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/password/reset",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 가입 신청은 분당 3회로 조인다. 승인 대기 계정만 만들어지지만 막지 않으면 승인 화면이 쓰레기로 덮인다.
      "auth-signup-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "public-write",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/signup",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 패스키 로그인 두 경로는 auth-attempts 통으로 건다. 도전값 받기까지 세는 것은 그것만 반복해도 서버 캐시가 부풀기 때문이다.
      // 등록·목록·삭제는 로그인한 사람만 부르므로 auth-route 에 둔다.
      "auth-webauthn-login-options-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/webauthn/login/options",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-webauthn-login-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/webauthn/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 잠금화면 지문 확인 두 경로는 로그인과 같은 통(auth-attempts)으로 건다. 비밀번호판과 같은 까닭이다.
      "auth-webauthn-verify-options-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/webauthn/verify/options",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-webauthn-verify-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/webauthn/verify",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      // 소셜 로그인 두 경로는 auth-attempts 통으로 건다. 인가 주소 받기까지 세는 것은 공급자 쪽에 우리 이름으로 요청이 쌓이기 때문이다.
      // providers 는 로그인 화면이 뜰 때마다 불리므로 제외한다(제한하면 공인 IP 를 공유하는 곳에서 단추가 사라진다). 연결·끊기도 로그인한 사람만 부른다.
      "auth-social-authorize-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/social/authorize",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-social-login-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-attempts",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/social/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },

      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "device-code-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "player-read",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/device/code/{code}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "player-read",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },      
      "deceased-build-list-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "player-read",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/guide/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "deceased-kiosk-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "player-read",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/deceased/kiosk/deviceCode/{deviceCode}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "mediasource-detail-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "player-read",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/building/source/{id}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "signalr-hub-anonymous-route": {
        "ClusterId": "funeral-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/funeral/hubs/device/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "funeral-service-route": {
        "ClusterId": "funeral-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/funeral/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/funeral" }
        ]
      },
      "file-download-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/download/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-thumbnail-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/thumbnail/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-medium-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/medium/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-large-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/large/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      "file-resize-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/file/resize/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      // 위 읽기 라우트에 안 걸리는 나머지 파일 경로(업로드·삭제·메타데이터 등)는 인증을 요구한다. 포털은 모두 토큰을 붙여 부른다.
      "file-route": {
        "ClusterId": "file-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/file/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/file" }
        ]
      },
      // mbox 올리기. **ai-route 보다 먼저 잡아야 한다**(Order 가 낮은 것이 먼저다).
      // 올리기는 뒷단이 본문을 다 받고 나서야 답하는 길이라 기다림의 셈이 AI 대화와
      // 다르다 — 한쪽을 조이다 다른 쪽을 끊지 않게 떼어 둔다.
      "ai-gmail-upload-route": {
        "ClusterId": "ai_upload_cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/ai/gmail/import/upload"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ]
      },

      "ai-route": {
        "ClusterId": "ai-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/ai/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ]
      },

      // 회사 소개 사이트. 관리는 인증, 문의 접수는 익명+IP 제한, 조회는 익명. Order 가 낮은 것이 먼저 잡는다.
      "site-admin-route": {
        "ClusterId": "site-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/site/admin/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/site" }
        ]
      },
      // 익명 쓰기는 이 하나뿐이다(public-write). 허니팟과 동의 여부는 서비스 안에서 한 번 더 본다.
      "site-inquiry-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "public-write",
        "Order": 1,
        "Match": {
          "Path": "/api/site/inquiries",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/site" }
        ]
      },
      // 조회 집계는 익명 쓰기지만 개인을 특정하는 값을 쌓지 않아 제한하지 않는다.
      "site-visit-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/site/visits",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/site" }
        ]
      },
      // 나머지 조회는 GET 만 익명으로 연다. 새 쓰기 경로가 새어 나가지 않게 메서드를 못박는다.
      "site-public-route": {
        "ClusterId": "site-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 2,
        "Match": {
          "Path": "/api/site/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/site" }
        ]
      },
      // 위 어디에도 안 걸린 /api/site 요청은 인증을 요구한다.
      "site-route": {
        "ClusterId": "site-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/site/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/site" }
        ]
      },
      // 생활과환경(기상·생일). 익명 경로가 없어 전부 인증을 요구한다.
      "life-route": {
        "ClusterId": "life-cluster",
        "Match": {
          "Path": "/api/life/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/life" }
        ]
      },
      // 운송관리. 서비스가 X-User-Id 로 사용자 줄을 만들어 익명 경로가 있을 수 없다.
      "cargotrust-route": {
        "ClusterId": "cargotrust-cluster",
        "Match": {
          "Path": "/api/cargotrust/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/cargotrust" }
        ]
      },
      // 배포 알림(익명, Order 1). 부르는 쪽은 러너라 로그인 토큰이 없고 X-Deploy-Token 공유 비밀로 본다. 틀리면 403, 설정이 없으면 503.
      // 바깥에서 두드릴 수 있으므로 분당 3회를 건다. POST 로만 못박는다(메서드를 열면 /api/notification 밑 경로가 새어 나간다).
      "notification-deploy-event-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "public-write",
        "Order": 1,
        "Match": {
          "Path": "/api/notification/deploy-event",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notification" }
        ]
      },
      // 쪽지 기기 도달 보고(익명, Order 1). 부르는 쪽은 서비스워커라 토큰이 없고 쪽지 GUID 가 열쇠다. 새어도 잃는 것은 전환 메일 한 통이다.
      // POST 로 못박는다. 제한은 분당 60회다. 정상 보고가 거절되면 전환 메일이 헛되이 나간다.
      "notification-note-delivered-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "push-ack",
        "Order": 1,
        "Match": {
          "Path": "/api/notification/notes/delivered",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notification" }
        ]
      },
      // 푸시 도착 보고(익명). 열쇠는 묶음 아이디와 기기의 구독 주소다. POST 로만, 제한은 쪽지 보고와 같은 분당 60회(push-ack).
      "notification-push-delivered-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "push-ack",
        "Order": 1,
        "Match": {
          "Path": "/api/notification/notifications/push/delivered",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notification" }
        ]
      },
      // 알림(푸시·이메일). 인증을 요구한다(D8-A). 공개 키 조회도 로그인 뒤에만 쓰므로 여기 포함한다.
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/notification/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notification" }
        ]
      },
      // 헬프데스크(D10-A). AuthorizationPolicy 를 지정하지 않아 Program.cs 의 FallbackPolicy(인증 필요)가 적용된다. 포털은 모든 호출에 토큰을 붙인다.
      "helpdesk-route": {
        "ClusterId": "helpdesk-cluster",
        "Match": {
          "Path": "/api/helpdesk/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/helpdesk" },
          { "PathPrefix": "/api" }
        ]
      },
      // 프로젝트관리. 저장 프로시저 범용 통로라 익명 경로가 없고 FallbackPolicy 를 따른다. 임의 SQL 경로(/api/projmng/Dev/sql)는 서비스가 역할을 한 번 더 본다.
      "projmng-route": {
        "ClusterId": "projmng-cluster",
        "Match": {
          "Path": "/api/projmng/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/projmng" },
          { "PathPrefix": "/api" }
        ]
      },
      // 한주 OADR 시스템 중계. 브라우저는 CORS 에 막히므로 게이트웨이가 대신 호출한다.
      "oadr-route": {
        "ClusterId": "oadr-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/oadr/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/oadr" },
          { "PathPrefix": "/oadr" },
          { "RequestHeader": "Origin", "Set": "" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5264" }
        }
      },
      "funeral-cluster": {
        // SignalR(WebSocket) 을 중계하므로 유휴 타임아웃을 넉넉히 준다. 플레이어 keepAlive 는 15초.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5320" }
        }
      },
      "file-cluster": {
        // 최대 500MB 업로드/다운로드를 다루므로 활동 타임아웃을 길게 잡는다.
        "HttpRequest": { "ActivityTimeout": "00:10:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5350" }
        }
      },
      // mbox 올리기 전용. 느린 회선에서 GB 짜리를 올리면 몇십 분이 걸리므로 넉넉히 둔다.
      //
      // **이름에 하이픈을 쓰지 않는다** — 운영은 이 주소를 환경변수로 덮는데, 진입점이
      // `/bin/sh -c` 라 셸이 하이픈 든 환경변수를 버린다(mcp_cluster 와 같은 사정).
      // 그래서 `ai_upload_cluster` 다. 하이픈으로 두면 운영에서 주소가 localhost 로
      // 남아 **모든 올리기가 502** 가 된다.
      "ai_upload_cluster": {
        "HttpRequest": { "ActivityTimeout": "12:00:00" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5029" }
        }
      },

      "ai-cluster": {
        // LLM 스트리밍 응답이 길어질 수 있어 여유를 둔다.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5029" }
        }
      },
