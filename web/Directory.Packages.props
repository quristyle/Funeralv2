<Project>

  <!--
    NuGet 중앙 패키지 관리(CPM). 백엔드와 같은 방식이다 —
    버전은 여기서만 정하고 각 csproj 의 PackageReference 에는 Version 을 적지 않는다.

    모듈이 열 개로 갈라지는 구조에서 이게 없으면 DevExpress 버전이 모듈마다
    달라진다. 한 프로세스에 서로 다른 DevExpress 어셈블리를 올릴 수는 없으므로
    반드시 한 곳에서 정해야 한다.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      DevExpress 버전. 올릴 때 이 한 줄만 바꾼다.

      26.1 대의 마지막 정식판이다(26.1.5 는 아직 pre 뿐). **nuget.org 에서 그대로
      받는다** — DevExpress 는 패키지를 공개 피드에 올리고 라이선스는 빌드 때
      라이선스 파일로 확인하는 방식이라, 인증 피드(nuget.devexpress.com)를
      등록하지 않아도 복원된다. 라이선스 파일 얘기는 README 를 보라.

      25.1 대를 쓰지 않는 이유가 둘 있다.
        · 25.1 은 net8.0 을 타겟해서 net10.0 위에서는 호환 계층으로만 돈다.
        · 25.1 이 끌고 오는 System.Security.Cryptography.Xml 8.0.2 에
          알려진 높음 심각도 취약점이 8건 있다(NU1903).
    -->
    <DevExpressVersion>26.1.4</DevExpressVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ── 장비 실시간 상태 (SignalR 클라이언트) ─────────────────
         빈소 화면이 붙고 떨어질 때 funeralv2Api 가 `DeviceStatusChanged` 를
         방송한다. 기기 관리 화면이 그것을 받아 켜짐/꺼짐을 바로 고친다.

         **JSini.Web.Funeral 만 참조한다** — 그 방송을 듣는 화면이 거기뿐이다. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />

    <!-- ── DevExpress Blazor ───────────────────────────────────── -->
    <PackageVersion Include="DevExpress.Blazor" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Blazor.Themes" Version="$(DevExpressVersion)" />

    <!--
      DevExpress 를 내릴 일이 생기면 System.Security.Cryptography.Xml 을 여기에
      다시 고정해야 한다. 25.1 대는 net8.0 을 타겟해서 그 패키지의 8.0.2 를
      끌고 오는데, 8.0.2 에는 알려진 높음 심각도 취약점이 8건 있다
      (NU1903, GHSA-23rf-6693-g89p 외 7건). 26.1.4 는 그 문제가 없어서 지웠다.

        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    -->

    <!-- ── 코드 편집기 ────────────────────────────────────────────
         프로젝트관리 화면 9개가 SQL·템플릿을 편집한다. Vue 는 monaco 를 직접
         감쌌고, 그 전 Blazor(ProjMngWasm)도 같은 BlazorMonaco 를 썼다.

         **JSini.Web.ProjMng 만 참조한다.** monaco 정적 자원이 수 MB 라
         Blazor Common 에 넣으면 편집기가 없는 앱까지 전부 싣는다.
         헬프데스크에도 편집기 쓰는 화면이 하나 있는데, 그때 가서 복제할지
         공용으로 올릴지 정한다(두 앱까지는 복제, 세 번째부터 승격). -->
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />

    <!-- ── Piral.Blazor MFE 오케스트레이션 ──────────────────────── -->
    <PackageVersion Include="Piral.Blazor.Orchestrator" Version="1.0.0" />
    <PackageVersion Include="Piral.Blazor.Shared" Version="1.0.0" />
    <PackageVersion Include="Piral.Blazor.Core" Version="10.0.19" />
    <PackageVersion Include="Piral.Blazor.Utils" Version="10.0.19" />
    <!-- Piral.Blazor.Orchestrator 가 끌고 오는 NuGet 6.8.1 전이 의존성 보안 패치 -->
    <PackageVersion Include="NuGet.Packaging" Version="6.12.1" />
    <PackageVersion Include="NuGet.Protocol" Version="6.12.1" />

    <!-- ── 셸의 역방향 프록시 ─────────────────────────────────────
         셸이 경로 접두사로 업무 MFE 에 넘긴다. ApiGateway 와 같은 버전을 쓴다 —
         같은 저장소에서 YARP 를 두 버전 굴리면 설정 문법 차이로 헷갈린다. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- ── 인증 ──────────────────────────────────────────────────
         셸은 쿠키 인증만 쓴다. 게이트웨이로 나가는 JWT 는 서버가 들고 있고
         브라우저에는 내려가지 않는다(BFF). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- ── 테스트 ────────────────────────────────────────────────
         아키텍처 규칙을 문서가 아니라 테스트로 강제한다. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
