@*
    사이드바 메뉴 트리. 이미 걸러진 목록을 받아 그리기만 한다.

    거르기를 여기서 하지 않는 것이 중요하다 — 권한 판정이 MenuFilter 와 여기로
    갈라지면 둘이 어긋나고, 그 어긋남은 "어떤 사용자에게만" 나타나서 재현이 어렵다.
*@

<ul class="jsini-menu">
    @foreach (var node in Nodes)
    {
        <li class="jsini-menu__item">
            @if (node.Children.Count > 0)
            {
                @* 자식이 있으면 펼침 묶음. 자기 화면이 있는 메뉴도 자식을 가질 수
                   있으므로(예: 현황관리), 제목 자체를 링크로 둘지는 IsCatalog 로 가른다. *@
                <details class="jsini-menu__group" open="@IsOpen(node)">
                    <summary class="jsini-menu__summary">
                        @if (node.IsCatalog)
                        {
                            <span>@node.Title</span>
                        }
                        else
                        {
                            <NavLink class="jsini-menu__link" href="@node.LinkTarget">@node.Title</NavLink>
                        }
                    </summary>
                    <SidebarMenu Nodes="@node.Children" />
                </details>
            }
            else if (node.IsExternalLink)
            {
                @* 외부 링크는 새 창으로. rel 을 붙여 두는 이유는 열린 창이
                   window.opener 로 이 포털을 건드리지 못하게 하려는 것이다. *@
                <a class="jsini-menu__link"
                   href="@(node.Link ?? node.LinkTarget)"
                   target="_blank"
                   rel="noopener noreferrer">@node.Title</a>
            }
            else
            {
                <NavLink class="jsini-menu__link" href="@node.LinkTarget" Match="NavLinkMatch.Prefix">
                    @node.Title
                </NavLink>
            }
        </li>
    }
</ul>

@code {
    /// <summary>그릴 메뉴들. **이미 걸러진 것**이어야 한다.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MenuNode> Nodes { get; set; } = [];

    /// <summary>
    /// 이 묶음을 펼친 채로 그릴지.
    ///
    /// 지금 열려 있는 화면이 이 묶음 안에 있으면 펼친다. 접힌 채로 두면 새로
    /// 고침한 사용자가 자기가 어디 있는지 알 수 없다.
    /// </summary>
    private bool IsOpen(MenuNode node) => Contains(node, CurrentPath());

    private static bool Contains(MenuNode node, string path)
    {
        if (!string.IsNullOrEmpty(node.LinkTarget)
            && path.StartsWith(node.LinkTarget, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return node.Children.Any(child => Contains(child, path));
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string CurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cut = relative.IndexOfAny(['?', '#']);
        if (cut >= 0)
        {
            relative = relative[..cut];
        }
        return "/" + relative.TrimStart('/');
    }
}
