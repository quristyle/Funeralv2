@*
    오른쪽 위 사용자 영역. 이름과 로그아웃.

    로그아웃이 폼 제출인 이유: 쿠키를 지우는 것은 서버가 하는 일이고, Blazor
    회로 안에서 NavigateTo 로는 쿠키가 지워지지 않는다. antiforgery 토큰까지
    함께 가야 하므로 평범한 POST 폼으로 둔다.
*@

<AuthorizeView>
    <Authorized>
        <span class="jsini-shell__user">@context.User.Identity?.Name</span>
        <form action="/logout" method="post" class="jsini-shell__logout">
            <AntiforgeryToken />
            <button type="submit" class="jsini-shell__logout-button">로그아웃</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a class="jsini-shell__login-link" href="/login">로그인</a>
    </NotAuthorized>
</AuthorizeView>
