@implements IDisposable

@*
    휴대폰 화면 아래에 붙는 띠. 보이고 안 보이고는 CSS 가 정하고 이 파일은 무엇을 놓을지만 다룬다. 칸 수는 환경설정에서 셋에서 여덟까지 고르고, 고른 적이 없으면 홈 · 알림 · 설정 · 프로필 · 메뉴 다섯이다(BottomNav.Defaults).
    몇이 오든 그냥 그린다 — 칸은 남는 폭을 똑같이 나눠 갖고 이름이 길면 말줄임으로 잘린다. 뒤엣것이 없으면 여덟 칸이 화면보다 넓어져 끝 칸이 밀려 나간다.
    이름을 감추는 것도 여기서 하지 않는다 — 여기서 @if 로 span 을 빼면 단추의 읽을 이름이 사라진다. CSS 가 자리만 뺏고 글자는 남긴다. 띠 자체를 끄는 것도 여기가 아니다 — 레이아웃이 아예 안 그리고, 여기서 감추면 표시와 판정이 갈라져 띠는 사라지고 여백만 남는다.
*@

<div class="jsini-bottom-nav">
    @foreach (var item in _items)
    {
        <button type="button" class="jsini-bottom-nav__item" @onclick="@(() => Go(item))">
            @if (IsProfile(item))
            {
                @*
                    프로필 칸만 그림이 사람마다 다르다 — 헤더 오른쪽의 판과 같은 차례로 그린다(사진 → 없으면 첫 글자 → 못 받아 오면 다시 첫 글자). 얼굴이 다르면 같은 것을 여는 단추로 안 보인다.
                *@
                <UserAvatar Photo="@(Me.AvatarThumbnailUrl ?? Me.AvatarUrl)"
                            Name="@(Me.DisplayName ?? Me.Username)"
                            OnPhotoError="@(() => Me.MarkAvatarUnavailable())"
                            CssClass="jsini-bottom-nav__avatar" />
            }
            else
            {
                <span class="@BottomNav.IconClass(item, Menus.AllMenus) jsini-bottom-nav__icon"
                      aria-hidden="true"></span>
            }
            <span>@item.Title</span>
        </button>
    }
</div>
