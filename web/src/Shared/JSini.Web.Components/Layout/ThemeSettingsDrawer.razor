@namespace JSini.Web.Components.Layout

@*
    테마 서랍. preview.tabler.io 의 Customize 판과 같은 구성이다 —
    밝기 · 강조색 · 바탕 톤 · 모서리, 그리고 우리가 더한 크기 · 글꼴.
*@

@implements IDisposable

<RightSideDrawer Id="jsini-theme-drawer" IsOpen="@_open" IsOpenChanged="@((v) => { if (!v) Drawer.Close(); _open = v; })"
                 IsPhone="@IsPhone"
                 IsPinned="@_pinned" IsPinnedChanged="@(v => _pinned = v)"
                 Title="화면 설정" CssClass="jsini-theme-drawer-custom">
    <ChildContent>
        <div class="jsini-theme p-3">

            @*
                밝기는 **그림만** 세운다(해 · 달 · 화면). 셋을 글자까지 달아 세우면
                좁은 판에서 줄이 넘어가고, 그 셋은 그림만으로도 갈린다 —
                이름은 `title`·`aria-label` 로 남겨 마우스와 낭독기가 읽는다.

                `aria-pressed` 는 **글자로** 적는다. `bool` 을 그대로 주면 Blazor 가
                참·거짓 속성으로 읽어 안 고른 칸에서는 속성째 사라지고, 낭독기에게
                「눌리는 단추가 아닌 것」으로 들린다.
            *@
            <section class="tb-custom">
                <div class="tb-custom__label">밝기</div>
                <div class="tb-custom__options">
                    @foreach (var mode in _catalog.Modes)
                    {
                        <button type="button"
                                class="tb-pill tb-pill--icon @(_mode == mode.Id ? "tb-pill--on" : "")"
                                title="@mode.Name"
                                aria-label="@mode.Name"
                                aria-pressed="@((_mode == mode.Id) ? "true" : "false")"
                                @onclick="@(() => SetAsync("setMode", mode.Id))">
                            <span class="jsini-icon-@ModeIcon(mode)" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </section>

            <section class="tb-custom">
                <div class="tb-custom__label">강조색</div>
                <div class="tb-custom__swatches">
                    @foreach (var color in _catalog.Colors)
                    {
                        <button type="button"
                                class="tb-swatch @(_color == color.Id ? "tb-swatch--on" : "")"
                                style="--swatch: @color.Swatch"
                                title="@color.Name"
                                aria-label="@color.Name"
                                @onclick="@(() => SetAsync("setColor", color.Id))"></button>
                    }
                </div>
            </section>

            <section class="tb-custom">
                <div class="tb-custom__label">바탕 톤</div>
                <div class="tb-custom__swatches">
                    @foreach (var tone in _catalog.Bases)
                    {
                        <button type="button"
                                class="tb-swatch @(_base == tone.Id ? "tb-swatch--on" : "")"
                                style="--swatch: @tone.Swatch"
                                title="@tone.Name"
                                aria-label="@tone.Name"
                                @onclick="@(() => SetAsync("setBase", tone.Id))"></button>
                    }
                </div>
            </section>

            <section class="tb-custom">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="tb-custom__label mb-0">모서리</div>
                    <span class="tb-custom__value">@_radius</span>
                </div>
                <div class="tb-slider-box">
                    <input type="range" class="tb-range-slider" min="0" max="5" step="0.5"
                           value="@_radius"
                           @oninput="@(e => OnRadiusInput(e.Value?.ToString()))"
                           @onchange="@(e => SetRadiusAsync(e.Value?.ToString()))" />
                    <div class="tb-slider-ticks">
                        <span>0</span>
                        <span>1</span>
                        <span>2</span>
                        <span>3</span>
                        <span>4</span>
                        <span>5</span>
                    </div>
                </div>
            </section>

            <section class="tb-custom">
                <div class="tb-custom__label">글꼴</div>
                <div class="tb-custom__options">
                    @foreach (var font in _catalog.Fonts ?? [])
                    {
                        <button type="button"
                                class="tb-pill tb-pill--font-@font.Id @(_font == font.Id ? "tb-pill--on" : "")"
                                @onclick="@(() => SetAsync("setFont", font.Id))">
                            @font.Name
                        </button>
                    }
                </div>
            </section>

            <section class="tb-custom">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="tb-custom__label mb-0">크기</div>
                    <span class="tb-custom__value">@GetSizeName(_sizeStep)</span>
                </div>
                <div class="tb-slider-box">
                    <input type="range" class="tb-range-slider" min="0" max="@GetSizeMax()" step="1"
                           value="@GetSizeIndex(_sizeStep)"
                           @oninput="@(e => OnSizeInput(e.Value?.ToString()))"
                           @onchange="@(e => OnSizeChangeAsync(e.Value?.ToString()))" />
                    <div class="tb-slider-ticks">
                        <span>가장작게</span>
                        <span>보통</span>
                        <span>최대한크게</span>
                    </div>
                </div>
            </section>

        </div>
    </ChildContent>
</RightSideDrawer>
