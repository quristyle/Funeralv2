@*
    AI 대화 알맹이 — ChatGPT 웹/모바일 UI/UX 스타일 (D11).
    화면 하나(`/site/ai/chat`)와 헤더에서 여는 서랍이 공용으로 쓰며,
    데스크탑과 모바일 모든 환경에서 최상의 대화 경험을 제공한다.
*@

@implements IDisposable

<div class="jsini-chat @(IsDrawer ? "jsini-chat--drawer" : "jsini-chat--full")">
    @* ── 상단 바 (ChatGPT Header Bar) ─────────────────────────── *@
    <header class="jsini-chat__header">
        <div class="jsini-chat__header-left">
            <button type="button" class="jsini-chat__header-btn jsini-chat__header-btn--history"
                    title="대화 목록 열기" @onclick="ToggleHistory">
                <span class="jsini-icon-menu" aria-hidden="true"></span>
                <span class="jsini-chat__header-btn-text">목록</span>
            </button>

            @if (_who is { Length: > 0 })
            {
                <div class="jsini-chat__model-badge" title="@_whoHint">
                    <span class="jsini-chat__who-dot @(_whoLive ? "is-live" : "")"></span>
                    <span class="jsini-chat__model-name">@(_whoLive ? _who : "JSini AI")</span>
                </div>
            }
        </div>

        <div class="jsini-chat__header-center">
            @if (_renaming)
            {
                <div class="jsini-chat__header-rename">
                    <DxTextBox @bind-Text="@_renameText"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="주제 이름"
                               CssClass="jsini-chat__rename-box" />
                    <button type="button" class="jsini-chat__header-action-btn" title="저장" @onclick="SaveRenameAsync">
                        <span class="jsini-icon-check"></span>
                    </button>
                    <button type="button" class="jsini-chat__header-action-btn" title="취소" @onclick="@(() => _renaming = false)">
                        <span class="jsini-icon-close"></span>
                    </button>
                </div>
            }
            else
            {
                <div class="jsini-chat__header-title" title="@CurrentTitle (클릭하여 이름 변경)" @onclick="BeginRename">
                    <span class="jsini-chat__title-text">@CurrentTitle</span>
                    @if (_sessionId is not null)
                    {
                        <span class="jsini-icon-edit jsini-chat__title-edit-icon" aria-hidden="true"></span>
                    }
                </div>
            }
        </div>

        <div class="jsini-chat__header-right">
            <button type="button" class="jsini-chat__header-btn jsini-chat__header-btn--new"
                    title="새 대화 시작" disabled="@_streaming" @onclick="StartNewChatAsync">
                <span class="jsini-icon-plus" aria-hidden="true"></span>
                <span class="jsini-chat__header-btn-text">새 대화</span>
            </button>

            @if (_sessionId is not null)
            {
                <button type="button" class="jsini-chat__header-btn jsini-chat__header-btn--danger"
                        title="이 대화 지우기" disabled="@_streaming" @onclick="ConfirmDeleteAsync">
                    <span class="jsini-icon-trash" aria-hidden="true"></span>
                </button>
            }
        </div>
    </header>

    @* ── 대화 히스토리 오프캔버스 패널 (ChatGPT History Drawer) ───── *@
    @if (_historyOpen)
    {
        <div class="jsini-chat__history-scrim" @onclick="CloseHistory"></div>
        <aside class="jsini-chat__history-panel" aria-label="대화 기록">
            <div class="jsini-chat__history-header">
                <div class="jsini-chat__history-header-left">
                    <span class="jsini-icon-robot jsini-chat__history-header-icon" aria-hidden="true"></span>
                    <span class="jsini-chat__history-title">대화 기록</span>
                </div>
                <button type="button" class="jsini-chat__history-close" title="닫기" @onclick="CloseHistory">
                    <span class="jsini-icon-close" aria-hidden="true"></span>
                </button>
            </div>

            <div class="jsini-chat__history-new">
                <button type="button" class="jsini-chat__history-new-btn" @onclick="StartNewChatAsync">
                    <span class="jsini-icon-plus" aria-hidden="true"></span>
                    <span>새 대화 시작</span>
                </button>
            </div>

            <div class="jsini-chat__history-list">
                @if (_sessions.Count == 0)
                {
                    <div class="jsini-chat__history-empty">
                        <p>아직 나눈 대화가 없습니다.</p>
                        <span>새로운 대화를 시작해보세요.</span>
                    </div>
                }
                @foreach (var session in _sessions)
                {
                    var isSelected = session.Id == _sessionId;
                    <div class="jsini-chat__history-item @(isSelected ? "is-selected" : "")"
                         @onclick="@(() => SelectSessionAsync(session.Id))">
                        <div class="jsini-chat__history-item-main">
                            <span class="jsini-icon-robot jsini-chat__history-item-icon" aria-hidden="true"></span>
                            <span class="jsini-chat__history-item-title" title="@session.Label">@session.Label</span>
                        </div>
                        <div class="jsini-chat__history-item-meta">
                            <span class="jsini-chat__history-item-time">
                                @session.UpdatedAt.ToLocalTime().ToString("MM.dd HH:mm")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </aside>
    }

    @* ── 메시지 영역 (ChatGPT Message Feed) ─────────────────────── *@
    <div class="jsini-chat__log" @ref="_logRef">
        <div class="jsini-chat__feed-container">
            @if (_messages.Count == 0)
            {
                <div class="jsini-chat__welcome">
                    <div class="jsini-chat__welcome-symbol">
                        <span class="jsini-icon-robot" aria-hidden="true"></span>
                    </div>
                    <h2 class="jsini-chat__welcome-heading">무엇을 도와드릴까요?</h2>
                    <p class="jsini-chat__welcome-sub">
                        포털 시스템 사용법, 업무 절차, 기술 관련 질문을 자유롭게 물어보세요.
                    </p>

                    <div class="jsini-chat__prompt-grid">
                        <button type="button" class="jsini-chat__prompt-card"
                                @onclick="@(() => AskPromptAsync("프로젝트관리 WBS 화면에서 작업 일정과 진척도를 확인하는 방법을 알려줘"))">
                            <span class="jsini-chat__prompt-badge">📋 일정 조회</span>
                            <strong class="jsini-chat__prompt-title">WBS 작업 일정 및 진척도</strong>
                            <span class="jsini-chat__prompt-desc">프로젝트 일정 확인 방법 안내</span>
                        </button>

                        <button type="button" class="jsini-chat__prompt-card"
                                @onclick="@(() => AskPromptAsync("헬프데스크에서 고장 접수나 지원 요청을 등록하는 절차를 설명해줘"))">
                            <span class="jsini-chat__prompt-badge">🛠️ 지원 요청</span>
                            <strong class="jsini-chat__prompt-title">헬프데스크 요청 등록 절차</strong>
                            <span class="jsini-chat__prompt-desc">고장 접수 및 업무 지원 신청 안내</span>
                        </button>

                        <button type="button" class="jsini-chat__prompt-card"
                                @onclick="@(() => AskPromptAsync("포털에서 내가 자주 쓰는 메뉴를 찾고 바로가기로 지정하는 방법 알려줘"))">
                            <span class="jsini-chat__prompt-badge">🔍 메뉴 바로가기</span>
                            <strong class="jsini-chat__prompt-title">메뉴 검색 및 즐겨찾기</strong>
                            <span class="jsini-chat__prompt-desc">주요 기능 찾기 및 하단 띠 설정</span>
                        </button>

                        <button type="button" class="jsini-chat__prompt-card"
                                @onclick="@(() => AskPromptAsync("포털 AI 어시스턴트가 제공하는 주요 기능과 활용 팁을 알려줘"))">
                            <span class="jsini-chat__prompt-badge">💡 AI 활용 팁</span>
                            <strong class="jsini-chat__prompt-title">AI 비서 기능 및 활용 가이드</strong>
                            <span class="jsini-chat__prompt-desc">빠른 지시와 질의응답 활용 팁</span>
                        </button>
                    </div>
                </div>
            }

            @for (var i = 0; i < _messages.Count; i++)
            {
                var message = _messages[i];
                var index = i;
                var isMe = message.Role == "user";

                <div class="jsini-chat__row @(isMe ? "jsini-chat__row--user" : "jsini-chat__row--ai")">
                    @if (!isMe)
                    {
                        <div class="jsini-chat__avatar" aria-hidden="true">
                            <span class="jsini-icon-robot"></span>
                        </div>
                    }

                    <div class="jsini-chat__message-content">
                        @if (!isMe)
                        {
                            <div class="jsini-chat__author-name">JSini AI</div>
                        }

                        <div class="jsini-chat__bubble">
                            @message.Content
                            @if (!isMe && _streaming && index == _messages.Count - 1)
                            {
                                <span class="jsini-chat__cursor" aria-hidden="true"></span>
                            }
                        </div>

                        @if (!isMe && !string.IsNullOrWhiteSpace(message.Content))
                        {
                            <div class="jsini-chat__message-tools">
                                <button type="button" class="jsini-chat__tool-btn" title="답변 복사"
                                        @onclick="@(() => CopyMessageAsync(message.Content, index))">
                                    <span class="@(_copiedIndex == index ? "jsini-icon-check" : "jsini-icon-copy")" aria-hidden="true"></span>
                                    <span>@(_copiedIndex == index ? "복사됨!" : "복사")</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_notices.Count > 0)
            {
                <div class="jsini-chat__notices">
                    @foreach (var notice in _notices)
                    {
                        <div class="jsini-chat__notice">
                            <span class="jsini-icon-bolt jsini-chat__notice-icon" aria-hidden="true"></span>
                            <span>@notice</span>
                        </div>
                    }
                </div>
            }

            @if (_streaming && _messages.Count > 0 && string.IsNullOrEmpty(_messages[^1].Content))
            {
                <div class="jsini-chat__typing">
                    <div class="jsini-chat__avatar jsini-chat__avatar--small" aria-hidden="true">
                        <span class="jsini-icon-robot"></span>
                    </div>
                    <div class="jsini-chat__typing-bubble">
                        <span class="jsini-chat__typing-dot"></span>
                        <span class="jsini-chat__typing-dot"></span>
                        <span class="jsini-chat__typing-dot"></span>
                    </div>
                    <span class="jsini-chat__typing-text">답변을 생성하고 있습니다…</span>
                </div>
            }
        </div>
    </div>

    @* ── 하단 입력 영역 (ChatGPT Pill Input Container) ─────────── *@
    <div class="jsini-chat__input-area">
        <div class="jsini-chat__input-container" @ref="_inputRef" @onkeydown="@OnKeyDownAsync">
            <div class="jsini-chat__capsule">
                <DxMemo @bind-Text="@_input"
                        BindValueMode="BindValueMode.OnInput"
                        Rows="1"
                        MaxRows="6"
                        ResizeMode="MemoResizeMode.Auto"
                        NullText="메시지를 입력하세요 (줄바꿈은 Shift+Enter)"
                        Enabled="@(!_streaming)"
                        CssClass="jsini-chat__textarea" />

                <div class="jsini-chat__capsule-actions">
                    @if (_streaming)
                    {
                        <button type="button" class="jsini-chat__circle-btn jsini-chat__circle-btn--stop"
                                title="답변 생성 중단" @onclick="StopGenerating">
                            <span class="jsini-icon-stop" aria-hidden="true"></span>
                        </button>
                    }
                    else
                    {
                        var canSend = !string.IsNullOrWhiteSpace(_input);
                        <button type="button"
                                class="jsini-chat__circle-btn jsini-chat__circle-btn--send @(canSend ? "is-active" : "")"
                                title="전송" disabled="@(!canSend)" @onclick="SendAsync">
                            <span class="jsini-icon-arrow-up" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </div>

            <p class="jsini-chat__disclaimer">
                AI는 실수를 할 수 있습니다. 중요한 정보는 다시 확인하세요.
            </p>
        </div>
    </div>
</div>

<ConfirmDialog @ref="_confirm" />
