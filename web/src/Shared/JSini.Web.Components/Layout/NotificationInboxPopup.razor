@using JSini.Web.Models

<CommPopup Visible="@Visible"
           VisibleChanged="@OnVisibleChangedAsync"
           HeaderText="알림"
           Width="min(40rem, calc(100vw - 2rem))"
           ShowFooter="false"
           CssClass="jsini-note-popup">
    
    <BodyContentTemplate>
        @if (_notifications.Count == 0)
        {
            <div class="text-center p-4 text-muted">
                새로운 알림이 없습니다.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2 mb-3">
                @foreach (var note in _notifications)
                {
                    <div class="card shadow-sm" @onclick="@(() => OpenAsync(note))" style="cursor: pointer;">
                        <div class="card-body">
                            <h6 class="card-title text-primary mb-1">@note.Title</h6>
                            <p class="card-text mb-2" style="font-size: 0.9rem;">@note.Body</p>
                            <div class="text-end text-muted" style="font-size: 0.75rem;">
                                @(note.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end border-top pt-3">
                <DxButton Text="모두 읽음 처리" RenderStyle="ButtonRenderStyle.Secondary" Click="@MarkAllReadAsync" />
            </div>
        }
    </BodyContentTemplate>

</CommPopup>
