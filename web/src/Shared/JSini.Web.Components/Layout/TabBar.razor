@*
    열어 둔 화면 탭 줄. vben 의 tabbar 를 옮긴 것이다.

    [DxTabs 를 쓰지 않았다]

    DxTabs 는 탭마다 내용을 안고 있는 부품이다. 여기 필요한 것은 **주소 목록**
    뿐이고 내용은 라우터가 그린다(PortalTabs 주석 참고). DxTabs 에 빈 탭을
    늘어놓으면 탭 수만큼 빈 패널이 만들어지고, 닫기·고정·오른쪽 메뉴를 다시
    붙여야 해서 얻는 것이 없다.

    [탭이 라우팅을 하지 않는다]

    누르면 `NavigationManager` 로 이동하고, **이동한 결과를 보고** 탭이 켜진다.
    반대로 만들면 주소와 화면이 어긋나서 새로 고침·뒤로 가기·즐겨찾기가 깨진다.

    [메뉴는 하나다. 여는 길이 둘일 뿐이다]

    오른쪽 클릭은 **누른 탭**을, 오른쪽 끝의 「⋯」 은 **보고 있는 탭**을 다룬다.
    다른 것은 대상뿐이고 **항목은 같다.**

    한동안 「⋯」 이 자기 항목을 따로 들고 있었고 셋뿐이었다. 그래서 같은
    자리에서 할 수 있는 일이 어느 쪽으로 열었느냐에 따라 달랐다 — 「아까는
    있던 항목이 없다」가 된다.

    창은 하나만 두고 `_target` 을 갈아 끼운다. 탭마다 창을 그리면 탭 열두 개에
    창 열두 개가 만들어지고, 그 안의 항목까지 전부 다시 그려진다.

    [고정한 탭은 새로고침 뒤에도 남는다]

    브라우저에 적어 둔다(`localStorage`). 왜 서버가 아닌지는 아래 저장 코드의
    주석에 적었다.
*@

@implements IDisposable

@using System.Text.Json

@inject PortalTabs Tabs
@inject MenuFavorites Favorites
@inject NavigationManager Navigation
@inject IJSRuntime Js

@if (Tabs.Items.Count > 0)
{
    <div class="jsini-tabs">
        <div class="jsini-tabs__list">
            @foreach (var tab in Tabs.Items)
            {
                var active = string.Equals(tab.Href, Tabs.ActiveHref, StringComparison.OrdinalIgnoreCase);

                <div class="jsini-tab @(active ? "jsini-tab--active" : "") @(tab.Pinned ? "jsini-tab--pinned" : "")"
                     @oncontextmenu="@(args => OpenMenuAsync(args, tab))"
                     @oncontextmenu:preventDefault="true">
                    <a class="jsini-tab__link" href="@tab.Href" title="@tab.Href">
                        @if (tab.Pinned)
                        {
                            <span class="jsini-icon-pin" aria-hidden="true"></span>
                        }
                        @tab.Title
                    </a>

                    @* 고정한 탭은 닫기 단추를 그리지 않는다. 그려 두고 눌러도
                       안 닫히면 고장으로 읽힌다. *@
                    @if (!tab.Pinned)
                    {
                        <button type="button" class="jsini-tab__close"
                                title="닫기" aria-label="@($"{tab.Title} 닫기")"
                                @onclick="@(() => Close(tab.Href))">×</button>
                    }
                </div>
            }
        </div>

        @* 오른쪽 끝 단추. 오른쪽 클릭과 **같은 창**을 연다 — 대상만 「보고 있는
           탭」으로 바뀐다. 항목을 따로 적어 두었을 때 셋만 있었고, 그래서
           같은 자리에서 할 수 있는 일이 어느 쪽으로 열었느냐에 따라 달랐다. *@
        <span id="jsini-tabs-more">
            <DxButton IconCssClass="jsini-icon-more"
                      RenderStyle="ButtonRenderStyle.Link"
                      Title="탭"
                      Click="@OpenMenuForActiveAsync" />
        </span>
    </div>

    @* 오른쪽 클릭 창. 항목은 `_target` 을 보고 그때그때 이름이 바뀐다
       (고정/고정 해제 · 담기/빼기). 대상이 없으면 아무것도 그리지 않는다. *@
    <DxContextMenu @ref="_menu" CssClass="jsini-tabmenu" PositionTarget="#jsini-tabs-more">
        <Items>
            @if (_target is { } t)
            {
                <DxContextMenuItem Text="새로 고침"
                                   IconCssClass="jsini-icon-refresh"
                                   Enabled="@IsActive(t)"
                                   Click="@(() => Refresh(t))" />

                <DxContextMenuItem Text="@(t.Pinned ? "고정 해제" : "고정")"
                                   IconCssClass="jsini-icon-pin"
                                   Click="@(() => Tabs.TogglePin(t.Href))" />

                <DxContextMenuItem Text="@(IsFavorite(t) ? "즐겨찾기에서 빼기" : "즐겨찾기에 담기")"
                                   IconCssClass="@(IsFavorite(t) ? "jsini-icon-star-on" : "jsini-icon-star")"
                                   Enabled="@(MenuPathOf(t).Length > 0)"
                                   Click="@(() => ToggleFavoriteAsync(t))" />

                <DxContextMenuItem Text="새 창으로 열기"
                                   IconCssClass="jsini-icon-expand"
                                   Click="@(() => OpenInNewWindowAsync(t))" />

                @* 여기부터 닫는 것들. 구분선을 두는 이유는 위쪽이 되돌릴 수 있는
                   일이고 아래쪽은 그렇지 않기 때문이다. *@
                <DxContextMenuItem Text="닫기"
                                   IconCssClass="jsini-icon-close"
                                   BeginGroup="true"
                                   Enabled="@(!t.Pinned)"
                                   Click="@(() => Close(t.Href))" />

                <DxContextMenuItem Text="왼쪽 탭 닫기"
                                   Enabled="@(HasClosableSide(t, left: true))"
                                   Click="@(() => GoAfter(Tabs.CloseLeft(t.Href)))" />

                <DxContextMenuItem Text="오른쪽 탭 닫기"
                                   Enabled="@(HasClosableSide(t, left: false))"
                                   Click="@(() => GoAfter(Tabs.CloseRight(t.Href)))" />

                <DxContextMenuItem Text="다른 탭 닫기"
                                   Click="@(() => GoAfter(Tabs.CloseOthers(t.Href)))" />

                <DxContextMenuItem Text="모두 닫기"
                                   Click="@CloseAll" />
            }
        </Items>
    </DxContextMenu>
}

@code {
    private DxContextMenu? _menu;

    /// <summary>오른쪽 클릭한 탭. 창이 열려 있는 동안만 값이 있다.</summary>
    private PortalTab? _target;

    /// <summary>적어 둔 고정 탭을 이미 되살렸는가. 회로마다 한 번만 읽는다.</summary>
    private bool _restored;

    /// <summary>고정 탭을 적어 두는 자리. 브라우저(이 기기)에 남는다.</summary>
    private const string PinnedKey = "jsini-tabs-pinned";

    protected override void OnInitialized()
    {
        Tabs.Changed += OnTabsChanged;
        Tabs.PinsChanged += OnPinsChanged;
        Favorites.Changed += OnTabsChanged;
    }

    private void OnTabsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// 오른쪽 클릭한 자리에 창을 연다.
    ///
    /// <para>
    /// 대상을 먼저 세우고 <b>한 번 다시 그린 뒤</b> 연다. 안 그러면 창이 이전
    /// 대상의 항목(고정/담기 여부)을 그린 채로 뜬다 — 이름만 틀린 것이 아니라
    /// 누르면 다른 탭이 닫힌다.
    /// </para>
    /// </summary>
    private async Task OpenMenuAsync(MouseEventArgs args, PortalTab tab)
    {
        _target = tab;
        StateHasChanged();

        if (_menu is not null)
        {
            await _menu.ShowAsync(args);
        }
    }

    /// <summary>
    /// 오른쪽 끝 단추로 여는 길. <b>대상이 「보고 있는 탭」이라는 것만 다르고</b>
    /// 항목은 오른쪽 클릭과 똑같다.
    /// </summary>
    private async Task OpenMenuForActiveAsync()
    {
        _target = Tabs.Items.FirstOrDefault(IsActive) ?? Tabs.Items.FirstOrDefault();
        StateHasChanged();

        if (_menu is not null && _target is not null)
        {
            await _menu.ShowAsync(ContextMenuPosition.Bottom);
        }
    }

    private bool IsActive(PortalTab tab) =>
        string.Equals(tab.Href, Tabs.ActiveHref, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// 이 탭의 <b>DB 메뉴 경로</b>. 즐겨찾기는 이 값으로 담긴다.
    ///
    /// <para>
    /// 탭이 들고 있는 것은 링크 주소(<c>/funeral/room-status</c>)인데 즐겨찾기
    /// 표에 쌓인 것은 DB 경로(<c>/room_status</c>)다. 섞으면 이미 담아 둔 것이
    /// 안 담긴 것으로 보인다(<c>MenuFavorites</c> 주석 참고).
    /// </para>
    /// </summary>
    private static string MenuPathOf(PortalTab tab) => RouteAliases.ToMenuPath(tab.Href);

    private bool IsFavorite(PortalTab tab) => Favorites.Contains(MenuPathOf(tab));

    private async Task ToggleFavoriteAsync(PortalTab tab)
    {
        if (MenuPathOf(tab) is { Length: > 0 } path)
        {
            await Favorites.ToggleAsync(path);
        }
    }

    /// <summary>
    /// 같은 주소로 다시 이동시켜 화면만 새로 만든다. <c>forceLoad</c> 를 켜지
    /// 않는다 — 켜면 문서를 새로 받아 회로가 끊기고 탭이 통째로 사라진다.
    /// </summary>
    private void Refresh(PortalTab tab) =>
        Navigation.NavigateTo(tab.Href, forceLoad: false, replace: true);

    private Task OpenInNewWindowAsync(PortalTab tab) =>
        Js.InvokeVoidAsync("open", tab.Href, "_blank", "noopener").AsTask();

    /// <summary>그쪽에 닫을 것이 하나라도 있는가. 없으면 항목을 꺼 둔다.</summary>
    private bool HasClosableSide(PortalTab tab, bool left)
    {
        var pivot = Tabs.Items.ToList().FindIndex(t =>
            string.Equals(t.Href, tab.Href, StringComparison.OrdinalIgnoreCase));

        if (pivot < 0)
        {
            return false;
        }

        return Tabs.Items
            .Select((t, i) => (t, i))
            .Any(x => !x.t.Pinned && (left ? x.i < pivot : x.i > pivot));
    }

    private void Close(string href) => GoAfter(Tabs.Close(href));

    private void CloseAll() => Navigation.NavigateTo(Tabs.CloseAll());

    /* ── 고정 탭은 브라우저에 적어 둔다 ──────────────────────────

       탭 목록은 회로 하나(= 브라우저 탭 하나)에 사는 값이라 F5 를 누르면
       회로와 함께 사라진다. 고정은 「이 화면은 늘 열어 둔다」는 뜻이라 그렇게
       사라지면 기능이 없는 것과 같다 — 실제로 「고정해 두고 새로고침하면
       고정이 풀려 있다」로 나타났다.

       [왜 서버가 아니라 브라우저인가]

       고정은 **이 기기에서 지금 하는 일**에 대한 표시다. 사무실에서 고정해
       둔 탭이 집 노트북에서도 열리면 그건 즐겨찾기지 고정이 아니다.
       즐겨찾기는 이미 서버에 있다(`MenuFavorites`).

       [회로가 붙은 뒤에 읽는다]

       프리렌더 중에는 JS 를 부를 수 없다. 그래서 첫 렌더 뒤에 읽고, 읽은
       것을 되살리면 탭 줄이 한 번 더 그려진다.
    */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored)
        {
            return;
        }

        _restored = true;

        try
        {
            var saved = await Js.InvokeAsync<string?>("localStorage.getItem", PinnedKey);

            if (string.IsNullOrWhiteSpace(saved))
            {
                return;
            }

            var pinned = JsonSerializer.Deserialize<List<PinnedTab>>(saved);

            if (pinned is { Count: > 0 })
            {
                Tabs.RestorePinned(pinned);
            }
        }
        catch (JsonException)
        {
            // 적어 둔 것이 깨졌으면 지우고 넘어간다. 고정 몇 개 때문에
            // 포털이 안 열리면 안 된다.
            await Js.InvokeVoidAsync("localStorage.removeItem", PinnedKey);
        }
    }

    private async void OnPinsChanged()
    {
        try
        {
            var pinned = Tabs.PinnedTabs;

            if (pinned.Count == 0)
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", PinnedKey);
                return;
            }

            await Js.InvokeVoidAsync("localStorage.setItem", PinnedKey, JsonSerializer.Serialize(pinned));
        }
        catch (JSException)
        {
            // 저장소를 못 쓰는 브라우저(사생활 보호 모드)가 있다. 고정은 이번
            // 회로 동안 그대로 듣고, 다음 새로고침에 풀릴 뿐이다.
        }
    }

    /// <summary>탭을 닫은 결과 옮겨 갈 곳이 생겼으면 옮긴다.</summary>
    private void GoAfter(string? next)
    {
        if (next is not null)
        {
            Navigation.NavigateTo(next);
        }
    }

    public void Dispose()
    {
        Tabs.Changed -= OnTabsChanged;
        Tabs.PinsChanged -= OnPinsChanged;
        Favorites.Changed -= OnTabsChanged;
    }
}
