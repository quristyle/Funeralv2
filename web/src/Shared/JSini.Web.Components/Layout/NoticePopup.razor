@*
    [공지 팝업] — 사용자에게 공지가 실제로 보이는 화면.
    이력: Vue `components/notice/notice-popup.vue` → 여기.

    쓰는 곳이 셋이고 **셋이 같은 화면을 본다**.

      · 로그인 뒤 — `NoticeAutoPopup` 이 레이아웃에서 띄운다
      · 로그인 화면 — 같은 부품이 공개 공지만 띄운다
      · 공지 관리의 「미리보기」 — `Preview="true"`

    미리보기용 화면을 따로 만들지 않는다. 따로 만들면 둘이 갈라지고,
    갈라진 줄은 실제 공지가 사용자에게 뜬 뒤에야 안다.

    [본문은 걸러서 넣는다]

    본문이 서식(HTML)이라 `MarkupString` 으로 그린다. 그대로 넣으면 XSS 경로가
    되므로 `NoticeHtml` 이 **아는 태그와 아는 속성만** 통과시킨다. 이유는 그
    파일 주석에 적었다.

    [첨부 주소는 우리가 만든다 (D5)]

    서버가 함께 주는 `downloadUrl`(`/api/file/download/...`)을 쓰지 않는다.
    그것은 브라우저가 게이트웨이와 같은 오리진에 있던 Vue 시절 주소다.
    지금은 셸이 중계한다 — `FileDownload.UrlFor`. 로그인 여부에 따라 무엇이
    내려가는지는 그쪽 주석에 적었고, **여기서 가르지 않는다.**
*@

<DxPopup Visible="@Visible"
         VisibleChanged="@SetVisibleAsync"
         CssClass="jsini-notice"
         HeaderCssClass="jsini-notice__head"
         FooterCssClass="jsini-notice__foot"
         Width="min(640px, calc(100vw - 2rem))"
         MaxHeight="86vh"
         ShowFooter="true"
         CloseOnOutsideClick="false">

    <HeaderContentTemplate>
        @if (Current is { } head)
        {
            <div class="jsini-notice__title">
                <div class="jsini-tags">
                    <span>@head.Title</span>

                    @if (Preview)
                    {
                        <span class="jsini-badge jsini-badge--warn">미리보기</span>
                    }

                    @if (head.IsPublic)
                    {
                        <span class="jsini-badge jsini-badge--on">전체공개</span>
                    }
                </div>

                <div class="jsini-notice__meta">
                    @PostedOn(head)

                    @if (Notices.Count > 1)
                    {
                        <span> · 공지 @(_index + 1) / @Notices.Count</span>
                    }
                </div>
            </div>
        }
    </HeaderContentTemplate>

    <BodyContentTemplate>
        @if (Current is { } body)
        {
            @* 본문의 서식(제목·목록·표)이 어떻게 보이는지는 app.css 가 정한다.
               테마 CSS 는 DevExpress 부품만 겨누므로 여기 태그들은 손이 안 닿는다. *@
            <div class="jsini-notice__body">
                @if (NoticeHtml.Sanitize(body.Content) is { Length: > 0 } markup)
                {
                    @((MarkupString)markup)
                }
                else
                {
                    <p class="jsini-text-muted">내용이 없습니다.</p>
                }
            </div>

            @if (body.Files.Count > 0)
            {
                <div class="jsini-notice__files">
                    <div class="jsini-notice__files-head">첨부파일 @body.Files.Count</div>

                    @* 파일 이름을 자르지 않는다. 실제 첨부에 마흔 자짜리가 있어
                       `…` 로 가리면 무엇을 내려받는지 알 수 없고, 확장자가
                       잘리면 더 나쁘다. 자르는 대신 줄바꿈을 허용한다. *@
                    <ul class="jsini-notice__file-list">
                        @foreach (var file in body.Files)
                        {
                            <li>
                                <a class="jsini-notice__file"
                                   href="@FileDownload.UrlFor(file.FileId, file.FileName)">
                                    <span class="jsini-notice__file-name">@file.FileName</span>
                                    <span class="jsini-notice__file-size">@Human(file.FileSize)</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </BodyContentTemplate>

    <FooterContentTemplate>
        @if (Preview)
        {
            <span class="jsini-text-muted">실제 사용자에게 보이는 그대로입니다.</span>
        }
        else if (Current is not null)
        {
            @* 「오늘 하루 보지 않기」는 브라우저에만 남는다(localStorage).
               계정별로 남기려면 서버에 읽음 기록이 필요한데 공지 성격상
               그만한 무게가 아니다. 미리보기에는 두지 않는다 — 관리자가
               확인만 하는 자리라 흔적을 남기면 안 된다. *@
            <DxCheckBox @bind-Checked="_dismiss">오늘 하루 보지 않기</DxCheckBox>
        }

        <span class="jsini-notice__gap"></span>

        @* 공지가 여럿이면 어디쯤인지 점으로 보여 주고, 눌러서 바로 넘어간다. *@
        @if (Notices.Count > 1)
        {
            <div class="jsini-notice__dots">
                @for (var i = 0; i < Notices.Count; i++)
                {
                    var at = i;

                    <button type="button"
                            class="jsini-notice__dot @(at == _index ? "is-on" : null)"
                            title="@Notices[at].Title"
                            aria-label="@($"{at + 1}번째 공지")"
                            @onclick="@(() => GoTo(at))"></button>
                }
            </div>

            <DxButton Text="이전" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(_index > 0)" Click="@(() => GoTo(_index - 1))" />
        }

        <DxButton Text="@(_index < Notices.Count - 1 ? "다음" : "닫기")"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Click="@NextAsync" />
    </FooterContentTemplate>
</DxPopup>

@code {
    /// <summary>띄울 공지들. 순서대로 하나씩 넘긴다.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<NoticeDto> Notices { get; set; } = [];

    /// <summary>창이 떠 있는지.</summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>창이 닫히면 알린다.</summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>
    /// 관리 화면의 미리보기인지.
    ///
    /// <para>
    /// 딱지를 하나 더 달고, 「오늘 하루 보지 않기」 대신 안내 줄이 선다.
    /// 본문이 보이는 모양은 실제 공지와 <b>같다</b> — 그것이 이 화면을 함께
    /// 쓰는 이유다.
    /// </para>
    /// </summary>
    [Parameter] public bool Preview { get; set; }

    /// <summary>
    /// 사용자가 「오늘 하루 보지 않기」로 닫은 공지의 아이디.
    ///
    /// <para>
    /// 저장은 <c>NoticeAutoPopup</c> 이 한다 — 이 부품은 <b>무엇을 보여 줄지만</b>
    /// 안다. localStorage 를 여기서 만지면 미리보기가 흔적을 남기게 되고,
    /// 그러면 관리자가 미리보기를 한 번 열었다는 이유로 그 공지를 못 보게 된다.
    /// </para>
    /// </summary>
    [Parameter] public EventCallback<string> OnDismissed { get; set; }

    /// <summary>지금 보고 있는 공지의 자리.</summary>
    private int _index;

    /// <summary>지금 공지의 「오늘 하루 보지 않기」 체크 상태. 공지를 넘길 때마다 푼다.</summary>
    private bool _dismiss;

    /// <summary>목록이 바뀌었는지 보는 표. 같은 값이 다시 들어와도 자리를 잃지 않는다.</summary>
    private object? _seen;

    private NoticeDto? Current =>
        _index >= 0 && _index < Notices.Count ? Notices[_index] : null;

    /// <summary>
    /// 목록이 <b>실제로</b> 바뀔 때만 첫 장으로 되돌린다.
    ///
    /// <para>
    /// 렌더마다 되돌리면 「다음」을 눌러도 제자리다 — 부모가 다시 그려지는
    /// 것만으로 파라미터는 다시 들어오기 때문이다. 값이 아니라
    /// <b>참조</b>로 본다.
    /// </para>
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_seen, Notices))
        {
            return;
        }

        _seen = Notices;
        _index = 0;
        _dismiss = false;
    }

    /// <summary>다른 공지로 넘어간다. 체크는 공지마다 따로다.</summary>
    private void GoTo(int target)
    {
        if (target < 0 || target >= Notices.Count)
        {
            return;
        }

        _index = target;
        _dismiss = false;
    }

    /// <summary>「다음」은 한 장씩 넘기고, 마지막 장에서는 닫는다.</summary>
    private async Task NextAsync()
    {
        await RememberAsync();

        if (_index < Notices.Count - 1)
        {
            GoTo(_index + 1);
            return;
        }

        await SetVisibleAsync(false);
    }

    /// <summary>체크해 둔 공지를 부모에게 알린다.</summary>
    private Task RememberAsync() =>
        _dismiss && Current is { } notice && OnDismissed.HasDelegate
            ? OnDismissed.InvokeAsync(notice.Id)
            : Task.CompletedTask;

    /// <summary>
    /// 창이 닫힌다.
    ///
    /// <para>
    /// 위쪽 × 로 닫는 것도 여기로 온다. 그때도 체크해 둔 것은 기억한다 —
    /// × 는 「더 보지 않겠다」는 뜻이라 체크를 무시하면 다음에 또 뜬다.
    /// </para>
    /// </summary>
    private async Task SetVisibleAsync(bool visible)
    {
        if (!visible)
        {
            await RememberAsync();
        }

        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }

    /// <summary>게시일. 시작일이 있으면 그것을, 없으면 등록일을 보여 준다.</summary>
    private static string PostedOn(NoticeDto notice) =>
        (notice.StartAt ?? notice.CreatedAt).ToString("yyyy. MM. dd.");

    /// <summary>사람이 읽는 크기.</summary>
    private static string Human(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024 / 1024:0.#} GB",
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B",
    };
}
