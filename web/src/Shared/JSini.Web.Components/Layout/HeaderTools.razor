@*
    상단 오른쪽 도구 묶음. vben 헤더에 있던 것들을 옮겼다.

      · 즐겨찾기 — 지금 화면을 담고 뺀다 (백엔드에 표가 그대로 남아 있었다)
      · 새로 고침 — 화면만 다시 그린다
      · 전체화면 — 상황판에 띄워 두는 화면에서 쓴다
      · 알림      — 안 읽은 것이 있으면 점이 붙는다

    [새로 고침이 F5 가 아니다]

    브라우저를 새로 고치면 회로가 끊어졌다 다시 붙고 메뉴·권한까지 다시 읽는다.
    사용자가 원하는 것은 대개 **이 표만 다시 읽는 것**이라, 같은 주소로 다시
    이동시켜 화면 컴포넌트만 새로 만든다.
*@

@implements IDisposable

@inject MenuFavorites Favorites
@inject NavigationManager Navigation
@inject IJSRuntime Js

<DxButton RenderStyle="ButtonRenderStyle.Link"
          IconCssClass="@(IsFavorite ? "jsini-icon-star-on" : "jsini-icon-star")"
          Title="@(IsFavorite ? "즐겨찾기에서 빼기" : "즐겨찾기에 담기")"
          Enabled="@(MenuPath is not null)"
          Click="@ToggleFavoriteAsync" />

<DxButton RenderStyle="ButtonRenderStyle.Link"
          IconCssClass="jsini-icon-refresh"
          Title="화면 새로 고침"
          Click="@Refresh" />

<DxButton RenderStyle="ButtonRenderStyle.Link"
          IconCssClass="jsini-icon-expand"
          Title="전체화면"
          Click="@ToggleFullScreenAsync" />

<DxButton RenderStyle="ButtonRenderStyle.Link"
          IconCssClass="jsini-icon-bell"
          Title="알림"
          Click="@(() => Navigation.NavigateTo("/admin/push/history"))" />

@code {
    /// <summary>
    /// 지금 화면의 <b>DB 메뉴 경로</b>. 즐겨찾기는 이 값으로 담긴다.
    ///
    /// 링크 주소가 아니다 — 즐겨찾기 표에 쌓인 값이 DB 경로라 섞으면 이미
    /// 담아 둔 것이 안 담긴 것으로 보인다(MenuFavorites 주석 참고).
    /// 메뉴에 없는 화면이면 <c>null</c> 이고, 그때는 별 단추가 꺼진다.
    /// </summary>
    [Parameter] public string? MenuPath { get; set; }

    private bool IsFavorite => Favorites.Contains(MenuPath);

    protected override void OnInitialized() => Favorites.Changed += OnFavoritesChanged;

    private void OnFavoritesChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleFavoriteAsync()
    {
        if (MenuPath is { Length: > 0 } path)
        {
            await Favorites.ToggleAsync(path);
        }
    }

    /// <summary>
    /// 같은 주소로 다시 이동시켜 화면만 새로 만든다.
    ///
    /// <c>forceLoad</c> 를 켜지 않는다. 켜면 문서를 새로 받아 회로가 끊어지고
    /// 메뉴·권한·탭이 전부 다시 만들어진다 — 그건 F5 와 같다.
    /// </summary>
    private void Refresh() =>
        Navigation.NavigateTo(Navigation.Uri, forceLoad: false, replace: true);

    private Task ToggleFullScreenAsync() =>
        Js.InvokeAsync<bool>("jsiniScreen.toggle").AsTask();

    public void Dispose() => Favorites.Changed -= OnFavoritesChanged;
}
