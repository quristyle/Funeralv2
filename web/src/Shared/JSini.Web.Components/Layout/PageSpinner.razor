@implements IDisposable

@*
    화면을 옮기는 동안 본문 위에 덮는 표시. 그림은 Vue 판의 상승 조각 넷을 옮겼고, 심볼은 굴리지 않는다(브랜드 규칙).
    언제 보일지는 CSS 가 정한다 — 나타날 때만 transition-delay 로 늦춘다. 타이머로 다스리면 이동 한 번에 그림을 두 번 더 밀어내고, 늦춤보다 빨리 끝난 이동은 켜졌다 꺼지는 깜빡임이 없다. 덮개는 늘 DOM 에 두고 클래스만 바꾼다.
*@

<div class="jsini-pageload @(Transition.IsBusy ? "is-on" : null)" aria-hidden="true">
    <svg class="jsini-loader" viewBox="0 0 48 48" role="img" aria-label="화면을 여는 중">
        <g transform="translate(4.84,0) skewX(-12.4)">
            <rect class="jsini-loader__bar" x="5" y="28" width="6" height="16" opacity="0.3" />
            <rect class="jsini-loader__bar" x="16" y="22" width="6" height="22" opacity="0.5" />
            <rect class="jsini-loader__bar" x="27" y="16" width="6" height="28" opacity="0.75" />
            <rect class="jsini-loader__bar" x="38" y="10" width="6" height="34" opacity="1" />
        </g>
    </svg>
</div>
