@*
    헤더에서 업무 비서(/admin/ai/assistant)로 가는 단추. AI 대화 단추 바로 옆에 선다.
    답이 표·목록을 실어 나르는 전체 폭 화면이라 서랍으로 열지 않고 그 화면으로 옮긴다.
*@
@implements IDisposable

@if (AssistantMenu is { } menu && HeaderIcons.IsIconEnabled(IconKey))
{
    @* 좌우 여백을 「조금작게」에서 멈춘다 — AiChatToggle 과 같은 까닭(ThemeSize.Chrome). *@
    <CascadingValue Name="@ThemeSize.CascadeName" TValue="SizeMode?" Value="@Size.Chrome">
        <DxButton RenderStyle="ButtonRenderStyle.Link"
                  IconCssClass="jsini-icon-briefcase"
                  Title="@($"{menu.Title} — 업무 자료를 AI 에게 묻기")"
                  Click="@(() => Open(menu))" />
    </CascadingValue>
}
