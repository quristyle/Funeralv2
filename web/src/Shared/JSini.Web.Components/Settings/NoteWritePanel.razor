@*
    [쪽지 쓰기] — 받는 사람을 **적어서** 보낸다.

    ────────────────────────────────────────────────────────────
    [`NotifySendPopup` 과 무엇이 다른가]

    그쪽은 **이미 고른 사람들**(생일 목록의 선택 줄 따위)에게 두드림 한 통을
    보내고 남는 것은 발송 기록뿐이다. 이쪽은 **아이디나 이메일을 손으로 적어**
    사람을 정하고, 글이 상대의 쪽지함에 남는다 — 앱 푸시도 메일도 다 막혀도.

    ────────────────────────────────────────────────────────────
    [받는 사람을 적는 칸이 하나다]

    아이디 칸과 이메일 칸을 나누지 않는다. 사람이 아는 것이 그때그때 다르고,
    나눠 두면 「이건 어느 칸이지」를 매번 묻게 된다. 한 칸에 적으면 **서버가
    푼다** — 아이디로 걸리면 아이디고, 아니면 이메일로 찾는다.

    적은 것은 곧바로 **딱지(chip)** 가 된다. 글자로 남겨 두면 쉼표를 빠뜨렸을
    때 두 사람이 한 사람으로 뭉쳐 「그런 아이디가 없습니다」가 되는데, 그때
    무엇이 잘못됐는지 화면만 봐서는 안 보인다.

    ────────────────────────────────────────────────────────────
    [찾기는 **거들 뿐**이다]

    두 글자부터 아이디·이름·이메일로 찾아 보여 준다. 그런데 **보내기는 그
    결과를 쓰지 않는다** — 서버가 딱지에 적힌 글자에서 다시 푼다. 화면이 푼
    아이디를 그대로 믿으면 브라우저에서 갈아 끼워 남의 이름으로 보낼 수 있다
    (`NoteClient.SearchRecipientsAsync` 머리말).

    ────────────────────────────────────────────────────────────
    [메일은 꺼져 있고, 앱 푸시는 켜져 있다]

    쪽지는 이미 쪽지함에 남는다. 메일까지 기본으로 켜면 **받는 쪽에 지워야 할
    것이 하나 늘어난다.** 둘 다 꺼도 된다 — 그때는 조용히 쪽지함에만 들어가고,
    화면이 그 사실을 미리 말한다.

    ────────────────────────────────────────────────────────────
    [결과를 두 갈래로 말한다]

    쪽지가 간 것과 두드림이 간 것은 다른 일이다. 푸시가 0 대에 갔다고 실패로
    말하면 보낸 사람이 같은 쪽지를 한 번 더 보내고, 상대의 쪽지함에는 두 통이
    쌓인다. **쪽지함에 들어갔으면 보낸 것**이고 두드림은 뒤에 덧붙인다.
*@

@inject NoteClient Notes
@inject Toasts Toasts

<div class="jsini-note">

    @* ── 받는 사람 ─────────────────────────────────────────── *@
    <div class="jsini-note__field">
        <span class="jsini-note__label">받는 사람</span>

        <div class="jsini-note__to">
            @if (_picked.Count == 0)
            {
                <span class="jsini-note__empty">아이디나 이메일을 적고 Enter 를 누르십시오.</span>
            }
            else
            {
                @foreach (var who in _picked)
                {
                    <span class="jsini-note__chip" title="@who">
                        <span>@who</span>
                        @* 딱지를 빼는 ×. 단추가 아니라 글자면 좁은 화면에서 못 누른다. *@
                        <DxButton RenderStyle="ButtonRenderStyle.Link"
                                  IconCssClass="jsini-icon-close"
                                  Title="@($"{who} 빼기")"
                                  Click="@(() => Remove(who))" />
                    </span>
                }
            }
        </div>

        @* 폼을 쓰지 않는다. 이 부품이 서랍·팝업 안에도 들어가는데 거기서 폼은
           진짜 POST 로 새는 길이 된다(`AiChatPanel` 과 같은 자리). *@
        <div class="jsini-note__pick" @onkeydown="@OnEntryKeyAsync">
            <DxTextBox @bind-Text="@_entry"
                       BindValueMode="BindValueMode.OnInput"
                       NullText="아이디 · 이메일 · 이름"
                       ValidationEnabled="false"
                       CssClass="jsini-note__input" />

            <DxButton Text="추가" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!string.IsNullOrWhiteSpace(_entry))"
                      Click="@(() => AddEntry())" />
        </div>

        @* 찾은 사람들. 누르면 딱지가 된다 — **아이디로 넣는다.** 이름으로
           넣으면 같은 이름이 둘일 때 서버가 못 푼다. *@
        @if (_matches.Count > 0)
        {
            <ul class="jsini-note__matches">
                @foreach (var hit in _matches)
                {
                    <li>
                        <button type="button" class="jsini-note__match" @onclick="@(() => Add(hit.LoginId))">
                            <span class="jsini-note__match-name">@hit.Display</span>
                            @if (hit.Affiliation is { Length: > 0 } dept)
                            {
                                <span class="jsini-note__match-sub">@dept</span>
                            }
                            @* 메일 주소가 없으면 그 자리에서 말한다 — 「메일도
                               보내기」를 켜 놓고 나중에 빠진 것을 알게 하지 않는다. *@
                            <span class="jsini-note__match-sub">
                                @(string.IsNullOrWhiteSpace(hit.Email) ? "메일 없음" : hit.Email)
                            </span>
                        </button>
                    </li>
                }
            </ul>
        }
        else if (_searched && _entry is { Length: >= MinQuery })
        {
            <p class="jsini-note__empty">그렇게 찾히는 사람이 없습니다. 아이디나 이메일을 그대로 적어도 됩니다.</p>
        }
    </div>

    @* ── 내용 ──────────────────────────────────────────────── *@
    <div class="jsini-note__field">
        <span class="jsini-note__label">제목</span>
        <DxTextBox @bind-Text="@_title" NullText="쪽지 제목" CssClass="jsini-note__input" />
    </div>

    <div class="jsini-note__field">
        <span class="jsini-note__label">내용</span>
        <DxMemo @bind-Text="@_body" Rows="@BodyRows"
                NullText="보낼 말을 적으십시오." CssClass="jsini-note__input" />
    </div>

    @* ── 두드림 ────────────────────────────────────────────── *@
    <div class="jsini-note__ways">
        <DxCheckBox @bind-Checked="@_push">앱 푸시</DxCheckBox>
        <DxCheckBox @bind-Checked="@_email">메일</DxCheckBox>

        @if (!_push && !_email)
        {
            @* 막지 않는다. 쪽지함에 남는 것이 본체라 두드림 없이 보내는 것도
               뜻이 있다 — 다만 그 사실을 말해 준다. *@
            <span class="jsini-note__empty">알림 없이 쪽지함에만 넣습니다.</span>
        }
    </div>

    <div class="jsini-note__send">
        <DxButton Text="쪽지 보내기" RenderStyle="ButtonRenderStyle.Primary"
                  IconCssClass="jsini-icon-mail"
                  Enabled="@CanSend" Click="@SendAsync" />

        @if (ShowCancel)
        {
            <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@CancelAsync" />
        }
    </div>

</div>

@code {
    /// <summary>찾기를 시작하는 글자 수. 한 글자로 훑으면 전 직원이 끌려 온다.</summary>
    private const int MinQuery = 2;

    /// <summary>내용 칸의 줄 수. 팝업은 좁으므로 부르는 쪽이 줄인다.</summary>
    [Parameter] public int BodyRows { get; set; } = 8;

    /// <summary>「닫기」 단추를 보일까. 팝업 안에서만 참이다.</summary>
    [Parameter] public bool ShowCancel { get; set; }

    /// <summary>「닫기」를 눌렀다.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// 보내고 난 뒤. <b>보낸 통이 하나라도 있을 때만 온다</b> — 창을 닫거나
    /// 쪽지함을 다시 읽는 쪽이 받는다.
    /// </summary>
    [Parameter] public EventCallback<NoteSendResultDto> OnSent { get; set; }

    /// <summary>창을 열 때 받는 사람 칸에 미리 넣어 둘 아이디들.</summary>
    [Parameter] public IReadOnlyList<string>? DefaultTo { get; set; }

    /// <summary>받는 사람 딱지. 적은 글자 그대로 담는다 — 푸는 것은 서버다.</summary>
    private readonly List<string> _picked = [];

    private string? _entry;
    private string? _title;
    private string? _body;

    private bool _push = true;
    private bool _email;

    private bool _sending;

    /// <summary>찾기 결과. 비어 있어도 「없다」와 「아직 안 찾았다」는 다르다.</summary>
    private IReadOnlyList<NoteRecipientDto> _matches = [];

    private bool _searched;

    /// <summary>
    /// 지금 치고 있는 글자. <b>답이 늦게 와서 앞 글자의 결과가 덮는 것</b>을 막는다.
    /// </summary>
    /// <remarks>
    /// 글자마다 조회가 나가므로 「김」의 결과가 「김병」보다 늦게 올 수 있다.
    /// 돌아온 답이 지금 친 글자의 것이 아니면 버린다 — 안 그러면 목록이
    /// 치는 대로 앞뒤로 튄다.
    /// </remarks>
    private string? _inFlight;

    /// <summary>보낼 수 있는가 — 사람과 제목이 있어야 한다.</summary>
    private bool CanSend =>
        !_sending && _picked.Count > 0 && !string.IsNullOrWhiteSpace(_title);

    protected override void OnInitialized()
    {
        foreach (var who in DefaultTo ?? [])
        {
            Add(who);
        }
    }

    /// <summary>
    /// 받는 사람 칸에서 Enter · 쉼표를 누르면 딱지가 된다.
    /// </summary>
    /// <remarks>
    /// 쉼표까지 받는 것은, 메일 주소를 여럿 붙여 넣는 사람이 그대로 치기
    /// 때문이다. <c>DxTextBox</c> 는 값을 <c>OnInput</c> 으로 올리므로
    /// 그 시점의 <c>_entry</c> 에는 쉼표가 아직 없을 수 있다 — 그래서
    /// 글자가 아니라 <b>키</b>를 본다.
    /// </remarks>
    private async Task OnEntryKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" or ",")
        {
            AddEntry();
            return;
        }

        await SearchAsync();
    }

    /// <summary>적은 글자를 딱지로 옮긴다. 쉼표로 여럿 붙여 넣은 것도 가른다.</summary>
    private void AddEntry()
    {
        foreach (var piece in (_entry ?? string.Empty)
            .Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            Add(piece);
        }

        _entry = null;
        _matches = [];
        _searched = false;
    }

    /// <summary>딱지 하나를 더한다. <b>같은 사람을 두 번 넣지 않는다.</b></summary>
    private void Add(string who)
    {
        var text = who.Trim();

        if (text.Length == 0 || _picked.Contains(text, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        _picked.Add(text);

        // 골랐으면 찾기 칸을 비운다 — 안 비우면 방금 고른 사람이 목록에 남아
        // 한 번 더 누르게 된다.
        _entry = null;
        _matches = [];
        _searched = false;
    }

    private void Remove(string who) => _picked.Remove(who);

    /// <summary>
    /// 두 글자부터 찾는다. <b>못 찾아도 오류로 말하지 않는다</b> — 찾기는
    /// 거들 뿐이고, 사람은 아이디를 그대로 적어도 보낼 수 있다.
    /// </summary>
    private async Task SearchAsync()
    {
        var q = (_entry ?? string.Empty).Trim();

        if (q.Length < MinQuery)
        {
            _matches = [];
            _searched = false;
            return;
        }

        _inFlight = q;

        try
        {
            var hits = await Notes.SearchRecipientsAsync(q);

            // 늦게 온 답이 지금 친 글자의 것이 아니면 버린다.
            if (!string.Equals(_inFlight, q, StringComparison.Ordinal))
            {
                return;
            }

            _matches = hits;
            _searched = true;
        }
        catch (ApiException)
        {
            // 찾기가 막혀도 보내기는 막지 않는다.
            _matches = [];
            _searched = true;
        }
    }

    private async Task SendAsync()
    {
        if (!CanSend)
        {
            return;
        }

        // 칸에 적다 만 글자가 있으면 그것도 받는 사람이다 — 「추가」를 안 누르고
        // 바로 보내기를 누르는 것이 사람의 흔한 순서다.
        AddEntry();

        _sending = true;

        // **첫 `await` 앞에서 한 번 그린다.** 안 그리면 보내는 동안 단추가 눌린
        // 채로 남아 사람이 한 번 더 누른다 — 그러면 같은 쪽지가 두 통 간다.
        StateHasChanged();

        NoteSendResultDto? result = null;
        string? error = null;

        try
        {
            result = await Notes.SendAsync(
                string.Join(",", _picked), _title!.Trim(), (_body ?? string.Empty).Trim(),
                _push, _email);
        }
        catch (ApiException ex)
        {
            // 서버가 사람에게 그대로 보여 줄 수 있는 문장을 준다
            // (「그런 아이디·이메일이 없습니다: …」).
            error = ex.Message;
        }
        finally
        {
            _sending = false;
        }

        if (error is not null || result is null or { Sent: 0 })
        {
            Toasts.Show(error ?? "쪽지를 보내지 못했습니다.", NoticeTone.Error);
            return;
        }

        Toasts.Show(Describe(result), result.Unknown.Count > 0 || result.NotifyNote is not null
            ? NoticeTone.Warning
            : NoticeTone.Info);

        // 보냈으면 칸을 비운다. 받는 사람은 남긴다 — 같은 사람에게 이어 보내는
        // 일이 흔하고, 딱지는 한 번 더 지우면 그만이다.
        _title = null;
        _body = null;

        await OnSent.InvokeAsync(result);
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    /// <summary>
    /// 결과를 사람이 읽는 한 줄로.
    /// </summary>
    /// <remarks>
    /// <b>쪽지와 두드림을 갈라 적는다.</b> 「보냈습니다」로만 말하면 알림이
    /// 안 간 것을 아무도 모르고, 「실패했습니다」로 말하면 이미 도착한 쪽지를
    /// 한 번 더 보낸다.
    /// </remarks>
    private static string Describe(NoteSendResultDto r)
    {
        var parts = new List<string> { $"쪽지 {r.Sent}통을 보냈습니다" };

        if (r.PushDevices > 0) parts.Add($"앱 알림 {r.PushDevices}대");
        if (r.EmailSent > 0) parts.Add($"메일 {r.EmailSent}명");
        if (r.NotifyNote is { Length: > 0 } why) parts.Add(why);

        if (r.Unknown.Count > 0)
        {
            parts.Add($"찾지 못한 값: {string.Join(", ", r.Unknown)}");
        }

        return string.Join(" · ", parts) + ".";
    }
}
