@*
    공통 나무. DevExpress 의 DxTreeList 를 감싼다 — CommGrd 의 짝이다. 같은 것은 넷이다: 선언하지 않은 파라미터는 Extra 로 받아 그대로 넘기고(attributes 가 맨 뒤라 화면 값이 기본을 이긴다), splat 값은 Coerce 가 형을 맞추고, 줄 열쇠를 켜 색으로 고른 줄을 보이게 하며, 고른 줄과 끌어 옮기기 콜백은 대리자가 감싸이도록 선언해 둔다(splat 으로 넘기면 500).
    나무라서 다른 것 넷: 순번 칸이 없다 — 첫 칸은 계층 칸이라 순번을 앞에 끼우면 펼침 화살표와 들여쓰기가 순번 칸으로 옮겨 간다(번호가 필요하면 계층 칸 다음에 둔다). 쪽나누기를 쓰지 않는다 — DxTreeList 의 쪽은 뿌리 줄만 세므로 나무는 접었다 펴서 다스린다. 팝업 편집이 된다 — 새 줄은 어디 아래인지 정해야 해서 OnNew · OnSave 가 부모를 함께 준다. 엑셀은 접힌 가지까지 내보낸다(RowExpandMode ExpandAll) — 기본값은 접힌 가지를 말없이 뺀다.
    나무 모양은 둘 중 하나로 알려 준다: 자식 목록형(ChildrenFieldName) 또는 부모 열쇠형(ParentKeyFieldName). 둘 다 KeyFieldName 이 필요하고, 아무것도 없으면 나무가 조용히 평평해지므로 여기서 막는다. 부모 열쇠형의 RootValue 는 식으로 준다 — 글자 "0" 은 object 라 Coerce 가 안 손대 열쇠가 정수면 뿌리를 못 찾는다.
*@

@typeparam TItem

@inherits DataPage
@implements ICommMenuHost

<div class="commtree"
     @oncontextmenu="@OpenMenuAsync"
     @oncontextmenu:preventDefault="@HasMenu">

    @if (Toolbar is not null)
    {
        <div class="commtree__toolbar">@Toolbar</div>
    }

    <DxTreeList @ref="_tree"
                Data="@Data"
                KeyFieldName="@KeyFieldName"
                ChildrenFieldName="@ChildrenFieldName"
                ParentKeyFieldName="@ParentKeyFieldName"
                ShowAllRows="true"
                PagerVisible="false"
                TextWrapEnabled="false"
                SelectionMode="TreeListSelectionMode.Single"
                AllowSelectRowByClick="true"
                FocusedRowEnabled="true"
                ColumnResizeMode="@ColumnResizeMode"
                EditMode="TreeListEditMode.PopupEditForm"
                PopupEditFormHeaderText="@EditFormTitle"
                CustomizeEditModel="@OnCustomizeEditModel"
                EditModelSaving="@OnEditModelSavingAsync"
                DataItemDeleting="@OnDataItemDeletingAsync"
                FilterCriteriaChanged="@OnFilterCriteriaChanged"
                CustomizeElement="@OnCustomizeElement"
                LayoutAutoSaving="@OnLayoutChanged"
                AllowDragRows="@AllowDragRows"
                AllowedDropTarget="@AllowedDropTarget"
                DropTargetMode="@DropTargetMode"
                ItemsDropped="@ItemsDropped"
                SelectedDataItem="@_selected"
                SelectedDataItemChanged="@OnSelectedDataItemChangedAsync"
                RowDoubleClick="@OnRowDoubleClickAsync"
                @attributes="_forwarded"
                ShowFilterRow="@_filterRow">

        <Columns>
            @Columns

            @if (HasActions)
            {
                @* 관리 칸은 「⋮」 하나다 — CommGrd 와 같다. 단추를 줄마다 늘어놓으면
                   화면마다 칸 폭이 갈리고, 나무에서는 계층 칸이 그 폭에 밀려 찌그러진다. *@
                <DxTreeListDataColumn Caption="" Width="@ActionsColumnWidth"
                                      MinWidth="@ActionsPixels" AllowSort="false">
                    <CellDisplayTemplate Context="cell">
                        <span class="commgrd__actions commgrd__more"
                              id="@_more.AnchorId(cell.VisibleIndex)"
                              @onclick:stopPropagation="true"
                              @ondblclick:stopPropagation="true">
                            <DxButton IconCssClass="jsini-icon-more-vertical"
                                      Title="관리"
                                      CssClass="@(_more.IsOpenAt(cell.VisibleIndex) ? "commgrd__icon--on" : null)"
                                      RenderStyle="ButtonRenderStyle.Link"
                                      Click="@(() => _more.ToggleAsync(cell.VisibleIndex, cell.DataItem))" />
                        </span>
                    </CellDisplayTemplate>
                </DxTreeListDataColumn>
            }
        </Columns>

        <EmptyDataAreaTemplate>
            @if (EmptyArea is not null)
            {
                @EmptyArea
            }
            else
            {
                <div class="commtree__empty">@EmptyText</div>
            }
        </EmptyDataAreaTemplate>

        <EditFormTemplate Context="edit">
            @EditFormTemplate?.Invoke(edit)
        </EditFormTemplate>
    </DxTreeList>

    @if (HasActions)
    {
        @* 관리 칸 「⋮」 가 펴는 판. 표 밖에 두는 까닭은 CommGrd 와 같다. *@
        <CommMoreFlyout TItem="TItem" Menu="@_more" Changed="@OnMenuChanged">
            <Items Context="m">
                @if (RowActions is not null)
                {
                    @RowActions(m.Item)
                }

                @if (OnAddChild.HasDelegate && ShowAddChild)
                {
                    <PermissionView Action="MenuAction.Create">
                        <DxButton IconCssClass="jsini-icon-child-plus"
                                  Title="하위 메뉴 추가"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => OnAddChild.InvokeAsync(m.Item))" />
                    </PermissionView>
                }

                @if (OnSave.HasDelegate && ShowAddChild)
                {
                    <PermissionView Action="MenuAction.Create">
                        <DxButton IconCssClass="jsini-icon-child-plus"
                                  Title="하위 추가"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => StartChildAsync(m.Index))" />
                    </PermissionView>
                }

                @if (OnSave.HasDelegate)
                {
                    <PermissionView Action="MenuAction.Update">
                        <DxButton IconCssClass="jsini-icon-edit"
                                  Title="수정"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => EditAsync(m.Index))" />
                    </PermissionView>
                }

                @if (OnDelete.HasDelegate)
                {
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton IconCssClass="jsini-icon-trash"
                                  Title="삭제"
                                  CssClass="commgrd__icon--warn"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => ConfirmDeleteAsync(m.Index, m.Item))" />
                    </PermissionView>
                }
            </Items>
        </CommMoreFlyout>
    }

    @* DeleteConfirm 을 준 화면만 쓴다. 안 준 화면은 DevExpress 기본 확인창이 뜬다. *@
    <ConfirmDialog @ref="_confirm" />

    @* 나무의 동작(등록 · 다시 읽기 · 펼치기 · 칸별 검색 · 엑셀)은 **오른쪽 클릭
       창**에 있다 — `CommGrd` 와 같다(그쪽 머리말). 화면만의 동작은
       `ContextMenuItems` 안의 `CommMenuItem` 으로 같은 창에 올린다. *@
    <CascadingValue TValue="ICommMenuHost" Value="this" IsFixed="true">
        @ContextMenuItems
    </CascadingValue>

    <DxContextMenu @ref="_menu" CssClass="commgrd__menu">
        <Items>
            @foreach (var item in _menuItems)
            {
                <DxContextMenuItem Text="@item.Text"
                                   IconCssClass="@item.Icon"
                                   BeginGroup="@item.BeginGroup"
                                   Enabled="@item.Enabled"
                                   Click="@item.Run" />
            }
        </Items>
    </DxContextMenu>

    @* 아래 띠에는 **동작이 아닌 것**만 남는다(「저장 중…」 같은 상태 표시).
       없으면 띠를 그리지 않는다. *@
    @if (ShowFooter && (FooterLeft is not null || FooterRight is not null))
    {
        <div class="commtree__footer">
            @FooterLeft

            <div class="commtree__spacer"></div>

            @FooterRight
        </div>
    }

</div>
