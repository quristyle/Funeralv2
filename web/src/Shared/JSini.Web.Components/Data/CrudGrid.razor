@*
    등록·수정·삭제가 되는 표. 관리 화면이 공통으로 쓴다.

    [화면마다 손으로 적지 않는 이유]

    관리 화면이 스무 개가 넘는다. 그 각각이 똑같은 배관을 필요로 한다 —
    도구줄 · 권한 판정 · 팝업 편집 폼 · 저장 · 삭제 확인 · 엑셀 내보내기 ·
    실패 안내. 손으로 적으면 반드시 갈라지고, 갈라지는 곳은 늘 **권한 판정**과
    **실패 처리**다.

      · 권한이 갈라지면 — 단추는 보이는데 눌러도 403 이거나, 그 반대다
      · 실패가 갈라지면 — 어떤 화면은 조용히 안 되고 어떤 화면은 죽는다

    [권한은 DB 메뉴 플래그를 따른다]

    등록·수정·삭제·엑셀 단추를 우리가 정하지 않는다. 메뉴마다
    `use_create` · `use_update` · `use_delete` · `use_excel` 플래그가 있고
    권한표가 그것을 내려 준다. `PermissionView` 가 그 값을 본다 —
    **옛 화면과 같은 동작**이고, 화면을 고치지 않고 DB 에서 켜고 끌 수 있다.

    [편집을 팝업으로 두는 이유]

    관리 화면의 칸이 여덟에서 열두 개다. 줄 안에서 편집하면(EditRow) 표가
    옆으로 늘어나 가로 스크롤이 생기고, 그 상태에서는 어느 칸을 고치는지
    보이지 않는다. 팝업은 칸을 세로로 세울 수 있다.
*@

@typeparam TItem

@inherits DataPage

<div class="jsini-toolbar">
    @ChildContent

    <div class="jsini-toolbar__spacer"></div>

    @if (OnSave.HasDelegate)
    {
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                      IconCssClass="jsini-icon-plus" Click="@StartNewAsync" />
        </PermissionView>
    }

    @if (AllowExport)
    {
        @* 엑셀은 DevExpress 가 표 그대로 뽑아 준다. 화면이 자료를 다시 모으지
           않는다 — 다시 모으면 화면에 건 필터·정렬이 빠져 "보이는 것과 다른
           파일" 이 나온다. *@
        <PermissionView Action="MenuAction.Excel">
            <DxButton Text="엑셀" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
                      IconCssClass="jsini-icon-excel" Click="@ExportAsync" />
        </PermissionView>
    }

    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
              IconCssClass="jsini-icon-refresh" Click="@(() => Reload.InvokeAsync())" />
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<DxGrid @ref="_grid"
        Data="@Data"
        ShowFilterRow="@ShowFilterRow"
        ShowSearchBox="@ShowSearchBox"
        PageSize="@PageSize"
        EditMode="GridEditMode.PopupEditForm"
        PopupEditFormHeaderText="@EditFormTitle"
        CustomizeEditModel="@OnCustomizeEditModel"
        EditModelSaving="@OnEditModelSavingAsync"
        DataItemDeleting="@OnDataItemDeletingAsync">
    <Columns>
        @Columns

        @if (OnSave.HasDelegate || OnDelete.HasDelegate)
        {
            <DxGridDataColumn Caption="관리" Width="120" MinWidth="120"
                              AllowSort="false" AllowGroup="false">
                <CellDisplayTemplate Context="cell">
                    <div class="d-flex gap-1">
                        @if (OnSave.HasDelegate)
                        {
                            <PermissionView Action="MenuAction.Update">
                                <DxButton Text="수정" SizeMode="SizeMode.Small"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          Click="@(() => EditAsync(cell.VisibleIndex))" />
                            </PermissionView>
                        }

                        @if (OnDelete.HasDelegate)
                        {
                            @* 확인 창은 DevExpress 가 띄운다. 우리가 따로 만들면
                               화면마다 문구가 달라진다. *@
                            <PermissionView Action="MenuAction.Delete">
                                <DxButton Text="삭제" SizeMode="SizeMode.Small"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          Click="@(() => ConfirmDelete(cell.VisibleIndex))" />
                            </PermissionView>
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }
    </Columns>

    <EditFormTemplate Context="edit">
        @EditForm(edit)
    </EditFormTemplate>
</DxGrid>

@code {
    /// <summary>표에 넣을 자료.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem> Data { get; set; } = [];

    /// <summary>표의 칸들. 관리 칸은 여기서 적지 않는다 — 이 부품이 붙인다.</summary>
    [Parameter, EditorRequired] public RenderFragment? Columns { get; set; }

    /// <summary>팝업 편집 폼의 내용.</summary>
    [Parameter] public RenderFragment<GridEditFormTemplateContext> EditForm { get; set; } = _ => @<text></text>;

    /// <summary>도구줄 왼쪽에 놓을 조회 조건.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>팝업 제목.</summary>
    [Parameter] public string EditFormTitle { get; set; } = "편집";

    [Parameter] public bool ShowFilterRow { get; set; }
    [Parameter] public bool ShowSearchBox { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 20;

    /// <summary>엑셀 내보내기 파일 이름. 비우면 단추가 안 나온다.</summary>
    [Parameter] public string? ExportName { get; set; }

    /// <summary>
    /// 새 행을 만들 때 기본값을 채운다.
    ///
    /// 부모 키(어느 회사·어느 프로젝트의 자료인가)를 여기서 넣는다.
    /// 안 넣으면 저장할 때 어디 소속인지 알 수 없어 목록에서 사라진다.
    /// </summary>
    [Parameter] public Action<TItem>? OnNew { get; set; }

    /// <summary>저장. 두 번째 인자가 <c>true</c> 면 새 자료다.</summary>
    [Parameter] public EventCallback<(TItem Item, bool IsNew)> OnSave { get; set; }

    /// <summary>삭제.</summary>
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }

    /// <summary>목록을 다시 읽는다. 저장·삭제 뒤에도 이것을 부른다.</summary>
    [Parameter] public EventCallback Reload { get; set; }

    private IGrid? _grid;

    private bool AllowExport => !string.IsNullOrWhiteSpace(ExportName);

    private Task StartNewAsync() => _grid?.StartEditNewRowAsync() ?? Task.CompletedTask;

    private Task EditAsync(int visibleIndex) => _grid?.StartEditRowAsync(visibleIndex) ?? Task.CompletedTask;

    private void ConfirmDelete(int visibleIndex) => _grid?.ShowRowDeleteConfirmation(visibleIndex);

    private Task ExportAsync() =>
        _grid?.ExportToXlsxAsync(ExportName!, new GridXlExportOptions
        {
            // 화면에 건 필터·정렬을 그대로 담는다. 원본 전량을 뽑으면
            // "보이는 것과 다른 파일" 이 나온다.
            ExportSelectedRowsOnly = false,
        }) ?? Task.CompletedTask;

    /// <summary>
    /// 새 행의 기본값을 채운다.
    ///
    /// DevExpress 는 편집 모델을 리플렉션으로 만든다. 그대로 두면 모든 칸이
    /// 비어 있고, 부모 키가 빈 자료가 저장된다.
    /// </summary>
    private void OnCustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        if (e.IsNew && e.EditModel is TItem item)
        {
            OnNew?.Invoke(item);
        }
    }

    private async Task OnEditModelSavingAsync(GridEditModelSavingEventArgs e)
    {
        if (e.EditModel is not TItem model)
        {
            return;
        }

        var saved = await RunAsync(
            () => OnSave.InvokeAsync((model, e.IsNew)),
            e.IsNew ? "등록했습니다." : "저장했습니다.",
            e.IsNew ? "등록하지 못했습니다" : "저장하지 못했습니다");

        if (!saved)
        {
            // 실패하면 팝업을 닫지 않는다. 닫으면 사용자가 쓴 내용이 사라지고,
            // 무엇이 잘못됐는지 고칠 기회도 없어진다.
            e.Cancel = true;
            return;
        }

        await Reload.InvokeAsync();
    }

    private async Task OnDataItemDeletingAsync(GridDataItemDeletingEventArgs e)
    {
        if (e.DataItem is not TItem item)
        {
            return;
        }

        if (await RunAsync(() => OnDelete.InvokeAsync(item), "삭제했습니다.", "삭제하지 못했습니다"))
        {
            await Reload.InvokeAsync();
        }
        else
        {
            e.Cancel = true;
        }
    }
}
