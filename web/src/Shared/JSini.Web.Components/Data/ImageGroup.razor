@*
    사진 여러 장을 한 묶음(파일 그룹)으로 다루는 부품. Vue 의 ImageGroupManager 를 잇는다.
    첨부와 달리 고르는 즉시 올라간다 — 첫 장을 올릴 때 서버가 그룹 아이디를 새로 발급해서 폼이 그 값을 받아 저장해야 하기 때문이다. 폼을 취소해도 올린 사진은 남는다(고아 그룹을 걷는 일은 서버 몫).
    미리 보기는 셸을 거친다 — FileServer 주소는 /api/file 이라 포털에서는 404 다(FileDownload).
*@

@* 올리다 생긴 일은 **담아 두지 않고 바로 띄운다.** 「N장까지만」은 그 순간에만
   뜻이 있는 말이라, 남겨 두면 다음에 고른 사진이 멀쩡한데도 경고가 붙어
   있는다(`FilePicker` 와 같다). *@

@implements IAsyncDisposable

<div class="jsini-imggroup">

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="jsini-imggroup__hint">@Hint</div>
    }

    <div class="jsini-imggroup__list">
        @foreach (var file in _files)
        {
            <figure class="jsini-imggroup__item @(file.IsRepresentative ? "jsini-imggroup__item--rep" : null)">
                <img src="@FileDownload.UrlFor(file.Id)" alt="@file.OriginalName" title="@file.OriginalName" />

                <figcaption class="jsini-imggroup__tools">
                    @if (ShowRepresentative)
                    {
                        <button type="button" title="대표 사진으로"
                                disabled="@(_busy || file.IsRepresentative)"
                                @onclick="@(() => SetRepresentativeAsync(file))">
                            @(file.IsRepresentative ? "대표" : "대표로")
                        </button>
                    }

                    <button type="button" title="이 사진 지우기" disabled="@_busy"
                            @onclick="@(() => DeleteAsync(file))">
                        지우기
                    </button>
                </figcaption>
            </figure>
        }

        @if (_files.Count < Limit)
        {
            <label class="jsini-imggroup__add">
                <InputFile OnChange="@UploadAsync" multiple accept="image/*" disabled="@_busy" />
                <span>@(_busy ? "올리는 중…" : $"사진 추가 ({_files.Count}/{Limit})")</span>
            </label>
        }
    </div>

    @if (_files.Count == 0 && !_busy)
    {
        <div class="jsini-imggroup__empty">등록된 사진이 없습니다.</div>
    }

</div>
