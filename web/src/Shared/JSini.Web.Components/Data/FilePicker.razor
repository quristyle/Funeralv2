@*
    첨부 고르기 (D5). 고른 파일을 **셸 서버에 잠깐 받아 두고**, 화면이 저장을
    누를 때 그 바이트를 게이트웨이로 올린다.

    [DevExpress `DxUpload` 를 쓰지 않았다 — 취향이 아니라 구조 때문이다]

    `DxUpload` 는 **브라우저가 직접** 지정한 주소로 POST 한다. 그런데 이 포털은
    BFF 라 **브라우저에는 게이트웨이 토큰이 없다** — 토큰은 셸 서버가 인증 쿠키
    안에 들고 있다(web/CLAUDE.md 의 「인증 — BFF」). 브라우저가 게이트웨이로
    직접 올리면 401 이고, 통하게 하려면 토큰을 브라우저로 내려보내야 하는데
    그것이 이 구조를 세운 이유를 지우는 일이다.

    `InputFile` 은 파일을 **회로(서버)** 로 흘려보낸다. 그 다음 게이트웨이로
    가는 길은 우리 서버 코드이고, 거기에는 토큰이 있다.

    [고르는 즉시 임시 파일로 받아 둔다]

    `IBrowserFile` 의 스트림은 **그 상호작용 동안에만** 유효하다. 고른 뒤
    폼을 채우다 저장을 누르면 그때는 이미 못 읽는 일이 생긴다 —
    증상은 「어제는 됐는데 오늘은 안 된다」라 원인을 찾기 어렵다.
    그래서 고르는 순간 임시 파일로 복사하고, 저장할 때는 그것을 읽는다.
    영상·음원 원본이 수백 MB 라 메모리에 들지 않고 디스크로 받는다.

    임시 파일은 이 부품이 사라질 때 지운다.

    [진행률은 브라우저→서버 구간이다]

    사람이 기다리는 시간의 대부분이 이 구간이다(그 다음 서버→게이트웨이는
    같은 망 안이다). 그래서 여기서만 진행률을 보여 준다.
*@

@implements IAsyncDisposable

<div class="jsini-picker">
    <label class="jsini-picker__drop">
        <InputFile OnChange="@OnChangeAsync" multiple="@(MaxFiles > 1)" accept="@Accept" disabled="@_busy" />
        <span class="jsini-picker__hint">@HintText</span>
    </label>

    @if (_busy)
    {
        <div class="jsini-picker__progress">
            <span>@_busyName 받는 중… @_busyPercent%</span>
            <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
                      Click="@Cancel" />
        </div>
    }

    @if (_files.Count > 0)
    {
        <ul class="jsini-picker__list">
            @foreach (var file in _files)
            {
                <li class="jsini-picker__item">
                    <span class="jsini-picker__name">@file.Name</span>
                    <span class="jsini-picker__size">@Human(file.Size)</span>
                    <DxButton Text="빼기" RenderStyle="ButtonRenderStyle.Link" SizeMode="SizeMode.Small"
                              Enabled="@(!_busy)" Click="@(() => RemoveAsync(file))" />
                </li>
            }
        </ul>
    }

    <PageNotice Text="@_error" Tone="NoticeTone.Warning" />
</div>

@code {
    /// <summary>몇 개까지. 1 이면 하나만 고르게 하고, 새로 고르면 앞엣것을 갈아 끼운다.</summary>
    [Parameter] public int MaxFiles { get; set; } = 5;

    /// <summary>한 개 최대 크기(바이트). 넘으면 그 파일만 빼고 이유를 말한다.</summary>
    [Parameter] public long MaxBytes { get; set; } = 100L * 1024 * 1024;

    /// <summary><c>accept</c> 속성. 예: <c>image/*</c>. 비우면 아무거나.</summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>칸 안에 적을 안내. 무엇을 올리는 자리인지 화면마다 다르다.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>고른 것이 바뀔 때마다. 화면은 이 목록을 들고 있다가 저장할 때 읽는다.</summary>
    [Parameter] public EventCallback<IReadOnlyList<PickedFile>> FilesChanged { get; set; }

    private readonly List<PickedFile> _files = [];

    private string? _error;
    private bool _busy;
    private string? _busyName;
    private int _busyPercent;

    private CancellationTokenSource? _cts;

    /// <summary>이 부품이 만든 임시 폴더. 사라질 때 통째로 지운다.</summary>
    private string? _tempDir;

    private string HintText => Hint
        ?? $"파일을 고르세요 (최대 {MaxFiles}개 · 한 개 {Human(MaxBytes)} 까지)";

    private async Task OnChangeAsync(InputFileChangeEventArgs e)
    {
        _error = null;

        // 하나만 받는 자리에서 새로 고르면 앞엣것을 버린다 — 영정 사진처럼
        // 「그 자리에 딱 하나」인 것들이다.
        if (MaxFiles == 1)
        {
            await ClearAsync();
        }

        // GetMultipleFiles 는 개수 상한을 넘기면 예외를 던진다. 상한을 넉넉히
        // 주고 우리가 세어 자르는 편이 「몇 개까지인지」를 말해 줄 수 있다.
        var picked = MaxFiles == 1
            ? [e.File]
            : e.GetMultipleFiles(Math.Max(MaxFiles, 1) + 10);

        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _busy = true;

        try
        {
            foreach (var browserFile in picked)
            {
                if (_files.Count >= MaxFiles)
                {
                    _error = $"{MaxFiles}개까지만 올릴 수 있어 나머지는 뺐습니다.";
                    break;
                }

                if (browserFile.Size > MaxBytes)
                {
                    _error = $"{browserFile.Name} 은(는) {Human(MaxBytes)} 를 넘어 뺐습니다.";
                    continue;
                }

                var saved = await ReceiveAsync(browserFile, _cts.Token);
                if (saved is not null)
                {
                    _files.Add(saved);
                }
            }
        }
        catch (OperationCanceledException)
        {
            _error = "받기를 멈췄습니다.";
        }
        catch (Exception ex)
        {
            // 브라우저가 파일을 못 읽는 경우(고른 뒤 원본을 지웠다 등)가 있다.
            // 화면 전체를 죽이지 않고 이 자리에서 말한다.
            _error = $"파일을 받지 못했습니다 — {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyName = null;
            _busyPercent = 0;
        }

        await FilesChanged.InvokeAsync(_files);
    }

    /// <summary>파일 하나를 임시 파일로 받는다. 진행률을 갱신하며 흘려 쓴다.</summary>
    private async Task<PickedFile?> ReceiveAsync(IBrowserFile browserFile, CancellationToken ct)
    {
        _tempDir ??= Directory.CreateDirectory(
            Path.Combine(Path.GetTempPath(), "jsini-upload", Guid.NewGuid().ToString("N"))).FullName;

        var path = Path.Combine(_tempDir, Guid.NewGuid().ToString("N"));

        _busyName = browserFile.Name;
        _busyPercent = 0;
        StateHasChanged();

        // OpenReadStream 의 기본 상한이 512KB 다. 넘으면 예외라, 우리 상한을 넘긴다.
        await using var source = browserFile.OpenReadStream(MaxBytes, ct);
        await using var target = File.Create(path);

        var buffer = new byte[64 * 1024];
        long copied = 0;
        var lastShown = 0;

        while (true)
        {
            var read = await source.ReadAsync(buffer, ct);
            if (read == 0)
            {
                break;
            }

            await target.WriteAsync(buffer.AsMemory(0, read), ct);
            copied += read;

            // 1% 단위로만 다시 그린다. 조각마다 그리면 회로가 그리기에 밀린다.
            var percent = browserFile.Size > 0 ? (int)(copied * 100 / browserFile.Size) : 100;
            if (percent != lastShown)
            {
                lastShown = percent;
                _busyPercent = percent;
                StateHasChanged();
            }
        }

        return new PickedFile(
            browserFile.Name,
            string.IsNullOrWhiteSpace(browserFile.ContentType)
                ? "application/octet-stream"
                : browserFile.ContentType,
            copied,
            path);
    }

    private void Cancel() => _cts?.Cancel();

    private async Task RemoveAsync(PickedFile file)
    {
        _files.Remove(file);
        Delete(file.TempPath);
        await FilesChanged.InvokeAsync(_files);
    }

    /// <summary>고른 것을 모두 버린다. 저장이 끝난 뒤 화면이 부른다.</summary>
    public async Task ClearAsync()
    {
        foreach (var file in _files)
        {
            Delete(file.TempPath);
        }
        _files.Clear();
        await FilesChanged.InvokeAsync(_files);
    }

    private static void Delete(string path)
    {
        try
        {
            if (File.Exists(path))
            {
                File.Delete(path);
            }
        }
        catch (IOException)
        {
            // 임시 파일이다. 못 지워도 업무에 영향이 없다.
        }
    }

    /// <summary>사람이 읽는 크기.</summary>
    private static string Human(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024 / 1024:0.#} GB",
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B",
    };

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();

        await ClearAsync();

        try
        {
            if (_tempDir is not null && Directory.Exists(_tempDir))
            {
                Directory.Delete(_tempDir, recursive: true);
            }
        }
        catch (IOException)
        {
        }
    }
}
