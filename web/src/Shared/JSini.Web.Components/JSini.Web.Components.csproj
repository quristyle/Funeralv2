<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Blazor Common — 앱 일곱 개가 함께 쓰는 화면과 구성.

    담는 것:
      Layout/    사이드바·헤더·테마. **일곱 앱이 같은 껍데기를 그려야 한다** —
                 업무를 옮길 때 헤더가 달라 보이면 다른 사이트로 넘어온 느낌이 든다.
      Data/      DevExpress 래퍼 (그리드·폼·모달 표준)
      Menu/      메뉴 트리 조회와 거르기. 앱마다 자기 사이드바를 그리므로 공용이다.
      Security/  토큰 저장과 권한 판정
      JSiniWebApp.cs  일곱 앱의 공통 등록. 이 파일이 이 구조를 지탱한다.

    [DevExpress 를 참조하는 유일한 자리다]

    업무 앱이 DxGrid 를 직접 쓰기 시작하면 그리드 기본값이 앱마다 달라진다.
    화면이 250개 넘게 옮겨 오는 동안 그 차이는 되돌릴 수 없다.

    [여기에 넣지 않는 것]

    한 업무만 쓰는 컴포넌트는 그 앱에 둔다. 두 앱이 쓰면 복제하고,
    **세 번째 앱이 필요해질 때** 여기로 올린다. 이 규칙이 없으면 이 프로젝트가
    모든 앱의 결합 지점이 되어 앱을 나눈 의미가 사라진다.
  -->

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      StaticWebAssetBasePath 를 건드리지 않는다.

      한때 `/` 로 두었더니 이 라이브러리의 app.css 가 호스트의 루트(/app.css)로
      나갔다. 그러면 두 가지가 깨진다.
        · 호스트 앱이 자기 wwwroot 에 같은 이름을 두면 조용히 덮인다
        · 앱마다 PathBase 가 달라서(/funeral, /helpdesk) 같은 파일이 앱마다
          다른 주소가 된다 — 브라우저가 일곱 번 내려받는다

      기본값(_content/JSini.Web.Components/...)이 맞다. JSiniHead 가 그 경로를 쓴다.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" />
    <PackageReference Include="DevExpress.Blazor.Themes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JSini.Web.Abstractions\JSini.Web.Abstractions.csproj" />
    <ProjectReference Include="..\JSini.Web.Http\JSini.Web.Http.csproj" />
    <ProjectReference Include="..\JSini.Web.Models\JSini.Web.Models.csproj" />
  </ItemGroup>

</Project>
