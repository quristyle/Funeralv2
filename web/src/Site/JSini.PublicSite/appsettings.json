{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 게이트웨이 주소.
  //   BaseUrl        서버가 SiteServer 공개 API 를 부를 때 쓴다 (섹션·글·자료·문의).
  //   PublicBaseUrl  브라우저가 직접 여는 주소의 밑동이다 — 표지 이미지(/api/file/...)와
  //                  내려받기(/api/site/downloads/{id}/file)는 게이트웨이가 서빙하므로
  //                  마크업에 절대 주소로 박아 내보낸다. 비워 두면 BaseUrl 의 오리진을 쓴다.
  "Gateway": {
    "BaseUrl": "http://localhost:5265/api/",
    "PublicBaseUrl": ""
  }
}
