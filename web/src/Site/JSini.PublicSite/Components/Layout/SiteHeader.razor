@*
    머리글. 상단에 붙어 따라온다. 모바일 차림표는 details 로 연다. 회로가 없어 상태를 서버가 들 수 없고, details 는 브라우저가 스스로 여닫는다.
*@

<header class="site-header">
    <div class="wrap site-header__bar">
        <a href="@Link("/")" class="site-header__brand" aria-label="JSINI">
            <BrandLogo Height="24" />
        </a>

        <nav class="site-header__nav" aria-label="주요 메뉴">
            @foreach (var item in Items)
            {
                <NavLink class="site-header__link" href="@item.Href" Match="NavLinkMatch.All">@item.Label</NavLink>
            }

            @* 업무 포털. 사이트 안 차림표와 섞이지 않게 단추 모양으로 둔다(눌렀을 때 다른 곳으로 나간다). *@
            <a class="site-header__portal" href="@PortalUrl" rel="noopener">@T.Nav.Portal →</a>

            @* 언어 전환. 지금 보고 있는 화면의 다른 언어 주소로 간다. *@
            <a class="site-header__lang"
               href="@OtherLocalePath"
               aria-label="@($"{T.Common.LangLabel}: {SiteMessages.Other(Locale).ToUpperInvariant()}")">
                @SiteMessages.Other(Locale).ToUpperInvariant()
            </a>
        </nav>

        <details class="site-header__mobile">
            <summary class="site-header__toggle" aria-label="메뉴">
                <span></span><span></span><span></span>
            </summary>

            <nav class="site-header__drawer" aria-label="주요 메뉴">
                @foreach (var item in Items)
                {
                    <a class="site-header__drawer-link" href="@item.Href">@item.Label</a>
                }
                <a class="site-header__drawer-link site-header__drawer-link--portal"
                   href="@PortalUrl" rel="noopener">@T.Nav.Portal →</a>
                <a class="site-header__drawer-link" href="@OtherLocalePath">
                    @SiteMessages.Other(Locale).ToUpperInvariant()
                </a>
            </nav>
        </details>
    </div>
</header>
