@page "/{Locale}/news/{Slug}"

@*
    뉴스 상세.

    원본에서는 이 화면만 프리렌더 대상이 아니었다 — 주소가 자료에 달려 있어
    빌드 때 목록을 받아야 했고, 그러면 배포가 API 상태에 묶이기 때문이다.
    서버 렌더에서는 그 제약이 통째로 사라진다. 검색 엔진도 다른 화면과 똑같이
    완성된 HTML 을 받는다.
*@

@inject SiteApi Api

<PageTitle>@(_post is null ? "JSINI" : $"{_post.Title} — JSINI")</PageTitle>
<HeadContent>
    @if (_post is not null)
    {
        <meta name="description" content="@(_post.Summary ?? _post.Title)" />
        <meta property="og:title" content="@($"{_post.Title} — JSINI")" />
        @if (!string.IsNullOrWhiteSpace(_post.CoverUrl))
        {
            <meta property="og:image" content="@Api.PublicUrl(_post.CoverUrl)" />
        }
    }
</HeadContent>

<article class="wrap wrap--narrow section">
    <a class="link-quiet" href="@($"/{L}/news")">← @T.Common.BackToList</a>

    @if (_post is null)
    {
        <p class="muted mt-10 text-sm">@T.Common.Empty</p>
    }
    else
    {
        @if (_post.PublishedAt is not null)
        {
            <time class="post-detail__date">@_post.PublishedAt.Value.ToString("yyyy-MM-dd")</time>
        }
        <h1 class="h-display post-detail__title">@_post.Title</h1>

        @if (!string.IsNullOrWhiteSpace(_post.CoverUrl))
        {
            <div class="post-detail__cover">
                <img src="@Api.PublicUrl(_post.CoverUrl)" alt="@_post.Title" />
            </div>
        }

        <RichText Text="@_post.Body" Class="mt-10 text-sm body-copy body-copy--loose" />
    }
</article>

@code {
    [Parameter] public string? Locale { get; set; }

    /// <summary>자료의 주소 조각. DB 의 <c>slug</c> 다.</summary>
    [Parameter] public string Slug { get; set; } = string.Empty;

    private Messages T => SiteMessages.For(Locale);
    private string L => SiteMessages.Normalize(Locale);

    private PostDetail? _post;

    protected override async Task OnInitializedAsync()
    {
        _post = await Api.PostAsync(L, Slug);
        Api.RecordVisit($"/{L}/news/{Slug}", L);
    }
}
