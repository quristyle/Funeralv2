@page "/cargotrust/companies/{CompanyId:long}"
@attribute [RouteKey("cargotrust.companies.detail")]

@*
    거래처 상세(CT-004, 설계안 7 · 12).

    [별점이 아니라 거래 데이터다]

    이 화면은 거래처를 한 단어로 부르지 않는다. 「악성」「위험」 같은 이름표를 달면
    그것은 사실이 아니라 서비스의 판정이 되고, 틀렸을 때 책임질 방법이 없다
    (설계안 12 · 33-1). 대신 **몇 건 중 몇 건이 어땠는지**와 **그것이 어느 기간의
    어떤 기준인지**를 함께 보여 주고, 판단은 보는 사람에게 맡긴다.

    [기간을 고른다 — 기본은 최근 90일]

    오래전에 정상이던 회사가 요즘 늦어졌을 수 있다. 전체만 보이면 그 변화가 평균에
    묻힌다. 고른 기간은 타일에, 다섯 기간을 나란히 놓은 것은 「기간별 변화」 표에
    둔다(설계안 7.4). 표는 늘 다섯 줄이라 기간을 바꿔도 달라지지 않는다.

    [보는 화면에 하나뿐인 「할 일」]

    맨 위 회사 정보 바로 아래가 **내 미처리 거래**다(OpenTransactions). 나머지는
    전부 판단을 돕는 숫자인데 그 줄만 손을 쓰는 자리라, 통계 사이에 끼워 두면
    받은 돈을 적으러 온 사람이 기간 고르개와 표 넷을 지나쳐 내려가야 한다.
    처리하고 나면 통계가 그 자리에서 달라지므로 상세를 다시 읽는다(후기는 빼고 —
    거래를 처리해도 후기는 그대로다).

    [등록자는 가린 이름으로 적는다]

    최근 거래 · 최근 미지급의 줄마다 등록자가 있다. 다만 **서버가 가운데를 가려서
    준다**(「이*열」 — 설계안 29 가 사용자 이름을 비공개로 두기 때문이다). 그래도
    적는 까닭은, 등록자가 없으면 한 사람이 열 건을 몰아 올린 것과 열 사람이 한
    건씩 올린 것을 가릴 수 없어서다. 후기에는 없다 — 글은 거래보다 사람을 더
    가리킨다. 신고는 그 줄 자체를 대상으로 받는다.

    최근 미지급은 다섯 줄까지다. 그보다 많으면 「미지급 거래」 화면
    (/cargotrust/unpaid)이 이 거래처만 걸러 전부 보여 준다.

    조각이 여럿 쌓인 화면이라 쪽이 구르게 둔다(CommCont 가 본문을 채우지 않게
    `ct-page` 로 감싼다).
*@

@inherits DataPage
@inject CargoTrustClient Api
@inject NavigationManager Navigation

<PageTitle>@(_detail?.Company.CompanyName ?? "거래처 상세") · 운송관리</PageTitle>

<div class="ct-page">
    @if (_detail is { } d)
    {
        var c = d.Company;

        <section class="ct-panel">
            <div class="ct-panel__head">
                <div class="ct-panel__name">
                    @c.CompanyName
                    @if (c.Status != "ACTIVE")
                    {
                        <span class="@CargoCodes.CompanyStatusBadge(c.Status)">@CargoCodes.CompanyStatusName(c.Status)</span>
                    }
                </div>
                <div class="jsini-actions ct-panel__actions">
                    <DxButton Text="이 거래처와 거래 등록" RenderStyle="ButtonRenderStyle.Primary" IconCssClass="jsini-icon-plus"
                              Click="@(() => Navigation.NavigateTo($"/cargotrust/transactions/new?companyId={c.CompanyId}"))" />
                    <DxButton Text="신고" RenderStyle="ButtonRenderStyle.Secondary"
                              Click="@(() => _report?.Open("COMPANY", c.CompanyId, $"{c.CompanyName} ({c.BusinessNumber})"))" />
                </div>
            </div>

            <dl class="ct-facts">
                <div><dt>사업자등록번호</dt><dd>@c.BusinessNumber</dd></div>
                <div><dt>대표자</dt><dd>@(c.CeoName ?? "-")</dd></div>
                <div><dt>업종</dt><dd>@(c.BusinessType ?? "-")</dd></div>
                <div><dt>지역</dt><dd>@(c.Region ?? "-")</dd></div>
                <div class="ct-facts__wide"><dt>사업장 주소</dt><dd>@(c.Address ?? "-")</dd></div>
                <div><dt>등록일</dt><dd>@(c.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</dd></div>
                <div>
                    <dt>내가 등록한 거래</dt>
                    <dd>
                        @if (d.MyTransactionCount > 0)
                        {
                            <a href="@($"/cargotrust/transactions?companyId={c.CompanyId}")">@(d.MyTransactionCount)건</a>
                        }
                        else
                        {
                            <span>없음</span>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        @* 판단(통계)보다 앞에 둔다 — 이 화면에서 **할 일이 있는 유일한 자리**다. *@
        <OpenTransactions CompanyId="@c.CompanyId" CompanyName="@c.CompanyName"
                          OnChanged="@(() => ReloadAsync(withReviews: false))" />

        <div class="ct-segment" role="group" aria-label="기간">
            @foreach (var p in Periods)
            {
                <DxButton Text="@p.Text"
                          RenderStyle="@(p.Days == _period ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                          RenderStyleMode="@(p.Days == _period ? ButtonRenderStyleMode.Contained : ButtonRenderStyleMode.Outline)"
                          Enabled="@(!Loading)"
                          Click="@(() => ChangePeriodAsync(p.Days))" />
            }
        </div>

        <StatsTiles Stats="@d.Stats" />

        <CommCont Title="기간별 변화" Hint="운송일 기준 · 기간마다 따로 센 값">
            <CommGrd TItem="CompanyStats" Data="@d.Periods" ShowFooter="false" ShowRowNumber="false"
                     ExportName="기간별변화">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.PeriodLabel)" Caption="기간" Width="110" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.TotalCount)" Caption="전체" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.NormalCount)" Caption="정상" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.DelayedCount)" Caption="지연" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.PartialCount)" Caption="일부" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.UnpaidCount)" Caption="미지급" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.DisputeCount)" Caption="분쟁" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.NormalRate)" Caption="정상률" Width="90">
                        <CellDisplayTemplate Context="cell">@CargoCodes.Rate(((CompanyStats)cell.DataItem).NormalRate)</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.AverageDelayDays)" Caption="평균 지연" Width="90">
                        <CellDisplayTemplate Context="cell">@CargoCodes.Days(((CompanyStats)cell.DataItem).AverageDelayDays)</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(CompanyStats.Confidence)" Caption="데이터 규모" MinWidth="150">
                        <CellDisplayTemplate Context="cell">
                            @{ var s = (CompanyStats)cell.DataItem; }
                            <span class="@CargoCodes.ConfidenceBadge(s.Confidence)">@CargoCodes.ConfidenceName(s.Confidence, s.ConfidenceLabel)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </CommGrd>
        </CommCont>

        <CommCont Title="최근 미지급" Hint="최근 5건 · 기간과 무관">
            <Actions>
                <DxButton Text="미지급 거래 전체 보기" RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => Navigation.NavigateTo($"/cargotrust/unpaid?companyId={c.CompanyId}"))" />
            </Actions>
            <ChildContent>
            @if (d.RecentUnpaid.Count > 0)
            {
                <CommGrd TItem="PublicTransaction" Data="@d.RecentUnpaid" ShowFooter="false" ExportName="최근미지급"
                         RowActions="@ReportTransaction">
                    <Columns>@PublicColumns</Columns>
                </CommGrd>
            }
            else
            {
                <div class="jsini-hint">미지급으로 등록된 거래가 없습니다.</div>
            }
            </ChildContent>
        </CommCont>

        <CommCont Title="최근 거래" Hint="최근 20건">
            <CommGrd TItem="PublicTransaction" Data="@d.RecentTransactions" ExportName="최근거래"
                     RowActions="@ReportTransaction">
                <Columns>@PublicColumns</Columns>
            </CommGrd>
        </CommCont>

        <CommCont Title="거래 후기" Hint="@($"{_reviews.Count}건 · 실제 거래에 붙은 것만")">
            @if (_reviews.Count == 0)
            {
                <div class="jsini-hint">아직 후기가 없습니다.</div>
            }
            else
            {
                <ul class="ct-reviews">
                    @foreach (var r in _reviews)
                    {
                        <li class="ct-review">
                            <div class="ct-review__meta">
                                <span>거래일 @CargoCodes.Day(r.TransportDate)</span>
                                <span>운송료 @CargoCodes.Won(r.Amount)</span>
                                <PayBadge Code="@r.PaymentStatus" />
                                <span class="jsini-hint">@CargoCodes.Moment(r.CreatedAt)</span>
                                <DxButton Text="신고" RenderStyle="ButtonRenderStyle.Link" CssClass="ct-review__report"
                                          Click="@(() => _report?.Open("REVIEW", r.ReviewId, $"{CargoCodes.Day(r.TransportDate)} 거래의 후기"))" />
                            </div>
                            <div class="ct-review__body">@r.Content</div>
                        </li>
                    }
                </ul>
            }
        </CommCont>
    }
    else if (!Loading)
    {
        <PageNotice Tone="NoticeTone.Warning" Text="거래처를 찾지 못했습니다. 숨김 처리되었거나 없는 번호일 수 있습니다." />
    }
</div>

<ReportPopup @ref="_report" />

@code {
    [Parameter] public long CompanyId { get; set; }

    private sealed record PeriodOption(int? Days, string Text);

    /// <summary>기간 고르개. <c>null</c> 이 전체다(서버에는 <c>all</c> 로 간다).</summary>
    private static readonly PeriodOption[] Periods =
    [
        new(30, "30일"),
        new(90, "90일"),
        new(180, "180일"),
        new(365, "1년"),
        new(null, "전체"),
    ];

    private int? _period = 90;
    private long _loadedFor;
    private CompanyDetail? _detail;
    private IReadOnlyList<PublicReview> _reviews = [];
    private ReportPopup? _report;

    /// <summary>
    /// 공개 거래 표의 칸. 최근 거래와 최근 미지급이 같은 칸을 쓴다 — 두 벌로 적으면
    /// 한쪽에만 칸이 더해져 같은 거래가 두 표에서 다르게 보인다.
    /// </summary>
    private static readonly RenderFragment PublicColumns =
        @<text>
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.TransportDate)" Caption="운송일" Width="110" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.Route)" Caption="구간" Width="130" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.TransportType)" Caption="유형" Width="100" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.Amount)" Caption="운송료" Width="110"
                              DisplayFormat="#,0" TextAlignment="GridTextAlignment.Right" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.ExpectedPaymentDate)" Caption="예정 지급일" Width="110" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.ActualPaymentDate)" Caption="실제 지급일" Width="110" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.PaymentStatus)" Caption="결과" Width="100">
                <CellDisplayTemplate Context="cell"><PayBadge Code="@(((PublicTransaction)cell.DataItem).PaymentStatus)" /></CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.DelayDays)" Caption="지연일" Width="80">
                <CellDisplayTemplate Context="cell">@CargoCodes.Days(((PublicTransaction)cell.DataItem).DelayDays)</CellDisplayTemplate>
            </DxGridDataColumn>
            @* 서버가 이미 가린 이름을 준다 — 여기서 또 가리면 관리자가 볼 것까지 가려진다. *@
            <DxGridDataColumn FieldName="@nameof(PublicTransaction.RegisteredBy)" Caption="등록자" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{ var t = (PublicTransaction)cell.DataItem; }
                    @(string.IsNullOrWhiteSpace(t.RegisteredBy) ? "-" : t.RegisteredBy)
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </text>;

    /// <summary>줄마다 「신고」. 사실과 다른 거래를 본 사람이 그 줄을 대상으로 올린다.</summary>
    private RenderFragment<PublicTransaction> ReportTransaction => t =>
        @<DxButton Text="신고" RenderStyle="ButtonRenderStyle.Link"
                   Click="@(() => _report?.Open("TRANSACTION", t.TransactionId,
                       $"{_detail?.Company.CompanyName} · {CargoCodes.Day(t.TransportDate)} · {CargoCodes.Won(t.Amount)}"))" />;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == CompanyId)
        {
            return;
        }

        _loadedFor = CompanyId;
        _period = 90;
        await ReloadAsync(withReviews: true);
    }

    private Task ChangePeriodAsync(int? days)
    {
        _period = days;
        return ReloadAsync(withReviews: false);
    }

    private Task ReloadAsync(bool withReviews) => LoadAsync(async () =>
    {
        // 후기는 기간과 무관하다 — 기간을 바꿀 때마다 다시 읽지 않는다.
        var detail = Api.GetCompanyAsync(CompanyId, _period);
        var reviews = withReviews ? Api.GetCompanyReviewsAsync(CompanyId) : Task.FromResult(_reviews);

        _detail = await detail;
        _reviews = await reviews;
        return _detail is null ? 0 : -1;
    }, "거래처를 찾지 못했습니다.", "거래처를 읽지 못했습니다");
}
