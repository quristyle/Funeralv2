@page "/cargotrust/payments"
@attribute [RouteKey("cargotrust.payments")]

@*
    결제 등록(CT-006, 설계안 9).

    [아직 다 받지 않은 거래만 늘어놓는다]

    예정 · 일부 지급 · 미지급 · 분쟁이다. 미지급·분쟁을 빼지 않는 이유는 그렇게
    적어 둔 거래를 **뒤늦게 받는 일이 흔해서**다. 다 받은 거래(정상·지연 지급)는
    더 적을 것이 없으므로 여기 없다.

    [거르는 것은 서버다 — `open: true`]

    전에는 내 거래를 통째로 읽어 화면에서 골랐다. 그 목록에는 상한이 있어서
    (CargoTrust:ListLimit, 500건) 운송일이 **오래된 것부터 잘린다.** 잘려 나간
    자리에 미수금이 있으면 그 돈은 이 화면에서 사라지는데, 미수금 화면은
    상한이 없어 그대로 보여 준다 — 같은 돈이 한 화면에만 있는 것이다.
    서버가 먼저 거르면 상한에 닿기 전에 다 받은 거래가 빠지므로 그 일이 없다.
    조건은 미수금 화면과 같은 한 벌이다(PaymentEndpoints.ReceivableStatuses).

    예정일이 지난 것부터 보이게 늘어놓는다 — 먼저 챙길 것이 그것이다.

    결제 입력 창은 내 거래 · 거래 상세 · 미수금과 같은 `PaymentPopup` 이다.
*@

@inherits DataPage

<PageTitle>결제 등록 · 운송관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="상태">
            <DxComboBox Data="@Statuses" @bind-Value="_status"
                        TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                        Style="width: 150px" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="MyTransaction" Data="@_rows" ExportName="결제대기"
             Reload="@ReloadAsync" RowActions="@PayButton" ActionsWidth="100"
             EmptyText="아직 받지 않은 거래가 없습니다.">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(MyTransaction.TransportDate)" Caption="운송일" Width="105" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.CompanyName)" Caption="거래처" MinWidth="150" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.Route)" Caption="구간" MinWidth="150" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.Amount)" Caption="운송료" Width="105"
                              DisplayFormat="#,0" TextAlignment="GridTextAlignment.Right" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.Outstanding)" Caption="남은 금액" Width="105"
                              DisplayFormat="#,0" TextAlignment="GridTextAlignment.Right" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.ExpectedPaymentDate)" Caption="예정 지급일" Width="105" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(MyTransaction.OverdueDays)" Caption="지남" Width="85">
                <CellDisplayTemplate Context="cell">
                    @{ var t = (MyTransaction)cell.DataItem; }
                    @if (t.OverdueDays is > 0)
                    {
                        <span class="ct-num--err">@(t.OverdueDays)일</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(MyTransaction.PaymentStatus)" Caption="상태" Width="95">
                <CellDisplayTemplate Context="cell"><PayBadge Code="@(((MyTransaction)cell.DataItem).PaymentStatus)" /></CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
</CommCont>

<PaymentPopup @ref="_payment" OnSaved="@(_ => ReloadAsync())" />

@code {
    private RenderFragment<MyTransaction> PayButton => t =>
        @<DxButton Text="결제 등록" RenderStyle="ButtonRenderStyle.Link"
                   Click="@(() => _payment?.Open(PaymentTarget.From(t)))" />;
}
