@page "/cargotrust/vehicles"
@attribute [RouteKey("cargotrust.vehicles")]

@* 나의 차량등록. 차종을 알아 오는 무료 공개 API 가 없어 사람이 적는다 — 번호판의 앞자리(화물차)와 한글 한 자(사업용)로 심야할인 판정 둘이 채워지고, 축수만 선택이다.
    차량번호는 남에게 싣지 않는다. 폭과 무관하게 카드로 통일한다(표는 정렬·거르기할 일이 없다). *@

@inherits DataPage

<PageTitle>나의 차량등록 · 운송관리</PageTitle>

<div class="ct-page ct-myveh">

    <div class="ct-myveh-top">
        <div class="ct-myveh-count">
            @if (_vehicles.Count > 0)
            {
                <span>등록한 차량 @_vehicles.Count 대</span>
            }
        </div>
        <DxButton Text="차량 등록" RenderStyle="ButtonRenderStyle.Primary"
                  CssClass="ct-myveh-add" IconCssClass="jsini-icon-plus"
                  Enabled="@(!Loading)" Click="@(() => Open(null))" />
    </div>

    @if (_vehicles.Count == 0 && !Loading)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="등록한 차량이 없습니다. 「차량 등록」을 눌러 차량번호만 적으면 화물차인지·사업용인지는 번호판에서 읽어 채웁니다." />
    }

    <ul class="ct-veh-cards">
        @foreach (var v in _vehicles)
        {
            <li class="ct-veh-card">
                <div class="ct-veh-card-head">
                    <strong>@v.PlateNo</strong>
                    @if (v.IsDefault)
                    {
                        <span class="jsini-badge jsini-badge--on">기본</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(v.Nickname))
                {
                    <div class="ct-veh-card-nick">@v.Nickname</div>
                }

                @* 표 칸으로 흩어져 있던 값을 여기로 접어 넣는다. 좁아지면 줄을 바꿔 담고 옆으로 흐르지 않는다. *@
                <div class="ct-veh-card-facts">
                    <span>@v.VehicleClassName</span>
                    <span>@(v.AxleCount is { } a ? $"{a}축" : "축수 모름")</span>
                    <span>@(v.IsBusiness ? "사업용" : "비사업용")</span>
                    <span>@(v.HasHipass ? "하이패스" : "하이패스 없음")</span>
                    @if (v.Tonnage is { } t and > 0)
                    {
                        <span>@t.ToString("0.#")톤</span>
                    }
                </div>

                @if (v.Plate is { Readable: true } plate)
                {
                    <div class="ct-veh-card-plate">번호판 — @plate.Summary</div>
                }

                @if (!string.IsNullOrWhiteSpace(v.Memo))
                {
                    <div class="ct-veh-card-memo">@v.Memo</div>
                }

                @* 단추는 양쪽 폭에서 같은 크기다 — 손가락 높이를 데스크톱에서 줄일 이유가 없다. *@
                <div class="ct-veh-card-actions">
                    <DxButton Text="수정" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => Open(v))" />
                    <DxButton Text="삭제" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => DeleteAsync(v))" />
                </div>
            </li>
        }
    </ul>
</div>

<VehicleEditPopup @ref="_popup" OnSaved="@ReloadAsync" />
