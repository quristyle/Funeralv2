@page "/cargotrust/disputes"
@attribute [RouteKey("cargotrust.disputes")]

@* 이의제기 — 운송사 쪽 화면. 회사에 연결된 CARRIER 계정만 쓸 수 있고(서버가 그 밖에는 403), 아니면 목록을 부르지 않고 사정을 적는다.
    사유는 서버가 하나만 받아 가장 앞선 것을 고르고, 증빙 첨부는 계약에 칸이 없어 빠졌다. 고르는 표에 등록자는 싣지 않는다. *@

@inherits DataPage

<PageTitle>이의제기 · 운송관리</PageTitle>

<div class="ct-page">
    @if (_me is not null && !_me.CanDispute)
    {
        <PageNotice Tone="NoticeTone.Warning"
                    Text="운송사 계정만 이의제기를 할 수 있습니다 — 관리자에게 회사 연결을 요청하십시오." />
    }
    else if (_me is not null)
    {
        <CommCont Title="@($"{_me.CompanyName ?? "우리 회사"}에 관한 거래")">
            <CommGrd TItem="PublicTransaction" Data="@_transactions" ExportName="회사거래"
                     RowActions="@DisputeButton">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.TransportDate)" Caption="운송일" Width="110" DisplayFormat="yyyy-MM-dd" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.Route)" Caption="구간" MinWidth="130" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.TransportType)" Caption="유형" Width="100" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.Amount)" Caption="운송료" Width="110"
                                      DisplayFormat="#,0" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.ExpectedPaymentDate)" Caption="예정 지급일" Width="110" DisplayFormat="yyyy-MM-dd" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.ActualPaymentDate)" Caption="실제 지급일" Width="110" DisplayFormat="yyyy-MM-dd" />
                    <DxGridDataColumn FieldName="@nameof(PublicTransaction.PaymentStatus)" Caption="결과" Width="100">
                        <CellDisplayTemplate Context="cell"><PayBadge Code="@(((PublicTransaction)cell.DataItem).PaymentStatus)" /></CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </CommGrd>
        </CommCont>

        <CommCont Title="내 이의제기">
            <CommGrd TItem="DisputeInfo" Data="@_disputes" ExportName="내이의제기">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.CreatedAt)" Caption="접수" Width="140">
                        <CellDisplayTemplate Context="cell">@CargoCodes.Moment(((DisputeInfo)cell.DataItem).CreatedAt)</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.TransportDate)" Caption="운송일" Width="110" DisplayFormat="yyyy-MM-dd" />
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.Amount)" Caption="운송료" Width="110"
                                      DisplayFormat="#,0" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.Reason)" Caption="사유" Width="120">
                        <CellDisplayTemplate Context="cell">@CargoCodes.DisputeReasonName(((DisputeInfo)cell.DataItem).Reason)</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.Content)" Caption="내용" MinWidth="180" />
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.Status)" Caption="상태" Width="90">
                        <CellDisplayTemplate Context="cell">
                            @{ var x = (DisputeInfo)cell.DataItem; }
                            <span class="@CargoCodes.DisputeStatusBadge(x.Status)">@CargoCodes.DisputeStatusName(x.Status)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(DisputeInfo.Resolution)" Caption="처리 결과" MinWidth="160" />
                </Columns>
            </CommGrd>
        </CommCont>
    }
</div>

<CommPopup @bind-Visible="_open" HeaderText="이의제기" Width="560px">
    <BodyContentTemplate Context="popup">
        @if (_target is not null)
        {
            <dl class="ct-facts">
                <div><dt>대상 거래</dt><dd>@CargoCodes.Day(_target.TransportDate)</dd></div>
                <div><dt>운송료</dt><dd>@CargoCodes.Won(_target.Amount)</dd></div>
                <div><dt>구간</dt><dd>@_target.Route</dd></div>
                <div><dt>등록된 결과</dt><dd><PayBadge Code="@_target.PaymentStatus" /></dd></div>
            </dl>
        }
        <DxFormLayout CssClass="ct-form">
            <DxFormLayoutItem Caption="이의 사유" ColSpanMd="12">
                <DxRadioGroup Items="@CargoCodes.DisputeReasonOptions" @bind-Value="_reason"
                              TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                              Layout="RadioGroupLayout.Vertical" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="내용" ColSpanMd="12">
                <DxMemo @bind-Text="_content" Rows="5" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="이의제기 제출" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!Loading)" Click="@SubmitAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _open = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    private RenderFragment<PublicTransaction> DisputeButton => t =>
        @<DxButton Text="이의제기" RenderStyle="ButtonRenderStyle.Link" Click="@(() => Open(t))" />;
}
