@* 거래처 등록 팝업. 사업자번호가 열쇠라 먼저 by-number 로 묻는다 — 이름부터 받으면 같은 회사가 두 줄로 쪼개진다.
    확인한 번호와 저장할 번호가 달라지면 안 되므로 번호를 고치면 확인을 다시 받는다. 서버의 409 를 칸을 다 채운 뒤에 듣지 않게 여기서 먼저 묻는다. *@

@inherits DataPage

<CommPopup @bind-Visible="_visible" HeaderText="거래처 등록" Width="560px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="ct-form">
            <DxFormLayoutItem Caption="사업자등록번호" ColSpanMd="12">
                <div class="ct-inline-field">
                    <DxTextBox Text="@_number" TextChanged="@OnNumberChanged"
                               BindValueMode="BindValueMode.OnInput" />
                    <DxButton Text="확인" RenderStyle="ButtonRenderStyle.Secondary"
                              Enabled="@(!Loading)" Click="@CheckAsync" />
                </div>
            </DxFormLayoutItem>

            @if (_existing is not null)
            {
                <DxFormLayoutItem ColSpanMd="12">
                    <PageNotice Tone="NoticeTone.Info">
                        이미 등록된 거래처입니다 — <b>@_existing.CompanyName</b>
                        (@_existing.BusinessNumber@(string.IsNullOrWhiteSpace(_existing.CeoName) ? null : $" · 대표 {_existing.CeoName}"))
                    </PageNotice>
                </DxFormLayoutItem>
            }
            else if (_checked)
            {
                <DxFormLayoutItem Caption="회사명" ColSpanMd="12">
                    <DxTextBox @bind-Text="_form.CompanyName" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="대표자" ColSpanMd="6">
                    <DxTextBox @bind-Text="_form.CeoName" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="전화번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="_form.Phone" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="지역" ColSpanMd="6">
                    <DxTextBox @bind-Text="_form.Region" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="업종" ColSpanMd="6">
                    <DxTextBox @bind-Text="_form.BusinessType" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="사업장 주소" ColSpanMd="12">
                    <DxTextBox @bind-Text="_form.Address" />
                </DxFormLayoutItem>
            }
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        @if (_existing is not null)
        {
            <DxButton Text="@(OnPicked.HasDelegate ? "이 거래처로" : "상세 보기")"
                      RenderStyle="ButtonRenderStyle.Primary" Click="@UseExistingAsync" />
        }
        else if (_checked)
        {
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@(!Loading)" Click="@SaveAsync" />
        }
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _visible = false)" />
    </FooterContentTemplate>
</CommPopup>
