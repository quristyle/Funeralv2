@* 거래 수정 팝업. 칸은 등록과 같은 TransactionFields 를 쓴다 — 두 벌이면 한쪽에만 칸이 더해진다. 감사 기록은 서버가 남긴다.
    거래처 새 등록은 여기서 끈다(AllowCreateCompany="false") — 팝업 위 팝업은 휴대폰에서 뒤 창의 저장 단추를 가린다. *@

@inherits DataPage

<CommPopup @bind-Visible="_visible" HeaderText="거래 수정" Width="720px">
    <BodyContentTemplate Context="popup">
        @if (_draft is not null)
        {
            <TransactionFields Draft="@_draft" AllowCreateCompany="false" />
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!Loading)" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _visible = false)" />
    </FooterContentTemplate>
</CommPopup>
