@*
    신고(CT-011). 거래처 상세 · 거래 상세 · 후기에서 연다.

    신고는 **판정이 아니라 검토 요청**이다 — 관리자가 보고 처리한다(설계안 15).
    그래서 창에는 무엇을 신고하는지(대상 요약)와 사유 하나, 설명만 받는다.
    같은 대상에 처리 안 된 내 신고가 있으면 서버가 409 로 막고, 그 말을 그대로
    토스트로 옮긴다.
*@

@inherits DataPage
@inject CargoTrustClient Api

<CommPopup @bind-Visible="_visible" HeaderText="신고" Width="560px">
    <BodyContentTemplate Context="popup">
        <div class="jsini-hint ct-popup-lead">@CargoCodes.ReportTargetName(_request.TargetType) · @_summary</div>
        <DxFormLayout CssClass="ct-form">
            <DxFormLayoutItem Caption="사유" ColSpanMd="12">
                <DxRadioGroup Items="@CargoCodes.ReportReasonOptions" @bind-Value="_reason"
                              TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                              Layout="RadioGroupLayout.Horizontal" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="_content" Rows="5" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="신고" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!Loading)" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _visible = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    [Parameter] public EventCallback<ReportInfo> OnSaved { get; set; }

    private bool _visible;
    private string? _summary;
    private string? _reason;
    private string? _content;
    private ReportRequest _request = new();

    /// <param name="targetType"><c>COMPANY</c> · <c>TRANSACTION</c> · <c>REVIEW</c></param>
    /// <param name="targetId">대상 번호</param>
    /// <param name="summary">창 위에 적을 대상 요약</param>
    public void Open(string targetType, long targetId, string summary)
    {
        _request = new ReportRequest { TargetType = targetType, TargetId = targetId };
        _summary = summary;
        _reason = null;
        _content = null;
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrEmpty(_reason))
        {
            Say("사유를 고르십시오.", NoticeTone.Warning);
            return;
        }

        _request.Reason = _reason;
        _request.Content = string.IsNullOrWhiteSpace(_content) ? null : _content.Trim();

        ReportInfo? saved = null;
        if (await RunAsync(async () => saved = await Api.CreateReportAsync(_request),
                "신고를 접수했습니다. 처리 상태는 「내 신고」에서 볼 수 있습니다.", "신고하지 못했습니다"))
        {
            _visible = false;
            if (saved is not null)
            {
                await OnSaved.InvokeAsync(saved);
            }
        }
    }
}
