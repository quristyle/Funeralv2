@* 거래 칸 묶음(등록 화면과 수정 팝업 공용). 결제 상태와 실제 지급일은 계약에 없고 결제 등록이 따로 적는다 — 여기서 상태를 고르면 같은 거래가 두 길로 상태를 얻는다.
    칸은 부모가 가진 Draft 를 고친다. 저장은 부르는 쪽이 한다(등록은 상세로, 수정은 목록을 다시 읽는다). *@

<DxFormLayout CssClass="ct-form">
    <DxFormLayoutItem Caption="거래처" ColSpanMd="12">
        <CompanyPicker Value="@Draft.Company" ValueChanged="@OnCompanyChanged" AllowCreate="@AllowCreateCompany" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="운송일" ColSpanMd="6">
        <DxDateEdit @bind-Date="Draft.TransportDate" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="예정 지급일" ColSpanMd="6">
        <DxDateEdit @bind-Date="Draft.ExpectedPaymentDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="출발지" ColSpanMd="6">
        <DxTextBox @bind-Text="Draft.Origin" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="도착지" ColSpanMd="6">
        <DxTextBox @bind-Text="Draft.Destination" />
    </DxFormLayoutItem>

    @* 운송 유형은 자유 입력이다(계약의 권장값만 목록에 둔다). 고르개에 「직접 입력」 줄이 있어야 현장 말(「탑차」 등)을 적을 수 있다. *@
    <DxFormLayoutItem Caption="운송 유형" ColSpanMd="6">
        <NativeSelect Items="@CargoCodes.TransportTypeOptions" Label="운송 유형"
                      AllowUserInput="true" CustomPlaceholder="탑차 · 윙바디 …"
                      Value="@Draft.TransportType"
                      ValueChanged="@(v => Draft.TransportType = v)" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="배차 경로" ColSpanMd="6">
        <DxTextBox @bind-Text="Draft.DispatchChannel" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="운송료(원)" ColSpanMd="6">
        <DxSpinEdit @bind-Value="Draft.Amount" MinValue="0m" Increment="10000m" DisplayFormat="#,0" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="메모" ColSpanMd="12">
        <DxMemo @bind-Text="Draft.Memo" Rows="3" />
    </DxFormLayoutItem>
</DxFormLayout>
