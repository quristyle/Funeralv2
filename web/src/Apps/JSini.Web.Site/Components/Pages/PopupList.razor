@page "/site/popup"

@*
    [사이트 팝업 관리]

    이력: Vue `views/portal/site/popup` → 여기.
    사이트 접속 시 표출되는 팝업 메세지를 관리한다.
*@

<PageTitle>팝업 관리 · 소개사이트·AI</PageTitle>

<h1>팝업 관리 <span class="pm-page__scope">소개사이트·AI</span></h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <DxTextBox @bind-Text="_keyword" NullText="팝업 제목 검색" Style="width: 240px" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadDataAsync" />
    </div>
    <PermissionView Action="MenuAction.Create">
        <DxButton Text="팝업 등록" RenderStyle="ButtonRenderStyle.Success" />
    </PermissionView>
</div>

<DxGrid Data="@_popups" Loading="@_loading" PageSize="15">
    <Columns>
        <DxGridDataColumn FieldName="Title" Caption="팝업 제목" MinWidth="200" />
        <DxGridDataColumn FieldName="StartAt" Caption="시작일" Width="140px" DisplayFormat="yyyy-MM-dd" />
        <DxGridDataColumn FieldName="EndAt" Caption="종료일" Width="140px" DisplayFormat="yyyy-MM-dd" />
        <DxGridDataColumn FieldName="IsActive" Caption="상태" Width="90px">
            <CellDisplayTemplate>
                <span class="badge @((bool)context.Value! ? "bg-success" : "bg-secondary")">
                    @((bool)context.Value! ? "게시중" : "종료")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="관리" Width="120px">
            <CellDisplayTemplate>
                <div class="d-flex gap-1 justify-content-center">
                    <PermissionView Action="MenuAction.Update">
                        <DxButton Text="수정" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
                    </PermissionView>
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton Text="삭제" RenderStyle="ButtonRenderStyle.Danger" SizeMode="SizeMode.Small" />
                    </PermissionView>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

@code {
    private List<PopupItemDto> _popups = [];
    private string? _keyword;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadDataAsync();

    private Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _popups =
            [
                new PopupItemDto { Id = 1, Title = "시스템 점검 안내 팝업", StartAt = DateTime.Now, EndAt = DateTime.Now.AddDays(7), IsActive = true }
            ];
        }
        finally
        {
            _loading = false;
        }
        return Task.CompletedTask;
    }

    public sealed class PopupItemDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public DateTime StartAt { get; set; }
        public DateTime EndAt { get; set; }
        public bool IsActive { get; set; }
    }
}
