@*
    소개사이트·AI 앱의 라우팅. 자기 어셈블리만 본다 —
    다른 업무 앱은 별도 프로세스라 애초에 볼 수 없다.

    권한 없는 화면은 여기서 막는다. 사이드바에서 메뉴를 지우는 것은 정리지
    통제가 아니다 — 주소를 직접 치거나 즐겨찾기로 열면 라우트는 살아 있다.
*@

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated is true)
                {
                    <RedirectTo Url="/forbidden" ForceLoad="true" />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <DxLoadingPanel Visible="true" IsContentBlocked="true" Text="확인 중…" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
