@page "/life/weather/responses"

@*
    [기상 대응 요령] — DB 메뉴 `/life/weather/responses`.
    이력: Vue `views/life/weather/responses.vue` → 여기.

    판정 기준 하나에 대응 요령 여럿이 달린다. 기준이 걸리면(예: 「일 강수량
    50mm 이상」) 그 아래 요령이 순서대로 알림에 실린다.

    [단추 셋이 아무 일도 하지 않았다]

    「요령 추가」·「수정」·「삭제」가 있었지만 `Click` 이 걸려 있지 않았다.
    사용자는 기능이 있는 줄 알고 누르고, 아무 반응이 없으니 고장으로 읽는다 —
    **없는 것보다 나쁘다.** 클라이언트에는 메서드가 다 있었다.

    [기준을 고르지 않으면 등록할 수 없다]

    요령은 반드시 기준에 매달린다. 기준 없이 저장하면 어느 기준에도 속하지
    않아 목록에서 사라진다. 그래서 기준을 고르기 전에는 등록 단추를 잠근다.
*@

@inherits DataPage
@inject LifeEnvClient Client

<PageTitle>기상 대응 요령 · 생활과환경</PageTitle>

<PageHeading Title="기상 대응 요령" Scope="생활과환경" />

<CrudGrid TItem="WeatherResponseItem"
          Data="@_responses"
          EditFormTitle="대응 요령"
          ExportName="대응요령"
          PageSize="20"
          OnNew="@FillNew"
          OnSave="@SaveAsync"
          OnDelete="@DeleteAsync"
          Reload="@ReloadAsync">
    <ChildContent>
        <DxComboBox Data="@_standards"
                    TextFieldName="@nameof(WeatherStandard.Name)"
                    ValueFieldName="@nameof(WeatherStandard.Id)"
                    Value="@_standardId"
                    ValueChanged="@((int id) => OnStandardChangedAsync(id))"
                    NullText="판정 기준을 고르십시오"
                    Style="width: 260px" />

        @if (Selected is { } std)
        {
            @* 어떤 조건일 때 이 요령이 나가는지 함께 보여 준다. 요령만 보면
               「언제 나가는 것인가」를 알 수 없다. *@
            <span class="lf-condition">@std.ConditionText</span>
        }
    </ChildContent>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(WeatherResponseItem.SortOrder)" Caption="순서" Width="70" />
        <DxGridDataColumn FieldName="@nameof(WeatherResponseItem.ActionContent)" Caption="조치 및 대응 내용" MinWidth="300" />
        <DxGridDataColumn FieldName="@nameof(WeatherResponseItem.Description)" Caption="비고" MinWidth="160" />
    </Columns>

    <EditForm Context="edit">
        @{
            var item = (WeatherResponseItem)edit.EditModel;
        }
        <DxFormLayout CssClass="lf-editform">
            <DxFormLayoutItem Caption="판정 기준" ColSpanMd="8">
                <DxComboBox Data="@_standards" @bind-Value="item.WeatherStandardId"
                            TextFieldName="@nameof(WeatherStandard.Name)"
                            ValueFieldName="@nameof(WeatherStandard.Id)"
                            NullText="기준을 고르십시오" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="순서" ColSpanMd="4">
                <DxSpinEdit @bind-Value="item.SortOrder" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="조치 내용" ColSpanMd="12">
                <DxMemo @bind-Text="item.ActionContent" Rows="4"
                        NullText="알림에 실릴 문장" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxMemo @bind-Text="item.Description" Rows="3"
                        NullText="알림에 실리지 않는 메모" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditForm>
</CrudGrid>

@code {
    private IReadOnlyList<WeatherStandard> _standards = [];
    private IReadOnlyList<WeatherResponseItem> _responses = [];

    private int _standardId;

    private WeatherStandard? Selected => _standards.FirstOrDefault(s => s.Id == _standardId);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(async () =>
        {
            _standards = await Client.GetStandardsAsync();

            // 첫 기준을 골라 둔다. 안 고르면 빈 표만 보이고 무엇을 해야 하는지
            // 알 수 없다.
            _standardId = _standards.FirstOrDefault()?.Id ?? 0;

            return _standards.Count;
        }, "등록된 판정 기준이 없습니다. 「날씨 기준 관리」에서 먼저 만드십시오.",
           "판정 기준을 읽지 못했습니다");

        if (_standardId != 0)
        {
            await ReloadAsync();
        }
    }

    private async Task OnStandardChangedAsync(int id)
    {
        _standardId = id;
        _responses = [];

        if (id != 0)
        {
            await ReloadAsync();
        }
    }

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        if (_standardId == 0)
        {
            _responses = [];
            return 0;
        }

        var rows = await Client.GetResponsesByStandardAsync(_standardId);
        _responses = [.. rows.OrderBy(r => r.SortOrder)];

        return _responses.Count;
    }, "이 기준에 등록된 요령이 없습니다.", "대응 요령을 읽지 못했습니다");

    private void FillNew(WeatherResponseItem item)
    {
        // 고른 기준을 물려준다. 안 넣으면 어느 기준에도 속하지 않아
        // 저장돼도 목록에서 사라진다.
        item.WeatherStandardId = _standardId;
        item.SortOrder = _responses.Count == 0 ? 1 : _responses.Max(r => r.SortOrder) + 1;
    }

    private Task SaveAsync((WeatherResponseItem Item, bool IsNew) e)
    {
        if (e.Item.WeatherStandardId == 0)
        {
            throw new ApiException("판정 기준을 고르십시오.");
        }

        if (string.IsNullOrWhiteSpace(e.Item.ActionContent))
        {
            throw new ApiException("조치 내용을 넣으십시오.");
        }

        return e.IsNew
            ? Client.CreateResponseAsync(e.Item)
            : Client.UpdateResponseAsync(e.Item.Id, e.Item);
    }

    private Task DeleteAsync(WeatherResponseItem item) => Client.DeleteResponseAsync(item.Id);
}
