@page "/life/weather/dashboard"
@attribute [RouteKey("life.weather.dashboard")]
@using JSini.Web.LifeEnv.Api

@*
    [기상 현황판]

    이력: Vue `views/life/weather/dashboard.vue` → 여기.
    호출: `life/weather`(전 지역 실황) · `life/weather/locations` ·
          `life/weather/current/{id}` · `life/weather/mid-term/{id}` ·
          `life/weather/forecast/{id}`(-10h~+10h 타임라인, 추이 차트 재료)

    전 지역 최신 실황을 카드로 늘어놓고, 고른 지역의 실황 상세·주간 예보·
    예보 추이 차트를 아래에 편다.

    [실패를 말하지 않고 있었다]

    `try/finally` 로 도는 표시만 끄고 실패는 삼켰다. 게이트웨이가 내려가 있어도
    **빈 카드**가 나오고, 사용자는 「자료가 없다」로 읽는다.

    [지역을 골라도 아무 일이 없었다]

    위 줄에 「선택한 지역의 주간 예보 및 추이를 시각화한다」고 적혀 있었는데,
    고르면 **카드에 테두리만 생겼다.** 주간 예보를 부르는 곳이 화면 어디에도
    없었고(`mid-term`), 어제 대비 기온도 마찬가지였다(`current` 가 준다).
    클라이언트에는 둘 다 있었다. 실황·주간 예보를 먼저 붙였고, 남아 있던
    「추이 시각화」는 아래 차트로 마저 해소했다.

    [예보 추이 차트 — D3 결정 반영]

    옛 화면의 예보 추이 차트(echarts, 기온/강수/바람/습도 라디오로 갈아
    끼움)를 DevExpress `DxChart` 로 되살렸다 — D3: 「DevExpress Blazor
    차트를, 기존에 차트가 있던 화면에」. 재료는 클라이언트에 이미 있던
    `forecast/{id}` 타임라인이고 카테고리 전환은 받아 둔 자료를 다시 그리기만
    한다(옛 화면과 같다). 옛 화면의 NOW 주황 점선은 상수선 대신 실측→예보가
    갈리는 칸의 X 라벨을 「지금」으로 바꿔 표시한다 — 뜻은 같고 부품은 적다.

    [차트가 점투성이였다]

    21칸 추이에 둥근 점을 다 찍어 놓아, 선이 아니라 점이 먼저 보였다.
    점을 감추고 곡선 2px 한 줄로 바꿨다 — 「어느 시각인가」는 십자선이,
    값은 말풍선이 준다. 항목마다 색을 따로 주고(기온 주황 · 강수 파랑 ·
    바람 청록 · 습도 보라) 그 넷은 밝고 어두운 두 테마에서 모두 재어
    골랐다. 자세한 것은 아래 색 상수 옆에 적어 두었다.

    [어제 대비를 색만으로 보이지 않는다]

    오르내림에 화살표를 함께 쓴다. 색만으로 가르면 색약인 사람에게는 두 값이
    같아 보인다 — 이 저장소의 다른 화면과 같은 규칙이다.
*@

@inherits DataPage
@inject LifeEnvClient Client

<PageTitle>기상 현황판 · 생활과환경</PageTitle>

<div class="jsini-card">
    <div class="jsini-split">
        <div class="jsini-inline">
            <span class="le-pick__label">지역 선택:</span>
            <DxComboBox Data="@_locations"
                        TextFieldName="Name"
                        ValueFieldName="Id"
                        Value="@_selectedLocationId"
                        ValueChanged="@((int val) => OnLocationSelected(val))"
                        Style="width: 200px" />
        </div>
        <div class="jsini-inline">
            @* 두 단추는 다른 화면으로 가는 길이다. 한동안 Click 이 안 걸려
               있어서 눌러도 아무 일이 없었다 — 기능이 있는 줄 알고 누르게
               되므로 없는 것보다 나빴다.

               NavigateUrl 을 쓰면 가운데 클릭으로 새 탭에 열리고 마우스를
               올렸을 때 주소가 보인다. *@
            <DxButton Text="시간대별 예보" RenderStyle="ButtonRenderStyle.Secondary"
                      NavigateUrl="/life/weather/forecast" />
            <DxButton Text="특보 현황" RenderStyle="ButtonRenderStyle.Secondary"
                      NavigateUrl="/life/weather/warning" />
            <DxButton Text="새로고침" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadDataAsync" />
        </div>
    </div>
</div>

@if (Loading)
{
    @* 이 저장소의 도는 표시는 DevExpress 것 한 벌이다(DynamicGrid 와 같다).
       전에는 Bootstrap `spinner-border` 였는데 기본 테마에 그 클래스가 없어
       아무것도 없는 빈칸이 잠깐 스쳤다. *@
    <DxLoadingPanel Visible="true" IsContentBlocked="true" Text="조회 중…" />
}
else
{
    @if (_detailError)
    {
        <PageNotice Tone="NoticeTone.Warning"
                    Text="선택한 지역의 상세 예보를 읽지 못했습니다. 지역을 다시 선택하거나 새로고침하십시오." />
    }

    <div class="le-obs">
        @foreach (var w in _weatherList)
        {
            @* 카드를 누르면 아래 실황·주간 예보·추이가 그 지역으로 바뀐다. *@
            <div class="le-obs__card @(w.WeatherLocationId == _selectedLocationId ? "is-on" : "")"
                 @onclick="@(() => OnLocationSelected(w.WeatherLocationId ?? 0))">
                <div class="jsini-split">
                    <h3 class="le-obs__where">📍 @w.Location</h3>
                    <span class="jsini-hint">@w.ObservationTime.ToString("HH:mm 관측")</span>
                </div>
                <div class="le-obs__now">
                    <span class="le-obs__temp">@w.TemperatureC.ToString("F1")°C</span>
                    <span class="le-obs__cond">@w.Condition</span>
                </div>
                <div class="le-obs__facts">
                    <span>습도: @(w.Humidity?.ToString() ?? "-")%</span>
                    <span>풍속: @(w.WindSpeed?.ToString("F1") ?? "-")m/s</span>
                    <span>강수: @(w.Rainfall?.ToString("F1") ?? "0")mm</span>
                </div>
            </div>
        }
    </div>

    @if (_current is not null)
    {
        <DashboardSection Title="@($"{_current.Location} 실황")">
            <ChildContent>
                <div class="le-cur">
                    <div class="le-cur__now">
                        <span class="le-cur__temp">@_current.TemperatureC.ToString("F1")°C</span>
                        <span class="le-cur__cond">@_current.Condition</span>
                    </div>

                    @if (_current.YesterdayTemperature is { } yesterday)
                    {
                        var gap = _current.TemperatureC - yesterday;

                        @* 색만으로 가르지 않는다 — 화살표를 함께 쓴다. *@
                        <span class="@(gap >= 0 ? "lf-up" : "lf-down")">
                            어제보다 @(gap >= 0 ? "▲" : "▼") @Math.Abs(gap).ToString("F1")°C
                        </span>
                    }
                    else
                    {
                        <span class="le-dept">어제 기온이 아직 없습니다.</span>
                    }

                    @if (_current.SensibleTemp is { } feels)
                    {
                        <span class="le-dept">체감 @feels.ToString("F1")°C</span>
                    }
                </div>
            </ChildContent>
        </DashboardSection>

        <DashboardSection Title="주간 예보">
            <ChildContent>
                @if (_midTerm.Count == 0)
                {
                    <p class="le-today__empty">이 지역의 주간 예보가 아직 없습니다.</p>
                }
                else
                {
                    <div class="le-week">
                        @foreach (var day in _midTerm)
                        {
                            <div class="le-week__day">
                                <span class="le-week__when">@day.DayDisplay</span>
                                <span class="le-week__date">@day.Date</span>

                                <span class="le-week__sky">
                                    @* 하루 단위 예보는 오전·오후가 갈리지 않는다.
                                       그때 빈칸 둘을 보여 주면 자료가 없는 것처럼 읽힌다. *@
                                    @(string.IsNullOrWhiteSpace(day.AmSky) && string.IsNullOrWhiteSpace(day.PmSky)
                                        ? "-"
                                        : $"{day.AmSky} / {day.PmSky}")
                                </span>

                                <span class="le-week__temp">
                                    <span class="lf-down">@day.MinTemp°</span>
                                    <span class="lf-up">@day.MaxTemp°</span>
                                </span>

                                <span class="le-week__pop">강수 @day.AmPop% / @day.PmPop%</span>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </DashboardSection>

        <h2 class="le-today__head">예보 추이</h2>

        @if (_trend.Count == 0)
        {
            <p class="le-today__empty">이 지역의 예보 추이가 아직 없습니다.</p>
        }
        else
        {
            <div class="jsini-card">
                <div class="jsini-split le-trend__head">
                    <div class="jsini-actions">
                        @* 옛 화면의 카테고리 라디오 자리. 자료는 한 번 받아 두고
                           고른 항목만 다시 그린다 — 단추마다 서버를 부르지 않는다. *@
                        <DxButton Text="기온"
                                  RenderStyle="@MetricStyle(TrendMetric.Temp)"
                                  Click="@(() => _metric = TrendMetric.Temp)" />
                        <DxButton Text="강수"
                                  RenderStyle="@MetricStyle(TrendMetric.Rain)"
                                  Click="@(() => _metric = TrendMetric.Rain)" />
                        <DxButton Text="바람"
                                  RenderStyle="@MetricStyle(TrendMetric.Wind)"
                                  Click="@(() => _metric = TrendMetric.Wind)" />
                        <DxButton Text="습도"
                                  RenderStyle="@MetricStyle(TrendMetric.Humid)"
                                  Click="@(() => _metric = TrendMetric.Humid)" />
                    </div>
                    <span class="jsini-hint">지난 10시간 실측 · 「지금」 칸부터 예보</span>
                </div>

                @*
                    [둥근 점을 걷어냈다]

                    21칸짜리 추이에 점을 다 찍으면 선보다 점이 먼저 보인다.
                    점은 감추고(`DxChartSeriesPoint Visible="false"`) 「어느
                    시각을 보고 있나」는 십자선이 준다 — 값은 말풍선이 그대로
                    준다. 곡선(spline)은 시간당 한 칸인 기상값에 맞고, 점이
                    없어도 흐름이 끊겨 보이지 않는다.

                    X 축의 눈금·세로 격자도 지웠다. 21칸이 전부 줄이 되면
                    자료보다 바탕이 시끄럽다. 가로 격자(값 축)만 남긴다.
                *@
                <DxChart Data="@_trend" Width="100%" Height="280px">
                    <DxChartLegend Visible="false" />

                    <DxChartArgumentAxis>
                        <DxChartAxisGridLines Visible="false" />
                        <DxChartAxisTick Visible="false" />
                        <DxChartAxisLabel Overlap="ChartAxisLabelOverlap.Hide" />
                    </DxChartArgumentAxis>

                    @* 세로 한 줄만. 가로선까지 따라다니면 격자가 두 벌이 된다. *@
                    <DxChartCrosshair Enabled="true" Width="1" Opacity="0.7"
                                      DashStyle="ChartDashStyle.Dot" Color="#8a93a5">
                        <DxChartCrosshairHorizontalLine Visible="false" />
                    </DxChartCrosshair>

                    @switch (_metric)
                    {
                        case TrendMetric.Rain:
                            @* 강수량만 막대로 — 옛 화면과 같다. 강수확률(%)은 단위가
                               달라 같은 축에 못 올린다. 주간 예보 줄이 이미 보여 준다.
                               막대는 끝만 둥글리고(4px) 사이에 여백을 둔다. *@
                            <DxChartBarSeries T="TrendPoint" TArgument="string" TValue="double?"
                                              ArgumentField="p => p.Label"
                                              ValueField="p => p.Rain"
                                              Color="@RainColor"
                                              CornerRadius="4"
                                              BarPadding="0.3"
                                              Name="강수량(mm)" />
                            <DxChartValueAxis>
                                <DxChartAxisTitle Text="강수량(mm)" />
                            </DxChartValueAxis>
                            break;
                        case TrendMetric.Wind:
                            <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double"
                                                 ArgumentField="p => p.Label"
                                                 ValueField="p => p.WindSpeed"
                                                 Color="@WindColor"
                                                 Width="2"
                                                 Name="풍속(m/s)">
                                <DxChartSeriesPoint Visible="false" />
                            </DxChartSplineSeries>
                            <DxChartValueAxis>
                                <DxChartAxisTitle Text="풍속(m/s)" />
                            </DxChartValueAxis>
                            break;
                        case TrendMetric.Humid:
                            <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double?"
                                                 ArgumentField="p => p.Label"
                                                 ValueField="p => p.Humidity"
                                                 Color="@HumidColor"
                                                 Width="2"
                                                 Name="습도(%)">
                                <DxChartSeriesPoint Visible="false" />
                            </DxChartSplineSeries>
                            <DxChartValueAxis>
                                <DxChartAxisRange StartValue="@(0)" EndValue="@(100)" />
                                <DxChartAxisTitle Text="습도(%)" />
                            </DxChartValueAxis>
                            break;
                        default:
                            <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double"
                                                 ArgumentField="p => p.Label"
                                                 ValueField="p => p.Temp"
                                                 Color="@TempColor"
                                                 Width="2"
                                                 Name="기온(°C)">
                                <DxChartSeriesPoint Visible="false" />
                            </DxChartSplineSeries>
                            <DxChartValueAxis>
                                <DxChartAxisTitle Text="기온(°C)" />
                            </DxChartValueAxis>
                            break;
                    }

                    @* 값을 앞에 크게, 무엇인지는 뒤에 작게 — 말풍선을 볼 때는
                       이미 무엇을 보는지 알고 숫자를 찾는다. *@
                    <DxChartTooltip Enabled="true">
                        <div class="le-trend__tip">
                            <span class="le-trend__tip-value">@TipValue(context.Point.Value)</span>
                            <span class="le-trend__tip-meta">@context.Point.SeriesName · @context.Point.Argument</span>
                        </div>
                    </DxChartTooltip>
                </DxChart>
            </div>
        }
    }
}

@code {
    private List<WeatherInfo> _weatherList = [];
    private List<WeatherLocation> _locations = [];
    private int _selectedLocationId;

    private WeatherInfo? _current;
    private List<MidTermForecast> _midTerm = [];
    private List<TrendPoint> _trend = [];
    private TrendMetric _metric = TrendMetric.Temp;
    private bool _detailError;

    protected override Task OnInitializedAsync() => LoadDataAsync();

    /// <summary>
    /// 전 지역 실황과 지역 목록.
    ///
    /// 실패를 삼키지 않는다 — 게이트웨이가 내려가 있어도 빈 카드가 나오면
    /// 사용자는 「자료가 없다」로 읽는다. 기상 자료는 실제로 비는 때가 있어서
    /// 그 둘을 구분해 주지 않으면 아무도 신고하지 않는다.
    /// </summary>
    private Task LoadDataAsync() => LoadAsync(async () =>
    {
        // 둘을 나란히. 서로 기다릴 이유가 없다.
        var weather = Client.GetLatestWeatherAsync();
        var locations = Client.GetLocationsAsync();

        await Task.WhenAll(weather, locations);

        _weatherList = [.. weather.Result];
        _locations = [.. locations.Result];

        if (_selectedLocationId == 0 && _locations.Count > 0)
        {
            _selectedLocationId = _locations[0].Id;
        }

        await LoadSelectedAsync();

        return _weatherList.Count;
    }, "등록된 관측 지역의 실황이 아직 없습니다.", "실황을 읽지 못했습니다");

    private async Task OnLocationSelected(int id)
    {
        if (id == 0 || id == _selectedLocationId)
        {
            return;
        }

        _selectedLocationId = id;
        await LoadSelectedAsync();
    }

    /// <summary>
    /// 고른 지역의 실황 상세 · 주간 예보 · 예보 추이(차트 재료).
    ///
    /// 셋을 나란히 부른다. 실패해도 위 카드는 그대로 둔다 — 한 지역의 예보를
    /// 못 읽었다고 전 지역 실황까지 사라지면 이 화면을 여는 이유가 없어진다.
    /// </summary>
    private async Task LoadSelectedAsync()
    {
        _current = null;
        _midTerm = [];
        _trend = [];
        _detailError = false;

        if (_selectedLocationId == 0)
        {
            return;
        }

        try
        {
            var current = Client.GetCurrentWeatherAsync(_selectedLocationId);
            var midTerm = Client.GetMidTermForecastAsync(_selectedLocationId);
            var forecast = Client.GetForecastAsync(_selectedLocationId);

            await Task.WhenAll(current, midTerm, forecast);

            _current = current.Result;
            _midTerm = [.. midTerm.Result];
            _trend = BuildTrend(forecast.Result);
        }
        catch (ApiException)
        {
            // 전 지역 카드까지 지우면 정상 자료와 장애를 구분할 수 없으므로
            // 카드와 마지막 성공 자료는 남기고, 상세 영역만 상태를 알린다.
            _detailError = true;
            _current = null;
            _midTerm = [];
            _trend = [];
        }
    }

    private ButtonRenderStyle MetricStyle(TrendMetric metric)
        => _metric == metric ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary;

    /*  ── 항목별 선 색 ────────────────────────────────────────

        차트 색은 여기 C# 에서 정해지는데 **테마는 브라우저가 바꾼다**
        (theme.js 가 `data-theme` 을 세운다 — 서버 쪽에는 그 신호가 없다).
        그래서 한쪽 바탕에만 맞춘 색을 쓰면 다른 쪽에서 묻힌다.

        네 값은 **밝은 카드(#ffffff)와 어두운 카드(#1e3048) 양쪽에서 재어**
        고른 것이다 — 밝기 띠(OKLCH L)·채도 바닥·바탕 대비(WCAG ≥ 3:1)
        셋을 두 바탕에서 모두 통과한다. 색을 바꿀 일이 생기면 두 바탕에서
        다시 재고 바꾼다. 항목이 한 번에 하나만 그려지므로 색맹 구분(색끼리의
        거리)은 따지지 않아도 되고, 무엇을 보고 있는지는 누른 단추와 축 제목이
        말해 준다 — 색만으로 가르지 않는다. */
    private static readonly System.Drawing.Color TempColor = System.Drawing.ColorTranslator.FromHtml("#d95926");
    private static readonly System.Drawing.Color RainColor = System.Drawing.ColorTranslator.FromHtml("#2a78d6");
    private static readonly System.Drawing.Color WindColor = System.Drawing.ColorTranslator.FromHtml("#199e70");
    private static readonly System.Drawing.Color HumidColor = System.Drawing.ColorTranslator.FromHtml("#9085e9");

    /// <summary>
    /// 말풍선에 쓰는 값. 소수점이 길게 붙으면(18.200000000000003) 숫자가
    /// 읽히지 않으므로 한 자리까지만 남긴다.
    /// </summary>
    private static string TipValue(object? value)
        => value is double d ? d.ToString("0.#") : value?.ToString() ?? "-";

    /// <summary>
    /// 타임라인을 차트 점으로 옮긴다.
    ///
    /// X 라벨 규칙은 옛 화면 그대로다 — 날짜가 바뀌는 칸은 M/D, 나머지는 HH시.
    /// 실측→예보가 갈리는 칸만 「지금」으로 바꾼다(옛 NOW 점선 자리).
    /// 타임라인이 21시간이라 시각 라벨이 겹칠 일이 없다 — 카테고리 축은
    /// 같은 라벨을 한 칸으로 합치므로, 하루를 넘는 자료를 다루게 되면
    /// 라벨에 날짜를 함께 넣어야 한다.
    /// </summary>
    private static List<TrendPoint> BuildTrend(IReadOnlyList<WeatherTimelinePoint> rows)
    {
        var list = new List<TrendPoint>(rows.Count);

        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var isNow = row.IsForecast && (i == 0 || !rows[i - 1].IsForecast);
            var isNewDate = i == 0 || row.Date != rows[i - 1].Date;

            var label = isNow
                ? "지금"
                : isNewDate ? DayLabel(row.Date) : HourLabel(row.Time);

            list.Add(new TrendPoint(label, row.Temp, row.Rain, row.WindSpeed, row.Reh));
        }

        return list;
    }

    /// <summary>yyyyMMdd → "M/d". 형식이 어긋난 값은 그대로 보여 준다 — 라벨 하나 때문에 화면을 세우지 않는다.</summary>
    private static string DayLabel(string date)
        => date.Length == 8 && int.TryParse(date[4..6], out var m) && int.TryParse(date[6..8], out var d)
            ? $"{m}/{d}"
            : date;

    /// <summary>HHmm → "HH시".</summary>
    private static string HourLabel(string time)
        => time.Length >= 2 ? $"{time[..2]}시" : time;

    private enum TrendMetric { Temp, Rain, Wind, Humid }

    /// <summary>차트 한 점. 습도는 실측 구간에 빈 칸이 있을 수 있어 nullable — DxChart 는 null 을 빈 칸으로 건너뛴다.</summary>
    private sealed record TrendPoint(string Label, double Temp, double? Rain, double WindSpeed, double? Humidity);
}
