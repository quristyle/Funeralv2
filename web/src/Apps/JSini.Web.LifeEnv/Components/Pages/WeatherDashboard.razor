@page "/life/weather/dashboard"
@attribute [RouteKey("life.weather.dashboard")]
@using JSini.Web.LifeEnv.Api

@*
    기상 현황판(DB 메뉴 /life/weather/dashboard). 전 지역 실황 카드 · 고른 지역의 실황·오늘의 예보·주간 예보·추이 차트.
    내 위치는 브라우저 좌표로 그 지점을 받는다. 위치는 단추만 다시 묻고 서버에 저장하지 않는다(알림 설정의 몫). 추이는 등록 지역에만 있다.
*@

@inherits DataPage
@implements IAsyncDisposable

<PageTitle>기상 현황판 · 생활과환경</PageTitle>

<div class="jsini-card">
    <div class="jsini-split">
        <div class="jsini-inline">
            <span class="le-pick__label">지역 선택:</span>
            @* 맨 앞 줄이 내 위치다. 기본값은 등록 지역의 첫 줄이어야 한다 — 내 위치가 기본이면 열자마자 위치 물음창이 뜬다. *@
            <DxComboBox Data="@_picks"
                        TextFieldName="Name"
                        ValueFieldName="Id"
                        Value="@_selectedLocationId"
                        ValueChanged="@((int val) => OnLocationSelected(val))"
                        Style="width: 200px" />
        </div>
        <div class="jsini-inline">
            @* 고르개는 같은 값을 다시 고를 수 없어, 자리를 옮긴 사람이 새 좌표를 잡으려면 이 단추가 필요하다. 누를 때마다 다시 묻는다. *@
            <DxButton Text="📍 내 위치"
                      RenderStyle="@(MyOn ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                      Enabled="@(!_myBusy)"
                      Click="@UseMyLocationAsync" />

            @* 다른 화면으로 가는 단추는 NavigateUrl 로 둔다 — 가운데 클릭으로 새 탭이 열리고 주소가 보인다. *@
            <DxButton Text="시간대별 예보" RenderStyle="ButtonRenderStyle.Secondary"
                      NavigateUrl="/life/weather/forecast" />
            <DxButton Text="특보 현황" RenderStyle="ButtonRenderStyle.Secondary"
                      NavigateUrl="/life/weather/warning" />
            <DxButton Text="새로고침" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadDataAsync" />
        </div>
    </div>
</div>

@if (Loading)
{
    @* 도는 표시는 DevExpress 것을 쓴다 — Bootstrap spinner 클래스는 기본 테마에 없다. *@
    <DxLoadingPanel Visible="true" IsContentBlocked="true" Text="조회 중…" />
}
else
{
    @if (_detailError)
    {
        <PageNotice Tone="NoticeTone.Warning"
                    Text="선택한 지역의 상세 예보를 읽지 못했습니다. 지역을 다시 선택하거나 새로고침하십시오." />
    }

    <div class="le-obs">
        @* 내 위치 카드는 실황 줄 맨 앞에 선다. 잡은 뒤에는 누르기만 하면 되고(날씨만 다시 받는다), 등록 지역 사이에 섞으면 찾기 어렵다. *@
        @if (_point is not null)
        {
            <div class="le-obs__card le-obs__card--me @(MyOn ? "is-on" : "")"
                 @onclick="@SelectMyLocationAsync">
                <div class="jsini-split">
                    <h3 class="le-obs__where">📍 @MyPlaceName</h3>
                    <span class="jsini-hint">
                        @(_point.Now is { } seen ? SeenAt(seen.ObservedAt) : "실황 없음")
                    </span>
                </div>

                @if (_point.Now is { } mine)
                {
                    <div class="le-obs__now">
                        <span class="le-obs__temp">@mine.TemperatureC.ToString("F1")°C</span>
                        <span class="le-obs__cond">@mine.Condition</span>
                    </div>
                    <div class="le-obs__facts">
                        <span>습도: @(mine.Humidity?.ToString() ?? "-")%</span>
                        <span>풍속: @(mine.WindSpeed?.ToString("F1") ?? "-")m/s</span>
                        <span>강수: @(mine.Rainfall?.ToString("F1") ?? "0")mm</span>
                    </div>
                }
                else
                {
                    @* 기상청이 답하지 않아도 카드는 선다(지역 이름은 우리 표에서 찾는다). 빈 칸만 보이면 자료가 빠진 것처럼 읽힌다. *@
                    <div class="le-obs__now">
                        <span class="le-obs__cond">기상청 실황을 받지 못했습니다.</span>
                    </div>
                }
            </div>
        }

        @foreach (var w in _weatherList)
        {
            <div class="le-obs__card @(w.WeatherLocationId == _selectedLocationId ? "is-on" : "")"
                 @onclick="@(() => OnLocationSelected(w.WeatherLocationId ?? 0))">
                <div class="jsini-split">
                    <h3 class="le-obs__where">📍 @w.Location</h3>
                    <span class="jsini-hint">@w.ObservationTime.ToString("HH:mm 관측")</span>
                </div>
                <div class="le-obs__now">
                    <span class="le-obs__temp">@w.TemperatureC.ToString("F1")°C</span>
                    <span class="le-obs__cond">@w.Condition</span>
                </div>
                <div class="le-obs__facts">
                    <span>습도: @(w.Humidity?.ToString() ?? "-")%</span>
                    <span>풍속: @(w.WindSpeed?.ToString("F1") ?? "-")m/s</span>
                    <span>강수: @(w.Rainfall?.ToString("F1") ?? "0")mm</span>
                </div>
            </div>
        }
    </div>

    @* 내 위치에는 실황과 사흘 예보만 있다 — 추이는 등록 지역에만 있어서 없는 것을 빈 카드로 그리지 않고 한 줄로 적는다. *@
    @if (MyOn)
    {
        @if (_myBusy)
        {
            <PageNotice Tone="NoticeTone.Info" Text="내 위치를 확인하는 중입니다…" />
        }
        else if (!string.IsNullOrWhiteSpace(_myError))
        {
            @* 토스트가 아니라 화면에 둔다 — 읽고 무언가를 해야 하는 안내라서다. *@
            <PageNotice Tone="NoticeTone.Warning" Text="@_myError" />
        }

        @if (_point is not null)
        {
            <DashboardSection Title="@($"{MyPlaceName} 실황")" Hint="@MyPlaceHint">
                <ChildContent>
                    @if (_point.Now is { } now)
                    {
                        <div class="le-cur">
                            <div class="le-cur__now">
                                <span class="le-cur__temp">@now.TemperatureC.ToString("F1")°C</span>
                                <span class="le-cur__cond">@now.Condition</span>
                            </div>

                            @* 한 지점에는 어제 기온 이력이 없다 — 없는 것을 0 으로 적으면 거짓이 된다. *@
                            @if (now.SensibleTemp is { } feels)
                            {
                                <span class="le-dept">체감 @feels.ToString("F1")°C</span>
                            }

                            <span class="le-dept">습도 @(now.Humidity?.ToString() ?? "-")%</span>
                            <span class="le-dept">풍속 @(now.WindSpeed?.ToString("F1") ?? "-")m/s</span>
                            <span class="le-dept">강수 @(now.Rainfall?.ToString("F1") ?? "0")mm</span>
                            <span class="jsini-hint">@SeenAt(now.ObservedAt)</span>
                        </div>
                    }
                    else
                    {
                        <p class="le-today__empty">
                            기상청 실황을 받지 못했습니다. 아래 예보만 보여 드립니다.
                        </p>
                    }
                </ChildContent>
            </DashboardSection>

            <DashboardSection Title="사흘 예보">
                <ChildContent>
                    @if (_point.Days.Count == 0)
                    {
                        <p class="le-today__empty">내 위치의 예보가 아직 없습니다.</p>
                    }
                    else
                    {
                        <div class="le-week">
                            @foreach (var day in _point.Days)
                            {
                                <div class="le-week__day">
                                    <span class="le-week__when">@day.Label</span>
                                    <span class="le-week__date">@DayLabel(day.Date)</span>

                                    <span class="le-week__sky">
                                        @(string.IsNullOrWhiteSpace(day.Condition) ? "-" : day.Condition)
                                    </span>

                                    <span class="le-week__temp">
                                        <span class="lf-down">@(day.MinC is { } lo ? $"{lo:0}°" : "-")</span>
                                        <span class="lf-up">@(day.MaxC is { } hi ? $"{hi:0}°" : "-")</span>
                                    </span>

                                    @* 강수확률이 없는 날은 비워 둔다 — 0% 로 적으면 「비 안 온다」로 읽힌다. *@
                                    <span class="le-week__pop">
                                        강수 @(day.RainProbability is { } pop ? $"{pop}%" : "-")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </ChildContent>
            </DashboardSection>

            @* 내 위치의 주간 예보는 서버가 좌표에서 고른 중기 구역으로 받는다. 시·군 단위라 사흘 예보보다 성기고, 사흘 예보와 날짜가 겹치는 것이 맞다. *@
            <DashboardSection Title="주간 예보" Hint="@WeekHint">
                <ChildContent>
                    @if (_midTerm.Count == 0)
                    {
                        <p class="le-today__empty">
                            @(_point.Place is null
                                ? "지역 이름을 찾지 못해 주간 예보를 만들 수 없습니다. 바다 위 좌표일 수 있습니다."
                                : "내 위치의 주간 예보가 아직 없습니다.")
                        </p>
                    }
                    else
                    {
                        <WeekForecastRow Days="_midTerm" />
                    }
                </ChildContent>
            </DashboardSection>
        }
    }
    else if (_current is not null)
    {
        <DashboardSection Title="@($"{_current.Location} 실황")">
            <ChildContent>
                <div class="le-cur">
                    <div class="le-cur__now">
                        <span class="le-cur__temp">@_current.TemperatureC.ToString("F1")°C</span>
                        <span class="le-cur__cond">@_current.Condition</span>
                    </div>

                    @if (_current.YesterdayTemperature is { } yesterday)
                    {
                        var gap = _current.TemperatureC - yesterday;

                        <span class="@(gap >= 0 ? "lf-up" : "lf-down")">
                            어제보다 @(gap >= 0 ? "▲" : "▼") @Math.Abs(gap).ToString("F1")°C
                        </span>
                    }
                    else
                    {
                        <span class="le-dept">어제 기온이 아직 없습니다.</span>
                    }

                    @if (_current.SensibleTemp is { } feels)
                    {
                        <span class="le-dept">체감 @feels.ToString("F1")°C</span>
                    }
                </div>
            </ChildContent>
        </DashboardSection>

        @* 오늘의 예보는 추이 차트와 같은 응답에서 오늘치 칸만 고른다. 실측 구간은 넣지 않는다 — 지나간 시각은 위 실황과 아래 추이가 말한다. *@
        <DashboardSection Title="오늘의 예보" Hint="@TodayHint">
            <ChildContent>
                @if (_todayHours.Count == 0)
                {
                    <p class="le-today__empty">오늘 남은 시간대의 예보가 아직 없습니다.</p>
                }
                else
                {
                    <div class="le-week le-week--hours">
                        @foreach (var hour in _todayHours)
                        {
                            <div class="le-week__day">
                                <span class="le-week__when">@hour.Label</span>
                                <span class="le-week__sky">@hour.Sky</span>

                                <span class="le-week__temp">
                                    <span class="lf-up">@hour.Temp.ToString("0.#")°</span>
                                </span>

                                @* 초단기 예보에는 강수확률이 없어 비워 둔다. *@
                                <span class="le-week__pop">
                                    강수 @(hour.Pop is { } pop ? $"{pop}%" : "-")
                                </span>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </DashboardSection>

        <DashboardSection Title="주간 예보">
            <ChildContent>
                @if (_midTerm.Count == 0)
                {
                    <p class="le-today__empty">이 지역의 주간 예보가 아직 없습니다.</p>
                }
                else
                {
                    @* 내 위치 쪽과 같은 줄(WeekForecastRow)이다 — 두 벌로 두면 한쪽만 고쳐진다. *@
                    <WeekForecastRow Days="_midTerm" />
                }
            </ChildContent>
        </DashboardSection>

        <h2 class="le-today__head">예보 추이</h2>

        @if (_trend.Count == 0)
        {
            <p class="le-today__empty">이 지역의 예보 추이가 아직 없습니다.</p>
        }
        else
        {
            <div class="jsini-card">
                <div class="jsini-split le-trend__head">
                    <div class="jsini-actions">
                        @* 단추는 그 카드까지 밀어 줄 뿐이다 — 서버도 차트도 다시 부르지 않는다. *@
                        <DxButton Text="기온"
                                  RenderStyle="@MetricStyle(TrendMetric.Temp)"
                                  Click="@(() => ShowMetric(TrendMetric.Temp))" />
                        <DxButton Text="강수"
                                  RenderStyle="@MetricStyle(TrendMetric.Rain)"
                                  Click="@(() => ShowMetric(TrendMetric.Rain))" />
                        <DxButton Text="바람"
                                  RenderStyle="@MetricStyle(TrendMetric.Wind)"
                                  Click="@(() => ShowMetric(TrendMetric.Wind))" />
                        <DxButton Text="습도"
                                  RenderStyle="@MetricStyle(TrendMetric.Humid)"
                                  Click="@(() => ShowMetric(TrendMetric.Humid))" />
                    </div>
                    <span class="jsini-hint">
                        지난 10시간 실측 · 「지금」 칸부터 예보
                        @* 넘기기 안내는 손가락 화면에서만 보인다(css). *@
                        <span class="le-trend__swipe">· 옆으로 쓸어 넘깁니다</span>
                    </span>
                </div>

                @* 카드 넷은 한 번 그려 두고 가로 스크롤로 넘긴다(css scroll-snap). 담장(ErrorBoundary)은 차트가 터져도 이 칸만 안내로 바꾸려고 둔다. *@
                <ErrorBoundary @ref="_chartGuard">
                    <ChildContent>
                        <div class="le-trend__deck" @ref="_deck">
                            @foreach (var metric in Slides)
                            {
                                <section class="le-trend__slide" data-slide="@metric">
                                    @* 카드 머리가 단위를 말하므로 값 축에는 제목을 달지 않는다. *@
                                    <h3 class="le-trend__slide-head">
                                        <span class="le-trend__mark" style="background: @SlideHex(metric)"></span>
                                        @SlideTitle(metric)
                                    </h3>

                                    <DxChart Data="@_trend" Width="100%" Height="260px">
                                        <DxChartLegend Visible="false" />

                                        @* X 축 눈금과 세로 격자는 두지 않는다 — 21칸이 전부 줄이 되면 바탕이 시끄럽다. *@
                                        <DxChartArgumentAxis>
                                            <DxChartAxisGridLines Visible="false" />
                                            <DxChartAxisTick Visible="false" />
                                            <DxChartAxisLabel DisplayMode="ChartAxisLabelDisplayMode.Standard"
                                                              Overlap="ChartAxisLabelOverlap.Hide"
                                                              RotationAngle="0" />
                                        </DxChartArgumentAxis>

                                        @* 세로 십자선은 손가락 화면에서 달지 않는다(<see cref="_touchOnly"/>). *@
                                        @if (!_touchOnly)
                                        {
                                            <DxChartCrosshair Enabled="true" Width="1" Opacity="0.7"
                                                              DashStyle="ChartDashStyle.Dot" Color="#8a93a5">
                                                <DxChartCrosshairHorizontalLine Visible="false" />
                                            </DxChartCrosshair>
                                        }

                                        @switch (metric)
                                        {
                                            case TrendMetric.Rain:
                                                @* 강수량만 막대로 — 강수확률(%)은 단위가 달라 같은 축에 올리지 않는다. *@
                                                <DxChartBarSeries T="TrendPoint" TArgument="string" TValue="double?"
                                                                  ArgumentField="p => p.Label"
                                                                  ValueField="p => p.Rain"
                                                                  Color="@RainColor"
                                                                  CornerRadius="4"
                                                                  BarPadding="0.3"
                                                                  Name="강수량(mm)" />
                                                break;
                                            case TrendMetric.Wind:
                                                <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double"
                                                                     ArgumentField="p => p.Label"
                                                                     ValueField="p => p.WindSpeed"
                                                                     Color="@WindColor"
                                                                     Width="2"
                                                                     Name="풍속(m/s)">
                                                    <DxChartSeriesPoint Visible="false" />
                                                </DxChartSplineSeries>
                                                break;
                                            case TrendMetric.Humid:
                                                <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double?"
                                                                     ArgumentField="p => p.Label"
                                                                     ValueField="p => p.Humidity"
                                                                     Color="@HumidColor"
                                                                     Width="2"
                                                                     Name="습도(%)">
                                                    <DxChartSeriesPoint Visible="false" />
                                                </DxChartSplineSeries>
                                                @* 습도는 축을 0~100 으로 묶는다. *@
                                                <DxChartValueAxis>
                                                    <DxChartAxisRange StartValue="@(0)" EndValue="@(100)" />
                                                </DxChartValueAxis>
                                                break;
                                            default:
                                                <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="double"
                                                                     ArgumentField="p => p.Label"
                                                                     ValueField="p => p.Temp"
                                                                     Color="@TempColor"
                                                                     Width="2"
                                                                     Name="기온(°C)">
                                                    <DxChartSeriesPoint Visible="false" />
                                                </DxChartSplineSeries>
                                                break;
                                        }

                                        @* 말풍선은 손가락 화면에서 달지 않는다 — 짚는 손짓이 카드를 미는 손짓과 다툰다(<see cref="_touchOnly"/>). *@
                                        @if (!_touchOnly)
                                        {
                                            <DxChartTooltip Enabled="true">
                                                <div class="le-trend__tip">
                                                    <span class="le-trend__tip-value">@TipValue(context.Point.Value)</span>
                                                    <span class="le-trend__tip-meta">@context.Point.SeriesName · @context.Point.Argument</span>
                                                </div>
                                            </DxChartTooltip>
                                        }
                                    </DxChart>
                                </section>
                            }
                        </div>
                    </ChildContent>
                    <ErrorContent>
                        <div class="le-today__empty">
                            추이 차트를 그리지 못했습니다.
                            <DxButton Text="다시 그리기" RenderStyle="ButtonRenderStyle.Link"
                                      Click="@(() => _chartGuard?.Recover())" />
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        }
    }
}
