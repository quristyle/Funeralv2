@page "/life/weather/events"
@attribute [RouteKey("life.weather.events")]

@*
    기준 초과 이벤트 기록(DB 메뉴 /life/weather/events). 「알림이 안 왔다」는 신고는 이 기록부터 본다 — 기록이 없으면 판정이 안 걸린 것이고, 있는데 미발송이면 알림 쪽 문제다.
    지우기는 기록만 지운다. 이미 나간 알림은 취소되지 않는다.
*@

@inherits DataPage

<PageTitle>기준 초과 이벤트 · 생활과환경</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="지역">
            <DxComboBox Data="@_locations" @bind-Value="_locationId"
                        TextFieldName="@nameof(WeatherLocation.Name)"
                        ValueFieldName="@nameof(WeatherLocation.Id)" Style="width: 170px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="기간">
            <DxDateEdit @bind-Date="_from" Style="width: 140px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            <DxDateEdit @bind-Date="_to" Style="width: 140px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem>
            <DxCheckBox @bind-Checked="_onlyUnsent">미발송만</DxCheckBox>
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="WeatherEventRecord" Data="@Shown" PageSize="25"
             ExportName="기상특보"
             Reload="@ReloadAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@DeleteMessage">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WeatherEventRecord.EventTime)" Caption="발생 시각" Width="160"
                              DisplayFormat="yyyy-MM-dd HH:mm" />

            <DxGridDataColumn Caption="지역" Width="140">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    @* 지역 이름이 비어 오면 지역 식별자로 표에서 찾는다. *@
                    @(e.WeatherInfo?.Location is { Length: > 0 } name
                        ? name
                        : LocationName(e.WeatherInfo?.WeatherLocationId))
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="걸린 기준" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                        var std = e.WeatherStandard;
                    }
                    @if (std is null)
                    {
                        <span class="jsini-text-muted">기준 정보 없음</span>
                    }
                    else
                    {
                        <span>@std.Name</span>
                        <span class="lf-condition">@std.ConditionText</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="측정값" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    @* 숫자만 있으면 기온인지 풍속인지 알 수 없다. 단위를 붙인다. *@
                    <strong>@e.MeasuredValue</strong>
                    <small>@e.WeatherStandard?.Unit</small>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="알림" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    <span class="jsini-badge @(e.IsNotified ? "jsini-badge--on" : "jsini-badge--off")">
                        @(e.IsNotified ? "발송" : "미발송")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

        </Columns>
    </CommGrd>
</CommCont>
