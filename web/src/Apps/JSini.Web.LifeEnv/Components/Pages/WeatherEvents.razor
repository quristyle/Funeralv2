@page "/life/weather/events"

@*
    [기준 초과 이벤트] — DB 메뉴 `/life/weather/events`.
    이력: Vue `views/life/weather/events.vue` → 여기.

    판정 기준을 넘긴 실황이 여기 쌓인다. 「알림이 안 왔다」는 신고를 받으면
    **이 기록부터 본다** — 기록이 없으면 판정이 안 걸린 것이고, 기록은 있는데
    「미발송」이면 알림 쪽 문제다. 그 둘을 가르는 것이 이 화면의 일이다.

    [조건이 하나도 없었다]

    최근 100건을 그냥 보여 주고 끝이었다. 지역·기간으로 좁힐 수 없어서
    「지난주 그 지역에서 무슨 일이 있었나」를 볼 수 없었다. 서버는 셋 다
    받는다(`locationId` · `startDate` · `endDate`).

    [무엇이 걸렸는지가 안 보였다]

    측정값만 있고 **어느 지역의 어느 기준**인지가 없었다. 숫자 하나만 보면
    「32.4」가 기온인지 풍속인지 알 수 없다. 서버가 함께 실어 주는 기준과
    지역을 보여 준다.

    [지우기는 기록을 지우는 것이다]

    잘못 걸린 이벤트를 정리하는 용도다. 알림을 취소하지 않는다 — 이미 나간
    알림은 되돌릴 수 없다.
*@

@inherits DataPage
@inject LifeEnvClient Client

<PageTitle>기준 초과 이벤트 · 생활과환경</PageTitle>

<div class="jsini-toolbar">
    <DxComboBox Data="@_locations" @bind-Value="_locationId"
                TextFieldName="@nameof(WeatherLocation.Name)"
                ValueFieldName="@nameof(WeatherLocation.Id)"
                NullText="지역 전체" Style="width: 170px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxDateEdit @bind-Date="_from" NullText="시작일" Style="width: 140px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxDateEdit @bind-Date="_to" NullText="종료일" Style="width: 140px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxCheckBox @bind-Checked="_onlyUnsent">미발송만</DxCheckBox>

    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<CommCont>
    <CommGrd TItem="WeatherEventRecord" Data="@Shown" PageSize="25">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WeatherEventRecord.EventTime)" Caption="발생 시각" Width="160"
                              DisplayFormat="yyyy-MM-dd HH:mm" />

            <DxGridDataColumn Caption="지역" Width="140">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    @* 실황에 지역 이름(`Location`)이 함께 온다. 비어 있으면
                       지역 식별자로 표에서 찾는다. *@
                    @(e.WeatherInfo?.Location is { Length: > 0 } name
                        ? name
                        : LocationName(e.WeatherInfo?.WeatherLocationId))
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="걸린 기준" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                        var std = e.WeatherStandard;
                    }
                    @if (std is null)
                    {
                        <span class="jsini-text-muted">기준 정보 없음</span>
                    }
                    else
                    {
                        <span>@std.Name</span>
                        <span class="lf-condition">@std.ConditionText</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="측정값" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    @* 숫자만 있으면 기온인지 풍속인지 알 수 없다. 단위를 붙인다. *@
                    <strong>@e.MeasuredValue</strong>
                    <small>@e.WeatherStandard?.Unit</small>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="알림" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    <span class="jsini-badge @(e.IsNotified ? "jsini-badge--on" : "jsini-badge--off")">
                        @(e.IsNotified ? "발송" : "미발송")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="" Width="80" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var e = (WeatherEventRecord)cell.DataItem;
                    }
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton Text="삭제"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => DeleteAsync(e))" />
                    </PermissionView>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
</CommCont>

@if (_total > _events.Count)
{
    <PageNotice Tone="NoticeTone.Info"
                Text="@($"전체 {_total}건 중 {_events.Count}건입니다. 기간이나 지역으로 좁히십시오.")" />
}

@code {
    private IReadOnlyList<WeatherEventRecord> _events = [];
    private IReadOnlyList<WeatherLocation> _locations = [];
    private int _total;

    private int? _locationId;
    private DateTime? _from;
    private DateTime? _to;
    private bool _onlyUnsent;

    /// <summary>
    /// 「미발송만」은 브라우저에서 거른다. 서버에 그 조건이 없다.
    ///
    /// 받아 온 것 안에서만 거르므로, 전체가 많으면 기간을 좁혀야 제대로 보인다.
    /// 그 사실을 아래 안내가 말해 준다.
    /// </summary>
    private IReadOnlyList<WeatherEventRecord> Shown =>
        _onlyUnsent ? [.. _events.Where(e => !e.IsNotified)] : _events;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        // 지역 목록은 고르개와 이름 표시에 함께 쓴다.
        if (_locations.Count == 0)
        {
            _locations = await Client.GetLocationsAsync();
        }

        var page = await Client.GetEventsAsync(
            1, 200,
            _from?.ToString("yyyy-MM-dd"),
            _to?.ToString("yyyy-MM-dd"),
            _locationId);

        _events = page?.Items ?? [];
        _total = page?.TotalCount ?? _events.Count;

        return _events.Count;
    }, "조건에 맞는 이벤트가 없습니다.", "이벤트 기록을 읽지 못했습니다");

    private string LocationName(int? id) =>
        id is null ? "-" : _locations.FirstOrDefault(l => l.Id == id)?.Name ?? "-";

    private async Task DeleteAsync(WeatherEventRecord e)
    {
        if (await RunAsync(() => Client.DeleteEventAsync(e.Id),
                           "지웠습니다. 이미 나간 알림은 되돌아가지 않습니다.", "지우지 못했습니다"))
        {
            await ReloadAsync();
        }
    }
}
