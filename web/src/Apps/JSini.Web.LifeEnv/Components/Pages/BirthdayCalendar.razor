@page "/life/birthday/calendar"
@attribute [RouteKey("life.birthday.calendar")]

@*
    월별 생일자 캘린더(API: auth/birthday/calendar · stats). 응답은 FullCalendar 모양이라 이 화면에서 스케줄러 모양으로 옮겨 담는다 — 백엔드는 건드리지 않는다.
*@

@inherits DataPage

<PageTitle>월별 생일자 캘린더 · 생활과환경</PageTitle>

<div class="jsini-toolbar">
    <DxButton Text="◀ 이전 달" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveAsync(-1))" />
    <span class="le-month">@_anchor.ToString("yyyy년 M월")</span>
    <DxButton Text="다음 달 ▶" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveAsync(1))" />
    <DxButton Text="이번 달" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveToTodayAsync())" />
</div>

@if (_stats.Count > 0)
{
    <div class="jsini-stats">
        @foreach (var s in _stats.Where(s => s.Month == _anchor.Month))
        {
            <div class="jsini-stat">
                <div class="jsini-stat__label">이 달 생일자</div>
                <div class="jsini-stat__value">@s.Total</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">양력</div>
                <div class="jsini-stat__value">@s.Solar</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">음력</div>
                <div class="jsini-stat__value">@s.Lunar</div>
            </div>
        }
    </div>
}

<div class="le-calendar">
    @foreach (var day in Days)
    {
        <div class="le-day @(day.Month == _anchor.Month ? "" : "le-day--other")">
            <div class="le-day__no">@day.Day</div>

            @foreach (var e in _events.Where(e => e.StartDate.Date == day.Date))
            {
                <div class="le-day__event" title="@e.Title">
                    @e.Title
                    @if (e.ExtendedProps.IsLunar)
                    {
                        <span class="le-day__lunar">음</span>
                    }
                </div>
            }
        </div>
    }
</div>
