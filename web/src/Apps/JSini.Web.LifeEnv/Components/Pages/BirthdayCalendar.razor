@page "/life/birthday/calendar"

@*
    [월별 생일자 캘린더]

    이력: Vue `views/life/birthday/calendar.vue` → 여기.
    API: `auth/birthday/calendar` · `auth/birthday/stats`

    한동안 이 화면은 하드코딩한 자료를 보여 주고 있었다. 실제 API 에 붙였다.

    [FullCalendar 응답을 스케줄러로 옮겨 담는다]

    서버 응답이 FullCalendar 모양인 것은 Vue 화면이 그 라이브러리를 썼기
    때문이다. **백엔드를 건드리지 않는다** — 이행하는 동안 백엔드는 그대로 두는
    것이 이 저장소의 규칙이고, 옮겨 담는 코드는 이 화면 한 곳이면 된다.
*@

@inherits DataPage
@inject BirthdayClient Api

<PageTitle>월별 생일자 캘린더 · 생활과환경</PageTitle>

<div class="jsini-toolbar">
    <DxButton Text="◀ 이전 달" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveAsync(-1))" />
    <span class="le-month">@_anchor.ToString("yyyy년 M월")</span>
    <DxButton Text="다음 달 ▶" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveAsync(1))" />
    <DxButton Text="이번 달" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => MoveToTodayAsync())" />
</div>

@if (_stats.Count > 0)
{
    <div class="jsini-stats">
        @foreach (var s in _stats.Where(s => s.Month == _anchor.Month))
        {
            <div class="jsini-stat">
                <div class="jsini-stat__label">이 달 생일자</div>
                <div class="jsini-stat__value">@s.Total</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">양력</div>
                <div class="jsini-stat__value">@s.Solar</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">음력</div>
                <div class="jsini-stat__value">@s.Lunar</div>
            </div>
        }
    </div>
}

<div class="le-calendar">
    @foreach (var day in Days)
    {
        <div class="le-day @(day.Month == _anchor.Month ? "" : "le-day--other")">
            <div class="le-day__no">@day.Day</div>

            @foreach (var e in _events.Where(e => e.StartDate.Date == day.Date))
            {
                <div class="le-day__event" title="@e.Title">
                    @e.Title
                    @if (e.ExtendedProps.IsLunar)
                    {
                        <span class="le-day__lunar">음</span>
                    }
                </div>
            }
        </div>
    }
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

@code {
    private DateTime _anchor = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private IReadOnlyList<BirthdayCalendarEvent> _events = [];
    private IReadOnlyList<BirthdayMonthStat> _stats = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>
    /// 이 달을 덮는 칸들. 월요일 시작으로 앞뒤 달 며칠이 섞여 나온다 —
    /// 격자를 7의 배수로 채워야 줄이 어긋나지 않는다.
    /// </summary>
    private IEnumerable<DateTime> Days
    {
        get
        {
            var first = _anchor;

            // 월요일이 0 이 되게 옮긴다. C# 의 DayOfWeek 는 일요일이 0 이다.
            var offset = ((int)first.DayOfWeek + 6) % 7;
            var start = first.AddDays(-offset);

            var last = first.AddMonths(1).AddDays(-1);
            var total = (last - start).Days + 1;
            var cells = (int)Math.Ceiling(total / 7d) * 7;

            for (var i = 0; i < cells; i++)
            {
                yield return start.AddDays(i);
            }
        }
    }

    private Task MoveAsync(int months)
    {
        _anchor = _anchor.AddMonths(months);
        return ReloadAsync();
    }

    private Task MoveToTodayAsync()
    {
        _anchor = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        return ReloadAsync();
    }

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        // 격자에 보이는 범위를 그대로 넘긴다. 달 경계만 넘기면 앞뒤 달 칸이 빈다.
        var days = Days.ToList();

        var events = Api.GetCalendarAsync(days[0], days[^1]);
        var stats = Api.GetStatsAsync();

        await Task.WhenAll(events, stats);

        _events = events.Result;
        _stats = stats.Result;
        return _events.Count;
    }, "이 달에 생일자가 없습니다.", "캘린더를 읽지 못했습니다");
}
