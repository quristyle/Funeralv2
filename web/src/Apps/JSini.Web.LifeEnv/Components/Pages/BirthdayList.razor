@page "/life/birthday/list"
@attribute [RouteKey("life.birthday.list")]

@*
    생일 축하 목록(DB 메뉴 /life/birthday/list). 통계 · 오늘 생일자 · 오늘의 축하 · 고른 달의 생일자를 담는다.
    얼굴은 목록을 받은 뒤 아이디를 모아 한 번에 묻는다. 「보내기」는 화면 안의 축하 글, 「알림」은 기기·메일로 나가는 공용 부품이라 한 단추로 묶지 않는다.
*@


@inherits DataPage

<PageTitle>생일 축하 목록 · 생활과환경</PageTitle>

@* 자료 판(CommCont)은 감싸지 않는다 — 카드와 달 띠가 위에 쌓여, 감싸면 남은 높이를 판이 다 먹어 아래가 잘린다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="회사">
            <DxComboBox Data="@_companies" TextFieldName="@nameof(OrgCompany.Name)" ValueFieldName="@nameof(OrgCompany.Id)"
                        Value="@_companyId" ValueChanged="@((string? v) => OnCompanyChangedAsync(v))"
                        Style="width: 170px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="부서">
            <DxComboBox Data="@Departments" TextFieldName="@nameof(OrgDepartment.Name)" ValueFieldName="@nameof(OrgDepartment.Id)"
                        @bind-Value="_departmentId" Style="width: 170px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="달">
            <DxComboBox Data="@Months" @bind-Value="_month" Style="width: 130px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto">
                <ItemTemplate>@context 월</ItemTemplate>
            </DxComboBox>
        </CommSchItem>
    </Fields>
</CommSch>

@* 열두 달을 한 줄로. 눌러서 그 달을 연다 — 숫자만 보여 주면 결국 위 드롭다운을
   다시 만지게 되고, 그러면 통계가 목록과 따로 노는 장식이 된다. *@
<div class="le-months">
    @foreach (var stat in _stats)
    {
        <button type="button"
                class="@($"le-month__tile{(stat.Month == CurrentMonth ? " is-on" : string.Empty)}")"
                @onclick="@(() => PickMonthAsync(stat.Month))">
            <span class="le-month__no">@stat.Month 월</span>
            <span class="le-month__total">@stat.Total</span>
            <span class="le-month__split">양 @stat.Solar · 음 @stat.Lunar</span>
        </button>
    }
</div>

<div class="le-today">
    <section class="le-today__box">
        @* 오늘만 보내기 단추가 있다 — 다른 달에 붙이면 아직 오지 않은 생일에 알림을 뿌리게 된다. *@
        <div class="le-today__bar">
            <h2 class="le-today__head">오늘 생일</h2>

            @if (_today.Count > 0)
            {
                <DxButton Text="모두에게 알림" RenderStyle="ButtonRenderStyle.Link"
                          IconCssClass="jsini-icon-bell"
                          Click="@(() => OpenNotify(_today))" />
            }
        </div>

        @if (_today.Count == 0)
        {
            <p class="le-today__empty">오늘 생일인 사람이 없습니다.</p>
        }
        else
        {
            @foreach (var person in _today)
            {
                <div class="le-today__row">
                    <UserAvatar LoginId="@person.SubjectId" Name="@person.Name" />
                    <span class="le-today__name">@person.Name</span>
                    <span class="le-dept">@person.DepartmentName</span>
                    <span class="jsini-badge">축하 @person.MessageCount</span>

                    <DxButton Title="알림 보내기" IconCssClass="jsini-icon-bell"
                              RenderStyle="ButtonRenderStyle.Link"
                              CssClass="le-today__bell"
                              Click="@(() => OpenNotify([person]))" />
                </div>
            }
        }
    </section>

    <section class="le-today__box">
        <h2 class="le-today__head">오늘의 축하</h2>

        @if (_messages.Count == 0)
        {
            <p class="le-today__empty">아직 올라온 축하가 없습니다.</p>
        }
        else
        {
            @foreach (var message in _messages)
            {
                <div class="le-today__msg">
                    <span class="le-today__from">@message.SenderName → @message.RecipientName</span>
                    <span class="le-today__text">@message.Content</span>
                </div>
            }
        }
    </section>
</div>

<h2 class="le-today__head">@CurrentMonth 월 생일자</h2>

<CommGrd TItem="BirthdayPerson" Data="@_people" PageSize="20"
         ExportName="생일자"
         Reload="@ReloadAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(BirthdayPerson.OccurrenceDate)" Caption="생일" Width="120" DisplayFormat="yyyy-MM-dd" />
        @* 얼굴은 이름 칸 안에 넣는다 — 따로 두면 좁은 화면에서 제일 먼저 밀려 나간다. *@
        <DxGridDataColumn FieldName="@nameof(BirthdayPerson.Name)" Caption="이름" MinWidth="140">
            <CellDisplayTemplate Context="cell">
                @{
                    var who = (BirthdayPerson)cell.DataItem;
                }
                <span class="le-who">
                    <UserAvatar LoginId="@who.SubjectId" Name="@who.Name" />
                    <span>@who.Name</span>
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(BirthdayPerson.CompanyName)" Caption="회사" Width="160" />
        <DxGridDataColumn FieldName="@nameof(BirthdayPerson.DepartmentName)" Caption="부서" Width="160" />
        <DxGridDataColumn Caption="구분" Width="90">
            <CellDisplayTemplate Context="cell">
                @(((BirthdayPerson)cell.DataItem).IsLunar ? "음력" : "양력")
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="축하" MinWidth="280">
            <CellDisplayTemplate Context="cell">
                @{
                    var person = (BirthdayPerson)cell.DataItem;
                }
                @if (person.IsCelebrated)
                {
                    <div class="le-send">
                        <DxTextBox Text="@GetDraft(person.SubjectId)"
                                   TextChanged="@((string v) => SetDraft(person.SubjectId, v))"
                                   Style="width: 200px" />
                        <DxButton Text="보내기" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => SendAsync(person))" />
                    </div>
                }
                else
                {
                    <span class="jsini-badge jsini-badge--off">대상 아님</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>

    @* 관리 칸은 「관리」 한 곳에 둔다 — 화면마다 조작 자리가 다르면 오른쪽 끝을 보는 버릇이 깨진다. *@
    <RowActions Context="person">
        <DxButton Title="알림 보내기" IconCssClass="jsini-icon-bell"
                  RenderStyle="ButtonRenderStyle.Link"
                  Click="@(() => OpenNotify([person]))" />
    </RowActions>
</CommGrd>

@* 알림 창은 공용 부품(NotifySendPopup)이다. 보내기·결과 읽어 주기를 여기서 다시 짜지 않는다. *@
<NotifySendPopup @bind-Visible="_notifying"
                 Recipients="@_notifyTargets"
                 HeaderText="생일 알림 보내기"
                 DefaultSubject="@NotifySubject"
                 DefaultBody="@NotifyBody"
                 LinkUrl="/life/birthday/list" />
