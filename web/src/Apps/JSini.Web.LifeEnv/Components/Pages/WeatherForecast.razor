@page "/life/weather/forecast"
@attribute [RouteKey("life.weather.forecast")]
@using JSini.Web.LifeEnv.Api

@*
    시간대별 예보 조회(DB 메뉴 /life/weather/forecast). 관측 지역의 타임라인과 단기·중기 통합 예보.
    조회·빈 결과·실패는 DataPage 가 갈라 준다 — 실패를 「예보가 없다」로 읽히게 하지 않는다.
*@

@inherits DataPage

<PageTitle>시간대별 예보 · 생활과환경</PageTitle>

@* 조건은 지역 하나. 자료 판(CommCont)은 감싸지 않는다 — 그림·주간 예보·표가 쌓여 감싸면 남은 높이를 판이 다 먹는다. *@
<CommSch OnSearch="@LoadForecastAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="지역">
            <DxComboBox Data="@_locations"
                        TextFieldName="Name"
                        ValueFieldName="Id"
                        Value="@_selectedLocationId"
                        ValueChanged="@((int id) => OnLocationChanged(id))"
                        Style="width: 200px" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 기온은 선, 강수확률은 막대. 기온은 영하까지 내려가고 확률은 0~100 이라 축을 나눈다. *@
@if (_timeline.Count > 0)
{
    <div class="jsini-card">
        <DxChart Data="@_timeline" Width="100%" Height="260px">
            <DxChartTitle Text="기온 · 강수확률" />
            <DxChartLegend Position="RelativePosition.Outside" />

            <DxChartArgumentAxis>
                <DxChartAxisLabel DisplayMode="ChartAxisLabelDisplayMode.Standard"
                                  Overlap="ChartAxisLabelOverlap.Hide"
                                  RotationAngle="0" />
            </DxChartArgumentAxis>

            <DxChartBarSeries T="WeatherTimelinePoint" TArgument="string" TValue="int"
                              ArgumentField="p => p.Time"
                              ValueField="p => p.Pop ?? 0"
                              Name="강수확률(%)" Axis="pop" />

            <DxChartSplineSeries T="WeatherTimelinePoint" TArgument="string" TValue="double"
                               ArgumentField="p => p.Time"
                               ValueField="p => p.Temp"
                               Name="기온(°C)">
                <DxChartSeriesPoint Visible="false" />
            </DxChartSplineSeries>

            <DxChartValueAxis>
                <DxChartAxisTitle Text="기온(°C)" />
            </DxChartValueAxis>

            <DxChartValueAxis Name="pop" Alignment="ChartAxisAlignment.Far">
                <DxChartAxisTitle Text="강수확률(%)" />
            </DxChartValueAxis>
        </DxChart>
    </div>
}

@* 주간 예보. 시간대별 표가 오늘·내일에 그치는 데 비해 이쪽은 열흘을 본다. *@
@if (_weekly.Count > 0)
{
    <h2 class="le-subhead">주간 예보</h2>

    <div class="le-week">
        @foreach (var day in _weekly)
        {
            <div class="le-week__day">
                <div class="le-week__label">@day.DayDisplay</div>
                <div class="le-week__date">@day.Date</div>
                <div class="le-week__sky">@(string.IsNullOrWhiteSpace(day.AmSky) ? day.PmSky : $"{day.AmSky} / {day.PmSky}")</div>
                <div class="le-week__temp">
                    <span class="lf-down">@day.MinTemp°</span>
                    <span class="lf-up">@day.MaxTemp°</span>
                </div>
                <div class="le-week__pop">@day.AmPop% / @day.PmPop%</div>
            </div>
        }
    </div>
}

<h2 class="le-subhead">시간대별</h2>

<CommGrd TItem="WeatherTimelinePoint" Data="@_timeline" Loading="@Loading" PageSize="20"
         ExportName="시간대별예보"
         Reload="@LoadForecastAsync">
    <Columns>
        <DxGridDataColumn FieldName="Date" Caption="날짜" Width="110px" />
        <DxGridDataColumn FieldName="Time" Caption="시각" Width="90px" />
        <DxGridDataColumn FieldName="Temp" Caption="기온(°C)" Width="100px">
            <CellDisplayTemplate>
                <strong class="lf-up">@context.Value°C</strong>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Pop" Caption="강수확률" Width="100px">
            <CellDisplayTemplate>
                <span>@(context.Value != null ? $"{context.Value}%" : "-")</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Sky" Caption="하늘 상태" MinWidth="120" />
        <DxGridDataColumn FieldName="WindSpeed" Caption="풍속(m/s)" Width="100px" />
    </Columns>
</CommGrd>
