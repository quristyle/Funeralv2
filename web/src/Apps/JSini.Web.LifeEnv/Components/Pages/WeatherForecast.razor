@page "/life/weather/forecast"
@using JSini.Web.LifeEnv.Api

@*
    [시간대별 예보 조회]

    이력: Vue `views/life/weather/forecast.vue` → 여기.
    관측 지역별 타임라인 및 단기/중기 통합 예보를 조회한다.
*@

@inject LifeEnvClient Client

<PageTitle>시간대별 예보 · 생활과환경</PageTitle>

<PageHeading Title="시간대별 예보" Scope="생활과환경" />

<div class="card p-3 mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="fw-bold">지역 선택:</span>
        <DxComboBox Data="@_locations"
                    TextFieldName="Name"
                    ValueFieldName="Id"
                    Value="@_selectedLocationId"
                    ValueChanged="@((int id) => OnLocationChanged(id))"
                    NullText="지역을 선택하세요"
                    Style="width: 200px" />
        <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadForecastAsync" />
    </div>
</div>

<DxGrid Data="@_timeline" Loading="@_loading" PageSize="20">
    <Columns>
        <DxGridDataColumn FieldName="Date" Caption="날짜" Width="110px" />
        <DxGridDataColumn FieldName="Time" Caption="시각" Width="90px" />
        <DxGridDataColumn FieldName="Temp" Caption="기온(°C)" Width="100px">
            <CellDisplayTemplate>
                <strong class="text-danger">@context.Value°C</strong>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Pop" Caption="강수확률" Width="100px">
            <CellDisplayTemplate>
                <span>@(context.Value != null ? $"{context.Value}%" : "-")</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Sky" Caption="하늘 상태" MinWidth="120" />
        <DxGridDataColumn FieldName="WindSpeed" Caption="풍속(m/s)" Width="100px" />
    </Columns>
</DxGrid>

@code {
    private List<WeatherLocation> _locations = [];
    private List<WeatherTimelinePoint> _timeline = [];
    private int _selectedLocationId;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var locs = await Client.GetLocationsAsync();
        _locations = locs.ToList();
        if (_locations.Count > 0)
        {
            _selectedLocationId = _locations[0].Id;
            await LoadForecastAsync();
        }
    }

    private async Task OnLocationChanged(int id)
    {
        _selectedLocationId = id;
        await LoadForecastAsync();
    }

    private async Task LoadForecastAsync()
    {
        if (_selectedLocationId == 0) return;
        _loading = true;
        try
        {
            var res = await Client.GetForecastAsync(_selectedLocationId);
            _timeline = res.ToList();
        }
        finally
        {
            _loading = false;
        }
    }
}
