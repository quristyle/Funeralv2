@page "/life/weather/forecast"
@using JSini.Web.LifeEnv.Api

@*
    [시간대별 예보 조회]

    이력: Vue `views/life/weather/forecast.vue` → 여기.
    관측 지역별 타임라인 및 단기/중기 통합 예보를 조회한다.

    [실패를 말하지 않고 있었다]

    `try/finally` 로 도는 표시만 끄고 실패는 삼켰다. 게이트웨이가 내려가 있어도
    **빈 표**가 나오고, 사용자는 「예보가 없다」로 읽는다. 기상 자료는 실제로
    비는 때가 있어서 그 둘을 구분해 주지 않으면 아무도 신고하지 않는다.

    `DataPage` 를 쓰면 조회·빈 결과·실패가 한 곳에서 갈린다.

    [표만 있고 그림이 없었다]

    옛 화면은 기온·강수확률·습도·풍속을 **그래프**로 보여 주고 그 아래 주간
    예보를 깔았다. 예보는 「몇 시에 몇 도」보다 **어디서 꺾이는가**를 보는
    자료다 — 표만 있으면 스물네 줄을 눈으로 훑어 그 꺾임을 찾아야 한다.

    기온과 강수확률을 한 그림에 둔다(축이 둘이다). 옛 화면은 항목마다 그림을
    따로 그렸는데, 실제로 함께 보는 것은 그 둘이다 — 나머지 값은 표에 있다.

    [주간 예보 통로가 있는데 안 쓰고 있었다]

    `GetMidTermForecastAsync`(오늘~10일)가 클라이언트에 이미 있었다.
    옛 화면은 그것을 아래에 깔았다.
*@

@inherits DataPage
@inject LifeEnvClient Client

<PageTitle>시간대별 예보 · 생활과환경</PageTitle>

<div class="jsini-card">
    <div class="jsini-inline">
        <span class="le-pick__label">지역 선택:</span>
        <DxComboBox Data="@_locations"
                    TextFieldName="Name"
                    ValueFieldName="Id"
                    Value="@_selectedLocationId"
                    ValueChanged="@((int id) => OnLocationChanged(id))"
                    NullText="지역을 선택하세요"
                    Style="width: 200px" />
        <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadForecastAsync" />
    </div>
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

@* 기온은 선, 강수확률은 막대. 축을 나눠야 둘을 겹쳐 볼 수 있다 —
   기온은 영하까지 내려가고 확률은 0~100 이라 한 축에 두면 한쪽이 납작해진다. *@
@if (_timeline.Count > 0)
{
    <div class="jsini-card">
        <DxChart Data="@_timeline" Width="100%" Height="260px">
            <DxChartTitle Text="기온 · 강수확률" />
            <DxChartLegend Position="RelativePosition.Outside" />

            <DxChartBarSeries T="WeatherTimelinePoint" TArgument="string" TValue="int"
                              ArgumentField="p => p.Time"
                              ValueField="p => p.Pop ?? 0"
                              Name="강수확률(%)" Axis="pop" />

            <DxChartLineSeries T="WeatherTimelinePoint" TArgument="string" TValue="double"
                               ArgumentField="p => p.Time"
                               ValueField="p => p.Temp"
                               Name="기온(°C)" />

            <DxChartValueAxis>
                <DxChartAxisTitle Text="기온(°C)" />
            </DxChartValueAxis>

            <DxChartValueAxis Name="pop" Alignment="ChartAxisAlignment.Far">
                <DxChartAxisTitle Text="강수확률(%)" />
            </DxChartValueAxis>
        </DxChart>
    </div>
}

@* 주간 예보. 시간대별 표가 오늘·내일에 그치는 데 비해 이쪽은 열흘을 본다. *@
@if (_weekly.Count > 0)
{
    <h2 class="le-subhead">주간 예보</h2>

    <div class="le-week">
        @foreach (var day in _weekly)
        {
            <div class="le-week__day">
                <div class="le-week__label">@day.DayDisplay</div>
                <div class="le-week__date">@day.Date</div>
                <div class="le-week__sky">@(string.IsNullOrWhiteSpace(day.AmSky) ? day.PmSky : $"{day.AmSky} / {day.PmSky}")</div>
                <div class="le-week__temp">
                    <span class="lf-down">@day.MinTemp°</span>
                    <span class="lf-up">@day.MaxTemp°</span>
                </div>
                <div class="le-week__pop">@day.AmPop% / @day.PmPop%</div>
            </div>
        }
    </div>
}

<h2 class="le-subhead">시간대별</h2>

<CommGrd TItem="WeatherTimelinePoint" Data="@_timeline" Loading="@Loading" PageSize="20">
    <Columns>
        <DxGridDataColumn FieldName="Date" Caption="날짜" Width="110px" />
        <DxGridDataColumn FieldName="Time" Caption="시각" Width="90px" />
        <DxGridDataColumn FieldName="Temp" Caption="기온(°C)" Width="100px">
            <CellDisplayTemplate>
                <strong class="lf-up">@context.Value°C</strong>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Pop" Caption="강수확률" Width="100px">
            <CellDisplayTemplate>
                <span>@(context.Value != null ? $"{context.Value}%" : "-")</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Sky" Caption="하늘 상태" MinWidth="120" />
        <DxGridDataColumn FieldName="WindSpeed" Caption="풍속(m/s)" Width="100px" />
    </Columns>
</CommGrd>

@code {
    private List<WeatherLocation> _locations = [];
    private List<WeatherTimelinePoint> _timeline = [];

    /// <summary>주간(오늘~10일) 예보. 시간대별 표가 못 보여 주는 폭이다.</summary>
    private List<MidTermForecast> _weekly = [];

    private int _selectedLocationId;

    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        _locations = [.. await Client.GetLocationsAsync()];

        if (_locations.Count == 0)
        {
            return 0;
        }

        _selectedLocationId = _locations[0].Id;
        await LoadPointAsync();

        return _timeline.Count;
    }, "등록된 관측 지역이 없습니다. [관측 지역 관리]에서 먼저 등록하십시오.", "예보를 읽지 못했습니다");

    private Task OnLocationChanged(int id)
    {
        _selectedLocationId = id;
        return LoadForecastAsync();
    }

    private Task LoadForecastAsync() => LoadAsync(async () =>
    {
        if (_selectedLocationId == 0)
        {
            _timeline = [];
            return -1;
        }

        await LoadPointAsync();
        return _timeline.Count;
    }, "그 지역의 예보가 아직 없습니다.", "예보를 읽지 못했습니다");

    /// <summary>
    /// 한 지역의 시간대별과 주간을 함께 읽는다.
    ///
    /// <para>
    /// <b>주간이 실패해도 시간대별은 보여 준다.</b> 중기 예보는 기상청 쪽
    /// 자료가 늦게 들어오는 때가 있어, 그것 때문에 화면 전체가 비면
    /// 「예보가 없다」로 읽힌다.
    /// </para>
    /// </summary>
    private async Task LoadPointAsync()
    {
        _timeline = [.. await Client.GetForecastAsync(_selectedLocationId)];

        try
        {
            _weekly = [.. await Client.GetMidTermForecastAsync(_selectedLocationId)];
        }
        catch (ApiException)
        {
            _weekly = [];
        }
    }
}
