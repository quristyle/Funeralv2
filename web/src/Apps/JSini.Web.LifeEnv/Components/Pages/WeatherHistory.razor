@page "/life/weather/history"
@attribute [RouteKey("life.weather.history")]

@*
    기상 실측 이력(DB 메뉴 /life/weather/history). 예보가 아니라 실측만 담는다.
*@

@inherits DataPage

<PageTitle>기상 실측 이력 · 생활과환경</PageTitle>

@* 「같은 시각 비교」도 조건이다 — 어느 표를 그릴지 정하므로 조건 줄에 함께 둔다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="지역">
            <DxComboBox Data="@_locations" @bind-Value="_locationId"
                        TextFieldName="@nameof(WeatherLocation.Name)"
                        ValueFieldName="@nameof(WeatherLocation.Id)" Style="width: 180px" />
        </CommSchItem>

        <CommSchItem Label="기간">
            <DxComboBox Data="@DayOptions" @bind-Value="_days"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 120px" />
        </CommSchItem>

        <CommSchItem>
            @* 같은 시각끼리 견주는 표로 바꾼다 — 관측 시각이 뒤섞이면 어제보다 더운지 알 수 없다. *@
            <DxCheckBox @bind-Checked="_byHour">같은 시각 비교</DxCheckBox>
        </CommSchItem>

        @if (_byHour)
        {
            <CommSchItem Label="시각">
                <DxComboBox Data="@Hours" @bind-Value="_hour" Style="width: 100px">
                    <ItemTemplate>@context 시</ItemTemplate>
                </DxComboBox>
            </CommSchItem>
        }
    </Fields>
</CommSch>

@* 표는 조건에 따라 둘 중 하나로 갈린다. 자료 영역은 하나다. *@
<CommCont>
@if (_byHour)
{
    <CommGrd TItem="HourlyTemp" Data="@_hourly" PageSize="30"
             ExportName="시각별기온"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(HourlyTemp.Date)" Caption="날짜" Width="160" />

            <DxGridDataColumn Caption="@($"{_hour}시 기온")" Width="140">
                <CellDisplayTemplate Context="cell">
                    <strong>@(((HourlyTemp)cell.DataItem).Temp)°C</strong>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="전날 대비" MinWidth="200">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (HourlyTemp)cell.DataItem;
                        var diff = DiffFromPreviousDay(row);
                    }
                    @* 숫자만으로는 추세가 안 보여 전날과의 차이를 함께 적는다. *@
                    @if (diff is { } d)
                    {
                        <span class="@(d > 0 ? "lf-up" : d < 0 ? "lf-down" : "")">
                            @(d > 0 ? "▲" : d < 0 ? "▼" : "-") @Math.Abs(d).ToString("0.0")°C
                        </span>
                    }
                    else
                    {
                        <span class="jsini-text-muted">-</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
}
else
{
    <CommGrd TItem="WeatherInfo" Data="@_history" PageSize="30"
             ExportName="관측이력"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.ObservationTime)" Caption="관측 시각" Width="170"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.Location)" Caption="지역" Width="120" />

            <DxGridDataColumn Caption="기온" Width="90">
                <CellDisplayTemplate Context="cell">
                    <strong>@(((WeatherInfo)cell.DataItem).TemperatureC)°C</strong>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="체감" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var w = (WeatherInfo)cell.DataItem;
                    }
                    @* 폭염·한파 기준은 체감온도로 견주므로 함께 보여 준다. *@
                    @(w.SensibleTemp is { } t ? $"{t}°C" : "-")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WeatherInfo.Condition)" Caption="상태" MinWidth="120" />
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.Humidity)" Caption="습도(%)" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.WindSpeed)" Caption="풍속(m/s)" Width="100" />
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.Rainfall)" Caption="강수(mm)" Width="100" />
            <DxGridDataColumn FieldName="@nameof(WeatherInfo.Snowfall)" Caption="적설(cm)" Width="100" />
        </Columns>
    </CommGrd>
}
</CommCont>
