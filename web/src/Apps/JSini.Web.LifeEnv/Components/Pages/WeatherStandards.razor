@page "/life/weather/manage/standards"
@attribute [RouteKey("life.weather.manage.standards")]

@*
    [기상 판정 기준] — DB 메뉴 `/life/weather/manage/standards`.
    이력: Vue `views/life/weather/standards.vue` → 여기.

    실황이 **어떤 조건일 때** 이벤트로 기록하고 알릴지 정한다. 여기서 정한
    기준에 「대응 요령」(`/life/weather/responses`)이 매달린다.

    [「기준 추가」와 「수정」이 빈 메서드였다]

        private void OpenCreateDialog() { }
        private void OpenEditDialog(WeatherStandard item) { }

    단추에 `Click` 이 걸려 있어서 훑어봐서는 정상으로 보였다. 눌러도 아무 일이
    없다는 것은 실제로 눌러 봐야만 알 수 있다 — **배선이 없는 단추보다 나쁘다.**

    [연산자에 따라 값이 하나이기도 둘이기도 하다]

      GE·LE·GT·LT·EQ   값 하나 (「30 이상」)
      BT·NB            값 둘   (「10 ~ 20 사이」)
      DGE·DLE          값 둘   (기준값과 차이 — 한파의 「전일 대비 10도 하강」)

    그래서 두 번째 값 칸은 연산자에 따라 켜고 끈다. 늘 보여 주면 하나만 쓰는
    기준에도 값을 넣게 되고, 그 값은 조용히 무시된다.
*@

@inherits DataPage

<PageTitle>기상 판정 기준 · 생활과환경</PageTitle>

@* 접지 않는다 — 조건이 검색어 한 칸이고 조회 단추가 없어 고치는 즉시 걸러진다. *@

<CommSch Foldable="false">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="WeatherStandard"
             Data="@Shown"
             EditFormTitle="판정 기준"
             ExportName="판정기준"
             PageSize="20"
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn Caption="구분" Width="90">
                <CellDisplayTemplate Context="cell">
                    <span class="jsini-badge">@CategoryLabel(((WeatherStandard)cell.DataItem).Category)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WeatherStandard.Name)" Caption="명칭" MinWidth="130" />
            <DxGridDataColumn FieldName="@nameof(WeatherStandard.ConditionText)" Caption="조건" MinWidth="160" />

            <DxGridDataColumn Caption="판정" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (WeatherStandard)cell.DataItem;
                    }
                    <div class="lf-threshold">
                        <span class="jsini-badge">@OperatorLabel(row.Operator)</span>
                        <strong>@ThresholdText(row)</strong>
                        <small>@row.Unit</small>

                        @if (row.Duration is > 0)
                        {
                            <span class="lf-threshold__note">@row.Duration 일 이상</span>
                        }

                        @if (row.UseSensibleTemp)
                        {
                            <span class="jsini-badge jsini-badge--warn">체감온도</span>
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="작업상태" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (WeatherStandard)cell.DataItem;
                    }
                    <span class="jsini-badge @StatusClass(row.WorkStatus)">@StatusLabel(row.WorkStatus)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WeatherStandard.SortOrder)" Caption="순서" Width="70" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var std = (WeatherStandard)edit.EditModel;
            }
            <DxFormLayout CssClass="lf-editform">
                <DxFormLayoutItem Caption="구분" ColSpanMd="4">
                    <DxComboBox Data="@Categories" @bind-Value="std.Category"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="명칭" ColSpanMd="8">
                    <DxTextBox @bind-Text="std.Name" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="조건 설명" ColSpanMd="12">
                    @* 사람이 읽는 문장이다. 대응 요령 화면이 「언제 나가는가」를
                       이 문장으로 보여 준다. *@
                    <DxTextBox @bind-Text="std.ConditionText" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="연산자" ColSpanMd="4">
                    <DxComboBox Data="@Operators" @bind-Value="std.Operator"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@(NeedsTwo(std.Operator) ? "값 1" : "임계값")" ColSpanMd="4">
                    <DxSpinEdit @bind-Value="std.ThresholdValue" />
                </DxFormLayoutItem>

                @if (NeedsTwo(std.Operator))
                {
                    <DxFormLayoutItem Caption="@(IsDiff(std.Operator) ? "차이" : "값 2")" ColSpanMd="4">
                        <DxSpinEdit @bind-Value="std.ThresholdValue2" />
                    </DxFormLayoutItem>
                }
                else
                {
                    <DxFormLayoutItem Caption="단위" ColSpanMd="4">
                        <DxTextBox @bind-Text="std.Unit" />
                    </DxFormLayoutItem>
                }

                @if (NeedsTwo(std.Operator))
                {
                    <DxFormLayoutItem Caption="단위" ColSpanMd="4">
                        <DxTextBox @bind-Text="std.Unit" />
                    </DxFormLayoutItem>
                }

                <DxFormLayoutItem Caption="작업상태" ColSpanMd="4">
                    <DxComboBox Data="@Statuses" @bind-Value="std.WorkStatus"
                                TextFieldName="Text" ValueFieldName="Value"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="지속(일)" ColSpanMd="4">
                    @* 폭염·한파처럼 「며칠 이어져야」 걸리는 기준이 있다.
                       비우면 한 번만 넘어도 걸린다. *@
                    <DxSpinEdit @bind-Value="std.Duration" MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="순서" ColSpanMd="4">
                    <DxSpinEdit @bind-Value="std.SortOrder" MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="재발송 대기(분)" ColSpanMd="4">
                    @* 0 이면 실황을 읽을 때마다 알린다. 한파처럼 오래 이어지는
                       기준에서 그러면 알림이 쏟아진다. *@
                    <DxSpinEdit @bind-Value="std.NotificationInterval" MinValue="0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="체감온도" ColSpanMd="8">
                    <DxCheckBox @bind-Checked="std.UseSensibleTemp">
                        기온 대신 체감온도로 견준다
                    </DxCheckBox>
                </DxFormLayoutItem>

                @if (string.Equals(std.Category, "COLD", StringComparison.OrdinalIgnoreCase))
                {
                    @* 한파만 쓰는 복합 조건이다. 다른 구분에서 보여 주면 무슨
                       값인지 알 수 없는 칸이 둘 는다. *@
                    <DxFormLayoutItem Caption="전일 대비 하강" ColSpanMd="6">
                        <DxSpinEdit @bind-Value="std.PrevDayDiff" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="평년 대비 차이" ColSpanMd="6">
                        <DxSpinEdit @bind-Value="std.AvgYearDiff" />
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>
