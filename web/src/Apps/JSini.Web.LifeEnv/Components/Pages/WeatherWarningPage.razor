@page "/life/weather/warning"
@using JSini.Web.LifeEnv.Api
@using WeatherWarningItem = JSini.Web.LifeEnv.Api.WeatherWarning

@*
    [기상 특보 현황]

    이력: Vue `views/life/weather/warning.vue` → 여기.
    기상청발표 특보 및 통보문 종합 현황을 조회한다.

    **파일 이름이 화면 이름과 다르다.** 컴포넌트 이름을 자료 타입과 같게 두면
    화면 안에서 자료 타입이 가려진다 — Razor 가 만드는 클래스가 같은
    네임스페이스에 있어 더 가깝기 때문이다. 아키텍처 테스트가 이 충돌을 막는다.
*@

@inject LifeEnvClient Client

<PageTitle>기상 특보 현황 · 생활과환경</PageTitle>

<PageHeading Title="기상 특보 현황" Scope="생활과환경" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <DxButton Text="새로고침" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadDataAsync" />
    </div>
</div>

<DxGrid Data="@_warnings" Loading="@_loading" PageSize="15" KeyFieldName="Id">
    <Columns>
        <DxGridDataColumn FieldName="TmFc" Caption="발표 시각" Width="150px" />
        <DxGridDataColumn FieldName="Title" Caption="특보 제목" MinWidth="200" />
        <DxGridDataColumn FieldName="Command" Caption="명령" Width="100px">
            <CellDisplayTemplate>
                <span class="badge bg-warning text-dark">@context.Value</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Content" Caption="발표 내용" MinWidth="300" />
    </Columns>
</DxGrid>

@code {
    private List<WeatherWarningItem> _warnings = [];
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var res = await Client.GetWarningsAsync(all: true);
            _warnings = res.ToList();
        }
        finally
        {
            _loading = false;
        }
    }
}
