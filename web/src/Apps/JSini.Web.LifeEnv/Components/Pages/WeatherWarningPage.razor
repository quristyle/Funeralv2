@page "/life/weather/warning"
@attribute [RouteKey("life.weather.warning")]
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using JSini.Web.LifeEnv.Api
@using WeatherWarningItem = JSini.Web.LifeEnv.Api.WeatherWarning

@*
    기상 특보 현황(DB 메뉴 /life/weather/warning). 최근 7일 특보 중 48시간 안의 것을 특보번호로 묶어 보여 주고, 고른 발표분의 통보문을 오른쪽에 편다.
    통보문 본문은 기상청이 준 글이라 이스케이프한 뒤 우리 지역 구역명(relatedZones)만 강조한다.
*@

@inherits DataPage

<PageTitle>기상 특보 현황 · 생활과환경</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="명령">
            <DxComboBox Data="@_commands" Value="@_command"
                        ValueChanged="@((string? v) => _command = v)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Style="width: 160px" />
        </CommSchItem>
    </Fields>

    <Actions>
        @* 건수는 판의 오른쪽 끝에 둔다 — 조건 옆에 두면 조건으로 읽힌다. *@
        <span class="le-warn__count">최근 48시간 @Groups.Count 건</span>
    </Actions>
</CommSch>

<div class="le-warn">
    <div class="le-warn__list">
        @if (Groups.Count == 0)
        {
            <p class="le-warn__empty">현재 발효중인 특보 정보가 없습니다.</p>
        }

        @foreach (var group in Groups)
        {
            <article class="le-warn__card">
                <header class="le-warn__head">
                    <span class="le-warn__title">@group.Latest.Title</span>
                    <span class="le-warn__when">
                        @Moment(group.Latest.TmFc) <span class="le-warn__ago">(@Elapsed(group.Latest.TmFc))</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(group.WarningNum))
                    {
                        <span class="le-warn__no">@group.WarningNum</span>
                    }
                </header>

                <div class="le-warn__body">
                    <div class="le-warn__history">
                        <span class="le-warn__label">발표 이력</span>

                        @foreach (var item in group.Items)
                        {
                            <button type="button"
                                    class="@($"le-warn__stamp{(item.Id == _selectedId ? " is-on" : string.Empty)}")"
                                    @onclick="@(() => SelectAsync(item.Id))">
                                <span class="le-warn__time">@Moment(item.TmFc, "HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(item.Command))
                                {
                                    <span class="@($"jsini-badge {CommandTone(item.Command)}")">@item.Command</span>
                                }
                            </button>
                        }
                    </div>

                    @{
                        var hits = MatchedSentences(group.Latest);
                    }

                    @if (hits.Count > 0)
                    {
                        <div class="le-warn__area">
                            <span class="le-warn__label">우리 관리지역</span>

                            @foreach (var hit in hits)
                            {
                                <div class="le-warn__areaRow">
                                    <span class="le-warn__areaName">@hit.Location.Name</span>
                                    <span class="le-warn__zone">@ZoneName(hit.Location.WarningAreaCode)</span>

                                    @foreach (var sentence in hit.Sentences)
                                    {
                                        <span class="le-warn__hit">@TrimBullet(sentence.Title)</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(group.Latest.Content))
                    {
                        <p class="le-warn__content">@group.Latest.Content</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(group.Latest.Other))
                    {
                        <p class="le-warn__other">※ @group.Latest.Other</p>
                    }
                </div>
            </article>
        }
    </div>

    <aside class="le-warn__detail">
        @if (_detail?.Msg is null)
        {
            <p class="le-warn__empty">
                @(_detailLoading ? "통보문을 읽는 중입니다 …" : "왼쪽 발표 이력에서 하나를 고르면 통보문이 나옵니다.")
            </p>
        }
        else
        {
            var msg = _detail.Msg;

            <h2 class="le-warn__msgTitle">@msg.T1</h2>
            <p class="le-warn__when">@Moment(msg.TmFc) 발표</p>

            @if (_detail.MatchedLocations.Count > 0)
            {
                <p class="le-warn__matched">
                    걸린 관리지역:
                    @string.Join(" · ", _detail.MatchedLocations.Select(l => l.Name))
                </p>
            }

            <WarningSection Title="발표 내용" Body="@msg.T2" Keywords="@_keywords" />
            <WarningSection Title="발효 시각" Body="@msg.T3" Keywords="@_keywords" />
            <WarningSection Title="예고 · 참고" Body="@msg.T4" Keywords="@_keywords" />

            @* 아래 둘은 그 시각의 전국 현황이다. 접지 않는다 — 우리 지역 소속을 확인하는 곳이라 접으면 아무도 펴지 않는다. *@
            <WarningSection Title="특보 발효 현황" Body="@msg.T6" Keywords="@_keywords" />
            <WarningSection Title="예비특보 발효 현황" Body="@msg.T7" Keywords="@_keywords" />
            <WarningSection Title="그 밖" Body="@msg.Other" Keywords="@_keywords" />
        }
    </aside>
</div>
