@using System.Text
@using System.Text.RegularExpressions

@*
    통보문 한 토막. 본문은 기상청이 준 글이라 먼저 통째로 이스케이프하고, 그 뒤에 우리 구역명(relatedZones)만 강조 태그로 끼운다.
    구역명은 길이 내림차순으로 칠한다 — 짧은 이름이 먼저 먹으면 「울산앞바다」가 두 조각으로 갈린다.
*@

@if (!string.IsNullOrWhiteSpace(Body))
{
    <section class="le-warn__section">
        <h3 class="le-warn__sectionTitle">@Title</h3>
        <p class="le-warn__text">@Highlighted</p>
    </section>
}
