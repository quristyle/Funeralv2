@*
    [사람 하나를 가리키는 동그라미 — 사진, 없으면 이름 첫 글자]

    ────────────────────────────────────────────────────────────
    [이 부품은 스스로 묻지 않는다]

    얼굴을 받아 오는 일은 **부르는 쪽**이 한다(`UserFaceClient.EnsureAsync`).
    표가 스무 줄이면 이 부품도 스물이라, 저마다 묻게 두면 화면 하나가
    게이트웨이를 스무 번 두드린다 — 아이디를 모아 한 번에 묻는 그 부품의
    뜻이 없어진다.

    여기는 **아는 것을 그릴 뿐**이고, 아직 못 읽었으면 이름 첫 글자가 그
    자리를 지킨다. 나중에 얼굴이 들어오면 다음 그림에서 바뀐다.

    ────────────────────────────────────────────────────────────
    [이름을 함께 받는다]

    프로젝트관리의 같은 부품(`JSini.Web.ProjMng/Components/Shared/UserFaceMark`)
    은 아이디만 받고 이름도 얼굴 조회에서 얻는다. 여기서는 **생일 목록이
    이름을 이미 들고 있어서** 그대로 받는다 — 얼굴이 아직 안 왔을 때
    아이디 첫 글자(`h`)가 아니라 이름 첫 글자(`홍`)가 서는 것이 낫다.
*@

@inject UserFaceClient Faces

<span class="le-face @CssClass" title="@(Name ?? LoginId)">
    @if (Photo is { Length: > 0 } photo)
    {
        @* 못 받아 오면 깨진 그림 대신 첫 글자로 돌아간다. *@
        <img class="le-face__img" src="@photo" alt=""
             @onerror="@(() => Faces.MarkPhotoUnavailable(LoginId))" />
    }
    else
    {
        <span class="le-face__initial">@Initial</span>
    }
</span>

@code {
    /// <summary>그릴 사람의 포털 로그인 아이디.</summary>
    [Parameter] public string? LoginId { get; set; }

    /// <summary>사람이 읽는 이름. 얼굴이 아직 안 왔을 때 첫 글자를 여기서 딴다.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>덧붙일 모양 이름. 크기를 바꾸는 자리가 쓴다(<c>le-face--lg</c>).</summary>
    [Parameter] public string? CssClass { get; set; }

    private string? Photo => Faces.PhotoOf(LoginId);

    /// <summary>
    /// 사진이 없을 때 동그라미에 넣을 <b>글자 한 자</b>.
    /// </summary>
    /// <remarks>
    /// 그 자리를 비우면 얼굴이 있는 줄과 없는 줄의 <b>왼쪽 여백이 달라져</b>
    /// 목록이 들쭉날쭉해진다.
    /// </remarks>
    private string Initial
    {
        get
        {
            var text = string.IsNullOrWhiteSpace(Name) ? LoginId : Name;
            return string.IsNullOrWhiteSpace(text) ? "?" : text.Trim()[..1].ToUpperInvariant();
        }
    }
}
