@page "/cargoadmin"
@attribute [RouteKey("cargoadmin")]

@*
    [운송관리 대시보드] — 설계안 CTA-001. 처리 대기 타일(의심 거래 · 미처리 신고 · 미처리 이의제기)은 누르면 거른 목록으로 건너간다.
    「의심」은 서버가 비정상 패턴으로 건 검토 표시일 뿐 판정이 아니다. 타일과 표가 쌓인 화면이라 자료 판으로 감싸지 않는다.
*@

@inherits DataPage

<PageTitle>대시보드 · 운송관리 관리자</PageTitle>

@if (_board is not null)
{
    <div class="jsini-stats">
        <a class="jsini-stat ca-stat-link" href="/cargoadmin/companies">
            <div class="jsini-stat__label">거래처</div>
            <div class="jsini-stat__value">@_board.CompanyCount.ToString("#,0")</div>
        </a>
        <a class="jsini-stat ca-stat-link" href="/cargoadmin/users">
            <div class="jsini-stat__label">사용자</div>
            <div class="jsini-stat__value">@_board.UserCount.ToString("#,0")</div>
        </a>
        <a class="jsini-stat ca-stat-link" href="/cargoadmin/transactions">
            <div class="jsini-stat__label">거래 전체</div>
            <div class="jsini-stat__value">@_board.TransactionCount.ToString("#,0")</div>
        </a>
        <div class="jsini-stat">
            <div class="jsini-stat__label">최근 30일 거래</div>
            <div class="jsini-stat__value">@_board.TransactionsLast30.ToString("#,0")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">운송료 합계</div>
            <div class="jsini-stat__value">@CargoAdminFormat.Won(_board.TotalAmount)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">받지 못한 금액</div>
            <div class="jsini-stat__value">@CargoAdminFormat.Won(_board.OutstandingAmount)</div>
        </div>
    </div>

    <h2 class="ca-subhead">처리 대기</h2>

    <div class="jsini-stats">
        <a class="@DueClass(_board.FlaggedCount)" href="/cargoadmin/transactions?reviewStatus=FLAGGED">
            <div class="jsini-stat__label">의심 표시 거래</div>
            <div class="jsini-stat__value">@_board.FlaggedCount.ToString("#,0")</div>
        </a>
        <a class="@DueClass(_board.OpenReports)" href="/cargoadmin/reports?status=RECEIVED">
            <div class="jsini-stat__label">미처리 신고</div>
            <div class="jsini-stat__value">@_board.OpenReports.ToString("#,0")</div>
        </a>
        <a class="@DueClass(_board.OpenDisputes)" href="/cargoadmin/disputes?status=RECEIVED">
            <div class="jsini-stat__label">미처리 이의제기</div>
            <div class="jsini-stat__value">@_board.OpenDisputes.ToString("#,0")</div>
        </a>
    </div>

    <h2 class="ca-subhead">결제 상태별 거래</h2>

    <div class="jsini-card">
        @if (_board.StatusCounts.Count == 0)
        {
            <span class="jsini-hint">등록된 거래가 없습니다.</span>
        }
        else
        {
            <div class="ca-counts">
                @foreach (var row in OrderedCounts)
                {
                    <a class="ca-counts__item ca-stat-link" href="@($"/cargoadmin/transactions?paymentStatus={row.Status}")">
                        <span class="@CargoAdminCodes.PaymentStatus.BadgeOf(row.Status)">@CargoAdminCodes.PaymentStatus.NameOf(row.Status)</span>
                        <span>@row.Count.ToString("#,0") 건</span>
                    </a>
                }
            </div>
        }
    </div>
}

<h2 class="ca-subhead">최근 감사 기록</h2>

<div class="ca-section">
    <CommGrd TItem="AdminAuditEntry" Data="@Recent"
             ExportName="최근감사기록"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn Caption="시각" Width="150">
                <CellDisplayTemplate Context="cell">
                    @CargoAdminFormat.Moment(((AdminAuditEntry)cell.DataItem).CreatedAt)
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(AdminAuditEntry.ActorName)" Caption="처리자" Width="120" />
            <DxGridDataColumn FieldName="@nameof(AdminAuditEntry.Action)" Caption="동작" MinWidth="160" />
            <DxGridDataColumn Caption="대상" Width="140">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AdminAuditEntry)cell.DataItem;
                    }
                    @CargoAdminCodes.AuditTarget.NameOf(a.TargetType) @(a.TargetId is { } id ? $"#{id}" : null)
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
        <ContextMenuItems>
            <CommMenuItem Text="감사 기록 전체 보기" IconCssClass="jsini-icon-expand"
                             Click="@(() => Navigation.NavigateTo("/cargoadmin/audit"))" />
        </ContextMenuItems>
    </CommGrd>
</div>
