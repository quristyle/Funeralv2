@page "/cargoadmin/companies"
@attribute [RouteKey("cargoadmin.companies")]

@*
    [거래처 관리] — 설계안 CTA-002. 사업자번호는 가리지 않는다(동명 업체 · 번호 오류를 가려야 하므로). 지우지 않고 「숨김」으로 치운다 — 지우면 그 회사 거래의 통계가 사라진다.
    조회는 서버가 거른다(q · status) — 받아 두고 거르면 상한(500) 뒤의 회사를 영영 못 찾는다.
*@

@inherits DataPage

<PageTitle>거래처 관리 · 운송관리 관리자</PageTitle>

<CommSch OnSearch="@ReloadAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@CargoAdminCodes.CompanyStatus.Filter" @bind-Value="_status"
                        TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                        Style="width: 120px" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="AdminCompany"
             Data="@_rows"
             EditFormTitle="거래처"
             ExportName="운송관리거래처"
             PageSize="20"
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(AdminCompany.BusinessNumber)" Caption="사업자번호" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AdminCompany.CompanyName)" Caption="회사명" MinWidth="180" />
            <DxGridDataColumn FieldName="@nameof(AdminCompany.CeoName)" Caption="대표자" Width="100" />
            <DxGridDataColumn FieldName="@nameof(AdminCompany.Region)" Caption="지역" Width="80" />
            <DxGridDataColumn FieldName="@nameof(AdminCompany.BusinessType)" Caption="업종" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AdminCompany.Phone)" Caption="전화" Width="130" />

            <DxGridDataColumn FieldName="@nameof(AdminCompany.Status)" Caption="상태" Width="80">
                <CellDisplayTemplate Context="cell">
                    @{
                        var c = (AdminCompany)cell.DataItem;
                    }
                    <span class="@CargoAdminCodes.CompanyStatus.BadgeOf(c.Status)">@CargoAdminCodes.CompanyStatus.NameOf(c.Status)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AdminCompany.TransactionCount)" Caption="거래 수" Width="80" />

            @* 메모는 관리자끼리만 보는 값이다. 표에 두어 「왜 숨겼나」를 열지 않고 알게 한다. *@
            <DxGridDataColumn FieldName="@nameof(AdminCompany.AdminMemo)" Caption="관리자 메모" MinWidth="160" />

            <DxGridDataColumn FieldName="@nameof(AdminCompany.UpdatedAt)" Caption="수정" Width="140"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var company = (AdminCompany)edit.EditModel;
            }

            <DxFormLayout>
                <DxFormLayoutItem Caption="사업자번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="company.BusinessNumber" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="회사명" ColSpanMd="6">
                    <DxTextBox @bind-Text="company.CompanyName" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="대표자" ColSpanMd="6">
                    <DxTextBox @bind-Text="company.CeoName" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="전화" ColSpanMd="6">
                    <DxTextBox @bind-Text="company.Phone" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="지역" ColSpanMd="4">
                    <DxTextBox @bind-Text="company.Region" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="업종" ColSpanMd="8">
                    <DxTextBox @bind-Text="company.BusinessType" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="주소" ColSpanMd="12">
                    <DxTextBox @bind-Text="company.Address" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="상태" ColSpanMd="4">
                    <DxComboBox Data="@CargoAdminCodes.CompanyStatus.Options"
                                TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                                @bind-Value="company.Status" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="관리자 메모" ColSpanMd="12">
                    <DxMemo @bind-Text="company.AdminMemo" Rows="3" />
                </DxFormLayoutItem>
            </DxFormLayout>

        </EditFormTemplate>
    </CommGrd>
</CommCont>
