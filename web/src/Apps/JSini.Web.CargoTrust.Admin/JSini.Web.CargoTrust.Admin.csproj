<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    운송관리(CargoTrust) 관리자 업무 MFE 모듈.

    사용자 모듈(JSini.Web.CargoTrust)과 **따로 둔다.** 같은 백엔드를 부르지만
    보는 사람이 다르고(차주 · 운송사 ↔ 운영자) 무엇을 보여 주는지도 다르다 —
    관리자 응답은 사업자번호를 가리지 않고 관리자 메모를 싣는다. 한 모듈에
    섞으면 그 둘의 경계가 화면 안의 `if` 로 내려와, 한 줄만 빠뜨려도 관리자
    자료가 사용자 화면에 샌다. 모듈이 갈리면 메뉴 권한이 그 경계를 쥔다.

    그래서 사용자 모듈을 참조하지도 않는다(의존 규칙 2). DTO 도 따로 들고 있다.
  -->

  <PropertyGroup>
    <RootNamespace>JSini.Web.CargoTrust.Admin</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>jsini-web-cargotrust-admin</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Piral.Blazor.Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\JSini.Web.Abstractions\JSini.Web.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Components\JSini.Web.Components.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Http\JSini.Web.Http.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Models\JSini.Web.Models.csproj" />
  </ItemGroup>

</Project>
