@page "/helpdesk/util/binary-parser"

@*
    [바이너리 파서] — DB 메뉴 `/helpdesk/util/binary-parser`.
    이력: Vue `views/helpdesk/util/binary-parser.vue` → 여기.
    엔드포인트: `POST utils/parse-binary`

    설비가 보낸 전문을 사람이 읽을 수 있게 푼다. 16진수로 적은 전문을 규칙에 따라 푼다.

    [원문을 지우지 않는다]

    푼 결과만 남기지 않고 넣은 원문을 화면에 그대로 둔다. 파싱이 틀렸을 때
    무엇을 넣었는지 알아야 고칠 수 있는데, 지워 버리면 다시 붙여 넣어야 한다.

    [보내는 칸 이름이 서버와 달랐다 — 늘 400 이었다]

    본문을 `{ raw }` 로 보내고 있었다. 서버가 받는 칸은 `content` 다
    (`record ParseRequest(string Content, …)`). 모델 바인딩은 모르는 칸을
    **조용히 버리므로** `Content` 가 비고, 서버가 곧바로
    「Content is empty」로 400 을 낸다 — 무엇을 넣어도 그랬다.

    게이트웨이로 두 모양을 나란히 던져 확인했다.

        { "raw": "02 30 31" }      →  400  Content is empty
        { "content": "02 30 31" }  →  200

    [보관한 전문이 안 보이고 있었다]

    설비 모델마다 **전문 샘플을 저장해 두고 꺼내 쓴다**(`mc-models/{id}/samples`).
    한 번 겪은 전문을 다시 손으로 붙여 넣지 않으려고 만든 것이다. 서버에도
    자료 타입에도 다 있었는데 화면에 꺼내는 자리가 없었다 —
    **매번 어딘가에서 전문을 찾아 붙여 넣어야 했다.**
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>바이너리 파서 · 헬프데스크</PageTitle>

<div class="jsini-toolbar">
    <DxComboBox Data="@_models" TextFieldName="@nameof(McModel.McName)" ValueFieldName="@nameof(McModel.Id)"
                Value="@_modelId" ValueChanged="@((int? v) => PickModelAsync(v))"
                ValueExpression="@(() => _modelId)"
                NullText="설비 모델" Style="width: 200px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxComboBox Data="@_samples" TextFieldName="@nameof(BinarySample.Title)" ValueFieldName="@nameof(BinarySample.Id)"
                @bind-Value="_sampleId" NullText="보관한 전문" Style="width: 220px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxButton Text="불러오기" RenderStyle="ButtonRenderStyle.Secondary"
              Enabled="@(_sampleId is not null)" Click="@LoadSampleAsync" />

    <PermissionView Action="MenuAction.Create">
        <DxButton Text="이 전문 보관" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(_modelId is not null)" Click="@StartSaveSample" />
    </PermissionView>
</div>

<div class="hd-form">
    <label class="hd-field">
        <span class="hd-field__label">원문</span>
        <DxMemo @bind-Text="_raw" Rows="8" NullText="16진수 전문을 붙여 넣으십시오 (예: 02 30 31 …)" />
    </label>

    <div>
        <DxButton Text="풀기" RenderStyle="ButtonRenderStyle.Primary" Click="@ParseAsync" />
    </div>
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<AutoGrid Data="@_rows" Loading="@Loading" PageSize="30" />

<DxPopup @bind-Visible="_savingSample" HeaderText="전문 보관" Width="420px" ShowFooter="false">
    <BodyContentTemplate Context="popup">
        <div class="jsini-hint">
            @(_sampleId is null
                ? "새 이름으로 보관합니다."
                : "불러온 전문을 지금 내용으로 덮어씁니다. 이름을 바꾸면 새로 보관합니다.")
        </div>

        <DxTextBox @bind-Text="_sampleTitle" NullText="전문 이름" />

        <div class="jsini-toolbar">
            <DxButton Text="보관" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveSampleAsync" />
            <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => _savingSample = false)" />
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    private string? _raw;
    private DataTable _rows = JsonTable.Empty;

    private IReadOnlyList<McModel> _models = [];
    private IReadOnlyList<BinarySample> _samples = [];

    private int? _modelId;
    private int? _sampleId;

    private bool _savingSample;
    private string? _sampleTitle;

    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        _models = await Api.GetListAsync<McModel>("utils/mc-models");
        return _models.Count;
    }, "등록된 설비 모델이 없습니다.", "설비 모델을 읽지 못했습니다");

    /// <summary>모델을 고르면 그 모델에 보관된 전문을 읽는다.</summary>
    private async Task PickModelAsync(int? modelId)
    {
        _modelId = modelId;
        _sampleId = null;
        _samples = [];

        if (modelId is null)
        {
            return;
        }

        try
        {
            _samples = await Api.GetListAsync<BinarySample>($"utils/mc-models/{modelId}/samples");
        }
        catch (ApiException ex)
        {
            // 보관함을 못 읽는다고 파서를 못 쓰게 하지 않는다.
            Say($"보관한 전문을 읽지 못했습니다 — {ex.Message}", NoticeTone.Warning);
        }
    }

    /// <summary>
    /// 보관한 전문을 원문 칸에 붙인다. <b>목록 응답에는 내용이 빠져 있어</b>
    /// 한 건을 따로 읽는다.
    /// </summary>
    private Task LoadSampleAsync() => LoadAsync(async () =>
    {
        var sample = await Api.GetAsync<BinarySample>($"utils/samples/{_sampleId}");

        _raw = sample?.Content;
        _sampleTitle = sample?.Title;
        _rows = JsonTable.Empty;

        return _raw is { Length: > 0 } ? 1 : 0;
    }, "그 전문에는 내용이 없습니다.", "전문을 불러오지 못했습니다");

    private void StartSaveSample()
    {
        if (string.IsNullOrWhiteSpace(_raw))
        {
            Say("보관할 원문이 없습니다.", NoticeTone.Warning);
            return;
        }

        _savingSample = true;
    }

    /// <summary>
    /// 보관한다.
    ///
    /// <para>
    /// 불러온 전문이 있고 이름을 그대로 두면 <b>덮어쓴다</b>. 이름을 바꾸면
    /// 새로 만든다 — 원본도 그렇게 갈랐다(덮어쓸 때는 확인을 물었다).
    /// </para>
    /// </summary>
    private async Task SaveSampleAsync()
    {
        if (string.IsNullOrWhiteSpace(_sampleTitle))
        {
            Say("전문 이름을 넣으십시오.", NoticeTone.Warning);
            return;
        }

        var loaded = _samples.FirstOrDefault(s => s.Id == _sampleId);
        var overwrite = loaded is not null &&
            string.Equals(loaded.Title, _sampleTitle, StringComparison.Ordinal);

        var body = new { content = _raw, title = _sampleTitle };

        if (await RunAsync(
                () => overwrite
                    ? Api.PutAsync($"utils/samples/{_sampleId}", body)
                    : Api.PostAsync($"utils/mc-models/{_modelId}/samples", body),
                overwrite ? "덮어썼습니다." : "보관했습니다.",
                "보관하지 못했습니다"))
        {
            _savingSample = false;
            await PickModelAsync(_modelId);
        }
    }

    private Task ParseAsync()
    {
        if (string.IsNullOrWhiteSpace(_raw))
        {
            Say("풀 원문을 넣으십시오.", NoticeTone.Warning);
            return Task.CompletedTask;
        }

        return LoadAsync(async () =>
        {
            var json = await Api.PostAsync<JsonElement>("utils/parse-binary", new { content = _raw });
            _rows = JsonTable.From(json);
            return _rows.Rows.Count;
        }, "푼 결과가 없습니다. 원문 모양을 확인하십시오.", "풀지 못했습니다");
    }
}
