@page "/helpdesk/util/binary-parser"
@attribute [RouteKey("helpdesk.util.binary-parser")]

@*
    [바이너리 파서] — DB 메뉴 `/helpdesk/util/binary-parser`. 엔드포인트 `POST utils/parse-binary`
    서버 칸은 content 다. raw 로 보내면 모델 바인딩이 조용히 버려 「Content is empty」 400 이 난다.
    입력 원문은 지우지 않는다(틀린 파싱을 고치려면 넣은 것이 남아 있어야 한다). 설비 모델의 전문 샘플(mc-models/{id}/samples)을 꺼내 쓴다.
*@

@inherits DataPage

<PageTitle>바이너리 파서 · 헬프데스크</PageTitle>

@* 조회 단추가 없다 — 아래 칸에 붙인 전문을 그 자리에서 해석한다. *@
@* 접지 않는다 — 화면의 주 입력이다. 설비 모델을 고르면 아래 판이 통째로 바뀐다. *@
<CommSch Foldable="false">
    <Fields>
        <CommSchItem Label="설비 모델">
            <DxComboBox Data="@_models" TextFieldName="@nameof(McModel.McName)" ValueFieldName="@nameof(McModel.Id)"
                        Value="@_modelId" ValueChanged="@((int? v) => PickModelAsync(v))"
                        ValueExpression="@(() => _modelId)" Style="width: 200px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="보관한 전문">
            <DxComboBox Data="@_samples" TextFieldName="@nameof(BinarySample.Title)" ValueFieldName="@nameof(BinarySample.Id)"
                        @bind-Value="_sampleId" Style="width: 220px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="불러오기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(_sampleId is not null)" Click="@LoadSampleAsync" />

        <PermissionView Action="MenuAction.Create">
            <DxButton Text="이 전문 보관" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus"
                      Enabled="@(_modelId is not null)" Click="@StartSaveSample" />
        </PermissionView>
    </Actions>
</CommSch>

<div class="hd-form">
    <label class="hd-field">
        <span class="hd-field__label">원문</span>
        <DxMemo @bind-Text="_raw" Rows="8" />
    </label>

    <div>
        <DxButton Text="풀기" RenderStyle="ButtonRenderStyle.Primary" Click="@ParseAsync" />
    </div>
</div>

<AutoGrid Data="@_rows" Loading="@Loading" PageSize="30" />

<CommPopup @bind-Visible="_savingSample" HeaderText="전문 보관" Width="420px">
    <BodyContentTemplate Context="popup">
        <div class="jsini-hint">
            @(_sampleId is null
                ? "새 이름으로 보관합니다."
                : "불러온 전문을 지금 내용으로 덮어씁니다. 이름을 바꾸면 새로 보관합니다.")
        </div>

        <DxTextBox @bind-Text="_sampleTitle" NullText="전문 이름" />

    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="보관" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveSampleAsync" />
        <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _savingSample = false)" />
    </FooterContentTemplate>
</CommPopup>
