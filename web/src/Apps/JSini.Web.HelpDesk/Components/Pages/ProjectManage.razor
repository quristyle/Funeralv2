@page "/helpdesk/project/manage"
@attribute [RouteKey("helpdesk.project.manage")]

@*
    [프로젝트 관리] — DB 메뉴 `/helpdesk/project/manage`.
    이력: Vue `views/helpdesk/project/manage` → 여기.
    엔드포인트: `project` (조회 · 등록 · 수정 · 삭제)

    [읽기만 남아 있었다]

    원본은 프로젝트를 **등록·수정·삭제하는 화면**이다(97줄). 옮길 때는 서버가
    준 대로 보여 주는 표 한 장이 되어 있었다 — 프로젝트를 만들 수 없으면
    WBS 도 간트도 얹을 자리가 없다. 이 모듈에서 **제일 먼저 하는 일**이
    빠져 있던 셈이다.

    [기간을 비워 두면 간트에 안 나온다]

    프로젝트 간트는 기간이 있는 것만 막대로 그린다(그 화면이 「기간이 없는
    프로젝트 n건은 타임라인에 나오지 않습니다」라고 말한다). 등록할 때 기간을
    권하는 이유가 그것이다 — 막지는 않는다. 기간을 나중에 정하는 일이 실제로 있다.
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>프로젝트 관리 · 헬프데스크</PageTitle>

@* 조건이 하나도 없어 조회 판을 세울 것이 없다. 등록·다시 읽기·수정·삭제는
   전부 CommGrd 가 맡는다 — 표 아래 띠와 관리 칸이 그 자리다. *@

<CommCont>
    <CommGrd TItem="Project" Data="@_items" PageSize="20"
             EditFormTitle="프로젝트"
             ExportName="프로젝트"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@DeleteMessage"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(Project.Name)" Caption="프로젝트" MinWidth="240" />

            <DxGridDataColumn Caption="담당 팀" Width="160">
                <CellDisplayTemplate Context="cell">
                    @(((Project)cell.DataItem).Team?.Name ?? "-")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(Project.ProjectStart)" Caption="시작" Width="130"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(Project.ProjectEnd)" Caption="종료" Width="130"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(Project.Remark)" Caption="비고" MinWidth="200" />

        </Columns>

        @* 편집 폼. DevExpress 가 만든 **편집 모델**(원본의 사본)이 넘어온다 —
           손으로 복사본을 만들어 팝업을 띄우던 일을 CommGrd 가 맡는다.

           지역 변수로 한 번 받아 두고 `@@bind-` 는 그 변수에 건다. 식 안에
           형변환을 끼우면 DevExpress 가 검증 식을 만들지 못해 팝업이 그냥
           안 열린다(EditFormBindingTests 주석 참고). *@
        <EditFormTemplate Context="edit">
            @{
                var form = (Project)edit.EditModel;
            }
            <DxFormLayout>
                <DxFormLayoutItem Caption="프로젝트" ColSpanMd="12">
                    <DxTextBox @bind-Text="form.Name" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="담당 팀" ColSpanMd="12">
                    <DxComboBox Data="@_teams" TextFieldName="@nameof(Team.Name)"
                                ValueFieldName="@nameof(Team.Id)"
                                @bind-Value="form.TeamId" NullText="팀 없음"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="시작" ColSpanMd="6">
                    <DxDateEdit @bind-Date="form.ProjectStart" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="종료" ColSpanMd="6">
                    <DxDateEdit @bind-Date="form.ProjectEnd" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                    <DxMemo @bind-Text="form.Remark" Rows="3" />
                </DxFormLayoutItem>

                @if (form.ProjectStart is null || form.ProjectEnd is null)
                {
                    <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                        @* 막지는 않는다. 기간을 나중에 정하는 일이 실제로 있다. *@
                        <div class="jsini-hint">기간을 비우면 간트 타임라인에 나오지 않습니다.</div>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    private IReadOnlyList<Project> _items = [];
    private IReadOnlyList<Team> _teams = [];


    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _items = await Api.GetListAsync<Project>("project");

        // 팀 목록은 편집 폼의 고르개가 쓴다. 못 읽어도 프로젝트는 보여 준다.
        try
        {
            _teams = await Api.GetListAsync<Team>("teams");
        }
        catch (ApiException)
        {
            _teams = [];
        }

        return _items.Count;
    }, "등록된 프로젝트가 없습니다.", "프로젝트를 읽지 못했습니다");

    private Task SaveAsync((Project Item, bool IsNew) e)
    {
        if (string.IsNullOrWhiteSpace(e.Item.Name))
        {
            // ApiException 으로 올린다. CommGrd 가 잡아 안내로 옮기고 팝업을
            // 열어 두므로 쓴 내용이 사라지지 않는다.
            throw new ApiException("프로젝트 이름을 넣으십시오.");
        }

        if (e.Item.ProjectEnd is { } end && e.Item.ProjectStart is { } start && end < start)
        {
            throw new ApiException("종료일이 시작일보다 앞섭니다.");
        }

        return e.IsNew
            ? Api.PostAsync("project", e.Item)
            : Api.PutAsync($"project/{e.Item.Id}", e.Item);
    }

    /// <summary>
    /// 삭제 확인 문구. <b>WBS 가 달려 있으면 서버가 막는다</b> — 화면이 미리
    /// 세지 않는 이유는 그 판단이 서버에만 있고, 화면이 따로 하면 둘이
    /// 어긋나서다. 그래서 「막힐 수도 있다」를 문구에 적어 둔다.
    /// </summary>
    private static string DeleteMessage(Project item) =>
        $"프로젝트 「{item.Name}」 을(를) 지웁니다."
        + "\nWBS 가 달려 있으면 서버가 막습니다. 되돌릴 수 없습니다.";

    private Task DeleteAsync(Project item) => Api.DeleteAsync($"project/{item.Id}");
}
