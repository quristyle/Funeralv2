@page "/helpdesk/hanju/gauge-collection"
@attribute [RouteKey("helpdesk.hanju.gauge-collection")]

@*
    [한주계량기 수집상태] — DB 메뉴 `/helpdesk/hanju/gauge-collection`. 프로시저 `P_QURI_MC`(계량기 목록) · 고른 계량기의 액션 프로시저 일곱
    수집중 판정은 run_state 가 아니라 last_mgap > 5 로 화면이 다시 정한다. 프로시저가 1분 지연인 계량기에도 N 을 줘서, 그대로 믿으면 멀쩡한 계량기가 붉게 선다.
    last_get_dt·next_get_dt 는 한주 DB 의 벽시계 값이라 UTC 로 읽어 되돌리면 아홉 시간이 어긋난다.
*@

@inherits AutoRefreshPage

<PageTitle>한주계량기 수집상태 · 헬프데스크</PageTitle>

<DxSplitter CssClass="hd-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
    <Panes>

    @* ── 왼쪽: 계량기 나무 ──────────────────────────────── *@
    <DxSplitterPane Size="24%" MinSize="220px" MaxSize="55%">
        <CommCont Title="계량기 목록" Hint="@ListHint" CssClass="hd-vsplit__pane hd-vsplit__pane--left">
            <ChildContent>
                @* 목록에 세울 계량기 거르개 셋. *@
                <div class="hd-gauge__filters">
                    <DxCheckBox Checked="@_onlyActive" CheckedChanged="@((bool v) => SetFilterAsync(active: v))">사용중</DxCheckBox>
                    <DxCheckBox Checked="@_excludeMaintenance" CheckedChanged="@((bool v) => SetFilterAsync(maintenance: v))">정상(점검제외)</DxCheckBox>
                    <DxCheckBox Checked="@_onlyReplicated" CheckedChanged="@((bool v) => SetFilterAsync(replicated: v))">복제계측기</DxCheckBox>
                </div>

                @* OnInput — 치는 대로 줄어야 한다(기본 OnChange 는 칸을 벗어나야 넘어온다). 라벨이 없어 자리표시 글이 라벨 노릇을 한다. *@
                <DxTextBox Text="@_keyword"
                           TextChanged="@((string? text) => Filter(text))"
                           BindValueMode="BindValueMode.OnInput"
                           InputDelay="200"
                           NullText="계량기 · 설명 찾기"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           CssClass="hd-gauge__search" />

                @* DxButtonGroup 은 자식을 Items 로 받는다. 그냥 넣으면 열 때 500 이 난다 — 맨 단추 셋으로 모양만 바꾼다. *@
                <div class="hd-gauge__group">
                    @foreach (var mode in GroupModes)
                    {
                        <DxButton Text="@mode.Text"
                                  RenderStyle="@(_group == mode.Value ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                                  Click="@(() => Regroup(mode.Value))" />
                    }
                </div>

                <CommTree TItem="GaugeNode" Data="@_nodes"
                          KeyFieldName="@nameof(GaugeNode.Key)"
                          ChildrenFieldName="@nameof(GaugeNode.Children)"
                          ShowExcelExport="false"
                          EmptyText="고를 계량기가 없습니다."
                          Reload="@ReloadAsync"
                          SelectedItem="@_node"
                          SelectedItemChanged="@PickAsync"
                          CssClass="hd-gauge__tree">
                    <Columns>
                        <DxTreeListDataColumn Caption="계량기" MinWidth="170">
                            <CellDisplayTemplate Context="cell">
                                @NodeLabel((GaugeNode)cell.DataItem)
                            </CellDisplayTemplate>
                        </DxTreeListDataColumn>
                    </Columns>
                </CommTree>
            </ChildContent>
        </CommCont>
    </DxSplitterPane>

    @* ── 오른쪽: 고른 계량기의 상태와 이력 ──────────────── *@
    <DxSplitterPane>
        @if (_gauge is null)
        {
            <CommCont CssClass="hd-vsplit__pane hd-vsplit__pane--right">
                <PageNotice Text="왼쪽에서 계량기를 고르십시오." Tone="NoticeTone.Info" />
            </CommCont>
        }
        else
        {
            <CommCont CssClass="hd-vsplit__pane hd-vsplit__pane--right hd-gauge__right">
                <TitleTemplate>
                    <h2 class="commcont__title">@_gauge.McId</h2>
                    <span class="jsini-badge @(Running ? "jsini-badge--success" : "jsini-badge--err")">
                        @(Running ? "수집중" : "중지")
                    </span>
                    @if (HasReplica)
                    {
                        <span class="jsini-badge jsini-badge--warn">Dst: @_gauge.DstMcId</span>
                    }
                    <span class="commcont__hint">@_gauge.Descript</span>
                </TitleTemplate>

                <ChildContent>
                    @* 액션 일곱. 누른 것이 진하게 선다. *@
                    <div class="jsini-toolbar hd-gauge__bar">
                        @foreach (var action in Actions)
                        {
                            <DxButton Text="@action.Text"
                                      RenderStyle="@(_action == action.Procedure ? action.On : ButtonRenderStyle.Secondary)"
                                      Enabled="@(!Loading)"
                                      Click="@(() => RunAsync(action))" />
                        }

                        <span class="hd-gauge__bar-right">
                            <DxCheckBox CheckType="CheckType.Switch" Checked="@_auto"
                                        CheckedChanged="@((bool on) => ToggleAuto(on))">
                                자동갱신 @(_auto ? "ON" : "OFF")
                            </DxCheckBox>
                            <DxButton IconCssClass="jsini-icon-refresh" Title="지금 다시 읽는다"
                                      RenderStyle="ButtonRenderStyle.Link"
                                      Enabled="@(!Loading)" Click="@RefreshNowAsync" />
                        </span>
                    </div>

                    @* 지금 상태. 지연이 한 시간을 넘으면 붉다. *@
                    <div class="hd-gauge__facts">
                        <div class="hd-gauge__fact">
                            <span class="hd-gauge__fact-label">지연 현황</span>
                            <span class="hd-gauge__fact-value @(_hour?.LastHgap > 0 ? "hd-gauge__over" : "hd-gauge__safe")">
                                @(_hour?.LastHgap ?? 0)h / @(_hour?.LastMgap ?? 0)m / @(_hour?.LastSgap ?? 0)s
                            </span>
                        </div>
                        <div class="hd-gauge__fact">
                            <span class="hd-gauge__fact-label">마지막 수집</span>
                            <span class="hd-gauge__fact-value">@Stamp(_hour?.LastGetDt)</span>
                        </div>
                        <div class="hd-gauge__fact">
                            <span class="hd-gauge__fact-label">다음 예정</span>
                            <span class="hd-gauge__fact-value">@Stamp(_hour?.NextGetDt)</span>
                        </div>
                        <div class="hd-gauge__fact">
                            <span class="hd-gauge__fact-label">서버 / 태그</span>
                            <span class="hd-gauge__fact-value">@Server / @(_gauge.TagId ?? "-")</span>
                        </div>
                        @if (_hour?.LastErrorMsg is { Length: > 0 } error)
                        {
                            <div class="hd-gauge__fact hd-gauge__fact--error">
                                <span class="hd-gauge__fact-label">최근 에러 (재시도: @_hour.RetryCnt)</span>
                                <span class="hd-gauge__fact-value" title="@error">@error</span>
                            </div>
                        }
                    </div>

                    <CommCont Title="@($"수집 이력 ({_gauge.McId})")" Hint="@_action">
                        <AutoGrid Data="@_rows" Loading="@Loading" SearchBox="true" AllRows="true" ColumnWidth="170" MinColumnWidth="160" />
                    </CommCont>

                    @if (HasReplica)
                    {
                        <CommCont Title="@($"복제 수집 이력 ({_gauge.DstMcId})")" Hint="@_action" CssClass="hd-gauge__replica">
                            <AutoGrid Data="@_replicaRows" Loading="@Loading" SearchBox="true" AllRows="true" ColumnWidth="170" MinColumnWidth="160" />
                        </CommCont>
                    }
                </ChildContent>
            </CommCont>
        }
    </DxSplitterPane>

    </Panes>
</DxSplitter>

<ConfirmDialog @ref="_confirm" />

@code {

    @* 지연된 계량기(5분 초과)는 이름이 붉다 — 나무를 훑는 것만으로 멈춘 것이 눈에 띈다. *@
    private static RenderFragment NodeLabel(GaugeNode node) =>
        node.IsGroup
            ? @<span class="hd-gauge__node">
                  <b class="hd-gauge__group-name">@node.Label</b>
                  @if (node.Extra is { Length: > 0 })
                  {
                      <span class="hd-gauge__node-desc">@node.Extra</span>
                  }
                  <span class="hd-gauge__count">(@node.Children.Count)</span>
              </span>
            : @<span class="hd-gauge__node">
                  @if (node.Delayed)
                  {
                      <span class="jsini-badge jsini-badge--err" title="@($"수집중지 ({node.Gauge!.LastMgap}분 지연)")">!</span>
                  }
                  @if (node.ReplicaTarget)
                  {
                      <span class="jsini-badge jsini-badge--warn" title="복제대상계측기">복제</span>
                  }
                  <b class="@(node.Delayed ? "hd-gauge__over" : null)">@node.Label</b>
                  @if (node.Gauge?.DstMcId is { Length: > 0 } dst)
                  {
                      <span class="hd-gauge__node-dst">(@dst)</span>
                  }
                  <span class="hd-gauge__node-desc" title="@node.Gauge?.Descript">@node.Gauge?.Descript</span>
              </span>;
}
