@page "/helpdesk/project/wbs-gantt"

@*
    [WBS 간트] — DB 메뉴 `/helpdesk/project/wbs-gantt`.
    이력: Vue `views/helpdesk/project/wbs-gantt` → 여기.
    엔드포인트: `wbs`

    **서버가 준 대로 보여 주는 화면이다**(AutoGrid). 칸을 손으로 적지 않은
    이유는 그 부품의 주석에 있다 — 요약하면, 이런 화면이 마흔 개고 백엔드가
    칸을 더할 때마다 화면을 고치러 가는 것이 이득이 아니기 때문이다.

    매일 들여다보는 화면이 되면 그때 칸을 손으로 적는다.

    [간트 차트를 아직 그리지 않는다]

    Vue 는 전용 간트 부품을 썼다. 그 부품을 옮기려면 라이브러리를 하나 더
    얹어야 하는데, 값어치가 확인되지 않았다. 지금은 **같은 자료를 기간이 보이는
    표로** 보여 준다 — 시작·종료·진척이 한 줄에 있으므로 읽을 수는 있다.
    간트가 실제로 필요하다는 것이 확인되면 그때 넣는다.
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>WBS 간트 · 헬프데스크</PageTitle>

<PageHeading Title="WBS 간트" Scope="헬프데스크" />

<PageNotice Text="간트 차트는 아직 옮기지 않았습니다. 같은 자료를 표로 보여 줍니다." Tone="NoticeTone.Warning" />

<PageNotice Text="@Notice" Tone="@Tone" />

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />

@code {
    private DataTable _rows = JsonTable.Empty;

    /// <summary>칸 이름표. 여기 적은 순서가 표의 앞쪽 순서다.</summary>
    private static readonly Dictionary<string, string> Captions = new(StringComparer.Ordinal)
    {
        ["wbsName"] = "작업",
        ["projectName"] = "프로젝트",
        ["adminName"] = "담당",
        ["startDate"] = "시작",
        ["endDate"] = "종료",
        ["progress"] = "진척",
        ["statusName"] = "상태",
    };

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var json = await Api.GetAsync<JsonElement>("wbs");
        _rows = JsonTable.From(json);
        return _rows.Rows.Count;
    }, "등록된 작업이 없습니다.", "WBS 를 읽지 못했습니다");
}
