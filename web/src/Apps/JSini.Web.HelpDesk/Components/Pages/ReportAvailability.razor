@page "/helpdesk/report/availability"
@attribute [RouteKey("helpdesk.report.availability")]

@*
    [가용성 분석] — DB 메뉴 `/helpdesk/report/availability`. 엔드포인트 `requests/report/quality`
    서버 집계를 그대로 본다 — 화면에서 다시 세면 같은 숫자를 두 곳에서 계산해 기간 경계가 어긋난다.
    응답이 객체 하나라 JsonTable 표는 빈다 — 지표 넷을 막대(0~100%)로 그린다.
*@

@inherits DataPage

<PageTitle>가용성 분석 · 헬프데스크</PageTitle>

@if (_analyzed > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">@(_periodLabel) 품질 지표 (분석 대상 @(_analyzed)건)</h3>
            <DxChart Data="@_bars" Palette="@BarPalette" Width="100%" Height="280px">
                <DxChartBarSeries T="RatioBar" TArgument="string" TValue="double"
                                  ArgumentField="b => b.Label" ValueField="b => b.Value"
                                  Name="비율(%)" />
                <DxChartValueAxis>
                    <DxChartAxisRange StartValue="@(0)" EndValue="@(100)" />
                    <DxChartAxisTitle Text="%" />
                </DxChartValueAxis>
                <DxChartLegend Visible="false" />
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @context.Point.Value%</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />
