@page "/helpdesk/report/weekly"
@attribute [RouteKey("helpdesk.report.weekly")]

@*
    [주간 리포트] — DB 메뉴 `/helpdesk/report/weekly`. 엔드포인트 `dashboard/my-monthly-stats`(고객) · `dashboard/admin-contribution-trend`(담당자)
    고객은 월별 접수(막대)+완료(선), 담당자는 주별 완료 52주(막대)를 그린다. 담당자별 몫(admins)은 중첩이라 표에 JSON 원문으로 남는다.
    칸 이름은 서버 DTO 기준이다 — period·openCount·closedCount 는 서버가 주지 않는다.
*@

@inherits DataPage

<PageTitle>주간 리포트 · 헬프데스크</PageTitle>

@if (_trend.Sum(p => p.Total + p.Completed) > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">@(_customer ? "월별 접수 · 완료 (우리 회사, 최근 12개월)" : "주별 완료 추이 (최근 52주)")</h3>
            <DxChart Data="@_trend" Palette="@TrendPalette" Width="100%" Height="280px">
                <DxChartArgumentAxis>
                    <DxChartAxisLabel DisplayMode="ChartAxisLabelDisplayMode.Standard"
                                      Overlap="ChartAxisLabelOverlap.Hide"
                                      RotationAngle="0" />
                </DxChartArgumentAxis>
                @if (_customer)
                {
                    <DxChartBarSeries T="TrendPoint" TArgument="string" TValue="int"
                                      ArgumentField="p => p.Label" ValueField="p => p.Total"
                                      Name="접수" />
                    <DxChartSplineSeries T="TrendPoint" TArgument="string" TValue="int"
                                       ArgumentField="p => p.Label" ValueField="p => p.Completed"
                                       Name="완료">
                        <DxChartSeriesPoint Visible="false" />
                    </DxChartSplineSeries>
                }
                else
                {
                    <DxChartBarSeries T="TrendPoint" TArgument="string" TValue="int"
                                      ArgumentField="p => p.Label" ValueField="p => p.Total"
                                      Name="주별 완료" />
                }
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @context.Point.SeriesName @(context.Point.Value)건</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />
