@page "/helpdesk/monitor/sm"

@*
    [SM 모니터링] — DB 메뉴 `/helpdesk/monitor/sm`.
    이력: Vue `views/helpdesk/monitor/sm` → 여기.
    엔드포인트: `requests/report/monthly` · `requests/report/emergency` ·
                `dashboard/admin-contribution-stats`

    ────────────────────────────────────────────────────────────
    [상태별 건수 표 한 장만 남아 있었다]

    원본은 **운영 현황판**이다(479줄). 한 달치 요청을 놓고 **평균 해결 시간
    (MTTR)**, 상태·유형 분포, 담당자별 부하, 그리고 **지금 터져 있는 긴급 건**을
    함께 보여 준다. 옮길 때는 `dashboard/requests/status-count` 하나만 부르는
    표가 되어 있었다 — 그 표로는 **「지금 무엇이 급한가」를 알 수 없다.**

    SM 은 「밀린 것이 몇 건인가」보다 **「누가 몰려 있고 무엇이 오래 걸리나」**를
    보는 일이다.

    ────────────────────────────────────────────────────────────
    [넷을 나란히 부르고, 하나가 실패해도 나머지를 보여 준다]

    현황판은 **떠 있는 것이 중요하다.** 담당자 부하 조회 하나가 실패했다고
    긴급 건까지 가리면, 그 순간 가장 필요한 정보를 잃는다.
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>SM 모니터링 · 헬프데스크</PageTitle>

<div class="jsini-toolbar">
    <DxSpinEdit @bind-Value="_year" MinValue="2000" MaxValue="2100" Style="width: 110px" />
    <DxSpinEdit @bind-Value="_month" MinValue="1" MaxValue="12" Style="width: 90px" />
    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@ReloadAsync" />
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

@if (_report is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">접수</div>
            <div class="jsini-stat__value">@_report.TotalCreated</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">해결</div>
            <div class="jsini-stat__value">@(_report.AdminCompletedCount + _report.UserCompletedCount)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">해결률</div>
            <div class="jsini-stat__value">@_report.ResolutionRate.ToString("0.0")%</div>
        </div>
        <div class="jsini-stat">
            @* MTTR — 평균 해결 시간. SM 계약에서 실제로 따지는 숫자다. *@
            <div class="jsini-stat__label">평균 해결</div>
            <div class="jsini-stat__value">@_report.AvgResolutionTime.ToString("0.0")시간</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">진행 중</div>
            <div class="jsini-stat__value">@_report.InProgressCount</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">대기</div>
            <div class="jsini-stat__value">@_report.PendingCount</div>
        </div>
    </div>
}

@* 지금 터져 있는 것. **맨 위에 둔다** — 이 화면에서 제일 급한 자료다. *@
@if (_emergency.Rows.Count > 0)
{
    <h2 class="ad-subhead">긴급</h2>

    <AutoGrid Data="@_emergency" Loading="@Loading" Captions="@EmergencyCaptions"
              HiddenCols="id,customerId" PageSize="10" />
}

@if (_daily.Count > 0)
{
    <h2 class="ad-subhead">날짜별 접수 · 완료</h2>

    <DxChart Data="@_daily" Width="100%" Height="240px">
        <DxChartLegend Position="RelativePosition.Outside" />
        <DxChartBarSeries T="DailyStat" TArgument="int" TValue="int"
                          ArgumentField="d => d.Day" ValueField="d => d.Created" Name="접수" />
        <DxChartBarSeries T="DailyStat" TArgument="int" TValue="int"
                          ArgumentField="d => d.Day" ValueField="d => d.Completed" Name="완료" />
    </DxChart>
}

<div class="hd-two">
    <div>
        <h2 class="ad-subhead">상태별</h2>
        <CommGrd TItem="Pair" Data="@_byStatus" PageSize="10">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(Pair.Label)" Caption="상태" MinWidth="160" />
                <DxGridDataColumn FieldName="@nameof(Pair.Value)" Caption="건수" Width="100" />
            </Columns>
        </CommGrd>
    </div>

    <div>
        <h2 class="ad-subhead">유형별</h2>
        <CommGrd TItem="Pair" Data="@_byType" PageSize="10">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(Pair.Label)" Caption="유형" MinWidth="160" />
                <DxGridDataColumn FieldName="@nameof(Pair.Value)" Caption="건수" Width="100" />
            </Columns>
        </CommGrd>
    </div>
</div>

@* 누가 몰려 있나. 담당자 재배정을 판단하는 자리다. *@
@if (_workload.Rows.Count > 0)
{
    <h2 class="ad-subhead">담당자별 부하</h2>

    <AutoGrid Data="@_workload" Loading="@Loading" Captions="@WorkloadCaptions"
              HiddenCols="adminId" PageSize="15" />
}

@code {
    /// <summary>이름과 숫자 한 쌍. 상태·유형 분포가 이 모양이다.</summary>
    public sealed record Pair(string Label, int Value);

    /// <summary>날짜별 접수·완료. 그래프의 재료다.</summary>
    public sealed record DailyStat(int Day, int Created, int Completed);

    private static readonly Dictionary<string, string> EmergencyCaptions = new(StringComparer.Ordinal)
    {
        ["title"] = "제목",
        ["requestedAt"] = "접수",
        ["status"] = "상태",
        ["customerName"] = "요청자",
    };

    private static readonly Dictionary<string, string> WorkloadCaptions = new(StringComparer.Ordinal)
    {
        ["adminName"] = "담당자",
        ["assignedCount"] = "배정",
        ["completedCount"] = "완료",
        ["inProgressCount"] = "진행 중",
    };

    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    private MonthlyReport? _report;
    private DataTable _emergency = JsonTable.Empty;
    private DataTable _workload = JsonTable.Empty;

    private IReadOnlyList<Pair> _byStatus = [];
    private IReadOnlyList<Pair> _byType = [];
    private IReadOnlyList<DailyStat> _daily = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var period = new { year = _year, month = _month };

        // 셋을 나란히. **하나가 실패해도 나머지는 보여 준다** —
        // 현황판은 떠 있는 것이 중요하다.
        var report = SafeAsync(() => Api.GetAsync<MonthlyReport>("requests/report/monthly", period));
        var emergency = SafeAsync(() => Api.GetAsync<JsonElement>("requests/report/emergency"));
        var workload = SafeAsync(() => Api.GetAsync<JsonElement>("dashboard/admin-contribution-stats", period));

        await Task.WhenAll(report, emergency, workload);

        _report = report.Result;
        _emergency = JsonTable.From(emergency.Result);
        _workload = JsonTable.From(workload.Result);

        _byStatus = Pairs(_report?.RequestsByStatus);
        _byType = Pairs(_report?.RequestsByType);

        _daily = _report?.DailyStats is { Count: > 0 } days
            ? [.. days.Select(d => new DailyStat(d.Day, d.CreatedCount, d.CompletedCount))]
            : [];

        return (_report?.TotalCreated ?? 0) + _emergency.Rows.Count;
    }, "그 달에 접수된 요청이 없습니다.", "현황을 읽지 못했습니다");

    /// <summary>실패를 삼키고 <c>default</c> 를 돌려준다. 까닭은 화면 머리말에 있다.</summary>
    private static async Task<T?> SafeAsync<T>(Func<Task<T?>> load)
    {
        try
        {
            return await load();
        }
        catch (ApiException)
        {
            return default;
        }
    }

    private static IReadOnlyList<Pair> Pairs(Dictionary<string, int>? source) =>
        source is null ? [] : [.. source.Select(kv => new Pair(kv.Key, kv.Value)).OrderByDescending(p => p.Value)];
}
