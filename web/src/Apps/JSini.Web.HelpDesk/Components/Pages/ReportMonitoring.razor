@page "/helpdesk/report/monitoring"
@attribute [RouteKey("helpdesk.report.monitoring")]

@*
    [운영 모니터링] — DB 메뉴 `/helpdesk/report/monitoring`. 엔드포인트 `dashboard/admin-stats`
    응답이 객체 하나라 JsonTable 표는 빈다 — 상태별 막대로 그린다. OADR 지표 선 차트가 다시 필요하면 자료를 OadrApi.GetServerReportAsync 로 되돌리는 결정이 먼저다.
*@

@using System.Text.Json

@inherits DataPage

<PageTitle>운영 모니터링 · 헬프데스크</PageTitle>

@if (_bars.Sum(b => b.Count) > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">내 배정 현황 (상태별)</h3>
            <DxChart Data="@_bars" Palette="@BarPalette" Width="100%" Height="280px">
                <DxChartBarSeries T="StatusBar" TArgument="string" TValue="int"
                                  ArgumentField="b => b.Label" ValueField="b => b.Count"
                                  Name="건수" />
                <DxChartLegend Visible="false" />
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @(context.Point.Value)건</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />
