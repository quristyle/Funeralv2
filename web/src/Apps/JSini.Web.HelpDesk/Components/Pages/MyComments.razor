@page "/helpdesk/request/my-comments"
@attribute [RouteKey("helpdesk.request.my-comments")]

@*
    [내 댓글] — DB 메뉴 `/helpdesk/request/my-comments`.
    이력: Vue `views/helpdesk/request/my-comments` → 여기.
    엔드포인트: `comments/my`
*@

@inherits DataPage

<PageTitle>내 댓글 · 헬프데스크</PageTitle>

@if (_comments.Count == 0 && !Loading)
{
    <p class="hd-cards__empty">작성한 댓글이 없습니다.</p>
}
else
{
    <div class="hd-my-comments">
        @foreach (var comment in _comments)
        {
            <article class="jsini-card hd-my-comment" @key="comment.CommentId"
                     style="cursor: pointer;"
                     @onclick="@(() => GoToDetail(comment))">
                <header class="hd-my-comment__head">
                    <div class="hd-my-comment__request">
                        @RequestTitle(comment)
                    </div>
                    @if (!string.IsNullOrWhiteSpace(comment.RequestStatus))
                    {
                        <span class="jsini-badge">@comment.RequestStatus</span>
                    }
                </header>

                <div class="hd-my-comment__content hd-content">
                    @Body(comment)
                </div>

                <footer class="hd-my-comment__foot">
                    <time datetime="@comment.CreatedAt.ToString("O")">@When(comment.CreatedAt)</time>
                    @if (comment.ParentCommentId.HasValue)
                    {
                        <span class="hd-my-comment__reply">답글</span>
                    }
                    @if (comment.ReplyCount > 0)
                    {
                        <span>답글 @comment.ReplyCount</span>
                    }
                </footer>
            </article>
        }
    </div>
}
