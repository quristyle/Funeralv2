@page "/helpdesk/hanju/procedure-result"
@attribute [RouteKey("helpdesk.hanju.procedure-result")]

@*
    [프로시저 결과] — DB 메뉴 `/helpdesk/hanju/procedure-result`. P_QURI_PROC(목록·인자)로 고른 프로시저를 실행한다.
    목록과 인자 이름은 DB 가 정하므로 화면에 박지 않는다(프로시저가 늘면 저절로 나온다). 왼쪽에서 고르고 오른쪽에서 본다.
    거르개는 거르는 목록 바로 위에 둔다 — 조회 판에 올리면 거를 목록과 떨어진다. 판은 <Panes> 안에 적어야 한다(빼면 빈 상자, DxSplitterPanesTests 가 막는다).
*@

@inherits DataPage

<PageTitle>프로시저 결과 · 헬프데스크</PageTitle>

<DxSplitter CssClass="hd-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
    <Panes>

    <DxSplitterPane Size="26%" MinSize="240px" MaxSize="60%">
        <CommCont Title="프로시저" Hint="@ListHint" CssClass="hd-vsplit__pane hd-vsplit__pane--left">
            <Actions>
                @* 목록을 다시 읽는다. 모양은 CommGrd 의 다시 읽기와 같게 맞춘다. *@
                <DxButton IconCssClass="jsini-icon-refresh" Title="프로시저 목록을 다시 읽는다"
                          RenderStyle="ButtonRenderStyle.Link"
                          Enabled="@(!Loading)" Click="@ReloadAsync" />
            </Actions>

            <ChildContent>
                @* 거르개. 라벨이 없어 자리표시 글이 라벨 노릇을 한다. 치는 대로 줄어야 해서 OnInput 이다(기본 OnChange 는 칸을 벗어나야 넘어온다). *@
                <DxTextBox Text="@_keyword"
                           TextChanged="@((string? text) => _keyword = text)"
                           BindValueMode="BindValueMode.OnInput"
                           InputDelay="200"
                           NullText="프로시저명 · 설명 찾기"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           CssClass="hd-procfilter" />

                @* 목록만 제 안에서 구른다 — 인자 칸과 「실행」이 그 아래 붙박이로 남아야 한다. 판 전체가 구르면 프로시저를 고르자마자 단추가 밀려난다. *@
                <div class="hd-proclist">
                    @if (Shown.Count == 0)
                    {
                        <p class="hd-proclist__empty">
                            @(_procedures.Count == 0 ? "돌릴 수 있는 프로시저가 없습니다." : "거른 결과가 없습니다.")
                        </p>
                    }
                    else
                    {
                        @foreach (var procedure in Shown)
                        {
                            @* 목록 줄은 button 이라야 키보드로 고른다. div 에 @onclick 을 달면 탭으로 닿지 않는다. *@
                            <button type="button"
                                    class="hd-proc @(IsPicked(procedure.Name) ? "is-on" : null)"
                                    aria-pressed="@IsPicked(procedure.Name)"
                                    title="@procedure.Name"
                                    @onclick="@(() => Pick(procedure.Name))">
                                <span class="hd-proc__name">@ShortName(procedure.Name)</span>
                                @if (procedure.Description is { Length: > 0 })
                                {
                                    <span class="hd-proc__desc">@procedure.Description</span>
                                }
                            </button>
                        }
                    }
                </div>

                @if (_selected is { Length: > 0 })
                {
                    <div class="hd-params">
                        <div class="hd-params__head">
                            <span class="hd-params__title">인자</span>
                            <DxButton Text="실행" RenderStyle="ButtonRenderStyle.Primary"
                                      Enabled="@(!Loading)" Click="@RunAsync" />
                        </div>

                        @if (_parameters.Count == 0)
                        {
                            <p class="hd-proclist__empty">넣을 인자가 없습니다.</p>
                        }
                        else
                        {
                            @* 격자는 이 칸이 쥔다. 줄마다 격자를 따로 만들면 이름 길이에 따라 칸 시작점이 어긋난다 — 줄들이 같은 세로줄을 공유한다(.hd-param 은 display: contents). *@
                            <div class="hd-params__fields">
                            @foreach (var parameter in _parameters)
                            {
                                <label class="hd-param">
                                    <span class="hd-param__label">@parameter.Name</span>
                                    @if (IsDateTimeType(parameter.DataType))
                                    {
                                        <DxDateEdit @bind-Date="parameter.DateValue"
                                                    TimeSectionVisible="true"
                                                    Format="yyyy-MM-dd HH:mm:ss"
                                                    DisplayFormat="yyyy-MM-dd HH:mm:ss"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                    }
                                    else if (IsDateType(parameter.DataType))
                                    {
                                        <DxDateEdit @bind-Date="parameter.DateValue"
                                                    Format="yyyy-MM-dd"
                                                    DisplayFormat="yyyy-MM-dd"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                    }
                                    else
                                    {
                                        <DxTextBox Text="@parameter.Value"
                                                   TextChanged="@((string v) => parameter.Value = v)" />
                                    }
                                    @if (ParamHint(parameter) is { Length: > 0 } hint)
                                    {
                                        <span class="hd-param__hint">@hint</span>
                                    }
                                </label>
                            }
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </CommCont>
    </DxSplitterPane>

    <DxSplitterPane>
        @if (_selected is not { Length: > 0 })
        {
            <CommCont CssClass="hd-vsplit__pane hd-vsplit__pane--right">
                <PageNotice Text="왼쪽에서 프로시저를 고르십시오." Tone="NoticeTone.Info" />
            </CommCont>
        }
        else
        {
            @* 제목이 곧 고른 프로시저다. 짧은 이름은 Title, 온전한 이름은 옆에 옅게 붙는 Hint 로 간다. 건수는 총 건수다 — 표 안 검색으로 거르면 보이는 줄만 줄고 이 수는 그대로다. *@
            <CommCont Title="@ShortName(_selected)" Hint="@ResultHint"
                      CssClass="hd-vsplit__pane hd-vsplit__pane--right">
                <ChildContent>
                    @if (Description is { Length: > 0 })
                    {
                        <div class="jsini-hint">@Description</div>
                    }

                    @* 결과 칸은 프로시저마다 달라 표 전체를 훑는 검색칸을 켠다. 쪽을 나누지 않는다(AllRows) — 한 묶음으로 훑는 화면이다. *@
                    <AutoGrid Data="@_rows" Loading="@Loading" SearchBox="true" AllRows="true" />
                </ChildContent>
            </CommCont>
        }
    </DxSplitterPane>

    </Panes>
</DxSplitter>
