@page "/helpdesk/request/detail/{Id}"
@attribute [RouteKey("helpdesk.request.detail")]

@*
    [요청 상세] — 요청 한 건의 본문·머릿값·댓글 나무와 접수·완료·종료·재요청 단추.
    메뉴에 없는 주소라 요청마다 제 탭을 직접 연다(`PortalTabs.Open`, standalone).
*@

@inherits DataPage

<PageTitle>@TabTitle · 헬프데스크</PageTitle>

@* 경계 767px 는 CSS 의 휴대폰 경계와 같아야 한다(요청 처리 목록과 같은 값). *@
<DxLayoutBreakpoint MaxWidth="767" IsActive="_isPhone" IsActiveChanged="@OnPhoneChanged" />

<div class="hd-detail">
    @* 돌아갈 자리 · 제목 · 상태 · 단추를 한 줄에 둔다. *@
    <div class="hd-detail__head">
        @* 알림으로 들어온 사람에게는 이 화면이 첫 화면이다. *@
        <a class="hd-detail__back" href="/helpdesk/request/manage">← 요청 처리</a>

        <h2 class="hd-detail__title">@TabTitle</h2>

        @if (_request is not null)
        {
            <span class="jsini-badge @StatusClass()">@StatusText()</span>

            @* 지운 글은 시스템관리자만 연다. 할 수 있는 일은 되살리기와 완전삭제 둘뿐이다. *@
            @if (IsDeleted)
            {
                <span class="jsini-badge jsini-badge--err">삭제됨</span>

                @if (Context.IsSystemAdmin)
                {
                    <div class="hd-actions">
                        <DxButton Text="복원" RenderStyle="ButtonRenderStyle.Primary"
                                  SizeMode="SizeMode.Small"
                                  Enabled="@(!Loading)" Click="@RestoreAsync" />
                        <DxButton Text="완전삭제" RenderStyle="ButtonRenderStyle.Danger"
                                  SizeMode="SizeMode.Small"
                                  Enabled="@(!Loading)" Click="@PurgeAsync" />
                    </div>
                }
            }
            else if (_isPhone)
            {
                @* 휴대폰에서는 단추 줄이 제목 아래로 몇 줄씩 흘러 본문을 밀어낸다. 단추 하나에 모아 누르면 목록으로 편다. *@
                @if (HasAnyAction)
                {
                    <DxDropDownButton Text="처리" RenderStyle="ButtonRenderStyle.Primary"
                                      SizeMode="SizeMode.Small"
                                      CssClass="hd-actions-menu"
                                      DropDownCssClass="hd-actions-sheet"
                                      Enabled="@(!Loading)">
                        <Items>
                            @if (CanHandle && IsPending)
                            {
                                <DxDropDownButtonItem Text="접수" Click="@AcceptAsync" />
                            }
                            @if (CanHandle && IsOpen)
                            {
                                <DxDropDownButtonItem Text="완료" Click="@CompleteAsync" />
                            }
                            @if (CanClose)
                            {
                                <DxDropDownButtonItem Text="종료(최종확인)" Click="@CloseAsync" />
                                <DxDropDownButtonItem Text="재요청" Click="@ResubmitAsync" />
                            }
                            @if (Context.IsSystemAdmin)
                            {
                                <DxDropDownButtonItem Text="지시작업으로보내기" Click="@SendToAiTaskAsync" />
                                @if (CanDeleteRequest)
                                {
                                    @* 지우는 것은 맨 아래에 금을 그어 떼어 둔다 — 손가락이 미끄러져 눌리지 않게. *@
                                    <DxDropDownButtonItem Text="삭제" IconCssClass="jsini-icon-close"
                                                          CssClass="hd-actions__danger"
                                                          BeginGroup="true" Click="@DeleteAsync" />
                                }
                            }
                        </Items>
                    </DxDropDownButton>
                }
            }
            else
            {
                <div class="hd-actions">
                    @* `Loading` 으로 두 번 눌러 알림이 두 번 나가는 것을 막는다. *@
                    @if (CanHandle)
                    {
                        @if (IsPending)
                        {
                            <DxButton Text="접수" RenderStyle="ButtonRenderStyle.Primary"
                                      SizeMode="SizeMode.Small"
                                      Enabled="@(!Loading)" Click="@AcceptAsync" />
                        }

                        @if (IsOpen)
                        {
                            <DxButton Text="완료" RenderStyle="ButtonRenderStyle.Success"
                                      SizeMode="SizeMode.Small"
                                      Enabled="@(!Loading)" Click="@CompleteAsync" />
                        }
                    }

                    @* 종료·재요청은 글 주인의 자리다 — 담당자 권한을 보지 않는다. *@
                    @if (CanClose)
                    {
                        <DxButton Text="종료(최종확인)" RenderStyle="ButtonRenderStyle.Primary"
                                  SizeMode="SizeMode.Small"
                                  Enabled="@(!Loading)" Click="@CloseAsync" />

                        @* 종료와 색을 달리해 끝내려던 사람이 새 글을 여는 일을 막는다. *@
                        <DxButton Text="재요청" RenderStyle="ButtonRenderStyle.Secondary"
                                  SizeMode="SizeMode.Small"
                                  Enabled="@(!Loading)" Click="@ResubmitAsync" />
                    }

                    @if (Context.IsSystemAdmin)
                    {
                        <DxButton Text="지시작업으로보내기" RenderStyle="ButtonRenderStyle.Info"
                                  SizeMode="SizeMode.Small"
                                  Enabled="@(!Loading)" Click="@SendToAiTaskAsync" />
                        @if (CanDeleteRequest)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      IconCssClass="jsini-icon-close"
                                      SizeMode="SizeMode.Small"
                                      Title="삭제" aria-label="삭제"
                                      Enabled="@(!Loading)" Click="@DeleteAsync" />
                        }
                    }
                </div>
            }
        }
    </div>

    @if (_request is not null && IsDeleted)
    {
        <PageNotice Tone="NoticeTone.Warning">@DeletedNotice</PageNotice>
    }

    @if (_request is not null)
    {
        @* `dl` 안의 `div` 가 있어야 좁은 화면에서 이름과 값이 한 덩이로 접힌다. *@
        <dl class="hd-facts">
            @* 회사 이름은 서버가 푼다(헬프데스크에는 회사 표가 없다). *@
            <div class="hd-fact"><dt>고객사</dt><dd>@CompanyName()</dd></div>

            <div class="hd-fact"><dt>요청자</dt><dd>@RequesterName()</dd></div>
            <div class="hd-fact"><dt>접수자</dt><dd>@AssigneeName()</dd></div>

            <div class="hd-fact"><dt>요청일</dt><dd>@When("createdAt")</dd></div>
            <div class="hd-fact"><dt>접수일</dt><dd>@When("acceptedAt")</dd></div>
            <div class="hd-fact"><dt>완료일</dt><dd>@When("completededAt")</dd></div>

            @* `-ded-` 는 서버 쪽 오타(`UserCompletededAt`)가 굳은 이름이다. *@
            @if (Value("userCompletededAt") is not null)
            {
                <div class="hd-fact"><dt>종료일</dt><dd>@When("userCompletededAt")</dd></div>
            }
        </dl>

        @* 본문은 서식 편집기가 쓴 HTML 이다. `data-imgview-scope` 로 그림을 크게 볼 수 있다. *@
        <div class="hd-content" data-imgview-scope>@Body()</div>

        @* 그림은 눌러 크게 보고(앞뒤로 넘긴다), 모든 파일은 이름을 눌러 내려받는다. *@
        @if (_attachments.Count > 0)
        {
            <section class="hd-attach" aria-label="첨부파일">
                <h2 class="hd-subhead">첨부 @_attachments.Count</h2>
                <ul class="hd-attach__list">
                    @foreach (var file in _attachments)
                    {
                        <li class="hd-attach__item">
                            @if (ImageIndex(file) is { } index)
                            {
                                <button type="button" class="hd-attach__thumb"
                                        title="@($"{file.OriginalFileName} 크게 보기")"
                                        aria-label="@($"{file.OriginalFileName} 크게 보기")"
                                        @onclick="@(() => OpenImages(index))">
                                    <img src="@FileDownload.ThumbnailUrlFor(file.FileId!)" alt="" loading="lazy" />
                                </button>
                            }
                            <a class="hd-cmt__file"
                               href="@FileUrl(file)"
                               target="_blank"
                               download="@file.OriginalFileName"
                               title="@($"{file.OriginalFileName} 내려받기")">
                                <span class="jsini-icon-paperclip" aria-hidden="true"></span>
                                <span class="hd-cmt__file-name">@file.OriginalFileName</span>
                                @if (file.FileSize is > 0)
                                {
                                    <span class="hd-cmt__file-size">(@HumanSize(file.FileSize.Value))</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    }

    @if (_notFound)
    {
        <PageNotice Tone="NoticeTone.Warning">@NotFoundMessage</PageNotice>
    }
    else
    {
        <h2 class="hd-subhead">댓글 @_commentCount</h2>

        @if (_roots.Count > 0)
        {
            <CommentThread Nodes="@_roots"
                           CanReply="@CanWrite"
                           CanDeleteComment="@(!IsFinished && !IsDeleted)"
                           CanPurge="@Context.IsSystemAdmin"
                           OnPurge="@PurgeCommentAsync"
                           ReplyTo="@_replyTo"
                           CurrentUserId="@Context.HelpdeskUserId"
                           CurrentUserType="@(Context.Identity?.LoginType ?? "admin")"
                           OnToggle="@ToggleReply"
                           OnReply="@AddReplyAsync"
                           OnDelete="@DeleteCommentAsync"
                           FailedIds="@FailedIds"
                           OnRetry="@RetryCommentAsync"
                           OnDiscard="@DiscardComment" />
        }

        @if (Context.IdentityChecked)
        {
            @if (IsFinished)
            {
            }
            else if (CanWrite)
            {
                <div class="hd-cmt-root">
                    <CommentEditor Id="new" OnSubmit="@AddRootAsync" />
                </div>
            }
            else if (!Context.IsLinked)
            {
                @* 계정이 연결되지 않아 작성자를 가리킬 값이 없다. *@
            }
        }
    }
</div>

<ConfirmDialog @ref="_confirm" />
