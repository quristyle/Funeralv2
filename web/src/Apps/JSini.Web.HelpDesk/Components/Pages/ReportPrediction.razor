@page "/helpdesk/report/prediction"
@attribute [RouteKey("helpdesk.report.prediction")]

@*
    [장애 예측] — DB 메뉴 `/helpdesk/report/prediction`. 엔드포인트 `requests/report/quality`
    응답이 객체 하나라 표는 빈다 — 위험 신호로 읽는 결함·재오픈 두 비율을 막대로 그린다.
*@

@inherits DataPage

<PageTitle>장애 예측 · 헬프데스크</PageTitle>

@if (_analyzed > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">@(_periodLabel) 위험 신호 (분석 대상 @(_analyzed)건 · 재작업 @(_rollback)건)</h3>
            <DxChart Data="@_bars" Palette="@BarPalette" Width="100%" Height="280px">
                <DxChartBarSeries T="RatioBar" TArgument="string" TValue="double"
                                  ArgumentField="b => b.Label" ValueField="b => b.Value"
                                  Name="비율(%)" />
                <DxChartValueAxis>
                    <DxChartAxisRange StartValue="@(0)" EndValue="@(100)" />
                    <DxChartAxisTitle Text="%" />
                </DxChartValueAxis>
                <DxChartLegend Visible="false" />
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @context.Point.Value%</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />
