@page "/helpdesk/report/monthly"

@*
    [월간 리포트] — DB 메뉴 `/helpdesk/report/monthly`.
    이력: Vue `views/helpdesk/report/monthly` → 여기.
    엔드포인트: `requests/report/monthly`

    **서버가 준 대로 보여 주는 화면이다**(AutoGrid). 칸을 손으로 적지 않은
    이유는 그 부품의 주석에 있다 — 요약하면, 이런 화면이 마흔 개고 백엔드가
    칸을 더할 때마다 화면을 고치러 가는 것이 이득이 아니기 때문이다.

    매일 들여다보는 화면이 되면 그때 칸을 손으로 적는다.

    [보고서는 서버가 집계한 것을 그대로 본다]

    화면에서 다시 세지 않는다. 세면 같은 숫자를 두 곳에서 계산하게 되고,
    반드시 어긋난다 — 기간 경계를 어떻게 잡느냐가 늘 다르기 때문이다.

    [응답이 배열이 아니라 객체다 — 표가 늘 비어 있었다]

    `report/monthly` 는 집계 <b>객체 하나</b>를 준다(`MaintenanceReportDto`).
    `JsonTable.From` 은 배열만 표로 옮기므로 이 화면의 표는 지금까지 한 줄도
    나온 적이 없다. 그 객체 안의 `dailyStats`(일자별 접수·완료 배열)를 아래
    차트가 그린다 — 표는 이 화면을 손볼 때(칸을 손으로 적을 때) 함께 정리한다.

    [차트 — D3 결정 반영]

    옛 화면은 한주 OADR 의 월간 지표를 막대+선 혼합(echarts)으로 그리던
    화면이라 D3 결정 대상이다. 이관하면서 자료가 헬프데스크 월간 보고서로
    바뀌었지만 `dailyStats` 가 같은 꼴(날짜축 시계열)이라, 옛 종류 그대로
    **막대(접수)+선(완료)** 혼합으로 그린다. 색은 옛 화면의 접수·완료 색이다.
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>월간 리포트 · 헬프데스크</PageTitle>

<PageHeading Title="월간 리포트" Scope="헬프데스크" />

<PageNotice Text="@Notice" Tone="@Tone" />

@if (_daily.Sum(d => d.Requested + d.Completed) > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">@(_periodLabel) 일자별 접수 · 완료</h3>
            <DxChart Data="@_daily" Palette="@DailyPalette" Width="100%" Height="280px">
                <DxChartBarSeries T="DayPoint" TArgument="string" TValue="int"
                                  ArgumentField="p => p.Label" ValueField="p => p.Requested"
                                  Name="접수" />
                <DxChartLineSeries T="DayPoint" TArgument="string" TValue="int"
                                   ArgumentField="p => p.Label" ValueField="p => p.Completed"
                                   Name="완료" />
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @context.Point.SeriesName @(context.Point.Value)건</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />

@code {
    private DataTable _rows = JsonTable.Empty;

    /// <summary>칸 이름표. 여기 적은 순서가 표의 앞쪽 순서다.</summary>
    private static readonly Dictionary<string, string> Captions = new(StringComparer.Ordinal)
    {
        ["period"] = "기간",
        ["companyName"] = "고객사",
        ["openCount"] = "접수",
        ["closedCount"] = "완료",
    };

    // ── 차트 재료 ───────────────────────────────────────────

    private sealed record DayPoint(string Label, int Requested, int Completed);

    /// <summary>접수·완료 색 — 옛 화면의 월별 차트 색 그대로.</summary>
    private static readonly string[] DailyPalette = ["#42A5F5", "#66BB6A"];

    private IReadOnlyList<DayPoint> _daily = [];

    private string _periodLabel = string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        // 보고서는 `dashboard` 가 아니라 **`requests` 묶음** 밑에 있다.
        // `year`·`month` 가 필수다 — 없으면 400 이 난다.
        var now = DateTime.Now;
        _periodLabel = $"{now.Year}년 {now.Month}월";

        var json = await Api.GetAsync<JsonElement>(
            "requests/report/monthly", new { year = now.Year, month = now.Month });
        _rows = JsonTable.From(json);
        _daily = ToDaily(json);

        // 응답이 객체라 표는 비고(위 주석) 차트만 남는다.
        // 차트에 그릴 것이 있으면 「없습니다」 를 띄우지 않는다.
        return _rows.Rows.Count + (_daily.Sum(d => d.Requested + d.Completed) > 0 ? 1 : 0);
    }, "집계할 자료가 없습니다.", "월간 리포트를 읽지 못했습니다");

    /// <summary>
    /// 객체 응답에서 `dailyStats` 만 뽑는다. 칸 이름은 서버
    /// <c>DailyRequestStatDto</c>(day·requestCount·completedCount)와 대조했다.
    /// </summary>
    private static IReadOnlyList<DayPoint> ToDaily(JsonElement json)
    {
        if (json.ValueKind != JsonValueKind.Object
            || !json.TryGetProperty("dailyStats", out var daily)
            || daily.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return [.. daily.EnumerateArray()
            .Where(d => d.ValueKind == JsonValueKind.Object)
            .Select(d => new DayPoint($"{Num(d, "day")}일", Num(d, "requestCount"), Num(d, "completedCount")))];
    }

    private static int Num(JsonElement json, string name) =>
        json.TryGetProperty(name, out var value) && value.TryGetInt32(out var n) ? n : 0;
}
