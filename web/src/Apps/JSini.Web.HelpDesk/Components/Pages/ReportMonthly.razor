@page "/helpdesk/report/monthly"
@attribute [RouteKey("helpdesk.report.monthly")]

@*
    [월간 리포트] — DB 메뉴 `/helpdesk/report/monthly`. 엔드포인트 `requests/report/monthly`
    응답이 객체 하나라 JsonTable 표는 빈다 — 그 안의 dailyStats(날짜축 시계열)를 막대(접수)+선(완료)으로 그린다.
*@

@inherits DataPage

<PageTitle>월간 리포트 · 헬프데스크</PageTitle>

@if (_daily.Sum(d => d.Requested + d.Completed) > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">@(_periodLabel) 일자별 접수 · 완료</h3>
            <DxChart Data="@_daily" Palette="@DailyPalette" Width="100%" Height="280px">
                <DxChartArgumentAxis>
                    <DxChartAxisLabel DisplayMode="ChartAxisLabelDisplayMode.Standard"
                                      Overlap="ChartAxisLabelOverlap.Hide"
                                      RotationAngle="0" />
                </DxChartArgumentAxis>
                <DxChartBarSeries T="DayPoint" TArgument="string" TValue="int"
                                  ArgumentField="p => p.Label" ValueField="p => p.Requested"
                                  Name="접수" />
                <DxChartSplineSeries T="DayPoint" TArgument="string" TValue="int"
                                   ArgumentField="p => p.Label" ValueField="p => p.Completed"
                                   Name="완료">
                    <DxChartSeriesPoint Visible="false" />
                </DxChartSplineSeries>
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @context.Point.SeriesName @(context.Point.Value)건</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />
