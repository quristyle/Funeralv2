@page "/helpdesk/util/mc-model"
@attribute [RouteKey("helpdesk.util.mc-model")]

@*
    [MC 모델 관리] — DB 메뉴 `/helpdesk/util/mc-model`.
    이력: Vue `views/helpdesk/util/mc-model` → 여기.
    엔드포인트: `utils/mc-models`(모델) · `utils/mc-models/{id}/parse-items`(해석 규칙)

    [읽기만 남아 있었다]

    원본은 **전문 해석 규칙을 만드는 화면**이다(873줄). 설비 모델을 등록하고,
    그 모델의 전문을 어떻게 끊어 읽을지(해석 항목)를 정한다. **바이너리 파서가
    그 규칙으로 전문을 푼다** — 규칙을 못 만들면 파서가 아무것도 못 푼다.
    옮길 때는 모델 이름만 보여 주는 표 한 장이 되어 있었다.

    [모델 → 해석 항목 두 층이다]

    왼쪽에서 모델을 고르면 오른쪽에 그 모델의 해석 항목이 나온다. 항목 아래에
    태그가 한 층 더 있는데(`TagItems`) 그것까지는 아직 옮기지 않았다 —
    태그 없이도 전문을 끊어 읽는 것은 된다.

    [키는 콤마로 적는다]

    전문 시작을 알아보는 바이트를 `2,48,49` 처럼 적는다. 서버가 그 글자를
    바이트 목록으로 바꾼다 — 화면이 바꾸지 않는 이유는 그 규칙이 서버에만
    있고, 화면이 따로 하면 둘이 어긋나서다.
*@

@inherits DataPage

<PageTitle>MC 모델 관리 · 헬프데스크</PageTitle>

@* 조건이 하나도 없어 조회 판을 세울 것이 없다. 등록은 각 자료 판의 제목
   줄로, 다시 읽기는 표 아래 띠로 갔다. *@

<div class="hd-two">
    <CommCont Title="설비 모델" Hint="@($"{_models.Count}개")">
        <Actions>
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="모델 등록" RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="jsini-icon-plus" Click="@StartNewModel" />
            </PermissionView>
        </Actions>

        <ChildContent>
        <CommGrd TItem="McModel" Data="@_models"
                 ExportName="설비모델"
                 ActionsWidth="190"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(McModel.McName)" Caption="모델" MinWidth="160" />
                <DxGridDataColumn FieldName="@nameof(McModel.StartKey)" Caption="시작 키" Width="120" />

            </Columns>

            @* 관리 칸은 CommGrd 가 붙인다. 「규칙 보기」는 오른쪽 판을 바꾸는
               이 화면만의 동작이라 「수정」 앞에 선다. *@
            <RowActions Context="model">
                <DxButton IconCssClass="jsini-icon-eye"
                          RenderStyle="ButtonRenderStyle.Link"
                          Title="이 모델의 해석 규칙을 오른쪽에 편다"
                          Enabled="@(model.Id != _modelId)"
                          Click="@(() => PickAsync(model))" />
                <PermissionView Action="MenuAction.Update">
                    <DxButton IconCssClass="jsini-icon-edit" Title="수정"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => StartEditModel(model))" />
                </PermissionView>
                <PermissionView Action="MenuAction.Delete">
                    <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                              CssClass="commgrd__icon--warn"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => DeleteModelAsync(model))" />
                </PermissionView>
            </RowActions>
        </CommGrd>
        </ChildContent>
    </CommCont>

    <CommCont Title="@($"해석 규칙{(_modelName is { Length: > 0 } name ? $" — {name}" : "")}")"
              Hint="@(_modelId is null ? null : $"{_items.Count}건")">
        <Actions>
            @if (_modelId is not null)
            {
                <PermissionView Action="MenuAction.Create">
                    <DxButton Text="규칙 추가" RenderStyle="ButtonRenderStyle.Secondary"
                              IconCssClass="jsini-icon-plus" Click="@StartNewItem" />
                </PermissionView>
            }
        </Actions>

        <ChildContent>
        @if (_modelId is null)
        {
            <PageNotice Text="왼쪽에서 모델을 고르면 그 모델의 해석 규칙이 나옵니다." />
        }
        else
        {
            <CommGrd TItem="ParseItem" Data="@_items"
                     ExportName="해석규칙"
                     Reload="@LoadItemsAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(ParseItem.Desc)" Caption="설명" MinWidth="180" />
                    <DxGridDataColumn FieldName="@nameof(ParseItem.PTYPE)" Caption="구분" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(ParseItem.KeyIdx)" Caption="키 위치" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(ParseItem.BlocParseLength)" Caption="길이" Width="110" />
                    <DxGridDataColumn FieldName="@nameof(ParseItem.BlocParseType)" Caption="해석" Width="90" />

                </Columns>

                <RowActions Context="item">
                    <PermissionView Action="MenuAction.Update">
                        <DxButton IconCssClass="jsini-icon-edit" Title="수정"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => StartEditItem(item))" />
                    </PermissionView>
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                                  CssClass="commgrd__icon--warn"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => DeleteItemAsync(item))" />
                    </PermissionView>
                </RowActions>
            </CommGrd>
        }
        </ChildContent>
    </CommCont>
</div>

<CommPopup @bind-Visible="_editingModel" HeaderText="@(_model.Id == 0 ? "모델 등록" : "모델 수정")"
         Width="460px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout>
            <DxFormLayoutItem Caption="모델" ColSpanMd="12">
                <DxTextBox @bind-Text="_model.McName" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="시작 키" ColSpanMd="12">
                @* 전문 시작을 알아보는 바이트. 서버가 이 글자를 바이트로 바꾼다. *@
                <DxTextBox @bind-Text="_model.StartKey" />
            </DxFormLayoutItem>
        </DxFormLayout>

    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveModelAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _editingModel = false)" />
    </FooterContentTemplate>
</CommPopup>

<CommPopup @bind-Visible="_editingItem" HeaderText="@(_item.Id == 0 ? "규칙 추가" : "규칙 수정")"
         Width="560px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout>
            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxTextBox @bind-Text="_item.Desc" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="구분" ColSpanMd="6">
                <DxComboBox Data="@PTypes" @bind-Value="_item.PTYPE" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="키 위치" ColSpanMd="6">
                <DxSpinEdit Value="@(_item.KeyIdx ?? 0)"
                            ValueChanged="@((int v) => _item.KeyIdx = v)" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="키" ColSpanMd="12">
                @* 콤마로 적는다. 서버가 바이트 목록으로 바꾼다. *@
                <DxTextBox @bind-Text="_keys" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="블록 길이" ColSpanMd="6">
                <DxTextBox @bind-Text="_item.BlocParseLength" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="해석 방식" ColSpanMd="6">
                <DxComboBox Data="@ParseTypes" @bind-Value="_item.BlocParseType" />
            </DxFormLayoutItem>
        </DxFormLayout>

    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveItemAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _editingItem = false)" />
    </FooterContentTemplate>
</CommPopup>
