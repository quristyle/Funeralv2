@page "/helpdesk/contact-us"
@using JSini.Web.HelpDesk.Api

@*
    [문의하기]

    이력: Vue `views/helpdesk/contact-us.vue` → 여기.
    고객 및 사용자의 서비스 문의 및 접수를 작성한다.
*@

@inject HelpDeskApi Api

<PageTitle>문의하기 · 헬프데스크</PageTitle>

<PageHeading Title="문의하기" Scope="헬프데스크" />

<div class="hd-form">
    <h2 class="hd-form__title">✉️ 고객센터 / 헬프데스크 문의 접수</h2>

    <div class="hd-form__field">
        <label class="hd-form__label">문의 제목</label>
        <DxTextBox @bind-Text="_title" NullText="문의 제목을 입력하세요" Style="width: 100%" />
    </div>

    <div class="hd-form__field">
        <label class="hd-form__label">문의 유형</label>
        <DxComboBox Data="@_types"
                    Value="@_selectedType"
                    ValueChanged="@((string val) => _selectedType = val)"
                    Style="width: 100%" />
    </div>

    <div class="hd-form__field">
        <label class="hd-form__label">문의 상세 내용</label>
        <DxMemo @bind-Text="_content" NullText="상세 문의 내용을 작성해 주세요..." Rows="8" Style="width: 100%" />
    </div>

    <div class="hd-form__actions">
        @* 「취소」가 아무 일도 안 하고 있었다. 적던 것을 비우는 단추다 —
           나가는 것이 아니라 처음부터 다시 쓰는 자리라 그렇다. *@
        <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary" Click="@Reset" />
        <DxButton Text="문의 접수" RenderStyle="ButtonRenderStyle.Primary" Click="@SubmitAsync" Enabled="@(!string.IsNullOrWhiteSpace(_title))" />
    </div>
</div>

@code {
    private string? _title;
    private string _selectedType = "시스템 장애";
    private string? _content;
    private readonly List<string> _types = ["시스템 장애", "기능 개선", "계정/권한", "기타"];

    /// <summary>적던 것을 비운다. 종류는 기본값으로 돌린다.</summary>
    private void Reset()
    {
        _title = null;
        _content = null;
        _selectedType = _types[0];
    }

    private Task SubmitAsync()
    {
        _title = string.Empty;
        _content = string.Empty;
        return Task.CompletedTask;
    }
}
