@page "/helpdesk/report/io-deep-dive"

@*
    [IO 심층 분석] — DB 메뉴 `/helpdesk/report/io-deep-dive`.
    이력: Vue `views/helpdesk/report/io-deep-dive` → 여기.
    엔드포인트: `requests/report/emergency`

    **서버가 준 대로 보여 주는 화면이다**(AutoGrid). 칸을 손으로 적지 않은
    이유는 그 부품의 주석에 있다 — 요약하면, 이런 화면이 마흔 개고 백엔드가
    칸을 더할 때마다 화면을 고치러 가는 것이 이득이 아니기 때문이다.

    매일 들여다보는 화면이 되면 그때 칸을 손으로 적는다.

    [보고서는 서버가 집계한 것을 그대로 본다]

    화면에서 다시 세지 않는다. 세면 같은 숫자를 두 곳에서 계산하게 되고,
    반드시 어긋난다 — 기간 경계를 어떻게 잡느냐가 늘 다르기 때문이다.

    [차트 — D3 결정 반영]

    옛 화면은 한주 OADR 의 3시간 I/O 지연 추이를 선 넉 줄(echarts)로 그리던
    화면이라 D3 결정 대상이다. 다만 이관하면서 자료가 **진행 중인 긴급 건
    목록**(id·title·status·time)으로 바뀌었고, 시계열이 아니라서 옛 종류(선)
    를 그릴 수 없다 — 상태별 <b>막대</b>로 대신한다. 재료는 표와 같은
    응답이고 따로 부르지 않는다. 이름표에 있던 `companyName`·`count`·
    `avgHours` 는 서버가 주지 않는 칸이라 실제 응답 칸으로 바로잡았다.
*@

@inherits DataPage
@inject HelpDeskApi Api

<PageTitle>IO 심층 분석 · 헬프데스크</PageTitle>

<PageHeading Title="IO 심층 분석" Scope="헬프데스크" />

<PageNotice Text="@Notice" Tone="@Tone" />

@if (_bars.Count > 0)
{
    <div class="hd-charts">
        <div class="hd-chart">
            <h3 class="hd-chart__title">진행 중 긴급 건 (상태별)</h3>
            <DxChart Data="@_bars" Palette="@BarPalette" Width="100%" Height="260px">
                <DxChartBarSeries T="StatusBar" TArgument="string" TValue="int"
                                  ArgumentField="b => b.Label" ValueField="b => b.Count"
                                  Name="긴급 건수" />
                <DxChartLegend Visible="false" />
                <DxChartTooltip Enabled="true">
                    <div class="jsini-tip">@context.Point.Argument · @(context.Point.Value)건</div>
                </DxChartTooltip>
            </DxChart>
        </div>
    </div>
}

<AutoGrid Data="@_rows" Loading="@Loading" Captions="@Captions" HiddenCols="id" PageSize="30" />

@code {
    private DataTable _rows = JsonTable.Empty;

    /// <summary>칸 이름표. 칸 이름은 서버 `report/emergency` 응답과 대조했다 — 머리 주석 참고.</summary>
    private static readonly Dictionary<string, string> Captions = new(StringComparer.Ordinal)
    {
        ["title"] = "제목",
        ["status"] = "상태",
        ["time"] = "접수 시각",
        ["severity"] = "심각도",
    };

    // ── 차트 재료 ───────────────────────────────────────────

    private sealed record StatusBar(string Label, int Count);

    /// <summary>긴급 건이라 옛 화면의 경고 팔레트 첫 색(붉은색)을 쓴다.</summary>
    private static readonly string[] BarPalette = ["#EF4444"];

    private IReadOnlyList<StatusBar> _bars = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        // 긴급 건 보고서. `dashboard` 가 아니라 `requests` 묶음 밑이다.
        // 이것만 기간 인자가 없다.
        var json = await Api.GetAsync<JsonElement>("requests/report/emergency");
        _rows = JsonTable.From(json);
        _bars = ToBars(_rows);
        return _rows.Rows.Count;
    }, "진행 중인 긴급 건이 없습니다.", "IO 심층 분석을 읽지 못했습니다");

    /// <summary>
    /// 표와 같은 응답을 상태별로 센다. 완료·종료는 서버가 이미 걸러서 안 온다.
    /// 칸이 없으면 차트만 조용히 빠지고 표는 남는다.
    /// </summary>
    private static IReadOnlyList<StatusBar> ToBars(DataTable rows)
    {
        if (!rows.Columns.Contains("status"))
        {
            return [];
        }

        return [.. rows.Rows.Cast<DataRow>()
            .GroupBy(r => StatusText(r["status"] as string))
            .Select(g => new StatusBar(g.Key, g.Count()))];
    }

    /// <summary>서버는 enum 이름(`Pending`)을 준다. 다른 화면들과 같은 한글 이름으로.</summary>
    private static string StatusText(string? status) => status switch
    {
        "Pending" => "대기",
        "InProgress" => "진행",
        "Consultation" => "협의",
        "Negotiation" => "논의",
        "Rejected" => "반려",
        _ => status ?? "-",
    };
}
