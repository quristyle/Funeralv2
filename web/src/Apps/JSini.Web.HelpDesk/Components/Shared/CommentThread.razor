@*
    댓글 한 뭉치 — 자기를 다시 부른다(답글의 답글에 깊이 제한이 없다). 들여쓰는 폭은 helpdesk.css 의 --hd-cmt-indent 가 상한이다.
    지워진 댓글(IsDel)은 줄째 빼지 않는다. 빼면 그 아래 답글이 부모를 잃고 뿌리로 튄다.
    답글 칸을 한 번에 하나만 여는 것은 RequestDetail 이 맡는다.
*@

<ul class="hd-cmts">
    @foreach (var node in Nodes)
    {
        <li class="hd-cmt" id="@($"comment-{node.Comment.Id}")">
            <div class="hd-cmt__head">
                @* 사진의 정본은 포털 계정이다. 업무 DB 의 사진 칸은 비어 있는 것이 보통이라 로그인 아이디로 얼굴을 묻는다. *@
                <UserAvatar LoginId="@node.Comment.CreatedBy"
                            Name="@AuthorName(node)"
                            CssClass="hd-cmt__avatar" />
                <span class="hd-cmt__when">@When(node)</span>

                @if (node.Children.Count > 0)
                {
                    <span class="hd-cmt__count">답글 @(node.Total - 1)</span>
                }
            </div>

            @if (node.Comment.IsDel)
            {
                <div class="hd-cmt__body hd-cmt__body--gone">삭제된 댓글입니다.</div>
            }
            else
            {
                @* 본문은 HTML 이다. 글자로 뭉개면 증상 그림이 안 보인다. 거르는 규칙은 요청 본문과 같은 한 벌(NoticeHtml)을 쓴다. *@
                <div class="hd-cmt__body hd-content">@Body(node)</div>

                @if (node.Comment.Attachments is { Count: > 0 } attachments)
                {
                    <ul class="hd-cmt__files">
                        @foreach (var file in attachments)
                        {
                            <li>
                                <a class="hd-cmt__file"
                                   href="@FileUrl(file)"
                                   target="_blank"
                                   download="@file.OriginalFileName">
                                    <span class="jsini-icon-paperclip" aria-hidden="true"></span>
                                    <span class="hd-cmt__file-name">@file.OriginalFileName</span>
                                    @if (file.FileSize is > 0)
                                    {
                                        <span class="hd-cmt__file-size">(@Human(file.FileSize.Value))</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
            }

            @if (!node.Comment.IsDel && (CanReply || CanDelete(node)))
            {
                <div class="hd-cmt__acts">
                    @if (CanReply)
                    {
                        <DxButton IconCssClass="jsini-icon-comment-plus"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="hd-cmt__act"
                                  Title="@(IsOpen(node) ? "답글 접기" : "댓글")"
                                  aria-label="@(IsOpen(node) ? "답글 접기" : "댓글")"
                                  Click="@(() => ToggleAsync(node))" />
                    }
                    @if (CanDelete(node))
                    {
                        <DxButton IconCssClass="jsini-icon-close"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="hd-cmt__act hd-cmt__act--del"
                                  Title="삭제"
                                  aria-label="삭제"
                                  Click="@(() => DeleteAsync(node))" />
                    }
                </div>
            }

            @if (IsOpen(node))
            {
                <div class="hd-cmt__write">
                    <CommentEditor Id="@($"r{node.Comment.Id}")"
                                   SubmitText="답글 남기기"
                                   OnSubmit="@((html, files) => Submit(node.Comment.Id, html, files))"
                                   OnCancel="@(() => OnToggle.InvokeAsync(null))" />
                </div>
            }

            @if (node.Children.Count > 0)
            {
                <div class="hd-cmt__kids">
                    <CommentThread Nodes="@node.Children"
                                   CanReply="@CanReply"
                                   CanDeleteComment="@CanDeleteComment"
                                   ReplyTo="@ReplyTo"
                                   CurrentUserId="@CurrentUserId"
                                   CurrentUserType="@CurrentUserType"
                                   OnToggle="@OnToggle"
                                   OnReply="@OnReply"
                                   OnDelete="@OnDelete" />
                </div>
            }
        </li>
    }
</ul>
