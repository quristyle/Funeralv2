@* 자료(영상·음원·장식·배경) 목록 한 벌. 자료는 media_sources 한 표이고 SourceType 으로 갈린다. 화면을 넷으로 나눈 것은 업무가 달라서다(영상은 빈소, 음원은 건물, 배경·장식은 장비 속성).
올리기는 두 단계다. 파일을 FileServer 에 올려 식별자와 주소를 받고 그것을 source 에 매단다. 자료 표는 바이트를 갖지 않고 주소만 갖는다. 재처리 단추는 파생물이 있는 화면이 넘긴다. *@

@inherits DataPage

@* 올리기 자리. 권한이 없으면 통째로 감춘다. *@
<PermissionView Action="MenuAction.Create">
    <div class="fn-upload">
        <FilePicker @ref="_picker"
                    MaxFiles="1"
                    MaxBytes="@MaxBytes"
                    Accept="@Accept"
                    ShowHint="false"
                    FilesChanged="@OnPickedAsync" />

        @if (_picked is not null)
        {
            <div class="jsini-toolbar">
                <DxTextBox @bind-Text="_uploadName" NullText="목록에 보일 이름" Style="width: 260px" />
                <DxButton Text="@(_uploading ? "올리는 중…" : "올리기")"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Enabled="@(!_uploading)"
                          Click="@UploadAsync" />
            </div>
        }
    </div>
</PermissionView>

<CommGrd TItem="MediaSource"
         Data="@Shown"
         EditFormTitle="@Title"
         ExportName="@Title"
         PageSize="20"
         OnSave="@SaveAsync"
         OnDelete="@DeleteAsync"
         Reload="@ReloadAsync">
    @* 재생·보기는 변환본을 먼저 본다(HasWebm). 재처리는 단추 수만큼 생긴다. *@
    <RowActions Context="m">
        <DxButton Text="재생" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => Preview(m))" />
        @foreach (var (kind, label) in Retries)
        {
            <PermissionView Action="MenuAction.Update">
                <DxButton Text="@label" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => RetryAsync(m.Id, kind))" />
            </PermissionView>
        }
    </RowActions>
    <Toolbar>
        <DxTextBox @bind-Text="_keyword" NullText="이름 검색" Style="width: 220px"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    </Toolbar>

    <Columns>
        @if (ShowThumbnail)
        {
            <DxGridDataColumn Caption="" Width="80" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (MediaSource)cell.DataItem;
                    }
                    @if (m.ThumbnailUrl is { Length: > 0 } thumb)
                    {
                        <img class="fn-thumb" src="@FileDownload.RelayUrl(thumb)" alt="" loading="lazy" />
                    }
                    else
                    {
                        @* 미리보기가 아직 없는 것과 만들다 실패한 것이 같아 보인다. 재처리는 「관리」 메뉴에 있다. *@
                        <span class="fn-thumb fn-thumb--none">없음</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }

        <DxGridDataColumn FieldName="@nameof(MediaSource.Name)" Caption="이름" MinWidth="200" />
        <DxGridDataColumn FieldName="@nameof(MediaSource.ShortName)" Caption="약칭" Width="120" />

        <DxGridDataColumn Caption="크기" Width="100">
            <CellDisplayTemplate Context="cell">
                @FormatSize(((MediaSource)cell.DataItem).FileSize)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 변환 상태. 없으면 왜 안 나오는지 알 길이 없어, 실패한 것은 마우스를 올리면 서버 오류와 실행 명령이 나온다. *@
        <DxGridDataColumn Caption="변환" Width="100">
            <CellDisplayTemplate Context="cell">
                @{
                    var m = (MediaSource)cell.DataItem;
                }
                <span class="jsini-badge @StatusClass(m.Status)" title="@StatusDetail(m)">
                    @StatusLabel(m.Status)
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(MediaSource.SortOrder)" Caption="정렬" Width="80" />
        <DxGridDataColumn FieldName="@nameof(MediaSource.Remark)" Caption="비고" MinWidth="150" />

    </Columns>

    <EditFormTemplate Context="edit">
        @{
            var m = (MediaSource)edit.EditModel;
        }
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="이름" ColSpanMd="8">
                <DxTextBox @bind-Text="m.Name" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="정렬" ColSpanMd="4">
                <DxSpinEdit @bind-Value="m.SortOrder" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="약칭" ColSpanMd="12">
                @* 빈소 화면처럼 자리가 좁은 곳이 이 값을 쓴다. *@
                <DxTextBox @bind-Text="m.ShortName" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxMemo @bind-Text="m.Remark" Rows="3" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="파일" ColSpanMd="12">
                @* 파일 자체는 바꿀 수 없다. 무엇이 매달려 있는지만 보여 준다. *@
                <DxTextBox Text="@m.Url" ReadOnly="true" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditFormTemplate>
</CommGrd>

@* 재생 창. 브라우저에게 변환본을 먼저 준다. 원본이 그대로 안 열리는 형식이라 서버가 변환본을 만들어 둔다. 주소는 셸 중계 경로로 옮긴다(저장된 값은 /api/file 이라 포털에서 404). *@
<CommPopup @bind-Visible="_previewing" HeaderText="@(_preview?.Name ?? "재생")"
           Width="720px" ShowFooter="false" CloseOnOutsideClick="true">
    <BodyContentTemplate>
        @if (_preview is not null)
        {
            var url = FileDownload.RelayUrl(PlayUrl(_preview));

            @if (string.Equals(SourceType, "AUDIO", StringComparison.Ordinal))
            {
                <audio class="fn-preview__player" src="@url" controls autoplay></audio>
            }
            else if (string.Equals(SourceType, "VIDEO", StringComparison.Ordinal))
            {
                @* preload 를 none 으로 두지 않는다. 창을 열자마자 트는 자리라 미리 받는 편이 빠르다. *@
                <video class="fn-preview__player" src="@url" controls autoplay></video>
            }
            else
            {
                <img class="fn-preview__player" src="@url" alt="@_preview.Name" />
            }

            <div class="jsini-hint">
                @if (_preview.HasWebm)
                {
                    <text>변환본(H.264)을 틉니다. </text>
                }
                @_preview.Url
            </div>
        }

        <div class="jsini-toolbar">
            <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => _previewing = false)" />
        </div>
    </BodyContentTemplate>
</CommPopup>
