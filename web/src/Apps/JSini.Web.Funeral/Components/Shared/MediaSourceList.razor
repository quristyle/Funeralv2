@*
    자료(영상·음원·장식·배경) 목록 한 벌.

    [화면 넷이 같은 표를 본다]

    자료는 한 표(`media_sources`)에 있고 `SourceType` 으로 갈린다. 화면을 넷으로
    나눈 것은 **업무가 다르기 때문**이다 — 영상은 빈소에 틀고, 음원은 건물에
    배정하고, 배경·장식은 장비 속성에 붙는다.

    그래도 「목록을 보고 이름·정렬을 고치고 지우는」 부분은 넷이 똑같다.
    손으로 네 번 적으면 반드시 갈라지고, 갈라지는 곳은 늘 권한 판정과 실패
    처리다. 그래서 여기로 모았다.

    [올리기 — D5]

    자료를 새로 만드는 것은 **두 단계**다. 파일을 FileServer 에 올려
    (`file/upload`) 식별자와 주소를 받고, 그것을 `source` 에 매단다.
    한 단계로 합칠 수 없다 — 자료 표는 파일 바이트를 갖지 않고 주소만 갖는다.

    두 단계라 **중간에서 끊길 수 있다.** 파일은 올라갔는데 자료를 못 만들면
    FileServer 에 주인 없는 파일이 남는다. 그래서 그 경우를 「등록하지
    못했습니다」로 뭉뚱그리지 않고, 파일은 올라갔다는 것까지 말한다.

    [재처리는 화면마다 다르다]

    영상은 미리보기 그림과 webm 을, 음원은 변환본을 다시 만든다. 장식·배경은
    파생물이 없어 재처리가 없다. 그래서 그 단추는 부르는 쪽이 넘긴다.
*@

@inherits DataPage

@inject FuneralApi Api
@inject FileUploadClient Files

@* 올리기 자리 (D5). 표 위에 둔다 — 「무엇이 있는지」보다 「새로 올리는 것」이
   이 화면에 오는 더 흔한 이유다. 권한이 없으면 통째로 감춘다. *@
<PermissionView Action="MenuAction.Create">
    <div class="fn-upload">
        <FilePicker @ref="_picker"
                    MaxFiles="1"
                    MaxBytes="@MaxBytes"
                    Accept="@Accept"
                    Hint="@($"{Title} 파일을 고르세요 (한 개 · {MaxBytes / 1024 / 1024}MB 까지)")"
                    FilesChanged="@OnPickedAsync" />

        @if (_picked is not null)
        {
            <div class="jsini-toolbar">
                <DxTextBox @bind-Text="_uploadName" NullText="목록에 보일 이름" Style="width: 260px" />
                <DxButton Text="@(_uploading ? "올리는 중…" : "올리기")"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Enabled="@(!_uploading)"
                          Click="@UploadAsync" />
            </div>
        }
    </div>
</PermissionView>

<CrudGrid TItem="MediaSource"
          Data="@Shown"
          EditFormTitle="@Title"
          ExportName="@Title"
          PageSize="20"
          OnSave="@SaveAsync"
          OnDelete="@DeleteAsync"
          Reload="@ReloadAsync">
    <ChildContent>
        <DxTextBox @bind-Text="_keyword" NullText="이름 검색" Style="width: 220px"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    </ChildContent>

    <Columns>
        @if (ShowThumbnail)
        {
            <DxGridDataColumn Caption="" Width="80" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (MediaSource)cell.DataItem;
                    }
                    @if (m.ThumbnailUrl is { Length: > 0 } thumb)
                    {
                        <img class="fn-thumb" src="@thumb" alt="" loading="lazy" />
                    }
                    else
                    {
                        @* 미리보기가 아직 안 만들어진 것과 만들다 실패한 것이
                           같아 보인다. 재처리 단추가 그 자리에 있다. *@
                        <span class="fn-thumb fn-thumb--none">없음</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }

        <DxGridDataColumn FieldName="@nameof(MediaSource.Name)" Caption="이름" MinWidth="200" />
        <DxGridDataColumn FieldName="@nameof(MediaSource.ShortName)" Caption="약칭" Width="120" />

        <DxGridDataColumn Caption="크기" Width="100">
            <CellDisplayTemplate Context="cell">
                @FormatSize(((MediaSource)cell.DataItem).FileSize)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(MediaSource.SortOrder)" Caption="정렬" Width="80" />
        <DxGridDataColumn FieldName="@nameof(MediaSource.Remark)" Caption="비고" MinWidth="150" />

        @if (Retries.Count > 0)
        {
            @* 단추 수만큼 폭을 준다. `Width` 는 CSS 길이라 숫자만 주면 안 된다. *@
            <DxGridDataColumn Caption="재처리" Width="@($"{60 + (Retries.Count * 60)}px")" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (MediaSource)cell.DataItem;
                    }
                    <div class="jsini-actions">
                        @foreach (var (kind, label) in Retries)
                        {
                            <PermissionView Action="MenuAction.Update">
                                <DxButton Text="@label"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          Click="@(() => RetryAsync(m.Id, kind))" />
                            </PermissionView>
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }
    </Columns>

    <EditForm Context="edit">
        @{
            var m = (MediaSource)edit.EditModel;
        }
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="이름" ColSpanMd="8">
                <DxTextBox @bind-Text="m.Name" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="정렬" ColSpanMd="4">
                <DxSpinEdit @bind-Value="m.SortOrder" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="약칭" ColSpanMd="12">
                @* 빈소 화면처럼 자리가 좁은 곳이 이 값을 쓴다. *@
                <DxTextBox @bind-Text="m.ShortName" NullText="좁은 화면에 쓰는 짧은 이름" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxMemo @bind-Text="m.Remark" Rows="3" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="파일" ColSpanMd="12">
                @* 파일 자체는 바꿀 수 없다(D5). 무엇이 매달려 있는지만 보여 준다 —
                   이름만 보고 「어느 파일이었지」를 알 수 없어서다. *@
                <DxTextBox Text="@m.Url" ReadOnly="true" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditForm>
</CrudGrid>

@code {
    /// <summary>이 화면이 다루는 자료 종류. 서버가 이 값으로 걸러 준다.</summary>
    [Parameter, EditorRequired] public string SourceType { get; set; } = string.Empty;

    /// <summary>편집 창과 엑셀 파일에 쓸 이름.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>미리보기 그림 칸을 보여 줄지. 영상만 참이다.</summary>
    [Parameter] public bool ShowThumbnail { get; set; }

    /// <summary>
    /// 재처리 단추들. <c>(종류, 이름)</c>.
    ///
    /// 종류는 <c>thumbnail</c> · <c>webm</c> · <c>audio</c> 셋이다.
    /// 파생물이 없는 자료(장식·배경)는 비워 둔다.
    /// </summary>
    [Parameter] public IReadOnlyList<(string Kind, string Label)> Retries { get; set; } = [];

    /// <summary>
    /// 파일 고르기 창의 <c>accept</c>. 화면마다 다르다 — 영상 자리에 mp3 를
    /// 고르면 목록에는 뜨는데 플레이어가 못 튼다.
    /// </summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>
    /// 한 개 최대 크기(바이트). 영상은 크고 장식 그림은 작다.
    /// 기본 300MB 는 영상 기준이다.
    /// </summary>
    [Parameter] public long MaxBytes { get; set; } = 300L * 1024 * 1024;

    private IReadOnlyList<MediaSource> _all = [];
    private string? _keyword;

    // ── 올리기 (D5) ─────────────────────────────────────────

    private FilePicker? _picker;
    private PickedFile? _picked;
    private string? _uploadName;
    private bool _uploading;

    private IReadOnlyList<MediaSource> Shown
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_keyword))
            {
                return _all;
            }

            var k = _keyword.Trim();
            return [.. _all.Where(m =>
                m.Name.Contains(k, StringComparison.OrdinalIgnoreCase)
                || (m.ShortName?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false))];
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetMediaSourcesAsync(SourceType);
        return _all.Count;
    }, "등록된 자료가 없습니다.", "목록을 읽지 못했습니다");

    /// <summary>
    /// 정보를 저장한다. <b>등록은 없다</b> — 파일을 올릴 길이 아직 없어서다.
    ///
    /// 종류를 다시 실어 보낸다. 안 실으면 서버가 빈 값으로 덮어써서 그 자료가
    /// 어느 화면에도 안 나오게 된다.
    /// </summary>
    private Task SaveAsync((MediaSource Item, bool IsNew) e)
    {
        e.Item.SourceType = SourceType;
        return Api.UpdateMediaSourceAsync(e.Item.Id, e.Item);
    }

    private Task DeleteAsync(MediaSource m) => Api.DeleteMediaSourceAsync(m.Id);

    // ── 올리기 (D5) ─────────────────────────────────────────

    /// <summary>
    /// 파일을 고르면 이름 칸을 파일 이름으로 미리 채운다.
    ///
    /// 확장자는 뗀다 — 목록에 보일 이름이지 파일 이름이 아니다.
    /// 사람이 고칠 수 있게 두되 <b>비워 두고 시작하지 않는다.</b> 비워 두면
    /// 이름을 안 적고 올려 목록이 「(이름 없음)」으로 채워진다.
    /// </summary>
    private void OnPickedAsync(IReadOnlyList<PickedFile> files)
    {
        _picked = files.Count > 0 ? files[0] : null;

        if (_picked is not null && string.IsNullOrWhiteSpace(_uploadName))
        {
            _uploadName = Path.GetFileNameWithoutExtension(_picked.Name);
        }
    }

    /// <summary>
    /// 파일을 올리고 자료로 매단다. <b>두 단계다</b> — 머리말 참고.
    /// </summary>
    private async Task UploadAsync()
    {
        if (_picked is null || _uploading)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_uploadName))
        {
            Say("목록에 보일 이름을 적어 주십시오.", NoticeTone.Warning);
            return;
        }

        _uploading = true;
        try
        {
            UploadedFile? uploaded = null;

            // ① 파일을 FileServer 로. 실패하면 여기서 끝난다 — 자료를 만들지 않는다.
            var sent = await RunAsync(async () =>
            {
                await using var stream = _picked.OpenRead();
                uploaded = await Files.UploadAsync(stream, _picked.Name, _picked.ContentType);
            }, string.Empty, "파일을 올리지 못했습니다");

            if (!sent || uploaded is null)
            {
                return;
            }

            // ② 자료로 매단다. 여기서 실패하면 **파일은 이미 올라가 있다.**
            //    그 사실을 말해 준다 — 「등록 실패」로만 알리면 같은 파일을
            //    몇 번이고 다시 올려 주인 없는 파일만 쌓인다.
            var linked = await RunAsync(
                () => Api.CreateMediaSourceAsync(new MediaSource
                {
                    Name = _uploadName!.Trim(),
                    SourceType = SourceType,
                    Url = uploaded.BestUrl ?? string.Empty,
                    OriginalFileId = uploaded.FileId ?? uploaded.Id,
                    ThumbnailUrl = uploaded.ThumbnailUrl,
                    ThumbnailFileId = uploaded.ThumbnailFileId,
                    FileSize = uploaded.FileSize ?? _picked.Size,
                }),
                string.Empty,
                "파일은 올라갔지만 목록에 매달지 못했습니다");

            if (!linked)
            {
                return;
            }

            _picked = null;
            _uploadName = null;
            if (_picker is not null)
            {
                await _picker.ClearAsync();
            }

            // **다시 읽는 것이 먼저다.** ReloadAsync 가 시작할 때 안내 줄을
            // 비우므로, 성공 문구를 먼저 적으면 그 자리에서 지워진다.
            await ReloadAsync();
            Say($"{Title} 을(를) 올렸습니다. 변환은 잠시 뒤 끝납니다.");
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>바이트를 사람이 읽는 단위로. 1MB 미만은 KB 로 둔다.</summary>
    private static string FormatSize(long? bytes)
    {
        if (bytes is null or 0)
        {
            return "-";
        }

        var mb = bytes.Value / 1024d / 1024d;
        return mb >= 1 ? $"{mb:0.0} MB" : $"{Math.Round(bytes.Value / 1024d)} KB";
    }

    /// <summary>
    /// 변환 재처리.
    ///
    /// 성공하면 목록을 다시 읽는다 — 변환은 비동기라 지금 당장 바뀌지는 않지만,
    /// 무언가 반응이 있어야 두 번 누르지 않는다.
    /// </summary>
    private async Task RetryAsync(string id, string kind)
    {
        var run = kind switch
        {
            "thumbnail" => Api.RetryThumbnailAsync(id),
            "webm" => Api.RetryWebmAsync(id),
            _ => Api.RetryAudioAsync(id),
        };

        if (await RunAsync(() => run, "재처리를 걸었습니다. 잠시 뒤 반영됩니다.", "재처리를 걸지 못했습니다"))
        {
            await ReloadAsync();
        }
    }
}
