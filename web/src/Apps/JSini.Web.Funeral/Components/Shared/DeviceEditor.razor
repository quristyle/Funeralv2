@*
    [기기 등록 · 수정]

    빈소마다 놓인 디스플레이·플레이어를 등록한다.

    [등록도 수정도 삭제도 없었다]

    「기기 관리」 화면에는 목록과 원격 명령뿐이었다. 클라이언트에는 넷 다
    있었고(`Create` · `Update` · `Delete` · `GetDevice`) 부르는 곳만 없었다.
    기기를 새로 놓거나 다른 호실로 옮기는 일을 포털에서 할 수 없었다.

    [코드는 등록할 때만 받는다]

    원격 명령이 이 값을 열쇠로 쓴다(`SetDeviceScreenPowerAsync(code, …)`).
    바꾸면 그 기기에 가던 명령이 아무 데도 닿지 않는데, 화면에는 성공으로
    보인다 — 명령은 보내는 데까지만 확인하기 때문이다. 그래서 수정에서는 잠근다.

    [건물 → 층 → 호실은 차례로 좁힌다]

    위를 바꾸면 아래 선택을 푼다. 안 그러면 다른 건물의 호실이 남아 엉뚱한
    자리에 기기가 붙는다 — 저장은 되고, 현황판에서만 이상해 보인다.
*@

@inherits DataPage
@inject FuneralApi Api

<DxPopup Visible="@Visible" VisibleChanged="@OnVisibleChanged"
         HeaderText="@(IsNew ? "기기 등록" : "기기 수정")" Width="720px" ShowFooter="false">
    <BodyContentTemplate Context="popup">
        <PageNotice Text="@Notice" Tone="@Tone" />

        @if (_form is null)
        {
            <p class="fn-note">읽는 중입니다 …</p>
        }
        else
        {
            <div class="fn-devsec__body">
                <DeviceField Label="기기명">
                    <DxTextBox @bind-Text="_form.Name" />
                </DeviceField>
                <DeviceField Label="약칭">
                    <DxTextBox @bind-Text="_form.ShortName" />
                </DeviceField>

                <DeviceField Label="코드">
                    @if (IsNew)
                    {
                        <DxTextBox @bind-Text="_form.Code" NullText="예: JSI-06-0005" />
                    }
                    else
                    {
                        @* 원격 명령이 이 값을 열쇠로 쓴다. 바꾸면 명령이
                           아무 데도 닿지 않는데 화면에는 성공으로 보인다. *@
                        <span class="fn-note">@_form.Code — 원격 명령의 열쇠라 바꾸지 않습니다.</span>
                    }
                </DeviceField>

                <DeviceField Label="종류">
                    <DxComboBox Data="@Types" TextFieldName="Name" ValueFieldName="Code"
                                @bind-Value="_form.DeviceType" />
                </DeviceField>

                <DeviceField Label="건물">
                    <DxComboBox Data="@_buildings" TextFieldName="@nameof(Building.Name)"
                                ValueFieldName="@nameof(Building.Id)"
                                Value="@_form.BuildingId"
                                ValueChanged="@((string? v) => PickBuildingAsync(v))"
                                NullText="고르십시오"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DeviceField>

                <DeviceField Label="층">
                    <DxComboBox Data="@_floors" TextFieldName="@nameof(Floor.Name)"
                                ValueFieldName="@nameof(Floor.Id)"
                                Value="@_form.FloorId"
                                ValueChanged="@((string? v) => PickFloorAsync(v))"
                                NullText="고르십시오"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DeviceField>

                <DeviceField Label="호실">
                    <DxComboBox Data="@_rooms" TextFieldName="@nameof(Room.Name)"
                                ValueFieldName="@nameof(Room.Id)"
                                @bind-Value="_form.RoomId" NullText="호실에 안 붙는 기기"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DeviceField>

                <DeviceField Label="IP">
                    <DxTextBox @bind-Text="_form.IpAddress" />
                </DeviceField>
                <DeviceField Label="MAC">
                    <DxTextBox @bind-Text="_form.MacAddress" />
                </DeviceField>
                <DeviceField Label="순서">
                    <DxSpinEdit @bind-Value="_form.SortOrder" MinValue="0" />
                </DeviceField>
            </div>

            <div class="jsini-toolbar">
                <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveAsync" />
                <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => OnVisibleChanged(false))" />
            </div>
        }
    </BodyContentTemplate>
</DxPopup>

@code {
    private sealed record Option(string Code, string Name);

    private static readonly Option[] Types =
    [
        new("FUNERAL_PORTRAIT", "영정사진"),
        new("MULTIMEDIA", "멀티미디어"),
        new("ROOM_GUIDE", "층별 안내"),
        new("ENTRANCE_GUIDE", "입구 안내"),
        new("KIOSK", "키오스크"),
        new("DID", "DID"),
    ];

    [Parameter] public bool Visible { get; set; }

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>고칠 기기. <c>null</c> 이면 새로 등록한다.</summary>
    [Parameter] public string? DeviceId { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private Device? _form;
    private string? _loadedFor;

    private IReadOnlyList<Building> _buildings = [];
    private IReadOnlyList<Floor> _floors = [];
    private IReadOnlyList<Room> _rooms = [];

    private bool IsNew => string.IsNullOrEmpty(DeviceId);

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible)
        {
            _loadedFor = null;
            return;
        }

        var key = DeviceId ?? "(new)";
        if (string.Equals(_loadedFor, key, StringComparison.Ordinal))
        {
            return;
        }

        _loadedFor = key;
        await OpenAsync();
    }

    private Task OpenAsync() => LoadAsync(async () =>
    {
        if (_buildings.Count == 0)
        {
            _buildings = await Api.GetBuildingsAsync();
        }

        _form = IsNew
            ? new Device { DeviceType = "FUNERAL_PORTRAIT" }
            : await Api.GetDeviceAsync(DeviceId!) ?? new Device { Id = DeviceId! };

        // 고른 기기가 이미 붙어 있는 자리에 맞춰 아래 목록을 채운다.
        await LoadFloorsAsync(_form.BuildingId);
        await LoadRoomsAsync(_form.BuildingId, _form.FloorId);

        return 1;
    }, string.Empty, "기기 자료를 읽지 못했습니다");

    private async Task LoadFloorsAsync(string? buildingId)
    {
        _floors = string.IsNullOrEmpty(buildingId)
            ? []
            : await Api.GetFloorsAsync(buildingId);
    }

    private async Task LoadRoomsAsync(string? buildingId, string? floorId)
    {
        // **이름을 붙여 넘긴다.** 첫 인자가 `companyId` 라, 자리로 넘기면
        // 건물이 회사 자리에 들어가 목록이 통째로 빈다.
        _rooms = string.IsNullOrEmpty(buildingId)
            ? []
            : await Api.GetRoomsAsync(buildingId: buildingId, floorId: floorId);
    }

    private async Task PickBuildingAsync(string? buildingId)
    {
        _form!.BuildingId = buildingId;

        // 위를 바꾸면 아래를 푼다. 남겨 두면 다른 건물의 층·호실에 기기가
        // 붙고, 저장은 되며 현황판에서만 이상해 보인다.
        _form.FloorId = null;
        _form.RoomId = null;

        await LoadFloorsAsync(buildingId);
        await LoadRoomsAsync(buildingId, null);
    }

    private async Task PickFloorAsync(string? floorId)
    {
        _form!.FloorId = floorId;
        _form.RoomId = null;

        await LoadRoomsAsync(_form.BuildingId, floorId);
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            Say("기기명을 넣으십시오.", NoticeTone.Warning);
            return;
        }

        if (IsNew && string.IsNullOrWhiteSpace(_form.Code))
        {
            Say("코드를 넣으십시오. 원격 명령이 이 값을 씁니다.", NoticeTone.Warning);
            return;
        }

        var saved = await RunAsync(
            () => IsNew
                ? Api.CreateDeviceAsync(_form)
                : Api.UpdateDeviceAsync(DeviceId!, _form),
            IsNew ? "등록했습니다." : "저장했습니다.",
            IsNew ? "등록하지 못했습니다" : "저장하지 못했습니다");

        if (saved)
        {
            await OnVisibleChanged(false);
            await OnSaved.InvokeAsync();
        }
    }

    private async Task OnVisibleChanged(bool visible)
    {
        Visible = visible;

        if (!visible)
        {
            _form = null;
            _loadedFor = null;
        }

        await VisibleChanged.InvokeAsync(visible);
    }
}
