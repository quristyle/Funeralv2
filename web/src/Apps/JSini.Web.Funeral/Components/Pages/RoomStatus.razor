@page "/funeral/room-status"
@attribute [RouteKey("funeral.room-status")]

@* [빈소현황] — DB 메뉴 `/room_status`. 호실·고인·장비를 서버가 room-board 한 번에 준다. 화면이 따로 조인하면 짝이 어긋난다.
상황판으로 띄워 두므로 방송과 폴링으로 스스로 갱신하고, 갱신은 안내 줄을 건드리지 않고 조용히 읽는다. 고치기는 여기서 하지 않고 해당 화면으로 가는 길만 건다. 빈 호실의 출상 취소만 여기서 되돌린다. *@

@inherits DataPage
@implements IDisposable

<PageTitle>빈소현황 · 장례식장</PageTitle>

<BuildingFilter @bind-BuildingId="_buildingId" @bind-FloorId="_floorId" ShowFloor="true" Search="@ReloadAsync" SummaryExtra="@ConditionSummary">
    <ChildContent>
        <CommSchItem Label="고인명">
            <DxTextBox @bind-Text="_name" Style="width: 140px"
                       BindValueMode="BindValueMode.OnInput"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem>
            <DxCheckBox @bind-Checked="_onlyInUse">사용 중만</DxCheckBox>
        </CommSchItem>

        <CommSchItem>
            <DxCheckBox @bind-Checked="_onlyAlert">장비 이상만</DxCheckBox>
        </CommSchItem>

        @* 기간 둘은 접는다. 조건줄이 두 줄이 되는 것이 아깝고, 펼쳐도 같은 판 안에 들어온다. *@
        @if (_showDates)
        {
            <CommSchItem Label="입관">
                <DxDateEdit @bind-Date="_coffinFrom"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <DxDateEdit @bind-Date="_coffinTo"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </CommSchItem>

            <CommSchItem Label="발인">
                <DxDateEdit @bind-Date="_burialFrom"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <DxDateEdit @bind-Date="_burialTo"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </CommSchItem>
        }
    </ChildContent>

    <Actions>
        <DxButton Text="새로 고침" RenderStyle="ButtonRenderStyle.Primary"
                  IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />

        <DxButton Text="@(_showDates ? "기간 접기" : "기간 조건")"
                  RenderStyle="ButtonRenderStyle.Link" Click="@(() => _showDates = !_showDates)" />

        @if (_showDates)
        {
            <DxButton Text="기간 지우기" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-undo" Click="@ClearDatesAsync" />
        }
    </Actions>
</BuildingFilter>

@if (_board is not null)
{
    <section class="fn-status-summary" aria-label="빈소 현황 요약">
        <div class="jsini-stats">
            <div class="jsini-stat">
                <div class="jsini-stat__label"><span class="jsini-icon-home" aria-hidden="true"></span>전체 호실</div>
                <div class="jsini-stat__value">@_board.Summary.TotalRooms</div>
            </div>
            <div class="jsini-stat fn-stat--active">
                <div class="jsini-stat__label"><span class="jsini-icon-user" aria-hidden="true"></span>사용 중</div>
                <div class="jsini-stat__value">@_board.Summary.UsingRooms</div>
            </div>
            <div class="jsini-stat fn-stat--empty">
                <div class="jsini-stat__label"><span class="jsini-icon-subtract" aria-hidden="true"></span>빈 호실</div>
                <div class="jsini-stat__value">@_board.Summary.EmptyRooms</div>
            </div>
            <div class="jsini-stat @(OfflineRooms > 0 ? "fn-stat--alert" : "fn-stat--online")">
                <div class="jsini-stat__label"><span class="jsini-icon-image" aria-hidden="true"></span>장비 온라인</div>
                <div class="jsini-stat__value">@_board.Summary.OnlineDevices / @_board.Summary.TotalDevices</div>
            </div>
        </div>
    </section>

    @if (OfflineRooms > 0)
    {
        @* 장비 상태. 이 화면을 띄워 두는 이유의 절반이라 맨 위에 둔다. *@
        <PageNotice Tone="NoticeTone.Warning"
                    Text="@($"장비가 다 안 붙은 호실이 {OfflineRooms}곳 있습니다.")" />
    }

    <div class="fn-board-toolbar">
        <div class="fn-board-toolbar__result" role="status" aria-live="polite">
            <strong>@Shown.Count</strong>개 호실 표시
            <span class="fn-board-toolbar__hint">전체 @(_board.Summary.TotalRooms)개 중 조건에 맞는 호실</span>
        </div>
        <div class="jsini-refresh-status" aria-label="자료 갱신 상태">
            <span class="jsini-icon-refresh" aria-hidden="true"></span>
            <span>마지막 갱신: @_lastRefreshAt.Kst("yyyy-MM-dd HH:mm:ss", "아직 없음")</span>
            @if (_backgroundRefreshError)
            {
                <span class="jsini-refresh-status__error">
                    <span class="jsini-icon-close-circle" aria-hidden="true"></span>
                    자동 갱신 실패 · 마지막 자료 표시 중
                </span>
            }
        </div>
    </div>

    @if (Shown.Count == 0)
    {
        <div class="fn-board-empty" role="status">
            <span class="jsini-icon-search" aria-hidden="true"></span>
            <strong>조건에 맞는 호실이 없습니다.</strong>
            <span>건물·층, 고인명, 기간 또는 장비 이상 조건을 바꿔 보세요.</span>
        </div>
    }
    else
    {
        <div class="fn-board" aria-label="빈소 카드 목록">
        @foreach (var room in Shown)
        {
            var hasDeviceAlert = room.DeviceCount > 0 && room.OnlineDeviceCount < room.DeviceCount;

            <article class="fn-card @(room.Occupied ? "fn-card--in-use" : "fn-card--empty") @(hasDeviceAlert ? "fn-card--device-alert" : "")"
                     aria-label="@($"{room.RoomName} · {(room.Occupied ? $"故 {room.DeceasedName}" : "비어 있음")}")">
                <header class="fn-card__head">
                    <div class="fn-card__room-wrap">
                        <span class="fn-card__room">@room.RoomName</span>
                        <span class="fn-card__occupancy">
                            <span class="@(room.Occupied ? "jsini-icon-user" : "jsini-icon-subtract")" aria-hidden="true"></span>
                            @(room.Occupied ? "사용 중" : "빈 호실")
                        </span>
                    </div>
                    <div class="fn-card__badges" aria-label="호실 상태">
                        @if (room.DeviceCount > 0)
                        {
                            <span class="fn-equipment-status @(hasDeviceAlert ? "fn-equipment-status--fault" : "fn-equipment-status--ok")">
                                <span class="@(hasDeviceAlert ? "jsini-icon-close-circle" : "jsini-icon-check-circle")" aria-hidden="true"></span>
                                <span>@(hasDeviceAlert ? "장비 이상" : "장비 정상")</span>
                                <span class="fn-equipment-status__count">@room.OnlineDeviceCount/@room.DeviceCount</span>
                            </span>
                        }
                    </div>
                </header>

                @if (room.Occupied)
                {
                    <div class="fn-card__body">
                        <div class="fn-card__person">
                            @if (room.PhotoUrl is { Length: > 0 } photo)
                            {
                                @* 영정. 서버가 보정본을 골라 준다. *@
                                <img class="fn-card__photo" src="@FileDownload.RelayUrl(photo)" alt="" loading="lazy" />
                            }

                            <div class="fn-card__person-info">
                                <div class="fn-card__name">故 @room.DeceasedName</div>
                                <div class="fn-card__sub">
                                    @Gender(room.DeceasedGender)
                                    @if (room.DeceasedAge is not null)
                                    {
                                        @* `is { } age` 로 잡은 이름은 Razor 조각 안에서 안 보여 값을 다시 읽는다. *@
                                        <span>· @room.DeceasedAge 세</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(room.Religion))
                                    {
                                        <span>· @room.Religion</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <dl class="fn-card__facts">
                            <dt>상주</dt><dd>@(room.ChiefMourner ?? "-")</dd>
                            <dt>입실</dt><dd>@Fmt(room.StartTime)</dd>
                            <dt>입관</dt><dd>@Fmt(room.CoffinTime)</dd>
                            <dt>발인</dt><dd>@Fmt(room.DischargeTime)</dd>
                            <dt>장지</dt><dd>@(room.BurialPlace ?? "-")</dd>
                            <dt>사용</dt><dd>@room.UseDays 일</dd>
                        </dl>

                        @* 고치러 가는 길만 건다. 같은 일을 두 자리에 두면 한쪽에만 규칙이 붙는다. 가운데 클릭으로 새 탭에 열린다. *@
                        <div class="fn-card__links">
                            <a href="/funeral/deceased?keyword=@Uri.EscapeDataString(room.DeceasedName ?? string.Empty)">
                                <span class="jsini-icon-user" aria-hidden="true"></span>고인 자료
                            </a>
                            @if (room.DeviceCount > 0)
                            {
                                <a href="/funeral/building/device">
                                    <span class="jsini-icon-image" aria-hidden="true"></span>기기 @room.DeviceCount 대
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="fn-card__body fn-card__body--empty">
                        <div class="fn-empty-state">
                            <span class="jsini-icon-check-circle" aria-hidden="true"></span>
                            <strong>현재 비어 있습니다</strong>
                        </div>

                        @if (room.LastVacatedAt is not null)
                        {
                            <div class="fn-card__sub">마지막 퇴실 @Fmt(room.LastVacatedAt)</div>
                        }

                        @if (room.LastDepartedDeceasedId is { Length: > 0 })
                        {
                            <div class="fn-card__cancel-note">
                                <span class="jsini-icon-undo" aria-hidden="true"></span>
                                출상 취소 가능
                            </div>
                            <PermissionView Action="MenuAction.Update">
                                <DxButton Text="@($"故 {room.LastDepartedDeceasedName} 출상 취소")"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          IconCssClass="jsini-icon-undo"
                                          Click="@(() => CancelDepartureAsync(room))" />
                            </PermissionView>
                        }
                        </div>
                }
            </article>
        }
    </div>
}
}
