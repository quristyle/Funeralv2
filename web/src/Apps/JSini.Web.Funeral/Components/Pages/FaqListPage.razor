@page "/funeral/help/faq"

@*
    [F.A.Q] — DB 메뉴 `/help/faq`.
    이력: Vue `views/funeral/help/faq/index` → 여기.

    [읽기만 하고 있었다]

    옛 화면에는 등록·수정·삭제가 있었다(서버의 `CanManage` 가 참일 때).
    클라이언트에는 메서드가 있었고 화면만 안 부르고 있었다.

    [관리 단추는 서버가 켠다]

    메뉴 권한(`PermissionView`)만으로는 모자란다. 이 화면은 **읽는 사람도
    들어오는** 자리라, 목록 응답의 `canManage` 가 참일 때만 관리 단추를
    보여 준다. 둘을 함께 본다 — 서버가 아니라고 하면 안 보인다.

    [답변이 HTML 이다 — 정제해서 그린다]

    한동안 태그를 걷어낸 글자만 보여 주었다. 정제 없이 넣는 것이 위험하다는
    판단은 맞았지만, 그 사이 **저장된 답변의 서식이 통째로 죽어 있었다** —
    옛 화면은 서식 편집기로 쓰고 그대로 그렸고, 번호 매긴 절차와 굵은 글씨가
    실제로 들어 있다.

    이제 공지 본문과 같은 길을 쓴다(`NoticeHtml.Sanitize`) — 서식 편집기가
    실제로 뱉는 태그만 남기고 script·이벤트 속성·낯선 스킴을 걷어낸다.
    쓰는 쪽도 서식 편집기(`DxHtmlEditor`)로 되돌렸다.

    **파일 이름이 화면 이름과 다르다.** 컴포넌트 이름을 자료 타입과 같게 두면
    화면 안에서 자료 타입이 가려진다 — Razor 가 만드는 클래스가 같은
    네임스페이스에 있어 더 가깝기 때문이다. 아키텍처 테스트가 이 충돌을 막는다.
*@

@inherits DataPage
@inject HelpApi Api

<PageTitle>F.A.Q · 장례식장</PageTitle>

<div class="jsini-toolbar">
    <DxTextBox @bind-Text="_keyword" NullText="질문 검색" Style="width: 220px"
               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxComboBox Data="@_categories" @bind-Value="_category"
                NullText="분류 전체" Style="width: 150px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />

    <div class="jsini-toolbar__spacer"></div>

    @if (_canManage)
    {
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary"
                      IconCssClass="jsini-icon-plus" Click="@StartNew" />
        </PermissionView>
    }
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

@foreach (var group in _items.GroupBy(f => string.IsNullOrWhiteSpace(f.Category) ? "기타" : f.Category))
{
    <section class="fn-faq">
        <h2 class="fn-subhead">@group.Key</h2>

        @foreach (var faq in group)
        {
            <details class="fn-faq__item">
                <summary class="fn-faq__q">
                    @faq.Question

                    @if (faq.Status != 1)
                    {
                        @* 중지된 항목은 관리자에게만 보인다. 그것을 표시해 두지
                           않으면 "왜 사용자에게 안 보이지" 를 묻게 된다. *@
                        <span class="jsini-badge jsini-badge--off">중지</span>
                    }
                </summary>

                @* 서식을 살려 그린다. **정제를 거친다** — `NoticeHtml.Sanitize` 가
                   서식 편집기가 실제로 뱉는 태그만 남기고 나머지(script·이벤트
                   속성·낯선 스킴)를 걷어낸다. 공지 본문이 이미 그 길을 쓴다. *@
                <div class="fn-faq__a">@((MarkupString)NoticeHtml.Sanitize(faq.Answer))</div>

                @if (_canManage)
                {
                    <div class="fn-faq__tools">
                        <PermissionView Action="MenuAction.Update">
                            <DxButton Text="수정"
                                      RenderStyle="ButtonRenderStyle.Link"
                                      Click="@(() => StartEdit(faq))" />
                        </PermissionView>
                        <PermissionView Action="MenuAction.Delete">
                            <DxButton Text="삭제"
                                      RenderStyle="ButtonRenderStyle.Link"
                                      Click="@(() => DeleteAsync(faq))" />
                        </PermissionView>
                    </div>
                }
            </details>
        }
    </section>
}

<DxPopup @bind-Visible="_editing" HeaderText="@(_isNew ? "질문 등록" : "질문 수정")"
         Width="680" CloseOnOutsideClick="false" ShowFooter="true">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="분류" ColSpanMd="6">
                @* 이미 쓰이는 분류를 고르거나 새로 적을 수 있다. 목록에만
                   가두면 분류를 늘릴 때마다 코드를 고쳐야 한다. *@
                <DxComboBox Data="@_categories" @bind-Value="_edit.Category"
                            AllowUserInput="true" NullText="분류 (직접 입력 가능)"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="정렬" ColSpanMd="3">
                <DxSpinEdit @bind-Value="_edit.OrderNo" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="3">
                <DxCheckBox Checked="@(_edit.Status == 1)"
                            CheckedChanged="@((bool v) => _edit.Status = v ? 1 : 0)">
                    사용
                </DxCheckBox>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="질문" ColSpanMd="12">
                <DxTextBox @bind-Text="_edit.Question" />
            </DxFormLayoutItem>

            @* 답변은 **HTML 이다.** 옛 화면이 서식 편집기로 쓰고 그대로 그렸다 —
               번호 매긴 절차나 굵은 글씨가 실제로 들어 있다. 여러 줄 입력으로
               두면 고치러 열었을 때 태그가 글자로 보이고, 새 답변은 줄바꿈이
               사라진다. *@
            <DxFormLayoutItem Caption="답변" ColSpanMd="12">
                <DxHtmlEditor @bind-Markup="_edit.Answer"
                              BindMarkupMode="HtmlEditorBindMarkupMode.OnDelayedInput"
                              CssClass="fn-editor"
                              NullText="답변 내용" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate>
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</DxPopup>

@code {
    private string? _keyword;
    private string? _category;

    private IReadOnlyList<Faq> _items = [];
    private IReadOnlyList<string> _categories = [];

    /// <summary>서버가 「이 사람은 고칠 수 있다」고 한 경우에만 참.</summary>
    private bool _canManage;

    private bool _editing;
    private bool _isNew;
    private Faq _edit = new();

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var list = await Api.GetFaqListAsync(_category, _keyword);

        _items = list.Items;
        _categories = list.Categories;
        _canManage = list.CanManage;

        return _items.Count;
    }, "등록된 질문이 없습니다.", "F.A.Q 를 읽지 못했습니다");

    private void StartNew()
    {
        _isNew = true;
        _edit = new Faq
        {
            Category = _category,
            Status = 1,

            // 마지막 뒤에 붙인다. 0 으로 두면 새 질문이 맨 앞에 끼어든다.
            OrderNo = _items.Count == 0 ? 1 : _items.Max(f => f.OrderNo) + 1,
        };
        _editing = true;
    }

    /// <summary>
    /// 편집 창에 <b>복사본</b>을 띄운다.
    ///
    /// 원본을 그대로 묶으면 저장을 취소해도 화면에는 이미 바뀐 값이 남는다 —
    /// 화면과 서버가 어긋난 채로 보이고, 새로 고치기 전에는 알 수 없다.
    /// </summary>
    private void StartEdit(Faq faq)
    {
        _isNew = false;
        _edit = new Faq
        {
            Id = faq.Id,
            Question = faq.Question,
            Answer = faq.Answer,
            Category = faq.Category,
            OrderNo = faq.OrderNo,
            Status = faq.Status,
        };
        _editing = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_edit.Question))
        {
            Say("질문을 넣으십시오.", NoticeTone.Warning);
            return;
        }

        var body = new
        {
            question = _edit.Question,
            answer = _edit.Answer,
            category = _edit.Category,
            orderNo = _edit.OrderNo,
            status = _edit.Status,
        };

        var saved = await RunAsync(
            () => _isNew ? Api.CreateFaqAsync(body) : Api.UpdateFaqAsync(_edit.Id, body),
            _isNew ? "등록했습니다." : "저장했습니다.",
            _isNew ? "등록하지 못했습니다" : "저장하지 못했습니다");

        if (!saved)
        {
            // 창을 닫지 않는다. 닫으면 쓴 내용이 사라진다.
            return;
        }

        _editing = false;
        await ReloadAsync();
    }

    private async Task DeleteAsync(Faq faq)
    {
        if (await RunAsync(() => Api.DeleteFaqAsync(faq.Id), "지웠습니다.", "지우지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

}
