@page "/funeral/player-download"

@*
    [플레이어 다운로드] — DB 메뉴 `/system/player-download`.
    이력: Vue `views/funeral/player-download/index` → 여기.

    빈소 디스플레이에 설치하는 Flutter 플레이어(funeralv2_player)를 OS 별로
    내려받는 곳이다. 파일은 **GitHub Releases** 에 있다 — 버전 태그(v1.0.0)를
    푸시하면 `.github/workflows/release.yml` 이 OS 별 산출물을 만들어 붙인다.
    거는 쪽은 포털관리의 「플레이어 릴리스」(`/admin/status/player-release`) 다.

    ────────────────────────────────────────────────────────────
    [한동안 자료실 목록을 보여 주고 있었다]

    이 화면이 자료실(`auth/help/archives`)의 「플레이어」 분류를 표로 보여 주고
    있었다. 원본에 없던 것이다. 자료실에는 아무도 올리지 않았고, 릴리스
    워크플로가 만든 설치 파일은 GitHub 에만 있어서 **화면이 늘 비어 있었다.**
    옮길 때 자료실 화면의 뼈대를 복사해 쓴 흔적으로 보인다.

    ────────────────────────────────────────────────────────────
    [리눅스는 배포판마다 파일이 다르다]

    Flutter 리눅스 빌드는 **빌드한 곳의 glibc 를 그대로 요구한다.** Debian 13
    trixie(2.41)에서 만든 것은 Ubuntu 24.04(2.39)에서 실행되지 않는다. 그래서
    자산 이름에 배포판이 들어가고(`_debian13_` · `_ubuntu24_`) 아래 짝짓기도
    배포판·아키텍처까지 본다 — `.deb` 로만 고르면 엉뚱한 파일을 준다.
    이름 규칙의 정본은 `packaging/build_deb.sh` 다.

    ────────────────────────────────────────────────────────────
    [GitHub 을 브라우저가 아니라 서버가 부른다]

    원본은 화면에서 `api.github.com` 을 직접 불렀다. 여기서는 게이트웨이를 거쳐
    AuthServer 가 부른다 — 토큰이 거기 있어 저장소가 비공개로 바뀌어도 계속
    읽히고, 익명 호출의 시간당 60회 제한(사무실이 한 아이피다)에 걸리지 않는다.

    **내려받기 자체는 브라우저가 GitHub 에서 바로 한다.** 파일이 수백 MB 라
    포털이 중계하면 회로가 그동안 묶인다.
*@

@inherits DataPage
@inject HelpApi Api

<PageTitle>플레이어 다운로드 · 장례식장</PageTitle>

<CommSch OnSearch="@ReloadAsync">
    <Fields>
        <CommSchItem Label="최신 버전">
            <span class="fn-pd__tag">
                @if (_latest.Published)
                {
                    <span class="jsini-badge jsini-badge--on">@_latest.TagName</span>
                    <span class="jsini-text-muted">@PublishedText 배포</span>
                }
                else
                {
                    <span class="jsini-text-muted">아직 발행된 릴리스가 없습니다</span>
                }
            </span>
        </CommSchItem>
    </Fields>
    <Actions>
        @* 바깥으로 나가는 링크다. 새 창으로 연다 — 포털을 벗어나면
           로그인 상태로 돌아오기 번거롭다. *@
        <a class="dxbl-btn dxbl-btn-secondary fn-pd__link"
           href="@_latest.ReleasesUrl" target="_blank" rel="noopener">
            전체 버전 보기
        </a>
    </Actions>
</CommSch>

@if (!string.IsNullOrWhiteSpace(_latest.Warning))
{
    <PageNotice Text="@_latest.Warning" Tone="NoticeTone.Warning" />
}

<PageNotice Text="@Notice" Tone="@Tone" />

<CommCont>
    <div class="fn-pd">
        @foreach (var platform in Platforms)
        {
            var asset = Match(platform);

            <div class="fn-pd__card">
                <div class="fn-pd__head">
                    <div class="fn-pd__title">@platform.Title</div>
                    <div class="fn-pd__sub">@platform.Subtitle</div>
                </div>

                <ul class="fn-pd__reqs">
                    @foreach (var requirement in platform.Requirements)
                    {
                        <li>@requirement</li>
                    }
                </ul>

                @* 고정폭 글꼴을 쓰지 않는다. 명령어라 어울려 보이지만, 그러면
                   환경설정에서 고른 글꼴이 이 칸에만 안 먹어 화면 안에서 글꼴이
                   갈린다. 명령어라는 것은 회색 상자와 머리글로 알린다. *@
                <div class="fn-pd__steps">
                    <div class="fn-pd__steps-title">설치 방법</div>
                    @foreach (var step in platform.Steps)
                    {
                        <div class="fn-pd__step">@step</div>
                    }
                </div>

                <div class="fn-pd__foot">
                    @if (asset is not null)
                    {
                        <a class="dxbl-btn dxbl-btn-primary fn-pd__download"
                           href="@asset.DownloadUrl" target="_blank" rel="noopener">
                            내려받기
                        </a>
                        <div class="fn-pd__asset" title="@asset.Name">
                            @asset.Name · @Size(asset.Size)
                        </div>
                    }
                    else
                    {
                        <span class="dxbl-btn dxbl-btn-secondary fn-pd__download fn-pd__download--off">
                            파일 없음
                        </span>
                        <div class="fn-pd__asset">이 버전에 이 OS 파일이 없습니다.</div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="fn-pd__note">
        설치 파일은 저장소에 버전 태그(예: <code>v1.0.0</code>)를 푸시할 때 자동으로
        만들어져 GitHub Releases 에 붙습니다. 리눅스는 <code>.deb</code> 설치를
        권합니다 — 의존 패키지와 부팅 시 자동 실행까지 함께 처리됩니다.
        설치한 뒤에는 <strong>기기 관리</strong> 화면에서 장비가 온라인으로 잡히는지
        확인하십시오.
    </div>
</CommCont>

@code {
    /// <summary>
    /// OS 별 카드 한 장.
    ///
    /// <para>
    /// <c>Matches</c> 는 자산 이름(소문자)을 받아 이 카드의 파일인지 답한다.
    /// <b>배포판과 아키텍처까지 본다</b> — 까닭은 화면 머리말에 있다.
    /// </para>
    /// </summary>
    private sealed record Platform(
        string Title,
        string Subtitle,
        Func<string, bool> Matches,
        string[] Requirements,
        string[] Steps);

    /// <summary>원본(Vue)의 일곱 카드를 그대로 옮겼다. 순서도 같다.</summary>
    private static readonly Platform[] Platforms =
    [
        new("Windows",
            "10 / 11 · 64비트 (x64)",
            n => n.Contains("windows") && n.EndsWith(".zip"),
            ["Windows 10 / 11 (64비트)", "Visual C++ 2015-2022 재배포 패키지"],
            ["zip 압축을 풀고 funeralv2_player.exe 실행"]),

        new("라즈베리파이",
            "Raspberry Pi OS 64비트 · .deb",
            n => n.Contains("debian13") && n.Contains("arm64") && n.EndsWith(".deb"),
            ["Raspberry Pi OS Lite 64비트 (Debian 13 trixie)", "Raspberry Pi 4 이상"],
            ["sudo apt install ./funeralv2-player_<버전>_debian13_arm64.deb",
             "sudo reboot  (재부팅하면 화면에 자동 실행)"]),

        new("Ubuntu (x64)",
            "24.04 LTS · 미니PC · .deb",
            n => n.Contains("ubuntu24") && n.Contains("amd64") && n.EndsWith(".deb"),
            ["Ubuntu 24.04 LTS 이상 (64비트)",
             "서버 · 최소 설치 권장 (데스크톱이면 디스플레이 매니저를 끈다)"],
            ["sudo apt install ./funeralv2-player_<버전>_ubuntu24_amd64.deb",
             "sudo systemctl disable --now gdm3   (데스크톱 설치인 경우)",
             "sudo reboot"]),

        new("Ubuntu (arm64)",
            "24.04 LTS · Jetson 등 · .deb",
            n => n.Contains("ubuntu24") && n.Contains("arm64") && n.EndsWith(".deb"),
            ["Ubuntu 24.04 LTS 이상 (arm64)",
             "Ubuntu 를 올린 arm 보드 (라즈베리파이는 위 카드를 쓴다)"],
            ["sudo apt install ./funeralv2-player_<버전>_ubuntu24_arm64.deb", "sudo reboot"]),

        new("Android TV",
            "TV 박스 · 태블릿 · .apk",
            n => n.EndsWith(".apk"),
            ["Android 5.0 이상 (TV 박스 · 태블릿)", "알 수 없는 출처 설치 허용 필요"],
            ["adb install -r funeralv2_player-<버전>-android-*.apk",
             "또는 USB · Downloader 앱으로 설치",
             "debugsigned 는 업데이트 시 기존 앱을 지우고 다시 설치"]),

        new("수동 설치 (arm64)",
            "deb 를 못 쓰는 환경 · tar.gz",
            n => n.Contains("arm64") && n.EndsWith(".tar.gz"),
            ["deb 를 쓸 수 없는 arm64 환경", "의존 패키지 수동 설치 필요"],
            ["압축을 풀고 동봉된 README.txt 절차대로 배치"]),

        new("수동 설치 (x64)",
            "deb 를 못 쓰는 환경 · tar.gz",
            n => n.Contains("amd64") && n.EndsWith(".tar.gz"),
            ["deb 를 쓸 수 없는 x64 환경", "의존 패키지 수동 설치 필요"],
            ["압축을 풀고 동봉된 README.txt 절차대로 배치"]),
    ];

    private PlayerLatest _latest = new();

    private string PublishedText =>
        _latest.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>
    /// 릴리스가 없어도 <b>실패가 아니다.</b> 서버가 까닭을 <c>Warning</c> 으로 주고
    /// 화면은 카드를 「파일 없음」으로 그린다 — 어느 OS 가 준비돼 있는지는
    /// 릴리스 전에도 보여 줘야 한다.
    /// </summary>
    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _latest = await Api.GetPlayerLatestAsync();
        return 1;
    }, failMessage: "릴리스 정보를 읽지 못했습니다");

    private PlayerAsset? Match(Platform platform) =>
        _latest.Assets.FirstOrDefault(a => platform.Matches(a.Name.ToLowerInvariant()));

    private static string Size(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{bytes / 1024d:0} KB";
}
