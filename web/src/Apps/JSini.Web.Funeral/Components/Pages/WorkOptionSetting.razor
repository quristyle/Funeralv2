@page "/funeral/setting/work-options"
@attribute [RouteKey("funeral.setting.work-options")]

@* [업무 설정] — DB 메뉴 `/setting/work-options`. 장례식장 업무 규칙을 켜고 끈다. 무엇이 있는지는 백엔드 SettingCatalog 가 정본이고, 화면은 서버가 준 묶음을 그대로 그린다.
스위치를 누르는 즉시 한 줄씩 저장한다. 저장 단추가 하나면 무엇을 바꿨는지 기억해야 하고, 실수로 나가면 조용히 사라진다. *@

@inherits DataPage

<PageTitle>업무 설정 · 장례식장</PageTitle>

@foreach (var group in Groups)
{
    <section class="fn-settings">
        <h2 class="fn-subhead">@group.Key</h2>

        @foreach (var setting in group)
        {
            <div class="fn-setting">
                <div class="fn-setting__text">
                    <div class="fn-setting__name">@setting.Name</div>

                    @if (!string.IsNullOrWhiteSpace(setting.Description))
                    {
                        <div class="fn-setting__desc">@setting.Description</div>
                    }

                    @if (setting.UpdatedAt is not null)
                    {
                        @* 바꾼 시각을 적는다. 「원래 이랬나」를 확인할 방법이 없으면 실수를 되짚을 수 없다. *@
                        <div class="fn-setting__desc">
                            마지막 저장 @setting.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </div>
                    }
                </div>

                <PermissionView Action="MenuAction.Update">
                    @* 스위치 하나가 곧 저장이다. *@
                    <DxCheckBox Checked="@setting.Enabled"
                                CheckedChanged="@((bool v) => ToggleAsync(setting, v))" />
                </PermissionView>
            </div>
        }
    </section>
}
