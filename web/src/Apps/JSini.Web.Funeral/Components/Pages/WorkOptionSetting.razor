@page "/funeral/setting/work-options"

@*
    [업무 설정] — DB 메뉴 `/setting/work-options`.
    이력: Vue `views/funeral/setting/work-options/index` → 여기.
    (더 거슬러 올라가면 옛 `page/ui_config.jsp` 의 오른쪽 표다.)

    장례식장 **업무 규칙**을 켜고 끈다. 무엇이 있는지는 백엔드의
    `SettingCatalog` 가 정본이고, 화면은 서버가 준 것을 그대로 그린다.

    [묶음 이름을 화면이 정하고 있었다 — 그래서 아무것도 안 보였다]

    이 화면은 「업무 · 운영 · WORK · OPERATION」 이라는 **목록을 코드에 적어
    두고** 그 묶음만 보여 주고 있었다. 그런데 실제 묶음 이름은
    「빈소 운영 · 장비 · 화면」이다. 하나도 안 맞아서 **설정 네 개가 전부
    보이지 않았다.**

    빈 화면이 「설정 항목이 없습니다」로 뜨니 서버가 안 주는 것처럼 보였다.
    묶음 이름은 DB 값이라 언제든 늘고 바뀐다 — 화면이 그것을 열거하면 안 된다.
    지금은 **서버가 준 묶음을 그대로** 그린다.

    [`/setting/environment` 와 다른 화면이다]

    그쪽은 **개인 환경설정**(테마·사이드바·탭)이고 여기는 업무 규칙이다.
    옛 Vue 에서도 한 번 그 자리를 덮어썼다가 되돌린 이력이 있다.

    [스위치를 누르는 즉시 저장한다]

    저장 단추를 따로 두지 않는다. 스위치가 열몇 개인데 단추가 하나면 「무엇을
    바꿨는지」를 사용자가 기억해야 하고, 실수로 저장 없이 나가면 조용히 사라진다.
    한 줄씩 저장하는 API 가 그래서 있다.
*@

@inherits DataPage
@inject FuneralApi Api

<PageTitle>업무 설정 · 장례식장</PageTitle>

<PageNotice Text="스위치를 누르면 바로 저장됩니다." />

<PageNotice Text="@Notice" Tone="@Tone" />

@foreach (var group in Groups)
{
    <section class="fn-settings">
        <h2 class="fn-subhead">@group.Key</h2>

        @foreach (var setting in group)
        {
            <div class="fn-setting">
                <div class="fn-setting__text">
                    <div class="fn-setting__name">@setting.Name</div>

                    @if (!string.IsNullOrWhiteSpace(setting.Description))
                    {
                        <div class="fn-setting__desc">@setting.Description</div>
                    }

                    @if (setting.UpdatedAt is not null)
                    {
                        @* 언제 누가 바꿨는지가 안 보이면 「원래 이랬나」를
                           확인할 방법이 없다. 시각만이라도 적어 둔다. *@
                        <div class="fn-setting__desc">
                            마지막 저장 @setting.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </div>
                    }
                </div>

                <PermissionView Action="MenuAction.Update">
                    @* 스위치 하나가 곧 저장이다. *@
                    <DxCheckBox Checked="@setting.Enabled"
                                CheckedChanged="@((bool v) => ToggleAsync(setting, v))" />
                </PermissionView>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<EnvironmentSetting> _all = [];

    /// <summary>
    /// 서버가 준 묶음을 그대로 그린다.
    ///
    /// <b>화면이 묶음 이름을 열거하지 않는다.</b> 그 값은 DB 에 있고 언제든
    /// 늘고 바뀐다 — 열거하면 새 묶음이 조용히 사라진다. 실제로 그래서
    /// 설정 넷이 전부 안 보이고 있었다.
    /// </summary>
    private IEnumerable<IGrouping<string, EnvironmentSetting>> Groups =>
        _all.GroupBy(s => string.IsNullOrWhiteSpace(s.GroupName) ? "기타" : s.GroupName)
            .OrderBy(g => g.Key, StringComparer.Ordinal);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetEnvironmentSettingsAsync();
        return _all.Count;
    }, "설정 항목이 없습니다.", "설정을 읽지 못했습니다");

    private async Task ToggleAsync(EnvironmentSetting setting, bool value)
    {
        // **화면 값을 먼저 바꾼다.** 서버 왕복을 기다리면 스위치가 눌린 뒤
        // 잠깐 제자리에 있어서 사용자가 한 번 더 누른다.
        setting.Enabled = value;

        if (await RunAsync(() => Api.UpdateEnvironmentSettingAsync(setting.Code, value),
                $"{setting.Name} 을(를) {(value ? "켰" : "껐")}습니다.", "저장하지 못했습니다"))
        {
            setting.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            // 실패했으면 되돌린다 — 안 되돌리면 화면과 서버가 어긋난 채로 남는다.
            setting.Enabled = !value;
        }
    }
}
