@page "/funeral/building/room"

@*
    [호실 관리] — DB 메뉴 `/building/room`.
    이력: Vue `views/funeral/building/room/index` → 여기.
*@

@inject FuneralApi Api

<PageTitle>호실 관리 · 장례식장</PageTitle>

<PageHeading Title="호실 관리" Scope="장례식장" />

<BuildingFilter @bind-BuildingId="_buildingId" @bind-FloorId="_floorId" ShowFloor="true" Search="@LoadAsync" />

<DxGrid Data="@_rooms" ShowFilterRow="false" PageSize="20" >
    <Columns>
        <DxGridDataColumn FieldName="@nameof(Room.FloorName)" Caption="층" Width="120" />
        <DxGridDataColumn FieldName="@nameof(Room.Name)" Caption="호실" MinWidth="160" />
        <DxGridDataColumn FieldName="@nameof(Room.ShortName)" Caption="약칭" Width="110" />
        <DxGridDataColumn FieldName="@nameof(Room.RoomType)" Caption="구분" Width="120" />
        <DxGridDataColumn FieldName="@nameof(Room.Status)" Caption="상태" Width="100">
            <CellDisplayTemplate>
                @{
                    var room = (Room)context.DataItem;
                }
                <span class="jsini-badge @(room.Status == "ACTIVE" ? "jsini-badge--on" : "jsini-badge--off")">
                    @(room.Status == "ACTIVE" ? "사용" : "미사용")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(Room.Remark)" Caption="비고" MinWidth="160" />
    </Columns>
</DxGrid>

<PageNotice Text="@_notice" Tone="@_tone" />

@code {
    private string? _buildingId;
    private string? _floorId;
    private IReadOnlyList<Room> _rooms = [];
    private string? _notice;
    private NoticeTone _tone = NoticeTone.Info;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _rooms = await Api.GetRoomsAsync(_buildingId, _floorId);
            _notice = _rooms.Count == 0 ? "조건에 맞는 호실이 없습니다." : null;
            _tone = NoticeTone.Info;
        }
        catch (ApiException ex)
        {
            _rooms = [];
            _notice = $"호실 목록을 읽지 못했습니다 — {ex.Message}";
            _tone = NoticeTone.Error;
        }
    }
}
