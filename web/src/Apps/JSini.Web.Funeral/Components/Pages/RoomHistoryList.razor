@page "/funeral/info/room-history"
@attribute [RouteKey("funeral.info.room-history")]

@* [호실 사용 이력] — DB 메뉴 `/info/room-history`. 사용 일수는 서버가 센다. 사용 중인 건은 끝 시각이 없어 화면에서 빼지 않는다. *@

@inherits DataPage

<PageTitle>호실 사용 이력 · 장례식장</PageTitle>

<BuildingFilter @bind-BuildingId="_buildingId" @bind-RoomId="_roomId" ShowRoom="true" Search="@ReloadAsync" SummaryExtra="@ConditionSummary">
    <DxTextBox @bind-Text="_keyword" NullText="고인명 검색" Style="width: 180px"
               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    <DxDateEdit @bind-Date="_from" NullText="시작일" Style="width: 150px" />
    <DxDateEdit @bind-Date="_to" NullText="종료일" Style="width: 150px" />
    <DxCheckBox @bind-Checked="_inUse">사용 중만</DxCheckBox>
</BuildingFilter>

<CommCont>
    <CommGrd TItem="RoomHistory" Data="@_rows" PageSize="20">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(RoomHistory.BuildingName)" Caption="건물" Width="140" />
            <DxGridDataColumn FieldName="@nameof(RoomHistory.RoomName)" Caption="호실" Width="120" />
            @* 영정사진. 이름만으로는 동명이인을 못 가려 아이디도 함께 본다. *@
            <DxGridDataColumn Caption="" Width="60" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var h = (RoomHistory)cell.DataItem;
                        var photo = h.MemorialPhotoFileId is { Length: > 0 } id
                            ? FileDownload.UrlFor(id)
                            : FileDownload.RelayUrl(h.MemorialPhotoUrl);
                    }
                    @if (!string.IsNullOrWhiteSpace(photo))
                    {
                        <img class="fn-thumb" src="@photo" alt="" loading="lazy" />
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(RoomHistory.DeceasedName)" Caption="고인" MinWidth="120" />

            <DxGridDataColumn Caption="성별" Width="70">
                <CellDisplayTemplate Context="cell">
                    @(((RoomHistory)cell.DataItem).Gender switch
                    {
                        "FEMALE" => "여",
                        "MALE" => "남",
                        _ => "-",
                    })
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(RoomHistory.Age)" Caption="나이" Width="70" />
            <DxGridDataColumn FieldName="@nameof(RoomHistory.StartTime)" Caption="입실" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn FieldName="@nameof(RoomHistory.EndTime)" Caption="퇴실" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn FieldName="@nameof(RoomHistory.UseDays)" Caption="사용일" Width="90" />
            <DxGridDataColumn FieldName="@nameof(RoomHistory.BurialPlot)" Caption="장지" MinWidth="130" />
            <DxGridDataColumn Caption="상태" Width="100">
                <CellDisplayTemplate>
                    @{
                        var h = (RoomHistory)context.DataItem;
                    }
                    <span class="jsini-badge @(h.InUse ? "jsini-badge--on" : "jsini-badge--off")">
                        @(h.InUse ? "사용 중" : "종료")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
</CommCont>
