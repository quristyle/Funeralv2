@page "/funeral/status/simple"
@attribute [RouteKey("funeral.status.simple")]

@*
    [간편 현황] — DB 메뉴 `/status/simple`.
    이력: Vue `views/funeral/status/simple/index` → 여기.

    칸을 넷으로 줄인 현황이다. 안내 데스크에서 크게 띄워 두는 화면이라
    한눈에 읽히는 것이 목적이고, 그래서 기본이 **사용 중만**이다.

    [스스로 새로 고치지 않고 있었다]

    띄워 두는 화면이라 사람이 새로 고침을 누르러 오지 않는다. 옛 화면은 30초
    시계를 돌렸는데 옮기면서 빠졌다 — 안내 데스크 화면이 아침에 띄운 상태로
    굳어 있었다는 뜻이다. `AutoRefreshPage` 가 그 시계를 든다.
*@

@inherits AutoRefreshPage

<PageTitle>간편 현황 · 장례식장</PageTitle>

<BuildingFilter @bind-BuildingId="_buildingId" @bind-FloorId="_floorId" ShowFloor="true" Search="@ReloadAsync" SummaryExtra="@ConditionSummary">
    <DxCheckBox @bind-Checked="_onlyInUse">사용 중만</DxCheckBox>
</BuildingFilter>

<CommCont>
    <CommGrd TItem="FuneralStatus" Data="@_rows" PageSize="30">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(FuneralStatus.RoomName)" Caption="호실" Width="130" />
            <DxGridDataColumn FieldName="@nameof(FuneralStatus.DeceasedName)" Caption="고인" MinWidth="140" />
            <DxGridDataColumn FieldName="@nameof(FuneralStatus.ChiefMourner)" Caption="상주" MinWidth="140" />
            <DxGridDataColumn FieldName="@nameof(FuneralStatus.DischargeTime)" Caption="발인" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
        </Columns>
    </CommGrd>
</CommCont>
