@page "/funeral/building/info"

@*
    [건물 관리] — DB 메뉴 `/building/info`.

    이력: Vue `views/funeral/building/info/index` → 여기.

    한동안 이 화면은 **하드코딩한 세 줄**을 보여 주고 있었다(골격을 잡을 때
    넣어 둔 것). 실제 API 에 붙였다.
*@

@inject FuneralApi Api

<PageTitle>건물 관리 · 장례식장</PageTitle>

<PageHeading Title="건물 관리" Scope="장례식장" />

<div class="jsini-toolbar">
    <DxTextBox @bind-Text="_keyword" NullText="건물명 검색" Style="width: 220px"
               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@LoadAsync" />
</div>

<DxGrid Data="@Shown" ShowFilterRow="false" PageSize="20" >
    <Columns>
        <DxGridDataColumn FieldName="@nameof(Building.Name)" Caption="건물명" MinWidth="180" />
        <DxGridDataColumn FieldName="@nameof(Building.ShortName)" Caption="약칭" Width="120" />
        <DxGridDataColumn FieldName="@nameof(Building.Address)" Caption="주소" MinWidth="260" />
        <DxGridDataColumn FieldName="@nameof(Building.ZipCode)" Caption="우편번호" Width="100" />
        <DxGridDataColumn FieldName="@nameof(Building.Remark)" Caption="비고" MinWidth="140" />
    </Columns>
</DxGrid>

<PageNotice Text="@_notice" Tone="@_tone" />

@code {
    private IReadOnlyList<Building> _all = [];
    private string? _keyword;
    private string? _notice;
    private NoticeTone _tone = NoticeTone.Info;

    private IReadOnlyList<Building> Shown => string.IsNullOrWhiteSpace(_keyword)
        ? _all
        : [.. _all.Where(b => b.Name.Contains(_keyword, StringComparison.OrdinalIgnoreCase))];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _all = await Api.GetBuildingsAsync();
            _notice = _all.Count == 0 ? "등록된 건물이 없습니다." : null;
            _tone = NoticeTone.Info;
        }
        catch (ApiException ex)
        {
            // 목록을 못 읽어도 화면은 남긴다. 조건을 바꿔 다시 시도할 수 있어야 한다.
            _all = [];
            _notice = $"건물 목록을 읽지 못했습니다 — {ex.Message}";
            _tone = NoticeTone.Error;
        }
    }
}
