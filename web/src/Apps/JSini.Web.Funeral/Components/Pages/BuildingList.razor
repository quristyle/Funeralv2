@page "/funeral/building/info"

@*
    [건물 관리] — DB 메뉴 `/building/info`.
    이력: Vue `views/funeral/building/info/index` → 여기.

    [읽기만 하고 있었다]

    목록은 붙어 있었지만 등록·수정·삭제가 없었다. 옛 화면에는 셋 다 있었고
    (`funeral/building/info` POST · PUT · DELETE), 클라이언트에도 메서드가
    이미 있었다 — 화면만 안 부르고 있었다.

    [건물이 층·호실의 뿌리다]

    건물 하나에 층이 달리고 층에 호실이 달린다. 그래서 건물을 지우면 그 아래가
    통째로 미아가 된다. 서버가 막지만, 지우기 전에 층이 몇 개인지 보여 주는
    편이 낫다 — 실수로 누르는 것을 막는 것은 화면의 몫이다.
*@

@inherits DataPage
@inject FuneralApi Api

<PageTitle>건물 관리 · 장례식장</PageTitle>

<PageHeading Title="건물 관리" Scope="장례식장" />

<CommGrd TItem="Building"
         Data="@Shown"
         EditFormTitle="건물"
         ExportName="건물"
         PageSize="20"
         OnNew="@FillNew"
         OnSave="@SaveAsync"
         OnDelete="@DeleteAsync"
         Reload="@ReloadAsync">
    <Toolbar>
        <DxTextBox @bind-Text="_keyword" NullText="건물명·주소 검색" Style="width: 220px"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    </Toolbar>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(Building.Name)" Caption="건물명" MinWidth="180" />
        <DxGridDataColumn FieldName="@nameof(Building.ShortName)" Caption="약칭" Width="110" />
        <DxGridDataColumn FieldName="@nameof(Building.Address)" Caption="주소" MinWidth="240" />
        <DxGridDataColumn FieldName="@nameof(Building.ZipCode)" Caption="우편번호" Width="100" />

        <DxGridDataColumn Caption="층" Width="70">
            <CellDisplayTemplate Context="cell">
                @{
                    var b = (Building)cell.DataItem;
                }
                @_floorCount.GetValueOrDefault(b.Id)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(Building.Remark)" Caption="비고" MinWidth="140" />
    </Columns>

    <EditFormTemplate Context="edit">
        @{
            var b = (Building)edit.EditModel;
        }
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="건물명" ColSpanMd="8">
                <DxTextBox @bind-Text="b.Name" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="약칭" ColSpanMd="4">
                @* 빈소 현황판처럼 자리가 좁은 화면이 이 값을 쓴다. *@
                <DxTextBox @bind-Text="b.ShortName" NullText="현황판에 쓰는 짧은 이름" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="우편번호" ColSpanMd="4">
                <DxTextBox @bind-Text="b.ZipCode" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="주소" ColSpanMd="8">
                <DxTextBox @bind-Text="b.Address" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="상세 주소" ColSpanMd="12">
                <DxTextBox @bind-Text="b.AddressDetail" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxMemo @bind-Text="b.Remark" Rows="3" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditFormTemplate>
</CommGrd>

@code {
    private IReadOnlyList<Building> _all = [];

    /// <summary>건물별 층 수. 지우기 전에 「비어 있는 건물인가」를 보여 준다.</summary>
    private Dictionary<string, int> _floorCount = [];

    private string? _keyword;

    private IReadOnlyList<Building> Shown
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_keyword))
            {
                return _all;
            }

            var k = _keyword.Trim();
            return [.. _all.Where(b =>
                b.Name.Contains(k, StringComparison.OrdinalIgnoreCase)
                || (b.Address?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false))];
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetBuildingsAsync();

        // 층은 건물 전체를 한 번에 받아 세어 둔다. 건물마다 따로 물으면
        // 건물 수만큼 왕복이 생긴다.
        var floors = await Api.GetFloorsAsync();
        _floorCount = floors
            .GroupBy(f => f.BuildingId)
            .ToDictionary(g => g.Key, g => g.Count());

        return _all.Count;
    }, "등록된 건물이 없습니다.", "건물 목록을 읽지 못했습니다");

    private void FillNew(Building b)
    {
        // 회사 식별자는 서버가 토큰에서 정한다. 화면이 넣으면 남의 회사에
        // 건물을 만들 수 있는 길이 열린다.
        b.CompanyId = string.Empty;
    }

    private Task SaveAsync((Building Item, bool IsNew) e) => e.IsNew
        ? Api.CreateBuildingAsync(e.Item)
        : Api.UpdateBuildingAsync(e.Item.Id, e.Item);

    private async Task DeleteAsync(Building b)
    {
        // 층이 남아 있으면 지우지 않는다. 서버도 막지만 여기서 먼저 말해 주는
        // 편이 낫다 — 「삭제하지 못했습니다」만 보면 왜인지 알 수 없다.
        //
        // 예외로 알린다. CommGrd 가 그것을 받아 안내로 바꾸고 목록을 그대로 둔다.
        if (_floorCount.GetValueOrDefault(b.Id) is > 0 and var floors)
        {
            throw new ApiException($"이 건물에 층이 {floors}개 있습니다. 층을 먼저 정리하십시오.");
        }

        await Api.DeleteBuildingAsync(b.Id);
    }
}
