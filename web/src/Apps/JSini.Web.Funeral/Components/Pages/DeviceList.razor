@page "/funeral/building/device"

@*
    [기기 관리] — DB 메뉴 `/building/device`.
    이력: Vue `views/funeral/building/device/index` → 여기.
    API: `funeral/building/device/list` · `funeral/building/device-attribute/{deviceId}`

    빈소마다 놓인 디스플레이·플레이어 장비다.

    [조건이 통째로 어긋나 있었다]

    `GetDevicesAsync` 의 첫 인자는 `companyId` 다. 화면이 자리로 넘겨
    건물이 회사 자리에, 층이 건물 자리에 들어가고 있었다 — 건물·층·호실을
    골라도 목록이 줄지 않는다. 이름을 붙여 넘겨 고쳤다.

    **온·오프라인은 서버가 판정해 `Status` 로 내려 준다.** 화면이 `LastSeenAt`
    을 보고 직접 재지 않는다 — 재면 브라우저 시계 기준이 되어, 시각이 어긋난
    장비에서는 멀쩡한 기기가 오프라인으로 보인다.

    [원격 업데이트 지시가 없었다]

    켜기·끄기·재시작만 있었다. 플레이어에게 「지금 새 판을 확인하라」고
    시키는 길(`update-now/{code}`)이 화면에 없어서, 새 판을 올려도 각 장비가
    스스로 확인할 때까지 기다려야 했다.

    [등록·수정·삭제가 없었다]

    목록과 원격 명령뿐이었다. 기기를 새로 놓거나 다른 호실로 옮기는 일을
    포털에서 할 수 없었다 — 클라이언트에는 넷 다 있었고 부르는 곳만 없었다.

    [화면 표시 설정 · 장식 · 문구를 고칠 자리가 없었다]

    목록과 원격 명령(켜기·끄기·재시작)뿐이었다. 그런데 **플레이어가 무엇을
    어떻게 보여 줄지는 전부 장비 속성(`device-attribute`)이 정한다** —
    가로·세로, 영정사진 효과, 영상·음악, 층별 안내, 키오스크 동작까지.
    포털 어느 화면에서도 그 값을 볼 수도 고칠 수도 없었다.
    화면 위에 얹는 **장식(리본)과 문구**도 마찬가지였다.
    클라이언트에는 셋 다 읽기·저장이 있었고 부르는 곳만 없었다.

    [장비 유형에 맞는 것을 앞에 둔다]

    속성이 마흔 칸이 넘는다. 영정사진 장비를 보면서 키오스크·층별 안내 설정이
    다 나오면, 실제로 쓰는 열 칸을 찾아 훑어야 한다. 유형에 해당하는 묶음을
    앞에 두고 나머지는 뒤로 내린다.

    **숨기지는 않는다.** 유형을 잘못 넣은 장비를 고칠 길은 남아 있어야 한다.

    [속성이 없는 장비가 있다]

    한 번도 설정하지 않은 장비는 속성 행 자체가 없다. 그때는 빈 화면이 아니라
    **기본값을 채운 새 속성**을 만들어 보여 준다 — 「없다」와 「못 읽었다」를
    사용자가 구분할 수 없고, 어차피 저장하면 만들어질 값이다.
*@

@inherits DataPage
@inject FuneralApi Api

<PageTitle>기기 관리 · 장례식장</PageTitle>

<PageHeading Title="기기 관리" Scope="장례식장" />

<BuildingFilter @bind-BuildingId="_buildingId" @bind-FloorId="_floorId" @bind-RoomId="_roomId"
                ShowFloor="true" ShowRoom="true" Search="@ReloadAsync">
    <PermissionView Action="MenuAction.Create">
        <DxButton Text="기기 등록" RenderStyle="ButtonRenderStyle.Success" Click="@OpenNew" />
    </PermissionView>
</BuildingFilter>

<div class="jsini-stats">
    <div class="jsini-stat">
        <div class="jsini-stat__label">전체</div>
        <div class="jsini-stat__value">@_devices.Count</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">온라인</div>
        <div class="jsini-stat__value">@_devices.Count(d => d.Status == "ONLINE")</div>
    </div>
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<DxGrid Data="@_devices" ShowFilterRow="false" PageSize="20"
        SelectionMode="GridSelectionMode.Single"
        SelectedDataItemChanged="@(item => SelectAsync(item as Device))">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(Device.Code)" Caption="코드" Width="120" />
        <DxGridDataColumn FieldName="@nameof(Device.Name)" Caption="기기명" MinWidth="160" />
        <DxGridDataColumn FieldName="@nameof(Device.RoomName)" Caption="호실" Width="130" />
        <DxGridDataColumn FieldName="@nameof(Device.DeviceType)" Caption="종류" Width="110">
            <CellDisplayTemplate>
                @{ var d = (Device)context.DataItem; }
                <span>@TypeName(d.DeviceType)</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(Device.IpAddress)" Caption="IP" Width="140" />
        <DxGridDataColumn FieldName="@nameof(Device.Status)" Caption="상태" Width="100">
            <CellDisplayTemplate>
                @{ var d = (Device)context.DataItem; }
                <span class="jsini-badge @(d.Status == "ONLINE" ? "jsini-badge--on" : "jsini-badge--off")">
                    @(d.Status == "ONLINE" ? "온라인" : "오프라인")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(Device.LastSeenAt)" Caption="최근 연결" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn Caption="관리" Width="130" AllowSort="false">
            <CellDisplayTemplate>
                @{ var d = (Device)context.DataItem; }
                <div class="d-flex gap-1">
                    <PermissionView Action="MenuAction.Update">
                        <DxButton Text="수정" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => OpenEdit(d))" />
                    </PermissionView>
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton Text="삭제" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => DeleteAsync(d))" />
                    </PermissionView>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="원격" Width="270">
            <CellDisplayTemplate>
                @{ var d = (Device)context.DataItem; }
                <PermissionView Action="MenuAction.Update">
                    <div class="d-flex gap-1">
                        @* 화면 전원은 DB 에 남지 않는 즉시 명령이다. *@
                        <DxButton Text="켜기" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => PowerAsync(d.Code, "ON"))" />
                        <DxButton Text="끄기" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => PowerAsync(d.Code, "OFF"))" />
                        <DxButton Text="재시작" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => RestartAsync(d.Code))" />
                        @* 새 판이 없으면 아무 일도 일어나지 않는다 — 릴리스 판정은
                           플레이어가 스스로 한다. 그래서 확인 창을 두지 않는다. *@
                        <DxButton Text="업데이트" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => UpdateNowAsync(d.Code))" />
                    </div>
                </PermissionView>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

<DeviceEditor @bind-Visible="_editing" DeviceId="@_editingId" OnSaved="@ReloadAsync" />

@if (_selected is null)
{
    <PageNotice Text="기기를 고르면 화면 표시 설정이 나옵니다." Tone="NoticeTone.Info" />
}
else if (_attribute is not null)
{
    <h2 class="fn-subhead">
        @_selected.Name · 화면 표시 설정
        <span class="fn-note">@TypeName(_selected.DeviceType)</span>
    </h2>

    <div class="jsini-toolbar">
        <PermissionView Action="MenuAction.Update">
            <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Success" Click="@SaveAttributeAsync" />
        </PermissionView>
        <DxButton Text="되돌리기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => SelectAsync(_selected))" />

        @if (_isNewAttribute)
        {
            <span class="fn-note">아직 설정이 없는 기기입니다. 저장하면 만들어집니다.</span>
        }
    </div>

    @foreach (var section in Sections(_selected.DeviceType))
    {
        <section class="fn-devsec @(section.Relevant ? "is-on" : string.Empty)">
            <h3 class="fn-devsec__head">
                @section.Label
                @if (!section.Relevant)
                {
                    @* 이 유형에서는 안 쓰는 묶음이다. 숨기지 않는 이유는
                       유형을 잘못 넣은 장비를 고칠 길이 필요하기 때문이다. *@
                    <span class="fn-note">이 기기 종류에서는 쓰지 않습니다</span>
                }
            </h3>

            <div class="fn-devsec__body">
                @switch (section.Key)
                {
                    case "layout":
                        <DeviceField Label="화면 방향">
                            <DxComboBox Data="@Orientations" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.DisplayOrientation" />
                        </DeviceField>
                        <DeviceField Label="세로 배치">
                            <DxComboBox Data="@Alignments" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.PortraitOrientation" />
                        </DeviceField>
                        <DeviceField Label="전환 간격(초)">
                            <DxSpinEdit @bind-Value="_attribute.ContentIntervalSec" MinValue="1" MaxValue="3600" />
                        </DeviceField>
                        <DeviceField Label="화면 보호기">
                            <DxCheckBox @bind-Checked="_attribute.IsScreensaverEnabled">켬</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="보호기 대기(초)">
                            <DxSpinEdit @bind-Value="_attribute.ScreensaverTimeoutSec" MinValue="0" MaxValue="86400" />
                        </DeviceField>
                        <DeviceField Label="여백 (상·하·좌·우)">
                            <div class="fn-quad">
                                <DxSpinEdit @bind-Value="_attribute.DisplayPaddingTop" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.DisplayPaddingBottom" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.DisplayPaddingLeft" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.DisplayPaddingRight" MinValue="0" />
                            </div>
                        </DeviceField>
                        break;

                    case "memorial":
                        <DeviceField Label="영정사진">
                            <DxCheckBox @bind-Checked="_attribute.IsMemorialPhotoEnabled">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="전환 효과">
                            <DxComboBox Data="@PhotoEffects" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.MemorialPhotoEffect" />
                        </DeviceField>
                        <DeviceField Label="세로 정렬">
                            <DxComboBox Data="@VerticalAligns" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.PhotoVerticalAlignment" />
                        </DeviceField>
                        <DeviceField Label="가로 정렬">
                            <DxComboBox Data="@HorizontalAligns" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.PhotoHorizontalAlignment" />
                        </DeviceField>
                        <DeviceField Label="고인 이름">
                            <DxCheckBox @bind-Checked="_attribute.IsDeceasedNameVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="상주 연락처">
                            <DxCheckBox @bind-Checked="_attribute.IsFamilyContactVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="비율 유지">
                            <DxCheckBox @bind-Checked="_attribute.IsMemorialPhotoKeepAspectRatio">유지</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="사진 여백 (상·하·좌·우)">
                            <div class="fn-quad">
                                <DxSpinEdit @bind-Value="_attribute.MemorialPaddingTop" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.MemorialPaddingBottom" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.MemorialPaddingLeft" MinValue="0" />
                                <DxSpinEdit @bind-Value="_attribute.MemorialPaddingRight" MinValue="0" />
                            </div>
                        </DeviceField>
                        break;

                    case "media":
                        <DeviceField Label="영상">
                            @* 「켬」과 「무엇을」이 짝이다. 자료를 고르면 켜 주고,
                               지우면 꺼 준다 — 켜 두고 빈 화면이 나오는 일을 막는다. *@
                            <DxComboBox Data="@_videos" TextFieldName="@nameof(MediaSource.Name)"
                                        ValueFieldName="@nameof(MediaSource.Id)"
                                        Value="@_attribute.VideoId"
                                        ValueChanged="@((string? v) => PickVideo(v))"
                                        NullText="쓰지 않음"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DeviceField>
                        <DeviceField Label="영상 방향">
                            <DxComboBox Data="@Alignments" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.VideoOrientation" />
                        </DeviceField>
                        <DeviceField Label="음악">
                            <DxComboBox Data="@_audios" TextFieldName="@nameof(MediaSource.Name)"
                                        ValueFieldName="@nameof(MediaSource.Id)"
                                        Value="@_attribute.MusicId"
                                        ValueChanged="@((string? v) => PickMusic(v))"
                                        NullText="쓰지 않음"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DeviceField>
                        <DeviceField Label="음량">
                            <DxSpinEdit Value="@(_attribute.MusicVolume ?? 50)"
                                        ValueChanged="@((int v) => _attribute.MusicVolume = v)"
                                        MinValue="0" MaxValue="100" />
                        </DeviceField>
                        <DeviceField Label="배경 이미지">
                            <DxComboBox Data="@_backgrounds" TextFieldName="@nameof(MediaSource.Name)"
                                        ValueFieldName="@nameof(MediaSource.Id)"
                                        Value="@_attribute.BackgroundImageId"
                                        ValueChanged="@((string? v) => PickBackground(v))"
                                        NullText="쓰지 않음"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DeviceField>
                        <DeviceField Label="배경 방향">
                            <DxComboBox Data="@Alignments" TextFieldName="Name" ValueFieldName="Code"
                                        @bind-Value="_attribute.BackgroundOrientation" />
                        </DeviceField>
                        <DeviceField Label="반복 · 음소거">
                            <div class="d-flex gap-2">
                                <DxCheckBox @bind-Checked="_attribute.IsMediaLoop">반복</DxCheckBox>
                                <DxCheckBox @bind-Checked="_attribute.IsMuted">음소거</DxCheckBox>
                            </div>
                        </DeviceField>
                        break;

                    case "floorGuide":
                        <DeviceField Label="층별 안내">
                            <DxCheckBox @bind-Checked="_attribute.IsFloorGuideEnabled">켬</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="배정 호실 표시">
                            <DxCheckBox @bind-Checked="_attribute.IsRoomAssignmentVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="사용 중만">
                            <DxCheckBox @bind-Checked="_attribute.IsActiveRoomsOnly">사용 중인 호실만</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="갱신 간격(초)">
                            <DxSpinEdit @bind-Value="_attribute.FloorGuideRefreshSec" MinValue="1" MaxValue="3600" />
                        </DeviceField>
                        break;

                    case "kiosk":
                        <DeviceField Label="터치">
                            <DxCheckBox @bind-Checked="_attribute.IsTouchEnabled">허용</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="QR 코드">
                            <DxCheckBox @bind-Checked="_attribute.IsQrCodeVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="건물 안내도">
                            <DxCheckBox @bind-Checked="_attribute.IsBuildingMapVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="공지">
                            <DxCheckBox @bind-Checked="_attribute.IsNoticeVisible">표시</DxCheckBox>
                        </DeviceField>
                        <DeviceField Label="공지 흐름 속도">
                            <DxSpinEdit @bind-Value="_attribute.NoticeScrollSpeed" MinValue="0" MaxValue="100" />
                        </DeviceField>
                        <DeviceField Label="입구 인사말" Wide="true">
                            <DxTextBox @bind-Text="_attribute.EntranceGreeting" NullText="예: 조문객 여러분을 맞이합니다" />
                        </DeviceField>
                        break;

                    case "remark":
                        <DeviceField Label="비고" Wide="true">
                            <DxTextBox @bind-Text="_attribute.Remark" />
                        </DeviceField>
                        break;
                }
            </div>
        </section>
    }

    @* 장식과 문구는 속성과 저장 경로가 다르다(각자 통째로 바꿔 끼운다).
       그래서 부품으로 갈라 각자 저장 단추를 들고 있게 했다 — 한 단추로
       셋을 함께 보내면 하나가 실패했을 때 무엇이 저장됐는지 알 수 없다. *@
    <DeviceConfigEditor DeviceId="@_selected.Id" />
    <DeviceRibbonEditor DeviceId="@_selected.Id" />
    <DeviceOverlayEditor DeviceId="@_selected.Id" />
}

@code {
    /// <summary>속성 묶음 하나. <c>Relevant</c> 는 이 장비 유형이 쓰는 묶음인가.</summary>
    private sealed record AttributeSection(string Key, string Label, bool Relevant);

    private sealed record Option(string Code, string Name);

    /// <summary>
    /// 묶음별로 어느 장비 유형이 쓰는가. 비우면 모든 유형이 쓴다.
    ///
    /// <b>배경 이미지는 영정사진 장비도 쓴다</b> — 그래서 media 묶음에 유형이 둘이다.
    /// </summary>
    private static readonly (string Key, string Label, string[] Types)[] SectionDefs =
    [
        ("layout", "화면 배치", []),
        ("memorial", "영정사진 · 추모", ["FUNERAL_PORTRAIT"]),
        ("media", "사진 · 영상 · 음악", ["MULTIMEDIA", "FUNERAL_PORTRAIT", "DID"]),
        ("floorGuide", "층별 안내판", ["ROOM_GUIDE"]),
        ("kiosk", "입구 정보 · 키오스크", ["KIOSK", "ENTRANCE_GUIDE"]),
        ("remark", "비고", []),
    ];

    private static readonly Option[] Orientations =
    [
        new("LANDSCAPE", "가로"),
        new("PORTRAIT", "세로"),
    ];

    private static readonly Option[] Alignments =
    [
        new("HORIZONTAL", "가로"),
        new("VERTICAL", "세로"),
    ];

    private static readonly Option[] PhotoEffects =
    [
        new("FADE", "페이드"),
        new("SLIDE", "슬라이드"),
        new("NONE", "없음"),
    ];

    private static readonly Option[] VerticalAligns =
    [
        new("TOP", "위"),
        new("CENTER", "가운데"),
        new("BOTTOM", "아래"),
    ];

    private static readonly Option[] HorizontalAligns =
    [
        new("LEFT", "왼쪽"),
        new("CENTER", "가운데"),
        new("RIGHT", "오른쪽"),
    ];

    private static readonly Dictionary<string, string> TypeNames = new(StringComparer.Ordinal)
    {
        ["FUNERAL_PORTRAIT"] = "영정사진",
        ["MULTIMEDIA"] = "멀티미디어",
        ["ROOM_GUIDE"] = "층별 안내",
        ["ENTRANCE_GUIDE"] = "입구 안내",
        ["KIOSK"] = "키오스크",
        ["DID"] = "DID",
    };

    private string? _buildingId;
    private string? _floorId;
    private string? _roomId;
    private IReadOnlyList<Device> _devices = [];

    private bool _editing;
    private string? _editingId;

    private Device? _selected;
    private DeviceAttribute? _attribute;
    private bool _isNewAttribute;

    private IReadOnlyList<MediaSource> _videos = [];
    private IReadOnlyList<MediaSource> _audios = [];
    private IReadOnlyList<MediaSource> _backgrounds = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _selected = null;
        _attribute = null;

        // **이름을 붙여 넘긴다.** 첫 인자가 `companyId` 라, 자리로 넘기면
        // 건물이 회사 자리에 들어가 조건이 통째로 어긋난다. 실제로 그랬다 —
        // 건물·층·호실을 골라도 목록이 줄지 않았고, 화면만 보면 알 수 없다.
        _devices = await Api.GetDevicesAsync(
            buildingId: _buildingId, floorId: _floorId, roomId: _roomId);
        return _devices.Count;
    }, "조건에 맞는 기기가 없습니다.", "기기 목록을 읽지 못했습니다");

    /// <summary>
    /// 고른 기기의 화면 표시 설정.
    ///
    /// 자료 목록은 <b>처음 한 번만</b> 읽는다 — 기기를 바꿀 때마다 다시 읽으면
    /// 목록을 훑는 동안 같은 세 요청이 계속 나간다.
    /// </summary>
    private Task SelectAsync(Device? device)
    {
        _selected = device;
        _attribute = null;

        if (device is null)
        {
            return Task.CompletedTask;
        }

        return LoadAsync(async () =>
        {
            if (_videos.Count == 0 && _audios.Count == 0 && _backgrounds.Count == 0)
            {
                var videos = Api.GetMediaSourcesAsync("VIDEO");
                var audios = Api.GetMediaSourcesAsync("AUDIO");
                var backgrounds = Api.GetMediaSourcesAsync("BACKGROUND");

                await Task.WhenAll(videos, audios, backgrounds);

                _videos = videos.Result;
                _audios = audios.Result;
                _backgrounds = backgrounds.Result;
            }

            var saved = await Api.GetDeviceAttributeAsync(device.Id);

            // 한 번도 설정하지 않은 기기는 속성 행이 없다. 빈 화면 대신
            // 기본값을 채운 새 속성을 보여 준다 — 어차피 저장하면 만들어진다.
            _isNewAttribute = saved is null;
            _attribute = saved ?? Defaults(device.Id);

            return 1;
        }, "설정을 읽지 못했습니다.", "설정을 읽지 못했습니다");
    }

    private static DeviceAttribute Defaults(string deviceId) => new()
    {
        DeviceId = deviceId,
        DisplayOrientation = "LANDSCAPE",
        PortraitOrientation = "HORIZONTAL",
        VideoOrientation = "HORIZONTAL",
        BackgroundOrientation = "HORIZONTAL",
        ContentIntervalSec = 10,
        ScreensaverTimeoutSec = 300,
        MemorialPhotoEffect = "FADE",
        PhotoVerticalAlignment = "TOP",
        PhotoHorizontalAlignment = "CENTER",
        IsDeceasedNameVisible = true,
        IsMediaLoop = true,
        FloorGuideRefreshSec = 60,
        MusicVolume = 50,
    };

    private async Task SaveAttributeAsync()
    {
        if (_attribute is null)
        {
            return;
        }

        var saved = await RunAsync(
            () => Api.UpsertDeviceAttributeAsync(_attribute),
            "저장했습니다. 플레이어가 다음 갱신 때 반영합니다.",
            "설정을 저장하지 못했습니다");

        if (saved)
        {
            await SelectAsync(_selected);
        }
    }

    // ── 자료를 고르면 켜고, 지우면 끈다 ─────────────────────
    //
    // 「켬」 스위치와 「무엇을」이 따로 놀면 켜 둔 채 빈 화면이 나온다.
    // 실제로 옛 화면이 그 짝을 손으로 맞추고 있었다.

    private void PickVideo(string? id)
    {
        _attribute!.VideoId = id;
        _attribute.IsVideoEnabled = !string.IsNullOrEmpty(id);
    }

    private void PickMusic(string? id)
    {
        _attribute!.MusicId = id;
        _attribute.IsMusicEnabled = !string.IsNullOrEmpty(id);
    }

    private void PickBackground(string? id)
    {
        _attribute!.BackgroundImageId = id;
        _attribute.IsBackgroundImageEnabled = !string.IsNullOrEmpty(id);
    }

    /// <summary>유형에 해당하는 묶음이 앞, 무관한 묶음이 뒤.</summary>
    private static List<AttributeSection> Sections(string? deviceType)
    {
        var relevant = new List<AttributeSection>();
        var others = new List<AttributeSection>();

        foreach (var (key, label, types) in SectionDefs)
        {
            var hit = types.Length == 0 || types.Contains(deviceType ?? string.Empty, StringComparer.Ordinal);
            (hit ? relevant : others).Add(new AttributeSection(key, label, hit));
        }

        return [.. relevant, .. others];
    }

    private static string TypeName(string? code) =>
        code is not null && TypeNames.TryGetValue(code, out var name) ? name : code ?? string.Empty;

    private void OpenNew()
    {
        _editingId = null;
        _editing = true;
    }

    private void OpenEdit(Device device)
    {
        _editingId = device.Id;
        _editing = true;
    }

    /// <summary>
    /// 기기를 지운다.
    ///
    /// 화면 표시 설정·장식·문구가 이 기기에 딸려 있다. 서버가 함께 정리하거나
    /// 남은 것이 있으면 막는다 — 화면이 미리 지우려 들지 않는다.
    /// </summary>
    private async Task DeleteAsync(Device device)
    {
        if (await RunAsync(() => Api.DeleteDeviceAsync(device.Id),
                $"{device.Name} 을 지웠습니다.", "지우지 못했습니다"))
        {
            if (string.Equals(_selected?.Id, device.Id, StringComparison.Ordinal))
            {
                _selected = null;
                _attribute = null;
            }

            await ReloadAsync();
        }
    }

    private Task PowerAsync(string code, string state) => RunAsync(
        () => Api.SetDeviceScreenPowerAsync(code, state),
        $"{code} 화면을 {(state == "ON" ? "켜" : "꺼")}도록 보냈습니다.",
        "명령을 보내지 못했습니다");

    private Task RestartAsync(string code) => RunAsync(
        () => Api.RestartDeviceAppAsync(code),
        $"{code} 플레이어를 다시 시작하도록 보냈습니다.",
        "명령을 보내지 못했습니다");

    /// <summary>
    /// 플레이어에게 지금 새 판을 확인하라고 시킨다.
    ///
    /// 서버는 파일을 나르지 않는다 — 릴리스 조회와 판정을 플레이어가 스스로
    /// 한다. 새 판이 없으면 아무 일도 일어나지 않으므로 확인 창을 두지 않는다.
    /// </summary>
    private Task UpdateNowAsync(string code) => RunAsync(
        () => Api.UpdateDeviceNowAsync(code),
        $"{code} 에 새 판 확인을 보냈습니다. 새 판이 없으면 그대로 둡니다.",
        "명령을 보내지 못했습니다");
}
