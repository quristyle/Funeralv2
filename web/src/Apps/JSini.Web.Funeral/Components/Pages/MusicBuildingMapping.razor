@page "/funeral/building/music-build"
@attribute [RouteKey("funeral.building.music-build")]

@* [건물별 음원] — DB 메뉴 `/building/music-build`. 음원 하나를 고르면 모든 건물이 배정 여부와 함께 온다. 배정된 건물만 받으면 빠진 건물을 따로 구해야 한다.
저장은 통째로 바꾼다. 목록에 없는 건물은 배정이 풀린다. *@

@inherits DataPage

<PageTitle>건물별 음원 · 장례식장</PageTitle>

@* 조건은 음원 하나다. 전체 선택·해제와 배정 저장은 이 화면의 동작이라 판의 Actions 에 둔다. *@
<CommSch OnSearch="@LoadMappingAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="음원">
            <DxComboBox Data="@_musics" @bind-Value="_musicId"
                        TextFieldName="@nameof(MediaSource.Name)" ValueFieldName="@nameof(MediaSource.Id)"
                        Style="width: 260px" />
        </CommSchItem>
    </Fields>

    <Actions>
        @* 건물이 스물을 넘는 곳이 있어, 하나씩 누르는 것과 「전부 켜고 몇 개만 끄는 것」은 손이 크게 다르다. *@
        @if (_musicId is not null && _mappings.Count > 0)
        {
            <span class="jsini-badge">@_mappings.Count(m => m.Mapped) / @_mappings.Count</span>

            <DxButton Text="전체 선택" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => ToggleAll(true))" />
            <DxButton Text="전체 해제" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => ToggleAll(false))" />
        }

        <PermissionView Action="MenuAction.Update">
            <DxButton Text="배정 저장" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-check"
                      Enabled="@(_musicId is not null)" Click="@SaveAsync" />
        </PermissionView>
    </Actions>
</CommSch>

@if (_musicId is null)
{
    <PageNotice Text="음원을 먼저 고르십시오." />
}
else
{
    <CommCont>
    <CommGrd TItem="BuildingMusicMapping" Data="@_mappings" PageSize="20"
             ExportName="건물별음원"
             Reload="@LoadMappingAsync">
        <Columns>
            <DxGridDataColumn Caption="배정" Width="80">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (BuildingMusicMapping)cell.DataItem;
                    }
                    <DxCheckBox Checked="@m.Mapped" CheckedChanged="@((bool v) => m.Mapped = v)" />
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(BuildingMusicMapping.BuildingName)" Caption="건물" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(BuildingMusicMapping.BuildingShortName)" Caption="약칭" Width="120" />
            <DxGridDataColumn FieldName="@nameof(BuildingMusicMapping.Address)" Caption="주소" MinWidth="240" />
        </Columns>
    </CommGrd>
    </CommCont>
}
