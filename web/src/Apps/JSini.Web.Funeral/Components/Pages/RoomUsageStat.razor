@page "/funeral/stat/room-usage"

@*
    [호실 사용 내역] — DB 메뉴 `/stat/room-usage`.
    이력: Vue `views/funeral/stat/room-usage/index` → 여기.
*@

@inherits DataPage
@inject FuneralApi Api

<PageTitle>호실 사용 내역 · 장례식장</PageTitle>

<PageHeading Title="호실 사용 내역" Scope="장례식장" />

<BuildingFilter @bind-BuildingId="_buildingId" @bind-RoomId="_roomId" ShowRoom="true" Search="@ReloadAsync">
    <DxDateEdit @bind-Date="_from" NullText="시작일" Style="width: 150px" />
    <DxDateEdit @bind-Date="_to" NullText="종료일" Style="width: 150px" />
</BuildingFilter>

<DxGrid Data="@_rows" ShowFilterRow="false" PageSize="20">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(RoomUsage.BuildingName)" Caption="건물" Width="140" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.RoomName)" Caption="호실" Width="120" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.DeceasedName)" Caption="고인" MinWidth="120" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.StartTime)" Caption="입실" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.EndTime)" Caption="퇴실" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.UseDays)" Caption="사용일" Width="90" />
        <DxGridDataColumn FieldName="@nameof(RoomUsage.BillingAmount)" Caption="금액" Width="130" DisplayFormat="N0" />
        <DxGridDataColumn Caption="상태" Width="100">
            <CellDisplayTemplate>
                @{
                    var u = (RoomUsage)context.DataItem;
                }
                <span class="jsini-badge @(u.InUse ? "jsini-badge--on" : "jsini-badge--off")">
                    @(u.InUse ? "사용 중" : "종료")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

<PageNotice Text="@Notice" Tone="@Tone" />

@code {
    private string? _buildingId;
    private string? _roomId;
    private DateTime? _from;
    private DateTime? _to;

    private IReadOnlyList<RoomUsage> _rows = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _rows = await Api.GetRoomUsageStatsAsync(_buildingId, _roomId, _from, _to);
        return _rows.Count;
    }, "조건에 맞는 자료가 없습니다.", "사용 내역을 읽지 못했습니다");
}
