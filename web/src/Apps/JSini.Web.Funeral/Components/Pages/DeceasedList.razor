@page "/funeral/deceased"

@*
    [고인 관리] — DB 메뉴 `/building/deceased`.
    이력: Vue `views/funeral/building/deceased/index` → 여기.

    고인 자료를 등록하고 고친다. 고인 현황(`/funeral/status/deceased-status`)과
    쓰임이 다르다 — **그쪽은 진행 상태를 다루고(출상 처리), 여기는 인적 사항과
    호실 배정을 다룬다.**

    [등록도 수정도 할 수 없었다]

    호실 이동·발인·삭제만 있었다. 위 줄에 「등록하고 고친다」고 적혀 있었는데
    그 길이 어디에도 없었다 — **장례식장 업무의 시작이 여기라, 이것이 없으면
    나머지 화면이 전부 남이 넣어 준 자료만 보게 된다.**
    클라이언트에는 상세 읽기·저장이 이미 있었고 부르는 곳만 없었다.

    [호실 이동을 여기서 한다]

    배정만 바꾸고 인적 사항은 건드리지 않는다. 서버에 그 전용 통로가 따로
    있는 이유가 그것이다(`MoveDeceasedRoomAsync`) — 상세 저장으로 옮기면
    같은 요청에 이름·나이까지 실려 나가고, 그 사이에 다른 사람이 고친 값을 덮는다.
*@

@inherits DataPage
@inject FuneralApi Api

<PageTitle>고인 관리 · 장례식장</PageTitle>

<PageHeading Title="고인 관리" Scope="장례식장" />

<div class="jsini-toolbar">
    <DxTextBox @bind-Text="_keyword" NullText="고인명 검색" Style="width: 200px"
               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@ReloadAsync" />

    <PermissionView Action="MenuAction.Create">
        <DxButton Text="고인 등록" RenderStyle="ButtonRenderStyle.Success" Click="@OpenNew" />
    </PermissionView>
</div>

<DxGrid Data="@_rows" ShowFilterRow="false" PageSize="20">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(Deceased.Name)" Caption="고인" MinWidth="120" />
        <DxGridDataColumn Caption="성별" Width="80">
            <CellDisplayTemplate Context="cell">
                @(((Deceased)cell.DataItem).Gender == "FEMALE" ? "여" : "남")
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(Deceased.Age)" Caption="나이" Width="80" />
        <DxGridDataColumn FieldName="@nameof(Deceased.Religion)" Caption="종교" Width="110" />
        <DxGridDataColumn FieldName="@nameof(Deceased.RoomName)" Caption="호실" Width="130" />
        <DxGridDataColumn FieldName="@nameof(Deceased.DeathDate)" Caption="임종" Width="120" DisplayFormat="yyyy-MM-dd" />
        <DxGridDataColumn FieldName="@nameof(Deceased.FuneralDate)" Caption="발인" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />

        <DxGridDataColumn Caption="상태" Width="110">
            <CellDisplayTemplate Context="cell">
                @{
                    var d = (Deceased)cell.DataItem;
                }
                <span class="jsini-badge @StatusClass(d.Status)">@StatusText(d.Status)</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="호실 이동" Width="230">
            <CellDisplayTemplate Context="cell">
                @{
                    var d = (Deceased)cell.DataItem;
                }
                <PermissionView Action="MenuAction.Update">
                    <div class="d-flex gap-1">
                        @* 배정 가능한 호실만 나온다 — ACTIVE 이고 비어 있는 것.
                           전체 호실을 보여 주면 이미 찬 방을 고르게 된다. *@
                        <DxComboBox Data="@_available" Value="@GetTarget(d.Id)"
                                    ValueChanged="@((string? v) => SetTarget(d.Id, v))"
                                    ValueExpression="@(() => GetTarget(d.Id))"
                                    TextFieldName="@nameof(Room.Name)" ValueFieldName="@nameof(Room.Id)"
                                    NullText="옮길 호실" Style="width: 140px" />
                        <DxButton Text="이동" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => MoveAsync(d))" />
                    </div>
                </PermissionView>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="발인" Width="150" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @{
                    var d = (Deceased)cell.DataItem;
                }
                <PermissionView Action="MenuAction.Update">
                    @if (IsDeparted(d.Status))
                    {
                        @* 발인은 되돌릴 수 있다 — 서버가 그 길을 열어 두었다.
                           실수로 눌렀을 때 손쓸 방법이 있는 것과 없는 것은 다르다. *@
                        <DxButton Text="발인 취소" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => CancelDepartureAsync(d))" />
                    }
                    else
                    {
                        <DxButton Text="발인 처리" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => DepartAsync(d))" />
                    }
                </PermissionView>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="" Width="80" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @{
                    var d = (Deceased)cell.DataItem;
                }
                <div class="d-flex gap-1">
                    <PermissionView Action="MenuAction.Update">
                        <DxButton Text="수정" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => OpenEdit(d))" />
                    </PermissionView>
                    <PermissionView Action="MenuAction.Delete">
                        <DxButton Text="삭제" SizeMode="SizeMode.Small"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => DeleteAsync(d))" />
                    </PermissionView>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

<PageNotice Text="@Notice" Tone="@Tone" />

<DeceasedEditor @bind-Visible="_editing" DeceasedId="@_editingId" Rooms="@_available"
                OnSaved="@ReloadAsync" />

@code {
    /// <summary>
    /// 주소로 받은 검색어 (<c>?keyword=</c>).
    ///
    /// 빈소현황 카드에서 「고인 자료」로 건너올 때 그 고인의 이름을 실어 보낸다.
    /// 안 받으면 목록 맨 앞으로 떨어져 다시 찾아야 하고, 그러면 링크를 걸어 둔
    /// 뜻이 없다.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "keyword")]
    public string? Keyword { get; set; }

    private string? _keyword;

    private bool _editing;
    private string? _editingId;
    private IReadOnlyList<Deceased> _rows = [];
    private IReadOnlyList<Room> _available = [];

    /// <summary>줄마다 고른 이동 대상. 하나로 두면 한 줄에서 고른 값이 다른 줄에도 뜬다.</summary>
    private readonly Dictionary<string, string?> _targets = new(StringComparer.Ordinal);

    /// <summary>
    /// 주소가 바뀌어도 다시 읽는다. <c>OnInitializedAsync</c> 만 걸면 같은
    /// 화면에서 검색어만 바뀔 때 목록이 그대로다.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        if (!string.Equals(_appliedKeyword, Keyword, StringComparison.Ordinal))
        {
            _appliedKeyword = Keyword;
            _keyword = Keyword;
        }

        return ReloadAsync();
    }

    /// <summary>마지막으로 반영한 주소 검색어. 사용자가 칸을 고친 것을 덮지 않으려고 둔다.</summary>
    private string? _appliedKeyword;

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var query = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(_keyword)) query["keyword"] = _keyword;

        // 목록과 빈 호실을 나란히. 이동 드롭다운이 바로 채워져 있어야 한다.
        var rows = Api.GetDeceasedListAsync(query);
        var rooms = Api.GetAvailableRoomsAsync();

        await Task.WhenAll(rows, rooms);

        _rows = rows.Result;
        _available = rooms.Result;
        _targets.Clear();

        return _rows.Count;
    }, "조건에 맞는 고인 자료가 없습니다.", "고인 목록을 읽지 못했습니다");

    private void OpenNew()
    {
        _editingId = null;
        _editing = true;
    }

    private void OpenEdit(Deceased d)
    {
        _editingId = d.Id;
        _editing = true;
    }

    private string? GetTarget(string id) => _targets.GetValueOrDefault(id);

    private void SetTarget(string id, string? value) => _targets[id] = value;

    private async Task MoveAsync(Deceased d)
    {
        var target = GetTarget(d.Id);

        if (string.IsNullOrWhiteSpace(target))
        {
            Say("옮길 호실을 고르십시오.", NoticeTone.Warning);
            return;
        }

        if (await RunAsync(() => Api.MoveDeceasedRoomAsync(d.Id, target),
                $"{d.Name} 님을 옮겼습니다.", "호실을 옮기지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    /// <summary>
    /// 발인 처리.
    ///
    /// 호실이 비고 현황판에서 내려간다. <b>되돌릴 수 있다</b> —
    /// 그래서 확인 창을 따로 띄우지 않는다. 되돌릴 수 없는 일이었다면
    /// 한 번 더 물었을 것이다.
    /// </summary>
    private async Task DepartAsync(Deceased d)
    {
        if (await RunAsync(() => Api.DepartDeceasedAsync(d.Id),
                           $"{d.Name} 님을 발인 처리했습니다.", "발인 처리를 하지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    /// <summary>발인 취소. 호실이 다시 차고 현황판에 올라온다.</summary>
    private async Task CancelDepartureAsync(Deceased d)
    {
        if (await RunAsync(() => Api.CancelDeceasedDepartureAsync(d.Id),
                           $"{d.Name} 님의 발인을 되돌렸습니다.", "되돌리지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    /// <summary>
    /// 삭제.
    ///
    /// 발인 처리와 다르다 — 기록이 사라진다. 과금·호실 이력이 이 고인을
    /// 가리키고 있으면 서버가 막는다.
    /// </summary>
    private async Task DeleteAsync(Deceased d)
    {
        if (await RunAsync(() => Api.DeleteDeceasedAsync(d.Id),
                           $"{d.Name} 님의 기록을 지웠습니다.", "지우지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    /// <summary>발인이 끝난 상태인가.</summary>
    private static bool IsDeparted(string? status) =>
        status is "FUNERAL_DEPARTURE_COMPLETED" or "COMPLETED";

    private static string StatusText(string? status) => status switch
    {
        "FUNERAL_IN_PROGRESS" => "장례 중",
        "FUNERAL_DEPARTURE_COMPLETED" => "발인 완료",
        "COMPLETED" => "종료",
        _ => status ?? "-",
    };

    private static string StatusClass(string? status) => status switch
    {
        "FUNERAL_IN_PROGRESS" => "jsini-badge--warn",
        "FUNERAL_DEPARTURE_COMPLETED" or "COMPLETED" => "jsini-badge--on",
        _ => "",
    };
}
