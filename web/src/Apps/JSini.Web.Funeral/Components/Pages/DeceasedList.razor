@page "/funeral/deceased"
@attribute [RouteKey("funeral.deceased")]

@* [고인 관리] — DB 메뉴 `/building/deceased`. 인적 사항과 호실 배정을 다룬다. 진행 상태(출상)는 고인 현황 쪽이다.
호실 이동은 상세 저장과 따로 간다. 상세로 옮기면 그 사이 다른 사람이 고친 이름·나이를 덮는다(MoveDeceasedRoomAsync). 조회 조건 이름은 name 이다. keyword 로 보내면 조용히 무시되어 전체가 나온다. *@

@inherits DataPage

<PageTitle>고인 관리 · 장례식장</PageTitle>

<BuildingFilter @bind-BuildingId="_buildingId" @bind-FloorId="_floorId" @bind-RoomId="_roomId"
                ShowFloor="true" ShowRoom="true" Search="@ReloadAsync" SummaryExtra="@ConditionSummary">
    <ChildContent>
        <CommSchItem Label="고인명">
            <DxTextBox @bind-Text="_keyword" Style="width: 150px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@Statuses" TextFieldName="Name" ValueFieldName="Code"
                        @bind-Value="_status" Style="width: 140px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        @* 기간 둘은 접는다. 펼쳐도 같은 판 안에 들어온다. 도구줄을 따로 두면 「조회」가 어느 조건까지 거는지 갈린다. *@
        @if (_showDates)
        {
            <CommSchItem Label="입실">
                <DxDateEdit @bind-Date="_enterFrom"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <DxDateEdit @bind-Date="_enterTo"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </CommSchItem>

            <CommSchItem Label="발인">
                <DxDateEdit @bind-Date="_funeralFrom"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <DxDateEdit @bind-Date="_funeralTo"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </CommSchItem>
        }
    </ChildContent>

    <Actions>
        <DxButton Text="@(_showDates ? "기간 접기" : "기간 조건")"
                  RenderStyle="ButtonRenderStyle.Link" Click="@(() => _showDates = !_showDates)" />

        @if (_showDates)
        {
            <DxButton Text="기간 지우기" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-undo" Click="@ClearDatesAsync" />
        }

        <PermissionView Action="MenuAction.Create">
            <DxButton Text="고인 등록" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus" Click="@OpenNew" />
        </PermissionView>
    </Actions>
</BuildingFilter>

<CommCont>
    <CommGrd TItem="Deceased" Data="@_rows" PageSize="20"
             ExportName="고인"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(Deceased.Name)" Caption="고인" MinWidth="120" />
            <DxGridDataColumn Caption="성별" Width="80">
                <CellDisplayTemplate Context="cell">
                    @(((Deceased)cell.DataItem).Gender == "FEMALE" ? "여" : "남")
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(Deceased.Age)" Caption="나이" Width="80" />
            <DxGridDataColumn FieldName="@nameof(Deceased.Religion)" Caption="종교" Width="110" />
            <DxGridDataColumn FieldName="@nameof(Deceased.RoomName)" Caption="호실" Width="130" />
            <DxGridDataColumn FieldName="@nameof(Deceased.DeathDate)" Caption="임종" Width="120" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(Deceased.FuneralDate)" Caption="발인" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />

            <DxGridDataColumn Caption="상태" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var d = (Deceased)cell.DataItem;
                    }
                    <span class="jsini-badge @StatusClass(d.Status)">@StatusText(d.Status)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="호실 이동" Width="230">
                <CellDisplayTemplate Context="cell">
                    @{
                        var d = (Deceased)cell.DataItem;
                    }
                    <PermissionView Action="MenuAction.Update">
                        <div class="jsini-actions">
                            @* 배정 가능한 호실만(ACTIVE 이고 비어 있는 것). 찬 방을 고르지 않게 한다. *@
                            <DxComboBox Data="@_available" Value="@GetTarget(d.Id)"
                                        ValueChanged="@((string? v) => SetTarget(d.Id, v))"
                                        ValueExpression="@(() => GetTarget(d.Id))"
                                        TextFieldName="@nameof(Room.Name)" ValueFieldName="@nameof(Room.Id)"
                                        Style="width: 140px" />
                            <DxButton Text="이동" RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="@(() => MoveAsync(d))" />
                        </div>
                    </PermissionView>
                </CellDisplayTemplate>
            </DxGridDataColumn>

        </Columns>

        @* 관리 칸은 하나로 모았다. 호실 이동은 단추가 아니라 값을 고르는 칸이라 여기 넣지 않는다. *@
        <RowActions Context="d">
            <PermissionView Action="MenuAction.Update">
                @if (IsDeparted(d.Status))
                {
                    @* 발인은 되돌릴 수 있다. 실수로 눌렀을 때 손쓸 길이 있다는 것이 삭제와 다르다. *@
                    <DxButton IconCssClass="jsini-icon-undo" RenderStyle="ButtonRenderStyle.Link"
                              Title="발인을 되돌린다"
                              Click="@(() => CancelDepartureAsync(d))" />
                }
                else
                {
                    <DxButton IconCssClass="jsini-icon-export" RenderStyle="ButtonRenderStyle.Link"
                              Title="발인 처리한다"
                              Click="@(() => DepartAsync(d))" />
                }
            </PermissionView>

            <PermissionView Action="MenuAction.Update">
                <DxButton IconCssClass="jsini-icon-edit" Title="수정"
                          RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => OpenEdit(d))" />
            </PermissionView>
            <PermissionView Action="MenuAction.Delete">
                <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                          CssClass="commgrd__icon--warn"
                          RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => DeleteAsync(d))" />
            </PermissionView>
        </RowActions>
    </CommGrd>
</CommCont>

<DeceasedEditor @bind-Visible="_editing" DeceasedId="@_editingId" Rooms="@_available"
                OnSaved="@ReloadAsync" />
