@page "/funeral/setting/environment"
@attribute [RouteKey("funeral.setting.environment")]

@* [환경설정] — DB 메뉴 `/setting/environment`. 개인 환경설정이다. 업무 규칙은 업무 설정 화면이 다룬다.
알림은 「내 알림 설정」 화면이 다 다루므로 여기는 길잡이만 둔다. 테마·사이드바·탭도 헤더와 레이아웃이 고친다.
계정에 담기는지 브라우저에 남는지는 항목마다 다르다(PortalPrefs · PortalBoot 머리말). *@

@inherits DataPage
@implements IDisposable

<PageTitle>환경설정</PageTitle>

<div class="fn-env">

@* ── 알림 ── 고치는 자리는 「내 알림 설정」 하나다. 같은 스위치를 두 화면에 두면 어느 쪽에 저장되는지를 매번 고르게 된다. *@
<div class="fn-env__group">

<h2 class="jsini-subhead">알림</h2>

<section class="jsini-settings">
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">내 알림 설정</div>
            <div class="jsini-setting__desc">받을 알림 · 이 브라우저 등록 · 등록된 기기 · 내 위치 날씨는 「내 알림 설정」에서 고칩니다.</div>
        </div>

        <DxButton Text="내 알림 설정" RenderStyle="ButtonRenderStyle.Secondary"
                  NavigateUrl="/funeral/setting/notification" />
    </div>
</section>

</div>

@* ── 묶음마다 제 상자(fn-env__group) ── 넓은 화면에서 단으로 흘려 키를 맞춘다(funeral.css .fn-env). 한 상자가 길면 쪼갤 수 없다. *@

@* ── 홈 화면 ── 계정에 담기는 유일한 값이라 제목을 갈라 둔다. 홈을 안 고르면 로그인 뒤 이 화면으로 떠밀려 온다. *@
<div class="fn-env__group">

<h2 class="jsini-subhead">홈 화면</h2>

<section class="jsini-settings">
    <div class="jsini-setting">

        @* 고르개가 179건이라 글자를 쳐서 찾게 한다. Value 는 담긴 값이 아니라 고르개가 켤 줄이다. 지정 안 함 줄은 PortalHome.ToChoice 가 채운다. *@
        <DxComboBox Data="@HomeChoices"
                    TextFieldName="@nameof(PortalHomeChoice.Label)"
                    ValueFieldName="@nameof(PortalHomeChoice.Path)"
                    Value="@_homeChoice"
                    ValueChanged="@((string? path) => OnHomeChangedAsync(path))"
                    AllowUserInput="true"
                    SearchMode="ListSearchMode.AutoSearch"
                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                    NullText="지정 안 함 (환경설정 화면이 열립니다)"
                    CssClass="fn-home" />
    </div>
</section>

</div>

@* ── 화면 ── 테마·사이드바·탭은 헤더와 레이아웃이 고치므로 여기서는 토스트 위치만 고른다(넓은 화면에서도 뜨는 값). *@
<div class="fn-env__group">


<section class="jsini-settings">
    @* 토스트 위치는 테마 서랍에서 옮겨 왔다. 둘 다 두면 같은 조작이 두 자리에 생긴다. *@
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">알림(토스트) 위치</div>
        </div>

        <DxComboBox Data="@_toastPositions"
                    TextFieldName="@nameof(FabPosOption.Name)"
                    ValueFieldName="@nameof(FabPosOption.Value)"
                    Value="@_selectedToastPosition"
                    ValueChanged="@((string val) => OnToastPositionChangedAsync(val))"
                    Style="width: 160px;" />
    </div>
</section>

</div>

@* ── 상단 아이콘 ── 헤더의 빠른 도구 아이콘 사용 여부. 권한이 있는 아이콘만 목록에 나온다. *@
<div class="fn-env__group">


<section class="jsini-settings">
    @if (PermittedHeaderIcons.Count == 0)
    {
        <div class="jsini-setting">
            <div class="jsini-setting__desc text-muted">사용 가능한 상단 아이콘이 없습니다.</div>
        </div>
    }
    else
    {
        @foreach (var icon in PermittedHeaderIcons)
        {
            <div class="jsini-setting">
                <div>
                    <div class="jsini-setting__name">
                        @if (!string.IsNullOrWhiteSpace(icon.Icon))
                        {
                            <span class="@icon.Icon me-1" aria-hidden="true"></span>
                        }
                        @icon.Title
                    </div>
                    @if (!string.IsNullOrWhiteSpace(icon.Description))
                    {
                        <div class="jsini-setting__desc">@icon.Description</div>
                    }
                </div>

                <DxCheckBox CheckType="CheckType.Switch"
                            Checked="@HeaderIcons.IsIconEnabled(icon.IconKey)"
                            CheckedChanged="@((bool v) => OnHeaderIconToggledAsync(icon.IconKey, v))" />
            </div>
        }
    }
</section>

</div>

@* ── 휴대폰 ── 휴대폰에서만 보이는 줄들. 아래 모바일 하단 네비게이션은 줄이 아니라 판이라 따로 묶는다. *@
<div class="fn-env__group">


<section class="jsini-settings">

    @* 감추기를 위치 고르개보다 먼저 묻는다. 감춰도 헤더의 ☰ 는 되살리지 않는다. 로고(MainLayout.OnBrandClick)가 메뉴를 여는 길이라 그 길을 아래 설명에 적는다. *@
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">모바일 메뉴 단추 숨기기</div>
            <div class="jsini-setting__desc">
                감추면 메뉴는 <b>왼쪽 위 로고</b>로 엽니다. <b>계정에 저장되어 어느 기기에서나 같습니다</b>.
                @* 길게 누르기는 눌러 보기 전엔 모르는 손짓이라, 그 손짓이 여는 창이 다루는 줄 옆에 알려 준다. *@
                휴대폰에서는 <b>그 단추를 길게 눌러</b> 여기 설정을 바로 열 수 있습니다.
            </div>
        </div>

        <DxCheckBox CheckType="CheckType.Switch"
                    Checked="@_fabHidden"
                    CheckedChanged="@((bool v) => OnFabHiddenChangedAsync(v))" />
    </div>

    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">모바일 메뉴 단추 위치</div>
            <div class="jsini-setting__desc">
                <b>이 브라우저에만 남습니다</b>.
            </div>
        </div>

        @* 감춰 둔 동안은 잠근다. 고를 수 있게 두면 아무 일도 안 일어나는 조작이 된다. 값은 지우지 않는다. *@
        <DxComboBox Data="@_fabPositions"
                    TextFieldName="@nameof(FabPosOption.Name)"
                    ValueFieldName="@nameof(FabPosOption.Value)"
                    Value="@_selectedFabPosition"
                    ValueChanged="@((string val) => OnFabPositionChangedAsync(val))"
                    Enabled="@(!_fabHidden)"
                    Style="width: 160px;" />
    </div>

    @* 요청 등록 단추는 권한이 있는 사람에게만 묻는다. 열 수 없으면 단추가 안 그려지므로 줄도 없어야 한다(MainLayout.HelpDeskFabAllowed 와 같은 판정). *@
    @if (CanSetHelpDeskFab)
    {
        <div class="jsini-setting">
            <div>
                <div class="jsini-setting__name">헬프데스크 요청등록 단추 숨기기</div>
                <div class="jsini-setting__desc">
                    감춰도 메뉴에서는 그대로 들어갑니다. <b>계정에 저장되어 어느 기기에서나 같습니다</b>.
                    휴대폰에서는 <b>그 단추를 길게 눌러</b> 여기 설정을 바로 열 수 있습니다.
                </div>
            </div>

            <DxCheckBox CheckType="CheckType.Switch"
                        Checked="@_helpDeskFabHidden"
                        CheckedChanged="@((bool v) => OnHelpDeskFabHiddenChangedAsync(v))" />
        </div>

        @* 넓은 화면에서도 띄울지는 감추기 아래, 위치 위에 묻는다. 감춘 동안은 잠근다(값은 지우지 않는다). *@
        <div class="jsini-setting">
            <div>
                <div class="jsini-setting__name">헬프데스크 요청등록 단추 — 넓은 화면에도 표시</div>
                <div class="jsini-setting__desc">
                    끄면 <b>휴대폰에서만</b> 뜹니다. 켜면 책상 화면 오른쪽 아래에도
                    같은 단추가 떠서 요청 등록으로 바로 갑니다.
                    <b>이 브라우저에만 남습니다</b>.
                </div>
            </div>

            <DxCheckBox CheckType="CheckType.Switch"
                        Checked="@_helpDeskFabDesktop"
                        Enabled="@(!_helpDeskFabHidden)"
                        CheckedChanged="@((bool v) => OnHelpDeskFabDesktopChangedAsync(v))" />
        </div>

        <div class="jsini-setting">
            <div>
                <div class="jsini-setting__name">헬프데스크 요청등록 단추 위치</div>
                <div class="jsini-setting__desc">
                    <b>모바일 메뉴 단추와 같은 귀퉁이면 두 단추가 세로로 섭니다</b>.
                    <b>이 브라우저에만 남습니다</b>.
                </div>
            </div>

            @* 위 고르개와 같은 까닭으로 감춘 동안은 잠근다. *@
            <DxComboBox Data="@_helpDeskFabPositions"
                        TextFieldName="@nameof(FabPosOption.Name)"
                        ValueFieldName="@nameof(FabPosOption.Value)"
                        Value="@_selectedHelpDeskFabPosition"
                        ValueChanged="@((string val) => OnHelpDeskFabPositionChangedAsync(val))"
                        Enabled="@(!_helpDeskFabHidden)"
                        Style="width: 160px;" />
        </div>
    }

    @* 잠금 스위치만 기본이 켜짐이다. 두 손가락 확대는 되돌리기가 어려워 막은 채 시작한다. 저장은 반대말(풀었다)로 적고, 뒤집기는 OnZoomLockedChangedAsync 한 곳에서만 한다. *@
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">모바일 화면 확대 잠금</div>
            <div class="jsini-setting__desc">
                넓은 화면은 <b>이 스위치와 무관합니다</b>.
                <b>이 브라우저에만 남습니다</b>.
            </div>
        </div>

        <DxCheckBox CheckType="CheckType.Switch"
                    Checked="@(!_zoomUnlocked)"
                    CheckedChanged="@((bool v) => OnZoomLockedChangedAsync(v))" />
    </div>
</section>

</div>

@* ── 휴대폰 아래 띠 ── 스위치 하나가 아니라 판이라 제목을 따로 단다. 휴대폰에서만 보이므로 위 묶음 바로 아래에 둔다.
쓸지와 무엇을 놓을지는 계정에 담는다. 브라우저에 두면 기기마다 띠가 갈려 한 곳에서 고친 것이 다른 곳에 안 간다. *@
<div class="fn-env__group">

<section class="jsini-settings">
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">하단 네비게이션 사용</div>
            <div class="jsini-setting__desc">
                <b>계정에 저장되어 어느 기기에서나 같습니다</b> — 휴대폰을 바꾸거나 둘을 번갈아 써도
                같은 띠가 뜹니다.
            </div>
        </div>

        <DxCheckBox CheckType="CheckType.Switch"
                    Checked="@(!_bottomNavHidden)"
                    CheckedChanged="@((bool v) => OnBottomNavUsedChangedAsync(v))" />
    </div>

    @* 띠를 안 쓰면 잠근다. 아무 일도 안 일어나는 조작은 「안 먹는다」로 읽힌다. *@
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">아이콘만 보기 (라벨 숨김)</div>
            <div class="jsini-setting__desc">
                이름이 빠진 만큼 띠가 얇아지고(60px → 44px) <b>그만큼이 본문 세로 공간이 됩니다</b>.
            </div>
        </div>

        <DxCheckBox CheckType="CheckType.Switch"
                    Enabled="@(!_bottomNavHidden)"
                    Checked="@_bottomNavLabelsHidden"
                    CheckedChanged="@((bool v) => OnBottomNavLabelsHiddenChangedAsync(v))" />
    </div>

    @* 헤더 스위치는 띠가 아니라 헤더를 가리키므로 잠그지 않는다. 띠를 안 쓰는 사람도 헤더에는 쓸 수 있다. *@
    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">데스크탑 상단에 표시</div>
            <div class="jsini-setting__desc">
                넓은 화면(768px 이상)에서는 <b>같은 칸들이 헤더 오른쪽 도구 줄에 아이콘으로</b> 섭니다.
                자리가 좁아 이름은 빠지고 짚으면 뜹니다. <b>휴대폰 띠와 따로 켜고 끕니다</b>.
            </div>
        </div>

        <DxCheckBox CheckType="CheckType.Switch"
                    Checked="@(!_bottomNavDesktopHidden)"
                    CheckedChanged="@((bool v) => OnBottomNavDesktopUsedChangedAsync(v))" />
    </div>
</section>

@* 둘 다 끈 동안에만 통째로 잠근다. 한쪽만 꺼 두면 고른 칸이 헤더에서 여전히 쓰인다. *@
<div class="fn-bnav @(NavLocked ? "fn-bnav--off" : "")">

    @* 메뉴가 아닌 넷은 메뉴 줄기로 찾을 수 없어 단추로 내놓는다. 이미 놓은 것은 잠근다(같은 칸이 둘이면 띠에 같은 그림이 나란히 선다). *@
    <div class="fn-bnav__quick">
        <span class="jsini-hint">바로 넣기</span>

        @foreach (var quick in BottomNav.Fixed)
        {
            var pick = quick;

            <DxButton Text="@pick.Title" IconCssClass="@pick.Icon"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@CanQuickAdd(pick)"
                      Title="@pick.Label"
                      Click="@(() => OnNavQuickAddAsync(pick))" />
        }
    </div>

    @for (var i = 0; i < _navItems.Count; i++)
    {
        var index = i;
        var item = _navItems[index];

        <div class="fn-bnav__row">
            <span class="@BottomNav.IconClass(item, Menus.AllMenus) fn-bnav__icon"
                  aria-hidden="true"></span>

            <DxComboBox Data="@NavChoices"
                        TextFieldName="@nameof(BottomNavChoice.Label)"
                        ValueFieldName="@nameof(BottomNavChoice.Path)"
                        Value="@item.Path"
                        ValueChanged="@((string? path) => OnNavMenuChangedAsync(index, path))"
                        AllowUserInput="true"
                        SearchMode="ListSearchMode.AutoSearch"
                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                        Enabled="@(!NavLocked)"
                        CssClass="fn-bnav__menu" />

            <DxTextBox Text="@item.Title"
                       TextChanged="@((string? text) => OnNavTitleChangedAsync(index, text))"
                       BindValueMode="BindValueMode.OnLostFocus"
                       Enabled="@(!NavLocked)"
                       CssClass="fn-bnav__name" />

            @* 순서 단추는 글자 없이 아이콘만 쓴다(줄이 좁아 글자를 적으면 고르개가 눌린다). 꺾쇠는 하나뿐이고 위를 보는 것은 CSS 가 뒤집는다. 맨 위·아래에서는 잠근다. *@
            <DxButton IconCssClass="jsini-icon-chevron-down" Title="앞으로 (띠에서 왼쪽)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!NavLocked && index > 0)"
                      Click="@(() => OnNavMoveAsync(index, -1))"
                      CssClass="fn-bnav__move fn-bnav__move--up" />

            <DxButton IconCssClass="jsini-icon-chevron-down" Title="뒤로 (띠에서 오른쪽)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!NavLocked && index < _navItems.Count - 1)"
                      Click="@(() => OnNavMoveAsync(index, 1))"
                      CssClass="fn-bnav__move" />

            @* 바닥(BottomNav.MinItems)에서 잠근다. 빼기로 띠를 없앨 수 있게 두면 빈 띠와 꺼 둔 화면이 눈에 같아 보인다. *@
            <DxButton IconCssClass="jsini-icon-trash" Title="빼기" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!NavLocked && _navItems.Count > BottomNav.MinItems)"
                      Click="@(() => OnNavRemoveAsync(index))"
                      CssClass="fn-bnav__drop" />
        </div>
    }

    <div class="fn-bnav__actions">
        <DxButton Text="항목 추가" IconCssClass="jsini-icon-plus"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!NavLocked && _navItems.Count < BottomNav.MaxItems)"
                  Click="@OnNavAddAsync" />

        <DxButton Text="기본값으로" RenderStyle="ButtonRenderStyle.Link"
                  Enabled="@(!NavLocked)"
                  Click="@OnNavResetAsync" />

        @* 지금 몇 칸이고 어디까지 되는지. 잠긴 까닭을 말해 주는 유일한 숫자라 남긴다. *@
        <span class="jsini-hint fn-bnav__count">@NavCountText</span>
    </div>
</div>

</div>

<div class="fn-env__group">


<section class="jsini-settings">


    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">내 정보</div>
            <div class="jsini-setting__desc">이름·연락처·생일·비밀번호는 「내 정보」에서 고칩니다.</div>
        </div>

        <DxButton Text="내 정보" RenderStyle="ButtonRenderStyle.Secondary"
                  NavigateUrl="/admin/profile" />
    </div>

    <div class="jsini-setting">
        <div>
            <div class="jsini-setting__name">보낸 알림 이력</div>
            <div class="jsini-setting__desc">
                내게 온 알림이 언제 무엇이었는지는 포털관리의 「알림 이력」에서 봅니다.
            </div>
        </div>

        <DxButton Text="알림 이력" RenderStyle="ButtonRenderStyle.Secondary"
                  NavigateUrl="/admin/push/history" />
    </div>
</section>

</div>

</div>
