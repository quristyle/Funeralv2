@page "/funeral/help/archive"
@attribute [RouteKey("funeral.help.archive")]

@* [자료실] — DB 메뉴 `/help/archive`. 내려받기는 AuthServer 를 거친다. 서버가 횟수를 세고 FileServer 로 302 를 준다. FileServer 를 직접 가리키면 셀 수가 없다.
첨부는 두 단계다. 파일을 FileServer 에 올려 식별자를 받고, 자료의 files 목록에 담아 저장한다. files 는 보낸 그대로가 최종이라 빠진 것은 지워지므로 수정할 때 이미 매달린 것도 함께 보낸다.
컴포넌트 이름은 자료 타입과 겹치지 않게 둔다. 같은 이름이면 화면 안에서 자료 타입이 가려진다(아키텍처 테스트가 막는다). *@

@inherits DataPage

<PageTitle>자료실 · 장례식장</PageTitle>

@* 등록은 조건 옆이 아니라 판 안의 Actions 에 둔다. 조건과 동작이 한 줄에 섞이면 무엇이 조건인지 흐려진다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="자료명">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="분류">
            <DxComboBox Data="@_categories" @bind-Value="_category" Style="width: 150px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>

    <Actions>
        @if (_canManage)
        {
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="jsini-icon-plus" Click="@StartNew" />
            </PermissionView>
        }
    </Actions>
</CommSch>

<CommCont>
    <CommGrd TItem="Archive" Data="@_items" PageSize="20"
             ExportName="자료실"
             Reload="@ReloadAsync"
             RowActions="@(_canManage ? Manage : null)">
        <Columns>
            <DxGridDataColumn Caption="자료명" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (Archive)cell.DataItem;
                    }
                    @if (a.Status != 1)
                    {
                        <span class="jsini-badge jsini-badge--off">중지</span>
                    }
                    <span>@a.Title</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(Archive.Category)" Caption="분류" Width="130" />
            <DxGridDataColumn FieldName="@nameof(Archive.DownloadCount)" Caption="내려받기" Width="90" />
            <DxGridDataColumn FieldName="@nameof(Archive.CreatedAt)" Caption="등록일" Width="120" DisplayFormat="yyyy-MM-dd" />

            <DxGridDataColumn Caption="첨부" Width="80">
                <CellDisplayTemplate Context="cell">
                    @(((Archive)cell.DataItem).Files.Count) 개
                </CellDisplayTemplate>
            </DxGridDataColumn>

        </Columns>

        <DetailRowTemplate Context="detail">
            @{
                var archive = (Archive)detail.DataItem;
            }
            @* 설명은 HTML 이다. 서식 편집기로 쓴 것이라 정제해서 그린다 — 공지 본문과 같다. *@
            @if (!string.IsNullOrWhiteSpace(archive.Description))
            {
                <div class="fn-faq__a">@((MarkupString)NoticeHtml.Sanitize(archive.Description))</div>
            }

            @if (archive.Files.Count == 0)
            {
                <PageNotice Text="첨부된 파일이 없습니다." />
            }
            else
            {
                @* 서버가 준 DownloadUrl 은 쓰지 않는다(같은 오리진 주소라 포털에서 404). 셸이 중계하는 FileDownload 를 쓴다. *@
                <ul class="fn-files">
                    @foreach (var file in archive.Files)
                    {
                        <li class="fn-files__item">
                            <a href="@FileDownload.ArchiveUrlFor(archive.Id, file.FileId, file.FileName)">@file.FileName</a>
                            <span class="fn-files__size">@FormatSize(file.FileSize)</span>
                        </li>
                    }
                </ul>
            }
        </DetailRowTemplate>
    </CommGrd>
</CommCont>

@* ── 자료 정보 편집 ─────────────────────────────────── *@
<CommPopup @bind-Visible="_editing" HeaderText="@(_isNew ? "자료 등록" : "자료 수정")"
         Width="660">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="자료명" ColSpanMd="12">
                <DxTextBox @bind-Text="_edit.Title" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="분류" ColSpanMd="6">
                <DxComboBox Data="@_categories" @bind-Value="_edit.Category"
                            AllowUserInput="true"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="정렬" ColSpanMd="3">
                <DxSpinEdit @bind-Value="_edit.OrderNo" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="3">
                <DxCheckBox Checked="@(_edit.Status == 1)"
                            CheckedChanged="@((bool v) => _edit.Status = v ? 1 : 0)">
                    사용
                </DxCheckBox>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                @* 설명은 서식 편집기로 되돌렸다. 여러 줄 입력이면 저장된 태그가 글자로 보이고 줄바꿈이 사라진다. *@
                <DxHtmlEditor @bind-Markup="_edit.Description"
                              BindMarkupMode="HtmlEditorBindMarkupMode.OnDelayedInput"
                              CssClass="fn-editor" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="첨부" ColSpanMd="12">
                @* 이미 매달린 것. 여기서 빼고 저장하면 지워진다(서버가 보낸 목록을 그대로 최종으로 삼는다). *@
                @if (_attached.Count > 0)
                {
                    <ul class="fn-files">
                        @foreach (var file in _attached.ToList())
                        {
                            <li class="fn-files__item">
                                <span>@file.FileName</span>
                                <span class="fn-files__size">@FormatSize(file.FileSize)</span>
                                <DxButton Text="빼기"
                                          RenderStyle="ButtonRenderStyle.Link"
                                          Click="@(() => _attached.Remove(file))" />
                            </li>
                        }
                    </ul>
                }

                <FilePicker @ref="_picker"
                            MaxFiles="10"
                            MaxBytes="@(100L * 1024 * 1024)"
                            ShowHint="false"
                            FilesChanged="@(files => _picked = files)" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="@(_saving ? "저장 중…" : "저장")" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_saving)" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_saving)" Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>
    /// 관리 칸. <b>권한이 없으면 아예 주지 않는다</b> — 빈 조각을 주면
    /// CommGrd 가 「단추가 있다」고 보고 칸을 그려서, 자료만 보는 사람에게
    /// 빈 칸 하나가 남는다.
    /// </summary>
    private RenderFragment<Archive> Manage => a =>@<text>
        <PermissionView Action="MenuAction.Update">
            <DxButton IconCssClass="jsini-icon-edit" Title="수정"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => StartEdit(a))" />
        </PermissionView>
        <PermissionView Action="MenuAction.Delete">
            <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                      CssClass="commgrd__icon--warn"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => DeleteAsync(a))" />
        </PermissionView>
    </text>;
}
