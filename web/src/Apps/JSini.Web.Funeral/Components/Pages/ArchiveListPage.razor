@page "/funeral/help/archive"

@*
    [자료실] — DB 메뉴 `/help/archive`.
    이력: Vue `views/funeral/help/archive/index` → 여기.

    **내려받기는 AuthServer 를 거친다.** 서버가 횟수를 세고 FileServer 로 302 로
    넘긴다. FileServer 를 직접 가리키면 셀 수가 없다.

    [읽기만 하고 있었다 — 이제 자료 정보는 고칠 수 있다]

    등록·수정·삭제가 빠져 있었다. 클라이언트에는 메서드가 있었고 화면만 안
    부르고 있었다.

    [첨부 올리기 — D5]

    두 단계다. 파일을 FileServer 에 올려(`file/upload`) 식별자를 받고, 그것을
    자료의 `files` 목록에 담아 저장한다.

    **`files` 는 보낸 그대로가 최종이다** — 빠진 것은 지워진다(서버 DTO 주석).
    그래서 수정할 때는 **이미 매달린 것을 함께 실어 보내야** 한다. 안 그러면
    이름만 고쳤는데 첨부가 통째로 사라진다. 화면이 지금 매달린 목록을 들고
    있다가 새로 올린 것을 뒤에 붙여 보낸다. 첨부를 빼는 것도 같은 길이다 —
    목록에서 빼고 저장하면 없어진다.

    **파일 이름이 화면 이름과 다르다.** 컴포넌트 이름을 자료 타입과 같게 두면
    화면 안에서 자료 타입이 가려진다 — Razor 가 만드는 클래스가 같은
    네임스페이스에 있어 더 가깝기 때문이다. 아키텍처 테스트가 이 충돌을 막는다.
*@

@inherits DataPage
@inject HelpApi Api
@inject FileUploadClient Files

<PageTitle>자료실 · 장례식장</PageTitle>

<PageHeading Title="자료실" Scope="장례식장" />

<div class="jsini-toolbar">
    <DxTextBox @bind-Text="_keyword" NullText="자료명 검색" Style="width: 220px"
               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxComboBox Data="@_categories" @bind-Value="_category"
                NullText="분류 전체" Style="width: 150px"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />

    <div class="jsini-toolbar__spacer"></div>

    @if (_canManage)
    {
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                      IconCssClass="jsini-icon-plus" Click="@StartNew" />
        </PermissionView>
    }
</div>

<DxGrid Data="@_items" ShowFilterRow="false" ShowSearchBox="false" PageSize="20"
        DetailExpandButtonDisplayMode="GridDetailExpandButtonDisplayMode.Auto">
    <Columns>
        <DxGridDataColumn Caption="자료명" MinWidth="220">
            <CellDisplayTemplate Context="cell">
                @{
                    var a = (Archive)cell.DataItem;
                }
                @if (a.Status != 1)
                {
                    <span class="jsini-badge jsini-badge--off">중지</span>
                }
                <span>@a.Title</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(Archive.Category)" Caption="분류" Width="130" />
        <DxGridDataColumn FieldName="@nameof(Archive.DownloadCount)" Caption="내려받기" Width="90" />
        <DxGridDataColumn FieldName="@nameof(Archive.CreatedAt)" Caption="등록일" Width="120" DisplayFormat="yyyy-MM-dd" />

        <DxGridDataColumn Caption="첨부" Width="80">
            <CellDisplayTemplate Context="cell">
                @(((Archive)cell.DataItem).Files.Count) 개
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @if (_canManage)
        {
            <DxGridDataColumn Caption="관리" Width="120" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (Archive)cell.DataItem;
                    }
                    <div class="d-flex gap-1">
                        <PermissionView Action="MenuAction.Update">
                            <DxButton Text="수정" SizeMode="SizeMode.Small"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="@(() => StartEdit(a))" />
                        </PermissionView>
                        <PermissionView Action="MenuAction.Delete">
                            <DxButton Text="삭제" SizeMode="SizeMode.Small"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="@(() => DeleteAsync(a))" />
                        </PermissionView>
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }
    </Columns>
    <DetailRowTemplate Context="detail">
        @{
            var archive = (Archive)detail.DataItem;
        }
        @if (archive.Files.Count == 0)
        {
            <PageNotice Text="첨부된 파일이 없습니다." />
        }
        else
        {
            <ul class="fn-files">
                @foreach (var file in archive.Files)
                {
                    <li class="fn-files__item">
                        <a href="@file.DownloadUrl">@file.FileName</a>
                        <span class="fn-files__size">@FormatSize(file.FileSize)</span>
                    </li>
                }
            </ul>
        }
    </DetailRowTemplate>
</DxGrid>

<PageNotice Text="@Notice" Tone="@Tone" />

@* ── 자료 정보 편집 ─────────────────────────────────── *@
<DxPopup @bind-Visible="_editing" HeaderText="@(_isNew ? "자료 등록" : "자료 수정")"
         Width="660" CloseOnOutsideClick="false" ShowFooter="true">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="fn-editform">
            <DxFormLayoutItem Caption="자료명" ColSpanMd="12">
                <DxTextBox @bind-Text="_edit.Title" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="분류" ColSpanMd="6">
                <DxComboBox Data="@_categories" @bind-Value="_edit.Category"
                            AllowUserInput="true" NullText="분류 (직접 입력 가능)"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="정렬" ColSpanMd="3">
                <DxSpinEdit @bind-Value="_edit.OrderNo" MinValue="0" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="3">
                <DxCheckBox Checked="@(_edit.Status == 1)"
                            CheckedChanged="@((bool v) => _edit.Status = v ? 1 : 0)">
                    사용
                </DxCheckBox>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="_edit.Description" Rows="6" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="첨부" ColSpanMd="12">
                @* 이미 매달린 것. **여기서 빼고 저장하면 지워진다** — 서버가
                   보낸 목록을 그대로 최종으로 삼기 때문이다. 그 말을 적어 둔다. *@
                @if (_attached.Count > 0)
                {
                    <ul class="fn-files">
                        @foreach (var file in _attached.ToList())
                        {
                            <li class="fn-files__item">
                                <span>@file.FileName</span>
                                <span class="fn-files__size">@FormatSize(file.FileSize)</span>
                                <DxButton Text="빼기" SizeMode="SizeMode.Small"
                                          RenderStyle="ButtonRenderStyle.Link"
                                          Click="@(() => _attached.Remove(file))" />
                            </li>
                        }
                    </ul>
                }

                <FilePicker @ref="_picker"
                            MaxFiles="10"
                            MaxBytes="@(100L * 1024 * 1024)"
                            Hint="자료 파일을 고르세요 (최대 10개 · 한 개 100MB). 저장할 때 함께 올라갑니다."
                            FilesChanged="@(files => _picked = files)" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate>
        <DxButton Text="@(_saving ? "저장 중…" : "저장")" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_saving)" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_saving)" Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</DxPopup>

@code {
    private string? _keyword;
    private string? _category;

    private IReadOnlyList<Archive> _items = [];
    private IReadOnlyList<string> _categories = [];

    /// <summary>서버가 「이 사람은 고칠 수 있다」고 한 경우에만 참.</summary>
    private bool _canManage;

    private bool _editing;
    private bool _isNew;
    private Archive _edit = new();
    private bool _saving;

    // ── 첨부 (D5) ───────────────────────────────────────────

    /// <summary>
    /// 지금 이 자료에 매달려 있는 파일. <b>저장할 때 이대로 다시 보낸다</b> —
    /// 서버가 보낸 목록을 최종으로 삼아 빠진 것을 지우기 때문이다.
    /// </summary>
    private List<ArchiveFile> _attached = [];

    private FilePicker? _picker;
    private IReadOnlyList<PickedFile> _picked = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var list = await Api.GetArchiveListAsync(_category, _keyword);

        _items = list.Items;
        _categories = list.Categories;
        _canManage = list.CanManage;

        return _items.Count;
    }, "등록된 자료가 없습니다.", "자료실을 읽지 못했습니다");

    private void StartNew()
    {
        _isNew = true;
        _edit = new Archive
        {
            Category = _category,
            Status = 1,
            OrderNo = _items.Count == 0 ? 1 : _items.Max(a => a.OrderNo) + 1,
        };
        _attached = [];
        _picked = [];
        _editing = true;
    }

    /// <summary>복사본을 띄운다. 원본을 묶으면 취소해도 표에 바뀐 값이 남는다.</summary>
    private void StartEdit(Archive a)
    {
        _isNew = false;
        _edit = new Archive
        {
            Id = a.Id,
            Title = a.Title,
            Description = a.Description,
            Category = a.Category,
            OrderNo = a.OrderNo,
            Status = a.Status,
        };

        // 첨부도 복사본이다. 원본 목록을 그대로 쓰면 창에서 「빼기」를 누른 것이
        // 저장하지 않아도 표에 반영된다.
        _attached = [.. a.Files];
        _picked = [];
        _editing = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_edit.Title))
        {
            Say("자료명을 넣으십시오.", NoticeTone.Warning);
            return;
        }

        _saving = true;
        try
        {
            // ① 새로 고른 파일부터 FileServer 로. 실패하면 자료를 건드리지 않는다 —
            //    반쯤 저장된 상태를 만들지 않는 편이 낫다.
            var files = new List<object>(_attached.Count + _picked.Count);
            var sort = 0;

            foreach (var file in _attached)
            {
                files.Add(new
                {
                    fileId = file.FileId,
                    fileName = file.FileName,
                    fileSize = file.FileSize,
                    contentType = file.ContentType,
                    sortNo = sort++,
                });
            }

            foreach (var pick in _picked)
            {
                UploadedFile? uploaded = null;

                var sent = await RunAsync(async () =>
                {
                    await using var stream = pick.OpenRead();
                    uploaded = await Files.UploadAsync(stream, pick.Name, pick.ContentType);
                }, string.Empty, $"{pick.Name} 을(를) 올리지 못했습니다");

                if (!sent || uploaded is null)
                {
                    return;
                }

                files.Add(new
                {
                    fileId = uploaded.FileId ?? uploaded.Id,
                    fileName = pick.Name,
                    fileSize = uploaded.FileSize ?? pick.Size,
                    contentType = pick.ContentType,
                    sortNo = sort++,
                });
            }

            // ② 자료를 저장한다. **`files` 는 보낸 그대로가 최종이다** —
            //    이미 매달린 것을 함께 실어야 지워지지 않는다(머리말 참고).
            var body = new
            {
                title = _edit.Title,
                description = _edit.Description,
                category = _edit.Category,
                orderNo = _edit.OrderNo,
                status = _edit.Status,
                files,
            };

            var saved = await RunAsync(
                () => _isNew ? Api.CreateArchiveAsync(body) : Api.UpdateArchiveAsync(_edit.Id, body),
                string.Empty,
                _isNew ? "등록하지 못했습니다" : "저장하지 못했습니다");

            if (!saved)
            {
                return;
            }

            _editing = false;
            if (_picker is not null)
            {
                await _picker.ClearAsync();
            }

            // 다시 읽는 것이 먼저다 — ReloadAsync 가 안내 줄을 비운다.
            await ReloadAsync();
            Say(_isNew ? "등록했습니다." : "저장했습니다.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Archive a)
    {
        if (await RunAsync(() => Api.DeleteArchiveAsync(a.Id), "지웠습니다.", "지우지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    private static string FormatSize(long? bytes)
    {
        if (bytes is null or 0) return string.Empty;
        var mb = bytes.Value / 1024d / 1024d;
        return mb >= 1 ? $"{mb:0.0} MB" : $"{Math.Round(bytes.Value / 1024d)} KB";
    }
}
