@page "/funeral/status/deceased-status"
@attribute [RouteKey("funeral.status.deceased-status")]

@* [고인 현황] — DB 메뉴 `/status/deceased-status`. 출상 처리와 취소를 여기서 한다. 배정만 바꾸고 인적 사항은 건드리지 않는다. 출상한 뒤에도 고인 자료는 조회와 정산에 쓰인다.
조회 조건 이름은 name 이다. keyword 로 보내면 조용히 무시되어 전체가 나온다.
영정 사진은 FileServer 에 올린 뒤 고인 상세에 매단다. 목록 자료에는 그 칸이 없어 상세를 읽어 얹어 저장한다. 보정본(memorialEditedPhoto*)이 있으면 서버가 그쪽을 먼저 주므로, 원본을 새로 올릴 때 보정본을 비운다. *@

@inherits DataPage

<PageTitle>고인 현황 · 장례식장</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="고인명">
            <DxTextBox @bind-Text="_keyword" Style="width: 200px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@Statuses" @bind-Value="_status"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Style="width: 170px">
                <ItemTemplate>@StatusText(context)</ItemTemplate>
            </DxComboBox>
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="Deceased" Data="@_rows" PageSize="20"
             ExportName="고인현황"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(Deceased.Name)" Caption="고인" MinWidth="120" />
            <DxGridDataColumn Caption="성별" Width="80">
                <CellDisplayTemplate>
                    @(((Deceased)context.DataItem).Gender == "FEMALE" ? "여" : "남")
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(Deceased.Age)" Caption="나이" Width="80" />
            <DxGridDataColumn FieldName="@nameof(Deceased.RoomName)" Caption="호실" Width="130" />
            @* 종교. 장례 절차와 제단 차림이 이 값에 따라 다르다. *@
            <DxGridDataColumn FieldName="@nameof(Deceased.Religion)" Caption="종교" Width="100" />
            <DxGridDataColumn FieldName="@nameof(Deceased.DeathDate)" Caption="임종" Width="130" DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(Deceased.BurialDate)" Caption="발인" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn Caption="상태" Width="110">
                <CellDisplayTemplate>
                    @{
                        var d = (Deceased)context.DataItem;
                    }
                    <span class="jsini-badge @(d.Status == Departed ? "jsini-badge--off" : "jsini-badge--on")">
                        @StatusText(d.Status)
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>

        @* 관리 칸은 CommGrd 가 붙인다. 손으로 두면 화면마다 조작 자리가 갈린다. *@
        <RowActions Context="row">
            <PermissionView Action="MenuAction.Update">
                @if (row.Status == Departed)
                {
                    <DxButton IconCssClass="jsini-icon-undo" RenderStyle="ButtonRenderStyle.Link"
                              Title="출상을 되돌린다"
                              Click="@(() => CancelAsync(row))" />
                }
                else
                {
                    <DxButton IconCssClass="jsini-icon-export" RenderStyle="ButtonRenderStyle.Link"
                              Title="출상 처리한다"
                              Click="@(() => DepartAsync(row))" />
                }

                @* 영정 사진. 빈소 디스플레이가 띄우는 그 사진이다. *@
                <DxButton IconCssClass="jsini-icon-image" RenderStyle="ButtonRenderStyle.Link"
                          Title="빈소 디스플레이가 띄우는 사진"
                          Click="@(() => StartPhotoAsync(row))" />
            </PermissionView>
        </RowActions>
    </CommGrd>
</CommCont>

@* ── 영정 사진 ── *@
<CommPopup @bind-Visible="_photoOpen" HeaderText="@($"영정 사진 · {_photoOf?.Name}")"
         Width="480">
    <BodyContentTemplate>
        @if (_detail is null)
        {
            <PageNotice Text="고인 자료를 읽는 중입니다…" Tone="NoticeTone.Info" />
        }
        else
        {
            @* 지금 걸린 사진. 「없음」과 「못 읽었다」를 구분하려면 보여 줘야 한다. *@
            @if (CurrentPhoto is { Length: > 0 } url)
            {
                <img class="fn-memorial" src="@FileDownload.RelayUrl(url)" alt="지금 걸린 영정 사진" />
            }
            else
            {
                <PageNotice Text="아직 영정 사진이 없습니다." Tone="NoticeTone.Info" />
            }

            <FilePicker @ref="_photoPicker"
                        MaxFiles="1"
                        MaxBytes="@(20L * 1024 * 1024)"
                        Accept="image/*"
                        ShowHint="false"
                        FilesChanged="@(files => _photoPicked = files.Count > 0 ? files[0] : null)" />

            @if (_detail.MemorialEditedPhotoFileId is { Length: > 0 })
            {
                <PageNotice Tone="NoticeTone.Warning"
                            Text="보정본이 걸려 있습니다. 새 사진을 올리면 보정본은 지워지고 올린 사진이 그대로 나갑니다." />
            }
        }
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupContext">
        <DxButton Text="@(_photoSaving ? "올리는 중…" : "올리기")"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_photoSaving && _photoPicked is not null)"
                  Click="@SavePhotoAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_photoSaving)" Click="@(() => _photoOpen = false)" />
    </FooterContentTemplate>
</CommPopup>
