@page "/admin/status/server"

@*
    [MSA 서버 상태] — DB 메뉴 `/system/server-status`.
    이력: Vue `views/portal/system/server-status/index` → 여기.

    세 곳을 함께 본다.

      게이트웨이  `gateway/status` — 서비스마다 헬스체크를 눌러 본 결과
      도커        `auth/deploy-status` 안의 컨테이너 · 이미지
      AI          `ai/providers` — 제공자 키와 하루 한도

    첫째가 「지금 응답하는가」, 둘째가 「어느 판이 떠 있는가」다. 둘이 어긋날
    때가 실제로 있다 — 컨테이너는 running 인데 응답을 못 하는 경우.

    셋째를 따로 보는 이유는 AI 만 성격이 다르기 때문이다. **컨테이너가 떠
    있고 응답도 하는데 키가 없거나 하루 한도를 다 썼으면** 대화가 안 된다.
    그것은 헬스체크로 잡히지 않는다.

    [정밀 확인 — 실제로 한 번 물어본다]

    키가 있어도 그 장비가 꺼져 있을 수 있다. 헬스체크는 **서비스**가 사는지
    볼 뿐이라 그것을 못 잡는다. 「정밀 확인」은 그 제공자에게 가장 짧은 질문을
    하나 던져 답이 나오는지 본다(`ai/health/deep`, 자동 전환을 끄고 부른다 —
    다른 제공자가 대신 답하면 꺼진 장비가 정상으로 보인다).

    **자동으로 부르지 않는다.** 유료 제공자에게는 돈이 드는 호출이라,
    사람이 눌렀을 때만 나간다. 백엔드 주석이 「화면의 정밀 확인 버튼」을
    가리키고 있는데 그 버튼이 화면에 없었다.

    [컨테이너 목록이 배열이 아니라 객체 안에 있었다]

    `docker` 를 배열로 받고 있어서 화면이 통째로 「응답을 해석하지
    못했습니다」로 끝났다. 서버는 `{ available, containers[], images[] }` 를
    보낸다. 소켓을 못 읽으면 `available` 이 거짓이고, 그때는 목록이 아니라
    **이유**를 보여 줘야 한다.

    [서비스 목록을 화면이 들고 있지 않다]

    게이트웨이가 자기가 아는 서비스를 눌러 보고 결과를 준다. 화면이 목록을
    가지면 서비스를 늘릴 때마다 화면을 고쳐야 한다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>MSA 서버 상태 · 포털관리</PageTitle>

<PageHeading Title="MSA 서버 상태" Scope="포털관리" />

<div class="jsini-toolbar">
    <DxButton Text="새로 고침" RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />

    @if (_status?.GeneratedAt is { } at)
    {
        <span class="ad-stamp">@at.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") 기준</span>
    }
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<h2 class="ad-subhead">서비스 응답</h2>

@if (_services.Count == 0)
{
    <PageNotice Text="게이트웨이가 서비스 상태를 주지 않았습니다." Tone="NoticeTone.Info" />
}
else
{
    <CommGrd TItem="ServiceHealth" Data="@_services"
             PageSizeSelectorVisible="false" PagerVisible="false">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(ServiceHealth.Name)" Caption="서비스" Width="180" />

            <DxGridDataColumn Caption="상태" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var svc = (ServiceHealth)cell.DataItem;
                        var up = string.Equals(svc.Status, "UP", StringComparison.OrdinalIgnoreCase);
                    }
                    <span class="jsini-badge @(up ? "jsini-badge--on" : "jsini-badge--off")">
                        @(svc.Status ?? "?")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="응답" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var svc = (ServiceHealth)cell.DataItem;
                    }
                    @* 살아 있어도 느린 것을 여기서 본다. 배포 직후에 특히 쓸모가 있다. *@
                    @(svc.LatencyMs is { } ms ? $"{ms}ms" : "-")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="의존성" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var svc = (ServiceHealth)cell.DataItem;
                    }
                    @* 서비스는 떠 있는데 그 서비스의 DB 가 죽어 있는 상태가 실제로
                       있다. 그때 「UP」만 보면 원인을 못 찾는다. *@
                    @string.Join(" · ", svc.Dependencies.Select(d => $"{d.Name} {d.Status}"))
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(ServiceHealth.Address)" Caption="주소" Width="200" />
            <DxGridDataColumn FieldName="@nameof(ServiceHealth.Error)" Caption="이유" MinWidth="160" />
        </Columns>
    </CommGrd>
}

<h2 class="ad-subhead">AI 제공자</h2>

@if (_ai is null)
{
    <PageNotice Text="AI 서버 상태를 읽지 못했습니다." Tone="NoticeTone.Info" />
}
else
{
    @if (_ai.RestingModels.Count > 0)
    {
        @* 쉬는 모델이 있다는 것은 한도를 넘겼거나 오류가 잦았다는 뜻이다.
           대화가 느려진 이유가 여기 있을 때가 많다. *@
        <PageNotice Tone="NoticeTone.Warning"
                    Text="@($"잠시 쉬는 모델: {string.Join(", ", _ai.RestingModels)}")" />
    }

    <CommGrd TItem="object" Data="@_ai.Providers"
             PageSizeSelectorVisible="false" PagerVisible="false">
        <Columns>
            <DxGridDataColumn Caption="제공자" Width="180">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                    }
                    <span>@(p.DisplayName ?? p.Key)</span>
                    @if (p.IsDefault)
                    {
                        <span class="jsini-badge jsini-badge--on">기본</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="설정" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                    }
                    @* 키가 없으면 그 제공자로는 아무것도 못 부른다 —
                       컨테이너가 떠 있어도 그렇다. *@
                    <span class="jsini-badge @(p.Configured ? "jsini-badge--on" : "jsini-badge--off")">
                        @(p.Configured ? "됨" : "키 없음")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AiProviderDto.Model)" Caption="모델" MinWidth="240" />

            <DxGridDataColumn Caption="오늘 사용" Width="120">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                    }
                    @* 한도가 0 이면 제한이 없다는 뜻이다. 「0/0」으로 보이면
                       다 쓴 것처럼 읽히므로 갈라 적는다. *@
                    @(p.MaxRequestsPerDay > 0 ? $"{p.UsedToday} / {p.MaxRequestsPerDay}" : $"{p.UsedToday} (무제한)")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="대체 모델" MinWidth="200">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                    }
                    <span class="ad-code">@(p.FallbackModels.Count == 0 ? "-" : string.Join(", ", p.FallbackModels))</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="고를 수 있는 모델" MinWidth="200">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                        var models = ModelsOf(p.Key);
                    }
                    @* 목록이 곧 「무엇으로 바꿀 수 있는가」다. 지금 모델이 쉬고
                       있을 때 어디로 옮길 수 있는지가 여기서만 보인다. *@
                    <span class="ad-code">@(models.Count == 0 ? "-" : string.Join(", ", models))</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="정밀 확인" Width="230" AllowSort="false">
                <CellDisplayTemplate Context="cell">
                    @{
                        var p = (AiProviderDto)cell.DataItem;
                        var result = _deep.GetValueOrDefault(p.Key);
                    }
                    <div class="ad-deep">
                        <DxButton Text="확인"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Enabled="@(_checking != p.Key)"
                                  Click="@(() => DeepCheckAsync(p.Key))" />

                        @if (_checking == p.Key)
                        {
                            <span class="ad-stamp">묻는 중 …</span>
                        }
                        else if (result is not null)
                        {
                            @* 한도 초과는 고장이 아니다. 색을 갈라 둔다 —
                               같은 붉은색이면 키가 잘못된 것처럼 읽힌다. *@
                            <span class="jsini-badge @DeepTone(result)">
                                @(result.Ok ? $"{result.LatencyMs}ms" : result.RateLimited ? "한도" : "실패")
                            </span>
                            <span class="ad-stamp">@result.Message</span>
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
}

<h2 class="ad-subhead">컨테이너</h2>

@if (_status is not null && !_status.Docker.Available)
{
    @* 목록이 빈 것과 「읽을 수 없었다」는 다른 일이다. 구별해서 말해야
       사람이 도커 소켓 권한을 보러 갈지 판단할 수 있다. *@
    <PageNotice Tone="NoticeTone.Warning"
                Text="@($"도커를 읽지 못했습니다 — {_status.Docker.Error ?? "소켓에 접근할 수 없습니다."}")" />
}
else
{
    <CommGrd TItem="DockerContainerDto" Data="@Containers" PageSize="30">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(DockerContainerDto.Service)" Caption="서비스" Width="170" />
            <DxGridDataColumn FieldName="@nameof(DockerContainerDto.Tag)" Caption="태그" Width="130" />

            <DxGridDataColumn Caption="상태" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var c = (DockerContainerDto)cell.DataItem;
                        var up = string.Equals(c.State, "running", StringComparison.OrdinalIgnoreCase);
                    }
                    <span class="jsini-badge @(up ? "jsini-badge--on" : "jsini-badge--off")">@(c.State ?? "?")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(DockerContainerDto.Status)" Caption="가동" Width="160" />
            <DxGridDataColumn FieldName="@nameof(DockerContainerDto.Image)" Caption="이미지" MinWidth="240" />
            <DxGridDataColumn FieldName="@nameof(DockerContainerDto.CreatedAt)" Caption="만든 때" Width="150"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
        </Columns>
    </CommGrd>
}

@if (Images.Count > 0)
{
    <h2 class="ad-subhead">쌓인 이미지 (@_status!.Docker.ImagesTotalMb MB)</h2>

    @* 정리 단추 (D17). 옛 화면에도 있던 것을 되살렸다.

       **되돌릴 수 없다** — 지운 이미지를 되살리려면 다시 빌드해야 한다.
       그래서 곧바로 지우지 않고, 서버에 「지울 목록만」 먼저 물어(dryRun)
       그 목록을 보여 준 뒤 확인을 받는다. 목록을 화면이 계산하지 않는 이유는
       AdminClient 쪽 주석에 있다.

       권한은 서버가 본다(ADMINISTRATOR 계열). 화면에서 단추를 감추지 않는
       이유: 권한표의 이름과 서버 판정이 어긋나면 **단추가 사라져 원인을
       찾을 수 없다.** 권한이 없으면 눌렀을 때 서버가 이유를 말해 준다. *@
    <div class="jsini-toolbar">
        <DxButton Text="쌓인 이미지 정리" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_cleaning)" Click="@PreviewCleanupAsync" />
        <span class="ad-stamp">
            사용 중 태그와 저장소마다 최근 것 몇 개는 남깁니다. 지우기 전에 목록을 보여 줍니다.
        </span>
    </div>

    <CommGrd TItem="DockerImageDto" Data="@Images">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(DockerImageDto.Name)" Caption="이미지" MinWidth="300" />
            <DxGridDataColumn FieldName="@nameof(DockerImageDto.SizeMb)" Caption="MB" Width="90" />

            <DxGridDataColumn Caption="사용" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var image = (DockerImageDto)cell.DataItem;
                    }
                    @* 안 쓰는 이미지가 곧 지울 수 있는 용량이다. 배포를 거듭하면
                       이것만 수십 GB 가 된다. *@
                    <span class="jsini-badge @(image.InUse ? "jsini-badge--on" : "")">
                        @(image.InUse ? "사용 중" : "미사용")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(DockerImageDto.CreatedAt)" Caption="만든 때" Width="150"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
        </Columns>
    </CommGrd>
}

@* 정리 확인 창. **지울 목록은 서버가 준 그대로다** — 여기 보이는 것이
   그대로 지워진다. *@
<DxPopup @bind-Visible="@_confirmVisible" HeaderText="쌓인 이미지를 정리합니다"
         ShowFooter="true" Width="42rem">
    <BodyContentTemplate>
        @if (_preview is null or { Removed.Count: 0 })
        {
            <p>지울 이미지가 없습니다. 사용 중이거나 최근 것이라 모두 남겨 둡니다.</p>
        }
        else
        {
            <p>
                <b>@_preview.Removed.Count 개</b>를 지웁니다.
                저장소마다 사용 중 태그와 최근 @_preview.KeptRecent 개는 남습니다.
            </p>

            <ul class="ad-cleanup-list">
                @foreach (var name in _preview.Removed)
                {
                    <li>@name</li>
                }
            </ul>

            @* 「최대」라고 적는다. 도커의 이미지 크기는 공유 레이어를 저마다
               온전히 세므로 이 합은 실제 회수량보다 크다. 정확한 값을 아는
               길이 없으니 부풀린 숫자를 확정처럼 보여 주지 않는다. *@
            <p class="ad-stamp">최대 @_preview.SpaceReclaimedMb MB 정도가 줄어듭니다.</p>

            <PageNotice Tone="NoticeTone.Warning"
                        Text="되돌릴 수 없습니다. 지운 이미지가 다시 필요하면 그 태그를 다시 빌드해야 합니다." />
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _confirmVisible = false)" />
        @if (_preview is { Removed.Count: > 0 })
        {
            <DxButton Text="@(_cleaning ? "지우는 중…" : "지운다")"
                      RenderStyle="ButtonRenderStyle.Danger"
                      Enabled="@(!_cleaning)" Click="@RunCleanupAsync" />
        }
    </FooterContentTemplate>
</DxPopup>

@code {
    private DeployStatusDto? _status;
    private IReadOnlyList<ServiceHealth> _services = [];
    private AiProviderStatusDto? _ai;
    private IReadOnlyList<AiProviderModelsDto> _models = [];

    /// <summary>제공자별 「정밀 확인」 결과. 누른 것만 들어 있다.</summary>
    private readonly Dictionary<string, AiDeepCheckDto> _deep = new(StringComparer.Ordinal);

    /// <summary>지금 확인 중인 제공자. 같은 단추를 두 번 누르는 것을 막는다.</summary>
    private string? _checking;

    // ── 이미지 정리 (D17) ───────────────────────────────────

    /// <summary>서버에게 물어 온 「지울 목록」. 확인 창이 이것을 그대로 보여 준다.</summary>
    private DockerCleanupDto? _preview;

    private bool _confirmVisible;

    /// <summary>미리보기·지우기가 도는 중. 같은 단추를 두 번 누르는 것을 막는다.</summary>
    private bool _cleaning;

    private IReadOnlyList<DockerContainerDto> Containers => _status?.Docker.Containers ?? [];
    private IReadOnlyList<DockerImageDto> Images => _status?.Docker.Images ?? [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        // 둘 중 하나가 실패해도 나머지는 보여 준다. 서버 상태를 보러 온
        // 사람에게 「둘 다 못 읽었습니다」는 쓸모가 없다.
        _services = await SafeAsync(Api.GetServiceHealthAsync, []);
        _ai = await SafeAsync(Api.GetAiProvidersAsync, null);
        _models = await SafeAsync(Api.GetAiModelsAsync, []);
        _status = await Api.GetDeployStatusAsync();

        return _services.Count + Containers.Count;
    }, "상태 정보를 받지 못했습니다.", "서버 상태를 읽지 못했습니다");

    /// <summary>
    /// 「지울 목록만」 먼저 물어보고 확인 창을 연다 (D17).
    ///
    /// 목록이 비어도 창은 연다 — 눌렀는데 아무 일도 일어나지 않으면 고장으로
    /// 읽힌다. 「지울 것이 없습니다」도 답이다.
    /// </summary>
    private async Task PreviewCleanupAsync()
    {
        if (_cleaning) return;

        _cleaning = true;
        _preview = null;
        try
        {
            var ok = await RunAsync(
                async () => _preview = await Api.CleanupDockerImagesAsync(dryRun: true),
                okMessage: string.Empty,
                failMessage: "지울 목록을 받지 못했습니다");

            if (ok)
            {
                // RunAsync 가 성공 문구를 남기는데, 여기서는 창이 곧 답이라
                // 안내 줄을 비운다.
                Say(null);
                _confirmVisible = true;
            }
        }
        finally
        {
            _cleaning = false;
        }
    }

    /// <summary>
    /// 실제로 지운다. <b>여기부터는 되돌릴 수 없다.</b>
    ///
    /// 끝나면 상태를 다시 읽는다 — 「쌓인 이미지」 표가 줄어든 것이 보여야
    /// 정말 지워졌는지 알 수 있다.
    /// </summary>
    private async Task RunCleanupAsync()
    {
        if (_cleaning) return;

        _cleaning = true;
        try
        {
            DockerCleanupDto? result = null;
            var ok = await RunAsync(
                async () => result = await Api.CleanupDockerImagesAsync(dryRun: false),
                okMessage: "이미지를 정리했습니다.",
                failMessage: "이미지를 정리하지 못했습니다");

            _confirmVisible = false;

            // **다시 읽는 것이 먼저다.** ReloadAsync 는 시작할 때 안내 줄을
            // 비우므로, 결과를 먼저 적으면 그 자리에서 지워진다. 표가 줄어든
            // 것을 보여 준 다음 무엇을 했는지 말한다.
            await ReloadAsync();

            if (ok && result is not null)
            {
                // 일부만 지워지는 일이 있다(다른 태그가 같은 레이어를 잡고 있는
                // 경우 등). 「정리했습니다」로 뭉뚱그리면 표가 안 줄어든 이유를
                // 알 수 없으므로 실패 건수를 함께 말한다.
                var message = $"이미지 {result.Removed.Count}개를 지웠습니다 ({result.SpaceReclaimedMb} MB 회수).";
                if (result.Errors.Count > 0)
                {
                    message += $" 지우지 못한 것 {result.Errors.Count}개 — {string.Join(", ", result.Errors.Take(3))}";
                }

                Say(message, result.Errors.Count > 0 ? NoticeTone.Warning : NoticeTone.Info);
            }
        }
        finally
        {
            _cleaning = false;
        }
    }

    private IReadOnlyList<string> ModelsOf(string key) =>
        _models.FirstOrDefault(m => string.Equals(m.Provider, key, StringComparison.OrdinalIgnoreCase))?.Models ?? [];

    private static string DeepTone(AiDeepCheckDto result) =>
        result.Ok ? "jsini-badge--on" : result.RateLimited ? "jsini-badge--warn" : "jsini-badge--off";

    /// <summary>
    /// 제공자 하나를 실제로 눌러 본다.
    ///
    /// 실패도 결과다 — 서버가 200 에 이유를 담아 준다. 그래서 예외로 다루지
    /// 않고 그대로 칸에 보여 준다. 연결 자체가 안 될 때만 안내로 올린다.
    /// </summary>
    private async Task DeepCheckAsync(string provider)
    {
        _checking = provider;
        _deep.Remove(provider);

        try
        {
            var result = await Api.DeepCheckAiAsync(provider);

            if (result is not null)
            {
                _deep[provider] = result;
            }
        }
        catch (ApiException ex)
        {
            Say($"{provider} 를 확인하지 못했습니다 — {ex.Message}", NoticeTone.Error);
        }
        finally
        {
            _checking = null;
        }
    }

    /// <summary>실패해도 화면을 세우지 않는 조회. 빈 값으로 떨어진다.</summary>
    private static async Task<T> SafeAsync<T>(Func<CancellationToken, Task<T>> load, T fallback)
    {
        try
        {
            return await load(default);
        }
        catch (ApiException)
        {
            return fallback;
        }
    }
}
