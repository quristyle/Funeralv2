@page "/admin/status/server"
@attribute [RouteKey("admin.status.server")]

@*
    [MSA 서버 상태] DB 메뉴 `/system/server-status`. 게이트웨이 헬스체크 · 도커 컨테이너/이미지 · AI 공급자 셋을 함께 본다.
    서비스·컨테이너는 카드이고 상세는 오른쪽 한 자리다. 정밀 확인(유료 호출)과 이미지 정리는 사람이 누를 때만 나간다.
*@

@inherits AutoRefreshPage

<PageTitle>MSA 서버 상태</PageTitle>

@* ── 게이트웨이 한 줄 ── 모든 요청이 지나므로 이것이 죽으면 아래 카드가 전부 빨갛다. 먼저 눈에 걸리게 맨 위에 둔다. *@
<DxFormLayout CssClass="ad-deck">
    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                       ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                       ColSpanXs="12"
                       CssClass="@($"ad-card ad-card--{GatewayTone}")">
        <CaptionTemplate>
            <span class="ad-card__name">API Gateway</span>
            <span class="jsini-badge @BadgeOf(GatewayTone)">@LabelOf(GatewayTone)</span>
            <span class="ad-card__sub">모든 서비스 요청의 단일 진입점</span>
        </CaptionTemplate>
        <Items>
            <DxFormLayoutItem ColSpanXs="12">
                <Template>
                    <div class="ad-tally">
                        <div class="ad-tally__cell ad-tally--up">
                            <span class="ad-tally__num">@CountOf("up")</span>
                            <span class="ad-tally__label">정상</span>
                        </div>
                        <div class="ad-tally__cell ad-tally--warn">
                            <span class="ad-tally__num">@CountOf("warn")</span>
                            <span class="ad-tally__label">응답 이상</span>
                        </div>
                        <div class="ad-tally__cell ad-tally--down">
                            <span class="ad-tally__num">@CountOf("down")</span>
                            <span class="ad-tally__label">중지</span>
                        </div>

                        <div class="ad-tally__tail">
                            <DxButton Text="다시 읽기" RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="@ReloadAsync" />
                            @* 도커 쪽 도장(GeneratedAt)은 쓰지 않는다 — 소켓을 못 읽으면 그 시각이 낡은 채로 멎어 남는다. *@
                            <span class="ad-stamp">
                                @(_readAt is { } at ? $"{at.Kst("HH:mm:ss")} 기준" : "확인 중") · 10초마다
                            </span>
                        </div>
                    </div>
                </Template>
            </DxFormLayoutItem>
        </Items>
    </DxFormLayoutGroup>
</DxFormLayout>

@* ── 왼쪽에 목록 둘, 오른쪽에 상세 하나 ── 상세를 아래위로 두면 「떠 있는데 응답이 없다」를 함께 볼 수 없다. ad-split 은 본문 높이를 통째로 차지해 아래 구역을 자른다. *@
<div class="ad-msa">
    <div class="ad-msa__panes">
        <h2 class="ad-subhead">서비스 응답</h2>

        @if (_services.Count == 0)
        {
            <PageNotice Text="게이트웨이가 서비스 상태를 주지 않았습니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <div class="ad-msa__list" role="listbox" aria-label="서비스">
                @{
                    var shown = Selected is { } current ? KeyOf(current) : null;
                }
                @foreach (var svc in SortedServices)
                {
                    var tone = ToneOf(svc.Status);
                    var meta = MetaOf(svc.Cluster);
                    @* 고른 열쇠가 아니라 실제로 펴 놓은 것과 견준다 — 아직 고르지 않았을 때는 가장 나쁜 것이 펴져 있다. *@
                    var key = KeyOf(svc);
                    // **상세가 한 자리**라 「이 갈래가 켜져 있을 때만」 표시한다.
                    // 갈래를 안 보면 컨테이너를 펴 놓고도 서비스 카드에 표시가 남는다.
                    var on = _pick == PickKind.Service && key == shown;

                    @* 카드 한 장이 서비스 하나다 — 이름 · 상태와 응답 시간 · 연결 점. *@
                    <button type="button"
                            class="ad-msa__card ad-msa__card--@tone @(on ? "is-on" : null)"
                            role="option" aria-selected="@on"
                            title="@meta.Desc"
                            @onclick="@(() => { _selectedKey = key; _pick = PickKind.Service; })">
                        <span class="ad-msa__row">
                            <span class="ad-msa__name">@meta.Name</span>
                            <span class="ad-msa__dot"></span>
                        </span>

                        <span class="ad-msa__row">
                            <span class="ad-msa__state">@LabelOf(tone)</span>
                            <span class="ad-msa__latency @LatencyClass(svc.LatencyMs)">
                                @(svc.LatencyMs is { } ms ? $"{ms}ms" : "-")
                            </span>
                        </span>

                        @* 딸린 것을 점으로 요약한다 — 카드에서 「DB 가 죽었다」를 알아채게 만든다. *@
                        @if (svc.Dependencies.Count > 0)
                        {
                            <span class="ad-msa__row ad-msa__deps">
                                <span class="ad-msa__deps-label">연결</span>
                                @foreach (var dep in svc.Dependencies)
                                {
                                    <span class="ad-msa__depdot ad-msa__depdot--@DepTone(dep.Status)"
                                          title="@($"{DepLabel(dep.Name)} {DepText(dep.Status)}")"></span>
                                }
                            </span>
                        }
                    </button>
                }
            </div>
        }

        <h2 class="ad-subhead">컨테이너</h2>

    @if (_status is not null && !_status.Docker.Available)
    {
        @* 목록이 빈 것과 「읽을 수 없었다」는 다르다 — 구별해야 도커 소켓 권한을 볼지 판단할 수 있다. *@
        <PageNotice Tone="NoticeTone.Warning"
                    Text="@($"도커를 읽지 못했습니다 — {_status.Docker.Error ?? "소켓에 접근할 수 없습니다."}")" />
    }
        else
        {
            <div class="ad-msa__list" role="listbox" aria-label="컨테이너">
                @{
                    var shownBox = PickedContainer is { } cur ? BoxKey(cur) : null;
                }
                @foreach (var row in SortedContainers)
                {
                    var boxTone = BoxTone(row.State);
                    var boxKey = BoxKey(row);
                    var boxOn = _pick == PickKind.Container && boxKey == shownBox;

                    <button type="button"
                            class="ad-msa__card ad-msa__card--@boxTone @(boxOn ? "is-on" : null)"
                            role="option" aria-selected="@boxOn"
                            title="@row.Image"
                            @onclick="@(() => { _boxKey = boxKey; _pick = PickKind.Container; })">
                        <span class="ad-msa__row">
                            <span class="ad-msa__name">@(row.Service ?? "(이름 없음)")</span>
                            <span class="ad-msa__dot"></span>
                        </span>

                        <span class="ad-msa__row">
                            <span class="ad-msa__state">@(row.State ?? "?")</span>

                            @* 태그가 곧 어느 판이 떠 있나다. 한 대만 옛 판인지 여기서 알아챈다. *@
                            <span class="ad-msa__latency" title="@($"이미지 태그 {row.Tag}")">
                                @Short(row.Tag)
                            </span>
                        </span>

                        <span class="ad-msa__row ad-msa__deps">
                            <span class="ad-box__uptime">@(row.Status ?? string.Empty)</span>
                        </span>
                    </button>
                }
            </div>
        }

    </div>

    @* 상세는 **한 자리**다. 고른 것이 서비스냐 컨테이너냐에 따라 내용만 갈린다. *@
    <div class="ad-msa__detail">
        @if (_pick == PickKind.Container)
        {
            @if (PickedContainer is not { } box)
            {
                <PageNotice Text="왼쪽에서 컨테이너를 고르십시오." Tone="NoticeTone.Info" />
            }
            else
            {
                <div class="ad-msa__head">
                    <strong>@(box.Service ?? "(이름 없음)")</strong>
                    <span class="jsini-badge @(IsUp(box.State) ? "jsini-badge--on" : "jsini-badge--off")">
                        @(box.State ?? "?")
                    </span>
                </div>

                <dl class="ad-msa__facts">
                    <dt>가동</dt>
                    <dd>@(box.Status ?? "-")</dd>

                    @* 이미지와 태그를 갈라 둔다 — 한 줄로 붙이면 줄바꿈이 아무 데서나 일어난다. *@
                    <dt>태그</dt>
                    <dd>@(box.Tag ?? "-")</dd>

                    <dt>이미지</dt>
                    <dd>@(box.Image ?? "-")</dd>

                    <dt>프로젝트</dt>
                    <dd>@(box.Project ?? "-")</dd>

                    <dt>만든 때</dt>
                    <dd>@(box.CreatedAt is { } at ? at.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") : "-")</dd>
                </dl>

                @* 같은 이름의 서비스가 위 목록에 있으면 그쪽 응답을 함께 말한다 — running 인데 응답을 못 하는 경우를 두 값을 나란히 놓아 본다. *@
                @if (ServiceOf(box) is { } paired)
                {
                    <div class="ad-msa__section">응답</div>
                    <dl class="ad-msa__facts">
                        <dt>상태</dt>
                        <dd>
                            <span class="jsini-badge @(ToneOf(paired.Status) == "up" ? "jsini-badge--on" : "jsini-badge--off")">
                                @LabelOf(ToneOf(paired.Status))
                            </span>
                        </dd>
                        <dt>응답 시간</dt>
                        <dd>@(paired.LatencyMs is { } pms ? $"{pms}ms" : "-")</dd>
                    </dl>
                }
            }
        }
        else
        {
            @if (Selected is not { } sel)
            {
                <PageNotice Text="왼쪽에서 서비스를 고르십시오." Tone="NoticeTone.Info" />
            }
            else
            {
                var tone = ToneOf(sel.Status);
                var meta = MetaOf(sel.Cluster);

                <div class="ad-msa__head">
                    <span class="ad-card__name">@meta.Name</span>
                    <span class="jsini-badge @BadgeOf(tone)">@LabelOf(tone)</span>
                    <span class="ad-msa__latency @LatencyClass(sel.LatencyMs)">
                        @(sel.LatencyMs is { } ms ? $"{ms}ms" : "-")
                    </span>
                </div>

                <div class="ad-card__sub">@meta.Desc</div>

                <dl class="ad-msa__facts">
                    <dt>주소</dt>
                    <dd><span class="ad-code">@(sel.Address ?? "-")</span></dd>

                    <dt>HTTP</dt>
                    <dd>@(sel.HttpStatus is { } http ? http.ToString() : "-")</dd>

                    @* 클러스터 이름은 게이트웨이 설정(appsettings 의 클러스터 키)과 맞춰 볼 때 쓴다. *@
                    <dt>클러스터</dt>
                    <dd><span class="ad-code">@(sel.Cluster ?? "-")</span></dd>

                    @if (sel.Destination is { Length: > 0 } dest)
                    {
                        <dt>목적지</dt>
                        <dd><span class="ad-code">@dest</span></dd>
                    }
                </dl>

                @if (sel.Error is { Length: > 0 } || sel.Reason is { Length: > 0 })
                {
                    @* 「왜」가 없으면 다음에 무엇을 할지 알 수 없다. *@
                    <div class="ad-card__why">@(sel.Error ?? sel.Reason)</div>
                }

                @if (sel.Dependencies.Count > 0)
                {
                    <div class="ad-msa__section">딸린 것</div>

                    @* 서비스는 떠 있는데 그 DB 가 죽어 있는 상태가 실제로 있다 — 「UP」만 보면 원인을 못 찾으니 점이 아니라 이름·상태·설명을 편다. *@
                    <ul class="ad-msa__deplist">
                        @foreach (var dep in sel.Dependencies)
                        {
                            <li>
                                <span class="jsini-badge @DepBadge(dep.Status)">
                                    @DepLabel(dep.Name) @DepText(dep.Status)
                                </span>

                                @if (dep.Description is { Length: > 0 } why)
                                {
                                    <span class="ad-stamp">@why</span>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (string.Equals(sel.Cluster, "ai-cluster", StringComparison.OrdinalIgnoreCase))
                {
                    @* ── AI 공급자 ── 「딸린 것」의 llm 은 기본 공급자 하나만 찌른 결과라 고를 수 있는 것 전부의 상태를 여기 둔다.
                       사용량은 실제 요청이 지나간 응답 헤더를 서버가 주워 둔 값이다 — 열어 두는 것만으로는 한도가 줄지 않는다(찔러 보면 무료 한도가 깎인다). *@
                    <div class="ad-msa__section">AI 공급자</div>

        @if (_ai is null)
        {
            <PageNotice Text="AI 서버 상태를 읽지 못했습니다." Tone="NoticeTone.Info" />
        }
        else
        {
            @if (_ai.RestingModels.Count > 0)
            {
                @* 쉬는 모델은 한도를 넘겼거나 오류가 잦았다는 뜻이다. *@
                <PageNotice Tone="NoticeTone.Warning"
                            Text="@($"잠시 쉬는 모델: {string.Join(", ", _ai.RestingModels)}")" />
            }

            <DxFormLayout CssClass="ad-deck" CaptionPosition="CaptionPosition.Vertical">
                @foreach (var p in _ai.Providers)
                {
                    var models = ModelsOf(p.Key);
                    var result = _deep.GetValueOrDefault(p.Key);

                    @* 키가 없으면 그 제공자로는 아무것도 못 부른다 — 카드 테두리 색으로 먼저 말한다. *@
                    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                                       ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                                       ColSpanXs="12"
                                       CssClass="@($"ad-card ad-card--{(p.Configured ? "up" : "off")}")">
                        <CaptionTemplate>
                            <span class="ad-card__name">@(p.DisplayName ?? p.Key)</span>
                            @if (p.IsDefault)
                            {
                                <span class="jsini-badge jsini-badge--on">기본</span>
                            }
                            <span class="jsini-badge @(p.Configured ? "jsini-badge--on" : "jsini-badge--off")">
                                @(p.Configured ? "키 있음" : "키 없음")
                            </span>
                        </CaptionTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="모델" ColSpanXs="12">
                                <Template>
                                    <span class="ad-code">@(p.Model ?? "-")</span>
                                </Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="오늘 사용" ColSpanXs="12">
                                <Template>
                                    @* 한도가 0 이면 제한이 없다는 뜻이라 갈라 적는다(「0/0」은 다 쓴 것으로 읽힌다). *@
                                    @if (p.MaxRequestsPerDay > 0)
                                    {
                                        <div class="ad-quota">
                                            <DxProgressBar Value="@p.UsedToday" MinValue="0"
                                                           MaxValue="@p.MaxRequestsPerDay"
                                                           CssClass="ad-quota__bar" />
                                            <span class="ad-stamp">@p.UsedToday / @p.MaxRequestsPerDay</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@p.UsedToday <span class="ad-stamp">(무제한)</span></span>
                                    }
                                </Template>
                            </DxFormLayoutItem>

                            @if (p.FallbackModels.Count > 0)
                            {
                                <DxFormLayoutItem Caption="대체 모델" ColSpanXs="12">
                                    <Template>
                                        <span class="ad-code">@string.Join(", ", p.FallbackModels)</span>
                                    </Template>
                                </DxFormLayoutItem>
                            }

                            @if (models.Count > 0)
                            {
                                <DxFormLayoutItem Caption="고를 수 있는 모델" ColSpanXs="12">
                                    <Template>
                                        @* 목록이 곧 무엇으로 바꿀 수 있는가다. 길어서 높이를 가둔다. *@
                                        <div class="ad-modellist ad-code">@string.Join(", ", models)</div>
                                    </Template>
                                </DxFormLayoutItem>
                            }

                            <DxFormLayoutItem ColSpanXs="12">
                                <Template>
                                    <div class="ad-deep">
                                        <DxButton Text="정밀 확인"
                                                  RenderStyle="ButtonRenderStyle.Secondary"
                                                  Enabled="@(_checking != p.Key)"
                                                  Click="@(() => DeepCheckAsync(p.Key))" />

                                        @if (_checking == p.Key)
                                        {
                                            <span class="ad-stamp">묻는 중 …</span>
                                        }
                                        else if (result is not null)
                                        {
                                            @* 한도 초과는 고장이 아니라 색을 갈라 둔다 — 같은 붉은색이면 키가 잘못된 것으로 읽힌다. *@
                                            <span class="jsini-badge @DeepTone(result)">
                                                @(result.Ok ? $"{result.LatencyMs}ms" : result.RateLimited ? "한도" : "실패")
                                            </span>
                                            <span class="ad-stamp">@result.Message</span>
                                        }
                                        else
                                        {
                                            <span class="ad-stamp">실제로 한 번 물어봅니다 (돈이 듭니다)</span>
                                        }
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>
                }
            </DxFormLayout>
        }
                }
            }
        }
    </div>
</div>

@* ── 소셜 로그인 ── 키가 없으면 가입 화면에 단추가 안 서는데 응답 확인으로는 안 잡힌다. 열쇠 값은 오지 않고 있는지(bool)만 온다. *@
<h2 class="ad-subhead">소셜 로그인</h2>

@if (_social is null)
{
    <PageNotice Text="소셜 로그인 설정을 읽지 못했습니다." Tone="NoticeTone.Info" />
}
else
{
    @* 「왜 단추가 안 보이나」를 한 줄로 끝낸다 — 갈래가 셋(스위치 · 열쇠 · 문제 없음)이다. *@
    @if (!_social.Enabled)
    {
        <PageNotice Tone="NoticeTone.Warning"
                    Text="소셜 로그인이 꺼져 있습니다 (Auth:Social:Enabled=false). 공급자를 다 채워도 단추가 서지 않습니다." />
    }
    else if (_social.UsableCount == 0)
    {
        <PageNotice Tone="NoticeTone.Warning"
                    Text="쓸 수 있는 공급자가 없어 가입·로그인 화면에 소셜 칸이 통째로 없습니다. 아래 카드에서 열쇠가 빠진 공급자를 확인하십시오." />
    }
    else
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="@($"공급자 {_social.UsableCount}개가 가입·로그인 화면에 보입니다. 지금까지 연결된 계정 {_social.LinkedCount}개.")" />
    }

    <DxFormLayout CssClass="ad-deck" CaptionPosition="CaptionPosition.Vertical">
        @foreach (var p in _social.Providers)
        {
            @* 쓸 수 있는지를 카드 테두리 색으로 먼저 말한다 — AI 공급자 카드와 같은 규칙이다. *@
            <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                               ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                               ColSpanXs="12" ColSpanMd="6" ColSpanXl="4"
                               CssClass="@($"ad-card ad-card--{(p.Usable ? "up" : "off")}")">
                <CaptionTemplate>
                    <span class="ad-card__name">@p.DisplayName</span>
                    <span class="jsini-badge @(p.Usable ? "jsini-badge--on" : "jsini-badge--off")">
                        @(p.Usable ? "단추 보임" : "안 보임")
                    </span>
                </CaptionTemplate>
                <Items>
                    <DxFormLayoutItem Caption="열쇠" ColSpanXs="12">
                        <Template>
                            <span class="jsini-badge @(p.HasClientId ? "jsini-badge--on" : "jsini-badge--off")">
                                ClientId @(p.HasClientId ? "있음" : "없음")
                            </span>
                            @* 비밀 열쇠가 비어도 단추는 선다 — 토큰을 바꾸는 마지막 걸음에서만 깨져 증상이 가장 늦게 나타난다. *@
                            <span class="jsini-badge @(p.HasClientSecret ? "jsini-badge--on" : "jsini-badge--off")">
                                ClientSecret @(p.HasClientSecret ? "있음" : "없음")
                            </span>
                        </Template>
                    </DxFormLayoutItem>

                    @if (p.Usable && !p.HasClientSecret)
                    {
                        <DxFormLayoutItem ColSpanXs="12">
                            <Template>
                                <span class="ad-stamp">
                                    단추는 서지만 공급자에 다녀온 뒤 토큰 교환에서 실패합니다.
                                </span>
                            </Template>
                        </DxFormLayoutItem>
                    }

                    @* 콜백 주소는 공급자 콘솔에 글자 하나까지 같게 등록해야 해서 경로가 아니라 완성된 주소로 적는다. *@
                    <DxFormLayoutItem Caption="콜백 주소 (공급자 콘솔에 등록)" ColSpanXs="12">
                        <Template>
                            <span class="ad-code">@CallbackUrl(p)</span>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="연결된 계정" ColSpanXs="12">
                        <Template>
                            <span>@p.LinkedCount</span>
                        </Template>
                    </DxFormLayoutItem>
                </Items>
            </DxFormLayoutGroup>
        }
    </DxFormLayout>

    @* 설정 둘은 공급자마다가 아니라 전체에 걸린다. *@
    <p class="ad-stamp">
        가입 즉시 사용: @(_social.AutoApprove ? "켬" : "끔 (관리자 승인 필요)")
        · 확인된 이메일로 기존 계정에 자동 연결: @(_social.LinkByVerifiedEmail ? "켬" : "끔")
    </p>
}

@if (_status is not null && _status.Docker.Available)
{
    <h2 class="ad-subhead">쌓인 이미지</h2>

    @if (Images.Count == 0)
    {
        <PageNotice Tone="NoticeTone.Info" Text="쌓인 이미지가 없습니다." />
    }
    else
    {
        @* 쌓인 이미지 집계 띠. 상세 목록은 팝업으로 연다. *@
        <div class="ad-image-strip">
            <div class="ad-tally">
                <div class="ad-tally__cell">
                    <span class="ad-tally__num">@Images.Count<small class="ad-image-strip__unit">개</small></span>
                    <span class="ad-tally__label">전체 (@TotalImagesMb.ToString("N0") MB)</span>
                </div>
                <div class="ad-tally__cell ad-tally--up">
                    <span class="ad-tally__num">@InUseImagesCount<small class="ad-image-strip__unit">개</small></span>
                    <span class="ad-tally__label">사용 중 (@InUseImagesMb.ToString("N0") MB)</span>
                </div>
                <div class="ad-tally__cell @(UnusedImagesCount > 0 ? "ad-tally--warn" : "")">
                    <span class="ad-tally__num">@UnusedImagesCount<small class="ad-image-strip__unit">개</small></span>
                    <span class="ad-tally__label">미사용 (@UnusedImagesMb.ToString("N0") MB)</span>
                </div>
            </div>

            <div class="ad-image-strip__actions">
                <DxButton Text="목록 보기" RenderStyle="ButtonRenderStyle.Primary"
                          Click="@(() => _imageListVisible = true)" />
                <DxButton Text="쌓인 이미지 정리" RenderStyle="ButtonRenderStyle.Secondary"
                          Enabled="@(!_cleaning)" Click="@PreviewCleanupAsync" />
                <span class="ad-stamp">
                    사용 중 태그와 최근 것은 보존됩니다.
                </span>
            </div>
        </div>
    }
}

@* 쌓인 이미지 목록 팝업 *@
<CommPopup @bind-Visible="@_imageListVisible"
           HeaderText="@($"쌓인 이미지 목록 ({Images.Count}개 · {TotalImagesMb:N0} MB)")"
           Width="min(980px, calc(100vw - 2rem))"
           CloseOnOutsideClick="true">
    <BodyContentTemplate Context="popupContext">
        @* 정리 단추 (D17). 팝업 안에서도 목록을 확인하며 정리할 수 있다. *@
        <div class="jsini-toolbar">
            <DxButton Text="쌓인 이미지 정리" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!_cleaning)" Click="@PreviewCleanupAsync" />
            <span class="ad-stamp">
                사용 중 태그와 저장소마다 최근 것 몇 개는 남깁니다. 지우기 전에 목록을 보여 줍니다.
            </span>
        </div>

        <CommGrd TItem="DockerImageDto" Data="@Images"
                 ExportName="쌓인이미지"
                 PageSize="15"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(DockerImageDto.Name)" Caption="이미지" MinWidth="300"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DockerImageDto.SizeMb)" Caption="MB" Width="90" />

                <DxGridDataColumn Caption="사용" Width="90">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var image = (DockerImageDto)cell.DataItem;
                        }
                        @* 안 쓰는 이미지가 곧 지울 수 있는 용량이다 — 배포를 거듭하면 이것만 수십 GB 가 된다. *@
                        <span class="jsini-badge @(image.InUse ? "jsini-badge--on" : "")">
                            @(image.InUse ? "사용 중" : "미사용")
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(DockerImageDto.CreatedAt)" Caption="만든 때" Width="150"
                                  DisplayFormat="yyyy-MM-dd HH:mm" />
            </Columns>
        </CommGrd>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupContext">
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _imageListVisible = false)" />
    </FooterContentTemplate>
</CommPopup>

@* 정리 확인 창. 지울 목록은 서버가 준 그대로다 — 여기 보이는 것이 그대로 지워진다. *@
<CommPopup @bind-Visible="@_confirmVisible" HeaderText="쌓인 이미지를 정리합니다" Width="42rem">
    <BodyContentTemplate>
        @if (_preview is null or { Removed.Count: 0 })
        {
            <p>지울 이미지가 없습니다. 사용 중이거나 최근 것이라 모두 남겨 둡니다.</p>
        }
        else
        {
            <p>
                <b>@_preview.Removed.Count 개</b>를 지웁니다.
                저장소마다 사용 중 태그와 최근 @_preview.KeptRecent 개는 남습니다.
            </p>

            <ul class="ad-cleanup-list">
                @foreach (var name in _preview.Removed)
                {
                    <li>@name</li>
                }
            </ul>

            @* 「최대」라고 적는다 — 이미지 크기는 공유 레이어를 저마다 세므로 이 합은 실제 회수량보다 크다. *@
            <p class="ad-stamp">최대 @_preview.SpaceReclaimedMb MB 정도가 줄어듭니다.</p>

            <PageNotice Tone="NoticeTone.Warning"
                        Text="되돌릴 수 없습니다. 지운 이미지가 다시 필요하면 그 태그를 다시 빌드해야 합니다." />
        }
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupContext">
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _confirmVisible = false)" />
        @if (_preview is { Removed.Count: > 0 })
        {
            <DxButton Text="@(_cleaning ? "지우는 중…" : "지운다")"
                      RenderStyle="ButtonRenderStyle.Danger"
                      Enabled="@(!_cleaning)" Click="@RunCleanupAsync" />
        }
    </FooterContentTemplate>
</CommPopup>
