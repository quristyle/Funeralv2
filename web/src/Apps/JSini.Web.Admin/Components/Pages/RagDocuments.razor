@page "/admin/ai/rag-documents"
@attribute [RouteKey("admin.ai.rag-documents")]
@inherits DataPage
@implements IAsyncDisposable

@*
    [RAG 문서함] — AI 가 읽을 문서를 올리고 정리하는 자리.

    카테고리(RAG 단위) → 분류(트리) → 파일.

    [왜 카테고리를 나누는가]

    섞으면 안 되는 자료가 있기 때문이다. 사내 규정과 제품 설명서를 한 색인에
    넣으면 "휴가 며칠인가" 에 제품 문서가 섞여 나온다. **카테고리마다 색인
    파일이 하나**이고, 검색할 때 범위를 좁힐 수 있다.

    [분류는 트리인데 검색은 카테고리 전체에서 한다]

    분류는 **사람이 정리하려고** 있는 것이다. 검색까지 분류로 좁히면, 어느
    서랍에 넣었는지 기억해야 찾을 수 있다 — 그러면 검색이 아니다.

    [올리기만 해서는 찾아지지 않는다]

    문서를 넣고 「색인 다시 만들기」를 눌러야 검색에 들어간다. 올릴 때마다
    자동으로 돌리지 않는 이유는 **한 번에 몇 분씩 걸리기 때문**이다(임베딩이
    CPU 로 돈다). 열 개를 올리면 열 번 도는 꼴이 된다.

    [읽을 수 없는 파일을 조용히 넘기지 않는다]

    상태 칸에 「건너뜀」과 까닭을 적는다. 아무 표시가 없으면 사람은 올렸으니
    찾아질 것으로 믿고, 나중에 "분명히 올렸는데 못 찾는다" 를 겪는다.

    [파일은 운영시스템에 남는다]

    LLM 서버는 파일을 갖지 않는다. 운영시스템이 읽어 글자로 바꾸고 토막을
    내며, LLM 서버에는 임베딩만 맡긴다.
*@

<PageTitle>RAG 문서함 · 포털관리</PageTitle>

<div class="ad-rag">

    @* ── 카테고리 줄 ──────────────────────────────────────── *@
    <div class="ad-rag__bar">
        <div class="ad-rag__bar-lead">
            <span class="ad-rag__label">카테고리</span>

            <div class="ad-rag__cat-list">
                @foreach (var c in _categories)
                {
                    <button type="button"
                            class="@($"ad-rag__cat {(c.Id == _categoryId ? "ad-rag__cat--on" : "")}")"
                            @onclick="@(() => PickCategoryAsync(c.Id))">
                        <span>@c.Name</span>
                        <span class="ad-rag__cat-count">@c.ChunkCount</span>
                    </button>
                }
            </div>

            <DxButton Text="+ 카테고리 추가" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@OpenNewCategory" />
        </div>

        @if (Current is { } cur)
        {
            <div class="ad-rag__bar-tail">
                <div class="ad-rag__metrics">
                    <span class="jsini-badge @(cur.IndexedAt is not null ? "jsini-badge--on" : "jsini-badge--off")">
                        @(cur.IndexedAt is { } at ? $"{at.Kst("MM-dd HH:mm")} 색인" : "색인 전")
                    </span>
                    <span class="jsini-badge jsini-badge--info">문서 @cur.DocTotal</span>
                    @if (cur.DocPending > 0)
                    {
                        <span class="jsini-badge jsini-badge--warn" title="「색인 다시 만들기」를 눌러야 검색에 들어갑니다.">
                            색인 대기 @cur.DocPending
                        </span>
                    }
                    @if (cur.DocSkipped > 0)
                    {
                        <span class="jsini-badge jsini-badge--off" title="읽을 수 없는 형식이라 색인을 다시 만들어도 안 들어갑니다.">
                            제외 @cur.DocSkipped
                        </span>
                    }
                    <span class="jsini-badge jsini-badge--muted">토막 @cur.ChunkCount</span>
                </div>

                <div class="ad-rag__bar-acts">
                    <DxButton Text="색인 다시 만들기" RenderStyle="ButtonRenderStyle.Primary"
                              Enabled="@(!_busy)" Click="@ReindexAsync" />
                    <DxButton Text="카테고리 지우기" RenderStyle="ButtonRenderStyle.Link"
                              Enabled="@(!_busy)" Click="@DeleteCategoryAsync" />
                </div>
            </div>
        }
    </div>

    @if (_categoryId is null)
    {
        <div class="ad-rag__empty-card">
            <div class="ad-rag__empty-symbol">
                <span class="jsini-icon-refresh"></span>
            </div>
            <h3 class="ad-rag__empty-title">등록된 RAG 카테고리가 없습니다</h3>
            <p class="ad-rag__empty-desc">문서를 업로드하고 AI 색인을 생성하려면 먼저 카테고리를 추가하세요.</p>
            <DxButton Text="+ 새 카테고리 추가" RenderStyle="ButtonRenderStyle.Primary" Click="@OpenNewCategory" />
        </div>
    }
    else
    {
        <div class="ad-rag__split">

            @* ── 왼쪽: 분류 트리 ──────────────────────────── *@
            <aside class="ad-rag__tree">
                <div class="ad-rag__tree-head">
                    <div class="ad-rag__tree-title">
                        <span>분류 목록</span>
                        <span class="ad-rag__dim-badge" title="끌어 놓으면 부모와 차례가 바뀝니다. 색인에는 영향이 없습니다.">드래그 이동</span>
                    </div>
                    <button type="button" class="ad-rag__add-btn"
                            @onclick="@(() => OpenNewFolder(null))" title="최상위 분류 추가">＋</button>
                </div>

                <div class="ad-rag__tree-nodes">
                    @* 여기에 분류를 떨구면 최상위로 올라온다. *@
                    <button type="button"
                            class="@($"ad-rag__node {(_folderId is null ? "ad-rag__node--on" : "")} {(_dragOver is null && _dragFolder is not null ? "ad-rag__node--target" : "")}")"
                            @ondragover:preventDefault="true"
                            @ondragover="@(() => _dragOver = null)"
                            @ondrop="@(() => DropFolderAsync(null, false))"
                            @onclick="@(() => PickFolderAsync(null, "분류 미지정"))">
                        <span class="ad-rag__node-name">분류 미지정</span>
                        @FolderTally(LooseCount, 0, LoosePending)
                        @if (_dragFolder is not null)
                        {
                            <span class="ad-rag__node-hint">— 최상위로</span>
                        }
                    </button>

                    @foreach (var n in _tree)
                    {
                        @RenderNode(n, 0)
                    }

                    @if (_tree.Count == 0)
                    {
                        <div class="ad-rag__tree-empty">
                            등록된 분류가 없습니다. 위의 ＋ 로 추가하세요.
                        </div>
                    }
                </div>
            </aside>

            @* ── 오른쪽: 문서 ─────────────────────────────── *@
            @* 이 영역 어디에 떨궈도 올라간다. 귀는 JS 가 단다 —
               Blazor 의 drop 이벤트로는 파일 목록을 받을 수 없다. *@
            <section class="ad-rag__docs ad-rag__drop" @ref="_dropZone">
                <div class="ad-rag__docs-head">
                    <div class="ad-rag__docs-title">
                        <strong>@_folderLabel</strong>
                        <span class="jsini-badge jsini-badge--info">문서 @_documents.Count 건</span>
                    </div>

                    <label class="ad-rag__upload" title="문서 파일 선택">
                        <InputFile @ref="_fileInput" OnChange="@OnFilesAsync" multiple disabled="@_busy" />
                        <span>@(_busy ? "올리는 중…" : "파일 올리기")</span>
                    </label>
                </div>

                <div class="ad-rag__guide">
                    <div class="ad-rag__guide-item">
                        <span class="ad-rag__guide-bullet">·</span>
                        <span><strong>파일 업로드:</strong> 영역 내로 파일을 끌어다 놓거나 상단 [파일 올리기] 단추로 선택 (최대 20개, 개당 50MB)</span>
                    </div>
                    <div class="ad-rag__guide-item">
                        <span class="ad-rag__guide-bullet">·</span>
                        <span><strong>지원 형식:</strong> 글자 파일(.md .txt .csv .json .yaml .log .sql 등) · .pdf · .html</span>
                    </div>
                    <div class="ad-rag__guide-item">
                        <span class="ad-rag__guide-bullet">·</span>
                        <span><strong>자동 색인:</strong> 파일 등록 또는 삭제 시 백그라운드에서 자동으로 색인이 진행되며, 필요 시 상단의 <strong>「색인 다시 만들기」</strong>로 즉시 수동 실행할 수도 있습니다.</span>
                    </div>
                </div>

                <div class="ad-rag__drop-hint">
                    <div class="ad-rag__drop-hint-box">
                        <span>놓으면 <strong>「@_folderLabel」</strong> 에 바로 올라갑니다 (여러 개 가능)</span>
                    </div>
                </div>

                @* ── 올리는 중 ────────────────────────────────────
                   파일마다 줄을 세운다. **다 올라가도 지우지 않는다** —
                   건너뛴 파일과 그 까닭을 읽을 시간이 있어야 한다. *@
                @if (_uploads.Count > 0)
                {
                    <div class="ad-rag__up-list">
                        <div class="ad-rag__up-head">
                            <span>올리기 진행 (@_uploads.Count(x => x.State is "done" or "failed") / @_uploads.Count)</span>
                            @if (!_busy)
                            {
                                <DxButton Text="치우기" RenderStyle="ButtonRenderStyle.Link" Click="@ClearUploads" />
                            }
                        </div>

                        @foreach (var u in _uploads)
                        {
                            <div class="ad-rag__up">
                                <div class="ad-rag__up-top">
                                    <span class="ad-rag__up-name">@u.FileName</span>
                                    <span class="ad-rag__dim">
                                        @switch (u.State)
                                        {
                                            case "waiting": <span class="jsini-badge jsini-badge--off">대기</span> break;
                                            case "sending": <span class="jsini-badge jsini-badge--info">@Bytes(u.SentBytes) / @Bytes(u.TotalBytes) (@u.Percent.ToString("0")%)</span> break;
                                            case "done":
                                                if (u.ServerStatus == "skipped")
                                                {
                                                    <span class="jsini-badge jsini-badge--warn">건너뜀 · @Bytes(u.TotalBytes)</span>
                                                }
                                                else
                                                {
                                                    <span class="jsini-badge jsini-badge--on">올림 · @Bytes(u.TotalBytes)</span>
                                                }
                                                break;
                                            default: <span class="jsini-badge jsini-badge--err">실패</span> break;
                                        }
                                    </span>
                                </div>

                                <div class="ad-rag__up-bar">
                                    <div class="@($"ad-rag__up-fill ad-rag__up-fill--{u.State}")"
                                         style="@($"width:{(u.State is "done" or "failed" ? 100 : u.Percent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(u.Error))
                                {
                                    <div class="ad-rag__err">@u.Error</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_documents.Count == 0)
                {
                    <div class="ad-rag__empty-docs">
                        <div class="ad-rag__empty-docs-symbol">
                            <span class="jsini-icon-refresh"></span>
                        </div>
                        <div class="ad-rag__empty-docs-title">등록된 문서가 없습니다</div>
                        <div class="ad-rag__empty-docs-desc">파일을 이 영역에 끌어다 놓거나 상단의 [파일 올리기]로 문서를 등록하세요.</div>
                    </div>
                }
                else
                {
                    <div class="ad-rag__table-wrap">
                        <table class="ad-llm__table ad-rag__table">
                            <thead>
                                <tr>
                                    <th>파일</th><th>상태</th><th>토막</th><th>크기</th>
                                    <th>올린 때</th><th>올린 이</th><th>옮기기 · 지우기</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _documents)
                                {
                                    @* 줄을 끌어 왼쪽 분류에 떨구면 옮겨진다. *@
                                    <tr draggable="true"
                                        class="@(_dragDoc == d.Id ? "ad-rag__row--dragging" : "")"
                                        @ondragstart="@(() => _dragDoc = d.Id)"
                                        @ondragend="@(() => { _dragDoc = null; _dragOver = null; })">
                                        <td class="ad-rag__td-name">
                                            @* **링크를 못 끌게 막는다.** 안 막으면 줄이 아니라
                                               주소가 끌려서, 이름을 잡고 끈 사람에게만 안 된다. *@
                                            @if (RagLibraryClient.DownloadUrl(d) is { } href)
                                            {
                                                <a href="@href" target="_blank" rel="noopener"
                                                   draggable="false" class="ad-rag__file-link"
                                                   title="내려받기">@d.FileName</a>
                                            }
                                            else
                                            {
                                                @* 아직 파일 서버로 안 옮긴 줄. 누를 데가 없는
                                                   링크를 거는 것보다 까닭을 적는 편이 낫다. *@
                                                <span class="ad-rag__file-link ad-rag__file-link--off"
                                                      title="파일 서버로 아직 안 옮긴 문서라 내려받을 수 없습니다.">@d.FileName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(d.Error))
                                            {
                                                <div class="ad-rag__err">@d.Error</div>
                                            }
                                        </td>
                                        <td><span class="jsini-badge @StatusBadge(d.Status)">@StatusLabel(d.Status)</span></td>
                                        <td>@(d.ChunkCount > 0 ? d.ChunkCount.ToString() : "-")</td>
                                        <td>@Bytes(d.SizeBytes)</td>
                                        <td>@d.CreatedAt.Kst("MM-dd HH:mm")</td>
                                        <td>@d.CreatedBy</td>
                                        <td class="ad-rag__row-acts">
                                            @* 끌어 옮기기만 두면 화면 어디에도 안 보이는
                                               몸짓이 유일한 길이 된다. *@
                                            <select class="ad-rag__move" title="다른 분류로 옮기기"
                                                    @onchange="@(e => MoveDocumentAsync(d.Id, ParseFolder(e.Value)))">
                                                @foreach (var (id, label) in FlatFolders())
                                                {
                                                    @* 지금 분류를 `selected` 로 집는다. `<select value=…>` 로
                                                       주면 옵션보다 먼저 그려져 안 잡히는 자리가 있다. *@
                                                    <option value="@(id?.ToString() ?? "")" selected="@(id == _folderId)">@label</option>
                                                }
                                            </select>
                                            <DxButton Text="지우기" RenderStyle="ButtonRenderStyle.Link"
                                                      Click="@(() => DeleteDocumentAsync(d.Id))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
</div>

@* ── 카테고리 추가 ───────────────────────────────────────────

   **`DxPopup` 을 직접 쓰지 않는다.** 그러면 `ShowFooter` 를 빠뜨렸을 때
   바닥이 통째로 안 그려져 **「만들기」 단추가 사라진다** — 실제로 그랬다.
   공통 팝업은 그 값이 기본으로 켜져 있고, 바깥을 눌러도 안 닫힌다. *@
<CommPopup @bind-Visible="_newCategoryVisible" HeaderText="카테고리 추가" Width="420">
    <BodyContentTemplate Context="popup">
        <div class="ad-rag__form">
            <label>열쇠</label>
            <DxTextBox @bind-Text="_newCategoryId" NullText="hr-policy" />
            <div class="ad-rag__dim">
                영문·숫자·하이픈만. 색인 파일과 폴더 이름이 되므로 한글은 쓸 수 없습니다.
            </div>

            <label>이름</label>
            <DxTextBox @bind-Text="_newCategoryName" NullText="사내 규정" />
            <div class="ad-rag__dim">사람이 보는 이름입니다. 한글로 적으세요.</div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popup">
        <DxButton Text="만들기" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_busy)" Click="@SaveCategoryAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _newCategoryVisible = false)" />
    </FooterContentTemplate>
</CommPopup>

@* ── 분류 추가 ─────────────────────────────────────────────── *@
<CommPopup @bind-Visible="_newFolderVisible" HeaderText="분류 추가" Width="380">
    <BodyContentTemplate Context="popup">
        <div class="ad-rag__form">
            <label>이름</label>
            <DxTextBox @bind-Text="_newFolderName" NullText="휴가" />
            <div class="ad-rag__dim">
                @(_newFolderParent is null ? "최상위에 만듭니다." : "고른 분류 아래에 만듭니다.")
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popup">
        <DxButton Text="만들기" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_busy)" Click="@SaveFolderAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _newFolderVisible = false)" />
    </FooterContentTemplate>
</CommPopup>

@* 지우기는 **묻고 지운다.** 카테고리를 지우면 분류·문서·디스크의 파일까지
   함께 사라지고, 되돌릴 방법이 없다. *@
<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>
    /// 분류 한 칸과 그 아래를 그린다. 깊이는 들여쓰기로만 나타낸다 —
    /// 접고 펴는 기능은 두지 않았다. 분류가 서너 단계를 넘지 않고,
    /// 접혀 있으면 "어디에 넣었더라" 를 다시 찾아야 한다.
    /// </summary>
    @* 분류 옆의 파일 수. 제 것이 0 이어도 아래에 있으면 그것을 적는다 —
       묶음 노릇만 하는 분류가 「0」으로 보이면 비어 있는 것으로 읽힌다. *@
    private RenderFragment FolderTally(int own, int below, int pending) => __builder =>
    {
        if (own == 0 && below == 0) return;

        <span class="ad-rag__count" title="@($"이 분류 {own}건{(below > 0 ? $" · 하위 {below}건" : "")}")">
            @own
            @if (below > 0)
            {
                <span class="ad-rag__count-sub">+@below</span>
            }
        </span>

        @* 색인에 안 든 수. **있을 때만 선다** — 늘 서 있으면 0 이 줄줄이
           늘어서서, 정작 손봐야 하는 분류가 묻힌다. *@
        if (pending > 0)
        {
            <span class="ad-rag__count ad-rag__count--wait"
                  title="@($"색인에 안 든 문서 {pending}건. 「색인 다시 만들기」를 눌러야 검색에 들어갑니다.")">
                대기 @pending
            </span>
        }
    };

    private RenderFragment RenderNode(RagFolderNode node, int depth) => __builder =>
    {
        @* 줄 위쪽 얇은 띠 — 여기에 놓으면 **형제로, 그 앞에** 끼운다.
           줄 가운데에 놓으면 **자식으로** 들어간다. 둘을 가르지 않으면
           "옆에 두고 싶었는데 안으로 들어갔다" 가 계속 난다. *@
        <div class="@($"ad-rag__gap {(_dragOver is { } g && g.Id == node.Id && g.Before ? "ad-rag__gap--on" : "")}")"
             style="@($"margin-left:{depth * 14}px")"
             @ondragover:preventDefault="true"
             @ondragover="@(() => DragOver(node.Id, true))"
             @ondrop="@(() => DropFolderAsync(node.Id, true))"></div>

        <div class="ad-rag__node-row" style="@($"padding-left:{depth * 14}px")">
            <button type="button"
                    draggable="true"
                    class="@($"ad-rag__node {(_folderId == node.Id ? "ad-rag__node--on" : "")} {(_dragOver is { } d2 && d2.Id == node.Id && !d2.Before ? "ad-rag__node--target" : "")}")"
                    @ondragstart="@(() => _dragFolder = node.Id)"
                    @ondragend="@(() => { _dragFolder = null; _dragOver = null; })"
                    @ondragover:preventDefault="true"
                    @ondragover="@(() => DragOver(node.Id, false))"
                    @ondrop="@(() => DropFolderAsync(node.Id, false))"
                    @onclick="@(() => PickFolderAsync(node.Id, node.Name))">
                <span class="ad-rag__node-name">@node.Name</span>
                @FolderTally(node.DocCount, node.DescendantCount, node.PendingTotal)
            </button>
            <span class="ad-rag__node-acts">
                <button type="button" class="ad-rag__node-act" title="하위 분류 추가"
                        @onclick="@(() => OpenNewFolder(node.Id))">＋</button>
                <button type="button" class="ad-rag__node-act" title="지우기"
                        @onclick="@(() => DeleteFolderAsync(node.Id))">×</button>
            </span>
        </div>

        @foreach (var c in node.Children)
        {
            @RenderNode(c, depth + 1)
        }
    };
}
