@page "/admin/status/llm"
@attribute [RouteKey("admin.status.llm")]
@inherits AutoRefreshPage

@*
    [LLM 장비 상태] — 추론을 돌리는 GPU 장비(호스트명 llm) 한 대를 본다.

    이 장비는 운영서버와 같은 내부망에 있고 바깥에서 직접 닿지 않는다.
    브라우저가 물을 수 없고, 컨테이너에 SSH 키를 넣는 것도 피했다 —
    **추론에 쓰는 바로 그 길(nginx + Bearer)을 그대로 탄다.**

      포털 → 게이트웨이 → AIAgentServer → 장비 nginx :11434 → 수집기 :11436

    [무엇을 맨 위에 두는가]

    GPU 를 맨 위에 둔다. 이 장비에서 고장도 느려짐도 거의 전부 GPU 에서
    온다 — 드라이버 판이 어긋나 아예 못 쓰거나, 달아올라 클럭이 눌리거나,
    VRAM 이 모자라 모델이 안 올라가거나.

    **온도 경계를 실측으로 잡았다.** 연속 부하에서 GPU0 이 81°C 까지 오르고
    그때 생성 속도가 137 → 129 tok/s 로 떨어졌다(GPU1 은 59°C). 두 카드가
    붙어 있어 아래쪽 흡기가 막힌 물리적 문제다. 그래서 75 를 노랑으로 둔다 —
    3090 이 클럭을 누르기 시작하는 83 을 기다리면 이미 늦다.

    [서비스는 상태만 보면 안 된다]

    재시작 횟수를 함께 보여 준다. 반복해 죽는 서비스는 systemd 가 곧바로
    다시 띄워서 **상태만 보면 계속 active 다.** 실제로 이 장비에서 추론 보조를
    켜다가 그런 일이 있었다 — 화면에는 초록인데 실제로는 1분에 열 번씩
    죽고 있었다.

    [장비가 꺼져 있어도 화면은 뭔가 말해야 한다]

    닿지 못하면 빈 자리가 아니라 **까닭**을 보여 준다. 어느 주소로 물었는지도
    함께 적는다 — 개발 PC 와 운영이 서로 다른 주소를 쓰기 때문에, 그것만
    보여도 "내 쪽 설정이 틀렸구나" 를 알 수 있다.
*@

<PageTitle>LLM 장비 상태 · 포털관리</PageTitle>

<DxFormLayout CssClass="ad-deck">
    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                       ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                       ColSpanXs="12"
                       CssClass="@($"ad-card ad-card--{(_hw?.Reachable == true ? "up" : "down")}")">
        <CaptionTemplate>
            <span class="ad-card__name">LLM 장비</span>
            <span class="jsini-badge @(_hw?.Reachable == true ? "jsini-badge--on" : "jsini-badge--err")">
                @(_hw?.Reachable == true ? "응답" : "응답 없음")
            </span>
            <span class="ad-card__sub">@(M?.System?.Hostname ?? "—") · @(M?.System?.Os ?? "")</span>
        </CaptionTemplate>
        <Items>
            <DxFormLayoutItem ColSpanXs="12">
                <Template>
                    <div class="ad-tally">
                        <div class="ad-tally__cell ad-tally--up">
                            <span class="ad-tally__num">@(M?.Gpu?.Devices.Count ?? 0)</span>
                            <span class="ad-tally__label">GPU</span>
                        </div>
                        <div class="ad-tally__cell">
                            <span class="ad-tally__num">@Duration(M?.System?.UptimeSeconds)</span>
                            <span class="ad-tally__label">가동</span>
                        </div>
                        <div class="ad-tally__cell">
                            <span class="ad-tally__num">@Num(M?.System?.LoadAvg.FirstOrDefault(), digits: 2)</span>
                            <span class="ad-tally__label">부하(1분)</span>
                        </div>

                        <div class="ad-tally__tail">
                            <DxButton Text="다시 읽기" RenderStyle="ButtonRenderStyle.Secondary" Click="@ReloadAsync" />
                            <span class="ad-stamp">
                                @(RefreshedAt is { } at ? $"{at.Kst("HH:mm:ss")} 기준" : "확인 중") · 10초마다
                            </span>
                        </div>
                    </div>

                    @if (_hw is { Reachable: false })
                    {
                        <div class="ad-card__why">
                            @(_hw.Message ?? "까닭을 알 수 없습니다.")
                            @if (!string.IsNullOrWhiteSpace(_hw.Endpoint))
                            {
                                <span class="ad-llm__dim"> — 물어본 곳 @_hw.Endpoint</span>
                            }
                        </div>
                    }
                </Template>
            </DxFormLayoutItem>
        </Items>
    </DxFormLayoutGroup>
</DxFormLayout>

@if (M is { } m)
{
    @* ── GPU ──────────────────────────────────────────────── *@
    <h2 class="ad-llm__head">
        GPU
        @if (m.Gpu is { Available: true, CudaVersion: { Length: > 0 } cuda })
        {
            <span class="ad-llm__dim">CUDA @cuda · 드라이버 @(m.Gpu.Devices.FirstOrDefault()?.DriverVersion ?? "-")</span>
        }
    </h2>

    @if (m.Gpu is { Available: false })
    {
        <div class="ad-card ad-card--down ad-llm__panel">
            <strong>GPU 를 읽지 못했습니다.</strong>
            <div class="ad-card__why">@(m.Gpu.Reason ?? "까닭 불명")</div>
        </div>
    }
    else
    {
        <DxFormLayout CssClass="ad-deck">
            @foreach (var g in m.Gpu?.Devices ?? [])
            {
                var tone = TempTone(g.TemperatureGpu);
                <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                                   ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                                   ColSpanXs="12" ColSpanMd="6"
                                   CssClass="@($"ad-card ad-card--{tone}")">
                    <CaptionTemplate>
                        <span class="ad-card__name">GPU @g.Index</span>
                        <span class="jsini-badge @BadgeOf(tone)">@Num(g.TemperatureGpu, "°C")</span>
                        <span class="ad-card__sub">@g.Name</span>
                    </CaptionTemplate>
                    <Items>
                        <DxFormLayoutItem ColSpanXs="12">
                            <Template>
                                <div class="ad-llm__bar">
                                    <div class="ad-llm__bar-fill ad-llm__bar--@FillTone(g.MemoryUsedPercent)"
                                         style="width:@(g.MemoryUsedPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    <span class="ad-llm__bar-text">
                                        VRAM @Mib(g.MemoryUsed) / @Mib(g.MemoryTotal) (@Num(g.MemoryUsedPercent, "%", 1))
                                    </span>
                                </div>

                                <dl class="ad-llm__kv">
                                    <dt>사용률</dt><dd>@Num(g.UtilizationGpu, "%")<span class="ad-llm__dim"> · 메모리 @Num(g.UtilizationMemory, "%")</span></dd>
                                    <dt>전력</dt>
                                    <dd>
                                        @Num(g.PowerDraw, " W", 1)<span class="ad-llm__dim"> / @Num(g.EnforcedPowerLimit ?? g.PowerLimit, " W")</span>
                                        @if (g.EnforcedPowerLimit is { } ep && g.PowerMaxLimit is { } mx && ep < mx)
                                        {
                                            <span class="ad-llm__dim"> (최대 @Num(mx, " W") 에서 낮춤)</span>
                                        }
                                    </dd>
                                    <dt>팬</dt><dd>@Num(g.FanSpeed, "%")</dd>
                                    <dt>클럭</dt><dd>@Num(g.ClocksSm, " MHz")<span class="ad-llm__dim"> / 최대 @Num(g.ClocksMaxSm, " MHz")</span></dd>
                                    <dt>상태</dt>
                                    <dd>
                                        @g.Pstate
                                        @if (IsThrottled(g.ClocksEventReasonsActive))
                                        {
                                            <span class="jsini-badge jsini-badge--warn">클럭 눌림</span>
                                        }
                                        @if (string.Equals(g.PersistenceMode, "Enabled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="ad-llm__dim"> · 지속모드</span>
                                        }
                                    </dd>
                                    <dt>PCIe</dt>
                                    <dd>
                                        Gen@(g.PcieLinkGenCurrent) x@(g.PcieLinkWidthCurrent)
                                        <span class="ad-llm__dim"> / 최대 Gen@(g.PcieLinkGenMax) x@(g.PcieLinkWidthMax)</span>
                                        @if (IsNarrowLink(g))
                                        {
                                            <span class="jsini-badge jsini-badge--warn">폭 제한</span>
                                        }
                                    </dd>
                                </dl>

                                @if (g.Processes.Count > 0)
                                {
                                    <div class="ad-llm__procs">
                                        @foreach (var p in g.Processes)
                                        {
                                            <span class="ad-llm__proc">
                                                @(p.Name?.Split('/').LastOrDefault() ?? "?")
                                                <span class="ad-llm__dim">pid @p.Pid · @Mib(p.MemoryMiB)</span>
                                            </span>
                                        }
                                    </div>
                                }
                            </Template>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            }
        </DxFormLayout>
    }

    @* ── 모델 ─────────────────────────────────────────────── *@
    <h2 class="ad-llm__head">올라와 있는 모델</h2>
    <DxFormLayout CssClass="ad-deck">
        @foreach (var s in m.Llm)
        {
            <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                               ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                               ColSpanXs="12" ColSpanMd="6"
                               CssClass="@($"ad-card ad-card--{(s.Reachable ? "up" : "down")}")">
                <CaptionTemplate>
                    <span class="ad-card__name">@s.Label</span>
                    <span class="jsini-badge @(s.Reachable ? "jsini-badge--on" : "jsini-badge--err")">
                        @(s.Reachable ? "응답" : "중지")
                    </span>
                    <span class="ad-card__sub">@s.BaseUrl</span>
                </CaptionTemplate>
                <Items>
                    <DxFormLayoutItem ColSpanXs="12">
                        <Template>
                            @if (s.Models.Count == 0)
                            {
                                <div class="ad-card__why">올라온 모델이 없습니다.</div>
                            }
                            @foreach (var mm in s.Models)
                            {
                                <dl class="ad-llm__kv">
                                    <dt>모델</dt><dd class="ad-desc__mono">@mm.Id</dd>
                                    <dt>크기</dt><dd>@Params(mm.Params)<span class="ad-llm__dim"> · @Bytes(mm.SizeBytes) · @mm.Quantization</span></dd>
                                    <dt>문맥</dt><dd>@Num(mm.ContextLength)<span class="ad-llm__dim"> / 학습 @Num(mm.TrainedContext)</span></dd>
                                </dl>
                            }
                            @if (s.Props is { } pr)
                            {
                                <div class="ad-llm__dim ad-desc__mono">슬롯 @pr.Slots · @pr.ModelPath</div>
                            }
                        </Template>
                    </DxFormLayoutItem>
                </Items>
            </DxFormLayoutGroup>
        }
    </DxFormLayout>

    @* ── CPU · 메모리 ─────────────────────────────────────── *@
    <h2 class="ad-llm__head">CPU · 메모리</h2>
    <DxFormLayout CssClass="ad-deck">
        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6" CssClass="ad-card">
            <CaptionTemplate>
                <span class="ad-card__name">CPU</span>
                <span class="jsini-badge @BadgeOf(FillTone(m.Cpu?.TotalUsagePercent ?? 0))">
                    @Num(m.Cpu?.TotalUsagePercent, "%", 1)
                </span>
                <span class="ad-card__sub">@m.Cpu?.Model</span>
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <dl class="ad-llm__kv">
                            <dt>코어</dt><dd>@m.Cpu?.LogicalCores 스레드</dd>
                            <dt>클럭</dt><dd>@Num(m.Cpu?.AvgMhz, " MHz") <span class="ad-llm__dim">평균</span></dd>
                            <dt>온도</dt><dd>@Num(m.Cpu?.TemperatureC, "°C", 1)</dd>
                            <dt>전력 정책</dt><dd>@m.Cpu?.Governor <span class="ad-llm__dim">· EPP @m.Cpu?.EnergyPreference</span></dd>
                            <dt>부하</dt><dd>@string.Join(" / ", (m.System?.LoadAvg ?? []).Select(x => x.ToString("0.00")))</dd>
                        </dl>
                        <div class="ad-llm__cores">
                            @foreach (var c in m.Cpu?.PerCorePercent ?? [])
                            {
                                <span class="ad-llm__core" title="@c.ToString("0.0")%">
                                    <span class="ad-llm__core-fill ad-llm__bar--@FillTone(c)"
                                          style="height:@(Math.Max(c, 2).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </span>
                            }
                        </div>
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>

        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6" CssClass="ad-card">
            <CaptionTemplate>
                <span class="ad-card__name">메모리</span>
                <span class="jsini-badge @BadgeOf(FillTone(m.Memory?.UsedPercent ?? 0))">
                    @Num(m.Memory?.UsedPercent, "%", 1)
                </span>
                <span class="ad-card__sub">@Bytes(m.Memory?.UsedBytes) / @Bytes(m.Memory?.TotalBytes)</span>
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <div class="ad-llm__bar">
                            <div class="ad-llm__bar-fill ad-llm__bar--@FillTone(m.Memory?.UsedPercent ?? 0)"
                                 style="width:@((m.Memory?.UsedPercent ?? 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            <span class="ad-llm__bar-text">사용 @Bytes(m.Memory?.UsedBytes)</span>
                        </div>
                        <dl class="ad-llm__kv">
                            <dt>여유</dt><dd>@Bytes(m.Memory?.AvailableBytes)</dd>
                            <dt>캐시</dt><dd>@Bytes(m.Memory?.CachedBytes)</dd>
                            <dt>스왑</dt><dd>@Bytes(m.Memory?.SwapUsedBytes) <span class="ad-llm__dim">/ @Bytes(m.Memory?.SwapTotalBytes)</span></dd>
                        </dl>
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>
    </DxFormLayout>

    @* ── 서비스 ───────────────────────────────────────────── *@
    <h2 class="ad-llm__head">서비스</h2>
    <div class="ad-llm__panel">
        <table class="ad-llm__table">
            <thead>
                <tr><th>유닛</th><th>상태</th><th>자동 기동</th><th>가동</th><th>재시작</th><th>메모리</th></tr>
            </thead>
            <tbody>
                @foreach (var s in m.Services)
                {
                    var tone = ServiceTone(s);
                    <tr>
                        <td>@UnitName(s.Unit)</td>
                        <td><span class="jsini-badge @BadgeOf(tone)">@s.ActiveState / @s.SubState</span></td>
                        <td>@s.Enabled</td>
                        <td>@Duration(s.ActiveSeconds)</td>
                        <td class="@(s.Restarts > 0 ? "ad-llm__warnnum" : "")">@s.Restarts</td>
                        <td>@Bytes(s.MemoryBytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── 디스크 · 네트워크 ────────────────────────────────── *@
    <h2 class="ad-llm__head">디스크 · 네트워크</h2>
    <div class="ad-llm__panel">
        <table class="ad-llm__table">
            <thead>
                <tr><th>마운트</th><th>장치</th><th>형식</th><th>사용</th><th>전체</th><th>비율</th></tr>
            </thead>
            <tbody>
                @foreach (var d in m.Disks)
                {
                    <tr>
                        <td>@d.Mount</td>
                        <td class="ad-desc__mono">@d.Device</td>
                        <td>@d.FsType</td>
                        <td>@Bytes(d.UsedBytes)</td>
                        <td>@Bytes(d.TotalBytes)</td>
                        <td><span class="jsini-badge @BadgeOf(FillTone(d.UsedPercent))">@Num(d.UsedPercent, "%", 1)</span></td>
                    </tr>
                }
            </tbody>
        </table>

        <table class="ad-llm__table">
            <thead>
                <tr><th>인터페이스</th><th>상태</th><th>속도</th><th>받음</th><th>보냄</th><th>오류</th></tr>
            </thead>
            <tbody>
                @foreach (var n in m.Network)
                {
                    var up = string.Equals(n.OperState, "up", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td>@n.Name</td>
                        <td><span class="jsini-badge @(up ? "jsini-badge--on" : "jsini-badge--off")">@n.OperState</span></td>
                        <td>@(n.SpeedMbps is { } sp and > 0 ? $"{sp} Mbps" : "-")</td>
                        <td>@Bytes(n.RxBytes)</td>
                        <td>@Bytes(n.TxBytes)</td>
                        <td class="@((n.RxErrors + n.TxErrors) > 0 ? "ad-llm__warnnum" : "")">@(n.RxErrors + n.TxErrors)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── 사내 문서 검색 (RAG) ──────────────────────────────────────
    여기부터는 **장비가 아니라 기능**이다. 장비가 멀쩡해도 이 둘은 따로
    끊어진다 — 임베딩 서버가 죽거나, 색인이 비었거나, 도구 서버가 안 떠
    있거나. 그때도 대화는 아는 것만으로 멀쩡히 돌아서 **서비스 상태로는
    안 갈린다.** 그래서 장비가 꺼져 있어도(M 이 null) 이 자리는 그린다.
*@
<h2 class="ad-llm__head">
    사내 문서 검색 (RAG)
    @if (_ai?.Rag is { } rh)
    {
        <span class="ad-llm__dim">
            토막 @Num(rh.Chunks)개 · 카테고리 @rh.Categories.Count(c => c.Indexed)/@rh.Categories.Count 색인됨
        </span>
    }
    <span class="ad-llm__head-act">
        <DxButton Text="지금 눌러 보기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!Loading)" Click="@RecheckFeaturesAsync" />
    </span>
</h2>

@if (_ai?.Rag is not { } rag)
{
    <div class="ad-card ad-card--down ad-llm__panel">
        <strong>RAG 상태를 읽지 못했습니다.</strong>
        <div class="ad-card__why">AI 서비스(AIAgentServer)가 답하지 않습니다.</div>
    </div>
}
else
{
    <DxFormLayout CssClass="ad-deck">
        @* 임베딩 서버 — **눌러 본 결과다.** 설정만 보면 죽어 있어도 초록이다 *@
        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6"
                           CssClass="@($"ad-card ad-card--{(rag.Embedding?.Reachable == true ? "up" : "down")}")">
            <CaptionTemplate>
                <span class="ad-card__name">임베딩 서버</span>
                <span class="jsini-badge @(rag.Embedding?.Reachable == true ? "jsini-badge--on" : "jsini-badge--err")">
                    @(rag.Embedding?.Reachable == true ? "응답" : "응답 없음")
                </span>
                <span class="ad-card__sub">@(rag.Embedding?.Model ?? "—")</span>
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <dl class="ad-llm__kv">
                            <dt>벡터 차원</dt><dd>@Num(rag.Embedding?.Dimensions)</dd>
                            <dt>걸린 시간</dt>
                            <dd>
                                @Num(rag.Embedding?.LatencyMs, " ms")
                                <span class="ad-llm__dim"> · 짧은 글 하나를 벡터로</span>
                            </dd>
                            <dt>물어본 곳</dt><dd class="ad-desc__mono">@(rag.Embedding?.Endpoint ?? "—")</dd>
                            <dt>확인</dt>
                            <dd>
                                @(rag.Embedding is { } eb ? eb.CheckedAt.Kst("HH:mm:ss") : "—")
                                <span class="ad-llm__dim"> · 2분마다 (누르면 지금)</span>
                            </dd>
                        </dl>

                        @if (rag.Embedding is { Reachable: false, Message: { Length: > 0 } ewhy })
                        {
                            <div class="ad-card__why">
                                @ewhy
                                <span class="ad-llm__dim"> — 그동안에도 대화는 돌아간다(낱말 검색만 한다).</span>
                            </div>
                        }
                        else if (DimensionNote(rag) is { Length: > 0 } dnote)
                        {
                            <div class="ad-card__why">@dnote</div>
                        }
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>

        @* 대화에 어떻게 붙는가 — 이쪽은 설정이다. 눌러 보는 값이 아니다 *@
        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6"
                           CssClass="@($"ad-card ad-card--{(rag.AugmentChat ? "up" : "off")}")">
            <CaptionTemplate>
                <span class="ad-card__name">대화에 끼우기</span>
                <span class="jsini-badge @(rag.AugmentChat ? "jsini-badge--on" : "jsini-badge--off")">
                    @(rag.AugmentChat ? "켜짐" : "꺼짐")
                </span>
                @* 설정 열쇠는 머리에 적지 않는다 — 머리띠가 라틴 글자를 대문자로
                   올려(tabler.css 의 그룹 머리) `Rag:AugmentChat` 이 그대로 적어
                   넣을 수 없는 글자가 된다. 아래 칸에 둔다 *@
                <span class="ad-card__sub">사내 문서</span>
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <dl class="ad-llm__kv">
                            <dt>넣는 토막</dt>
                            <dd>@Num(rag.TopK)개<span class="ad-llm__dim"> · 점수 @Num(rag.MinVectorScore, "", 2) 미만은 버린다</span></dd>
                            <dt>찾는 범위</dt>
                            <dd>@(string.IsNullOrWhiteSpace(rag.ChatCategory) ? "모든 카테고리" : rag.ChatCategory)</dd>
                            <dt>색인 자리</dt><dd class="ad-desc__mono">@(rag.IndexPath ?? "—")</dd>
                            <dt>문서 자리</dt><dd class="ad-desc__mono">@(rag.UploadRoot ?? "—")</dd>
                            <dt>마지막 색인</dt>
                            <dd>@(rag.BuiltAt is { } rb ? rb.Kst("yyyy-MM-dd HH:mm") : "한 번도 만들지 않음")</dd>
                            <dt>설정</dt><dd class="ad-desc__mono">Rag:AugmentChat</dd>
                        </dl>
                        @if (!rag.AugmentChat)
                        {
                            <div class="ad-card__why">
                                꺼져 있습니다 — 사내 문서를 찾기는 하지만 <b>대화에는 붙이지 않습니다.</b>
                            </div>
                        }
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>
    </DxFormLayout>

    @* 카테고리 — **색인(메모리)과 문서(DB)를 나란히 놓는다.**
       둘이 어긋나는 것이 「올려만 놓고 색인을 안 돌린」 상태다 *@
    <div class="ad-llm__panel">
        <table class="ad-llm__table">
            <thead>
                <tr><th>카테고리</th><th>문서</th><th>토막</th><th>차원</th><th>색인 파일</th><th>만든 때</th><th>상태</th></tr>
            </thead>
            <tbody>
                @if (rag.Categories.Count == 0)
                {
                    <tr><td colspan="7">카테고리가 하나도 없습니다.</td></tr>
                }
                @foreach (var c in rag.Categories)
                {
                    var state = CategoryState(c);
                    <tr>
                        <td>
                            @c.Name
                            <span class="ad-llm__dim">@c.Id@(c.FromLibrary ? "" : " · 저장소")</span>
                        </td>
                        <td>
                            @Num(c.Documents)건
                            <span class="ad-llm__dim"> · @Bytes(c.DocumentBytes)</span>
                        </td>
                        <td>
                            @Num(c.Chunks)
                            @if (c.Indexed && c.VectorChunks < c.Chunks)
                            {
                                <span class="ad-llm__warnnum"> 벡터 @Num(c.VectorChunks)</span>
                            }
                            else if (c.Sources > 0)
                            {
                                <span class="ad-llm__dim"> · 문서 @Num(c.Sources)</span>
                            }
                        </td>
                        <td>@(c.Dimensions > 0 ? Num(c.Dimensions) : "-")</td>
                        <td>@Bytes(c.IndexBytes)</td>
                        <td>@(c.BuiltAt is { } cb ? cb.Kst("MM-dd HH:mm") : "-")</td>
                        <td><span class="jsini-badge @BadgeOf(state.Tone)">@state.Label</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── 웹 검색 (MCP 도구) ───────────────────────────────────── *@
<h2 class="ad-llm__head">
    웹 검색 (MCP 도구)
    @if (_ai?.Web is { } wh)
    {
        <span class="ad-llm__dim">도구 @(wh.Tools.Count)개 · 뒷단 @SearchName(wh.Server?.SearchProvider)</span>
    }
    <span class="ad-llm__head-act">
        <DxButton Text="@(_webChecking ? "찾는 중…" : "검색 해 보기")"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_webChecking && _ai?.Web?.Enabled == true)"
                  Click="@CheckWebSearchAsync" />
    </span>
</h2>

@if (_ai?.Web is not { } web)
{
    <div class="ad-card ad-card--down ad-llm__panel">
        <strong>웹 검색 상태를 읽지 못했습니다.</strong>
        <div class="ad-card__why">AI 서비스(AIAgentServer)가 답하지 않습니다.</div>
    </div>
}
else
{
    <DxFormLayout CssClass="ad-deck">
        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6"
                           CssClass="@($"ad-card ad-card--{WebServerTone(web)}")">
            <CaptionTemplate>
                <span class="ad-card__name">도구 서버</span>
                <span class="jsini-badge @BadgeOf(WebServerTone(web))">
                    @(web.Connected ? "붙음" : web.Server?.Reachable == true ? "응답" : "응답 없음")
                </span>
                @* 주소도 머리에 적지 않는다 — 대문자로 올라가면 경로가 달라진다
                   (`/mcp` → `/MCP`). 그대로 옮겨 적을 수 있어야 하는 값이다 *@
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <dl class="ad-llm__kv">
                            <dt>주소</dt><dd class="ad-desc__mono">@(web.Endpoint ?? "—")</dd>
                            <dt>검색 뒷단</dt>
                            <dd>
                                @SearchName(web.Server?.SearchProvider)
                                <span class="ad-llm__dim"> · McpServer 설정이 정한다</span>
                            </dd>
                            <dt>걸린 시간</dt><dd>@Num(web.Server?.LatencyMs, " ms")</dd>
                            <dt>확인</dt>
                            <dd>
                                @(web.Server is { } ws ? ws.CheckedAt.Kst("HH:mm:ss") : "—")
                                <span class="ad-llm__dim"> · 2분마다 (누르면 지금)</span>
                            </dd>
                        </dl>

                        @if (web.Tools.Count > 0)
                        {
                            <div class="ad-llm__procs">
                                @foreach (var t in web.Tools)
                                {
                                    <span class="ad-llm__proc" title="@t.Description">@t.Name</span>
                                }
                            </div>
                        }

                        @if (!web.Enabled)
                        {
                            <div class="ad-card__why">도구가 꺼져 있습니다. (Mcp:Enabled)</div>
                        }
                        else if (web.Server is { Reachable: false, Message: { Length: > 0 } mwhy })
                        {
                            <div class="ad-card__why">@mwhy</div>
                        }
                        else if (!web.Connected)
                        {
                            <div class="ad-card__why">
                                도구 목록을 받지 못했습니다 — <b>모델은 웹을 못 찾고 아는 것만으로 답합니다.</b>
                            </div>
                        }
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>

        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.Card"
                           ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.None"
                           ColSpanXs="12" ColSpanMd="6"
                           CssClass="@($"ad-card ad-card--{(web.AugmentChat ? "up" : "off")}")">
            <CaptionTemplate>
                <span class="ad-card__name">대화에 끼우기</span>
                <span class="jsini-badge @(web.AugmentChat ? "jsini-badge--on" : "jsini-badge--off")">
                    @(web.AugmentChat ? "켜짐" : "꺼짐")
                </span>
                <span class="ad-card__sub">웹 검색</span>
            </CaptionTemplate>
            <Items>
                <DxFormLayoutItem ColSpanXs="12">
                    <Template>
                        <dl class="ad-llm__kv">
                            <dt>도구 왕복</dt>
                            <dd>최대 @Num(web.MaxToolRounds)번<span class="ad-llm__dim"> · 막지 않으면 같은 검색을 되풀이한다</span></dd>
                            <dt>사내 문서 우선</dt>
                            <dd>점수 @Num(web.SkipWhenRagScore, "", 2) 이상이면 웹을 건너뛴다</dd>
                            <dt>설정</dt><dd class="ad-desc__mono">Mcp:AugmentChat</dd>
                        </dl>
                        <div class="ad-card__why">
                            @if (web.AugmentChat)
                            {
                                <text>보통 대화에서도 웹을 찾습니다 — 질문마다 「찾아볼까」를 묻는 왕복이 하나 늘어납니다.</text>
                            }
                            else
                            {
                                <text>보통 대화는 웹을 찾지 않습니다. <b>「웹으로 묻기」(<span class="ad-desc__mono">/chat/web</span>)는 그대로 됩니다.</b></text>
                            }
                        </div>
                    </Template>
                </DxFormLayoutItem>
            </Items>
        </DxFormLayoutGroup>
    </DxFormLayout>

    @* 눌러 본 결과. **0건도 실패다** — 화면을 긁는 뒷단은 구조가 바뀌면
       오류 없이 빈 목록을 준다 *@
    @if (_webCheck is { } wc)
    {
        <div class="ad-llm__panel">
            <div class="ad-llm__webhead">
                <span class="jsini-badge @(wc.Ok ? "jsini-badge--on" : "jsini-badge--err")">
                    @(wc.Ok ? $"{wc.Count}건" : "못 찾음")
                </span>
                <span>「@wc.Query」</span>
                <span class="ad-llm__dim">@Num(wc.LatencyMs, " ms")</span>
            </div>

            @foreach (var hit in wc.Results)
            {
                <div class="ad-llm__webhit">
                    <a href="@hit.Url" target="_blank" rel="noopener noreferrer">@hit.Title</a>
                    <span class="ad-llm__dim">@hit.Url</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(wc.Note))
            {
                <div class="ad-card__why">@wc.Note</div>
            }
        </div>
    }
}

@if (M is { } mf)
{
    <div class="ad-stamp ad-llm__foot">
        커널 @mf.System?.Kernel · 물어본 곳 @_hw?.Endpoint
    </div>
}
