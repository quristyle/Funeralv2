@page "/admin/auth/role"
@attribute [RouteKey("admin.auth.role")]

@*
    [역할 관리] DB 메뉴 `/auth/role`. 왼쪽은 역할 CRUD, 오른쪽은 고른 역할에 사람을 지정하고 메뉴별 권한을 정한다.
    세 화면(역할 · 메뉴롤 · 사람롤)이 같은 role-permission 저장 경로를 쓴다. 오른쪽은 탭이다 — 메뉴 권한 표가 열다섯 칸이라 나란히 두면 체크박스가 잘린다.
    메뉴가 쓰지 않는다고 한 항목은 잠그고(서버가 AND 로 묶는다), 사용자 정의 칸은 쓰는 메뉴가 없으면 감춘다. 체크는 누르는 즉시 바뀐 메뉴만 저장한다.
*@

@inherits DataPage

<PageTitle>역할 관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
    <Actions>
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="역할 등록" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus" Click="@OpenNew" />
        </PermissionView>
    </Actions>
</CommSch>

@* 끌어서 나누는 판 둘. 사람롤과 같은 부품이다 — 왼쪽이 좁은 까닭은 역할이 열몇 개뿐이고 오른쪽 권한 표가 폭을 많이 쓰기 때문이다. *@
<DxSplitter CssClass="ad-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
    <Panes>

    <DxSplitterPane Size="30%" MinSize="240px" MaxSize="60%">
    <section class="ad-vsplit__pane ad-vsplit__pane--left ad-rolelist">
        @* 역할은 열몇 개뿐이라 가상 스크롤 없이 한 쪽에 다 깐다. *@
        <CommGrd TItem="RoleDto"
                 Data="@Shown"
                 MobileCards="false"
                 ExportName="역할"
                 VirtualScrollingEnabled="false"
                 PageSize="1000"
                 OnDelete="@DeleteAsync"
                 DeleteConfirm="@DeleteMessage"
                 Reload="@ReloadAsync"
                 SelectedItem="@_role"
                 SelectedItemChanged="@SelectRoleAsync">
            <ContextMenuItems>
                <PermissionView Action="MenuAction.Create">
                    <CommMenuItem Text="역할 등록" IconCssClass="jsini-icon-plus" Click="@OpenNew" />
                </PermissionView>
            </ContextMenuItems>

            <RowActions Context="r">
                <PermissionView Action="MenuAction.Update">
                    <DxButton IconCssClass="jsini-icon-edit"
                              Title="수정"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => OpenEdit(r))" />
                </PermissionView>
            </RowActions>

            <Columns>
                <DxGridDataColumn FieldName="@nameof(RoleDto.Name)" Caption="역할 이름" MinWidth="140">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var r = (RoleDto)cell.DataItem;
                        }
                        <div>
                            <div>@r.Name</div>
                            <div style="font-size: 0.85em; color: var(--bs-secondary); margin-top: 2px;">@r.Id</div>
                        </div>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                

                <DxGridDataColumn Caption="상태" Width="80">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var r = (RoleDto)cell.DataItem;
                        }
                        <span class="jsini-badge @(r.Status == 1 ? "jsini-badge--on" : "jsini-badge--off")">
                            @(r.Status == 1 ? "사용" : "중지")
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </section>
    </DxSplitterPane>

    <DxSplitterPane>
    <section class="ad-vsplit__pane ad-vsplit__pane--right">
        @if (_role is null)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="왼쪽에서 권한을 설정할 역할을 고르십시오." />
        }
        else
        {
            <h2 class="ad-subhead">@_role.Name <span class="ad-stamp">@_role.Id</span></h2>

            @* 탭으로 가른다 — 메뉴 권한 표가 열다섯 칸이라 사람 목록과 나란히 두면 체크박스가 다 잘린다. *@
            <DxTabs RenderMode="TabsRenderMode.OnDemand" CssClass="ad-roletabs">

                <DxTabPage Text="@($"지정 사용자 ({_users.Count})")">
                    <div class="ad-roletabs__body">
                        <DxSplitter CssClass="ad-hsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
                            <Panes>
                                <DxSplitterPane Size="50%">
                                    <CommGrd TItem="RoleUserDto" Data="@_users"
                                 MobileCards="false"
                                 ExportName="지정 사용자"
                                 EmptyText="지정된 사용자가 없습니다."
                                 Reload="@(() => LoadUsersAsync())"
                                 RowActions="@UserActions"
                                 SelectedItem="@_pickedUser"
                                 SelectedItemChanged="@((RoleUserDto? u) => _pickedUser = u)"
                                 OnRowDoubleClick="@RemoveUserAsync"
                                 AllowDragRows="true"
                                 AllowedDropTarget="DevExpress.Blazor.GridAllowedDropTarget.External"
                                 ItemsDropped="@OnGridItemsDroppedAsync">
                            <ContextMenuItems>
                                <PermissionView Action="MenuAction.Update">
                                    <CommMenuItem Text="사용자 추가" IconCssClass="jsini-icon-plus"
                                                     Click="@OpenPickerAsync" />
                                </PermissionView>
                            </ContextMenuItems>

                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.LoginId)" Caption="사용자 ID" Width="130" />
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.UserName)" Caption="사용자명" Width="120" />
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.CompanyName)" Caption="소속 회사" MinWidth="130" />
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.DeptName)" Caption="소속 부서" MinWidth="130" />
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.Email)" Caption="이메일" MinWidth="160" />
                                <DxGridDataColumn FieldName="@nameof(RoleUserDto.Phone)" Caption="연락처" Width="120" />
                            </Columns>
                        </CommGrd>
                                </DxSplitterPane>

                                <DxSplitterPane>
                                    @* 위아래로 쌓이는 좁은 화면에서만 선다 — 위 표에서 고른 사람을 빼고 아래 조직도에서 고른 사람을 넣는다. *@
                                    <PermissionView Action="MenuAction.Update">
                                        <div class="ad-roleshift">
                                            <DxButton Text="넣기" IconCssClass="jsini-icon-arrow-up"
                                                      RenderStyle="ButtonRenderStyle.Primary"
                                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                      Title="아래 조직도에서 고른 사람에게 이 역할을 겁니다"
                                                      Enabled="@CanAddPicked"
                                                      Click="@(() => AddNodeAsync(_pickedNode!))" />
                                            <DxButton Text="빼기" IconCssClass="jsini-icon-arrow-up ad-roleshift__down"
                                                      RenderStyle="ButtonRenderStyle.Danger"
                                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                      Title="위 표에서 고른 사람에게서 이 역할을 뗍니다"
                                                      Enabled="@(_pickedUser is not null)"
                                                      Click="@(() => RemoveUserAsync(_pickedUser!))" />
                                        </div>
                                    </PermissionView>
                                    <CommTree TItem="OrgNode" Data="@_orgTree"
                                              KeyFieldName="@nameof(OrgNode.Id)"
                                              ParentKeyFieldName="@nameof(OrgNode.ParentId)"
                                              ChildrenFieldName="@nameof(OrgNode.Children)"
                                              EmptyText="조직도를 불러오지 못했습니다."
                                              SelectedItem="@_pickedNode"
                                              SelectedItemChanged="@((OrgNode? n) => _pickedNode = n)"
                                              OnRowDoubleClick="@AddNodeAsync"
                                              AllowDragRows="true"
                                              AllowedDropTarget="DevExpress.Blazor.TreeListAllowedDropTarget.External"
                                              ItemsDropped="@OnTreeItemsDroppedAsync">
                                        <Columns>
                                            <DxTreeListDataColumn FieldName="@nameof(OrgNode.Name)" Caption="부서/사용자" MinWidth="200">
                                                <CellDisplayTemplate Context="cell">
                                                    @{
                                                        var n = (OrgNode)cell.DataItem;
                                                    }
                                                    <span style="@(n.IsUser ? "color: var(--bs-primary);" : "")">
                                                        @n.Name @(n.IsUser ? $"({n.LoginId})" : "")
                                                    </span>
                                                </CellDisplayTemplate>
                                            </DxTreeListDataColumn>
                                        </Columns>
                                    </CommTree>
                                </DxSplitterPane>
                            </Panes>
                        </DxSplitter>
                    </div>
                </DxTabPage>

                <DxTabPage Text="@($"메뉴 세부 권한 ({GrantedMenuCount})")">
                    <div class="ad-roletabs__body">
                        @if (NoCustomConfigured)
                        {
                            @* 사용자 정의 칸을 아무 메뉴도 안 쓰면 칸이 안 보이는 것이 고장으로 읽히지 않게 말해 둔다. *@
                            <PageNotice Tone="NoticeTone.Info"
                                        Text="사용자 정의 권한(1~8)을 쓰는 메뉴가 없어 그 칸은 감춰 두었습니다. [메뉴 관리]에서 켜면 여기에 나타납니다." />
                        }

                        <CommTree TItem="RoleMenuRow" Data="@_menuTree"
                                  KeyFieldName="@nameof(RoleMenuRow.MenuId)"
                                  ChildrenFieldName="@nameof(RoleMenuRow.Children)"
                                  ExportName="메뉴 권한"
                                  EmptyText="메뉴가 없습니다."
                                  Reload="@(() => LoadMenusAsync())">
                            <FooterLeft>
                                @* 누르는 즉시 저장되므로 단추 대신 지금 보내는 중인지만 적는다 — 끝나기 전에 다른 역할로 옮겨도 되는지 알 수 있어야 한다. *@
                                @if (_pendingSaves > 0)
                                {
                                    <span class="ad-stamp">저장 중…</span>
                                }
                            </FooterLeft>

                            <Columns>
                                <DxTreeListDataColumn Caption="메뉴" MinWidth="260">
                                    <CellDisplayTemplate Context="cell">
                                        @{
                                            var row = (RoleMenuRow)cell.DataItem;
                                        }
                                        @* 코드가 아니라 메뉴명을 적는다 — 「대시보드」가 업무마다 있어 이름만으론 갈리지 않으니 코드는 아래 작게 깐다.
                                           단추는 이름 줄에 붙인다 — 긴 코드가 같은 줄에 있으면 단추를 칸 밖으로 밀어내 행이 안 보이는 줄이 생긴다. *@
                                        <span class="ad-rolemenu__name">
                                            <span class="ad-rolemenu__head">
                                                <span class="ad-rolemenu__title">@row.MenuName</span>

                                                @* 일괄 켜기·끄기. 잠긴 칸은 건너뛴다(머리말). *@
                                                <PermissionView Action="MenuAction.Update">
                                                    <span class="jsini-actions">
                                                        <DxButton Text="행" RenderStyle="ButtonRenderStyle.Link"
                                                                  Title="이 메뉴의 권한을 한 번에 켜고 끕니다"
                                                                  Click="@(() => ToggleAsync([row]))" />

                                                        @if (row.Children.Count > 0)
                                                        {
                                                            <DxButton Text="하위" RenderStyle="ButtonRenderStyle.Link"
                                                                      Title="이 메뉴와 하위 전체의 권한을 한 번에 켜고 끕니다"
                                                                      Click="@(() => ToggleAsync(Subtree(row)))" />
                                                        }
                                                    </span>
                                                </PermissionView>
                                            </span>

                                            @if (row.Stamp.Length > 0)
                                            {
                                                <span class="ad-rolemenu__code" title="@row.Stamp">@row.Stamp</span>
                                            }
                                        </span>
                                    </CellDisplayTemplate>
                                </DxTreeListDataColumn>

                                @foreach (var item in ShownItems)
                                {
                                    <DxTreeListDataColumn Caption="@item.Caption" Width="@(item.IsCustom ? "80px" : "64px")">
                                        <CellDisplayTemplate Context="cell">
                                            @{
                                                var row = (RoleMenuRow)cell.DataItem;
                                                var used = item.Used(row.Source);
                                            }
                                            @* 메뉴가 안 쓰는 항목은 잠근다 — 켜도 아무 일이 없는 칸을 열어 두면 「켰는데 왜 안 되지」가 된다. 고칠 권한이 없으면 보기만 한다. *@
                                            <span title="@item.Hint(row, used)">
                                                <DxCheckBox Checked="@item.Get(row.Source)"
                                                            CheckedChanged="@((bool v) => SetAsync(row, item, v))"
                                                            Enabled="@(used && _canEdit)" />
                                            </span>
                                        </CellDisplayTemplate>
                                    </DxTreeListDataColumn>
                                }
                            </Columns>
                        </CommTree>
                    </div>
                </DxTabPage>
            </DxTabs>
        }
    </section>
    </DxSplitterPane>

    </Panes>
</DxSplitter>

@* 이미 지정된 사람은 서버가 빼고 준다(eligible-users) — 화면에서 거르면 서버 판정과 어긋난다. *@
<CommPopup @bind-Visible="_pickerOpen"
           HeaderText="사용자 추가"
           Width="min(900px, calc(100vw - 2rem))">
    <BodyContentTemplate Context="popup">
        <DxSplitter CssClass="ad-hsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
                            <Panes>
                                <DxSplitterPane Size="50%">
                                    <CommGrd TItem="RoleUserDto" Data="@_pickable" PageSize="10"
                 ShowExcelExport="false"
                 EmptyText="추가할 수 있는 사용자가 없습니다."
                 Reload="@LoadPickableAsync">
            <Columns>
                @* DevExpress 다중 선택을 쓰지 않는다 — CommGrd 가 이름을 선언하지 않아 대리자가 흘러가 화면이 그리기 전에 500 으로 죽는다(web/CLAUDE.md). 칸 하나를 직접 그린다. *@
                <DxGridDataColumn Caption="" Width="44">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var u = (RoleUserDto)cell.DataItem;
                        }
                        <DxCheckBox Checked="@_picked.Contains(u.Id)"
                                    CheckedChanged="@((bool v) => Pick(u.Id, v))" />
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(RoleUserDto.LoginId)" Caption="사용자 ID" Width="130" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.UserName)" Caption="사용자명" Width="120" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.CompanyName)" Caption="소속 회사" MinWidth="130" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.DeptName)" Caption="소속 부서" MinWidth="130" />

                @* 이미 가진 역할. 하나 더 거는 것이라 무엇을 갖고 있는지 보여야 한다. *@
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.RoleNames)" Caption="할당된 역할" MinWidth="160" />
            </Columns>
        </CommGrd>
                                </DxSplitterPane>

                                <DxSplitterPane>
                                    <CommTree TItem="OrgNode" Data="@_orgTree"
                                              KeyFieldName="@nameof(OrgNode.Id)"
                                              ParentKeyFieldName="@nameof(OrgNode.ParentId)"
                                              ChildrenFieldName="@nameof(OrgNode.Children)"
                                              EmptyText="조직도를 불러오지 못했습니다."
                                              AllowDragRows="true"
                                              AllowedDropTarget="DevExpress.Blazor.TreeListAllowedDropTarget.External"
                                              ItemsDropped="@OnTreeItemsDroppedAsync">
                                        <Columns>
                                            <DxTreeListDataColumn FieldName="@nameof(OrgNode.Name)" Caption="부서/사용자" MinWidth="200">
                                                <CellDisplayTemplate Context="cell">
                                                    @{
                                                        var n = (OrgNode)cell.DataItem;
                                                    }
                                                    <span style="@(n.IsUser ? "color: var(--bs-primary);" : "")">
                                                        @n.Name @(n.IsUser ? $"({n.LoginId})" : "")
                                                    </span>
                                                </CellDisplayTemplate>
                                            </DxTreeListDataColumn>
                                        </Columns>
                                    </CommTree>
                                </DxSplitterPane>
                            </Panes>
                        </DxSplitter>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <span class="ad-stamp">@_picked.Count 명 선택</span>
        <span class="jsini-notice-popup__gap"></span>
        <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _pickerOpen = false)" />
        <DxButton Text="추가" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_picked.Count > 0)"
                  Click="@AssignAsync" />
    </FooterContentTemplate>
</CommPopup>

@* 역할 등록·수정 창. 공통 팝업(CommPopup)으로 띄운다. *@
<CommPopup @bind-Visible="_roleEditOpen"
           HeaderText="@(_isNew ? "역할 등록" : "역할 수정")"
           Width="560px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="ad-editform">
            <DxFormLayoutItem Caption="식별자" ColSpanMd="6">
                <DxTextBox @bind-Text="_editRole.Id" ReadOnly="@(!_isNew)" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="역할 이름" ColSpanMd="6">
                <DxTextBox @bind-Text="_editRole.Name" />
            </DxFormLayoutItem>

            @if (_isNew)
            {
                <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                    <AiCodeSuggest Word="@_editRole.Name"
                                   OnPick="@(code => _editRole.Id = code)" />
                </DxFormLayoutItem>
            }

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="_editRole.Remark" Rows="3" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="12">
                <DxCheckBox @bind-Checked="_editRole.IsActive">사용</DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveRoleAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _roleEditOpen = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>지정 사용자 표의 관리 칸 — 해제.</summary>
    private RenderFragment<RoleUserDto> UserActions => user =>@<text>
        <PermissionView Action="MenuAction.Update">
            <DxButton IconCssClass="jsini-icon-subtract" RenderStyle="ButtonRenderStyle.Link"
                      Title="이 사람에게서 이 역할을 뗍니다"
                      Click="@(() => RemoveUserAsync(user))" />
        </PermissionView>
    </text>;
}
