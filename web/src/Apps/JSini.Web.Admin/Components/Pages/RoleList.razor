@page "/admin/auth/role"

@*
    [역할 관리] — DB 메뉴 `/auth/role`.
    이력: Vue `views/portal/auth/role` → 여기.

    이 화면도 보기 자료를 그리고 있었다 — 「SUPER_ADMIN · FUNERAL_MANAGER ·
    USER」 세 줄이 코드에 박혀 있었다.

    [역할 식별자를 사람이 정한다]

    자동 번호가 아니다. 권한 판정과 로그에 그대로 찍히기 때문이다 —
    숫자면 로그를 봐도 무슨 역할인지 알 수 없다. 그래서 등록할 때만 받고
    수정에서는 잠근다. 바꾸면 그 역할이 걸린 계정·메뉴 권한이 통째로 끊긴다.

    [메뉴별 권한은 여기서 정하지 않는다]

    「어느 역할이 어느 메뉴를 볼 수 있는가」는 `/admin/auth/menu-role`,
    「누가 이 역할을 가지는가」는 `/admin/auth/user-role` 이다. 옛 화면도
    그렇게 셋으로 나뉘어 있었다 — 한 화면에 다 넣으면 표가 세 겹이 된다.

    [다만 「이 역할을 지우면 누가 영향받나」는 여기서 보인다]

    역할을 고르면 그 역할이 걸린 사람을 아래에 편다(읽기 전용).
    **거는 일은 여기서 하지 않는다** — 사람에게 거는 길이 이미 「사람롤」에
    있고, 같은 일을 하는 자리를 둘로 만들면 한쪽에만 규칙이 붙는다.
    삭제를 누르기 전에 무엇이 딸려 있는지 보이는 것이 목적이다.
*@

@inherits DataPage
@inject AdminClient Api
@inject NavigationManager Navigation

<PageTitle>역할 관리 · 포털관리</PageTitle>

<CommSch>
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" NullText="역할 이름·식별자 검색" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommGrd TItem="RoleDto"
         Data="@Shown"
         EditFormTitle="역할"
         ExportName="역할"
         PageSize="20"
         OnNew="@FillNew"
         OnSave="@SaveAsync"
         OnDelete="@DeleteAsync"
         Reload="@ReloadAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(RoleDto.Id)" Caption="식별자" Width="170" />
        <DxGridDataColumn FieldName="@nameof(RoleDto.Name)" Caption="역할 이름" MinWidth="160" />
        <DxGridDataColumn FieldName="@nameof(RoleDto.Remark)" Caption="설명" MinWidth="220" />

        <DxGridDataColumn Caption="상태" Width="90">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (RoleDto)cell.DataItem;
                }
                <span class="jsini-badge @(r.Status == 1 ? "jsini-badge--on" : "jsini-badge--off")">
                    @(r.Status == 1 ? "사용" : "중지")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 두 화면으로 건너가는 길. 옛 화면에도 있던 것이라 역할을 고른 채로
           바로 넘어갈 수 있다. *@
        <DxGridDataColumn Caption="연결" Width="150" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (RoleDto)cell.DataItem;
                }
                <div class="jsini-actions">
                    <DxButton Text="메뉴"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => Navigation.NavigateTo($"/admin/auth/menu-role?role={Uri.EscapeDataString(r.Id)}"))" />
                    <DxButton Text="사용자"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => Navigation.NavigateTo($"/admin/auth/user-role?role={Uri.EscapeDataString(r.Id)}"))" />
                    <DxButton Text="누가?"
                              RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => ShowUsersAsync(r))" />
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>

    <EditFormTemplate Context="edit">
        @{
            var r = (RoleDto)edit.EditModel;
            var isNew = !_all.Any(x => x.Id == r.Id);
        }
        <DxFormLayout CssClass="ad-editform">
            <DxFormLayoutItem Caption="식별자" ColSpanMd="6">
                <DxTextBox @bind-Text="r.Id" ReadOnly="@(!isNew)"
                           NullText="ADMIN 처럼 영문 대문자" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="역할 이름" ColSpanMd="6">
                <DxTextBox @bind-Text="r.Name" NullText="사람이 읽는 이름" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="r.Remark" Rows="3" NullText="이 역할이 무엇을 하는가" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="12">
                <DxCheckBox @bind-Checked="r.IsActive">사용</DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditFormTemplate>
</CommGrd>

@if (_usersOf is not null)
{
    <h2 class="ad-section">@_usersOf.Name 을 가진 사람 (@_users.Count)</h2>

    @if (_users.Count == 0)
    {
        <p class="ad-stamp">이 역할이 걸린 사람이 없습니다.</p>
    }
    else
    {
        <CommGrd TItem="RoleUserDto" Data="@_users">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.LoginId)" Caption="아이디" Width="150" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.UserName)" Caption="이름" Width="140" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.CompanyName)" Caption="회사" Width="160" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.DeptName)" Caption="부서" Width="160" />
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.Email)" Caption="이메일" MinWidth="180" />

                @* 이 사람이 가진 역할 전부. 하나를 풀어도 다른 역할이 같은
                   메뉴를 주고 있으면 접근이 그대로다. *@
                <DxGridDataColumn FieldName="@nameof(RoleUserDto.RoleNames)" Caption="가진 역할" MinWidth="200" />
            </Columns>
        </CommGrd>
    }

    <p class="ad-stamp">
        거는 일과 푸는 일은 [권한 › 사람롤]에서 합니다 — 같은 일을 하는 자리를
        둘로 만들지 않습니다.
    </p>
}

@code {
    private IReadOnlyList<RoleDto> _all = [];
    private string? _keyword;

    private RoleDto? _usersOf;
    private IReadOnlyList<RoleUserDto> _users = [];

    private IReadOnlyList<RoleDto> Shown
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_keyword))
            {
                return _all;
            }

            var k = _keyword.Trim();
            return [.. _all.Where(r =>
                r.Name.Contains(k, StringComparison.OrdinalIgnoreCase)
                || r.Id.Contains(k, StringComparison.OrdinalIgnoreCase))];
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetRolesAsync();
        return _all.Count;
    }, "등록된 역할이 없습니다.", "역할 목록을 읽지 못했습니다");

    /// <summary>
    /// 이 역할이 걸린 사람. <b>읽기만 한다</b> —
    /// 삭제·수정을 누르기 전에 무엇이 딸려 있는지 보이는 것이 목적이다.
    /// </summary>
    private Task ShowUsersAsync(RoleDto role) => LoadAsync(async () =>
    {
        _usersOf = role;
        _users = await Api.GetRoleUsersAsync(role.Id);

        return _users.Count;
    }, "이 역할이 걸린 사람이 없습니다.", "역할이 걸린 사람을 읽지 못했습니다");

    private void FillNew(RoleDto r) => r.Status = 1;

    private async Task SaveAsync((RoleDto Item, bool IsNew) e)
    {
        var body = new SaveRoleDto
        {
            Id = e.Item.Id,
            Name = e.Item.Name,
            Remark = e.Item.Remark,
            Status = e.Item.Status,
            Permissions = e.Item.Permissions,
        };

        if (e.IsNew)
        {
            await Api.CreateRoleAsync(body);
            return;
        }

        await Api.UpdateRoleAsync(e.Item.Id, body);
    }

    private Task DeleteAsync(RoleDto r) => Api.DeleteRoleAsync(r.Id);
}
