@page "/admin/push/setting"
@attribute [RouteKey("admin.push.setting")]

@*
    [알림 설정] — DB 메뉴 `/system/push/setting`.
    이력: Vue `views/portal/system/push/setting` → 여기.

    내 수신 설정과 등록된 기기를 본다.

    [주소가 틀려 404 였다]

    알림 서비스의 게이트웨이 접두사는 `notification` 이고 서비스 안의 묶음은
    `/notifications` 다. 둘 다 있어야 한다 — `notify/preferences/me` 로 부르던
    동안 이 화면은 늘 「설정을 읽지 못했습니다」였다.

    [응답이 설정만 오는 것이 아니다]

    설정과 함께 **푸시를 보낼 수 있는 서버인지**(`pushAvailable`)와 등록된
    기기가 같이 온다. 앞엣것이 중요하다 — 서버에 VAPID 키가 없으면 스위치를
    켜도 아무 일도 일어나지 않는데, 그것을 안 알려 주면 사용자는 자기 기기
    문제로 여긴다.

    [구독 등록·해제를 여기서 한다] (2026-09-13)

    한동안 이 화면은 등록된 기기를 보여 주고 시험 발송만 했다 — 브라우저
    푸시 구독에 필요한 배관(서비스워커 · VAPID 키 교환)이 Vue 에서 넘어오지
    않았기 때문이다. 그래서 **기기 목록이 영원히 비어 있었다.** 새로 구독할
    길이 없었으니 당연한데, 화면만 보면 "아직 기기를 안 붙였나 보다" 로
    읽혀서 잘못된 것으로 보이지 않았다.

    배관은 셸의 wwwroot/js/pwa.js 에 있다(서비스워커는 /push-sw.js).
    이 화면은 그것을 부르고, 결과를 서버에 옮긴다.

    [권한 요청은 반드시 단추 클릭에서 이어져야 한다]

    화면이 뜨자마자 부르면 브라우저가 조용히 거절한다. 그래서 상태 읽기
    (`jsiniPwa.status`)와 구독 만들기(`jsiniPwa.subscribe`)를 갈라 두었다 —
    앞엣것만 자동으로 돌고, 뒤엣것은 사람이 누를 때만 돈다.
*@

@inherits DataPage
@inject AdminClient Api
@inject IJSRuntime JS

<PageTitle>알림 설정 · 포털관리</PageTitle>

@if (_settings is { PushAvailable: false })
{
    @* 서버가 푸시를 못 보내는 상태다. 스위치를 켜도 소용없다는 것을 먼저 말한다. *@
    <PageNotice Tone="NoticeTone.Warning"
                Text="서버에 푸시 발송 키(VAPID)가 설정되어 있지 않습니다. 푸시를 켜도 알림이 가지 않습니다." />
}

@if (_settings is not null && !_settings.Preference.Saved)
{
    <PageNotice Tone="NoticeTone.Info"
                Text="아직 알림 설정을 정한 적이 없어 기본값을 보여 주고 있습니다. 스위치를 한 번 누르면 저장됩니다." />
}

@if (_settings is not null)
{
    <section class="ad-settings">
        <div class="ad-setting">
            <div>
                <div class="ad-setting__name">푸시 알림</div>
                <div class="ad-setting__desc">브라우저로 알림을 받습니다.</div>
            </div>
            <DxCheckBox Checked="@_settings.Preference.PushEnabled"
                        CheckedChanged="@((bool v) => ToggleAsync(p => p.PushEnabled = v))" />
        </div>

        <div class="ad-setting">
            <div>
                <div class="ad-setting__name">이메일 알림</div>
                <div class="ad-setting__desc">같은 내용을 이메일로도 받습니다.</div>
            </div>
            <DxCheckBox Checked="@_settings.Preference.EmailEnabled"
                        CheckedChanged="@((bool v) => ToggleAsync(p => p.EmailEnabled = v))" />
        </div>

        <div class="ad-setting">
            <div>
                <div class="ad-setting__name">기상 특보</div>
                <div class="ad-setting__desc">생활과환경이 특보를 받으면 알립니다.</div>
            </div>
            <DxCheckBox Checked="@_settings.Preference.WeatherEnabled"
                        CheckedChanged="@((bool v) => ToggleAsync(p => p.WeatherEnabled = v))" />
        </div>
    </section>

    @if (_settings.Preference.UpdatedAt is { } at)
    {
        <div class="ad-stamp">마지막 저장 @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
    }
}

<div class="jsini-toolbar">
    <PermissionView Action="MenuAction.Update">
        <DxButton Text="시험 발송" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@TestAsync" />
    </PermissionView>

    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Secondary"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />
</div>

@*
    ── 이 브라우저 ────────────────────────────────────────────────

    기기 목록과 따로 두는 이유는, 목록은 **계정에 붙은 모든 기기**이고
    여기는 **지금 보고 있는 이 브라우저 하나**라서다. 둘을 한 칸에 섞으면
    "해제" 가 무엇을 해제하는지 모호해진다.
*@
<h2 class="ad-subhead">이 브라우저</h2>

@if (_browser is null)
{
    <PageNotice Tone="NoticeTone.Info" Text="브라우저 상태를 확인하고 있습니다…" />
}
else if (!_browser.Supported)
{
    @* iOS 사파리가 여기 걸린다 — 홈 화면에 추가해야 비로소 푸시가 열린다.
       "지원하지 않는다" 로만 말하면 사용자가 할 수 있는 일이 없어 보인다. *@
    <PageNotice Tone="NoticeTone.Warning"
                Text="이 브라우저에서는 웹푸시를 쓸 수 없습니다. 아이폰·아이패드는 홈 화면에 추가한 뒤 그 아이콘으로 열면 됩니다." />
}
else if (_browser.Permission == "denied")
{
    @* 한 번 거부하면 자바스크립트로는 다시 물을 수 없다. 주소창에서 푸는
       길을 알려 주지 않으면 사용자는 단추만 계속 누른다. *@
    <PageNotice Tone="NoticeTone.Warning"
                Text="브라우저에서 이 사이트의 알림을 차단해 두었습니다. 주소창 왼쪽 자물쇠 → 알림에서 허용으로 바꾼 뒤 다시 시도하세요." />
}
else
{
    @* NoticeTone 에 Success 가 없다 — 「됐다」와 「아직이다」 둘 다 알림이다.
       둘을 색으로 가르지 않고 문장으로 가른다. *@
    <PageNotice Tone="NoticeTone.Info"
                Text="@(_browser.Subscribed
                          ? "이 브라우저는 알림을 받도록 등록되어 있습니다."
                          : "이 브라우저는 아직 등록되지 않았습니다. 등록해야 알림이 옵니다.")" />
}

<div class="jsini-toolbar">
    @if (_browser is { Supported: true, Subscribed: false } && _browser.Permission != "denied")
    {
        <DxButton Text="이 브라우저에서 알림 받기" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_settings?.PushAvailable == true && !_busy)"
                  Click="@SubscribeAsync" />
    }

    @if (_browser is { Subscribed: true })
    {
        <DxButton Text="이 브라우저 등록 해제" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_busy)" Click="@UnsubscribeAsync" />
    }
</div>

<h2 class="ad-subhead">등록된 기기 (@Devices.Count)</h2>

<CommGrd TItem="PushDeviceDto" Data="@Devices"
         PageSizeSelectorVisible="false" PagerVisible="false">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.UserAgent)" Caption="기기" MinWidth="320" />
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.CreatedAt)" Caption="등록" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.LastUsedAt)" Caption="최근 사용" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
    </Columns>
</CommGrd>

@code {
    private NotificationSettingsDto? _settings;
    private PushSubscriptionListDto? _subscriptions;

    /// <summary>
    /// 기기 목록.
    ///
    /// 두 곳에서 온다 — 설정 응답의 <c>devices</c> 와 구독 목록. 보통 같지만
    /// 한쪽이 비는 경우가 있어 **더 많이 담긴 쪽**을 쓴다.
    /// </summary>
    private IReadOnlyList<PushDeviceDto> Devices
    {
        get
        {
            var fromSettings = _settings?.Devices ?? [];
            var fromSubs = _subscriptions?.Items ?? [];

            return fromSubs.Count >= fromSettings.Count ? fromSubs : fromSettings;
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var settings = Api.GetMyPreferencesAsync();
        var subs = Api.GetMySubscriptionsAsync();

        await Task.WhenAll(settings, subs);

        _settings = settings.Result ?? new NotificationSettingsDto();
        _subscriptions = subs.Result;

        // 설정을 읽었으면 화면은 채워진 것이다. 기기가 없다고 「없습니다」를
        // 띄우면 설정을 못 읽은 것처럼 보인다.
        return 1;
    }, "설정을 받지 못했습니다.", "설정을 읽지 못했습니다");

    /// <summary>
    /// 스위치를 누르는 즉시 저장한다. 저장 단추를 따로 두면 무엇을 바꿨는지
    /// 사용자가 기억해야 하고, 저장 없이 나가면 조용히 사라진다.
    /// </summary>
    private async Task ToggleAsync(Action<NotificationPreferenceDto> change)
    {
        if (_settings is null)
        {
            return;
        }

        change(_settings.Preference);

        if (await RunAsync(() => Api.SaveMyPreferencesAsync(_settings.Preference),
                           "저장했습니다.", "저장하지 못했습니다"))
        {
            // 저장했으니 「아직 정한 적 없음」 안내를 내린다.
            _settings.Preference.Saved = true;
            _settings.Preference.UpdatedAt = DateTime.UtcNow;
        }
    }

    private Task TestAsync() => RunAsync(
        () => Api.SendTestPushAsync(),
        "시험 알림을 보냈습니다. 잠시 뒤 도착합니다.", "시험 발송을 하지 못했습니다");

    // ── 이 브라우저의 구독 ──────────────────────────────────────

    /// <summary>브라우저 쪽 사정. 아직 못 읽었으면 <c>null</c> 이다.</summary>
    private PushBrowserResult? _browser;

    /// <summary>구독·해제가 도는 동안 단추를 잠근다. 두 번 누르면 기기가 둘 생긴다.</summary>
    private bool _busy;

    /// <summary>
    /// 브라우저 상태를 읽는다.
    ///
    /// <b>OnInitializedAsync 에서 부를 수 없다.</b> 그 시점은 프리렌더 중이라
    /// 브라우저가 아직 없고, JS interop 은 거기서 던진다. 첫 렌더 뒤에 읽고
    /// 화면을 다시 그린다.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await RefreshBrowserAsync();
        StateHasChanged();
    }

    /// <summary>
    /// <c>jsiniPwa.status</c> 를 읽어 <see cref="_browser"/> 에 담는다.
    ///
    /// 스크립트가 아직 안 실렸거나(느린 망) 브라우저가 막아 둔 경우를 위해
    /// 예외를 삼키고 "지원하지 않음" 으로 떨어뜨린다 — 이 화면의 나머지
    /// (설정 스위치 · 기기 목록 · 시험 발송)는 그래도 쓸 수 있어야 한다.
    /// </summary>
    private async Task RefreshBrowserAsync()
    {
        try
        {
            _browser = await JS.InvokeAsync<PushBrowserResult>("jsiniPwa.status");
        }
        catch (Exception)
        {
            _browser = new PushBrowserResult { Supported = false, Permission = "unsupported" };
        }
    }

    /// <summary>
    /// 이 브라우저를 등록한다.
    ///
    /// <para>
    /// 순서가 중요하다 — <b>브라우저에서 먼저 만들고 서버에 올린다.</b>
    /// 반대로 하면 서버에는 있는데 브라우저에는 없는 구독이 남고, 그쪽은
    /// 발송이 계속 실패하면서도 화면에는 등록된 것으로 보인다.
    /// </para>
    /// </summary>
    private async Task SubscribeAsync()
    {
        if (_busy) return;

        var key = _settings?.VapidPublicKey;
        if (string.IsNullOrWhiteSpace(key))
        {
            Say("서버에 푸시 발송 키(VAPID)가 없어 등록할 수 없습니다.", NoticeTone.Warning);
            return;
        }

        _busy = true;
        try
        {
            PushBrowserResult? made;
            try
            {
                made = await JS.InvokeAsync<PushBrowserResult>("jsiniPwa.subscribe", key);
            }
            catch (Exception ex)
            {
                Say($"브라우저에서 구독을 만들지 못했습니다: {ex.Message}", NoticeTone.Error);
                return;
            }

            if (made is not { Ok: true })
            {
                Say(made?.Error ?? "브라우저에서 구독을 만들지 못했습니다.", NoticeTone.Warning);
                await RefreshBrowserAsync();
                return;
            }

            var ok = await RunAsync(
                () => Api.RegisterPushSubscriptionAsync(new PushSubscribeRequest
                {
                    Endpoint = made.Endpoint,
                    P256dh = made.P256dh,
                    Auth = made.Auth
                }),
                "이 브라우저를 등록했습니다.", "등록 정보를 서버에 올리지 못했습니다");

            if (!ok)
            {
                // 서버가 안 받았으면 브라우저 쪽 구독도 되돌린다. 남겨 두면
                // 「구독은 되어 있는데 알림은 안 오는」 상태가 되고, 그 상태는
                // 다시 등록을 눌러도 "이미 있다" 로 통과해 버린다.
                try { await JS.InvokeAsync<PushBrowserResult>("jsiniPwa.unsubscribe"); }
                catch (Exception) { /* 되돌리기 실패까지 사용자에게 말하지 않는다 */ }
            }

            await RefreshBrowserAsync();
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 이 브라우저의 등록을 푼다.
    ///
    /// <b>서버를 먼저 지운다.</b> 브라우저에서 먼저 끊으면 endpoint 를 잃어
    /// 서버 것을 지울 열쇠가 없어진다 — pwa.js 의 <c>unsubscribe</c> 가
    /// 끊기 전에 그 값을 꺼내 돌려주지만, 서버 호출이 실패했을 때 되돌릴
    /// 수 있는 쪽은 이 순서뿐이다.
    /// </summary>
    private async Task UnsubscribeAsync()
    {
        if (_busy) return;

        var endpoint = _browser?.Endpoint;
        if (string.IsNullOrWhiteSpace(endpoint))
        {
            await RefreshBrowserAsync();
            return;
        }

        _busy = true;
        try
        {
            var ok = await RunAsync(
                () => Api.RemovePushSubscriptionAsync(endpoint),
                "이 브라우저의 등록을 해제했습니다.", "해제하지 못했습니다");

            if (!ok) return;

            try { await JS.InvokeAsync<PushBrowserResult>("jsiniPwa.unsubscribe"); }
            catch (Exception ex)
            {
                Say($"서버에서는 지웠지만 브라우저 구독을 끊지 못했습니다: {ex.Message}",
                    NoticeTone.Warning);
            }

            await RefreshBrowserAsync();
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
