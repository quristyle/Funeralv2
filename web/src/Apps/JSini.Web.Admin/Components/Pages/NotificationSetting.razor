@page "/admin/push/setting"

@*
    [알림 설정] — DB 메뉴 `/system/push/setting`.
    이력: Vue `views/portal/system/push/setting` → 여기.

    내 수신 설정과 등록된 기기를 본다.

    [구독 등록·해제는 여기서 하지 않는다]

    브라우저 푸시 구독은 **브라우저 권한**이 필요해서 자바스크립트가 있어야
    한다. 그 배관(서비스 워커 · VAPID 키 교환)은 아직 옮기지 않았다.
    여기서는 이미 등록된 기기를 보여 주고 시험 발송만 한다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>알림 설정 · 포털관리</PageTitle>

<PageHeading Title="알림 설정" Scope="포털관리" />

@if (_pref is not null)
{
    <section class="ad-settings">
        <div class="ad-setting">
            <div>
                <div class="ad-setting__name">푸시 알림</div>
                <div class="ad-setting__desc">브라우저로 알림을 받습니다.</div>
            </div>
            <DxCheckBox Checked="@_pref.PushEnabled" CheckedChanged="@((bool v) => ToggleAsync(p => p.PushEnabled = v))" />
        </div>

        <div class="ad-setting">
            <div>
                <div class="ad-setting__name">이메일 알림</div>
                <div class="ad-setting__desc">같은 내용을 이메일로도 받습니다.</div>
            </div>
            <DxCheckBox Checked="@_pref.EmailEnabled" CheckedChanged="@((bool v) => ToggleAsync(p => p.EmailEnabled = v))" />
        </div>
    </section>
}

<div class="jsini-toolbar">
    <PermissionView Action="MenuAction.Update">
        <DxButton Text="시험 발송" RenderStyle="ButtonRenderStyle.Secondary" Click="@TestAsync" />
    </PermissionView>
</div>

<h2 class="ad-subhead">등록된 기기</h2>
<DxGrid Data="@_subs" ShowFilterRow="false" PageSizeSelectorVisible="false" PagerVisible="false">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushSubscriptionDto.UserAgent)" Caption="기기" MinWidth="320" />
        <DxGridDataColumn FieldName="@nameof(PushSubscriptionDto.CreatedAt)" Caption="등록" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(PushSubscriptionDto.LastUsedAt)" Caption="최근 사용" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
    </Columns>
</DxGrid>

<PageNotice Text="@Notice" Tone="@Tone" />

@code {
    private NotificationPreferenceDto? _pref;
    private IReadOnlyList<PushSubscriptionDto> _subs = [];

    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        var pref = Api.GetMyPreferencesAsync();
        var subs = Api.GetMySubscriptionsAsync();

        await Task.WhenAll(pref, subs);

        _pref = pref.Result ?? new NotificationPreferenceDto();
        _subs = subs.Result;

        return _subs.Count;
    }, "등록된 기기가 없습니다. 브라우저에서 알림을 허용하면 여기 나타납니다.", "설정을 읽지 못했습니다");

    /// <summary>
    /// 스위치를 누르는 즉시 저장한다. 저장 단추를 따로 두면 무엇을 바꿨는지
    /// 사용자가 기억해야 하고, 저장 없이 나가면 조용히 사라진다.
    /// </summary>
    private async Task ToggleAsync(Action<NotificationPreferenceDto> change)
    {
        if (_pref is null) return;

        change(_pref);
        await RunAsync(() => Api.SaveMyPreferencesAsync(_pref), "저장했습니다.", "저장하지 못했습니다");
    }

    private Task TestAsync() => RunAsync(
        () => Api.SendTestPushAsync(),
        "시험 알림을 보냈습니다. 잠시 뒤 도착합니다.", "시험 발송을 하지 못했습니다");
}
