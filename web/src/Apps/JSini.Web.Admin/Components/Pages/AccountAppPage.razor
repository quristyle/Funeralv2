@page "/admin/system/account/{LoginId}/app"
@attribute [RouteKey("admin.system.account.app")]
@attribute [ScreenAccess("admin.system.account")]

@*
    [계정 앱 현황] 계정 하나의 앱·구독·주고받은 기록. 들어오는 길은 계정 관리 줄의 🔔 단추다 — 사람을 골라야 뜻이 생기는 화면이라 사이드바에 세우지 않는다.
    「저 사람만 알림이 안 온다」의 까닭은 몇 가지(VAPID 없음 · 구독 기기 0 · 본인이 끔 · 연속 실패 · 보낸 적 없음)인데 서로 다른 표에 흩어져 있다. 그래서 나란히 놓고 걸리는 것을 맨 위에 문장으로 적는다.
    구독(기기)과 스위치(뜻)는 섞지 않고 기기 한 대씩 보여 준다. 실행 방식(앱 설치 여부)은 구독에 적힌 값이고, 옛 구독의 「모름」은 「안 깔았다」로 그리지 않는다.
    기간은 집계와 기록에만 걸린다 — 기기 목록과 수신 설정은 지금 모습이다.
*@

@inherits DataPage

<PageTitle>@(_status?.UserName ?? LoginId) 앱 현황</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="아이디">
            <span class="ad-appstat__who">
                <strong>@LoginId</strong>
                @if (!string.IsNullOrWhiteSpace(_status?.UserName))
                {
                    <span class="jsini-text-muted">@_status!.UserName</span>
                }
            </span>
        </CommSchItem>

        <CommSchItem Label="기간">
            <DxComboBox Data="@DayOptions" @bind-Value="_days" Style="width: 130px">
                <ItemTemplate>최근 @context 일</ItemTemplate>
            </DxComboBox>
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="계정 관리" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => Navigation.NavigateTo("/admin/system/account"))" />
    </Actions>
</CommSch>

@* ── 걸리는 것부터 말한다 ── 이 화면에 오는 사람은 이미 「안 온다」를 알고 왔다. 표를 읽어 원인을 맞추게 하지 않고, 막는 힘이 센 것부터 문장으로 먼저 적는다. *@

@if (_status is not null && !_status.AccountFound)
{
    <PageNotice Tone="NoticeTone.Warning"
                Text="@($"「{LoginId}」 는 지금 계정 목록에 없습니다. 지워진 계정의 구독·기록만 남아 있을 수 있습니다.")" />
}

@if (_status is { PushAvailable: false })
{
    <PageNotice Tone="NoticeTone.Error"
                Text="서버에 VAPID 키가 없어 푸시가 한 건도 나가지 않습니다. 이 사람만의 문제가 아닙니다 — 서버 설정을 먼저 확인하십시오." />
}
else if (_status is { Devices.Count: 0 })
{
    <PageNotice Tone="NoticeTone.Warning"
                Text="구독한 기기가 없습니다. 푸시를 켜 두어도 도착할 곳이 없습니다 — 본인이 쓰는 브라우저에서 「내 알림 설정 → 이 브라우저에서 알림 받기」를 눌러야 합니다." />
}
else if (_status is { Preference.PushEnabled: false })
{
    <PageNotice Tone="NoticeTone.Warning"
                Text="본인이 푸시 수신을 꺼 두었습니다. 기기는 등록돼 있지만 서버가 발송 직전에 거릅니다." />
}
else if (DeadDevices > 0)
{
    <PageNotice Tone="NoticeTone.Warning"
                Text="@($"기기 {DeadDevices}대가 연달아 실패하고 있습니다. 그 기기는 지금 못 받는 중이며, 본인이 그 브라우저에서 다시 등록해야 합니다.")" />
}

@* 타일은 지금 모습이다 — 기간을 바꿔도 안 변한다. 그래서 아래 집계와 줄을 나눠 둔다. *@
@if (_status is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">구독 기기</div>
            <div class="jsini-stat__value">@_status.Devices.Count</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">앱으로 설치</div>
            <div class="jsini-stat__value">@InstalledDevices</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">푸시 수신(@(_status.Days)일)</div>
            <div class="jsini-stat__value">@Stat("push", "received").Success</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">메일 수신(@(_status.Days)일)</div>
            <div class="jsini-stat__value">@Stat("email", "received").Success</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">안 읽은 쪽지</div>
            <div class="jsini-stat__value">@_status.Notes.UnreadTotal</div>
        </div>
    </div>
}

<h2 class="ad-subhead">계정</h2>

@if (_status is not null)
{
    <dl class="jsini-facts">
        <div class="jsini-fact">
            <dt>로그인 아이디</dt>
            <dd>@_status.OwnerKey</dd>
        </div>
        <div class="jsini-fact">
            <dt>이름</dt>
            <dd>@(_status.UserName ?? "-")</dd>
        </div>
        <div class="jsini-fact">
            <dt>부서</dt>
            <dd>@(_status.DeptName ?? "-")</dd>
        </div>
        <div class="jsini-fact">
            <dt>이메일</dt>
            <dd>
                @if (string.IsNullOrWhiteSpace(_status.Email))
                {
                    @* 메일이 안 가는 까닭의 첫째다 — 스위치를 아무리 켜도 보낼 주소가 없으면 그 사람은 명단에서 빠진다. *@
                    <span class="jsini-badge jsini-badge--warn"
                          title="이메일이 등록돼 있지 않아 역할·아이디로 보내는 메일에서 빠집니다.">없음</span>
                }
                else
                {
                    @_status.Email
                }
            </dd>
        </div>
    </dl>
}

<h2 class="ad-subhead">수신 설정</h2>

@* 저장한 적이 없으면 흐리게 그린다 — 한 번도 안 건드린 것과 일부러 켜 둔 것은 다른 일이다. *@
@if (_status is not null)
{
    <dl class="jsini-facts">
        <div class="jsini-fact">
            <dt>푸시 알림</dt>
            <dd>@Switch(_status.Preference.PushEnabled)</dd>
        </div>
        <div class="jsini-fact">
            <dt>이메일 알림</dt>
            <dd>@Switch(_status.Preference.EmailEnabled)</dd>
        </div>
        <div class="jsini-fact">
            <dt>쪽지 메일 전달</dt>
            <dd>@Switch(_status.Preference.NoteEmailEnabled)</dd>
        </div>
        @* 위의 푸시·이메일 알림 아래 갈래다 — 그것을 꺼도 안 가므로, 왜 안 왔나를 볼 때 넷을 나란히 본다. *@
        <div class="jsini-fact">
            <dt>댓글 앱알림</dt>
            <dd>@Switch(_status.Preference.CommentPushEnabled)</dd>
        </div>
        <div class="jsini-fact">
            <dt>댓글 이메일</dt>
            <dd>@Switch(_status.Preference.CommentEmailEnabled)</dd>
        </div>
        <div class="jsini-fact">
            <dt>기상특보</dt>
            <dd>@Switch(_status.Preference.WeatherEnabled)</dd>
        </div>
        <div class="jsini-fact">
            <dt>내 위치 날씨</dt>
            <dd>
                @Switch(_status.Preference.WeatherLocalEnabled)
                @if (_status.Preference.WeatherLocalEnabled && _status.Preference.WeatherLat is null)
                {
                    @* 켜져 있는데 좌표가 없으면 한 건도 안 나간다 — 스위치만 보면 다 된 것으로 읽히는 자리라 그 자리에서 말한다. *@
                    <span class="jsini-badge jsini-badge--warn" title="위치를 한 번도 잡지 않아 보낼 곳이 없습니다.">위치 없음</span>
                }
            </dd>
        </div>
        <div class="jsini-fact">
            <dt>설정 저장</dt>
            <dd>
                @if (_status.Preference.Saved)
                {
                    <span title="본인이 정한 값입니다.">@Stamp(_status.Preference.UpdatedAt)</span>
                }
                else
                {
                    <span class="jsini-text-muted" title="한 번도 저장한 적이 없어 위 값은 전부 기본값입니다.">한 적 없음(기본값)</span>
                }
            </dd>
        </div>
    </dl>
}

<h2 class="ad-subhead">앱 설치·구독 기기 (@Devices.Count)</h2>

<CommGrd TItem="PushDeviceDto" Data="@Devices"
         EmptyText="구독한 기기가 없습니다. 이 사람에게는 푸시가 도착할 곳이 없습니다."
         ExportName="구독 기기"
         PageSizeSelectorVisible="false">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.UserAgent)" Caption="기기" MinWidth="300">
            <CellDisplayTemplate Context="cell">
                @{ var device = (PushDeviceDto)cell.DataItem; }
                <span title="@device.UserAgent">
                    <strong>@PushDeviceLabel.Name(device)</strong>
                    <br />
                    <span class="jsini-text-muted">@PushDeviceLabel.Details(device)</span>
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 이 화면의 「앱설치」가 여기다 — 구독할 때 브라우저가 적어 보낸 실행 방식이 곧 답이다. *@
        <DxGridDataColumn Caption="실행 방식" Width="130">
            <CellDisplayTemplate Context="cell">
                @{ var installed = PushDeviceLabel.Installed((PushDeviceDto)cell.DataItem); }
                @if (installed is true)
                {
                    <span class="jsini-badge jsini-badge--on" title="홈 화면·시작 메뉴의 아이콘으로 여는 기기입니다.">앱(PWA)</span>
                }
                else if (installed is false)
                {
                    <span class="jsini-badge jsini-badge--off" title="브라우저 탭으로 엽니다. 창을 닫으면 알림이 늦을 수 있습니다.">브라우저 탭</span>
                }
                else
                {
                    <span class="jsini-text-muted" title="이 칸이 생기기 전에 등록한 구독이라 알 수 없습니다.">모름</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.Source)" Caption="구독 경로" Width="110" />

        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.CreatedAt)" Caption="등록" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />

        @* 「마지막 발송」이다 — 보낸 때이고 받은 때가 아니다. 받은 때는 바로 옆 칸이 답한다. *@
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.LastSentAt)" Caption="마지막 발송" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />

        @* 이 칸이 「넷에 보냈는데 하나만 울린다」에 답한다 — 서비스워커가 알림을 띄운 뒤 되알려 준 때다. 비어 있으면 그 기기는 지금 못 받고 있다. *@
        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.LastDeliveredAt)" Caption="마지막 도착" Width="150">
            <CellDisplayTemplate Context="cell">
                @{ var dev = (PushDeviceDto)cell.DataItem; }
                @if (dev.LastDeliveredAt is not null)
                {
                    @dev.LastDeliveredAt.Kst("yyyy-MM-dd HH:mm", string.Empty)
                }
                else if (dev.RecentSentCount > 0)
                {
                    <span class="jsini-badge jsini-badge--warn"
                          title="최근 30일에 @(dev.RecentSentCount)건을 보냈는데 이 기기가 받았다는 보고가 한 번도 없습니다. 브라우저 자료를 지웠거나 알림 권한이 꺼져 있을 수 있습니다.">못 받음</span>
                }
                else
                {
                    <span class="jsini-text-muted" title="이 기기로 보낸 알림이 아직 없습니다.">-</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 최근 30일. 분모는 성공한 발송만 센다 — 못 보낸 줄까지 넣으면 멀쩡한 기기가 「열 중 둘」로 보인다. *@
        <DxGridDataColumn Caption="최근 도달" Width="110"
                          TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var dev = (PushDeviceDto)cell.DataItem; }
                @if (dev.RecentSentCount > 0)
                {
                    <span class="jsini-badge @(dev.RecentDeliveredCount > 0 ? "jsini-badge--on" : "jsini-badge--warn")"
                          title="최근 30일에 보낸 @(dev.RecentSentCount)건 중 이 기기가 받았다고 알려 온 수입니다.">@dev.RecentDeliveredCount / @dev.RecentSentCount</span>
                }
                else
                {
                    <span class="jsini-text-muted">-</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(PushDeviceDto.FailureCount)" Caption="연속 실패" Width="100"
                          TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var fails = ((PushDeviceDto)cell.DataItem).FailureCount; }
                @if (fails > 0)
                {
                    <span class="jsini-badge jsini-badge--err"
                          title="연달아 실패한 횟수입니다. 이 기기는 지금 알림을 못 받고 있습니다.">@fails</span>
                }
                else
                {
                    <span class="jsini-text-muted">-</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>

<h2 class="ad-subhead">주고받은 것 (최근 @(_status?.Days ?? _days)일)</h2>

@* 줄 수는 사람·기기 단위다 — 「몇 번 보냈나」가 아니라 「닿으려 했나」를 센다. 안 닿은 까닭을 찾는 자리라 그쪽이 맞다. *@
<CommGrd TItem="AppChannelStatDto" Data="@Channels"
         EmptyText="집계할 것이 없습니다."
         ExportName="주고받은 것"
         PageSizeSelectorVisible="false">
    <Columns>
        <DxGridDataColumn Caption="길" Width="100">
            <CellDisplayTemplate Context="cell">
                @ChannelText(((AppChannelStatDto)cell.DataItem).Channel)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="방향" Width="100">
            <CellDisplayTemplate Context="cell">
                @DirectionText(((AppChannelStatDto)cell.DataItem).Direction)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(AppChannelStatDto.Total)" Caption="시도" Width="90" />
        <DxGridDataColumn FieldName="@nameof(AppChannelStatDto.Success)" Caption="성공" Width="90" />

        <DxGridDataColumn Caption="실패" Width="90">
            <CellDisplayTemplate Context="cell">
                @{ var stat = (AppChannelStatDto)cell.DataItem; }
                @if (stat.Failure > 0)
                {
                    <span class="jsini-badge jsini-badge--err">@stat.Failure</span>
                }
                else
                {
                    <span class="jsini-text-muted">0</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 메일에는 읽음이 없다 — 0 으로 두면 아무도 안 읽은 것으로 읽히므로 그 줄만 「-」로 적는다. *@
        <DxGridDataColumn Caption="읽음" Width="90">
            <CellDisplayTemplate Context="cell">
                @{ var stat = (AppChannelStatDto)cell.DataItem; }
                @if (stat.Channel == "email")
                {
                    <span class="jsini-text-muted" title="메일은 읽었는지 알 길이 없습니다.">-</span>
                }
                else
                {
                    @stat.Read
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(AppChannelStatDto.LastAt)" Caption="마지막" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
    </Columns>
</CommGrd>

<h2 class="ad-subhead">쪽지</h2>

@if (_status is not null)
{
    <dl class="jsini-facts">
        <div class="jsini-fact">
            <dt>받은 쪽지(@(_status.Days)일)</dt>
            <dd>@_status.Notes.Received</dd>
        </div>
        <div class="jsini-fact">
            <dt>보낸 쪽지(@(_status.Days)일)</dt>
            <dd>@_status.Notes.Sent</dd>
        </div>
        <div class="jsini-fact">
            <dt>메일로도 전달</dt>
            <dd>@_status.Notes.MailForwarded</dd>
        </div>
        <div class="jsini-fact">
            <dt>안 읽은 쪽지(전체)</dt>
            <dd>
                @if (_status.Notes.UnreadTotal > 0)
                {
                    <span class="jsini-badge jsini-badge--warn">@_status.Notes.UnreadTotal</span>
                }
                else
                {
                    <span class="jsini-text-muted">0</span>
                }
            </dd>
        </div>
        <div class="jsini-fact">
            <dt>마지막 수신</dt>
            <dd>@Stamp(_status.Notes.LastReceivedAt)</dd>
        </div>
        <div class="jsini-fact">
            <dt>마지막 발신</dt>
            <dd>@Stamp(_status.Notes.LastSentAt)</dd>
        </div>
    </dl>
}

<h2 class="ad-subhead">최근 기록</h2>

<CommGrd TItem="AppDeliveryRowDto" Data="@Deliveries"
         EmptyText="그 기간에 주고받은 기록이 없습니다."
         ExportName="앱 기록">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(AppDeliveryRowDto.SentAt)" Caption="시각" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />

        <DxGridDataColumn Caption="길" Width="90">
            <CellDisplayTemplate Context="cell">
                @ChannelText(((AppDeliveryRowDto)cell.DataItem).Channel)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="방향" Width="90">
            <CellDisplayTemplate Context="cell">
                @{ var row = (AppDeliveryRowDto)cell.DataItem; }
                <span class="jsini-badge @(row.Direction == "sent" ? "ad-appstat--sent" : "ad-appstat--recv")">
                    @DirectionText(row.Direction)
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* 상대가 없는 줄이 많다 — 시스템이 보낸 것(배포 알림·기상 특보)은 보낸 사람이 없다. 빈칸으로 두면 자료가 빠진 것으로 읽힌다. *@
        <DxGridDataColumn FieldName="@nameof(AppDeliveryRowDto.Counterpart)" Caption="상대" Width="150">
            <CellDisplayTemplate Context="cell">
                @{ var who = ((AppDeliveryRowDto)cell.DataItem).Counterpart; }
                @if (string.IsNullOrWhiteSpace(who))
                {
                    <span class="jsini-text-muted" title="시스템이 보낸 알림입니다.">시스템</span>
                }
                else
                {
                    @who
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(AppDeliveryRowDto.Title)" Caption="제목" MinWidth="220">
            <CellDisplayTemplate Context="cell">
                @{ var row = (AppDeliveryRowDto)cell.DataItem; }
                <span title="@row.Body">@(string.IsNullOrWhiteSpace(row.Title) ? "(제목 없음)" : row.Title)</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="결과" Width="160">
            <CellDisplayTemplate Context="cell">
                @{ var row = (AppDeliveryRowDto)cell.DataItem; }
                @if (!row.Success)
                {
                    <span class="jsini-badge jsini-badge--err" title="@row.FailureReason">
                        @(row.FailureReason ?? "실패")
                    </span>
                }
                else if (row.ReadAt is not null)
                {
                    <span class="jsini-badge jsini-badge--on" title="@Stamp(row.ReadAt)">읽음</span>
                }
                else if (row.Channel == "email")
                {
                    @* 메일은 여기까지가 아는 전부다 — 「안 읽음」으로 적으면 읽었는지 알아본 것처럼 들린다. *@
                    <span class="jsini-badge jsini-badge--on">보냄</span>
                }
                else
                {
                    <span class="jsini-badge">안 읽음</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>
