@page "/admin/company/list"
@attribute [RouteKey("admin.company.list")]

@*
    [회사 관리] — DB 메뉴 `/system/company`.

        왼쪽   회사 목록 — 고르고, 끌어서 차례를 바꾸고, 지운다
        오른쪽 고른 회사의 탭 — 수정(Company/CompanyInfoTab) ·
               부서(CompanyDeptTab) · 사용자(CompanyUserTab)

    사용처(`COMPANY_USAGE_LOCATION`)를 비워 두면 그 업무 시스템의 회사
    드롭다운에서 사라진다 — 목록에서 「없음」으로 드러내는 이유다.
*@

@inherits DataPage

<PageTitle>회사 목록 · 포털관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="사용처">
            <DxComboBox Data="@_usages" TextFieldName="@nameof(CommonCodeDto.CodeName)"
                        ValueFieldName="@nameof(CommonCodeDto.CodeValue)"
                        @bind-Value="_usageFilter" Style="width: 200px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

<DxSplitter CssClass="ad-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
    <Panes>

    <DxSplitterPane Size="45%" MinSize="320px" MaxSize="75%">
    <section class="ad-vsplit__pane ad-vsplit__pane--left">
        @* 편집 폼을 주지 않으면 표가 「수정」 단추를 달지 않고 ＋ 는 OnEditOpen 으로 온다. *@
        <CommGrd TItem="CompanyDto"
                 @ref="_grid"
                 Data="@Shown"
                 ExportName="회사목록"
                 PageSize="20"
                 CreateTitle="회사 등록"
                 OnNew="@FillNew"
                 OnEditOpen="@OnEditOpen"
                 OnSave="@PersistAsync"
                 OnDelete="@DeleteAsync"
                 DeleteConfirm="@DeleteMessage"
                 Reload="@ReloadAsync"
                 SelectedItem="@_selected"
                 SelectedItemChanged="@SelectAsync"
                 AutoSelectFirstRow="false"
                 AllowDragRows="@_canUpdate"
                 ItemsDropped="@OnRowsDroppedAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(CompanyDto.SortOrder)" Caption="순서" Width="70" />
                <DxGridDataColumn FieldName="@nameof(CompanyDto.Name)" Caption="회사명" MinWidth="160" />
                <DxGridDataColumn FieldName="@nameof(CompanyDto.ShortName)" Caption="약칭" Width="110" />

                <DxGridDataColumn Caption="사용처" MinWidth="180" AllowSort="false">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var c = (CompanyDto)cell.DataItem;
                        }
                        @if (c.UsageLocations.Count == 0)
                        {
                            <span class="jsini-badge jsini-badge--off">없음</span>
                        }
                        else
                        {
                            @foreach (var code in c.UsageLocations)
                            {
                                <span class="jsini-badge">@UsageName(code)</span>
                            }
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="사람 · 부서" Width="110" AllowSort="false">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var c = (CompanyDto)cell.DataItem;
                        }
                        <span class="ad-stamp">@c.UserCount 명 · @c.DeptCount 부서</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="상태" Width="80">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var c = (CompanyDto)cell.DataItem;
                        }
                        <span class="jsini-badge @(c.Status == 1 ? "jsini-badge--on" : "jsini-badge--off")">
                            @(c.Status == 1 ? "사용" : "중지")
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </section>
    </DxSplitterPane>

    <DxSplitterPane>
    <section class="ad-vsplit__pane ad-vsplit__pane--right">
        @if (_edit is null || _original is null)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="왼쪽에서 회사를 고르십시오. 새 회사는 표 아래 ＋ 로 등록합니다." />
        }
        else
        {
            <h2 class="ad-subhead ad-company__head">
                <span>@(_isNew ? "새 회사" : _original.Name)</span>
                @if (!_isNew)
                {
                    <span class="ad-stamp">@_original.UserCount 명 · @_original.DeptCount 부서</span>
                }
            </h2>

            @* 새 회사는 아직 아이디가 없어 부서·사용자 탭을 세우지 않는다. *@
            <DxTabs CssClass="ad-roletabs" @bind-ActiveTabIndex="_tab">
                <DxTabPage Text="수정">
                    <div class="ad-roletabs__body">
                        <CompanyInfoTab Edit="@_edit" Original="@_original" IsNew="@_isNew"
                                        Usages="@_usages" CanSave="@CanSave" Saving="@_saving"
                                        OnSave="@SaveEditAsync" OnRevert="@Revert" />
                    </div>
                </DxTabPage>

                @if (!_isNew)
                {
                    <DxTabPage Text="@($"부서 ({_original.DeptCount})")">
                        <div class="ad-roletabs__body">
                            <CompanyDeptTab CompanyId="@_original.Id" CompanyName="@_original.Name"
                                            OnChanged="@ReloadAsync" />
                        </div>
                    </DxTabPage>

                    <DxTabPage Text="@($"사용자 ({_original.UserCount})")">
                        <div class="ad-roletabs__body">
                            <CompanyUserTab CompanyId="@_original.Id" CompanyName="@_original.Name"
                                            OnChanged="@ReloadAsync" />
                        </div>
                    </DxTabPage>
                }
            </DxTabs>
        }
    </section>
    </DxSplitterPane>

    </Panes>
</DxSplitter>

<ConfirmDialog @ref="_confirm" />
