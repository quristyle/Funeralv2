@page "/admin/system/signup"
@attribute [RouteKey("admin.system.signup")]
@attribute [ScreenAccess("admin.system.account")]

@*
    [가입 신청] 로그인 화면의 「가입 신청」으로 들어온 것을 승인하거나 거절한다. DB 메뉴에 없어 사이드바에 뜨지 않고 계정 관리의 단추로 들어온다 — 라우트는 /admin/system/signup 이다.
    승인은 상태를 PENDING 에서 ACTIVE 로 바꾸는 일이고, 거절은 지운다 — REJECTED 로 두면 아이디가 묶여 다시 신청할 수 없다. 소속과 역할은 신청서에 없어 승인 뒤 계정 관리에서 붙인다.
*@

@inherits DataPage

<PageTitle>가입 신청</PageTitle>

@* 거를 조건이 없다 — 승인을 기다리는 것만 내려온다. 계정 관리와 오가는 단추가 두 화면에서 같은 자리에 있어야 해서 판을 세운다. 「초기화」는 없고 다시 읽기만 있다. *@
<CommSch OnSearch="@ReloadAsync">
    <Actions>
        <DxButton Text="계정 관리로" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => Navigation.NavigateTo("/admin/system/account"))" />
    </Actions>
</CommSch>

<CommCont>
    <CommGrd TItem="SignupPendingDto"
             Data="@_pending"
             ExportName="가입신청"
             EmptyText="승인을 기다리는 신청이 없습니다."
             Reload="@ReloadAsync">
        <Columns>
            @* 이름 칸에 얼굴을 함께 그린다 — 사진은 소셜 공급자가 준 것만 쓰고, 직접 입력한 신청은 첫 글자로 대신한다. referrerpolicy 는 카카오 CDN 에 우리 주소를 흘리지 않기 위해 건다. *@
            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.UserName)" Caption="신청자" MinWidth="170">
                <CellDisplayTemplate Context="cell">
                    @{ var row = (SignupPendingDto)cell.DataItem; }
                    <div class="ad-signup__who">
                        <UserAvatar Photo="@row.FaceUrl"
                                    Name="@(string.IsNullOrWhiteSpace(row.UserName) ? row.LoginId : row.UserName)"
                                    CssClass="ad-signup__face" />
                        <strong class="ad-signup__name">@row.UserName</strong>
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.LoginId)" Caption="아이디" Width="130" />

            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.Route)" Caption="가입 경로" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{ var row = (SignupPendingDto)cell.DataItem; }
                    <span class="ad-signup__route ad-signup__route--@(row.SocialProvider?.ToLowerInvariant() ?? "direct")">@row.Route</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.Email)" Caption="이메일" MinWidth="180" />
            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.Phone)" Caption="연락처" Width="130" />
            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.Note)" Caption="하실 말씀" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(SignupPendingDto.RequestedAt)" Caption="신청일" Width="140"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
        </Columns>

        <RowActions Context="row">
            <DxButton IconCssClass="jsini-icon-check-circle" Title="가입을 승인한다" RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => ApproveAsync(row))" />
            <DxButton IconCssClass="jsini-icon-link" Title="기존 계정으로 결합한다" RenderStyle="ButtonRenderStyle.Link"
                      Visible="@(row.SocialProvider != null)"
                      Click="@(() => AskMergeAsync(row))" />
            <DxButton IconCssClass="jsini-icon-close-circle" Title="가입을 거절한다" CssClass="commgrd__icon--warn" RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => AskRejectAsync(row))" />
        </RowActions>
    </CommGrd>
</CommCont>

@* 거절 사유를 묻는 창. 사유는 없어도 되지만 신청자에게 그대로 메일로 가므로 빈 채로 보내면 같은 신청이 다시 들어온다. *@
<CommPopup @bind-Visible="_rejecting" HeaderText="가입 신청 거절" Width="420px">
    <BodyContentTemplate>
        <p class="jsini-hint">
            @(_target?.UserName ?? "-") (@(_target?.LoginId ?? "-")) 님의 신청을 거절합니다.
            <b>신청은 지워집니다.</b>
        </p>

        <DxMemo @bind-Text="_reason" Rows="3"
                NullText="거절 사유 (신청자에게 메일로 그대로 갑니다)" />
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="거절" RenderStyle="ButtonRenderStyle.Danger" Click="@RejectAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _rejecting = false)" />
    </FooterContentTemplate>
</CommPopup>

<CommPopup @bind-Visible="_merging" HeaderText="소셜 가입 결합" Width="480px">
    <BodyContentTemplate>
        <p class="jsini-hint">
            <strong>@(_target?.UserName ?? "-")</strong> (@(_target?.LoginId ?? "-")) 님의 소셜 연결을 기존 계정으로 옮기고 신청은 지웁니다.
        </p>

        <div style="margin-top: 12px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">결합할 대상 계정 선택</label>
            <DxComboBox Data="@_accounts"
                        TextFieldName="@nameof(AccountDto.DisplayText)"
                        ValueFieldName="@nameof(AccountDto.LoginId)"
                        @bind-Value="_targetAccountId"
                        SearchMode="ListSearchMode.AutoSearch"
                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        NullText="계정을 선택하거나 아래에 아이디를 직접 입력하세요" />
        </div>

        <div style="margin-top: 10px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">대상 계정 아이디 직접 입력</label>
            <DxTextBox @bind-Text="_targetAccountId" NullText="대상 계정 로그인 아이디" />
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="결합" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!string.IsNullOrWhiteSpace(_targetAccountId))"
                  Click="@MergeAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _merging = false)" />
    </FooterContentTemplate>
</CommPopup>
