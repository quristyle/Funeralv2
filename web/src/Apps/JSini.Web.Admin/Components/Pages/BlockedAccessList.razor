@page "/admin/status/blocked-access"
@attribute [RouteKey("admin.status.blocked-access")]

@*
    [차단 접근기록] — DB 메뉴 `/admin/status/blocked-access`.

    **상태관리 묶음에 둔다.** 바로 위가 「메뉴 사용기록」이다 — 그쪽이 **열린**
    화면을 적고 이쪽이 **막힌** 화면을 적는다. 둘은 한 짝이라 한 자리에 있어야
    나란히 읽힌다.

    ────────────────────────────────────────────────────────────
    [무엇에 답하는 화면인가]

    물음이 둘인데 **할 일이 아주 다르다.** 그래서 「까닭」 칸이 이 화면에서
    가장 중요한 칸이다.

    | 까닭 | 무슨 일인가 | 할 일 |
    |---|---|---|
    | **권한 없음** | 메뉴는 있는데 그 역할에 열람이 꺼져 있다 | 메뉴 권한에서 체크 하나 |
    | **관리 밖** | 가리킬 메뉴가 아예 없다 | 메뉴로 등록하거나 화면이 `[ScreenAccess]` 로 부모를 가리켜야 한다 |

    뒤엣것은 **권한을 아무리 줘도 안 열린다.** 한 칸에 뭉뚱그리면 관리자가
    권한을 주고 나서 「줬는데 왜 안 되지」로 되돌아온다.

    ────────────────────────────────────────────────────────────
    [서버 로그로는 알 수 없었다]

    포털은 한 회로 안에서 라우팅만 바뀐다. 주소를 쳐서 들어와도 **HTTP 요청이
    한 건도 나가지 않으므로** 접근 로그에는 로그인 한 번과 WebSocket 하나뿐이다.
    막혔다는 사실을 아는 자리는 라우터 앞의 문 하나뿐이고(`ScreenGate`),
    거기서 한 줄씩 적어 보낸다 — 이 화면은 그 줄들을 읽는다.

    **쌓기 시작한 날(2026-10-13) 이전의 값은 없다.** 그 앞의 기간을 고르면
    빈 목록이고, 그것은 고장이 아니다.

    ────────────────────────────────────────────────────────────
    [보기 셋 — 같은 자료에 묻는 물음이 셋이다]

    | 보기 | 답하는 물음 |
    |---|---|
    | 화면별 | **어떤 화면이 권한관리 밖인가** — 이 표가 있는 까닭 그 자체다 |
    | 사용자별 | 누가 자꾸 막히나 (권한이 모자란 사람이 여기 선다) |
    | 기록 | 누가 **어떤 주소**를 언제 열려 했나 |

    매개변수가 든 **실제 주소**(`/admin/system/account/jupark/app`)는 기록
    보기에만 있다. 화면별은 열쇠로 묶으므로 「누구의 것을 보려 했나」가
    거기서는 사라진다 — 그 물음에 답해야 할 때는 기록으로 간다.
*@

@inherits DataPage

<PageTitle>차단 접근기록 · 포털관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" OnReset="@Reset" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="기간">
            @* 기본은 최근 7일이다. 이 화면을 여는 까닭이 대개 「요즘 누가 어디서
               막히나」라서, 처음부터 전부 더해 보여 줄 값이 없다. *@
            <div class="ad-checks">
                <DxDateEdit @bind-Date="_from" CssClass="ad-editform__date" />
                <span class="jsini-text-muted">~</span>
                <DxDateEdit @bind-Date="_to" CssClass="ad-editform__date" />
            </div>
        </CommSchItem>

        <CommSchItem Label="보기">
            <DxComboBox Data="@ViewOptions" Value="@_view"
                        ValueChanged="@((string? v) => PickViewAsync(v))"
                        ValueExpression="@(() => _view)"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 120px" />
        </CommSchItem>

        <CommSchItem Label="까닭">
            @* **이 화면에서 가장 자주 쓰는 조건이다.** 「관리 밖」만 걸러 보면
               손볼 화면 목록이 그대로 나온다. *@
            <DxComboBox Data="@ReasonOptions" Value="@_reason"
                        ValueChanged="@((string? v) => PickReasonAsync(v))"
                        ValueExpression="@(() => _reason)"
                        TextFieldName="Text" ValueFieldName="Value"
                        NullText="전체" Style="width: 130px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="사용자">
            @* **목록은 조회해 온 자료에서 만든다.** 계정 전체를 싣지 않는 까닭은
               막힌 적 없는 사람을 고르면 늘 빈 목록이기 때문이다. *@
            <DxComboBox Data="@_users" Value="@PickedUser"
                        ValueChanged="@((BlockedAccessByUserDto? u) => PickUserAsync(u))"
                        ValueExpression="@(() => PickedUser)"
                        NullText="@(_users.Count == 0 ? "기록이 없습니다" : "전체")"
                        TextFieldName="@nameof(BlockedAccessByUserDto.Who)" Style="width: 200px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="주소·화면">
            <DxTextBox @bind-Text="_keyword" Style="width: 180px"
                       BindValueMode="BindValueMode.OnInput" InputDelay="200"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 타일 넷. **표가 답하지 않는 것만 올린다** — 보기마다 표가 바뀌는데
   「이 기간이 통틀어 얼마인가」는 어느 표에도 없다.

   「관리 밖」을 제 타일로 세운 까닭은 그것이 **사람이 손봐야 하는 수**이기
   때문이다. 나머지 셋은 상태를 말하고 이 하나는 할 일을 말한다. *@
<div class="jsini-stats">
    <div class="jsini-stat">
        <div class="jsini-stat__label">차단</div>
        <div class="jsini-stat__value">@TotalBlocks.ToString("N0")</div>
        <div class="jsini-hint">@PeriodText</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">관리 밖 화면</div>
        <div class="jsini-stat__value">@UnmanagedScreens.ToString("N0")</div>
        <div class="jsini-hint">메뉴가 없다</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">사람</div>
        <div class="jsini-stat__value">@PeopleCount.ToString("N0")</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">마지막</div>
        <div class="jsini-stat__value">@LastBlockText</div>
    </div>
</div>

@* **잘렸다는 사실은 판 밖에서 말한다.** 말 없이 자르면 「이 기간에 그만큼
   뿐」으로 읽힌다. *@
@if (Truncated is { } cut)
{
    <PageNotice Tone="NoticeTone.Info"
                Text="@($"최근 {cut:N0}건만 보여 줍니다. 그 앞의 기록은 기간을 좁히거나 사용자를 고르십시오.")" />
}

<CommCont>
    @if (_view == ViewByScreen)
    {
        <CommGrd TItem="BlockedAccessByScreenDto"
                 Data="@_screens"
                 ExportName="차단 접근기록 (화면별)"
                 EmptyText="이 기간에 막힌 화면이 없습니다."
                 SelectedItem="@_pickedScreen"
                 SelectedItemChanged="@OnScreenPickedAsync"
                 OnRowClick="@OpenScreenDetailAsync"
                 OnRowDoubleClick="@OpenScreenDetailAsync"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn Caption="화면" MinWidth="200"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (BlockedAccessByScreenDto)cell.DataItem;
                        }
                        <span>@row.Screen</span>
                        @if (!string.IsNullOrWhiteSpace(row.MenuTitle)
                             && !string.IsNullOrWhiteSpace(row.RouteKey))
                        {
                            <span class="jsini-text-muted"> · @row.RouteKey</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                @* **이 화면에서 가장 중요한 칸이다**(머리말). 둘의 할 일이 다르다. *@
                <DxGridDataColumn Caption="까닭" Width="110">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (BlockedAccessByScreenDto)cell.DataItem;
                        }
                        <span class="@ReasonCss(row.Reason)">@row.ReasonText</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="마지막 주소" MinWidth="200"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        <span class="jsini-text-muted">
                            @(((BlockedAccessByScreenDto)cell.DataItem).LastHref)
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(BlockedAccessByScreenDto.Blocks)"
                                  Caption="차단" Width="90" DisplayFormat="N0" />

                <DxGridDataColumn FieldName="@nameof(BlockedAccessByScreenDto.Users)"
                                  Caption="사람" Width="80" DisplayFormat="N0" />

                <DxGridDataColumn Caption="마지막" Width="130">
                    <CellDisplayTemplate Context="cell">
                        @* 서버가 주는 값은 UTC 다. 한국 시각은 **보여 주기 직전에
                           한 번만** 만든다(docs/utc-time.md). *@
                        @(((BlockedAccessByScreenDto)cell.DataItem).LastBlockedAt.Kst("MM-dd HH:mm"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>

            <ContextMenuItems>
                <CommMenuItem Text="차단 상세 보기" IconCssClass="jsini-icon-eye"
                              Enabled="@(_pickedScreen is not null)"
                              Click="@(() => OpenScreenDetailAsync(_pickedScreen!))" />
                <CommMenuItem Text="이 화면의 기록" IconCssClass="jsini-icon-clock"
                              Enabled="@(_pickedScreen is not null)"
                              Click="@(() => OpenScreenLogAsync(_pickedScreen!))" />
            </ContextMenuItems>
        </CommGrd>
    }
    else if (_view == ViewByUser)
    {
        <CommGrd TItem="BlockedAccessByUserDto"
                 Data="@_users"
                 ExportName="차단 접근기록 (사용자별)"
                 EmptyText="이 기간에 막힌 기록이 없습니다."
                 SelectedItem="@_pickedUser"
                 SelectedItemChanged="@OnUserPickedAsync"
                 OnRowClick="@OpenUserDetailAsync"
                 OnRowDoubleClick="@OpenUserDetailAsync"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(BlockedAccessByUserDto.Who)" Caption="사용자"
                                  MinWidth="180" TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(BlockedAccessByUserDto.DepartmentName)"
                                  Caption="부서" Width="120" TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(BlockedAccessByUserDto.Blocks)"
                                  Caption="차단" Width="90" DisplayFormat="N0" />

                @* 건수 옆에 화면 수가 있어야 한다 — 「한 화면을 백 번 두드린
                   사람」과 「백 군데서 막힌 사람」은 건수만으로는 같아 보인다. *@
                <DxGridDataColumn FieldName="@nameof(BlockedAccessByUserDto.Screens)"
                                  Caption="화면" Width="80" DisplayFormat="N0" />

                <DxGridDataColumn Caption="가장 많이 막힌 화면" MinWidth="200"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (BlockedAccessByUserDto)cell.DataItem;
                        }
                        @if (string.IsNullOrWhiteSpace(row.TopScreen))
                        {
                            <span class="jsini-text-muted">–</span>
                        }
                        else
                        {
                            <span>@row.TopScreen</span>
                            <span class="jsini-text-muted"> · @row.TopScreenBlocks.ToString("N0")회</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="마지막" Width="130">
                    <CellDisplayTemplate Context="cell">
                        @(((BlockedAccessByUserDto)cell.DataItem).LastBlockedAt.Kst("MM-dd HH:mm"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>

            <ContextMenuItems>
                <CommMenuItem Text="차단 상세 보기" IconCssClass="jsini-icon-eye"
                              Enabled="@(_pickedUser is not null)"
                              Click="@(() => OpenUserDetailAsync(_pickedUser!))" />
                <CommMenuItem Text="이 사람의 기록" IconCssClass="jsini-icon-clock"
                              Enabled="@(_pickedUser is not null)"
                              Click="@(() => OpenUserLogAsync(_pickedUser!))" />
            </ContextMenuItems>
        </CommGrd>
    }
    else
    {
        <CommGrd TItem="BlockedAccessDto"
                 Data="@_logs"
                 ExportName="차단 접근기록"
                 EmptyText="이 기간에 막힌 기록이 없습니다."
                 SelectedItem="@_pickedLog"
                 SelectedItemChanged="@OnLogPickedAsync"
                 OnRowClick="@OpenLogDetail"
                 OnRowDoubleClick="@OpenLogDetail"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn Caption="막힌 때" Width="150">
                    <CellDisplayTemplate Context="cell">
                        @(((BlockedAccessDto)cell.DataItem).OccurredAt.Kst("MM-dd HH:mm:ss"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Who)" Caption="사용자"
                                  MinWidth="160" TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.DepartmentName)"
                                  Caption="부서" Width="110" TextAlignment="GridTextAlignment.Left" />

                @* **매개변수가 든 실제 주소.** 「누구의 것을 보려 했나」가 이
                   칸에만 남는다 — 화면별 보기는 열쇠로 묶어서 여기가 사라진다. *@
                <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Href)" Caption="주소"
                                  MinWidth="220" TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn Caption="까닭" Width="110">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (BlockedAccessDto)cell.DataItem;
                        }
                        <span class="@ReasonCss(row.Reason)">@row.ReasonText</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Screen)" Caption="화면"
                                  MinWidth="160" TextAlignment="GridTextAlignment.Left" />

                @* 「어디서 왔나」. 주소만 보면 알 수 없는 것이 **길**이라,
                   기록 줄에 앞 화면을 함께 적어 둔다. *@
                <DxGridDataColumn Caption="앞 화면" MinWidth="140"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (BlockedAccessDto)cell.DataItem;
                        }
                        @if (string.IsNullOrWhiteSpace(row.FromPath))
                        {
                            <span class="jsini-text-muted">처음</span>
                        }
                        else
                        {
                            <span class="jsini-text-muted">@row.FromPath</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                @* 위조할 수 있는 값이라 **보여 주기 전용이다**(ClientAddress 머리말).
                   그래도 적어 두는 것은 「같은 사람인가 같은 자리인가」를 가르는
                   데 쓰이기 때문이다. *@
                <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.ClientIp)" Caption="접속지"
                                  Width="130" TextAlignment="GridTextAlignment.Left" />
            </Columns>

            <ContextMenuItems>
                <CommMenuItem Text="차단 상세 보기" IconCssClass="jsini-icon-eye"
                              Enabled="@(_pickedLog is not null)"
                              Click="@(() => OpenLogDetail(_pickedLog!))" />
            </ContextMenuItems>
        </CommGrd>
    }
</CommCont>

@* ── 차단 상세 창 ──────────────────────────────────────────
   항목 카드를 선택(클릭)했을 때 차단된 사용자와 시각, 주소 등 상세 정보를 보여준다. *@
<CommPopup @bind-Visible="_detailVisible"
           HeaderText="@DetailTitle"
           Width="min(920px, calc(100vw - 2rem))"
           CloseOnOutsideClick="true">
    <BodyContentTemplate Context="popupContext">
        @if (_detailScreen is not null)
        {
            <dl class="ad-blocked__facts">
                <dt>화면</dt>
                <dd>
                    <b>@_detailScreen.Screen</b>
                    @if (!string.IsNullOrWhiteSpace(_detailScreen.RouteKey))
                    {
                        <span class="jsini-text-muted"> (@_detailScreen.RouteKey)</span>
                    }
                </dd>

                <dt>까닭</dt>
                <dd>
                    <span class="@ReasonCss(_detailScreen.Reason)">@_detailScreen.ReasonText</span>
                </dd>

                <dt>차단 횟수</dt>
                <dd>
                    <b>@_detailScreen.Blocks.ToString("N0")</b>회
                    <span class="jsini-text-muted">(대상 사용자 <b>@_detailScreen.Users.ToString("N0")</b>명)</span>
                </dd>

                <dt>마지막 차단</dt>
                <dd>@_detailScreen.LastBlockedAt.Kst("yyyy-MM-dd HH:mm:ss")</dd>

                @if (!string.IsNullOrWhiteSpace(_detailScreen.LastHref))
                {
                    <dt>최근 시도 주소</dt>
                    <dd><code class="jsini-text-muted">@_detailScreen.LastHref</code></dd>
                }
            </dl>

            <div class="ad-subhead" style="margin: 0.75rem 0 0.5rem; font-weight: 600;">
                차단된 사용자와 시각 (@(_detailLoading ? "조회 중…" : $"{_detailLogs.Count:N0}건"))
            </div>

            @if (_detailLoading)
            {
                <p class="jsini-hint">차단 기록을 읽는 중입니다…</p>
            }
            else if (_detailLogs.Count == 0)
            {
                <p class="jsini-hint">차단 상세 기록이 없습니다.</p>
            }
            else
            {
                <CommGrd TItem="BlockedAccessDto"
                         Data="@_detailLogs"
                         PageSize="10"
                         ShowHeader="false"
                         ExportName="@($"{_detailScreen.Screen} 차단기록")"
                         EmptyText="차단 기록이 없습니다.">
                    <Columns>
                        <DxGridDataColumn Caption="차단 시각" Width="145">
                            <CellDisplayTemplate Context="cell">
                                @(((BlockedAccessDto)cell.DataItem).OccurredAt.Kst("yyyy-MM-dd HH:mm:ss"))
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Who)" Caption="차단된 사용자"
                                          MinWidth="150" TextAlignment="GridTextAlignment.Left" />

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.DepartmentName)"
                                          Caption="부서" Width="100" TextAlignment="GridTextAlignment.Left" />

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Href)" Caption="시도 주소"
                                          MinWidth="180" TextAlignment="GridTextAlignment.Left" />

                        <DxGridDataColumn Caption="앞 화면" Width="120" TextAlignment="GridTextAlignment.Left">
                            <CellDisplayTemplate Context="cell">
                                @{ var row = (BlockedAccessDto)cell.DataItem; }
                                <span class="jsini-text-muted">@(string.IsNullOrWhiteSpace(row.FromPath) ? "처음" : row.FromPath)</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.ClientIp)" Caption="접속지"
                                          Width="120" TextAlignment="GridTextAlignment.Left" />
                    </Columns>
                </CommGrd>
            }
        }
        else if (_detailUser is not null)
        {
            <dl class="ad-blocked__facts">
                <dt>사용자</dt>
                <dd><b>@_detailUser.Who</b></dd>

                <dt>부서</dt>
                <dd>@(string.IsNullOrWhiteSpace(_detailUser.DepartmentName) ? "-" : _detailUser.DepartmentName)</dd>

                <dt>차단 횟수</dt>
                <dd>
                    <b>@_detailUser.Blocks.ToString("N0")</b>회
                    <span class="jsini-text-muted">(화면 <b>@_detailUser.Screens.ToString("N0")</b>개)</span>
                </dd>

                <dt>많이 막힌 화면</dt>
                <dd>@(_detailUser.TopScreen ?? "-") <span class="jsini-text-muted">(@_detailUser.TopScreenBlocks.ToString("N0")회)</span></dd>

                <dt>기간</dt>
                <dd>@_detailUser.FirstBlockedAt.Kst("yyyy-MM-dd HH:mm") ~ @_detailUser.LastBlockedAt.Kst("yyyy-MM-dd HH:mm")</dd>
            </dl>

            <div class="ad-subhead" style="margin: 0.75rem 0 0.5rem; font-weight: 600;">
                차단된 화면과 시각 (@(_detailLoading ? "조회 중…" : $"{_detailLogs.Count:N0}건"))
            </div>

            @if (_detailLoading)
            {
                <p class="jsini-hint">차단 기록을 읽는 중입니다…</p>
            }
            else if (_detailLogs.Count == 0)
            {
                <p class="jsini-hint">차단 상세 기록이 없습니다.</p>
            }
            else
            {
                <CommGrd TItem="BlockedAccessDto"
                         Data="@_detailLogs"
                         PageSize="10"
                         ShowHeader="false"
                         ExportName="@($"{_detailUser.Who} 차단기록")"
                         EmptyText="차단 기록이 없습니다.">
                    <Columns>
                        <DxGridDataColumn Caption="차단 시각" Width="145">
                            <CellDisplayTemplate Context="cell">
                                @(((BlockedAccessDto)cell.DataItem).OccurredAt.Kst("yyyy-MM-dd HH:mm:ss"))
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Screen)" Caption="화면"
                                          MinWidth="150" TextAlignment="GridTextAlignment.Left" />

                        <DxGridDataColumn Caption="까닭" Width="110">
                            <CellDisplayTemplate Context="cell">
                                @{ var row = (BlockedAccessDto)cell.DataItem; }
                                <span class="@ReasonCss(row.Reason)">@row.ReasonText</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.Href)" Caption="시도 주소"
                                          MinWidth="180" TextAlignment="GridTextAlignment.Left" />

                        <DxGridDataColumn Caption="앞 화면" Width="120" TextAlignment="GridTextAlignment.Left">
                            <CellDisplayTemplate Context="cell">
                                @{ var row = (BlockedAccessDto)cell.DataItem; }
                                <span class="jsini-text-muted">@(string.IsNullOrWhiteSpace(row.FromPath) ? "처음" : row.FromPath)</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(BlockedAccessDto.ClientIp)" Caption="접속지"
                                          Width="120" TextAlignment="GridTextAlignment.Left" />
                    </Columns>
                </CommGrd>
            }
        }
        else if (_detailLog is not null)
        {
            <dl class="ad-blocked__facts">
                <dt>차단 시각</dt>
                <dd><b>@_detailLog.OccurredAt.Kst("yyyy-MM-dd HH:mm:ss")</b></dd>

                <dt>차단된 사용자</dt>
                <dd>
                    <b>@_detailLog.Who</b>
                    @if (!string.IsNullOrWhiteSpace(_detailLog.DepartmentName))
                    {
                        <span class="jsini-text-muted"> (@_detailLog.DepartmentName)</span>
                    }
                </dd>

                <dt>화면</dt>
                <dd>
                    @_detailLog.Screen
                    @if (!string.IsNullOrWhiteSpace(_detailLog.RouteKey))
                    {
                        <span class="jsini-text-muted"> (@_detailLog.RouteKey)</span>
                    }
                </dd>

                <dt>까닭</dt>
                <dd>
                    <span class="@ReasonCss(_detailLog.Reason)">@_detailLog.ReasonText</span>
                </dd>

                <dt>시도 주소</dt>
                <dd><code>@_detailLog.Href</code></dd>

                <dt>앞 화면</dt>
                <dd>@(string.IsNullOrWhiteSpace(_detailLog.FromPath) ? "처음" : _detailLog.FromPath)</dd>

                <dt>접속지</dt>
                <dd>@_detailLog.ClientIp</dd>
            </dl>
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        @if (_detailScreen is not null)
        {
            <DxButton Text="이 화면의 기록 보기" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-clock"
                      Click="@OpenScreenLogFromDetailAsync" />
        }
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CloseDetail" />
    </FooterContentTemplate>
</CommPopup>
