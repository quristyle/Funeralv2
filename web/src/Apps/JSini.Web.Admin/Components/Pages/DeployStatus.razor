@page "/admin/status/deploy"

@*
    [배포 현황] — DB 메뉴 `/system/deploy-status`.
    이력: Vue `views/portal/system/deploy-status/index` → 여기.

    GitHub 워크플로 실행 이력과 셀프 호스티드 러너 상태를 본다.

    [칸 이름이 서버와 어긋나 있었다]

    `head_branch` · `created_at` 은 **GitHub API 의** 이름이고, 우리 서버는
    그것을 `branch` · `startedAt` 으로 바꿔 보낸다. 그 이름으로 받고 있어서
    브랜치·시각 칸이 늘 비어 있었다. 예외가 나지 않는 종류의 어긋남이라
    「자료가 없나 보다」로 읽혔다.

    [GitHub 이 안 읽혀도 화면은 뜬다]

    서버가 둘을 따로 긁어 합쳐 주고, GitHub 쪽이 실패하면 `github.error` 에
    이유가 담긴다. 그때도 컨테이너 목록은 온다 — 배포가 안 되는 이유를 보러
    들어온 사람에게 빈 화면을 주지 않는다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>배포 현황 · 포털관리</PageTitle>

<PageHeading Title="배포 현황" Scope="포털관리" />

<div class="jsini-toolbar">
    <DxButton Text="새로 고침" RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="jsini-icon-refresh" Click="@ReloadAsync" />

    @if (_status?.Repo is { Length: > 0 } repo)
    {
        <span class="ad-stamp">@repo</span>
    }

    @if (_status?.GeneratedAt is { } at)
    {
        <span class="ad-stamp">@at.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") 기준</span>
    }
</div>

@if (_status?.Github.Error is { Length: > 0 } error)
{
    <PageNotice Text="@($"GitHub 을 읽지 못했습니다 — {error}")" Tone="NoticeTone.Warning" />
}

<h2 class="ad-subhead">워크플로 실행</h2>

<CommGrd TItem="GithubRunDto" Data="@Runs">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(GithubRunDto.StartedAt)" Caption="시각" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(GithubRunDto.Name)" Caption="워크플로" Width="150" />

        @* 커밋 제목이 있어야 「무엇을 배포한 실행인가」를 안다. 옛 화면에도 있었다. *@
        <DxGridDataColumn FieldName="@nameof(GithubRunDto.Title)" Caption="내용" MinWidth="240" />

        <DxGridDataColumn FieldName="@nameof(GithubRunDto.Branch)" Caption="브랜치" Width="100" />
        <DxGridDataColumn FieldName="@nameof(GithubRunDto.Actor)" Caption="건 사람" Width="110" />

        <DxGridDataColumn Caption="걸린 시간" Width="90">
            <CellDisplayTemplate Context="cell">
                @{
                    var run = (GithubRunDto)cell.DataItem;
                }
                @(run.DurationSec is { } sec ? $"{sec:F0}초" : "-")
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="결과" Width="100">
            <CellDisplayTemplate Context="cell">
                @{
                    var run = (GithubRunDto)cell.DataItem;
                }
                <span class="jsini-badge @ConclusionClass(run)">@ConclusionText(run)</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="" Width="70" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @{
                    var run = (GithubRunDto)cell.DataItem;
                }
                @if (run.HtmlUrl is { Length: > 0 } url)
                {
                    @* 실패한 실행의 로그는 GitHub 에서만 볼 수 있다. 그 자리로 바로 보낸다. *@
                    <a href="@url" target="_blank" rel="noopener">로그</a>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>

<h2 class="ad-subhead">러너</h2>

<CommGrd TItem="GithubRunnerDto" Data="@Runners"
         PageSizeSelectorVisible="false" PagerVisible="false">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(GithubRunnerDto.Name)" Caption="이름" Width="180" />

        <DxGridDataColumn Caption="상태" Width="110">
            <CellDisplayTemplate Context="cell">
                @{
                    var runner = (GithubRunnerDto)cell.DataItem;
                    var online = string.Equals(runner.Status, "online", StringComparison.OrdinalIgnoreCase);
                }
                <span class="jsini-badge @(online ? "jsini-badge--on" : "jsini-badge--off")">
                    @(online ? "온라인" : "오프라인")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="작업" Width="100">
            <CellDisplayTemplate Context="cell">
                @(((GithubRunnerDto)cell.DataItem).Busy ? "실행 중" : "대기")
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="꼬리표" MinWidth="200">
            <CellDisplayTemplate Context="cell">
                @string.Join(" · ", ((GithubRunnerDto)cell.DataItem).Labels)
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>

<PageNotice Text="@Notice" Tone="@Tone" />

@code {
    private DeployStatusDto? _status;

    private IReadOnlyList<GithubRunDto> Runs => _status?.Github.Runs ?? [];
    private IReadOnlyList<GithubRunnerDto> Runners => _status?.Github.Runners ?? [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _status = await Api.GetDeployStatusAsync();
        return Runs.Count + Runners.Count;
    }, "배포 이력을 받지 못했습니다.", "배포 현황을 읽지 못했습니다");

    /// <summary>결과 문구. 아직 안 끝난 실행은 <c>conclusion</c> 이 비어 있다.</summary>
    private static string ConclusionText(GithubRunDto run) => run.Conclusion?.ToLowerInvariant() switch
    {
        "success" => "성공",
        "failure" => "실패",
        "cancelled" => "취소",
        "skipped" => "건너뜀",
        null or "" => string.Equals(run.Status, "completed", StringComparison.OrdinalIgnoreCase)
            ? "알 수 없음"
            : "진행 중",
        _ => run.Conclusion!,
    };

    private static string ConclusionClass(GithubRunDto run) => run.Conclusion?.ToLowerInvariant() switch
    {
        "success" => "jsini-badge--on",
        "failure" => "jsini-badge--off",
        null or "" => "jsini-badge--warn",
        _ => "",
    };
}
