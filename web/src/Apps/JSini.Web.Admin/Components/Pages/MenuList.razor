@page "/admin/system/menu"
@attribute [RouteKey("admin.system.menu")]

@*
    [메뉴 관리] DB 메뉴 `/system/menu`. 화면은 「화면」 칸에서 실려 있는 목록으로 고른다 — 없는 화면을 가리킬 수 없어 「보이는데 안 열리는」 메뉴가 생기지 않는다.
    경로 칸은 권한표·즐겨찾기의 열쇠라 남겼다. 권한 일곱 가지는 여기서 켠다. 끌어 옮기기는 되돌리기 어려워 편집 폼에서 값으로 고른다.
*@

@inherits DataPage
@using JSini.Web.Components.Menu

<PageTitle>메뉴 관리</PageTitle>

@* 조건 둘은 브라우저 안에서 거른다. 등록은 조건과 섞이지 않게 동작 자리(Actions)에 둔다 — 이 화면은 저장을 부품에 맡기지 않아 부품은 등록 단추를 그리지 않는다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 230px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem>
            <DxCheckBox @bind-Checked="_onlyHidden">숨긴 메뉴만</DxCheckBox>
        </CommSchItem>
    </Fields>
    <Actions>
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus" Click="@StartNew" />
        </PermissionView>
    </Actions>
</CommSch>

@* 건수를 누르면 그 건수의 메뉴만 표로 보인다. 검색 조건과는 함께 걸리고, 「전체」는 거름을 푼다. *@
@if (_stats is not null)
{
    <div class="ad-menu-strip" role="group" aria-label="메뉴 현황 요약">
        @StripItem(null, "전체", _stats.Total)
        <span class="ad-menu-strip__sep" aria-hidden="true"></span>
        @StripItem(MenuSlice.Catalogs, "묶음", _stats.Catalogs)
        <span class="ad-menu-strip__sep" aria-hidden="true"></span>
        @StripItem(MenuSlice.Screens, "화면", _stats.Screens)
        <span class="ad-menu-strip__sep" aria-hidden="true"></span>
        @StripItem(MenuSlice.Hidden, "숨김", _stats.Hidden)
        <span class="ad-menu-strip__sep" aria-hidden="true"></span>
        @StripItem(MenuSlice.Stopped, "중지", _stats.Stopped)
    </div>
}

@* 검색어가 있으면 나무를 접고 평평한 목록으로 보인다 — 나무인 채 거르면 걸리지 않은 묶음이 결과에 섞인다. *@
<CommCont>
@if (Filtering)
{
    <CommGrd TItem="SystemMenuDto" Data="@Flat" PageSize="30"
             ExportName="메뉴" ColumnResizingMode="ColumnResizingMode.FixedWidth"
             KeyFieldName="@nameof(SystemMenuDto.Id)"
             Reload="@ReloadAsync"
             RowActions="@RowActions">
        <Columns>
            <DxGridDataColumn Caption="메뉴" MinWidth="220">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (SystemMenuDto)cell.DataItem;
                    }
                    <span class="ad-menu__trail">@Trail(m.Id)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(SystemMenuDto.Path)" Caption="경로" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(SystemMenuDto.Type)" Caption="유형" Width="100" />
        </Columns>
    </CommGrd>
}
else
{
    @* 줄을 끌면 상위와 순서가 함께 바뀐다(줄 사이면 형제, 줄 위면 하위). 수정 권한이 없으면 끌리지 않는다. 관리 칸은 CommTree 가 그리고 RowActions 로 표와 같은 모양을 준다. *@
    <CommTree TItem="SystemMenuDto" Data="@_menus"
              KeyFieldName="@nameof(SystemMenuDto.Id)"
              ChildrenFieldName="@nameof(SystemMenuDto.Children)"
              ExportName="메뉴" ColumnResizingMode="ColumnResizingMode.FixedWidth"
              Reload="@ReloadAsync"
              RowActions="@RowActions"
              OnAddChild="@StartChild"
              AllowDragRows="@_canMove"
              ItemsDropped="@OnDroppedAsync">
        <Columns>
            <DxTreeListDataColumn Caption="메뉴" MinWidth="240">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (SystemMenuDto)cell.DataItem;
                    }
                    <span class="jsini-tags">
                        <span class="@(m.Status == 1 ? "" : "ad-menu--off")">@Title(m)</span>
                        @if (m.Meta.HideInMenu)
                        {
                            <span class="jsini-badge jsini-badge--off">숨김</span>
                        }
                    </span>
                </CellDisplayTemplate>
            </DxTreeListDataColumn>

            <DxTreeListDataColumn FieldName="@nameof(SystemMenuDto.Path)" Caption="경로" MinWidth="200" />
            <DxTreeListDataColumn FieldName="@nameof(SystemMenuDto.Type)" Caption="유형" Width="100" />

 

            @* 권한 일곱 가지를 글자로 압축한다 — 일곱 칸으로 벌리면 표가 옆으로 넘친다. *@
            <DxTreeListDataColumn Caption="허용" Width="150">
                <CellDisplayTemplate Context="cell">
                    <span class="ad-menu__perm">@Permits(((SystemMenuDto)cell.DataItem).Permissions)</span>
                </CellDisplayTemplate>
            </DxTreeListDataColumn>

            <DxTreeListDataColumn Caption="기기" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var meta = ((SystemMenuDto)cell.DataItem).Meta;
                    }
                    <span class="ad-menu__perm">@(meta.UseMobile ? "폰" : "")@(meta.UseTablet ? " 탭" : "")</span>
                </CellDisplayTemplate>
            </DxTreeListDataColumn>
        </Columns>
    </CommTree>
}
</CommCont>

@* 편집 창을 직접 띄운다 — 폼이 이 화면의 것이라(칸 스물 남짓, 저장 전 이름·경로 중복을 게이트웨이에 묻고, 화면 칸은 실린 라우트에서 고른다) 부품 팝업을 쓰지 않는다. 창은 CommPopup 으로 띄운다. *@
<CommPopup @bind-Visible="_editing" HeaderText="@EditHeader"
           Width="720">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="ad-editform">
            @* AI 로 채우기. 비어 있는 칸만 채운다 — 사람이 고른 값을 덮지 않는다. *@
            <DxFormLayoutItem Caption="무엇을 하는 메뉴인가" ColSpanMd="12">
                <div class="jsini-inline">
                    <DxTextBox @bind-Text="_brief" />
                    <DxButton Text="AI 로 채우기" IconCssClass="jsini-icon-robot"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              Enabled="@(!_autoFilling)"
                              Click="@AutoFillAsync" />
                </div>
            </DxFormLayoutItem>

            @* 메뉴 코드다 — 화면·권한·즐겨찾기가 이름으로 부르는 영문 식별자다. 옛 한글 이름은 그대로 두고, 새로 만들 때만 형식을 본다. *@
            <DxFormLayoutItem Caption="메뉴 코드" ColSpanMd="6">
                <DxTextBox @bind-Text="_edit.Name" />
            </DxFormLayoutItem>

            @* 제목은 번역 키다. 키 옆의 AI 추천은 등록할 때만 — 아래 두 칸이 그 키의 한국어·영어 글자다. *@
            <DxFormLayoutItem Caption="제목 (번역 키)" ColSpanMd="6">
                <div class="jsini-inline">
                    <DxTextBox @bind-Text="_edit.Meta.Title" @bind-Text:after="OnTitleKeyChangedAsync" />
                    @if (_isNew)
                    {
                        <AiCodeSuggest Word="@(string.IsNullOrWhiteSpace(_titleKo) ? _edit.Name : _titleKo)" Natural="true" OnPick="@PickTitleKeyAsync" />
                    }
                </div>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="제목 · 한국어" ColSpanMd="3">
                <DxTextBox @bind-Text="_titleKo" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="제목 · English" ColSpanMd="3">
                <DxTextBox @bind-Text="_titleEn" />
            </DxFormLayoutItem>

            @* 화면이 있는 메뉴(MENU)에서만 쓴다 — 나머지 유형은 화면을 가리키지 않아 칸을 끈다(값은 남긴다). *@
            <DxFormLayoutItem Caption="화면" ColSpanMd="12">
                <DxComboBox Data="@ScreenChoices" @bind-Value="_edit.RouteKey"
                            TextFieldName="Text" ValueFieldName="Value"
                            Enabled="@UsesScreen"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            @* 권한표와 즐겨찾기의 열쇠다. 바꾸면 그 메뉴의 권한과 즐겨찾기가 끊긴다. *@
            <DxFormLayoutItem Caption="경로 (권한 열쇠)" ColSpanMd="6">
                <DxTextBox @bind-Text="_edit.Path" Enabled="@UsesPath" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="유형" ColSpanMd="6">
                <DxComboBox Data="@TypeOptions" @bind-Value="_edit.Type"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="상위 메뉴" ColSpanMd="6">
                <DxComboBox Data="@ParentChoices" @bind-Value="_edit.Pid"
                            TextFieldName="Text" ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="순서" ColSpanMd="3">
                <DxSpinEdit @bind-Value="_edit.Meta.Order" MinValue="0" />
            </DxFormLayoutItem>

            @* 아이콘은 보고 고른다 — 값이 iconify 이름이라 틀린 이름은 오류 없이 빈 동그라미가 된다. 고를 목록은 이 화면이 들고 있는 메뉴에서 뽑는다. *@
            <DxFormLayoutItem Caption="아이콘" ColSpanMd="12">
                <IconPicker @bind-Value="_edit.Meta.Icon" Available="@IconChoices" Enabled="@UsesIcon" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="화면 파일" ColSpanMd="12">
                @* 옛 Vue 경로. 라우팅에는 쓰이지 않는다. *@
                <DxTextBox @bind-Text="_edit.Component" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="바깥 링크" ColSpanMd="12">
                <DxTextBox @bind-Text="_edit.Meta.Link" Enabled="@UsesLink" />
            </DxFormLayoutItem>

            @* iframe 주소. 바깥 링크와 다른 칸이다 — 이것은 화면 안에 끼워 넣는다. 이 칸이 곧 화면이라 채우면 razor 나 배포 없이 메뉴가 열린다. *@
            <DxFormLayoutItem Caption="iframe 주소" ColSpanMd="12">
                <DxTextBox @bind-Text="_edit.Meta.IframeSrc" Enabled="@UsesIframe" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="보이기" ColSpanMd="12">
                <div class="ad-checks">
                    <DxCheckBox Checked="@(_edit.Status == 1)"
                                CheckedChanged="@((bool v) => _edit.Status = v ? 1 : 0)">사용</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.HideInMenu" Enabled="@UsesVisibility">메뉴에서 숨김</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.HideChildrenInMenu" Enabled="@UsesChildrenHide">하위를 숨김</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.HideInBreadcrumb" Enabled="@UsesBreadcrumb">길잡이에서 숨김</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.HideInTab" Enabled="@UsesVisibility">탭으로 열지 않음</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.AffixTab" Enabled="@UsesAffixTab">탭 고정</DxCheckBox>
                </div>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="기기" ColSpanMd="12">
                @* 화면 크기별 노출. 사이드바가 이 값으로 메뉴를 거른다. *@
                <div class="ad-checks">
                    <DxCheckBox @bind-Checked="_edit.Meta.UseMobile" Enabled="@UsesVisibility">휴대폰</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Meta.UseTablet" Enabled="@UsesVisibility">태블릿</DxCheckBox>
                </div>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="허용 동작" ColSpanMd="12">
                <div class="ad-checks">
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseView" Enabled="@UsesPermissions">조회</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseSearch" Enabled="@UsesPermissions">검색</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseCreate" Enabled="@UsesPermissions">등록</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseUpdate" Enabled="@UsesPermissions">수정</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseDelete" Enabled="@UsesPermissions">삭제</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UsePrint" Enabled="@UsesPermissions">출력</DxCheckBox>
                    <DxCheckBox @bind-Checked="_edit.Permissions.UseExcel" Enabled="@UsesPermissions">엑셀</DxCheckBox>
                </div>
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>요약 띠의 한 칸. 고른 칸은 aria-pressed 로 가른다.</summary>
    private RenderFragment StripItem(MenuSlice? slice, string label, int count) =>@<button type="button"
            class="ad-menu-strip__item @(_slice == slice ? "ad-menu-strip__item--on" : "")"
            aria-pressed="@(_slice == slice ? "true" : "false")"
            title="@(slice is null ? "거름을 풀고 전체를 봅니다" : $"{label} 메뉴만 봅니다")"
            @onclick="@(() => PickSlice(slice))">
        <span class="ad-menu-strip__label">@label</span>
        <span class="ad-menu-strip__val">@count</span>
    </button>;

    /// <summary>
    /// 관리 칸의 단추들. 표와 나무가 <b>같은 조각</b>을 쓴다.
    ///
    /// <para>
    /// 거를 때는 표(<c>CommGrd</c>), 안 거를 때는 나무(<c>CommTree</c>)로
    /// 갈아타는 화면이라 모양이 다르면 <b>조건을 지울 때마다 조작 자리가
    /// 바뀐 것처럼</b> 보인다. 그래서 한 조각을 두 곳에 넘긴다 — 나무는
    /// <c>RowActions</c> 파라미터로, 표는 자기 관리 칸 안에서.
    /// </para>
    ///
    /// <para>
    /// 아이콘과 스타일은 <c>CommGrd</c> 가 붙이는 것에 맞춰 두었다.
    /// <c>commgrd__icon--warn</c> 은 클래스 하나짜리 색 규칙이라 나무 안에서도
    /// 그대로 걸린다.
    /// </para>
    /// </summary>
    private RenderFragment RowActions(SystemMenuDto m) =>@<div class="jsini-actions">
        <PermissionView Action="MenuAction.Update">
            <DxButton IconCssClass="jsini-icon-edit" Title="수정"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => StartEdit(m))" />
        </PermissionView>
        <PermissionView Action="MenuAction.Delete">
            <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                      CssClass="commgrd__icon--warn"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => DeleteAsync(m))" />
        </PermissionView>
    </div>;
}
