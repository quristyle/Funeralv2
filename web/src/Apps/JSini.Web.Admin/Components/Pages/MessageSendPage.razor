@page "/admin/push/send"
@attribute [RouteKey("admin.push.send")]

@*
    [메시지 발송] — 알림관리 › 메시지 발송. 웹푸시 · 이메일을 보낸다. 문자·카카오 칸은 아직 보낼 통로가 없어 단추를 눌러도 아무 데도 가지 않는다.
    받는 사람은 왼쪽에서 한 번 고르고 오른쪽 탭이 그 명단을 나눠 쓴다. 길마다 열쇠가 달라 못 채운 사람 수를 칸마다 적는다.
*@

@inherits DataPage

<PageTitle>메시지 발송</PageTitle>

@* 조건줄은 판 밖에 둔다 — 판이 좁아질 때 조건 칸이 함께 눌려 글자가 잘린다. *@
<CommSch OnSearch="@LoadAsync" SearchText="사람 다시 읽기" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="찾기">
            @* 이름·아이디·부서·회사 어느 것으로 쳐도 걸린다. 목록이 브라우저에 있어 회로를 타지 않는다. *@
            <DxTextBox @bind-Text="_filter"
                       BindValueMode="BindValueMode.OnInput"
                       ValidationEnabled="false" />
        </CommSchItem>

        <CommSchItem Label="상태">
            @* 기본은 재직자만이다. 가운데 칸(재직자 + 승인 대기)은 가입 신청자를 불러오고, 전부 켜면 퇴사·잠금까지 올라온다. *@
            <DxComboBox Data="@ScopeOptions" @bind-Value="_scope"
                        TextFieldName="@nameof(SchOption.Text)"
                        ValueFieldName="@nameof(SchOption.Value)"
                        ValidationEnabled="false" Style="width: 180px" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="@($"보이는 {Matched.Count}명 모두 고르기")"
                  RenderStyle="ButtonRenderStyle.Secondary" Click="@PickAllAsync" />
        <DxButton Text="고른 사람 비우기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(_picked.Count > 0)" Click="@ClearPickedAsync" />
    </Actions>
</CommSch>

@* 끌어서 나누는 판 둘. 치수는 admin.css 의 .ad-vsplit 가 갖는다. SeparatorSize 는 판에 테두리가 없어 구분선을 남긴다. *@
<DxSplitter CssClass="ad-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
    <Panes>

    @* ── 왼쪽: 받는 사람 ────────────────────────────── *@
    <DxSplitterPane Size="34%" MinSize="260px" MaxSize="60%">
    <section class="ad-vsplit__pane ad-vsplit__pane--left">
        @* 제목은 붙잡고 표만 구른다 — 통째로 구르면 「몇 명 고름」도 올라가 버린다. *@
        <h2 class="ad-subhead">받는 사람 (@_picked.Count 명 고름 / 전체 @_accounts.Count 명)</h2>

        @if (_picked.Count == 0)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="목록에서 받을 사람을 고르십시오." />
        }

        @* 표로 바꾸면서 칸 머리의 「모두 고르기」·칸별 정렬·아래 띠를 얻었다. 체크 칸은 SelectionMode 가 여럿일 때 화면이 손으로 넣는다(CommGrd 머리말).
           조건줄은 읽어 온 목록 전체를 좁히고, 칸 검색은 그중 한 칸만 본다. *@
        <CommGrd TItem="AccountDto"
                 Data="@Matched"
                 PageSize="50"
                 EmptyText="조건에 맞는 사람이 없습니다."
                 ExportName="받는사람"
                 SelectionMode="GridSelectionMode.Multiple"
                 SelectedItems="@Picked"
                 SelectedItemsChanged="@OnPickedChangedAsync"
                 Reload="@LoadAsync">
            <Columns>
                @* 체크 칸이 맨 앞이다. 머리의 「모두 고르기」는 지금 쪽만 집으므로 조건줄의 「보이는 N명 모두 고르기」를 쓴다. *@
                <DxGridSelectionColumn Width="40" />

                <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="90"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="100"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" MinWidth="90"
                                  TextAlignment="GridTextAlignment.Left" />

                @* 상태는 재직자가 아닌 줄에만 적는다 — 전부 「정상」이면 정작 눈에 걸릴 「승인 대기」가 묻힌다. *@
                <DxGridDataColumn Caption="상태" Width="84" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (AccountDto)cell.DataItem;
                        }
                        @if (!IsActive(row))
                        {
                            <span class="jsini-badge @StatusClass(row.Status)">@StatusText(row.Status)</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                @* 어느 길로 못 받는지 그 자리에서 보인다. *@
                <DxGridDataColumn Caption="빠짐" Width="100" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var a = (AccountDto)cell.DataItem;
                        }
                        <span class="jsini-tags">
                            @if (string.IsNullOrWhiteSpace(a.Email))
                            {
                                <span class="jsini-badge jsini-badge--off"
                                      title="이메일 주소가 없어 메일을 보낼 수 없습니다.">메일</span>
                            }
                            @if (string.IsNullOrWhiteSpace(a.Phone))
                            {
                                <span class="jsini-badge jsini-badge--off"
                                      title="휴대폰 번호가 없어 문자를 보낼 수 없습니다.">번호</span>
                            }
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </section>
    </DxSplitterPane>

    @* ── 오른쪽: 보낼 내용 ──────────────────────────── *@
    <DxSplitterPane>
    <section class="ad-vsplit__pane ad-vsplit__pane--right ad-send">
        @* 판이 높이를 정해 주므로 탭 안쪽이 자기 안에서 구른다. DxTabs 상자 둘을 묶지 않으면 「보내기」 단추가 판 밖으로 나간다. *@
        <DxTabs RenderMode="TabsRenderMode.OnDemand" CssClass="ad-send__tabs">

            @* ── 웹푸시 ─────────────────────────────────────────────── *@
            <DxTabPage Text="PWA 발송">
                <div class="ad-sendform">
@* 남기는 것은 받는 쪽이 등록해야 도착한다는 것 하나다 — 「보냈는데 안 왔다」의 거의 모든 원인이다. *@
                    <PageNotice Tone="NoticeTone.Info"
                                Text="받는 사람이 이 포털을 알림 설정에서 등록해 두어야 도착합니다." />

                    <div class="ad-field">
                        <label class="ad-field__label">제목 <span class="ad-field__must">*</span></label>
                        <DxTextBox @bind-Text="_push.Title" ValidationEnabled="false" />
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">알림구분</label>
                        @* 목록은 공통코드(NOTI_CATEGORY)가 갖는다. 알림창에는 안 뜨고, 발송 기록에 남아 알림함과 발송 이력이 거를 때 쓴다. *@
                        <DxComboBox Data="@_categoryOptions" @bind-Value="_push.Category"
                                    TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                                    ValidationEnabled="false" Style="width: 200px" />
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">내용</label>
                        <DxMemo @bind-Text="_push.Body" Rows="4" ValidationEnabled="false" />
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">아이콘</label>
                        @* 주소는 이 포털 안의 것이어야 한다 — 바깥 주소를 적으면 알림이 뜰 때 그쪽으로 요청이 나간다. *@
                        <div class="jsini-inline">
                            <DxTextBox @bind-Text="_push.Icon"
                                       BindValueMode="BindValueMode.OnInput"
                                       ValidationEnabled="false" CssClass="ad-field__grow" />

                            @foreach (var icon in Icons)
                            {
                                <DxButton Text="@icon.Label" RenderStyle="ButtonRenderStyle.Secondary"
                                          Click="@(() => _push.Icon = icon.Url)" />
                            }
                        </div>
                        <div class="jsini-hint">비우면 브라우저 기본 아이콘으로 뜹니다.</div>
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">눌렀을 때 열 주소</label>
                        <DxTextBox @bind-Text="_push.Url"
                                   ValidationEnabled="false" />
                        <div class="jsini-hint">비우면 첫 화면이 열립니다.</div>
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">묶음 이름(태그)</label>
                        <DxTextBox @bind-Text="_push.Tag"
                                   ValidationEnabled="false" />
                        <div class="jsini-hint">
                            같은 태그의 알림은 브라우저가 <b>하나로 합칩니다</b>. 같은 건을 여러 번 갱신해
                            보낼 때만 적습니다 — 비우면 올 때마다 따로 쌓입니다.
                        </div>
                    </div>

                    <div class="jsini-toolbar">
                        <PermissionView Action="MenuAction.Create">
                            <DxButton Text="@($"{_picked.Count}명에게 푸시 보내기")"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      Enabled="@(_picked.Count > 0 && !_busy)"
                                      Click="@SendPushAsync" />
                        </PermissionView>
                    </div>
                </div>
            </DxTabPage>

            @* ── 이메일 ─────────────────────────────────────────────── *@
            <DxTabPage Text="이메일 발송">
                <div class="ad-sendform">
                    @* SMTP 직발송이다(큐 스풀은 제목·본문·받는이만 담는다). 화면에 적지 않는다 — 미리 적으면 아래의 정말 봐야 할 주의가 묻힌다. *@
                    @* 주소가 없는 사람은 아래 칸에 안 들어간다. 손으로 적을 수 있게 된 뒤로는 「몰라서 못 채웠다」라고 말해야 한다. 칸을 고치면 접는다. *@
                    @if (!MailToEdited && _picked.Count > 0 && NoEmail.Count > 0)
                    {
                        <PageNotice Tone="NoticeTone.Warning"
                                    Text="@($"고른 {_picked.Count}명 중 {NoEmail.Count}명은 이메일 주소가 없어 아래 받는 사람에 안 들어갔습니다 — {string.Join(" · ", NoEmail.Take(5))}{(NoEmail.Count > 5 ? " 외" : "")}. 주소를 알면 직접 적을 수 있습니다.")" />
                    }

                    @* 승인 대기인 사람을 골랐을 때 화면이 그 사실을 말한다 — 가입 안내·보완 요청이 이 화면에서 나가는 메일이다. *@
                    @if (PickedPending.Count > 0)
                    {
                        <PageNotice Tone="NoticeTone.Info"
                                    Text="@($"고른 사람 중 {PickedPending.Count}명은 아직 승인 대기입니다 — {string.Join(" · ", PickedPending.Take(5))}{(PickedPending.Count > 5 ? " 외" : "")}. 주소가 있으면 메일은 그대로 나갑니다.")" />
                    }

                    @* 주소 꼴이 아닌 것은 적는 동안 말한다 — 서버는 나머지에게 이미 나간 뒤라 고쳐 다시 보내면 두 번 받는다. *@
                    @if (MailBadAddresses.Count > 0)
                    {
                        <PageNotice Tone="NoticeTone.Warning"
                                    Text="@($"주소 꼴이 아닌 것이 {MailBadAddresses.Count}개 있습니다 — {string.Join(" · ", MailBadAddresses.Take(5))}{(MailBadAddresses.Count > 5 ? " 외" : "")}")" />
                    }

                    @* 고친 값이 정본이다(_mailTo). 안 고쳤으면 고른 사람의 주소가 보이고, 한 번 고치면 왼쪽에서 더 골라도 따라 바뀌지 않는다. 되돌리는 단추를 옆에 둔다. *@
                    <div class="ad-field">
                        <label class="ad-field__label">받는 사람 <span class="ad-field__must">*</span></label>

                        <DxMemo Text="@MailToText"
                                TextChanged="@((string v) => _mailTo = v ?? string.Empty)"
                                BindValueMode="BindValueMode.OnInput"
                                Rows="3" ValidationEnabled="false" />

                        <div class="jsini-inline">
                            <DxButton Text="고른 사람 주소로 되돌리기"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      Enabled="@MailToEdited" Click="@ResetMailToAsync" />
                            <span class="jsini-text-muted">@MailToHint</span>
                        </div>

                        <div class="jsini-hint">
                            쉼표·세미콜론·줄바꿈으로 나눕니다. <b>왼쪽에서 고르지 않은 사람에게도</b>
                            주소만 적으면 나갑니다.
                        </div>
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">제목 <span class="ad-field__must">*</span></label>
                        <DxTextBox @bind-Text="_mail.Subject" ValidationEnabled="false" />
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">본문 <span class="ad-field__must">*</span></label>

                        @* 공지 화면과 같은 부품이다. 값은 InputDelay 뒤에 오므로 보낼 때 편집기에게 직접 묻는다(FlushBodyAsync). *@
                        <DxHtmlEditor Markup="@_mail.Body"
                                      MarkupChanged="@(v => _mail.Body = v ?? string.Empty)"
                                      BindMarkupMode="HtmlEditorBindMarkupMode.OnDelayedInput"
                                      CssClass="ad-mail-editor" />

                        @* 평문 스위치는 없다 — 서식 편집기 글을 평문으로 보내면 태그가 그대로 보이므로 그 조합을 막는다. *@
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">첨부</label>

                        @* 파일 서버에 올리지 않고 바이트로 실어 보낸다. 상한(다섯 개 · 합쳐 15MB)은 서버와 맞춘 값이고, 총량을 봐야 한다(MaxTotalBytes). *@
                        <FilePicker MaxFiles="5"
                                    MaxBytes="15728640"
                                    MaxTotalBytes="15728640"
                                    ShowHint="false"
                                    FilesChanged="@(files => _mailFiles = files)" />
                    </div>

                    <div class="jsini-toolbar">
                        <PermissionView Action="MenuAction.Create">
                            <DxButton Text="@($"{MailRecipients.Count}곳으로 메일 보내기")"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      Enabled="@(MailRecipients.Count > 0 && !_busy)"
                                      Click="@SendEmailAsync" />
                        </PermissionView>
                    </div>
                </div>
            </DxTabPage>

            @* ── 문자 (아직 보낼 곳이 없다) ─────────────────────────── *@
            <DxTabPage Text="문자 발송">
                <div class="ad-sendform">
                    <PageNotice Tone="NoticeTone.Warning"
                                Text="문자 발송은 아직 연결되지 않았습니다. 보내는 통로(대행사·발신번호 사전등록)가 정해지면 이 화면 그대로 동작합니다. 지금은 눌러도 아무 데도 가지 않습니다." />

                    @if (_picked.Count > 0 && NoPhone.Count > 0)
                    {
                        <PageNotice Tone="NoticeTone.Info"
                                    Text="@($"고른 {_picked.Count}명 중 {NoPhone.Count}명은 휴대폰 번호가 없습니다.")" />
                    }

                    <div class="ad-field">
                        <label class="ad-field__label">발신번호</label>
                        <DxTextBox @bind-Text="_sms.From" ValidationEnabled="false" />
                        <div class="jsini-hint">문자는 <b>사전등록한 번호로만</b> 보낼 수 있습니다(전기통신사업법).</div>
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">내용</label>
                        <DxMemo @bind-Text="_sms.Body" Rows="5" ValidationEnabled="false" />
                        @* 90바이트가 SMS 와 LMS 를 가르는 선이다. 글자 수가 아니라 바이트라 한글은 두 배로 센다. *@
                        <div class="jsini-hint">
                            @SmsBytes 바이트 / 90 — @(SmsBytes > 90 ? "장문(LMS)으로 나갑니다." : "단문(SMS)입니다.")
                        </div>
                    </div>

                    <div class="jsini-toolbar">
                        <DxButton Text="문자 보내기" RenderStyle="ButtonRenderStyle.Primary"
                                  Enabled="false" />
                        <span class="jsini-text-muted">통로가 연결되면 켜집니다.</span>
                    </div>
                </div>
            </DxTabPage>

            @* ── 카카오 (아직 보낼 곳이 없다) ───────────────────────── *@
            <DxTabPage Text="카카오 발송">
                <div class="ad-sendform">
                    <PageNotice Tone="NoticeTone.Warning"
                                Text="카카오 알림톡은 아직 연결되지 않았습니다. 채널 등록과 템플릿 심사가 끝나면 이 화면 그대로 동작합니다. 지금은 눌러도 아무 데도 가지 않습니다." />

                    <div class="ad-field">
                        <label class="ad-field__label">발신 채널</label>
                        <DxTextBox @bind-Text="_kakao.Channel" ValidationEnabled="false" />
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">템플릿 코드</label>
                        <DxTextBox @bind-Text="_kakao.TemplateCode"
                                   ValidationEnabled="false" />
                        @* 알림톡은 심사받은 템플릿의 빈칸만 채운다 — 그 성질을 화면이 말하지 않으면 자유 문구를 적고 실패한다. *@
                        <div class="jsini-hint">
                            알림톡은 <b>심사받은 템플릿</b>으로만 나갑니다. 아래는 그 템플릿의 빈칸을 채우는 값입니다.
                        </div>
                    </div>

                    <div class="ad-field">
                        <label class="ad-field__label">치환 값</label>
                        <DxMemo @bind-Text="_kakao.Body" Rows="5"
                                ValidationEnabled="false" />
                    </div>

                    <div class="ad-field">
                        <DxCheckBox Checked="@_kakao.SmsFallback"
                                    CheckedChanged="@((bool on) => _kakao.SmsFallback = on)">
                            실패하면 문자로 대체 발송
                        </DxCheckBox>
                    </div>

                    <div class="jsini-toolbar">
                        <DxButton Text="알림톡 보내기" RenderStyle="ButtonRenderStyle.Primary"
                                  Enabled="false" />
                        <span class="jsini-text-muted">통로가 연결되면 켜집니다.</span>
                    </div>
                </div>
            </DxTabPage>
        </DxTabs>
    </section>
    </DxSplitterPane>

    </Panes>
</DxSplitter>
