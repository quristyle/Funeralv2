@page "/admin/company/user"
@attribute [RouteKey("admin.company.user")]

@*
    [회사 사용자] DB 메뉴 `/company/user`. 회사를 고르기 전에는 부르지 않는다 — 전 사용자를 한 번에 읽으면 회사가 여럿인 환경에 수천 줄이 된다. 넣기·빼기는 여럿을 한 번에 보낸다(중간 실패로 절반만 반영되지 않게).
    후보는 「소속이 없는 사람」이다 — 서버가 회사 식별자를 받지 않아 어느 회사에 넣든 후보가 같다. 옮기려면 먼저 그 회사에서 뺀다.
*@

@inherits DataPage

<PageTitle>회사 사용자</PageTitle>

@* 사람 넣기는 표의 등록이 아니라 이 화면만의 동작이라 Actions 에 둔다 — 표 아래 띠의 등록은 새 줄을 만든다는 뜻인데 여기서 만드는 것은 계정이 아니라 회사와의 연결이다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="회사">
            <DxComboBox Data="@_companies" @bind-Value="_companyId"
                        TextFieldName="@nameof(CompanyDto.Name)" ValueFieldName="@nameof(CompanyDto.Id)"
                        Style="width: 240px" />
        </CommSchItem>
    </Fields>
    <Actions>
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="사람 넣기" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus"
                      Enabled="@(!string.IsNullOrWhiteSpace(_companyId))" Click="@OpenAddAsync" />
        </PermissionView>
    </Actions>
</CommSch>

<CommCont>
    <CommGrd TItem="AccountDto" Data="@Shown" PageSize="20"
             ExportName="회사사용자"
             Reload="@ReloadAsync"
             RowActions="@Unlink">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="140" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="130" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" Width="160" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.Email)" Caption="이메일" MinWidth="200" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.Phone)" Caption="연락처" Width="140" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.RoleText)" Caption="역할" MinWidth="180" />

    </Columns>
    </CommGrd>
</CommCont>

<CommPopup @bind-Visible="_adding" HeaderText="회사에 사람 넣기" Width="620px">
    <BodyContentTemplate Context="popup">
        @if (_candidates.Count == 0)
        {
            <p class="ad-stamp">
                소속이 없는 사람이 없습니다. 이미 다른 회사에 속한 사람을 옮기려면
                그 회사에서 먼저 빼야 합니다.
            </p>
        }
        else
        {
            <CommGrd TItem="AccountDto" Data="@_candidates" PageSize="10"
                     SelectionMode="GridSelectionMode.Multiple"
                     @bind-SelectedDataItems="_picked"
                     ShowAllRowsSelectionCheckbox="true">
                <Columns>
                    <DxGridSelectionColumn Width="50px" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="140" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="130" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.Email)" Caption="이메일" MinWidth="180" />
                </Columns>
            </CommGrd>
        }

    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="넣기" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_picked.Any())" Click="@AddAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _adding = false)" />
    </FooterContentTemplate>
</CommPopup>

@* 확인은 공통 부품에 맡긴다 — 손으로 팝업을 적으면 화면마다 단추 글자가 갈리고 취소가 어느 쪽이었나를 매번 찾게 된다. *@
<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>
    /// 관리 칸의 「빼기」. <b>계정을 지우는 것이 아니다</b> — 회사와의 연결만
    /// 푼다. 그래서 CommGrd 의 삭제(휴지통)를 쓰지 않는다. 그 아이콘은
    /// 「이 줄이 사라진다」는 뜻인데 여기서는 사람이 그대로 남는다.
    /// </summary>
    private RenderFragment<AccountDto> Unlink => user =>@<PermissionView Action="MenuAction.Delete">
        <DxButton IconCssClass="jsini-icon-subtract" RenderStyle="ButtonRenderStyle.Link"
                  Title="회사 소속을 푼다. 계정은 남는다"
                  Click="@(() => RemoveAsync(user))" />
    </PermissionView>;
}
