@page "/admin/auth/user-role"

@*
    [사용자별 권한] — DB 메뉴 `/auth/user-role`.
    이력: Vue `views/portal/auth/user-role/index` → 여기.

    역할을 고르면 **속한 사람**과 **넣을 수 있는 사람**이 나란히 나온다.
    한 표에 체크박스로 두지 않은 이유는, 계정이 수백이면 체크박스 표에서
    "지금 누가 들어 있는지" 가 안 보이기 때문이다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>사용자별 권한 · 포털관리</PageTitle>

<PageHeading Title="사용자별 권한" Scope="포털관리" />

<div class="jsini-toolbar">
    <DxComboBox Data="@_roles" @bind-Value="_roleId"
                TextFieldName="@nameof(RoleDto.Name)" ValueFieldName="@nameof(RoleDto.Id)"
                NullText="역할을 고르십시오" Style="width: 240px" />
    <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@ReloadAsync" />
</div>

<PageNotice Text="@Notice" Tone="@Tone" />

<div class="ad-two-pane">
    <section>
        <h2 class="ad-subhead">이 역할인 사람 (@_members.Count)</h2>
        <DxGrid Data="@_members" ShowFilterRow="false" PageSize="15">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="120" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="130" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" MinWidth="140" />
                <DxGridDataColumn Caption="" Width="80">
                    <CellDisplayTemplate Context="cell">
                        @{ var a = (AccountDto)cell.DataItem; }
                        <PermissionView Action="MenuAction.Update">
                            <DxButton Text="빼기" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="@(() => RemoveAsync(a))" />
                        </PermissionView>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </section>

    <section>
        <h2 class="ad-subhead">넣을 수 있는 사람 (@_candidates.Count)</h2>
        <DxGrid Data="@_candidates" ShowFilterRow="false" PageSize="15"
                SelectionMode="GridSelectionMode.Multiple"
                @bind-SelectedDataItems="_selected">
            <Columns>
                <DxGridSelectionColumn Width="46px" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="120" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="130" />
                <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" MinWidth="140" />
            </Columns>
        </DxGrid>

        <PermissionView Action="MenuAction.Update">
            <DxButton Text="고른 사람 넣기" RenderStyle="ButtonRenderStyle.Success"
                      CssClass="mt-2" Click="@AssignAsync" />
        </PermissionView>
    </section>
</div>

@code {
    private IReadOnlyList<RoleDto> _roles = [];
    private string? _roleId;

    private IReadOnlyList<AccountDto> _members = [];
    private IReadOnlyList<AccountDto> _candidates = [];
    private IReadOnlyList<object> _selected = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        if (_roles.Count == 0)
        {
            _roles = await Api.GetRolesAsync();
        }

        if (string.IsNullOrWhiteSpace(_roleId))
        {
            _members = [];
            _candidates = [];
            Say("역할을 고르고 조회하십시오.");
            return -1;
        }

        // 둘을 나란히. 서로 기다릴 이유가 없다.
        var members = Api.GetRoleUsersAsync(_roleId);
        var candidates = Api.GetRoleEligibleUsersAsync(_roleId);

        await Task.WhenAll(members, candidates);

        _members = members.Result;
        _candidates = candidates.Result;
        _selected = [];

        return _members.Count + _candidates.Count;
    }, "조회 결과가 없습니다.", "권한 정보를 읽지 못했습니다");

    private async Task AssignAsync()
    {
        if (_roleId is null) return;

        var ids = _selected.OfType<AccountDto>().Select(a => a.Id).ToList();

        if (ids.Count == 0)
        {
            Say("넣을 사람을 고르십시오.", NoticeTone.Warning);
            return;
        }

        if (await RunAsync(() => Api.AssignRoleUsersAsync(_roleId, ids),
                $"{ids.Count}명을 넣었습니다.", "넣지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    private async Task RemoveAsync(AccountDto account)
    {
        if (_roleId is null) return;

        if (await RunAsync(() => Api.RemoveRoleUserAsync(_roleId, account.Id),
                $"{account.UserName} 님을 뺐습니다.", "빼지 못했습니다"))
        {
            await ReloadAsync();
        }
    }
}
