@page "/admin/status/menu-usage"
@attribute [RouteKey("admin.status.menu-usage")]

@*
    [메뉴 사용기록] DB 메뉴 `/admin/status/menu-usage`. 상태관리 묶음에 두어 옆의 AI 사용량과 견주어 읽는다.
    포털은 회로 안에서 라우팅만 바뀌어 서버 로그에 안 남는다 — 화면을 열 때마다 MenuUsageRecorder 가 한 줄씩 보낸다. 쌓기 시작한 날 이전 값은 없다.
    타임라인의 +12분 은 앞 칸에서 다음 칸까지지 머문 시간이 아니다 — 떠난 순간은 아무도 재지 않는다.
*@

@inherits DataPage

<PageTitle>메뉴 사용기록</PageTitle>

<CommSch OnSearch="@ReloadAsync" OnReset="@Reset" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="기간">
            @* 기본은 최근 7일이다. 요즘 누가 무엇을 보는지가 이 화면을 여는 까닭이다. *@
            <div class="ad-checks">
                <DxDateEdit @bind-Date="_from" CssClass="ad-editform__date" />
                <span class="jsini-text-muted">~</span>
                <DxDateEdit @bind-Date="_to" CssClass="ad-editform__date" />
            </div>
        </CommSchItem>

        <CommSchItem Label="보기">
            <DxComboBox Data="@ViewOptions" Value="@_view"
                        ValueChanged="@((string? v) => PickViewAsync(v))"
                        ValueExpression="@(() => _view)"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 120px" />
        </CommSchItem>

        <CommSchItem Label="사용자">
            @* 목록은 조회해 온 자료에서 만든다 — 기록이 없는 사람을 고르면 늘 빈 목록이라 그 기간에 포털을 쓴 사람만 고를 수 있다. *@
            <DxComboBox Data="@_users" Value="@PickedUser"
                        ValueChanged="@((MenuUsageByUserDto? u) => PickUserAsync(u))"
                        ValueExpression="@(() => PickedUser)"
                        NullText="@(_users.Count == 0 ? "기록이 없습니다" : "전체")"
                        TextFieldName="@nameof(MenuUsageByUserDto.Who)" Style="width: 200px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="화면">
            <DxTextBox @bind-Text="_keyword" Style="width: 180px"
                       BindValueMode="BindValueMode.OnInput" InputDelay="200"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 타일 넷. 표가 답하지 않는 「이 기간이 통틀어 얼마인가」만 올린다. *@
<div class="jsini-stats">
    <div class="jsini-stat">
        <div class="jsini-stat__label">열람</div>
        <div class="jsini-stat__value">@TotalViews.ToString("N0")</div>
        <div class="jsini-hint">@PeriodText</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">사람</div>
        <div class="jsini-stat__value">@PeopleCount.ToString("N0")</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">화면</div>
        <div class="jsini-stat__value">@ScreenCount.ToString("N0")</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">마지막</div>
        <div class="jsini-stat__value">@LastViewText</div>
    </div>
</div>

@* 잘렸다는 사실은 판 밖에서 말한다 — 말 없이 자르면 「이 기간에 그만큼뿐」으로 읽힌다. *@
@if (Truncated is { } cut)
{
    <PageNotice Tone="NoticeTone.Info"
                Text="@($"최근 {cut:N0}건만 보여 줍니다. 그 앞의 기록은 기간을 좁히거나 사용자를 고르십시오.")" />
}

<CommCont>
    @if (_view == ViewByUser)
    {
        <CommGrd TItem="MenuUsageByUserDto"
                 Data="@_users"
                 ExportName="메뉴 사용기록 (사용자별)"
                 EmptyText="이 기간에 쌓인 기록이 없습니다."
                 OnRowDoubleClick="@OpenUserTimelineAsync"
                 SelectedItem="@_pickedRow"
                 SelectedItemChanged="@OnUserPicked"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(MenuUsageByUserDto.Who)" Caption="사용자" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByUserDto.DepartmentName)" Caption="부서" Width="120"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByUserDto.Views)" Caption="열람" Width="90"
                                  DisplayFormat="N0" />

                @* 건수 옆에 화면 수가 있어야 한다 — 떨어져 있으면 많이 본 사람과 넓게 본 사람이 구분되지 않는다. *@
                <DxGridDataColumn FieldName="@nameof(MenuUsageByUserDto.Screens)" Caption="화면" Width="80"
                                  DisplayFormat="N0" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByUserDto.Days)" Caption="날" Width="70"
                                  DisplayFormat="N0" />

                <DxGridDataColumn Caption="가장 많이 본 화면" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (MenuUsageByUserDto)cell.DataItem;
                        }
                        @if (string.IsNullOrWhiteSpace(row.TopMenuTitle))
                        {
                            <span class="jsini-text-muted">–</span>
                        }
                        else
                        {
                            <span>@row.TopMenuTitle</span>
                            <span class="jsini-text-muted"> · @row.TopMenuViews.ToString("N0")회</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="마지막" Width="130">
                    <CellDisplayTemplate Context="cell">
                        @* 서버가 주는 값은 UTC 다 — 한국 시각은 보여 주기 직전에 한 번만 만든다(docs/utc-time.md). *@
                        @(((MenuUsageByUserDto)cell.DataItem).LastViewAt.Kst("MM-dd HH:mm"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>

            <ContextMenuItems>
                <CommMenuItem Text="이 사람의 타임라인" IconCssClass="jsini-icon-clock"
                              Enabled="@(_pickedRow is not null)"
                              Click="@(() => OpenUserTimelineAsync(_pickedRow!))" />
            </ContextMenuItems>
        </CommGrd>
    }
    else if (_view == ViewByMenu)
    {
        <CommGrd TItem="MenuUsageByMenuDto"
                 Data="@_menus"
                 ExportName="메뉴 사용기록 (화면별)"
                 EmptyText="이 기간에 쌓인 기록이 없습니다."
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(MenuUsageByMenuDto.Screen)" Caption="화면" MinWidth="200"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByMenuDto.MenuPath)" Caption="경로" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByMenuDto.Views)" Caption="열람" Width="90"
                                  DisplayFormat="N0" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageByMenuDto.Users)" Caption="사람" Width="80"
                                  DisplayFormat="N0" />

                <DxGridDataColumn Caption="마지막" Width="130">
                    <CellDisplayTemplate Context="cell">
                        @(((MenuUsageByMenuDto)cell.DataItem).LastViewAt.Kst("MM-dd HH:mm"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    }
    else if (_view == ViewLog)
    {
        <CommGrd TItem="MenuUsageDto"
                 Data="@_logs"
                 ExportName="메뉴 사용기록"
                 EmptyText="이 기간에 쌓인 기록이 없습니다."
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn Caption="본 때" Width="150">
                    <CellDisplayTemplate Context="cell">
                        @(((MenuUsageDto)cell.DataItem).OccurredAt.Kst("MM-dd HH:mm:ss"))
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(MenuUsageDto.Who)" Caption="사용자" MinWidth="160"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageDto.DepartmentName)" Caption="부서" Width="120"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageDto.Screen)" Caption="화면" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn FieldName="@nameof(MenuUsageDto.MenuPath)" Caption="경로" MinWidth="160"
                                  TextAlignment="GridTextAlignment.Left" />

                @* 어디서 왔나 — 화면 하나만 보면 알 수 없는 길이라 기록 줄에 앞 화면을 함께 적는다. *@
                <DxGridDataColumn Caption="앞 화면" MinWidth="140"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var row = (MenuUsageDto)cell.DataItem;
                        }
                        @if (string.IsNullOrWhiteSpace(row.FromPath))
                        {
                            <span class="jsini-text-muted">처음</span>
                        }
                        else
                        {
                            <span class="jsini-text-muted">@row.FromPath</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    }
    else
    {
        @* ── 일자별 타임라인 ── 표로 그리지 않는다 — 읽는 방향이 다르다. 위에서 아래로 하루가 어떻게 흘렀나를 보려고 날짜를 머리띠로 세우고 시각을 줄줄이 세운다. *@

        @if (_days.Count == 0)
        {
            <PageNotice Tone="NoticeTone.Info" Text="이 기간에 쌓인 기록이 없습니다." />
        }
        else
        {
            <div class="ad-usagetl">
                @foreach (var day in _days)
                {
                    <section class="ad-usagetl__day">
                        <header class="ad-usagetl__date">
                            <span class="ad-usagetl__datetext">@day.Date (@WeekdayOf(day.Date))</span>
                            <span class="jsini-text-muted">
                                @day.Views.ToString("N0")건 · 화면 @day.Screens.ToString("N0")개 ·
                                @day.FirstAt.Kst("HH:mm") ~ @day.LastAt.Kst("HH:mm")
                            </span>
                        </header>

                        <ol class="ad-usagetl__list">
                            @foreach (var item in day.Items)
                            {
                                <li class="ad-usagetl__item">
                                    <span class="ad-usagetl__time">@item.OccurredAt.Kst("HH:mm:ss")</span>
                                    <span class="ad-usagetl__dot" aria-hidden="true"></span>

                                    <span class="ad-usagetl__name" title="@item.MenuPath">@item.Screen</span>

                                    @* 사람을 고른 보기에서는 같은 이름이 줄마다 서므로 적지 않는다. 안 고르면 누구의 줄인지가 이 글자 하나에 달려 있다. *@
                                    @if (_userId is null)
                                    {
                                        <span class="ad-usagetl__who">@item.Who</span>
                                    }

                                    @* 앞 칸에서 여기까지다 — 머문 시간이 아니라서 말풍선에 그 말을 적는다. *@
                                    @if (item.Seq > 1 && item.GapMinutes > 0)
                                    {
                                        <span class="ad-usagetl__gap"
                                              title="앞 화면을 연 뒤 여기까지 걸린 시간입니다. 그 화면에 머문 시간이 아닙니다.">
                                            +@GapText(item.GapMinutes)
                                        </span>
                                    }
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>
        }
    }
</CommCont>
