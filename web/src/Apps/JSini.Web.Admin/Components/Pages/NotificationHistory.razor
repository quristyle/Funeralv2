@page "/admin/push/history"
@attribute [RouteKey("admin.push.history")]

@*
    [내 알림함] — DB 메뉴 `/system/push/history`.
    이력: Vue `views/portal/system/push/history` → 여기.

    내가 받은 알림을 본다. 읽음 처리는 서버에 남는다 —
    화면에서만 지우면 다른 기기에서 다시 안 읽은 것으로 보인다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>내 알림함 · 포털관리</PageTitle>

<CommSch OnSearch="@ReloadAsync">
    <Fields>
        <CommSchItem Label="기간">
            <DxDateEdit @bind-Date="_from" Style="width: 140px" />
        </CommSchItem>
        <CommSchItem Label="~">
            <DxDateEdit @bind-Date="_to" Style="width: 140px" />
        </CommSchItem>
        <CommSchItem>
            @* 라벨을 안 붙인다. 스위치 옆 글자가 이미 무엇인지 말한다.

               **이건 서버에 보내지 않는다.** 받아 둔 것에서 거르므로 누르는
               즉시 반영된다 — 서버로 보내면 「조회」를 한 번 더 눌러야 한다. *@
            <DxCheckBox @bind-Checked="_unreadOnly">안 읽은 것만</DxCheckBox>
        </CommSchItem>
    </Fields>
</CommSch>

<PageNotice Text="@Notice" Tone="@Tone" />

<CommCont>
    <CommGrd TItem="NotificationDto" Data="@Shown" PageSize="30"
             ExportName="알림함"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(NotificationDto.CreatedAt)" Caption="받은 때" Width="150" DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn FieldName="@nameof(NotificationDto.Title)" Caption="제목" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(NotificationDto.Body)" Caption="내용" MinWidth="280" />
            <DxGridDataColumn Caption="상태" Width="120">
                <CellDisplayTemplate Context="cell">
                    @{ var n = (NotificationDto)cell.DataItem; }
                    @if (n.IsRead)
                    {
                        <span class="jsini-badge jsini-badge--off">읽음</span>
                    }
                    else
                    {
                        <DxButton Text="읽음 처리" RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="@(() => MarkReadAsync(n))" />
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
</CommCont>

@code {
    /// <summary>
    /// 조회 기간. <b>기본이 최근 한 달이다.</b>
    /// </summary>
    /// <remarks>
    /// 알림은 지우지 않으므로 자라기만 한다. 전에는 조건 없이 불러
    /// <b>그 사람의 알림을 전부</b> 받아 왔다(서버에 페이징이 없다 —
    /// <c>GetMyNotificationsAsync</c> 머리말). 발송 이력(이레)보다 길게 잡은
    /// 것은 자기 알림함은 드물게 열어 보기 때문이다.
    /// </remarks>
    private DateTime? _from = DateTime.Today.AddMonths(-1);
    private DateTime? _to = DateTime.Today;

    private bool _unreadOnly;
    private IReadOnlyList<NotificationDto> _all = [];

    private IReadOnlyList<NotificationDto> Shown =>
        _unreadOnly ? [.. _all.Where(n => !n.IsRead)] : _all;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetMyNotificationsAsync(_from, _to);
        return _all.Count;
    }, "받은 알림이 없습니다.", "알림을 읽지 못했습니다");

    private async Task MarkReadAsync(NotificationDto n)
    {
        if (await RunAsync(() => Api.MarkNotificationReadAsync(n.Id),
                "읽음으로 표시했습니다.", "표시하지 못했습니다"))
        {
            n.IsRead = true;
        }
    }
}
