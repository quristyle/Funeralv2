@page "/admin/push/history"
@attribute [RouteKey("admin.push.history")]

@*
    [내 알림함] 내가 받은 알림을 본다. 읽음 처리는 서버에 남는다 — 화면에서만 지우면 다른 기기에서 다시 안 읽은 것으로 보인다.
    출처는 알림 서버의 발송 기록이다(헬프데스크 표가 아니다). 한 줄은 발송 한 번이고 batch_id 로 묶는다. 푸시가 실패했거나 꺼 둔 알림도 내게 온 소식이면 보여 주고, 못 받은 까닭을 함께 적는다.
*@

@inherits DataPage

<PageTitle>내 알림함</PageTitle>

@* 휴대폰인가(767px, CSS 의 휴대폰 경계와 같은 값). 표를 카드 목록으로 바꿔 단다. 값은 첫 그림 뒤에 오므로 표가 한 번 곧바로 걷히는데, 그 뒤 CommGrd 가 제 속을 만지는 일은 _gone 이 막는다. *@
<DxLayoutBreakpoint MaxWidth="767" IsActive="_isPhone" IsActiveChanged="@OnPhoneChanged" />

@* 조건을 고치면 그 자리에서 다시 읽는다 — 칸마다 bind 대신 값과 변경을 따로 받는다. 조회 단추는 새로 온 알림만 확인하려는 사람이 쓰는 길이다. *@
<CommSch OnSearch="@ReloadAsync" SearchText="다시 읽기" Busy="@Loading"
         MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="기간">
            <DxDateEdit Date="@_from" DateChanged="@((DateTime? d) => OnFromChangedAsync(d))"
                        Style="width: 140px" />
        </CommSchItem>
        <CommSchItem Label="~">
            <DxDateEdit Date="@_to" DateChanged="@((DateTime? d) => OnToChangedAsync(d))"
                        Style="width: 140px" />
        </CommSchItem>
        <CommSchItem Label="구분">
            @* 갈래 목록은 공통코드(NOTI_CATEGORY)가 갖는다 — 화면에 박으면 갈래 하나 늘리는 데 배포가 필요하다. 기간 안에 없는 것을 좁히는 조건이라 서버로 보낸다. *@
            <DxComboBox Data="@_categoryOptions" TData="SchOption" TValue="string"
                        Value="@_category" ValueChanged="@((string? v) => OnCategoryChangedAsync(v))"
                        TextFieldName="@nameof(SchOption.Text)" ValueFieldName="@nameof(SchOption.Value)"
                        Style="width: 150px" />
        </CommSchItem>
        <CommSchItem Label="제목·내용">
            <DxTextBox @bind-Text="_keyword" @bind-Text:after="ReloadAsync"
                       BindValueMode="BindValueMode.OnInput" InputDelay="2000"
                       ValidationEnabled="false" Style="width: 220px" />
        </CommSchItem>

        <CommSchItem>
            @* 라벨을 안 붙인다 — 스위치 옆 글자가 이미 무엇인지 말한다. 기본이 켜짐이다(안 본 것을 보려고 연다). 받아 둔 것에서 먼저 거르고 서버에도 조건을 실어 다시 읽는다. *@
            <DxCheckBox Checked="@_unreadOnly" CheckedChanged="@((bool on) => OnUnreadChangedAsync(on))">
                안 읽은 것만
            </DxCheckBox>
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont CssClass="@(_isPhone ? "ad-notebox ad-notebox--phone" : "ad-notebox")">
    @* ── 목록을 그리는 길이 둘이다 ── 데스크톱은 표, 휴대폰은 카드 목록이다. 표는 360px 에서 가로로 굴려야 내용이 보여서, 휴대폰에서는 한 건을 한 장에 세로로 편다. 할 수 있는 일은 줄지 않는다. *@
    @if (_isPhone)
    {
        @* 일괄 동작 띠 — 표의 Toolbar 와 같은 자리에 같은 것을 둔다. 「전체」는 지금 깔린 것만 고른다 — 아직 안 보이는 것을 잡으면 일괄삭제가 눈으로 확인한 것보다 많이 지운다. *@
        <div class="ad-notecards__bar">
            <DxCheckBox Checked="@AllPicked" CheckedChanged="@((bool on) => PickAll(on))"
                        Enabled="@(PhoneShown.Count > 0)">
                전체
            </DxCheckBox>

            @if (_selectedItems.Count > 0)
            {
                <span class="jsini-hint">@(_selectedItems.Count)건 선택</span>
            }

            <div class="ad-notecards__acts">
                <DxButton Text="읽음" IconCssClass="jsini-icon-check"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Enabled="@(_selectedItems.Count > 0)"
                          Click="@MarkSelectedReadAsync" />
                <DxButton Text="삭제" IconCssClass="jsini-icon-trash"
                          RenderStyle="ButtonRenderStyle.Danger"
                          Enabled="@(_selectedItems.Count > 0)"
                          Click="@DeleteSelectedAsync" />
            </div>
        </div>

        @if (PhoneShown.Count == 0)
        {
            @* 「없습니다」는 토스트로 한 번 지나가므로 빈 목록 자리에도 적어 둔다 — 안 적으면 좁힌 사람이 덜 그려진 화면을 본다. *@
            <p class="ad-notecards__empty">받은 알림이 없습니다.</p>
        }
        else
        {
            @* 손짓을 거는 자리다 — 코드비하인드가 이 id 로 찾는다. 섰다 사라지는 목록이라 다시 설 때마다 새로 건다. 어긋나면 손짓이 조용히 안 걸리므로 상수 하나를 나눠 쓴다. *@
            <ul class="ad-notecards" id="@SwipeListId">
                @foreach (var n in PhoneShown)
                {
                    @* @key 를 둔다 — 읽음 처리·삭제로 가운데 한 장이 빠지면 Blazor 가 맨 끝 것을 지우고 나머지 글자만 밀어 올려, 손짓이 붙은 DOM 이 엉뚱한 알림 카드가 된다. *@
                    <li class="ad-notecards__item @(n.IsRead ? null : "ad-notecards__item--unread")"
                        @key="n.Id" data-note="@n.Id">

                        @* ── 밀어서 읽음 · 밀어서 삭제 ── 서랍의 카드와 같은 짝이다(오른쪽 읽음 · 왼쪽 삭제). 띠는 미는 만큼만 넓어지고 본문에 불투명한 깔 것이 필요 없다. 밀 수 없는 자리를 위해 ✓ 단추는 그대로 둔다 — 손짓은 빠른 길이다. *@
                        <span class="ad-notecards__act ad-notecards__act--read"
                              aria-hidden="true">
                            <span class="ad-notecards__act-mark">✓</span>
                            <span class="ad-notecards__act-text">읽음</span>
                        </span>

                        <span class="ad-notecards__act ad-notecards__act--del"
                              aria-hidden="true">
                            <span class="ad-notecards__act-text">삭제</span>
                            <span class="ad-notecards__act-mark">🗑</span>
                        </span>

                        @* 미는 것은 카드가 아니라 이 줄이다 — 카드 자신을 옮기면 띠도 함께 가서 아무것도 열리지 않는다. *@
                        <div class="ad-notecards__row">

                            @* 체크는 이 자리에서만 한다 — 카드 본문을 누르는 것은 「연다」이고, 번짐을 안 끊으면 체크하려던 손짓이 그 줄을 열어 버린다. *@
                            <span class="ad-notecards__check"
                                  @onclick="@(() => { })" @onclick:stopPropagation="true">
                                <DxCheckBox Checked="@Picked(n)"
                                            CheckedChanged="@((bool on) => Pick(n, on))" />
                            </span>

                            <div class="ad-notecards__body" role="button" tabindex="0"
                                 @onclick="@(() => OpenAsync(n))"
                                 @onkeydown="@(e => OnCardKeyAsync(e, n))">

                                @* 얹는 한 줄 — 구분 · 도착 · 상태 · 받은 때. 표에서 칸 넷이던 것을 딱지로 바꿔 한 줄에 흘려 담는다. *@
                                <div class="ad-notecards__meta">
                                    @if (!string.IsNullOrWhiteSpace(n.Category))
                                    {
                                        <span class="jsini-badge">@_categoryName(n.Category)</span>
                                    }

                                    @* 도착했으면 아무것도 적지 않는다 — 정상에 딱지를 붙이면 눈이 거기로 간다. *@
                                    @if (!n.Delivered)
                                    {
                                        <span class="jsini-badge jsini-badge--warn" title="@n.FailureReason">
                                            @(n.FailureReason ?? "기기에 못 감")
                                        </span>
                                    }

                                    @if (n.IsRead)
                                    {
                                        <span class="jsini-badge jsini-badge--off">읽음</span>
                                    }

                                    @* 받은 때는 줄 끝에 민다 — 딱지가 몇 개든 같은 쪽에 있어 눈이 훑기 쉽다. *@
                                    <span class="ad-notecards__when">@n.CreatedAt.Kst("yyyy-MM-dd HH:mm")</span>
                                </div>

                                <div class="ad-notecards__title">@n.Title</div>

                                @* 표에서 가로로 굴려야 보이던 그 칸이다 — 제목 아래에 그대로 깔리고 네 줄까지 받는다. 긴 것은 눌러서 그 화면에서 본다. *@
                                @if (!string.IsNullOrWhiteSpace(n.Body))
                                {
                                    <p class="ad-notecards__text">@n.Body</p>
                                }
                            </div>

                            @* 한 건만 읽음으로 찍는다 — 카드를 누르는 것과 달리 찍고 나서 그 화면으로 데려가지 않는다. 치우기만 하려는 알림이 잦아 둘을 가른다(서랍의 ✓ 단추와 같다). *@
                            @if (!n.IsRead)
                            {
                                <span class="ad-notecards__mark"
                                      @onclick="@(() => { })" @onclick:stopPropagation="true">
                                    <DxButton RenderStyle="ButtonRenderStyle.Link"
                                              IconCssClass="jsini-icon-check-circle"
                                              Title="읽음으로 표시"
                                              Click="@(() => MarkReadAsync(n))" />
                                </span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }

        @* 「더보기」. 몇 줄을 깔지는 PhoneShown 이 정하고 이 단추가 그 수를 늘린다. 다 깔고 나서도 자리에 남고 「끝」도 걷지 않는다 — 끊긴 자리에 표시가 없으면 사람은 덜 불러온 것으로 읽는다. *@
        @if (PhoneShown.Count > 0)
        {
            <div class="ad-notecards__more">
                <DxButton Text="@(PhoneRest > 0 ? $"더보기 {PhoneRest:N0}건" : "더보기 · 마지막입니다")"
                          Enabled="@(PhoneRest > 0)"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          CssClass="ad-notecards__more-go"
                          Click="@ShowMore" />
            </div>

            @* 휴대폰에서 목록 끝까지 굴리면 단추와 같은 만큼 더 펼친다. 감지점은 늘 DOM 에 둬야 다시 펼칠 때 관찰을 이어 간다. *@
            <span class="ad-notecards__more-sentinel"
                  aria-hidden="true"
                  @ref="_moreSentinel"></span>
        }
    }
    else
    {
    @* 줄을 한 번 누르면 그 알림이 가리키는 화면이 열린다 — 여는 김에 읽음으로 찍는다(PushClickRead). 두 번 누르기는 화면 어디에도 안 보이는 몸짓이라 쓰지 않는다. 줄 누르기는 체크를 하지 않고, 줄 안의 단추는 번짐을 막는다(@onclick:stopPropagation). *@
    <CommGrd TItem="NotificationDto" Data="@Shown" PageSize="30"
             ExportName="알림함"
             CssClass="ad-notebox__grid"
             SelectionMode="GridSelectionMode.Multiple"
             AllowSelectRowByClick="false"
             SelectedItems="@_selectedItems"
             SelectedItemsChanged="@((IReadOnlyList<NotificationDto> items) => _selectedItems = items)"
             OnRowClick="@OpenAsync"
             Reload="@ReloadAsync">
        <RowActions Context="n">
            @if (!n.IsRead)
            {
                <DxButton Text="읽음 처리" RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => MarkReadAsync(n))" />
            }
        </RowActions>
        @* 일괄 동작은 표 위에 둔다 — 오른쪽 클릭 창에만 있으면 체크해 놓고 할 일이 화면에 안 보인다. 몇 건을 골랐는지도 여기 적는다. *@
        <Toolbar>
            <DxButton Text="선택 항목 읽음 처리" IconCssClass="jsini-icon-check"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(_selectedItems.Count > 0)"
                      Click="@MarkSelectedReadAsync" />
            <DxButton Text="선택 항목 일괄삭제" IconCssClass="jsini-icon-trash"
                      RenderStyle="ButtonRenderStyle.Danger"
                      Enabled="@(_selectedItems.Count > 0)"
                      Click="@DeleteSelectedAsync" />
            @if (_selectedItems.Count > 0)
            {
                <span class="jsini-hint">@(_selectedItems.Count)건 선택</span>
            }
        </Toolbar>
        <Columns>
            @* 줄마다 체크 칸. 머리줄의 체크가 「보이는 것 전부」를 고른다. *@
            <DxGridSelectionColumn Width="50" />
            @* 서버가 주는 것은 UTC 라 그대로 그리면 아홉 시간 전으로 보인다 — ToLocalTime() 으로는 안 된다(컨테이너가 UTC 라 아무 일도 안 한다). 한국 시각은 Kst(...) 하나로 만든다(docs/utc-time.md). *@
            <DxGridDataColumn FieldName="@nameof(NotificationDto.CreatedAt)" Caption="받은 때" Width="150">
                <CellDisplayTemplate Context="cell">
                    @(((NotificationDto)cell.DataItem).CreatedAt.Kst("yyyy-MM-dd HH:mm", string.Empty))
                </CellDisplayTemplate>
            </DxGridDataColumn>
            @* 갈래. 공통코드의 이름으로 그린다 — 목록에서 지워진 옛 코드값이 그대로 보인다. *@
            <DxGridDataColumn FieldName="@nameof(NotificationDto.Category)" Caption="구분" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{ var c = ((NotificationDto)cell.DataItem).Category; }
                    @if (!string.IsNullOrWhiteSpace(c))
                    {
                        <span class="jsini-badge">@_categoryName(c)</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(NotificationDto.Title)" Caption="제목" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(NotificationDto.Body)" Caption="내용" MinWidth="280" />
            @* 왔지만 기기에는 안 떴다를 말하는 칸. 도착했으면 적지 않는다. *@
            <DxGridDataColumn Caption="도착" Width="150">
                <CellDisplayTemplate Context="cell">
                    @{ var row = (NotificationDto)cell.DataItem; }
                    @if (!row.Delivered)
                    {
                        <span class="jsini-badge jsini-badge--warn" title="@row.FailureReason">
                            @(row.FailureReason ?? "기기에 못 감")
                        </span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="상태" Width="120">
                <CellDisplayTemplate Context="cell">
                    @{ var n = (NotificationDto)cell.DataItem; }
                    @if (n.IsRead)
                    {
                        <span class="jsini-badge jsini-badge--off">읽음</span>
                    }
                    else
                    {
                        <span class="jsini-badge jsini-badge--warn">안 읽음</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
    }
</CommCont>

@* 일괄삭제만 묻는다 — 한 건씩 치우는 길은 눈앞의 그 줄 하나라 묻지 않는다. 체크해 둔 수십 건은 되짚을 길이 없다. *@
<ConfirmDialog @ref="_confirm" />
