@page "/admin/system/account"
@attribute [RouteKey("admin.system.account")]

@*
    [계정 관리] DB 메뉴 `/system/account`. 조회 영역(CommSch) → 자료 영역(CommCont + CommGrd).
    로그인 아이디는 등록할 때만 정한다(권한표·즐겨찾기의 열쇠). 첫 비밀번호는 등록·초기화 응답에 한 번만 실려 창에 띄운다 — 닫으면 다시 못 본다.
    알림 상태 넷(구독 · 푸시 · 이메일 · 기상특보)은 다른 서비스 표라 따로 읽는다 — 알림 서버가 죽어도 계정 목록은 뜬다. 행이 없으면 기본값이고 흐리게 그린다.
*@

@inherits DataPage

<PageTitle>계정 관리</PageTitle>

@* 조회 안내. 저장·삭제 안내는 CommGrd 가 자기 자리에 띄운다. *@

<CommSch OnSearch="@ReloadAsync" OnReset="@Reset" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 240px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@StatusFilters" @bind-Value="_status" Style="width: 140px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>

    @* 가입 신청은 DB 메뉴에 없어 사이드바에 뜨지 않는다 — 들어가는 길이 여기뿐이라 단추를 둔다. 조회 영역에 둔다(표 안에 두면 가로 스크롤 저편으로 밀린다). *@
    <Actions>
        <DxButton Text="가입현황" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => Navigation.NavigateTo("/admin/system/signup"))" />
    </Actions>
</CommSch>

@* PopupEditFormCssClass 는 편집 창을 넓힌다 — 기본 폭에서는 편집기 하나가 145px 밖에 안 남는다.
   여는 태그 안에 Razor 주석을 쓰지 않는다 — 속성 자리에 끼우면 회로가 끊겨 표가 통째로 안 그려진다. *@
<CommCont>
    <CommGrd TItem="AccountDto"
             StateKey="@StateKey"
             Data="@Shown"
             EditFormTitle="계정"
             PopupEditFormCssClass="ad-editpopup"
             ExportName="계정"
             EmptyText="조건에 맞는 계정이 없습니다."
             OnNew="@FillNew"
             OnEditOpen="@PrepareEdit"
             OnSave="@SaveAsync"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="140">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <span>@a.LoginId</span>
                        @if (a.IsSocialMerged)
                        {
                            <span class="jsini-badge jsini-badge--info" title="@($"소셜 가입신청 결합 계정 ({a.SocialProviderText})")">소셜결합</span>
                        }
                        else if (a.IsSocialLinked)
                        {
                            <span class="jsini-badge jsini-badge--muted" title="@($"소셜 연동 계정 ({a.SocialProviderText})")">소셜</span>
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="110" />
            <DxGridDataColumn Caption="소셜 연동" Width="120">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    @if (a.SocialProviders is { Count: > 0 })
                    {
                        <div style="display: flex; flex-wrap: wrap; gap: 2px;">
                            @foreach (var provider in a.SocialProviders)
                            {
                                <span class="jsini-badge @SocialBadgeClass(provider)" title="@(a.IsSocialMerged ? "결합된 소셜 계정" : "연결된 소셜 계정")">
                                    @(SocialProviderName(provider))@(a.IsSocialMerged ? "(결합)" : "")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="jsini-text-muted">–</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="이메일" MinWidth="190">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                        var emails = a.Emails is { Count: > 0 }
                            ? a.Emails.Where(e => !string.IsNullOrWhiteSpace(e)).Distinct(StringComparer.OrdinalIgnoreCase).ToList()
                            : (!string.IsNullOrWhiteSpace(a.Email) ? [a.Email] : new List<string>());
                    }
                    @if (emails.Count == 0)
                    {
                        <span class="jsini-text-muted">–</span>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                            @foreach (var em in emails)
                            {
                                <span>@em</span>
                            }
                        </div>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="연락처" Width="140">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                        var phones = a.Phones is { Count: > 0 }
                            ? a.Phones.Where(p => !string.IsNullOrWhiteSpace(p)).Distinct(StringComparer.OrdinalIgnoreCase).ToList()
                            : (!string.IsNullOrWhiteSpace(a.Phone) ? [a.Phone] : new List<string>());
                    }
                    @if (phones.Count == 0)
                    {
                        <span class="jsini-text-muted">–</span>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                            @foreach (var ph in phones)
                            {
                                <span>@ph</span>
                            }
                        </div>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="@nameof(AccountDto.CompanyName)" Caption="회사" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" Width="130" />

            <DxGridDataColumn FieldName="@nameof(AccountDto.RoleText)" Caption="역할" MinWidth="150" />

            <DxGridDataColumn Caption="상태" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    <span class="jsini-badge @StatusClass(a.Status)">@StatusText(a.Status)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AccountDto.CreatedAt)" Caption="등록일" Width="110"
                              DisplayFormat="yyyy-MM-dd" />

            @* ── 마지막 로그인 · 마지막 사용 ── 로그인 시각만으로는 안 쓰는 계정을 못 가린다(토큰 7일 · 갱신 쿠키 30일). 마지막 사용은 사용기록이 화면을 옮길 때마다 밀어 준다(docs/menu-usage.md).
               시각 밑에 「며칠 전」을 덧붙이고, 보여 주기 직전에만 Kst() 로 바꾼다(docs/utc-time.md). *@

            <DxGridDataColumn FieldName="@nameof(AccountDto.LastLoginAt)" Caption="마지막 로그인" Width="135">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    @if (a.LastLoginAt is null)
                    {
                        <span class="jsini-text-muted" title="이 계정으로 로그인한 기록이 없습니다.">–</span>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 1px;"
                             title="@LoginTitle(a)">
                            <span>@a.LastLoginAt.Kst("yyyy-MM-dd HH:mm")</span>
                            <span class="jsini-text-muted" style="font-size: .75rem;">@Ago(a.LastLoginAt)</span>
                        </div>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AccountDto.LastSeenAt)" Caption="마지막 사용" Width="135">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    @if (a.LastSeenAt is null)
                    {
                        <span class="jsini-text-muted" title="포털을 쓴 기록이 없습니다.">–</span>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 1px;"
                             title="마지막으로 화면을 연 때입니다(한국 시각). 화면에 머물기만 한 시간은 세지 않습니다.">
                            <span>@a.LastSeenAt.Kst("yyyy-MM-dd HH:mm")</span>
                            <span class="jsini-text-muted" style="font-size: .75rem;">@Ago(a.LastSeenAt)</span>
                        </div>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            @* 알림 넷은 기본으로 감춰 두지 않는다 — 발송이 안 닿는 까닭을 찾으러 오는 자리다. *@

            @* 구독은 **기기 수**다. 0 이면 푸시를 켜 두어도 갈 곳이 없다. *@
            <DxGridDataColumn Caption="PWA 구독" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var n = State((AccountDto)cell.DataItem);
                    }
                    @if (n is null)
                    {
                        <span class="jsini-text-muted">–</span>
                    }
                    else if (n.DeviceCount > 0)
                    {
                        <span class="jsini-badge jsini-badge--on"
                              title="@($"기기 {n.DeviceCount}대가 구독 중입니다.{LastSent(n)}")">
                            @n.DeviceCount 대
                        </span>
                    }
                    else
                    {
                        <span class="jsini-badge jsini-badge--off"
                              title="구독한 기기가 없어 푸시가 도착할 곳이 없습니다.">없음</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="푸시 알림" Width="90">
                <CellDisplayTemplate Context="cell">
                    @Switch(State((AccountDto)cell.DataItem), s => s.PushEnabled)
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="이메일 알림" Width="95">
                <CellDisplayTemplate Context="cell">
                    @Switch(State((AccountDto)cell.DataItem), s => s.EmailEnabled)
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="기상특보" Width="90">
                <CellDisplayTemplate Context="cell">
                    @Switch(State((AccountDto)cell.DataItem), s => s.WeatherEnabled)
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>

        @* 줄마다 [앱 현황]으로 가는 길 — 칸 넷이 답하지 못하는 「어느 기기가 못 받나」는 그쪽이 답한다. 관리 칸에 둔다(오른쪽에 붙박여 굴러도 같은 자리). *@
        @* 비밀번호 초기화는 줄에 붙여 둔다 — 편집 창 안에 두면 저장을 눌러야 끝나는 일처럼 보이지만 누르는 즉시 바뀐다. 고치기와 같은 권한(Update)으로 가린다. *@
        <RowActions Context="a">
            <PermissionView Action="MenuAction.Update">
                <DxButton IconCssClass="jsini-icon-link" Title="다른 계정으로 결합"
                          RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => AskMergeAsync(a))" />

                <DxButton IconCssClass="jsini-icon-lock" Title="비밀번호 초기화"
                          CssClass="commgrd__icon--warn"
                          RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => ResetPasswordAsync(a))" />
            </PermissionView>

            <DxButton IconCssClass="jsini-icon-bell" Title="앱 현황"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => Navigation.NavigateTo($"/admin/system/account/{Uri.EscapeDataString(a.LoginId)}/app"))" />

            <PermissionView Action="MenuAction.Delete">
                <DxButton IconCssClass="jsini-icon-trash" Title="삭제"
                          CssClass="commgrd__icon--warn"
                          RenderStyle="ButtonRenderStyle.Link"
                          Click="@(() => ConfirmDeleteAsync(a))" />
            </PermissionView>
        </RowActions>

        <EditFormTemplate Context="edit">
            @{
                var a = (AccountDto)edit.EditModel;
                var isNew = string.IsNullOrEmpty(a.Id);
            }
            @* 칸을 두 줄기로 세운다 — 왼쪽은 사람을 가리키는 값, 오른쪽은 설명하는 값. 체크 네모는 표제 아래 가로로 늘어놓는다(ad-checks) — 칸을 쪼개면 500px 창에서 글자가 세로로 흘러내린다. *@
            <DxFormLayout CssClass="ad-editform">
                <DxFormLayoutItem Caption="로그인 아이디" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.LoginId" ReadOnly="@(!isNew)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.UserName" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이메일" ColSpanMd="6">
                    <DxTagBox Data="@(new List<string>())"
                              @bind-Values="a.EmailValues"
                              AllowCustomTags="true" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="연락처" ColSpanMd="6">
                    <DxTagBox Data="@(new List<string>())"
                              @bind-Values="a.PhoneValues"
                              AllowCustomTags="true" />
                </DxFormLayoutItem>

                @if (!isNew)
                {
                    <DxFormLayoutItem Caption="회사" ColSpanMd="6">
                        <DxComboBox Data="@_companies" @bind-Value="a.CompanyId"
                                    @bind-Value:after="() => CompanyChangedAsync(a)"
                                    TextFieldName="@nameof(CompanyDto.Name)"
                                    ValueFieldName="@nameof(CompanyDto.Id)"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                }

                <DxFormLayoutItem Caption="부서" ColSpanMd="6">
                    <DxComboBox Data="@_depts" @bind-Value="a.DeptId"
                                TextFieldName="@nameof(DeptDto.Name)"
                                ValueFieldName="@nameof(DeptDto.Id)"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="상태" ColSpanMd="6">
                    <DxComboBox Data="@StatusOptions" @bind-Value="a.Status"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="역할" ColSpanMd="12">
                    @* Roles · BirthDateTime 은 형을 맞춰 둔 창이다. 형변환이나 메서드를 끼우면 팝업이 말없이 안 열린다. *@
                    <DxTagBox Data="@_roles"
                              @bind-Values="a.Roles"
                              TextFieldName="@nameof(RoleDto.Name)"
                              ValueFieldName="@nameof(RoleDto.Id)" />
                </DxFormLayoutItem>

                @* 날짜와 네모 둘은 한 가지 일이라 한 표제 아래 둔다. *@
                <DxFormLayoutItem Caption="생일" ColSpanMd="12">
                    <div class="ad-checks">
                        <DxDateEdit @bind-Date="a.BirthDateTime" CssClass="ad-editform__date" />
                        <DxCheckBox @bind-Checked="a.BirthDateIsLunar">음력</DxCheckBox>
                        <DxCheckBox @bind-Checked="a.BirthdayCelebrated">생일 목록에 넣는다</DxCheckBox>
                    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="워터마크" ColSpanMd="12">
                    @* 화면 위에 로그인 아이디를 옅게 깔아 촬영물에서 누구 화면인지 드러나게 한다. 관리자만 끈다 — 당사자가 끌 수 있으면 목적이 사라진다. 까닭은 아래 한 줄에 적는다(옆에 달면 네모가 두 줄로 접힌다). *@
                    <DxCheckBox @bind-Checked="a.Watermark">화면에 아이디를 옅게 깐다</DxCheckBox>
                </DxFormLayoutItem>

                @* 개발 업무용 속성 — 프로젝트관리의 개발자 관리 화면에서 옮겨 왔다. 묶음 넷은 닫힌 채로 두고 필요한 것만 편다. 값은 사전에 담긴다(account_profile_details, Dev. 접두사) — 속성을 더해도 마이그레이션이 없다. *@
                <DxFormLayoutGroup Caption="업무" ColSpanMd="12" Expanded="false">
                    <DxFormLayoutItem Caption="사번" ColSpanMd="4">
                        @* 사내 자료를 들여올 때 사번 → 계정 대조 열쇠로 쓰인다. *@
                        <DxTextBox @bind-Text="a.Dev.BpId" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="직급" ColSpanMd="4">
                        <DxTextBox @bind-Text="a.Dev.Position" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="비상연락처" ColSpanMd="4">
                        <DxTextBox @bind-Text="a.Dev.EmergTel" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                <DxFormLayoutGroup Caption="장비 대장" ColSpanMd="12" Expanded="false">
                    <DxFormLayoutItem Caption="노트북 장비번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.NotebookNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="노트북 확인번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.NotebookChkNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터1 장비번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor1No" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터1 확인번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor1ChkNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터2 장비번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor2No" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터2 확인번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor2ChkNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터3 장비번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor3No" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="모니터3 확인번호" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.Monitor3ChkNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="MAC 주소" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.MacAddr" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="사용 IP" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.UseIp" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="받은 것" ColSpanMd="12">
                        <div class="ad-checks">
                            <DxCheckBox @bind-Checked="a.Dev.Notebook">노트북</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.HubHdmi">허브/HDMI</DxCheckBox>
                        </div>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                @* 네모 열을 표제 열 개로 가르지 않는다 — 창이 500px 남짓이라 표제 칸이 60px 밖에 안 되어 글자가 세로로 흘러내린다. *@
                <DxFormLayoutGroup Caption="계정 발급 현황" ColSpanMd="12" Expanded="false">
                    <DxFormLayoutItem ColSpanMd="12">
                        <div class="ad-checks">
                            <DxCheckBox @bind-Checked="a.Dev.Git">Git</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.Startkit">StartKit</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.Dxb">DXB</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.VmConn">VM 접속</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.Aipro">AI Pro</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.ClaudeCode">Claude Code</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.DevDb">개발 DB</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.Wiki">Wiki</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.ProjectView">ProjectView</DxCheckBox>
                            <DxCheckBox @bind-Checked="a.Dev.Svn">SVN</DxCheckBox>
                        </div>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                <DxFormLayoutGroup Caption="옷 치수" ColSpanMd="12" Expanded="false">
                    <DxFormLayoutItem Caption="하계" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.SummerSize" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="동계" ColSpanMd="6">
                        <DxTextBox @bind-Text="a.Dev.WinterSize" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@* 발급된 비밀번호를 창으로 두는 까닭은 놓치면 끝이기 때문이다 — 줄로 띄우면 다음 조회에 지워진다. 등록과 초기화가 같은 창을 쓴다(둘 다 평문을 한 번만 보여 준다). *@
<CommPopup @bind-Visible="_issuedVisible"
         HeaderText="@(_issuedIsReset ? "초기화한 비밀번호" : "첫 비밀번호")"
         CloseOnEscape="false"
         CloseOnOutsideClick="false">
    @* Context 이름을 바꿔 둔다 — 안쪽 DxFormLayoutItem 의 기본 이름 context 와 겹치면 Razor 가 컴파일을 거절한다(RZ9999). *@
    <BodyContentTemplate Context="popup">
        <p class="jsini-hint">
            아래 비밀번호는 <b>지금 한 번만 보입니다.</b> 서버에는 해시로만 남아
            창을 닫으면 다시 볼 수 없습니다. 본인에게 전달하십시오.
        </p>

        <DxFormLayout CssClass="ad-editform">
            <DxFormLayoutItem Caption="아이디" ColSpanMd="12">
                @* 이름을 함께 적는다 — 아이디만 보고 엉뚱한 사람에게 전달하는 것이 이 창에서 날 수 있는 가장 나쁜 실수다. *@
                <DxTextBox Text="@IssuedWho" ReadOnly="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비밀번호" ColSpanMd="12">
                @* Password="false" — 가려 두면 옮겨 적을 수가 없다. *@
                <DxTextBox Text="@_issuedPassword" ReadOnly="true" />
            </DxFormLayoutItem>
        </DxFormLayout>

        <p class="jsini-hint">
            본인은 첫 로그인에서 곧바로 비밀번호를 바꾸게 됩니다.
        </p>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupContext">
        @* 복사를 먼저 둔다 — 열두 글자를 눈으로 옮겨 적는 것은 틀리기 쉽다. *@
        <DxButton Text="@(_issuedCopied ? "복사됨" : "복사")"
                  IconCssClass="@(_issuedCopied ? "jsini-icon-check" : "jsini-icon-copy")"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CopyIssuedAsync" />

        <DxButton Text="확인했습니다" RenderStyle="ButtonRenderStyle.Primary"
                  Click="@(() => _issuedVisible = false)" />
    </FooterContentTemplate>
</CommPopup>

@* 초기화를 묻는 창. CommGrd 의 삭제 창과 같은 부품이지만 그쪽은 표 안에 숨어 있어 쓸 수 없다. *@
<ConfirmDialog @ref="_confirm" />

@* 계정 결합 창. 기존 계정을 다른 계정으로 결합(Merge)하여 통합한다. *@
<CommPopup @bind-Visible="_mergingVisible" HeaderText="계정 결합" Width="480px">
    <BodyContentTemplate Context="mergePopup">
        <p class="jsini-hint">
            <strong>@(_mergeSource?.UserName ?? "-")</strong> (@(_mergeSource?.LoginId ?? "-")) 계정을 다른 기존 계정으로 결합합니다.
            <br />
            소셜 연동, 연락처 등이 대상 계정으로 통합되고, 원본 계정은 삭제됩니다.
        </p>

        <div style="margin-top: 12px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">결합할 대상 계정 선택</label>
            <DxComboBox Data="@MergeTargetCandidates"
                        TextFieldName="@nameof(AccountDto.DisplayText)"
                        ValueFieldName="@nameof(AccountDto.LoginId)"
                        @bind-Value="_mergeTargetAccountId"
                        SearchMode="ListSearchMode.AutoSearch"
                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        NullText="계정을 선택하거나 아래에 아이디를 직접 입력하세요" />
        </div>

        <div style="margin-top: 10px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">대상 계정 아이디 직접 입력</label>
            <DxTextBox @bind-Text="_mergeTargetAccountId" NullText="대상 계정 로그인 아이디" />
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="결합" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!string.IsNullOrWhiteSpace(_mergeTargetAccountId))"
                  Click="@MergeAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _mergingVisible = false)" />
    </FooterContentTemplate>
</CommPopup>
