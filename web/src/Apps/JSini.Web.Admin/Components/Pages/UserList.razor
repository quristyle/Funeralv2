@page "/admin/system/account"

@*
    [계정 관리] — DB 메뉴 `/system/account`.

    화면 구성: 조회 영역(CommSch) → 자료 영역(CommCont + CommGrd).
    로그인 아이디는 등록할 때만 정한다 — 권한표·즐겨찾기의 열쇠라 바꾸면
    그 사람의 기록이 끊긴다. 비밀번호는 여기서 다루지 않는다.
*@

@inherits DataPage
@inject AdminClient Api
@inject NavigationManager Navigation

<PageTitle>계정 관리 · 포털관리</PageTitle>

@* 조회 안내. 저장·삭제 안내는 CommGrd 가 자기 자리에 띄운다. *@
<PageNotice Text="@Notice" Tone="@Tone" />

<CommSch OnSearch="@ReloadAsync" OnReset="@Reset">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" NullText="아이디·이름·이메일" Style="width: 240px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@StatusFilters" @bind-Value="_status"
                        NullText="전체" Style="width: 140px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="AccountDto"
             Data="@Shown"
             EditFormTitle="계정"
             ExportName="계정"
             EmptyText="조건에 맞는 계정이 없습니다."
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             Reload="@ReloadAsync">
        @* 가입 신청은 DB 메뉴에 없어 사이드바에 뜨지 않는다. 들어가는 길이
           여기뿐이라 단추를 둔다 — 그 화면의 머리말에 사연이 있다. *@
        <Toolbar>
            <DxButton Text="가입 신청" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => Navigation.NavigateTo("/admin/system/signup"))" />
        </Toolbar>

        <Columns>
            <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="110" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.Email)" Caption="이메일" MinWidth="180" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.Phone)" Caption="연락처" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.CompanyName)" Caption="회사" Width="130" />
            <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" Width="130" />

            <DxGridDataColumn FieldName="@nameof(AccountDto.RoleText)" Caption="역할" MinWidth="150" />

            <DxGridDataColumn Caption="상태" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var a = (AccountDto)cell.DataItem;
                    }
                    <span class="jsini-badge @StatusClass(a.Status)">@StatusText(a.Status)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AccountDto.CreatedAt)" Caption="등록일" Width="110"
                              DisplayFormat="yyyy-MM-dd" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var a = (AccountDto)edit.EditModel;
                var isNew = string.IsNullOrEmpty(a.Id);
            }
            <DxFormLayout CssClass="ad-editform">
                <DxFormLayoutItem Caption="로그인 아이디" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.LoginId" ReadOnly="@(!isNew)"
                               NullText="영문·숫자" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.UserName" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이메일" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.Email" NullText="user@example.com" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="연락처" ColSpanMd="6">
                    <DxTextBox @bind-Text="a.Phone" NullText="010-0000-0000" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="부서" ColSpanMd="6">
                    <DxComboBox Data="@_depts" @bind-Value="a.DeptId"
                                TextFieldName="@nameof(DeptDto.Name)"
                                ValueFieldName="@nameof(DeptDto.Id)"
                                NullText="소속 없음"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="상태" ColSpanMd="6">
                    <DxComboBox Data="@StatusOptions" @bind-Value="a.Status"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="역할" ColSpanMd="12">
                    @* Roles · BirthDateTime 은 형을 맞춰 둔 창이다. 형변환이나
                       메서드를 끼우면 팝업이 말없이 안 열린다 — AdminModels 참고. *@
                    <DxTagBox Data="@_roles"
                              @bind-Values="a.Roles"
                              TextFieldName="@nameof(RoleDto.Name)"
                              ValueFieldName="@nameof(RoleDto.Id)"
                              NullText="역할 없음" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="생일" ColSpanMd="5">
                    <DxDateEdit @bind-Date="a.BirthDateTime" NullText="비워 둘 수 있다" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="음력" ColSpanMd="3">
                    <DxCheckBox @bind-Checked="a.BirthDateIsLunar">음력</DxCheckBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="축하 대상" ColSpanMd="4">
                    <DxCheckBox @bind-Checked="a.BirthdayCelebrated">생일 목록에 넣는다</DxCheckBox>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    private IReadOnlyList<AccountDto> _all = [];
    private IReadOnlyList<RoleDto> _roles = [];
    private IReadOnlyList<DeptDto> _depts = [];

    private string? _keyword;
    private string? _status;

    @* PENDING 은 거르기에만 있고 편집 목록(StatusOptions)에는 없다. 승인은
       [가입 신청] 화면이 하는 일이라, 여기서 손으로 PENDING 을 지정하면
       그 사람이 이유 없이 로그인하지 못한다. *@
    private static readonly string[] StatusFilters = ["PENDING", "ACTIVE", "LOCKED", "RESIGNED"];

    private static readonly object[] StatusOptions =
    [
        new { Value = "ACTIVE", Text = "정상" },
        new { Value = "LOCKED", Text = "잠금" },
        new { Value = "RESIGNED", Text = "퇴사" },
    ];

    /// <summary>거르기는 브라우저 쪽에서 한다. 서버에 검색 조건이 없다.</summary>
    private IReadOnlyList<AccountDto> Shown
    {
        get
        {
            IEnumerable<AccountDto> rows = _all;

            if (!string.IsNullOrWhiteSpace(_status))
            {
                rows = rows.Where(a => string.Equals(a.Status, _status, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_keyword))
            {
                var k = _keyword.Trim();
                rows = rows.Where(a =>
                    a.LoginId.Contains(k, StringComparison.OrdinalIgnoreCase)
                    || a.UserName.Contains(k, StringComparison.OrdinalIgnoreCase)
                    || (a.Email?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return [.. rows];
        }
    }

    /// <summary>
    /// 화면을 열면 바로 읽는다. 역할·부서도 함께 받는다 — 조회 전에 바로
    /// 「등록」을 눌러도 편집 폼의 고르개가 비어 있으면 안 되기 때문이다.
    /// </summary>
    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        _roles = await Api.GetRolesAsync();
        _depts = Flatten(await Api.GetDeptsAsync());
        _all = await Api.GetAccountsAsync();

        return _all.Count;
    }, "계정이 없습니다.", "계정 목록을 읽지 못했습니다");

    /// <summary>「조회」와 저장·삭제 뒤가 부른다.</summary>
    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetAccountsAsync();
        return _all.Count;
    }, "조건에 맞는 계정이 없습니다.", "계정 목록을 읽지 못했습니다");

    /// <summary>조건을 비우고 전체를 다시 읽는다.</summary>
    private Task Reset()
    {
        _keyword = null;
        _status = null;
        return ReloadAsync();
    }

    private void FillNew(AccountDto a)
    {
        a.Status = "ACTIVE";
        a.BirthdayCelebrated = true;
        a.RoleIds = [];
    }

    private Task SaveAsync((AccountDto Item, bool IsNew) e)
    {
        var body = new SaveAccountDto
        {
            LoginId = e.Item.LoginId,
            UserName = e.Item.UserName,
            Email = e.Item.Email,
            Phone = e.Item.Phone,
            Status = e.Item.Status,
            DeptId = e.Item.DeptId,
            RoleIds = e.Item.RoleIds,
            BirthDate = e.Item.BirthDate,
            BirthDateIsLunar = e.Item.BirthDateIsLunar,
            BirthdayCelebrated = e.Item.BirthdayCelebrated,
        };

        return e.IsNew
            ? Api.CreateAccountAsync(body)
            : Api.UpdateAccountAsync(e.Item.Id, body);
    }

    private Task DeleteAsync(AccountDto a) => Api.DeleteAccountAsync(a.Id);

    /// <summary>부서는 나무로 온다. 고르개에는 펴서 준다.</summary>
    private static List<DeptDto> Flatten(IEnumerable<DeptDto> nodes)
    {
        var flat = new List<DeptDto>();

        void Walk(IEnumerable<DeptDto> items)
        {
            foreach (var item in items)
            {
                flat.Add(item);

                if (item.Children is { Count: > 0 } children)
                {
                    Walk(children);
                }
            }
        }

        Walk(nodes);
        return flat;
    }

    private static string StatusText(string status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => "정상",
        "LOCKED" => "잠금",
        "RESIGNED" => "퇴사",
        "PENDING" => "승인 대기",
        _ => status ?? "-",
    };

    private static string StatusClass(string status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => "jsini-badge--on",
        "LOCKED" or "PENDING" => "jsini-badge--warn",
        _ => "jsini-badge--off",
    };
}
