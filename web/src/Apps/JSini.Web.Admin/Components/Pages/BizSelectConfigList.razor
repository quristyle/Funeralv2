@page "/admin/system/metadata"

@*
    [메타데이터 관리] — DB 메뉴 `/system/metadata_manager`.
    이력: Vue `views/portal/system/biz-select-config/list` → 여기.

    화면의 드롭다운이 **무엇을 어디서 읽을지** 정하는 표다. 코드를 고치지 않고
    드롭다운을 늘리려고 만든 자리라, 이 표가 곧 메타데이터다.

    `BizSelect` 부품이 `BizType` 으로 여기를 찾아 `ApiUrl` 을 부른다.

    [읽기만 하고 있었고, 정작 중요한 칸이 안 보였다]

    등록·수정·삭제가 없었다 — 「코드를 고치지 않고 늘리는」 것이 목적인 표인데
    화면에서 늘릴 수가 없었다.

    그리고 표에 네 칸만 보였다. **`labelField` · `valueField` · `resultPath` 가
    없으면 드롭다운이 빈 채로 뜬다** — 자료는 오는데 어느 칸을 보여 주고 어느
    칸을 값으로 쓸지 모르기 때문이다. 그 셋이 안 보이니 「왜 비어 있지」를
    이 화면에서 알 수 없었다.

    [주소는 서비스 안쪽 경로다]

    `serviceCode` 가 어느 MSA 로 갈지 정하고, `apiUrl` 은 그 서비스의 접두사를
    **뺀** 경로다(`/building/source/list?type=BACKGROUND`). 게이트웨이 접두사를
    함께 적으면 두 번 붙어 404 가 난다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>메타데이터 관리 · 포털관리</PageTitle>

<CommSch>
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" NullText="타입·주소 검색" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont>
    <CommGrd TItem="BizSelectConfigDto"
             Data="@Shown"
             EditFormTitle="메타데이터"
             ExportName="메타데이터"
             PageSize="20"
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(BizSelectConfigDto.BizType)" Caption="타입" Width="170" />
            <DxGridDataColumn FieldName="@nameof(BizSelectConfigDto.ServiceCode)" Caption="서비스" Width="100" />
            <DxGridDataColumn FieldName="@nameof(BizSelectConfigDto.HttpMethod)" Caption="방식" Width="80" />
            <DxGridDataColumn FieldName="@nameof(BizSelectConfigDto.ApiUrl)" Caption="주소" MinWidth="260" />

            <DxGridDataColumn Caption="이름/값 칸" Width="170">
                <CellDisplayTemplate Context="cell">
                    @{
                        var c = (BizSelectConfigDto)cell.DataItem;
                    }
                    @* 이 둘이 비면 드롭다운이 빈 채로 뜬다. 표에서 바로 보이게 한다. *@
                    @if (string.IsNullOrWhiteSpace(c.LabelField) || string.IsNullOrWhiteSpace(c.ValueField))
                    {
                        <span class="jsini-badge jsini-badge--off">비어 있음</span>
                    }
                    else
                    {
                        <span class="ad-code">@c.LabelField / @c.ValueField</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(BizSelectConfigDto.Remark)" Caption="설명" MinWidth="200" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var c = (BizSelectConfigDto)edit.EditModel;
            }
            <DxFormLayout CssClass="ad-editform">
                <DxFormLayoutItem Caption="타입" ColSpanMd="6">
                    @* 화면이 이 이름으로 찾는다. 바꾸면 그 이름을 쓰던 드롭다운이
                       조용히 빈다 — 화면 쪽 코드가 이 값을 글자로 들고 있어서다. *@
                    <DxTextBox @bind-Text="c.BizType" NullText="portal_account" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="서비스" ColSpanMd="3">
                    <DxComboBox Data="@Services" @bind-Value="c.ServiceCode" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="방식" ColSpanMd="3">
                    <DxComboBox Data="@Methods" @bind-Value="c.HttpMethod" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="주소" ColSpanMd="12">
                    <DxTextBox @bind-Text="c.ApiUrl" NullText="/building/source/list?type=BACKGROUND" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이름 칸" ColSpanMd="4">
                    @* 사람에게 보여 줄 칸. 비면 드롭다운이 빈 줄로 뜬다. *@
                    <DxTextBox @bind-Text="c.LabelField" NullText="name" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="값 칸" ColSpanMd="4">
                    @* 저장될 값. 비면 고를 수는 있는데 아무것도 안 담긴다. *@
                    <DxTextBox @bind-Text="c.ValueField" NullText="id" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="결과 경로" ColSpanMd="4">
                    @* 응답에서 목록이 들어 있는 자리. funeralv2 봉투는 `result` 다. *@
                    <DxTextBox @bind-Text="c.ResultPath" NullText="result" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="고정 파라미터" ColSpanMd="6">
                    @* 늘 함께 보내는 값. JSON 객체 글자다. *@
                    <DxTextBox @bind-Text="c.StaticParams" NullText='{"status": 1}' />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="파라미터 경로" ColSpanMd="6">
                    @* 화면이 넘긴 값을 본문 어디에 넣을지. 점 표기다. *@
                    <DxTextBox @bind-Text="c.ParamPath" NullText="params.filter" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="처리기" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.ProcessorType" NullText="특별한 가공이 필요할 때만" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                    <DxTextBox @bind-Text="c.Remark" NullText="어느 화면의 무슨 드롭다운인가" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    private IReadOnlyList<BizSelectConfigDto> _all = [];
    private string? _keyword;

    private static readonly string[] Services = ["auth", "funeral", "helpdesk", "projmng", "file", "ai"];
    private static readonly string[] Methods = ["GET", "POST"];

    private IReadOnlyList<BizSelectConfigDto> Shown
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_keyword))
            {
                return _all;
            }

            var k = _keyword.Trim();
            return [.. _all.Where(c =>
                c.BizType.Contains(k, StringComparison.OrdinalIgnoreCase)
                || c.ApiUrl.Contains(k, StringComparison.OrdinalIgnoreCase)
                || (c.Remark?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false))];
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetBizSelectConfigsAsync();
        return _all.Count;
    }, "등록된 메타데이터가 없습니다.", "메타데이터를 읽지 못했습니다");

    private static void FillNew(BizSelectConfigDto c)
    {
        c.ServiceCode = "auth";
        c.HttpMethod = "GET";

        // 대부분이 이 셋이다. 비워 두면 드롭다운이 빈 채로 뜨는데, 그 원인이
        // 화면에서 잘 안 보여서 기본값을 넣어 둔다.
        c.LabelField = "name";
        c.ValueField = "id";
        c.ResultPath = "result";
    }

    private Task SaveAsync((BizSelectConfigDto Item, bool IsNew) e)
    {
        if (string.IsNullOrWhiteSpace(e.Item.BizType) || string.IsNullOrWhiteSpace(e.Item.ApiUrl))
        {
            throw new ApiException("타입과 주소는 반드시 넣어야 합니다.");
        }

        if (string.IsNullOrWhiteSpace(e.Item.LabelField) || string.IsNullOrWhiteSpace(e.Item.ValueField))
        {
            throw new ApiException("이름 칸과 값 칸이 없으면 드롭다운이 빈 채로 뜹니다.");
        }

        return e.IsNew
            ? Api.CreateBizSelectConfigAsync(e.Item)
            : Api.UpdateBizSelectConfigAsync(e.Item.Id, e.Item);
    }

    private Task DeleteAsync(BizSelectConfigDto c) => Api.DeleteBizSelectConfigAsync(c.Id);
}
