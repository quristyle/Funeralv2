@page "/admin/location/map"
@attribute [RouteKey("admin.location.map")]

@*
    [위치 지도] — 알림관리 › 위치 지도.

    **위치를 허용한 계정을 한 장에 찍고, 그 자리에서 쪽지를 보낸다.**

    ────────────────────────────────────────────────────────────
    [좌표를 새로 받지 않는다]

    점의 출처는 「내 위치 날씨」가 받아 둔 좌표 하나다
    (`scom.notification_preferences.weather_lat`). 사람이 포털에서 위치를
    허용하면 그때 저장되고, 포털을 열 때마다 조용히 다시 확인된다
    (`GeoLocator`). 이 화면은 그것을 **읽기만** 한다 — 자리를 적는 칸이
    둘이 되면 한쪽만 갱신되는 날이 반드시 오고, 그때 어느 쪽이 맞는지
    아무도 말할 수 없다.

    그래서 목록에 없는 사람은 **위치를 허용하지 않은 사람**이다. 「그 사람이
    어디 있는지 왜 안 보이나」의 답은 언제나 그것 하나라, 화면이 그 수를
    세어 위에 적어 둔다.

    ────────────────────────────────────────────────────────────
    [점을 누르면 그 자리에서 쪽지다]

    지도를 보는 까닭이 대개 「저 사람에게 지금 연락해야 한다」라서, 점을
    누른 뒤 쪽지 화면으로 **옮기지 않는다** — 옮기면 누구를 보다가 눌렀는지가
    사라지고 받는 사람을 손으로 다시 적게 된다. 창이 그 자리에서 뜨고
    받는 사람은 이미 들어가 있다(`NoteWritePopup.DefaultTo`).

    ────────────────────────────────────────────────────────────
    [쪽지가 안 닿는 사람을 지우지 않는다]

    앱 푸시도 쪽지 메일도 닿지 않는 사람이 있다(기기를 등록한 적이 없고
    메일받기도 안 켰다). 쪽지 찾기 목록은 그런 사람을 **빼고** 보여 주지만
    (`NoteRecipientResolver.SearchAsync`), 지도는 다르다 — 여기서 묻는 것은
    「누가 어디 있나」이고 그 답은 쪽지와 무관하다. 대신 점을 흐리게 두고
    쪽지 단추를 잠근다. 빼 버리면 **지도에서 사람이 사라진 까닭**을 화면
    어디에서도 알 수 없다.

    ────────────────────────────────────────────────────────────
    [남의 자리를 보는 화면이다]

    메뉴 권한을 시스템관리자·관리자에게만 준다(`role_menus`). 협력사 역할에는
    주지 않는다 — 쪽지는 누구나 쓰지만, 직원 전체가 어디 있는지는 다른 이야기다.
*@

@inherits DataPage
@implements IAsyncDisposable
@inject AdminClient Api
@inject IJSRuntime Js

<PageTitle>위치 지도 · 포털관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            @* 서버로 보내지 않는다. 받아 둔 것에서 거르므로 치는 즉시 점이
               줄어든다 — 위치를 허용한 사람은 많아야 직원 수다. *@
            <DxTextBox Text="@_keyword"
                       TextChanged="@((string v) => Filter(v))"
                       BindValueMode="BindValueMode.OnInput"
                       ValidationEnabled="false"
                       Style="width: 200px" />
        </CommSchItem>

        <CommSchItem>
            <DxCheckBox Checked="@_reachableOnly"
                        CheckedChanged="@((bool on) => { _reachableOnly = on; Refresh(false); })">
                쪽지가 닿는 사람만
            </DxCheckBox>
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="전체 보기" RenderStyle="ButtonRenderStyle.Secondary"
                  Title="찍힌 점이 모두 들어오게 맞춘다"
                  Click="@FitAsync" />

        @* **목록 전체에게 한 통.** 서른 명까지다 — 서버가 한 번에 푸는 받는
           사람 수가 거기까지고(`NoteRecipientResolver.MaxRecipients`), 넘으면
           앞에서 잘려 **뒤쪽 사람만 조용히 못 받는다.** 그 수를 넘었으면
           단추를 잠그고 까닭을 적어 둔다. *@
        <DxButton Text="@($"목록 전체에게 쪽지 ({Reachable.Count})")"
                  RenderStyle="ButtonRenderStyle.Primary"
                  IconCssClass="jsini-icon-mail"
                  Enabled="@(Reachable.Count is > 0 and <= MaxBulk)"
                  Title="@BulkTitle"
                  Click="@(() => OpenWrite([.. Reachable.Select(p => p.LoginId)]))" />
    </Actions>
</CommSch>

<div class="ad-split">

    @* ── 왼쪽: 누가 허용했나 ──────────────────────────────── *@
    <CommCont CssClass="ad-split__side" Title="위치를 허용한 계정">
        <CommGrd TItem="AccountLocationDto"
                 Data="@Shown"
                 PageSize="20"
                 EmptyText="위치를 허용한 계정이 없습니다."
                 ExportName="위치 허용 계정"
                 SelectedItem="@_picked"
                 SelectedItemChanged="@PickAsync"
                 AutoSelectFirstRow="false"
                 Reload="@ReloadAsync">
            <Columns>
                <DxGridDataColumn Caption="사람" MinWidth="130"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{ var row = (AccountLocationDto)cell.DataItem; }
                        <span class="@(row.CanReceive ? null : "ad-geomap__off")">@Who(row)</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                @* 어디에 있나. 지역 이름이 비는 줄이 흔해서 그때는 좌표를 적는다 —
                   빈 칸으로 두면 「자리를 모르는 사람」으로 읽힌다. *@
                <DxGridDataColumn Caption="자리" MinWidth="120"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @Where((AccountLocationDto)cell.DataItem)
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                @* 얼마나 묵었나. 「잡은 때」와 「확인한 때」 중 나중 것이다
                   (`AccountLocationDto.LastKnownAt`). *@
                <DxGridDataColumn Caption="확인" Width="90">
                    <CellDisplayTemplate Context="cell">
                        @Fresh((AccountLocationDto)cell.DataItem)
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>

            <RowActions Context="row">
                <DxButton Text="쪽지" RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="jsini-icon-mail"
                          Enabled="@row.CanReceive"
                          Title="@ReachTitle(row)"
                          Click="@(() => OpenWrite([row.LoginId]))" />
            </RowActions>
        </CommGrd>
    </CommCont>

    @* ── 오른쪽: 지도 ──────────────────────────────────────── *@
    <CommCont CssClass="ad-split__main">

        <div class="ad-geomap">
            @* 타일과 점은 JS 가 붙인다. 여기는 빈 상자다 — 회로로 그리면
               끌 때마다 서버를 왕복한다(`wwwroot/js/geo-map.js` 머리말). *@
            <div class="ad-geomap__stage" @ref="_stage"></div>

            <div class="ad-geomap__zoom">
                <DxButton Text="+" RenderStyle="ButtonRenderStyle.Secondary"
                          Title="확대" Click="@(() => ZoomAsync(1))" />
                <DxButton Text="−" RenderStyle="ButtonRenderStyle.Secondary"
                          Title="축소" Click="@(() => ZoomAsync(-1))" />
            </div>

            @* 타일을 내주는 쪽이 요구하는 표시다. 지도 위에 얹어 자리를 안 먹는다. *@
            <div class="ad-geomap__credit">
                <a href="https://www.openstreetmap.org/copyright"
                   target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
            </div>

            @* 고른 사람. **지도 위에 얹는다** — 아래에 두면 점을 누를 때마다
               눈이 지도 밖으로 내려갔다 올라온다. *@
            @if (_picked is { } who)
            {
                <div class="ad-geomap__card">
                    <div class="ad-geomap__who">@Who(who)</div>

                    <dl class="ad-geomap__facts">
                        <dt>자리</dt>
                        <dd>@Where(who)</dd>
                        <dt>확인</dt>
                        <dd>@When(who)</dd>
                    </dl>

                    <div class="ad-geomap__acts">
                        <DxButton Text="쪽지 보내기" RenderStyle="ButtonRenderStyle.Primary"
                                  IconCssClass="jsini-icon-mail"
                                  Enabled="@who.CanReceive"
                                  Title="@ReachTitle(who)"
                                  Click="@(() => OpenWrite([who.LoginId]))" />

                        @* 큰 지도는 새 창이다. 판 안에서 길을 찾다가 포털
                           화면을 잃지 않도록 — 설정 화면의 지도와 같다. *@
                        <a class="ad-geomap__out" href="@BigMapUrl(who)"
                           target="_blank" rel="noopener noreferrer">큰 지도</a>
                    </div>

                    @if (!who.CanReceive)
                    {
                        @* 화면 어디에도 없는 주의라 남긴다 — 단추가 잠긴
                           까닭이 「권한이 없다」로 읽히면 엉뚱한 곳을 고치게 된다. *@
                        <p class="jsini-hint">앱 푸시도 쪽지 메일도 닿지 않아 쪽지가 도착하지 않습니다.</p>
                    }
                </div>
            }
        </div>

    </CommCont>
</div>

@* ── 쓰는 창 ─────────────────────────────────────────────── *@
@*
   **창을 통째로 새로 만든다.** 판은 받는 사람을 처음 만들어질 때 한 번만
   읽으므로(`NoteWritePanel.OnInitialized`), 창을 하나 두고 상대만 바꿔 열면
   두 번째부터 옛 사람이 그대로 남는다 — 쪽지함 화면과 같은 자리다.
*@
@if (_writing)
{
    <NoteWritePopup Visible="true"
                    DefaultTo="@_writeTo"
                    VisibleChanged="@(v => { if (!v) _writing = false; })" />
}

@code {
    /// <summary>
    /// 「목록 전체에게」로 한 번에 보낼 수 있는 사람 수.
    /// </summary>
    /// <remarks>
    /// 서버가 한 번에 푸는 받는 사람 수와 같아야 한다
    /// (<c>NoteRecipientResolver.MaxRecipients</c>). 여기가 더 크면 <b>넘은
    /// 만큼이 앞에서 잘려</b> 뒤쪽 사람만 조용히 못 받는다 — 보낸 쪽은 전원에게
    /// 갔다고 믿는다.
    /// </remarks>
    private const int MaxBulk = 30;

    /// <summary>지도 판. JS 가 여기에 타일과 점을 붙인다.</summary>
    private ElementReference _stage;

    private IJSObjectReference? _module;
    private IJSObjectReference? _map;

    /// <summary>점을 눌렀을 때 JS 가 되부를 손잡이.</summary>
    private DotNetObjectReference<LocationMapPage>? _self;

    /// <summary>서버가 준 전부. 거르기는 이것에서 한다.</summary>
    private IReadOnlyList<AccountLocationDto> _all = [];

    private string _keyword = string.Empty;
    private bool _reachableOnly;

    /// <summary>지금 고른 사람. 지도의 점과 왼쪽 목록이 같은 값을 본다.</summary>
    private AccountLocationDto? _picked;

    private bool _writing;
    private IReadOnlyList<string>? _writeTo;

    /// <summary>
    /// 점을 다시 실어야 하나. <b>그린 뒤에 보낸다</b> — 조회가 끝나는 시점에는
    /// 아직 판이 없을 수 있다(첫 진입).
    /// </summary>
    private bool _dirty;

    /// <summary>다시 실을 때 「전체 보기」까지 할 것인가.</summary>
    private bool _refit;

    /// <summary>조건에 걸러진 사람들. 지도와 목록이 같은 것을 본다.</summary>
    private IReadOnlyList<AccountLocationDto> Shown
    {
        get
        {
            var q = _keyword.Trim();

            return [.. _all
                .Where(p => !_reachableOnly || p.CanReceive)
                .Where(p => q.Length == 0
                            || Contains(p.Name, q)
                            || Contains(p.LoginId, q)
                            || Contains(p.Affiliation, q)
                            || Contains(p.Place, q))];
        }
    }

    /// <summary>걸러진 사람 중 쪽지가 닿는 사람들. 「목록 전체에게」가 쓴다.</summary>
    private IReadOnlyList<AccountLocationDto> Reachable => [.. Shown.Where(p => p.CanReceive)];

    /// <summary>접힌 조회줄에 적을 지금 조건(<c>CommSch.MobileSummary</c>).</summary>
    private string ConditionSummary => SchSummary.Of(
        SchSummary.Or(_keyword.Trim()),
        SchSummary.On(_reachableOnly, "쪽지가 닿는 사람만"),
        $"{Shown.Count}명");

    /// <summary>「목록 전체에게」 단추의 도움말. 잠겼으면 까닭을 적는다.</summary>
    private string BulkTitle => Reachable.Count switch
    {
        0 => "쪽지가 닿는 사람이 목록에 없습니다.",
        > MaxBulk => $"한 번에 {MaxBulk}명까지 보냅니다. 조건으로 목록을 좁히십시오.",
        _ => "목록에 있는 사람 모두에게 같은 쪽지를 보냅니다.",
    };

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        _all = await Api.GetAccountLocationsAsync();

        // 사라진 사람을 고른 채로 두지 않는다 — 그 카드의 「쪽지 보내기」는
        // 이제 목록에 없는 사람에게 간다.
        if (_picked is { } prev && !_all.Any(p => p.LoginId == prev.LoginId))
        {
            _picked = null;
        }

        // 자료가 바뀐 때만 맞춘다. 거르기만 했을 때도 맞추면 손으로 옮겨 둔
        // 자리가 조건을 만질 때마다 되돌아간다.
        Refresh(true);

        return _all.Count;
    }, "위치를 허용한 계정이 없습니다.", "위치 목록을 읽지 못했습니다");

    /// <summary>검색어가 바뀌었다. 치는 즉시 점이 줄어든다.</summary>
    private void Filter(string value)
    {
        _keyword = value ?? string.Empty;
        Refresh(false);
    }

    /// <summary>점을 다시 실어 달라고 적어 둔다. 실제로 싣는 것은 그린 뒤다.</summary>
    private void Refresh(bool refit)
    {
        _dirty = true;
        _refit |= refit;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            // 회로가 붙기 전(프리렌더)에는 JS 를 부를 수 없다.
            if (!RendererInfo.IsInteractive) return;

            _self = DotNetObjectReference.Create(this);

            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/JSini.Web.Admin/js/geo-map.js");

            _map = await _module.InvokeAsync<IJSObjectReference>("create", _stage, _self);

            // 판이 방금 생겼다. 조회가 먼저 끝났으면 그 점들이 아직 안 실렸다.
            _dirty = true;
        }

        if (_dirty && _map is not null)
        {
            var refit = _refit;
            _dirty = false;
            _refit = false;

            await _map.InvokeVoidAsync("setMarkers", Shown.Select(Pin), refit);
        }
    }

    /// <summary>
    /// 지도에서 점을 눌렀다. <b>빈 곳을 누르면 <c>null</c> 이 온다</b> —
    /// 고른 것을 푸는 길이다.
    /// </summary>
    /// <remarks>
    /// JS 가 되부르는 자리라 <c>StateHasChanged</c> 를 직접 부른다. 회로가
    /// 일으킨 사건이 아니라서 Blazor 가 알아서 다시 그리지 않는다.
    /// </remarks>
    [JSInvokable]
    public void PickMarker(string? loginId)
    {
        _picked = loginId is { Length: > 0 }
            ? _all.FirstOrDefault(p => p.LoginId == loginId)
            : null;

        StateHasChanged();
    }

    /// <summary>
    /// 목록에서 골랐다. <b>지도도 그 자리로 옮긴다</b> — 목록에서 고른 사람이
    /// 화면 밖에 있으면 고른 것이 눈에 안 보인다.
    /// </summary>
    private async Task PickAsync(AccountLocationDto? row)
    {
        // **이미 고른 줄이면 아무것도 안 한다.** 표는 파라미터로 받은 선택을
        // 그대로 따르므로(`CommGrd.OnParametersSet`) 지도에서 고른 것이 표에
        // 되비치는데, 그때 이 자리가 또 불리면 **점을 누를 때마다 지도가
        // 15 단계로 당겨진다** — 전체를 보다가 한 명을 짚는 순간 나머지가
        // 화면 밖으로 나간다.
        if (ReferenceEquals(_picked, row)) return;

        _picked = row;

        if (_map is not null)
        {
            await _map.InvokeVoidAsync("focus", row?.LoginId);
        }
    }

    private async Task FitAsync()
    {
        if (_map is not null) await _map.InvokeVoidAsync("fit");
    }

    private async Task ZoomAsync(int step)
    {
        if (_map is not null) await _map.InvokeVoidAsync("zoomBy", step);
    }

    /// <summary>쓰는 창을 연다. 받는 사람은 이미 들어가 있다.</summary>
    private void OpenWrite(IReadOnlyList<string> to)
    {
        _writeTo = to;
        _writing = true;
    }

    /// <summary>지도에 넘길 점 하나. JS 는 이 네 칸만 본다.</summary>
    private object Pin(AccountLocationDto p) => new
    {
        key = p.LoginId,
        lat = p.Lat,
        lon = p.Lon,
        name = Who(p),

        // 쪽지가 안 닿는 사람은 흐리게. 빼지 않는 까닭은 화면 머리말에 있다.
        muted = !p.CanReceive,
    };

    /// <summary>사람을 가리키는 한 마디. 이름이 없으면 아이디를 쓴다.</summary>
    private static string Who(AccountLocationDto p) =>
        string.IsNullOrWhiteSpace(p.Name) ? p.LoginId : p.Name!;

    /// <summary>
    /// 어디에 있나. <b>지역 이름이 없으면 좌표를 적는다</b> — 빈 칸으로 두면
    /// 자리를 모르는 사람으로 읽힌다.
    /// </summary>
    private static string Where(AccountLocationDto p) =>
        string.IsNullOrWhiteSpace(p.Place)
            ? FormattableString.Invariant($"{p.Lat:0.####}, {p.Lon:0.####}")
            : p.Place!;

    /// <summary>자리를 마지막으로 확인한 때. 없으면 모른다고 적는다.</summary>
    private static string When(AccountLocationDto p) =>
        p.LastKnownAt is { } at
            ? at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "알 수 없음";

    /// <summary>
    /// 목록 칸에 적는 짧은 말 — <b>며칠 전인가</b>.
    /// </summary>
    /// <remarks>
    /// 좁은 칸이라 날짜를 다 적으면 잘린다. 그리고 여기서 사람이 묻는 것은
    /// 「언제였나」가 아니라 <b>「이 점을 믿어도 되나」</b>라, 날수가 답에 가깝다.
    /// 정확한 시각은 고른 카드가 적는다.
    /// </remarks>
    private static string Fresh(AccountLocationDto p)
    {
        if (p.LastKnownAt is not { } at) return "—";

        var days = (int)(DateTime.UtcNow - at).TotalDays;

        return days switch
        {
            <= 0 => "오늘",
            1 => "어제",
            < 30 => $"{days}일 전",
            _ => at.ToLocalTime().ToString("yyyy-MM"),
        };
    }

    /// <summary>쪽지 단추의 도움말. 잠겼으면 까닭을 적는다.</summary>
    private static string ReachTitle(AccountLocationDto p) => p.CanReceive
        ? $"{Who(p)} 에게 쪽지를 보냅니다."
        : "앱 푸시도 쪽지 메일도 닿지 않아 쪽지가 도착하지 않습니다.";

    /// <summary>같은 자리를 OpenStreetMap 에서 여는 주소.</summary>
    private static string BigMapUrl(AccountLocationDto p) => FormattableString.Invariant(
        $"https://www.openstreetmap.org/?mlat={p.Lat:0.######}&mlon={p.Lon:0.######}#map=16/{p.Lat:0.######}/{p.Lon:0.######}");

    private static bool Contains(string? text, string needle) =>
        text is not null && text.Contains(needle, StringComparison.OrdinalIgnoreCase);

    public async ValueTask DisposeAsync()
    {
        // 회로가 이미 끊겼으면 JS 를 부를 수 없다. 화면을 옮기며 늘 지나는
        // 길이라 예외를 남기지 않는다 — 조직도와 같은 자리다.
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
