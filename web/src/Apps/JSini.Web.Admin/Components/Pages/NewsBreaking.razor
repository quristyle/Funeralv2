@page "/admin/news/breaking"
@attribute [RouteKey("admin.news.breaking")]
@inherits BasePage

<PageTitle>뉴스속보 목록</PageTitle>

<div class="h-full flex-col">
    <DxToolbar CssClass="p-2 border-b">
        <DxToolbarItem Text="새로고침" IconCssClass="jsini-mi mi-lucide-refresh-cw" Click="RefreshAsync" />
    </DxToolbar>

    <div class="flex-1 p-4 overflow-auto">
        @* 휴대폰에서는 카드로 편다 — `CommGrd` 와 같은 표시·같은 CSS 다
           (`GridCards` 머리말). 이 화면만 맨 `DxGrid` 를 쓰고 있어 표시를
           손으로 단다. *@
        <DxGrid Data="Data" ShowFilterRow="true" ShowSearchBox="true"
                CssClass="@GridCards.CssClass" CustomizeElement="@GridCards.Label">
            <Columns>
                <DxGridDataColumn FieldName="Id" Caption="ID" Width="80px" />
                <DxGridDataColumn FieldName="Title" Caption="제목" />
                <DxGridDataColumn FieldName="Category" Caption="카테고리" Width="100px" />
                <DxGridDataColumn FieldName="Urgency" Caption="긴급도" Width="100px" />
                <DxGridDataColumn FieldName="Source" Caption="출처" Width="120px" />
                <DxGridDataColumn FieldName="PublishedAt" Caption="발행일" Width="150px" DisplayFormat="yyyy-MM-dd HH:mm" />
                <DxGridDataColumn Caption="URL" Width="100px">
                    <CellDisplayTemplate>
                        <a href="@context.GetRowValue("Url")" target="_blank" class="link-quiet">보기</a>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </div>
</div>
