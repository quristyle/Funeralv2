@page "/admin/news/breaking"
@attribute [RouteKey("admin.news.breaking")]
@attribute [ScreenAccess("admin.notice")]

@*
    [뉴스속보 목록] DB 메뉴 `/admin/news/breaking`. 맨 DxGrid 에서 CommGrd 로 옮겼다 — 머리줄 건수 · 오른쪽 클릭 창(다시 읽기 · 칸별 검색 · 엑셀) · 휴대폰 카드가 공통 표에서 온다.
    새로고침 띠는 걷었다 — 다시 읽기는 Reload 로 오른쪽 클릭 창에 있다(web/CLAUDE.md).
*@

@inherits BasePage

<PageTitle>뉴스속보 목록</PageTitle>

<CommCont>
    @* 칸별 검색 줄을 켜 둔다 — 분류·긴급도·출처로 좁혀 보는 표라서, 훑는 검색칸도 함께 둔다. *@
    <CommGrd TItem="NewsItem" Data="@Data"
             ShowFilterRow="true" ShowSearchBox="true"
             ExportName="뉴스속보"
             Reload="@RefreshAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(NewsItem.Id)" Caption="ID" Width="80px" />
            <DxGridDataColumn FieldName="@nameof(NewsItem.Title)" Caption="제목" MinWidth="200" />
            <DxGridDataColumn FieldName="@nameof(NewsItem.Category)" Caption="카테고리" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(NewsItem.Urgency)" Caption="긴급도" Width="100px" />
            <DxGridDataColumn FieldName="@nameof(NewsItem.Source)" Caption="출처" Width="120px" />
            <DxGridDataColumn FieldName="@nameof(NewsItem.PublishedAt)" Caption="발행일" Width="150px"
                              DisplayFormat="yyyy-MM-dd HH:mm" />
            <DxGridDataColumn Caption="URL" Width="100px">
                <CellDisplayTemplate>
                    <a href="@context.GetRowValue(nameof(NewsItem.Url))" target="_blank" class="link-quiet">보기</a>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </CommGrd>
</CommCont>
