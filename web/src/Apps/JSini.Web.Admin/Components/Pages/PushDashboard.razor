@page "/admin/push/dashboard"
@attribute [RouteKey("admin.push.dashboard")]

@*
    [푸시 현황] DB 메뉴 `/system/push/dashboard`. 발송 건수 · 성공률 · 실패 사유를 한 화면에 모은다.
    위쪽(발송·성공·실패·추이·실패 사유)은 알림 서비스의 기록(scom.push_send_logs)이고, 아래쪽(도달·열람·사람별)은 아직 헬프데스크 것이다. 서비스워커의 되알림 길이 없어 섞으면 어느 숫자를 세는지 알 수 없어 갈라 적는다.
    추이는 DxChart 로, 성공률 축은 0~100 으로 고정한다 — 축이 값을 따라 늘면 나빠졌는지를 기울기로 읽을 수 없다. 표는 정확한 값을 위해 남긴다.
*@

@inherits DataPage

<PageTitle>푸시 현황</PageTitle>

@* 조건은 기간 하나뿐이지만 판을 세운다 — 화면 백 개가 같은 자리에 조건을 두고 있다. 자료 판(CommCont)은 쓰지 않는다 — 통계 타일과 표 넷이 쌓이는 대시보드라 감싸면 아래가 잘린다. *@
<CommSch OnSearch="@ReloadAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="기간">
            <DxComboBox Data="@DayOptions" @bind-Value="_days" Style="width: 130px">
                <ItemTemplate>최근 @context 일</ItemTemplate>
            </DxComboBox>
        </CommSchItem>
    </Fields>
</CommSch>

@if (_stats is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">발송</div>
            <div class="jsini-stat__value">@_stats.TotalSent</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">성공</div>
            <div class="jsini-stat__value">@_stats.SuccessCount</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">실패</div>
            <div class="jsini-stat__value">@_stats.FailureCount</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">성공률</div>
            <div class="jsini-stat__value">@_stats.SuccessRate.ToString("0.0")%</div>
        </div>

    </div>
}

<h2 class="ad-subhead">성공률 추이</h2>

@if (_trend.Count > 0)
{
    <div class="jsini-card">
        <DxChart Data="@_trend" Width="100%" Height="240px">
            <DxChartArgumentAxis>
                <DxChartAxisLabel DisplayMode="ChartAxisLabelDisplayMode.Standard"
                                  Overlap="ChartAxisLabelOverlap.Hide"
                                  RotationAngle="0" />
            </DxChartArgumentAxis>
            <DxChartLegend Visible="false" />
            <DxChartSplineSeries T="PushTrendPointDto" TArgument="string" TValue="double"
                               ArgumentField="p => p.Period"
                               ValueField="p => p.SuccessRate"
                               Name="성공률(%)">
                <DxChartSeriesPoint Visible="false" />
            </DxChartSplineSeries>
            <DxChartValueAxis>
                <DxChartAxisRange StartValue="@(0)" EndValue="@(100)" />
            </DxChartValueAxis>
            <DxChartTooltip Enabled="true">
                <div class="jsini-tip">
                    @context.Point.Argument —
                    성공률 @(context.Point.Value is double rate ? rate.ToString("0.0") : context.Point.Value)%
                </div>
            </DxChartTooltip>
        </DxChart>
    </div>
}

<CommGrd TItem="PushTrendPointDto" Data="@_trend">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushTrendPointDto.Period)" Caption="기간" Width="160" />
        <DxGridDataColumn FieldName="@nameof(PushTrendPointDto.Sent)" Caption="발송" Width="100" />
        <DxGridDataColumn FieldName="@nameof(PushTrendPointDto.Success)" Caption="성공" Width="100" />
        <DxGridDataColumn Caption="성공률" Width="110">
            <CellDisplayTemplate Context="cell">
                @(((PushTrendPointDto)cell.DataItem).SuccessRate.ToString("0.0"))%
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>

<h2 class="ad-subhead">실패 사유</h2>

@if (_reasons.Count > 0)
{
    <div class="jsini-card">
        <DxChart Data="@_reasons" Width="100%" Height="220px" Rotated="true">
            <DxChartLegend Visible="false" />
            <DxChartBarSeries T="PushFailureReasonDto" TArgument="string" TValue="int"
                              ArgumentField="r => r.Reason"
                              ValueField="r => r.Count"
                              Name="건수" />
            <DxChartTooltip Enabled="true">
                <div class="jsini-tip">@context.Point.Argument — @(context.Point.Value)건</div>
            </DxChartTooltip>
        </DxChart>
    </div>
}

<CommGrd TItem="PushFailureReasonDto" Data="@_reasons" PageSizeSelectorVisible="false">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushFailureReasonDto.Reason)" Caption="사유" MinWidth="260" />
        <DxGridDataColumn FieldName="@nameof(PushFailureReasonDto.Count)" Caption="건수" Width="110" />
    </Columns>
</CommGrd>

@* ── 도달·열람 ── 보낸 것과 읽힌 것은 다르다 — 성공률만 보면 아무도 안 읽는 알림을 계속 보내게 된다. 이 아래는 헬프데스크가 보낸 것만 센다. *@
<h2 class="ad-subhead">도달 · 열람</h2>

<PageNotice Tone="NoticeTone.Info"
            Text="아래 숫자는 헬프데스크가 보낸 알림만 셉니다. 포털에서 보낸 알림은 「받았다·눌렀다」를 되돌려 주는 길이 아직 없어 도달·열람이 잡히지 않습니다." />

@if (_engagement is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">도달</div>
            <div class="jsini-stat__value">@_engagement.TotalDelivered</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">열람</div>
            <div class="jsini-stat__value">@_engagement.TotalRead</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">열람률</div>
            <div class="jsini-stat__value">@_engagement.ReadRate.ToString("0.0")%</div>
        </div>
    </div>
}

@* 무엇이 읽히는가. 제목을 바꿔 볼 근거가 여기 있다. *@
<h2 class="ad-subhead">많이 읽힌 알림</h2>

<CommGrd TItem="PushMessageStatDto" Data="@_messages" PageSize="10">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushMessageStatDto.Title)" Caption="제목" MinWidth="240" />
        <DxGridDataColumn FieldName="@nameof(PushMessageStatDto.CreatedAt)" Caption="보낸 때" Width="150"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(PushMessageStatDto.RecipientCount)" Caption="대상" Width="90" />
        <DxGridDataColumn FieldName="@nameof(PushMessageStatDto.DeliveredCount)" Caption="도달" Width="90" />
        <DxGridDataColumn FieldName="@nameof(PushMessageStatDto.ReadCount)" Caption="열람" Width="90" />
        <DxGridDataColumn Caption="열람률" Width="100">
            <CellDisplayTemplate Context="cell">
                @(((PushMessageStatDto)cell.DataItem).ReadRate.ToString("0.0"))%
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>

@* 누구에게 닿지 않는가. 열람률이 0 인 사람은 구독이 끊겼을 수 있다. *@
<h2 class="ad-subhead">사람별 수신 · 열람</h2>

<CommGrd TItem="PushUserStatDto" Data="@_users" PageSize="10">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(PushUserStatDto.UserName)" Caption="사용자" MinWidth="180" />
        <DxGridDataColumn FieldName="@nameof(PushUserStatDto.UserType)" Caption="구분" Width="110" />
        <DxGridDataColumn FieldName="@nameof(PushUserStatDto.TotalReceived)" Caption="수신" Width="90" />
        <DxGridDataColumn FieldName="@nameof(PushUserStatDto.TotalRead)" Caption="열람" Width="90" />
        <DxGridDataColumn Caption="열람률" Width="100">
            <CellDisplayTemplate Context="cell">
                @(((PushUserStatDto)cell.DataItem).ReadRate.ToString("0.0"))%
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>
