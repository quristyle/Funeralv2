@page "/admin/status/ai-usage"
@attribute [RouteKey("admin.status.ai-usage")]

@*
    [AI 사용량] DB 메뉴 `/admin/status/ai-usage`. 상태관리 묶음에서 옆의 LLM 장비 상태와 나란히 읽는다 — 느리다는 말이 장비 탓인지 사람이 몰린 탓인지 가른다.
    사람을 아는 자리는 AIAgentServer 하나라 호출이 지나갈 때 scom.ai_usage_logs 에 적어 둔다 — LLM 장비를 켜기 전의 값은 없다.
    토큰 수를 안 준 호출은 0 으로 더하지 않는다 — 합계가 조용히 작아진다. 모르는 건수를 따로 세어 표시한다. 누가 많이 쓰는지는 표가, 왜 많은지는 호출 하나하나를 눌러 본다.
*@

@inherits DataPage

<PageTitle>AI 사용량</PageTitle>

<CommSch OnSearch="@ReloadAsync" OnReset="@Reset" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="기간">
            @* 기본은 최근 30일이다 — 요즘 누가 많이 쓰나를 보려고 여는 화면이라 처음부터 전부 더해 보이지 않는다. *@
            <div class="ad-checks">
                <DxDateEdit @bind-Date="_from" CssClass="ad-editform__date" />
                <span class="jsini-text-muted">~</span>
                <DxDateEdit @bind-Date="_to" CssClass="ad-editform__date" />
            </div>
        </CommSchItem>

        <CommSchItem Label="기능">
            <DxComboBox Data="@FeatureOptions" @bind-Value="_feature"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 160px"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>

        <CommSchItem Label="사용자">
            <DxTextBox @bind-Text="_keyword" Style="width: 180px"
                       BindValueMode="BindValueMode.OnInput" InputDelay="200"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 타일 넷. 표가 답하지 않는 「전체 얼마인가」만 올린다 — 사람 수가 같이 있어야 「열 명이 쓰는 백만 토큰」과 「한 명이 쓰는 백만 토큰」이 구분된다. *@
<div class="jsini-stats">
    <div class="jsini-stat">
        <div class="jsini-stat__label">호출</div>
        <div class="jsini-stat__value">@TotalCalls.ToString("N0")</div>
        <div class="jsini-hint">@PeriodText</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">토큰 합계</div>
        <div class="jsini-stat__value">@TotalTokens.ToString("N0")</div>
        @if (UnknownTokenCalls > 0)
        {
            @* 합계가 실제보다 작다는 뜻이다. 적지 않으면 그 사실이 어디에도 안 보인다. *@
            <div class="jsini-hint">@UnknownTokenCalls.ToString("N0")건은 토큰 수를 모른다</div>
        }
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">쓴 사람</div>
        <div class="jsini-stat__value">@PeopleCount.ToString("N0")</div>
    </div>
    <div class="jsini-stat">
        <div class="jsini-stat__label">실패</div>
        <div class="jsini-stat__value">@TotalFailed.ToString("N0")</div>
        @if (TotalFailed > 0)
        {
            <div class="jsini-hint">줄을 눌러 까닭을 본다</div>
        }
    </div>
</div>

<CommCont>
    <CommGrd TItem="AiUsageByUserDto"
             Data="@Shown"
             ExportName="AI 사용량"
             EmptyText="이 기간에 AI 를 쓴 기록이 없습니다."
             OnRowDoubleClick="@OpenDetail"
             SelectedItem="@_picked"
             SelectedItemChanged="@OnPicked"
             Reload="@ReloadAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(AiUsageByUserDto.Who)" Caption="사용자" MinWidth="180"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn FieldName="@nameof(AiUsageByUserDto.Calls)" Caption="호출" Width="90"
                              DisplayFormat="N0" />

            <DxGridDataColumn Caption="실패" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (AiUsageByUserDto)cell.DataItem;
                    }
                    @if (row.FailedCalls == 0)
                    {
                        <span class="jsini-text-muted">–</span>
                    }
                    else
                    {
                        @* 0 이 아니면 눈에 띄어야 한다 — 많이 쓰는데 자주 실패한다가 한도·장비 문제의 첫 신호다. *@
                        <span class="jsini-badge jsini-badge--warn">@row.FailedCalls.ToString("N0")</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AiUsageByUserDto.PromptTokens)" Caption="보낸 토큰" Width="110"
                              DisplayFormat="N0" />

            <DxGridDataColumn FieldName="@nameof(AiUsageByUserDto.CompletionTokens)" Caption="받은 토큰" Width="110"
                              DisplayFormat="N0" />

            <DxGridDataColumn Caption="토큰 합계" Width="130">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (AiUsageByUserDto)cell.DataItem;
                    }
                    <span>@row.TotalTokens.ToString("N0")</span>
                    @if (row.UnknownTokenCalls > 0)
                    {
                        @* 모르는 것과 0 을 가른다 — 칸이 좁아 말풍선에 까닭을 적는다. *@
                        <span class="jsini-text-muted"
                              title="@($"{row.UnknownTokenCalls:N0}건은 공급자가 토큰 수를 알려 주지 않아 이 합계에서 빠져 있습니다.")">
                            +?
                        </span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="평균 응답" Width="100">
                <CellDisplayTemplate Context="cell">
                    @{
                        var row = (AiUsageByUserDto)cell.DataItem;
                    }
                    @(row.AvgLatencyMs is { } ms ? $"{ms / 1000.0:0.0}초" : "-")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="마지막" Width="130">
                <CellDisplayTemplate Context="cell">
                    @* 서버가 주는 값은 UTC 다 — 한국 시각은 보여 주기 직전에 한 번만 만든다(docs/utc-time.md). *@
                    @(((AiUsageByUserDto)cell.DataItem).LastCallAt.Kst("MM-dd HH:mm"))
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>

        <ContextMenuItems>
            <CommMenuItem Text="최근 호출 보기" IconCssClass="jsini-icon-eye"
                          Enabled="@(_picked is not null)"
                          Click="@(() => OpenDetail(_picked!))" />
        </ContextMenuItems>
    </CommGrd>
</CommCont>
