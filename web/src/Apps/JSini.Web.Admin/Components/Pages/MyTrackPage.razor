@page "/admin/location/my-track"
@attribute [RouteKey("admin.location.my-track")]

@*
    [내 이동경로] 내가 하루 동안 어디에 얼마나 있었나를 지도 한 장과 목록으로 본다. 남의 자리는 「위치 지도」가 본다 — 이쪽은 내 자리의 역사라 남의 것을 물을 길이 없다(주소에 /me 가 박혀 있다).
    기록은 포털이 열려 있는 동안 30분마다 쌓인다. 웹은 탭이 닫힌 뒤 위치를 못 읽어 포털을 안 연 날은 빈다 — 그래서 「기록이 있는 날」 고르개가 있다.
    머문 자리는 저장된 것이 아니라 서버가 200m 안의 점을 묶어 셈한 값이다. 머문 시간은 모자라는 쪽으로 틀린다(잰 것은 30분 표본뿐) — 관측 수를 함께 적는다.
*@

@inherits DataPage
@implements IAsyncDisposable

<PageTitle>내 이동경로</PageTitle>

@* 날짜와 기록일 선택 및 이동, 위치 기록은 화면의 주 조작이므로 모바일에서도 접지 않는다. *@
<CommSch CssClass="ad-track__sch" OnSearch="@ReloadAsync" Busy="@Loading" ReloadIcon="true" Foldable="false">
    <Fields>
        <CommSchItem>
            @* 한국 달력 날짜다 — UTC 자정으로 끊으면 한국의 하루가 아침 아홉 시에 갈린다. *@
            <DxDateEdit Date="@_date" DateChanged="@((DateTime? d) => PickDateAsync(d))"
                        CssClass="jsini-dateedit--click-open"
                        Title="날짜"
                        aria-label="날짜"
                        Style="width: 140px" />
        </CommSchItem>

        <CommSchItem>
            @* 빈 날을 피하게 해 주는 고르개다 — 포털을 안 연 날은 기록이 없어 빈 날이 드물지 않다. *@
            <DxComboBox Data="@_days" Style="width: 180px"
                        NullText="@(_days.Count == 0 ? "최근 기록이 없습니다" : "기록이 있는 날")"
                        Title="기록이 있는 날"
                        aria-label="기록이 있는 날"
                        Value="@CurrentDay"
                        ValueChanged="@((LocationTrackDayDto? d) => PickDayAsync(d))"
                        ValueExpression="@(() => CurrentDay)"
                        TextFieldName="@nameof(LocationTrackDayDto.Label)" />
        </CommSchItem>

        <CommSchItem>
            @* 묶음을 의심할 수 있어야 한다 — 목록만 갈아 끼우고 지도는 그대로 둔다. 지도가 함께 바뀌면 보고 있던 자리를 잃는다. *@
            <DxCheckBox Checked="@_raw"
                        CheckedChanged="@((bool on) => { _raw = on; })"
                        Title="원시 기록으로 보기"
                        aria-label="원시 기록으로 보기">
                원시 기록으로 보기
            </DxCheckBox>
        </CommSchItem>
    </Fields>

    <Actions>
        @* 「어제」가 아니라 「이전」이다 — 하루씩 옮기는 단추라 사흘 전을 보는 중에 「어제」가 적혀 있으면 어제로 읽힌다. *@
        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="jsini-icon-chevron-left"
                  Title="하루 앞으로 갑니다."
                  aria-label="이전"
                  Click="@(() => ShiftAsync(-1))" />

        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="jsini-icon-chevron-right"
                  Title="하루 뒤로 갑니다."
                  aria-label="다음"
                  Enabled="@(_date < AppTime.TodayDate)"
                  Click="@(() => ShiftAsync(1))" />

        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="jsini-icon-calendar"
                  Title="오늘 날짜로 갑니다."
                  aria-label="오늘"
                  Enabled="@(_date != AppTime.TodayDate)"
                  Click="@(() => PickDateAsync(AppTime.TodayDate))" />

        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="jsini-icon-expand"
                  Title="그날 지나온 자리가 모두 들어오게 맞춥니다."
                  aria-label="전체 보기"
                  Click="@FitAsync" />

        @* 지금 있는 자리를 한 점 보탠다 — 30분 주기를 기다리지 않고 도착한 즉시 찍는다. *@
        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                  IconCssClass="jsini-icon-pin"
                  Title="지금 위치를 측정하여 오늘 이동 경로에 기록합니다."
                  aria-label="지금위치 기록"
                  Enabled="@(!_recording && !Loading)"
                  Click="@RecordLocationAsync" />
    </Actions>
</CommSch>

@* ── 하루 요약 ── 지도와 목록보다 먼저 온다. 그날 많이 돌아다녔나의 답은 점을 세는 것이 아니라 머문 자리들의 직선 거리 합이다. *@
<dl class="jsini-facts ad-track__sum">
    <div class="jsini-fact">
        <dt>머문 곳</dt>
        <dd>@Stays.Count 곳</dd>
    </div>

    <div class="jsini-fact">
        <dt>이동 거리</dt>
        @* 직선 거리의 합이다 — 두 자리 사이를 어떻게 갔는지는 30분 표본으로 알 수 없어 「직선」을 이름에 적는다. *@
        <dd title="머문 자리를 직선으로 이은 길이입니다. 실제 주행 거리가 아닙니다.">
            @DistanceText(_track?.TotalMeters ?? 0) <span class="jsini-text-muted">(직선)</span>
        </dd>
    </div>

    <div class="jsini-fact">
        <dt>가장 오래 머문 시간</dt>
        <dd>@MinutesText(_track?.LongestMinutes ?? 0)</dd>
    </div>

    <div class="jsini-fact">
        <dt>관측</dt>
        @* 묶는 자를 여기 적는다. 「왜 여기와 저기가 한 자리인가」의 답이다. *@
        <dd>
            @Points.Count 회
            <span class="jsini-text-muted">· @StayRadiusText 안을 한 자리로</span>
        </dd>
    </div>
</dl>

@if (!Loading && Points.Count == 0)
{
    @* 빈 날을 고장으로 읽지 않게 한다 — 까닭은 둘뿐이고 어디에도 안 적히면 사람은 기능이 깨진 것으로 본다. *@
    <PageNotice Tone="NoticeTone.Info"
                Text="그날 쌓인 기록이 없습니다. 기록은 포털을 열어 둔 동안에만 쌓이고, 브라우저에서 위치를 허용하지 않으면 한 줄도 쌓이지 않습니다 — 환경설정의 「내 위치 잡기」에서 확인하십시오." />
}

@* 휴대폰에서는 판을 하나씩 세운다 — 마크업을 갈아 끼우지 않고 클래스만 붙인다. 지도 판의 @ref 가 빠지면 손잡이가 죽은 DOM 을 가리킨다. *@
<DxLayoutBreakpoint MaxWidth="767" IsActive="_isPhone"
                    IsActiveChanged="@OnPhoneChanged" />

@if (_isPhone)
{
    <div class="ad-geoview" role="tablist" aria-label="보기">
        <button type="button" role="tab"
                class="ad-geoview__btn @(_view == PhoneView.Map ? "ad-geoview__btn--on" : null)"
                aria-selected="@((_view == PhoneView.Map).ToString().ToLowerInvariant())"
                @onclick="@(() => SetView(PhoneView.Map))">
            <i class="jsini-icon-pin"></i> 지도
        </button>

        <button type="button" role="tab"
                class="ad-geoview__btn @(_view == PhoneView.List ? "ad-geoview__btn--on" : null)"
                aria-selected="@((_view == PhoneView.List).ToString().ToLowerInvariant())"
                @onclick="@(() => SetView(PhoneView.List))">
            <i class="jsini-icon-menu"></i> 목록 @(_raw ? Points.Count : Stays.Count)
        </button>
    </div>
}

<div class="ad-split ad-split--track @PhoneCss">

    @* ── 왼쪽: 목록 ───────────────────────────────────────── *@
    <CommCont CssClass="ad-split__side" Title="@(_isPhone ? null : ListTitle)">

        @if (_raw)
        {
            <CommGrd TItem="LocationTrackPointDto"
                     Data="@Points"
                     EmptyText="그날 쌓인 기록이 없습니다."
                     ExportName="@($"이동기록 {DateKey}")"
                     Reload="@ReloadAsync">
                <Columns>
                    <DxGridDataColumn Caption="시각" Width="80">
                        <CellDisplayTemplate Context="cell">
                            @(((LocationTrackPointDto)cell.DataItem).RecordedAt.Kst("HH:mm:ss"))
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="자리" MinWidth="140"
                                      TextAlignment="GridTextAlignment.Left">
                        <CellDisplayTemplate Context="cell">
                            @{ var p = (LocationTrackPointDto)cell.DataItem; }
                            @(string.IsNullOrWhiteSpace(p.Place) ? Coord(p.Lat, p.Lon) : p.Place!)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 믿을 수 없는 점을 가려내는 단서다 — 실내에서 받은 좌표는 오차가 천 미터를 넘기도 한다. *@
                    <DxGridDataColumn Caption="오차" Width="70">
                        <CellDisplayTemplate Context="cell">
                            @AccuracyText((LocationTrackPointDto)cell.DataItem)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </CommGrd>
        }
        else
        {
            <CommGrd TItem="LocationStayDto"
                     Data="@Stays"
                     EmptyText="그날 머문 자리가 없습니다."
                     ExportName="@($"이동경로 {DateKey}")"
                     SelectedItem="@_picked"
                     SelectedItemChanged="@PickAsync"
                     AutoSelectFirstRow="false"
                     Reload="@ReloadAsync">
                <Columns>
                    @* 지도의 점에 적힌 번호와 같은 값이다 — 둘을 잇는 유일한 끈이라 맨 앞에 둔다. *@
                    <DxGridDataColumn Caption="#" Width="40">
                        <CellDisplayTemplate Context="cell">
                            @(((LocationStayDto)cell.DataItem).Seq)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="머문 곳" MinWidth="110"
                                      TextAlignment="GridTextAlignment.Left">
                        <CellDisplayTemplate Context="cell">
                            @Where((LocationStayDto)cell.DataItem)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 머문시간이 시간대보다 앞이다 — 이 화면을 여는 까닭이 그 값이라, 뒤에 두면 판이 좁아질 때 제일 먼저 잘린다. *@
                    <DxGridDataColumn Caption="머문시간" Width="96">
                        <CellDisplayTemplate Context="cell">
                            @{ var s = (LocationStayDto)cell.DataItem; }
                            <span title="@DwellTitle(s)">@MinutesText(s.Minutes)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 도착·떠남을 한 칸에 담는다 — 칸을 둘로 나누면 좁은 판에서 둘 다 줄바꿈된다. *@
                    <DxGridDataColumn Caption="시간대" Width="120">
                        <CellDisplayTemplate Context="cell">
                            @Span((LocationStayDto)cell.DataItem)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>

                @* 글자 없이 그림만 — 좁은 판에서 「지도」 두 글자가 칸을 먹는데, 이 단추의 몫은 이미 고른 자리로 돌아오는 것 하나다. *@
                <RowActions Context="row">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              IconCssClass="jsini-icon-pin"
                              Title="지도에서 그 자리로 갑니다."
                              Click="@(() => ShowOnMapAsync(row))" />
                </RowActions>
            </CommGrd>
        }

    </CommCont>

    @* ── 오른쪽: 지도 ─────────────────────────────────────── *@
    <CommCont CssClass="ad-split__main">

        <div class="ad-geomap">
            @* 타일 · 선 · 점은 JS 가 붙인다 — 회로로 그리면 끌 때마다 서버를 왕복한다. *@
            <div class="ad-geomap__stage" @ref="_stage"></div>

            <div class="ad-geomap__zoom">
                <DxButton Text="+" RenderStyle="ButtonRenderStyle.Secondary"
                          Title="확대" Click="@(() => ZoomAsync(1))" />
                <DxButton Text="−" RenderStyle="ButtonRenderStyle.Secondary"
                          Title="축소" Click="@(() => ZoomAsync(-1))" />
            </div>

            @* 타일을 내주는 쪽이 요구하는 표시다. 지도 위에 얹어 자리를 안 먹는다. *@
            <div class="ad-geomap__credit">
                <a href="https://www.openstreetmap.org/copyright"
                   target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
            </div>

            @* 고른 자리는 지도 위에 얹는다 — 아래에 두면 점을 누를 때마다 눈이 지도 밖으로 내려갔다 올라온다. *@
            @if (_picked is { } stay)
            {
                <div class="ad-geomap__card">
                    @if (_isPhone)
                    {
                        <button type="button" class="ad-geomap__close"
                                aria-label="닫기" title="고른 것을 풉니다."
                                @onclick="@(() => PickAsync(null))">
                            <i class="jsini-icon-close"></i>
                        </button>
                    }

                    <div class="ad-geomap__who">@stay.Seq. @Where(stay)</div>

                    <dl class="ad-geomap__facts">
                        <dt>시간대</dt>
                        <dd>@Span(stay)</dd>
                        <dt>머문시간</dt>
                        <dd>@MinutesText(stay.Minutes) <span class="jsini-text-muted">· 관측 @stay.Samples 회</span></dd>
                        <dt>앞 자리에서</dt>
                        <dd>@(stay.Seq == 1 ? "출발" : $"{DistanceText(stay.MovedMeters)} (직선)")</dd>
                    </dl>

                    <div class="ad-geomap__acts">
                        @* 큰 지도는 새 창이다 — 판 안에서 길을 찾다가 포털 화면을 잃지 않도록. *@
                        <a class="ad-geomap__out" href="@BigMapUrl(stay)"
                           target="_blank" rel="noopener noreferrer">큰 지도</a>
                    </div>
                </div>
            }
        </div>

    </CommCont>
</div>
