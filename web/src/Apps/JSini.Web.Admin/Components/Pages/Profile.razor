@page "/admin/profile"

@*
    [내 정보] — DB 메뉴 `/profile`.
    이력: Vue `views/portal/_core/profile/index` → 여기.

    로그인한 사람의 정보와 최근 활동을 본다.

    [읽기만 하고 있었다]

    이름·연락처·이메일·생일을 바꿀 길이 없었다. 서버에는
    `POST auth/user/profile` 이 있고 클라이언트에만 빠져 있었다.

    [생일은 다른 화면이 읽는다]

    생활과환경의 「생일 목록」이 이 값을 본다. 여기서 비워 두면 그 목록에
    나오지 않는다 — 개인이 직접 정하는 것이 맞아서 그렇게 두었다.

    [비밀번호 변경 — 「회로 안에서 못 한다」는 잘못된 판단이었다]

    한동안 이 자리에 「쿠키를 다시 굽는 흐름이라 회로 안에서 처리할 수 없다」고
    적어 두고 폼을 만들지 않았다. **서버를 읽어 보면 그렇지 않다** —
    `POST auth/user/change-password` 는 비밀번호 해시와 만료 시계만 고치고
    새 토큰을 주지 않는다. 로그인 상태는 그대로다.

    그래서 회로 안에서 그대로 부른다. 90일 만료로 어쩔 수 없이 이 화면에 오는
    사람이 있는데, 그동안 바꿀 길이 없었다.

    실패 이유는 서버가 구분해 준다(이전 비밀번호 불일치 · 지금 것과 같음 · 빈 값).
    뭉뚱그린 문구를 주면 무엇을 고쳐야 할지 알 수 없어서 그렇게 만들어 두었다 —
    화면이 그 문구를 그대로 보여 준다.
*@

@inherits DataPage
@inject AdminClient Api

<PageTitle>내 정보 · 포털관리</PageTitle>

<PageNotice Text="@Notice" Tone="@Tone" />

@if (_info is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">아이디</div>
            <div class="jsini-stat__value ad-stat--text">@(_info.Username ?? _info.UserId ?? "-")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">회사</div>
            <div class="jsini-stat__value ad-stat--text">@(_info.CompanyName ?? "-")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">부서</div>
            <div class="jsini-stat__value ad-stat--text">@(_info.DeptName ?? "-")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">마지막 접속</div>
            <div class="jsini-stat__value ad-stat--text">
                @(_info.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
            </div>
        </div>
    </div>

    @if (_info.RoleNames.Count > 0)
    {
        @* 역할은 여기서 못 바꾼다. 회사·부서에서 물려받는 것이 섞여 있어
           개인이 정할 수 있는 값이 아니다 — 바꾸는 곳은 「사람롤」이다. *@
        <PageNotice Text="@($"역할: {string.Join(", ", _info.RoleNames)}")" />
    }

    <h2 class="ad-subhead">고치기</h2>

    <DxFormLayout CssClass="ad-editform ad-profile">
        <DxFormLayoutItem Caption="이름" ColSpanMd="6">
            <DxTextBox @bind-Text="_edit.RealName" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="이메일" ColSpanMd="6">
            @* 남과 겹치면 서버가 409 로 거절한다. 그 문구를 그대로 보여 준다. *@
            <DxTextBox @bind-Text="_edit.Email" NullText="user@example.com" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="연락처" ColSpanMd="6">
            <DxTextBox @bind-Text="_edit.Phone" NullText="010-0000-0000" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="생일" ColSpanMd="4">
            <DxDateEdit Date="@_birthDate"
                        DateChanged="@((DateTime? d) => { _birthDate = d; })"
                        NullText="비워 둘 수 있다"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="음력" ColSpanMd="2">
            <DxCheckBox @bind-Checked="_isLunar">음력</DxCheckBox>
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="소개" ColSpanMd="12">
            <DxMemo @bind-Text="_edit.Introduction" Rows="3" NullText="한 줄 소개" />
        </DxFormLayoutItem>
    </DxFormLayout>

    <div class="jsini-toolbar">
        <div class="jsini-toolbar__spacer"></div>
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary"
                  Click="@SaveAsync" />
        <DxButton Text="되돌리기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@Revert" />
    </div>

    <h2 class="ad-subhead">비밀번호 변경</h2>

    <DxFormLayout CssClass="ad-editform ad-profile">
        <DxFormLayoutItem Caption="지금 비밀번호" ColSpanMd="4">
            <DxTextBox @bind-Text="_oldPassword" Password="true" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="새 비밀번호" ColSpanMd="4">
            <DxTextBox @bind-Text="_newPassword" Password="true" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="새 비밀번호 확인" ColSpanMd="4">
            @* 확인 칸은 서버에 보내지 않는다. 오타를 저장 전에 잡으려는 것뿐이다 —
               서버는 두 값이 같은지 알 방법이 없다. *@
            <DxTextBox @bind-Text="_confirmPassword" Password="true" />
        </DxFormLayoutItem>
    </DxFormLayout>

    <div class="jsini-toolbar">
        <div class="jsini-toolbar__spacer"></div>
        <DxButton Text="비밀번호 바꾸기" RenderStyle="ButtonRenderStyle.Primary"
                  Click="@ChangePasswordAsync" />
    </div>
}

<h2 class="ad-subhead">최근 활동</h2>

<CommGrd TItem="UserActivityDto" Data="@_activity" PageSize="20">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(UserActivityDto.CreatedAt)" Caption="시각" Width="160"
                          DisplayFormat="yyyy-MM-dd HH:mm" />
        <DxGridDataColumn FieldName="@nameof(UserActivityDto.Action)" Caption="동작" Width="160" />
        <DxGridDataColumn FieldName="@nameof(UserActivityDto.Detail)" Caption="내용" MinWidth="260" />
        <DxGridDataColumn FieldName="@nameof(UserActivityDto.IpAddress)" Caption="접속지" Width="150" />
    </Columns>
</CommGrd>

@code {
    private UserInfoDto? _info;
    private IReadOnlyList<UserActivityDto> _activity = [];

    private UpdateProfileDto _edit = new();
    private DateTime? _birthDate;
    private bool _isLunar;

    private string? _oldPassword;
    private string? _newPassword;
    private string? _confirmPassword;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () =>
    {
        var info = Api.GetMyInfoAsync();
        var activity = Api.GetMyActivityAsync();

        await Task.WhenAll(info, activity);

        _info = info.Result;
        _activity = activity.Result;

        Revert();

        return _activity.Count;
    }, "최근 활동 기록이 없습니다.", "내 정보를 읽지 못했습니다");

    /// <summary>받아 온 값으로 폼을 되돌린다. 처음 채울 때도 이것을 쓴다.</summary>
    private void Revert()
    {
        if (_info is null)
        {
            return;
        }

        _edit = new UpdateProfileDto
        {
            RealName = _info.RealName,
            Email = _info.Email,
            Phone = _info.Phone,
            Introduction = _info.Introduction,
        };

        _birthDate = DateTime.TryParse(_info.BirthDate, out var d) ? d : null;
        _isLunar = _info.BirthDateIsLunar;
    }

    /// <summary>
    /// 저장한다.
    ///
    /// 생일은 <c>yyyy-MM-dd</c> 글자로 보낸다. <b>비웠으면 빈 문자열</b>이다 —
    /// <c>null</c> 로 보내면 서버가 「건드리지 말라」로 읽어 옛 값이 남는다.
    /// </summary>
    private async Task SaveAsync()
    {
        _edit.BirthDate = _birthDate?.ToString("yyyy-MM-dd") ?? string.Empty;
        _edit.BirthDateIsLunar = _isLunar;

        if (await RunAsync(() => Api.UpdateMyProfileAsync(_edit), "저장했습니다.", "저장하지 못했습니다"))
        {
            await ReloadAsync();
        }
    }

    /// <summary>
    /// 비밀번호를 바꾼다.
    ///
    /// 바꿔도 <b>로그인 상태는 그대로다</b> — 서버가 새 토큰을 주지 않는다.
    /// 그래서 이 화면을 떠나지 않고 계속 쓸 수 있다.
    /// </summary>
    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrEmpty(_oldPassword) || string.IsNullOrEmpty(_newPassword))
        {
            Say("지금 비밀번호와 새 비밀번호를 모두 넣으십시오.", NoticeTone.Warning);
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            // 서버는 두 값이 같은지 알 방법이 없다. 여기서만 잡을 수 있다.
            Say("새 비밀번호와 확인이 다릅니다.", NoticeTone.Warning);
            return;
        }

        var changed = await RunAsync(
            () => Api.ChangePasswordAsync(_oldPassword, _newPassword),
            "비밀번호를 바꿨습니다. 다음 로그인부터 새 비밀번호를 씁니다.",
            "비밀번호를 바꾸지 못했습니다");

        if (changed)
        {
            // 성공했든 아니든 칸을 비우는 것이 맞지만, 실패했을 때 비우면
            // 지금 비밀번호를 다시 치게 된다. 성공했을 때만 비운다.
            _oldPassword = null;
            _newPassword = null;
            _confirmPassword = null;
        }
    }
}
