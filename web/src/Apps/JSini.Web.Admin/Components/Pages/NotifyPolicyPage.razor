@page "/admin/system/notify-policy"
@attribute [RouteKey("admin.system.notify-policy")]

@*
    [알림관리] 어떤 이벤트가 일어났을 때 어떤 역할이 어떤 길로 알림을 받을지 정한다. DB 메뉴 `/admin/system/notify-policy`. 문서: docs/notify-policy.md
    왼쪽은 이벤트 카드, 오른쪽은 받는 쪽이다. 정책이 없는 이벤트는 지금까지처럼 나가고, 「제한 없음」은 띠로 반드시 말한다. 본인 설정이 정책 뒤의 마지막 말이다.
    판 둘은 DxSplitter 로 나누고 <Panes> 안에 적는다 — 없으면 속이 빈 상자가 나온다. 판은 CommCont 여야 높이를 채운다(admin.css).
*@

@inherits DataPage

<PageTitle>알림관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" OnReset="@ResetAsync" Busy="@Loading"
         MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_keyword" Style="width: 220px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
        <CommSchItem Label="사용 여부">
            <DxCheckBox @bind-Checked="_activeOnly">쓰는 것만</DxCheckBox>
        </CommSchItem>
    </Fields>
</CommSch>

<DxTabs RenderMode="TabsRenderMode.OnDemand" CssClass="ad-nptabs" @bind-ActiveTabIndex="ActiveTab">
    <DxTabPage Text="이벤트 중심">
        <DxSplitter CssClass="ad-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
            <Panes>
                <DxSplitterPane Size="32%" MinSize="260px" MaxSize="60%">
    <CommCont Hint="@EventHint"
              CssClass="ad-vsplit__pane ad-vsplit__pane--left">
        <TitleTemplate>
            <div class="np-events-head">
                <h2 class="commcont__title">알림 이벤트</h2>
                <DxCheckBox Checked="@_excludeUngoverned"
                            CheckedChanged="@((bool v) => OnExcludeUngovernedChanged(v))">
                    정책밖 제외
                </DxCheckBox>
            </div>
        </TitleTemplate>
        <Actions>
            @* 카드 목록에는 `CommGrd` 의 아래 띠가 없다. 다시 읽는 자리를
               판 머리에 세워 둔다 — 아이콘과 자리는 다른 화면과 같은 것이다. *@
            <DxButton IconCssClass="jsini-icon-refresh" Title="알림 이벤트를 다시 읽는다"
                      RenderStyle="ButtonRenderStyle.Link"
                      Enabled="@(!Loading)" Click="@ReloadAsync" />
        </Actions>

        <ChildContent>
            @if (VisibleEvents.Count == 0)
            {
                <p class="np-list__empty">
                    @(_events.Count == 0 ? "등록된 알림 이벤트가 없습니다. 메뉴 SQL 을 돌렸는지 확인하십시오." : "조건에 맞는 알림 이벤트가 없습니다.")
                </p>
            }
            else
            {
                <div class="np-list" role="listbox" aria-label="알림 이벤트">
                    @foreach (var ev in VisibleEvents)
                    {
                        var on = _selected is not null && _selected.Code == ev.Code;

                        @* 카드 한 장이 이벤트 하나다. 석 줄로 읽는다 —
                           이름과 딱지 · 설명 · 받는 설정과 발생처.
                           사용여부 스위치로 목록에서 바로 확인하고 켜고 끌 수 있다. *@
                        <div class="np-card np-card--@CardTone(ev) @(on ? "is-on" : null)"
                             role="option" aria-selected="@on" tabindex="0"
                             @onclick="@(() => SelectAsync(ev))"
                             @onkeydown="@(e => OnCardKeyDown(e, ev))">
                            <div class="np-card__top">
                                <span class="np-card__name">@ev.Name</span>
                                @if (!ev.Governed)
                                {
                                    @* 보이되 못 건다를 목록에서부터 말한다 — 눌러 보고 나서 알게 하면 안 된다. *@
                                    <span class="jsini-badge">정책 밖</span>
                                }
                                else if (!IsEventActive(ev))
                                {
                                    <span class="jsini-badge jsini-badge--warn">꺼짐</span>
                                }
                                <span class="np-card__switch"
                                      @onclick="@(() => { })"
                                      @onclick:stopPropagation="true">
                                    <DxCheckBox Checked="@IsEventActive(ev)"
                                                CheckedChanged="@((bool v) => OnCardActiveChangedAsync(ev, v))"
                                                CheckType="CheckType.Switch"
                                                Enabled="@(ev.Governed && _canEdit)"
                                                Title="@(ev.Governed ? (IsEventActive(ev) ? "알림 사용 중 (누르면 끕니다)" : "알림 꺼짐 (누르면 켭니다)") : "정책 밖 알림")" />
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(ev.Description))
                            {
                                <span class="np-card__desc">@ev.Description</span>
                            }

                            <span class="np-card__meta">
                                <span class="np-card__chan">@ev.ChannelSummary</span>
                                @if (!string.IsNullOrWhiteSpace(ev.Source))
                                {
                                    <span class="np-card__src">@ev.Source</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </CommCont>
    </DxSplitterPane>

    <DxSplitterPane>
    <CommCont CssClass="ad-vsplit__pane ad-vsplit__pane--right">
        <TitleTemplate>
            @if (_selected is not null)
            {
                <div class="np-events-head">
                    <h2 class="commcont__title">@_selected.Name</h2>
                    <span class="ad-stamp">@_selected.Code</span>
                </div>
            }
        </TitleTemplate>
        <ChildContent>
            @if (_selected is null)
            {
                <PageNotice Tone="NoticeTone.Info"
                            Text="왼쪽에서 설정할 알림 이벤트를 고르십시오." />
            }
            else
            {
                @* 판이 남은 높이를 채우므로 안쪽에서 굴러야 한다 — 안 굴리면 본문의 overflow: hidden 에 잘린다. *@
                <div class="np-edit">

                @if (!string.IsNullOrWhiteSpace(_selected.Description))
                {
                    <p class="np-desc">@_selected.Description</p>
                }

                <dl class="np-facts">
                    <dt>발생처</dt>
                    <dd>@(_selected.Source ?? "—")</dd>
                    <dt>알림구분</dt>
                    <dd>@(_selected.CategoryName ?? "없음")</dd>
                    <dt>대상</dt>
                    <dd>@_selected.TargetText</dd>
                    <dt>나가는 길</dt>
                    <dd>@ChannelText(_selected)</dd>
                </dl>

                @* 셋을 갈라서 말한다 — 「제한 없음」과 「아무도 못 받음」은 체크가 하나도 없는 같은 화면에서 뜻이 정반대다. *@
                @if (!_selected.Governed)
                {
                    <PageNotice Tone="NoticeTone.Warning" Text="@UngovernedText" />
                }
                else if (!_isActive)
                {
                    <PageNotice Tone="NoticeTone.Warning"
                                Text="이 이벤트를 꺼 두었습니다. 역할과 상관없이 아무에게도 나가지 않습니다." />
                }
                else if (NoRolePicked)
                {
                    @* 푸시와 메일의 기본값이 반대다 — 같은 기본값을 쓰면 켜진 날 배포·생일 알림이 전 직원 메일함으로 쏟아진다. 소개 사이트 문의처럼 정책이 정본인 이벤트는 역할이 비면 알림이 멎어 말과 색을 함께 바꾼다. *@
                    <PageNotice Tone="@NoRoleTone" Text="@NoRoleText" />
                }
                else
                {
                    <PageNotice Tone="NoticeTone.Info" Text="@EffectText" />
                }

                <div class="np-switch">
                    <DxCheckBox Checked="@_isActive"
                                CheckedChanged="@((bool v) => OnActiveChangedAsync(v))"
                                CheckType="CheckType.Switch"
                                Enabled="@(_selected.Governed && _canEdit)">
                        이 이벤트의 알림을 쓴다
                    </DxCheckBox>
                </div>

                <div class="np-roles-head">
                    <h2 class="ad-section">역할별 수신</h2>
                    <div class="np-roles-all">
                        <span title="@PushHint">
                            <DxCheckBox Checked="@AllPush"
                                        CheckedChanged="@((bool v) => OnAllPushChangedAsync(v))"
                                        Enabled="@(CanPick && _selected.SupportsPush)">
                                앱 푸시 전체
                            </DxCheckBox>
                        </span>
                        <span title="@MailHint">
                            <DxCheckBox Checked="@AllEmail"
                                        CheckedChanged="@((bool v) => OnAllEmailChangedAsync(v))"
                                        Enabled="@(CanPick && _selected.SupportsEmail)">
                                이메일 전체
                            </DxCheckBox>
                        </span>
                    </div>
                </div>

                        @* 역할을 전부 보여 주고 체크로 가린다 — 걸려 있지 않은 역할이 안 보이는 「더하기」 창은 물을 때마다 열어 확인해야 한다. 열여섯 줄이라 페이징 없이 펼친다. *@
                        @if (_rows.Count == 0)
                        {
                            <p class="np-list__empty">등록된 역할이 없습니다.</p>
                        }
                        else
                        {
                            <div class="np-roles" role="list" aria-label="역할별 수신">
                                @foreach (var row in _rows)
                                {
                                    <div class="np-role-item" role="listitem">
                                        <div class="np-role-info">
                                            <span class="np-role-name">@row.RoleName</span>
                                            <span class="ad-stamp np-role-id">@row.RoleId</span>
                                            @if (row.AccountCount == 0)
                                            {
                                                <span class="jsini-badge jsini-badge--warn">0명</span>
                                            }
                                            else
                                            {
                                                <span class="jsini-badge">@($"{row.AccountCount}명")</span>
                                            }
                                        </div>
                                        <div class="np-role-checks">
                                            <span title="@PushHint">
                                                <DxCheckBox Checked="@row.Push"
                                                            CheckedChanged="@((bool v) => SetPushAsync(row, v))"
                                                            Enabled="@(CanPick && _selected.SupportsPush)">
                                                    앱 푸시
                                                </DxCheckBox>
                                            </span>
                                            <span title="@MailHint">
                                                <DxCheckBox Checked="@row.Email"
                                                            CheckedChanged="@((bool v) => SetEmailAsync(row, v))"
                                                            Enabled="@(CanPick && _selected.SupportsEmail)">
                                                    이메일
                                                </DxCheckBox>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="jsini-hint">
                            받는 사람이 <b>본인 환경설정에서 꺼 두면</b> 여기서 켜 두어도 가지 않습니다 —
                            순서가 <b>정책 → 본인 설정</b> 입니다.
                            @if (_selected is { SupportsEmail: true, EmailFromPush: true })
                            {
                                <text>
                                    이메일은 <b>켠 역할에만</b> 나갑니다 — 앱 푸시처럼 「안 걸면 모두에게」가
                                    아닙니다.
                                </text>
                            }
                        </div>

                        @if (_selected.UpdatedAt is not null)
                        {
                            <p class="ad-stamp">
                                마지막 저장 · @Stamp(_selected.UpdatedAt)
                                @if (_pendingSaves > 0)
                                {
                                    <text> · 저장 중…</text>
                                }
                            </p>
                        }
                        else if (_pendingSaves > 0)
                        {
                            <p class="ad-stamp">저장 중…</p>
                        }

                        <div class="np-actions">
                            @* 받는 사람 보기는 권한 문을 하나 더 세우지 않는다 — 설정을 볼 수 있는 사람이면 그 목록은 설정을 읽어 푼 것일 뿐이다. *@
                            <DxButton Text="받는 사람" RenderStyle="ButtonRenderStyle.Secondary"
                                      Enabled="@(!Loading)" Click="@OpenRecipientsAsync" />
                        </div>
                    </div>
                }
            </ChildContent>
        </CommCont>
        </DxSplitterPane>

            </Panes>
        </DxSplitter>
    </DxTabPage>

    <DxTabPage Text="역할 중심">
        <DxSplitter CssClass="ad-vsplit" Orientation="Orientation.Horizontal" SeparatorSize="2">
            <Panes>

            <DxSplitterPane Size="32%" MinSize="260px" MaxSize="60%">
            <CommCont Hint="@RoleHint"
                      CssClass="ad-vsplit__pane ad-vsplit__pane--left">
                <TitleTemplate>
                    <div class="np-events-head">
                        <h2 class="commcont__title">역할 목록</h2>
                    </div>
                </TitleTemplate>
                <Actions>
                    <DxButton IconCssClass="jsini-icon-refresh" Title="역할 목록을 다시 읽는다"
                              RenderStyle="ButtonRenderStyle.Link"
                              Enabled="@(!Loading)" Click="@ReloadAsync" />
                </Actions>

                <ChildContent>
                    @if (VisibleRoles.Count == 0)
                    {
                        <p class="np-list__empty">
                            @(_roles.Count == 0 ? "등록된 역할이 없습니다." : "조건에 맞는 역할이 없습니다.")
                        </p>
                    }
                    else
                    {
                        <div class="np-list" role="listbox" aria-label="역할 목록">
                            @foreach (var role in VisibleRoles)
                            {
                                var on = _selectedRole is not null && _selectedRole.Id == role.Id;

                                <button type="button"
                                        class="np-card np-card--@RoleCardTone(role) @(on ? "is-on" : null)"
                                        role="option" aria-selected="@on"
                                        @onclick="@(() => SelectRoleAsync(role))">
                                    <span class="np-card__top">
                                        <span class="np-card__name">@role.Name</span>
                                        @if (role.AccountCount == 0)
                                        {
                                            <span class="jsini-badge jsini-badge--warn">0명</span>
                                        }
                                        else
                                        {
                                            <span class="jsini-badge">@($"{role.AccountCount}명")</span>
                                        }
                                    </span>

                                    <span class="np-card__desc">
                                        <span class="ad-stamp">@role.Id</span>
                                    </span>

                                    <span class="np-card__meta">
                                        <span class="np-card__chan">@RoleChannelSummary(role)</span>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </ChildContent>
            </CommCont>
            </DxSplitterPane>

            <DxSplitterPane>
            <CommCont CssClass="ad-vsplit__pane ad-vsplit__pane--right">
                <TitleTemplate>
                    @if (_selectedRole is not null)
                    {
                        <div class="np-events-head">
                            <h2 class="commcont__title">@_selectedRole.Name</h2>
                            <span class="ad-stamp">@_selectedRole.Id</span>
                            @if (_selectedRole.AccountCount == 0)
                            {
                                <span class="jsini-badge jsini-badge--warn">0명</span>
                            }
                            else
                            {
                                <span class="jsini-badge">@($"{_selectedRole.AccountCount}명")</span>
                            }
                        </div>
                    }
                </TitleTemplate>
                <ChildContent>
                    @if (_selectedRole is null)
                    {
                        <PageNotice Tone="NoticeTone.Info"
                                    Text="왼쪽에서 알림 설정을 지정할 역할을 고르십시오." />
                    }
                    else
                    {
                        <div class="np-edit">

                        <PageNotice Tone="NoticeTone.Info" Text="@RoleEffectText" />

                        <div class="np-roles-head">
                            <h2 class="ad-section">이벤트별 수신 권한</h2>
                            <div class="np-roles-all">
                                <span>
                                    <DxCheckBox Checked="@AllRolePush"
                                                CheckedChanged="@((bool v) => OnAllRolePushChangedAsync(v))"
                                                Enabled="@(_canEdit && _roleEventRows.Any(r => CanPickRoleEvent(r.Event) && r.Event.SupportsPush))">
                                        앱 푸시 전체
                                    </DxCheckBox>
                                </span>
                                <span>
                                    <DxCheckBox Checked="@AllRoleEmail"
                                                CheckedChanged="@((bool v) => OnAllRoleEmailChangedAsync(v))"
                                                Enabled="@(_canEdit && _roleEventRows.Any(r => CanPickRoleEvent(r.Event) && r.Event.SupportsEmail))">
                                        이메일 전체
                                    </DxCheckBox>
                                </span>
                            </div>
                        </div>

                        @if (_roleEventRows.Count == 0)
                        {
                            <p class="np-list__empty">설정 가능한 알림 이벤트가 없습니다.</p>
                        }
                        else
                        {
                            <div class="np-roles" role="list" aria-label="이벤트별 수신 권한">
                                @foreach (var row in _roleEventRows)
                                {
                                    <div class="np-role-item" role="listitem">
                                        <div class="np-role-info">
                                            <span class="np-role-name">@row.Event.Name</span>
                                            <span class="ad-stamp np-role-id">@row.Event.Code</span>
                                            @if (!string.IsNullOrWhiteSpace(row.Event.CategoryName))
                                            {
                                                <span class="jsini-badge">@row.Event.CategoryName</span>
                                            }
                                            <span class="ad-stamp">@row.Event.TargetText</span>
                                            @if (!row.Event.Governed)
                                            {
                                                <span class="jsini-badge">정책 밖</span>
                                            }
                                            else if (!row.Event.IsActive)
                                            {
                                                <span class="jsini-badge jsini-badge--warn">꺼짐</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(row.Event.Description))
                                        {
                                            <div class="np-role-event-desc">@row.Event.Description</div>
                                        }

                                        <div class="np-role-checks">
                                            <span title="@RolePushHint(row.Event)">
                                                <DxCheckBox Checked="@row.Push"
                                                            CheckedChanged="@((bool v) => SetRoleEventPushAsync(row, v))"
                                                            Enabled="@(CanPickRoleEvent(row.Event) && row.Event.SupportsPush)">
                                                    앱 푸시
                                                </DxCheckBox>
                                            </span>
                                            <span title="@RoleMailHint(row.Event)">
                                                <DxCheckBox Checked="@row.Email"
                                                            CheckedChanged="@((bool v) => SetRoleEventEmailAsync(row, v))"
                                                            Enabled="@(CanPickRoleEvent(row.Event) && row.Event.SupportsEmail)">
                                                    이메일
                                                </DxCheckBox>
                                            </span>
                                            <DxButton Text="받는 사람" RenderStyle="ButtonRenderStyle.Link"
                                                      Enabled="@(!Loading)" Click="@(() => OpenRecipientsForEventAsync(row.Event))" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="jsini-hint">
                            받는 사람이 <b>본인 환경설정에서 꺼 두면</b> 여기서 켜 두어도 가지 않습니다 —
                            순서가 <b>정책 → 본인 설정</b> 입니다.
                        </div>

                        @if (_pendingSaves > 0)
                        {
                            <p class="ad-stamp">저장 중…</p>
                        }
                    </div>
                }
                </ChildContent>
            </CommCont>
            </DxSplitterPane>

            </Panes>
        </DxSplitter>
    </DxTabPage>
</DxTabs>

@* 받는 사람은 저장된 설정으로 셈한다 — 체크 상태로 보여 주면 저장하지 않은 값으로 「갑니다」를 말하게 된다. *@
<CommPopup @bind-Visible="_showRecipients" HeaderText="받는 사람" Width="720px">
    <BodyContentTemplate Context="popup">
        @if (_preview is null)
        {
            <PageNotice Text="받는 사람을 읽는 중입니다." Tone="NoticeTone.Info" />
        }
        else if (_preview.EventDisabled)
        {
            <PageNotice Tone="NoticeTone.Warning"
                        Text="이 이벤트를 꺼 두었습니다 — 아무에게도 나가지 않습니다." />
        }
        else if (_preview is { Unrestricted: true, PolicyRequired: true })
        {
            @* 보내는 쪽이 기본 역할을 안 적어 두는 이벤트다 — 「제한 없음」이 아니라 받을 사람이 없는 것이다. 여기서 갈라 말하지 않으면 답이 뒤집힌다. *@
            <PageNotice Tone="NoticeTone.Warning"
                        Text="받는 역할이 하나도 없습니다 — 이 알림은 지금 아무에게도 가지 않습니다. 왼쪽에서 역할을 고르십시오." />
        }
        else if (_preview.Unrestricted)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="역할을 걸지 않아 제한이 없습니다. 지금까지와 똑같이, 보내는 쪽이 정한 대상에게 나갑니다." />
        }
        else if (_preview.Recipients.Count == 0)
        {
            <PageNotice Tone="NoticeTone.Warning"
                        Text="고른 역할에 걸린 사람이 없습니다. 「사람롤」에서 역할에 사람을 거십시오." />
        }
        else
        {
            <CommGrd TItem="NotifyRecipientDto"
                     Data="@_preview.Recipients"
                     Unit="명"
                     ShowExcelExport="false"
                     EmptyText="받는 사람이 없습니다."
                     AutoSelectFirstRow="false">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(NotifyRecipientDto.UserName)" Caption="이름"
                                      Width="100" TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(NotifyRecipientDto.UserId)" Caption="아이디"
                                      Width="110" TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(NotifyRecipientDto.RoleText)" Caption="역할"
                                      MinWidth="110" TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn Caption="앱 푸시" Width="78">
                        <CellDisplayTemplate Context="cell">
                            @Mark(((NotifyRecipientDto)cell.DataItem).PushReaches)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="이메일" Width="78">
                        <CellDisplayTemplate Context="cell">
                            @Mark(((NotifyRecipientDto)cell.DataItem).EmailReaches)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    @* 못 닿는 까닭을 줄마다 적는다 — 고칠 자리가 알림관리 · 그 사람의 환경설정 · 계정 관리 셋으로 갈린다. *@
                    <DxGridDataColumn Caption="비고" MinWidth="170" TextAlignment="GridTextAlignment.Left">
                        <CellDisplayTemplate Context="cell">
                            <span class="np-why">@((NotifyRecipientDto)cell.DataItem).Why</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </CommGrd>

            <div class="jsini-hint">@ReachText</div>
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _showRecipients = false)" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />
