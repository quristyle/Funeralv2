@*
    「주소 찾기」 단추. 카카오(다음) 우편번호 서비스를 띄우고, 고른 값을
    우편번호 칸과 주소 칸에 함께 넣는다.

    ────────────────────────────────────────────────────────────
    [왜 단추만 있고 칸은 밖에 있나]

    우편번호·주소·상세주소 세 칸은 이미 편집 폼이 자기 배치로 그리고 있다.
    이 부품이 칸까지 그리면 그 배치(`DxFormLayoutItem` 의 ColSpanMd)를 여기서
    한 번 더 정해야 하고, 쓰는 화면마다 폭이 달라 맞출 수가 없다.

    그래서 **값만 주고받는다.** 칸은 화면이 그린다.

    ────────────────────────────────────────────────────────────
    [두 값을 한 번에 돌려준다]

    우편번호와 주소를 따로 알리면 받는 쪽이 두 번 그려지고, 그 사이 한쪽만
    바뀐 상태가 화면에 보인다. 콜백 하나로 묶었다.

    상세주소는 건드리지 않는다 — 사람이 적는 값이라 주소를 다시 찾았다고
    지워 버리면 층·호수를 다시 치게 된다.

    ────────────────────────────────────────────────────────────
    [실패는 조용히 넘기지 않는다]

    바깥 CDN 을 받아야 열린다. 사내망이 막고 있거나 망이 끊기면 단추가
    **아무 반응이 없는 것처럼** 보이므로, 그때는 이유를 띄운다. 주소는 손으로도
    칠 수 있으니 여기서 막지는 않는다.
*@

@inherits DataPage
@inject IJSRuntime JS
@implements IAsyncDisposable

<DxButton Text="@Text"
          RenderStyle="ButtonRenderStyle.Secondary"
          IconCssClass="jsini-icon-search"
          Enabled="@(!_opening)"
          Click="@PickAsync" />

@code {
    /// <summary>단추에 적는 글자.</summary>
    [Parameter] public string Text { get; set; } = "주소 찾기";

    /// <summary>
    /// 주소를 골랐을 때. 우편번호와 주소를 함께 준다.
    /// 고르지 않고 닫으면 부르지 않는다.
    /// </summary>
    [Parameter] public EventCallback<AddrPick> OnPicked { get; set; }

    private IJSObjectReference? _js;

    /// <summary>
    /// 지금 덮개가 떠 있는가. 떠 있는 동안 단추를 잠근다 —
    /// 연달아 누르면 덮개가 겹쳐 쌓이고, 뒤엣것을 닫아도 앞엣것이 남는다.
    /// </summary>
    private bool _opening;

    private async Task PickAsync()
    {
        if (_opening)
        {
            return;
        }

        _opening = true;

        try
        {
            _js ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/JSini.Web.Admin/js/addr-find.js");

            var picked = await _js.InvokeAsync<AddrPick?>("pick");

            if (picked is not null)
            {
                await OnPicked.InvokeAsync(picked);
            }
        }
        catch (JSException)
        {
            // 스크립트를 못 받았거나 위젯이 죽었다. 주소는 손으로도 칠 수 있다.
            Say("주소 검색을 열지 못했습니다. 주소를 직접 입력해 주십시오.", NoticeTone.Warning);
        }
        catch (InvalidOperationException)
        {
            // 회로가 닫히는 중이다(화면을 옮기는 순간 등). 띄울 곳이 없다.
        }
        finally
        {
            _opening = false;
        }
    }

    /// <summary>골라 온 주소. JS 가 돌려주는 모양 그대로다.</summary>
    public sealed class AddrPick
    {
        public string ZipCode { get; set; } = string.Empty;

        /// <summary>도로명 또는 지번 주소. 참고 항목까지 붙어 있다.</summary>
        public string Address { get; set; } = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (_js is null)
        {
            return;
        }

        try
        {
            await _js.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // 회로가 이미 끊겼다. 브라우저 쪽은 함께 사라진다.
        }
    }
}
