@* 메뉴에 닿는 대상(회사 · 부서 · 사람) 한 묶음. 셋의 해제 단추가 같은 규칙을 쓰도록 부품으로 뺐다.
    여러 역할이 걸리면 어느 역할 때문인지 이름을 함께 보여 준다. *@

<h2 class="ad-section">@Title (@Targets.Count)</h2>

@if (Targets.Count == 0)
{
    <p class="ad-stamp">없습니다.</p>
}
else
{
    @* 목록 높이를 묶는다 — 사람이 많으면 표가 화면 밖으로 밀린다(admin.css ad-reach). *@
    <div class="ad-scroll ad-reach">
        <table class="ad-perm">
            <thead>
                <tr>
                    <th>이름</th>
                    <th>소속</th>
                    <th>인원</th>
                    <th>걸린 역할</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var target in Targets)
                {
                    <tr>
                        <td>
                            @target.Name
                            @if (!string.IsNullOrWhiteSpace(target.LoginId))
                            {
                                <span class="ad-stamp">@target.LoginId</span>
                            }
                        </td>
                        <td class="ad-stamp">@target.CompanyName</td>
                        <td class="ad-stamp">@target.UserCount</td>
                        <td>
                            @* 이름과 식별자가 짝이다. 서버가 같은 순서로 준다. *@
                            @for (var i = 0; i < target.ViaRoleIds.Count; i++)
                            {
                                var roleId = target.ViaRoleIds[i];
                                var roleName = i < target.ViaRoleNames.Count ? target.ViaRoleNames[i] : roleId;

                                <span class="ad-via">
                                    <span class="jsini-badge">@roleName</span>

                                    <PermissionView Action="MenuAction.Update">
                                        <DxButton Text="해제"
                                                  RenderStyle="ButtonRenderStyle.Secondary"
                                                  Click="@(() => OnDetach.InvokeAsync((Kind, target.Id, roleId, target.Name)))" />
                                    </PermissionView>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
