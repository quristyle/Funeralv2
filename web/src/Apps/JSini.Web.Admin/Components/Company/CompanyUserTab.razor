@* 고른 회사에 속한 사람. 넣기 · 빼기를 여기서 한다(계정 자체는 지우지 않는다). *@

@inherits DataPage

<CommGrd TItem="AccountDto" Data="@_users" PageSize="20"
         ExportName="@($"{CompanyName} 사용자")"
         EmptyText="이 회사에 속한 사용자가 없습니다."
         Reload="@ReloadAsync"
         RowActions="@Unlink"
         AutoSelectFirstRow="false">
    <ContextMenuItems>
        <PermissionView Action="MenuAction.Create">
            <CommMenuItem Text="사람 넣기" IconCssClass="jsini-icon-plus" Click="@OpenAddAsync" />
        </PermissionView>
    </ContextMenuItems>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="130" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="110" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.DeptName)" Caption="부서" Width="140" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.Email)" Caption="이메일" MinWidth="180" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.Phone)" Caption="연락처" Width="130" />
        <DxGridDataColumn FieldName="@nameof(AccountDto.RoleText)" Caption="역할" MinWidth="160" />
    </Columns>
</CommGrd>

@* 후보는 어느 회사에도 속하지 않은 사람이다. 다른 회사 사람은 그 회사에서 먼저 빼야 한다. *@
<CommPopup @bind-Visible="_adding" HeaderText="@($"「{CompanyName}」 에 사람 넣기")" Width="620px">
    <BodyContentTemplate Context="popup">
        @if (_candidates.Count == 0)
        {
            <p class="ad-stamp">
                소속이 없는 사람이 없습니다. 다른 회사에 속한 사람은 그 회사에서 먼저 빼야 합니다.
            </p>
        }
        else
        {
            <CommGrd TItem="AccountDto" Data="@_candidates" PageSize="10"
                     ShowExcelExport="false"
                     SelectionMode="GridSelectionMode.Multiple"
                     SelectedItems="@_picked"
                     SelectedItemsChanged="@OnPicked"
                     ShowAllRowsSelectionCheckbox="true">
                <Columns>
                    <DxGridSelectionColumn Width="50px" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.LoginId)" Caption="아이디" Width="140" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.UserName)" Caption="이름" Width="130" />
                    <DxGridDataColumn FieldName="@nameof(AccountDto.Email)" Caption="이메일" MinWidth="180" />
                </Columns>
            </CommGrd>
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <span class="ad-stamp">@_picked.Count 명 선택</span>
        <span class="jsini-notice-popup__gap"></span>
        <DxButton Text="넣기" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_picked.Count > 0)" Click="@AddAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _adding = false)" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />
