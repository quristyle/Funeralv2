{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 게이트웨이 주소. 이 앱이 **직접** 부른다 — 셸을 거치지 않는다.
  // 거치면 셸이 모든 트래픽의 병목이 되고 앱을 나눈 의미가 없어진다.
  "Gateway": {
    "BaseUrl": "http://localhost:5265/api/"
  },

  // 인증 쿠키를 일곱 앱이 함께 풀려면 키 링을 공유해야 한다.
  // 이 값이 앱마다 다르면 업무를 옮길 때마다 로그인 화면으로 튕긴다.
  "DataProtection": {
    "KeyRingPath": "../../../.keys"
  }
}
