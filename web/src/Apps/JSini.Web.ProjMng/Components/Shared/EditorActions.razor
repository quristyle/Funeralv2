@*
    Monaco 옆의 「…」 메뉴(복사 · 자동 줄바꿈 · 줄 번호). 떠 있는 줄(Floating)은 편집기 안쪽 오른쪽 위에, 붙는 줄은 칸 이름표 끝에 선다.
    글자는 누른 순간에 편집기에서 받는다(TextProvider) — 바깥이 든 값은 입력 debounce 만큼 뒤처진다.
*@

@* 단추는 「…」 하나 — 펴진 판에 복사와 스위치가 선다. 스위치는 …Changed 를 매어 준 자리에만 선다.
   aria-checked · aria-expanded 는 글자로 적는다(bool 은 거짓일 때 속성째 사라진다). 이 말은 여는 태그 안에 적지 않는다. *@
<div class="pm-edact @(Floating ? "pm-edact--float" : null) @(_open ? "is-open" : null)"
     @onkeydown="@OnKeyDown">
    <button type="button"
            class="pm-edact__btn @(_open ? "is-active" : null)"
            title="편집기 메뉴"
            aria-label="편집기 메뉴"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="@Toggle">
        <span class="jsini-icon-more"></span>
    </button>

    @if (_open)
    {
        @* 바깥을 누르면 닫는다. 판 뒤에 깔리는 투명한 막이다. *@
        <div class="pm-edact__veil" @onclick="@Close"></div>

        <div class="pm-edact__menu" role="menu">
            <button type="button" role="menuitem"
                    class="pm-edact__item @(_copied ? "is-copied" : null)"
                    @onclick="@CopyAsync">
                <span class="pm-edact__icon @(_copied ? "jsini-icon-check" : "jsini-icon-copy")"></span>
                <span class="pm-edact__label">@(_copied ? "복사되었습니다" : CopyTitle)</span>
            </button>

            @if (WordWrapChanged.HasDelegate)
            {
                <button type="button" role="menuitemcheckbox"
                        class="pm-edact__item"
                        aria-checked="@(WordWrap ? "true" : "false")"
                        @onclick="@ToggleWrapAsync">
                    <span class="pm-edact__icon jsini-icon-wrap"></span>
                    <span class="pm-edact__label">자동 줄바꿈</span>
                    <span class="pm-edact__switch @(WordWrap ? "is-on" : null)"></span>
                </button>
            }

            @if (LineNumbersChanged.HasDelegate)
            {
                <button type="button" role="menuitemcheckbox"
                        class="pm-edact__item"
                        aria-checked="@(LineNumbers ? "true" : "false")"
                        @onclick="@ToggleLineNumbersAsync">
                    <span class="pm-edact__icon pm-edact__icon--num">1</span>
                    <span class="pm-edact__label">줄 번호</span>
                    <span class="pm-edact__switch @(LineNumbers ? "is-on" : null)"></span>
                </button>
            }
        </div>
    }
</div>
