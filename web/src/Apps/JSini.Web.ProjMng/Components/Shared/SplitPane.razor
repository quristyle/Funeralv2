@*
    좌우 분할. 마스터-디테일 화면이 쓴다.
*@

<DxLayoutBreakpoint MaxWidth="900" @bind-IsActive="_isNarrow" />

<DxSplitter CssClass="pm-split" Orientation="@(_isNarrow ? Orientation.Vertical : Orientation.Horizontal)">
    <DxSplitterPane Size="@(_isNarrow ? "50%" : $"{Size}%")">
        <div class="pm-split__first">
            @First
        </div>
    </DxSplitterPane>
    <DxSplitterPane>
        <div class="pm-split__second">
            @Second
        </div>
    </DxSplitterPane>
</DxSplitter>

@code {
    /// <summary>왼쪽 창의 너비 비율(%).</summary>
    [Parameter] public int Size { get; set; } = 35;

    [Parameter] public RenderFragment? First { get; set; }

    [Parameter] public RenderFragment? Second { get; set; }

    private bool _isNarrow;
}
