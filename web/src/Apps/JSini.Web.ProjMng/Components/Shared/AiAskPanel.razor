@*
    빠른 지시 알맹이. 화면(AiAsk)과 헤더 서랍(QuickAskDrawer)이 같은 부품을 쓴다.
    @page 와 PageTitle 은 화면 쪽에 둔다 — 서랍은 살아 있는 부품이라 제목을 여기서 걸면 탭 이름이 붙박인다.
*@

@inherits DataPage
@implements IDisposable
@implements IAsyncDisposable

@* 휴대폰 여부. `@@bind-IsActive` 로 묶으면 처리기가 돌지 않는다.
   경계 767px 는 포털 탭 줄이 감춰지는 경계와 같다(`app.css`). *@
<DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall"
                    IsActive="_isPhone" IsActiveChanged="@OnPhoneChanged" />

@* 이 부품만의 id. 화면과 서랍이 함께 떠 있을 때 글상자를 잡는 JS
   (`ask-draft.js`)가 엉뚱한 쪽을 집지 않게 한다. *@
<div class="pm-ask" id="@_domId">

    @* ── 판 안의 탭 줄 (휴대폰) ────────────────────────────
       열어 본 건이 있을 때만 선다. `@@key` 는 가운데 탭을 닫을 때 눌린 칸이
       다른 건의 칸으로 굳는 것을 막는다. *@
    @if (_isPhone && _views.Count > 0)
    {
        <div class="pm-ask__tabs" role="tablist" aria-label="열어 둔 상세">
            <button type="button"
                    class="pm-ask__tab @(Viewing is null ? "pm-ask__tab--on" : null)"
                    role="tab" aria-selected="@(Viewing is null)"
                    @onclick="ShowList">빠른 지시</button>

            @foreach (var key in _views)
            {
                var on = Viewing == key;

                <span @key="key" class="pm-ask__tab @(on ? "pm-ask__tab--on" : null)">
                    <button type="button" class="pm-ask__tabgo"
                            role="tab" aria-selected="@on"
                            title="@ViewTitle(key)"
                            @onclick="@(() => ShowView(key))">@ViewTitle(key)</button>

                    <button type="button" class="pm-ask__tabx"
                            title="닫기" aria-label="@($"{ViewTitle(key)} 닫기")"
                            @onclick="@(() => CloseView(key))">×</button>
                </span>
            }
        </div>
    }

    @* ── 상세 (휴대폰) ────────────────────────────────────
       보고 있는 한 건만 그린다 — 감춰 두면 건마다 로그 타이머가 돈다. *@
    @if (_isPhone && Viewing is { } viewing)
    {
        <CommCont CssClass="pm-ask__view">
            <AiTaskView @key="viewing" Item="@ViewItem" Live="true"
                        MissingText="그 건을 목록에서 놓쳤습니다. 탭을 닫고 다시 여십시오." />

            @if (ViewItem is not null)
            {
                @* 단추는 목록·책상 화면과 같은 부품을 쓴다. *@
                <div class="pm-ask__viewacts jsini-actbar">
                    <AiTaskActions Item="@ViewItem"
                                   OnChanged="@OnViewChangedAsync"
                                   OnConfirmed="@OnViewClosedAsync"
                                   OnDeleted="@OnViewClosedAsync"
                                   OnClose="@(() => CloseView(viewing))" />
                </div>
            }
            else
            {
                <div class="pm-ask__viewacts jsini-actbar">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Click="@(() => CloseView(viewing))">
                        <span class="pm-peek__btn-text--full">닫기</span>
                        <span class="pm-peek__btn-text--short">닫기</span>
                    </DxButton>
                </div>
            }
        </CommCont>
    }

    @* ── 적는 자리 ────────────────────────────────────────
       상세를 보는 동안에는 지우지 않고 감추기만 한다 — 지우면 적다 만 글을
       붙드는 JS 가 글상자를 잃는다. 적는 자리와 카드 목록 둘 다 감춘다. *@
    <CommCont CssClass="@WritePaneCss">


        <div class="pm-ask__where">
            @* 고른 값은 칸을 바꾸는 그 자리에서 기억된다(`Pick*` 속성). *@
            <DxComboBox Data="@_targets" @bind-Value="PickTarget"
                        TextFieldName="@nameof(AiTargetDto.TargetNm)"
                        ValueFieldName="@nameof(AiTargetDto.TargetKey)"
                        NullText="어디에서 일할지"
                        CssClass="pm-ask__target"
                        Enabled="@(!Busy && _targets.Count > 0)" />

            @* 고르개는 공통 부품이다(`AiRunnerPick`) — 「AI 작업」 화면의
               작성 탭이 같은 것을 쓴다. 이름과 한도를 어떻게 그리는지는
               그 부품이 정하고, 여기서는 **폭만 준다**(`pm-ask__kind`). *@
            <AiRunnerPick Items="@RunnerKinds" @bind-Value="PickKind"
                          CssClass="pm-ask__kind"
                          Enabled="@(!Busy && AllowedKinds.Count > 1)"
                          Usage="@UsageOf"
                          UsageSeen="@_usageSeen" />
        </div>

        @* 글상자. autofocus 는 걸지 않는다(모바일에서 자판이 화면 절반을 먹는다). bind-Text:event="oninput" 은 DevExpress 편집기에서 회로가 끊기므로 BindValueMode 를 쓴다.
           Ctrl+Enter 는 키를 가리지 않고 ask-draft.js 가 받아 올린다(onkeydown 을 걸면 타자가 통째로 안 먹는다). *@
        <DxMemo @bind-Text="Text"
                BindValueMode="BindValueMode.OnInput"
                InputDelay="300"
                Rows="6"
                CssClass="pm-ask__text"
                NullText="무엇을 시킬지, 또는 무엇이 궁금한지 적으십시오. 첫 줄이 제목이 됩니다."
                Enabled="@(!Busy)" />

        @* 고르개는 아래 단추 줄에 서고, 여기에는 고른 뒤에만 생기는 줄이 온다. 파일은 고르는 순간 올린다(작업 번호가 없어 서버가 주인 없이 담고, 보낼 때 묶는다).
           올린 뒤 FilePicker 목록은 비운다 — 안 비우면 앞엣것이 다시 올라간다. 다 올라가기 전에는 CanSend 가 막는다. *@
        @if (_selectedFileNames.Count > 0 || _attached.Count > 0)
        {
        <div class="pm-ask__files">
            @if (_selectedFileNames.Count > 0)
            {
                <div class="pm-ask__selected" aria-live="polite">
                    <span>선택됨</span>
                    <span>@string.Join(", ", _selectedFileNames)</span>
                </div>
            }

            @if (_attached.Count > 0)
            {
                <ul class="pm-ask__clips">
                    @foreach (var f in _attached)
                    {
                        <li class="pm-ask__clip" title="@($"{f.FileNm} · {f.SizeText}")">
                            @* 그림은 그림으로 보여 준다 — 이름만으로는 뗄지 말지를
                               정할 수 없다. 그림이 아닌 것은 클립 표시다. *@
                            @if (f.IsImage)
                            {
                                <img class="pm-ask__clipimg"
                                     src="@FileDownload.AiTaskUrlFor(f.FileKey)" alt="@f.FileNm" />
                            }
                            else
                            {
                                <span class="pm-ask__clipicon" aria-hidden="true"></span>
                            }

                            <span class="pm-ask__clipname">@f.FileNm</span>
                            <span class="pm-ask__clipsize">@f.SizeText</span>

                            <button type="button" class="pm-ask__clipx"
                                    title="이 첨부를 뗍니다"
                                    disabled="@(Busy || _uploading)"
                                    @onclick="@(() => DropFileAsync(f))">×</button>
                        </li>
                    }
                </ul>
            }

        </div>
        }

        @* 글상자 아래 한 줄 — 파일 첨부 아이콘과 보내기 단추. 알림 수단은 알림관리에서 정하므로 체크박스를 두지 않는다. *@
        <div class="pm-ask__bar">
            @* 자리가 다 차면 고르개를 감춘다 — 남겨 두면 바이트를 다 받은 뒤 거절당한다. 남은 자리와 상한은 감싼 상자의 title 이 말한다. *@
            @if (_attached.Count < MaxFiles)
            {
                <span class="pm-ask__pick" title="@FileHint">
                    <FilePicker @ref="_picker"
                                MaxFiles="@(MaxFiles - _attached.Count)"
                                MaxBytes="@MaxFileBytes"
                                MaxTotalBytes="@(MaxFileBytes * MaxFiles)"
                                ShowHint="false"
                                SelectionChanged="@OnSelectionChanged"
                                FilesChanged="@OnPickedAsync" />
                </span>
            }

            @* 권한 경로를 손으로 준다. 안 주면 서랍으로 열렸을 때 뒤에 깔린
               남의 화면으로 따져 보내기 단추가 소리 없이 사라진다. *@
            <PermissionView Action="MenuAction.Create" Path="@AskPath">
                <DxButton Text="@SendText"
                          RenderStyle="ButtonRenderStyle.Primary"
                          CssClass="pm-ask__go"
                          Enabled="@CanSend"
                          Click="@SendAsync" />
            </PermissionView>
        </div>

    </CommCont>

    @* ── 보낸 것 ────────────────────────────────────────── *@
    <CommCont CssClass="@ListPaneCss">
        @* 카드가 없으면 줄째 안 그린다 — 고르개만 남으면 빈 띠가 되어 카드가 밀려 내려간다. *@
        @if (_recent.Count > 0)
        {
            <div class="pm-ask__list-head">
                <div class="pm-ask__list-left">
                    <button type="button" class="pm-ask__batch-btn"
                            disabled="@(_batchConfirming || CompletedCount == 0)"
                            title="@(CompletedCount > 0 ? $"완료건 {CompletedCount}건 일괄 사용자확인" : "확인할 완료건이 없습니다")"
                            aria-label="완료건 일괄 사용자확인"
                            @onclick="ConfirmCompletedBatchAsync">
                        <span class="pm-ask__batch-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                                <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                            </svg>
                        </span>
                        <span class="pm-ask__batch-label">완료건 일괄확인</span>
                        @if (CompletedCount > 0)
                        {
                            <span class="pm-ask__batch-badge">@CompletedCount</span>
                        }
                    </button>
                </div>

                 @* 단 수 고르개. 한 벌만 적고 CSS 가 가른다 — 좁은 화면에서는 아이콘 하나가 1→2→3→4→1 을 돌고, 넉넉하면 네 칸이 한꺼번에 선다.
                    폭은 이 줄의 폭으로 잰다(서랍은 300px 까지 좁아진다). *@
                <div class="pm-ask__cols" role="group" aria-label="카드 단 수">
                    <button type="button" class="pm-ask__col-btn"
                            title="@($"가로 {_cols}단 (클릭 시 {NextCols}단)")"
                            aria-label="@($"가로 {_cols}단 보기, 클릭 시 {NextCols}단으로 전환")"
                            @onclick="CycleCols">
                        <span class="pm-ask__col-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                                @if (_cols == 1)
                                {
                                    <rect x="2" y="2" width="12" height="12" rx="1.5" />
                                }
                                else if (_cols == 2)
                                {
                                    <rect x="2" y="2" width="5.5" height="12" rx="1" />
                                    <rect x="8.5" y="2" width="5.5" height="12" rx="1" />
                                }
                                else if (_cols == 3)
                                {
                                    <rect x="1.5" y="2" width="3.7" height="12" rx="1" />
                                    <rect x="6.15" y="2" width="3.7" height="12" rx="1" />
                                    <rect x="10.8" y="2" width="3.7" height="12" rx="1" />
                                }
                                else
                                {
                                    <rect x="1" y="2" width="2.8" height="12" rx="0.75" />
                                    <rect x="4.7" y="2" width="2.8" height="12" rx="0.75" />
                                    <rect x="8.5" y="2" width="2.8" height="12" rx="0.75" />
                                    <rect x="12.2" y="2" width="2.8" height="12" rx="0.75" />
                                }
                            </svg>
                        </span>
                        <span class="pm-ask__col-num">@($"{_cols}단")</span>
                    </button>

                     @* 넓은 화면 쪽. 고른 칸은 aria-pressed 로 가른다 — disabled 로 잠그면 읽어 주는 장치가 못 쓰는 단추로 읽는다. *@
                    <span class="pm-ask__cols-label" aria-hidden="true">단</span>

                    @foreach (var n in ColChoices)
                    {
                        <button type="button" class="pm-ask__col"
                                aria-pressed="@(_cols == n ? "true" : "false")"
                                title="@($"가로 {n}단으로 깔기")"
                                @onclick="@(() => SetCols(n))">@n</button>
                    }
                </div>
            </div>
        }

        <div class="pm-ask__scroll">
            @* 쓸어내려 새로고침하는 인디케이터. 카드 뒤로 가려지지 않게 배지로 전면에 띄운다. *@
            <div class="pm-ask__pull" aria-hidden="true">
                <div class="pm-ask__pull-inner">
                    <span class="pm-ask__pull-icon">
                        <svg class="pm-ask__pull-arrow" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1z"/>
                        </svg>
                        <span class="pm-ask__pull-spinner"></span>
                    </span>
                    <span class="pm-ask__pull-text">당겨서 새로고침</span>
                </div>
            </div>

            @if (_recent.Count == 0 && !_recentLoaded)
            {
                @* 아직 묻는 중이다. 「없습니다」를 먼저 세우면 카드가 그것을 밀어내며
                   들어와 화면이 한 번 뒤집힌다. *@
            }
            else if (_recent.Count == 0)
            {
                <div class="pm-ask__empty-card">
                    <div class="pm-ask__empty-symbol" aria-hidden="true">
                        <span class="jsini-icon-robot"></span>
                    </div>
                    <h3 class="pm-ask__empty-title">아직 요청한 빠른 지시가 없습니다</h3>
                    <p class="pm-ask__empty-desc">
                        무엇을 시킬지 또는 궁금한 점을 위 입력창에 적어 보내보세요.<br />
                        AI가 백그라운드에서 작업을 수행하고 완료 시 보고서를 전송합니다.
                    </p>
                    <div class="pm-ask__prompts">
                        <button type="button" class="pm-ask__prompt-btn"
                                @onclick="@(() => SetPrompt("최근 커밋 변경 내역과 현재 브랜치 상태 요약해줘"))">
                            <span class="pm-ask__prompt-icon">💡</span>
                            <span class="pm-ask__prompt-text">최근 커밋 변경 내역과 브랜치 상태 요약해줘</span>
                        </button>
                        <button type="button" class="pm-ask__prompt-btn"
                                @onclick="@(() => SetPrompt("전체 아키텍처 테스트와 백엔드 테스트 실행하고 결과 알려줘"))">
                            <span class="pm-ask__prompt-icon">🧪</span>
                            <span class="pm-ask__prompt-text">전체 테스트 실행하고 결과 알려줘</span>
                        </button>
                        <button type="button" class="pm-ask__prompt-btn"
                                @onclick="@(() => SetPrompt("코드베이스의 미해결 TODO 및 개선 검토 항목 정리해줘"))">
                            <span class="pm-ask__prompt-icon">📝</span>
                            <span class="pm-ask__prompt-text">미해결 TODO 및 개선 검토 항목 정리해줘</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                @* 단 수는 격자에 실어 내린다(`--pm-ask-cols`) — 단마다 클래스를
                   두면 CSS 가 같은 규칙을 셋으로 베낀다. *@
                <ul class="pm-ask__list" data-cols="@_cols" style="--pm-ask-cols: @_cols">
                @foreach (var t in _recent)
                {
                     @* 카드 한 장이 건 하나. 끝난 건은 밀어서 확인 완료로 치운다(ask-swipe.js). 아직 도는 건에는 붙이지 않는다.
                        @key 가 없으면 가운데 한 장이 빠질 때 손짓이 엉뚱한 카드에 굳는다. *@
                    <li @key="t.TaskKey"
                        class="pm-ask__item pm-ask__item--@t.StatusTone pm-ask__item--cols-@_cols"
                        data-task="@t.TaskKey" data-swipe="@(t.IsFinal || t.IsDraft ? "1" : null)">

                        @if (t.IsFinal || t.IsDraft)
                        {
                            @* 미는 만큼만 넓어지는 띠(`--pm-ask-swipe`) — 가만히
                               있을 때는 폭이 0 이라 보이지 않는다. *@
                            <span class="pm-ask__ack" aria-hidden="true">
                                <span class="pm-ask__ack-mark">✓</span>
                                <span class="pm-ask__ack-text">확인</span>
                            </span>
                        }

                        <button type="button" class="pm-ask__head"
                                @onclick="@(() => PeekAsync(t.TaskKey))">
                            @* 지시자의 얼굴. 2단 이상에서는 제목 가독성을 위해 숨긴다(1단에서만 표시). *@
                            @if (_cols < 2)
                            {
                                <UserAvatar LoginId="@t.CreId" Card="false" CssClass="pm-face" />
                            }

                            <span class="pm-ask__rows">
                                <span class="pm-ask__line">
                                    @* 어느 AI 에게 간 건인지. 글자는 한 자뿐이고
                                       가르는 것은 색이라 `title` 로 이름을 단다. *@
                                    <span class="pm-ai pm-ai--@AiRunnerMark.Tone(t.RunnerKind)"
                                          title="@KindName(t.RunnerKind)">@AiRunnerMark.Letter(t.RunnerKind)</span>
                                    <span class="pm-ask__state" title="@t.StatusText">@StatusText(t, _cols)</span>
                                    @if (t.TurnCount >= 2)
                                    {
                                        @if (_cols < 4)
                                        {
                                            <span class="pm-ask__turn-badge" title="@($"처리차수 {t.TurnCount}차")">@($"{t.TurnCount}차")</span>
                                        }
                                    }
                                    @* 3단, 4단에서는 1번줄의 처리시간 숨김 (1단, 2단에서만 표시) *@
                                    @if (_cols < 3)
                                    {
                                        <span class="pm-ask__span">@AiTaskWhen.Elapsed(t)</span>
                                    }
                                </span>

                                @if (_cols <= 2)
                                {
                                    @* 1단, 2단: 2번째 줄에 시간, (1단만 대상), 배지, 제목이 한 줄로 말줄임되어 2줄 유지 *@
                                    <span class="pm-ask__line pm-ask__line--sub">
                                        <span class="pm-ask__when">@AiTaskWhen.RunAt(t, compact: true)</span>

                                        @* 대상은 1단에서만 표시 (2단 이상에서는 숨김) *@
                                        @if (_cols == 1 && TargetName(t) is { } targetName)
                                        {
                                            <span class="pm-ask__to"
                                                  title="@($"{TargetKindText(t)}: {targetName}")"
                                                  aria-label="@($"{TargetKindText(t)}: {targetName}")">@targetName</span>
                                        }

                                        @* 파일이 붙어 간 표시 — 개수만 적는다. *@
                                        @if (t.FileCount > 0)
                                        {
                                            <span class="pm-ask__clipmark"
                                                  title="@($"파일 {t.FileCount}개가 함께 갔습니다")">@t.FileCount</span>
                                        }

                                        @* 관리자가 답을 달았는데 아직 안 읽은 건.
                                           「안 읽음」은 올린 사람 기준이라 내 요청에만 적는다. *@
                                        @if (t.IsUserRequest && t.UnreadNoteCount > 0 && IsMine(t))
                                        {
                                            <span class="pm-ask__new"
                                                  title="관리자가 남긴 말이 있습니다">새 남긴말 @t.UnreadNoteCount</span>
                                        }

                                        <span class="pm-ask__title">@t.Title</span>
                                    </span>
                                }
                                else
                                {
                                     @* 3단·4단: 2번줄 시간, 3번째 줄 제목(1줄 말줄임). 4단은 3·4번줄에 걸쳐 제목(2줄). *@
                                    <span class="pm-ask__line pm-ask__line--sub">
                                        <span class="pm-ask__when">@AiTaskWhen.RunAt(t, compact: true)</span>

                                        @if (t.FileCount > 0)
                                        {
                                            <span class="pm-ask__clipmark"
                                                  title="@($"파일 {t.FileCount}개가 함께 갔습니다")">@t.FileCount</span>
                                        }

                                        @if (t.IsUserRequest && t.UnreadNoteCount > 0 && IsMine(t))
                                        {
                                            <span class="pm-ask__new"
                                                  title="관리자가 남긴 말이 있습니다">새 남긴말 @t.UnreadNoteCount</span>
                                        }
                                    </span>

                                    <span class="pm-ask__line pm-ask__line--title">
                                        <span class="pm-ask__title">@t.Title</span>
                                    </span>
                                }
                            </span>
                        </button>
                    </li>
                }
            </ul>

            @* 자르고 남은 것을 넉 장씩 더 꺼낸다. 격자 밖에 둔다 — 안에 넣으면 칸 하나를 차지해 빈자리가 생긴다. *@
            @if (Rest > 0 || _more > 0)
            {
                <div class="pm-ask__more">
                    @if (Rest > 0)
                    {
                        <DxButton Text="@($"더보기 {Rest}건")"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  CssClass="pm-ask__morego"
                                  Click="@ShowMore" />
                    }

                    @if (_more > 0)
                    {
                        <DxButton Text="접기"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  CssClass="pm-ask__fold"
                                  Click="@Fold" />
                    }
                </div>
            }
        }

            @* 휴대폰에서 목록 끝까지 굴리면 단추와 같은 만큼 더 펼친다.
               감지점은 늘 DOM 에 둬야 관찰을 이어 갈 수 있다. *@
            <span class="pm-ask__more-sentinel"
                  aria-hidden="true"
                  @ref="_moreSentinel"></span>
        </div>
    </CommCont>
</div>
