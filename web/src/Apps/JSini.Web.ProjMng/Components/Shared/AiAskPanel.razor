                    IsActive="_isPhone" IsActiveChanged="@(v => _isPhone = v)" />

@* 상자에 **이 부품만의 id** 를 단다. 글상자를 잡는 JS(`ask-draft.js`)가
   `document.querySelector` 로 하나만 집는데, 화면과 서랍이 함께 떠 있으면
   `.pm-ask__text` 가 둘이라 **둘 다 헤더 쪽(문서에서 앞선다) 글상자를 잡는다** —
   화면에서 친 글자가 아무 데도 안 적힌다. id 로 제 상자 안에서만 찾게 한다. *@
<div class="pm-ask" id="@_domId">

    @* ── 적는 자리 ──────────────────────────────────────── *@
    <CommCont>

        @if (_targets.Count == 0)
        {
            @* 대상이 없으면 보낼 수가 없다. **단추를 회색으로 두고 말없이
               두지 않는다** — 어디로 가야 하는지 적는다. *@
            <PageNotice Tone="NoticeTone.Warning"
                        Text="쓸 수 있는 작업 대상이 없습니다. 「AI 작업 대상」 화면에서 먼저 등록하십시오." />
        }

        <div class="pm-ask__where">
            @* 고른 값은 **칸을 바꾸는 그 자리에서** 기억된다(`Pick*` 속성).
               보낼 때 기억하지 않는 이유는, 고르기만 하고 안 보낸 채 나가는
               일이 흔한데 그때 다음번에 또 같은 것을 고르게 되기 때문이다. *@
            <DxComboBox Data="@_targets" @bind-Value="PickTarget"
                        TextFieldName="@nameof(AiTargetDto.TargetNm)"
                        ValueFieldName="@nameof(AiTargetDto.TargetKey)"
                        NullText="어디에서 일할지"
                        CssClass="pm-ask__target"
                        Enabled="@(!Busy && _targets.Count > 0)" />

            <DxComboBox Data="@RunnerKinds" @bind-Value="PickKind"
                        TextFieldName="@nameof(PickOption.Text)"
                        ValueFieldName="@nameof(PickOption.Value)"
                        CssClass="pm-ask__kind"
                        Enabled="@(!Busy && AllowedKinds.Count > 1)" />
        </div>

        @* 글상자 하나. `autofocus` 를 걸지 않는다 — 모바일에서 그것은
           **들어오자마자 자판이 올라와 화면 절반을 먹는다**는 뜻이고,
           최근 보낸 것을 확인하러 들어온 사람에게는 방해다.

           [치는 대로 넘기되 `@@bind-Text:event="oninput"` 은 안 된다]

           그렇게 걸면 **회로가 그 자리에서 끊긴다** — 화면이 통째로 죽고
           「unhandled exception on the current circuit」만 남는다.
           DevExpress 편집기는 평범한 `input` 이 아니라 자기 사용자 정의
           요소라서, Blazor 가 그 이름의 이벤트를 걸 자리를 못 찾는다.
           **빌드는 통과하므로 쳐 봐야 안다.**

           이 저장소가 이미 두 곳에 적어 둔 함정이다(`LockScreen` ·
           `ParticipationBoard`). 부품이 주는 `BindValueMode` 를 쓴다.

           [왜 `OnLostFocus`(기본값)로 두지 않나]

           단추가 「적은 것이 있나」로 켜지는데, 기본값이면 **칸을 떠나기
           전까지 값이 안 넘어와** 다 적고도 단추가 회색이다. 모바일에서는
           칸 밖을 탭할 일이 없어 그대로 막힌다.

           `InputDelay` 는 타자 왕복을 묶는 값이다. 찾기 칸은 200ms 지만
           여기는 서버에 아무것도 묻지 않고 단추 하나만 켜므로 넉넉히 둔다. *@
        <DxMemo @bind-Text="Text"
                BindValueMode="BindValueMode.OnInput"
                InputDelay="300"
                Rows="6"
                CssClass="pm-ask__text"
                NullText="무엇을 시킬지, 또는 무엇이 궁금한지 적으십시오. 첫 줄이 제목이 됩니다."
                Enabled="@(!Busy)" />

        @if (_draftRestored)
        {
            <div class="pm-ask__draft">
                <span class="pm-ask__draft-text">
                    작성 중이던 내용을 복원했습니다@(_draftSavedAt.HasValue ? $" ({_draftSavedAt.Value:MM-dd HH:mm})" : "").
                </span>
                <button type="button" class="pm-ask__draft-clear" @onclick="ClearDraftAsync">
                    내용 비우기
                </button>
            </div>
        }

        @* ── 함께 보내는 파일 ─────────────────────────────────

           [왜 글상자 바로 아래인가]

           적다가 「아, 이 화면을 보여 줘야겠다」가 되는 자리라 글과 붙어
           있어야 한다. 단추 줄(`pm-ask__bar`) 안에 끼우면 좁은 화면에서
           그 줄이 두 층으로 풀리고, 그때 단추가 자판 밑으로 내려간다.

           [고르는 순간 올린다 — 단추를 누를 때가 아니다]

           사진 한 장이 몇 MB 다. 보낼 때 몰아 올리면 **단추를 누른 뒤
           한참 아무 일도 안 일어나는 것처럼 보이고**, 그 사이에 화면을
           떠나면 통째로 사라진다. 고르는 순간 올려 두면 기다리는 시간이
           「고르는 동작」 안에 들어가고, 보내기는 번호만 싣는다.

           그때는 작업 번호가 아직 없어서 서버가 **주인 없이** 담아 둔다.
           보낼 때 그 번호들을 실어 보내면 묶인다(`AiTaskFileService`).

           [붙인 것은 우리가 그린다]

           `FilePicker` 안의 DevExpress 목록은 **올리고 나서 비운다**
           (`ClearAsync`). 안 비우면 같은 파일이 두 벌로 보이고 — 그쪽
           목록과 아래 칩 — 다음에 고를 때 앞엣것까지 다시 올라간다.

           [다 올라가기 전에는 못 보낸다]

           `CanSend` 가 `_uploading` 을 본다. 안 보면 올리는 중에 누른 건이
           **번호가 덜 실린 채** 나가고, 사람은 붙인 줄 알고 있다. *@
        <div class="pm-ask__files">
            @if (_selectedFileNames.Count > 0)
            {
                <div class="pm-ask__selected" aria-live="polite">
                    <span>선택됨</span>
                    <span>@string.Join(", ", _selectedFileNames)</span>
                </div>
            }

            @if (_attached.Count > 0)
            {
                <ul class="pm-ask__clips">
                    @foreach (var f in _attached)
                    {
                        <li class="pm-ask__clip" title="@($"{f.FileNm} · {f.SizeText}")">
                            @* 그림은 그림으로 보여 준다. 이름만 늘어놓으면
                               「어느 화면을 찍은 것이었나」를 알 수 없어 뗄지
                               말지를 못 정한다. 그림이 아닌 것은 클립 표시다. *@
                            @if (f.IsImage)
                            {
                                <img class="pm-ask__clipimg"
                                     src="@FileDownload.AiTaskUrlFor(f.FileKey)" alt="@f.FileNm" />
                            }
                            else
                            {
                                <span class="pm-ask__clipicon" aria-hidden="true"></span>
                            }

                            <span class="pm-ask__clipname">@f.FileNm</span>
                            <span class="pm-ask__clipsize">@f.SizeText</span>

                            <button type="button" class="pm-ask__clipx"
                                    title="이 첨부를 뗍니다"
                                    disabled="@(Busy || _uploading)"
                                    @onclick="@(() => DropFileAsync(f))">×</button>
                        </li>
                    }
                </ul>
            }

            @* 자리가 다 차면 고르개를 감춘다. 남겨 두면 고를 수는 있는데
               올리는 자리에서 거절당한다 — 그때는 이미 바이트를 다 받은
               뒤다(`FilePicker` 가 총량을 먼저 막는 것과 같은 까닭). *@
            @if (_attached.Count < MaxFiles)
            {
                <FilePicker @ref="_picker"
                            MaxFiles="@(MaxFiles - _attached.Count)"
                            MaxBytes="@MaxFileBytes"
                            MaxTotalBytes="@(MaxFileBytes * MaxFiles)"
                            Hint="@FileHint"
                            SelectionChanged="@OnSelectionChanged"
                            FilesChanged="@OnPickedAsync" />
            }
        </div>

        @* 글상자 바로 아래 **한 줄**이다 — 올리기 · 메일 · 보내기.

           예전에는 올리기가 제 줄을 갖고 그 아래에 단추 줄이 따로 있었다.
           칸이 둘로 늘면서 그 모양은 **글상자와 단추 사이에 두 줄**이 되는데,
           자판이 올라온 화면에서 그 두 줄은 곧 단추가 자판 밑으로 내려간다는
           뜻이다. 한 줄로 묶으면 **적던 손이 그대로 단추에 닿는다.**

           체크칸 둘이 왼쪽, 단추가 오른쪽 끝이다(`margin-left:auto`) —
           누르려고 내리는 손가락이 체크칸을 스치지 않게 떼어 둔다.
           좁아지면 단추가 아래로 내려가 한 줄을 다 쓴다(CSS 참고). *@
        <div class="pm-ask__bar">
            @* 글자를 `<span>` 으로 옆에 두지 않는다. **부품 안에 넣으면
               DevExpress 가 그것까지 누르는 자리로 만든다** — 모바일에서
               14px 짜리 네모만 겨누게 하지 않으려는 것이고, 「AI 작업」
               화면의 같은 칸도 이 모양이다.

               글자는 짧게 둔다 — 한 줄에 셋이 서는 자리라 칸마다 설명을
               달면 줄이 도로 풀린다. 켜짐·꺼짐은 네모 자신이 말하므로
               아래에 풀어 적는 줄을 따로 두지 않는다. *@
            <DxCheckBox @bind-Checked="@MailOn"
                        CssClass="pm-ask__opt"
                        Enabled="@(!Busy)">
                이메일
            </DxCheckBox>

            <DxCheckBox @bind-Checked="@PwaOn"
                        CssClass="pm-ask__opt"
                        Enabled="@(!Busy)">
                앱알림
            </DxCheckBox>

            @* **경로를 손으로 준다.** 안 주면 `PermissionView` 가 「지금 열려
               있는 화면」으로 따지는데, 서랍으로 열렸을 때 그것은 사람이
               보고 있던 남의 화면이다 — 열람만 되는 화면을 보다가 ⚡ 를
               누르면 보내기 단추가 소리 없이 사라진다. 이 알맹이의 권한은
               언제나 「빠른 지시」 화면의 것이다. *@
            <PermissionView Action="MenuAction.Create" Path="@AskPath">
                <DxButton Text="@SendText"
                          RenderStyle="ButtonRenderStyle.Primary"
                          CssClass="pm-ask__go"
                          Enabled="@CanSend"
                          Click="@SendAsync" />
            </PermissionView>
        </div>

        @* 여기에 설명 줄을 두지 않는다 (2026-09-24).

           한동안 단추 아래에 한 줄(`SendNote`)이 있어 올리기가 어느 쪽인지 ·
           메일이 가는지를 풀어 적었고, 보낸 뒤에는 「보냈습니다 — …」 안내가
           한 줄 더 섰다. 둘 다 **화면에 이미 있는 것을 다시 말하는 글**이다 —
           올리기는 단추 글자(`SendText`)와 묻는 창이, 메일·앱알림은 체크칸
           자신이, 보냈다는 사실은 토스트와 바로 아래 카드가 말한다.

           휴대폰에서 그 두 줄은 **글상자와 카드 사이를 벌려** 방금 보낸 것이
           자판 밖으로 밀려나게 했다. 「길에서 한 줄 던지는 자리」라는 이 화면의
           전제와 정면으로 어긋난다.

           보낸 결과는 토스트가 말한다(`RunAsync` 의 `okMessage`) — 잠깐 떴다
           지는 것이 맞는 종류고, 그것이 이 저장소의 규칙이다(`PageNotice` 머리말). *@
    </CommCont>

    @* ── 보낸 것 ──────────────────────────────────────────

       제목을 달지 않는다. 이 판 위가 보내는 자리고 그 바로 아래에 카드가
       깔리면 **그것이 방금 보낸 것들이라는 사실은 자리로 이미 말한다.**
       모바일에서 제목 한 줄은 카드 한 층만큼의 높이다. *@
    <CommCont>
        @if (_recent.Count == 0)
        {
            <PageNotice Tone="NoticeTone.Info" Text="아직 보낸 것이 없습니다." />
        }
        else
        {
            @* ── 몇 단으로 깔 것인가 (2026-09-25) ───────────────

               한동안 **둘씩** 하나뿐이었다. 그런데 같은 알맹이가 뜨는 자리가
               셋이다 — 세로로 쥔 휴대폰 · 헤더에서 여는 서랍(좁고 길다) ·
               책상의 넓은 화면. 한 벌의 수로는 그 셋을 다 맞출 수 없다.

                 · 휴대폰에서 반 폭이면 제목이 **두어 낱말 만에** 잘린다.
                   무엇을 시킨 건인지가 사라지면 상태만 남아도 소용이 없다.
                 · 넓은 화면에서 두 장은 한 줄을 다 못 쓴다. 카드가 옆으로
                   늘어져 오른쪽이 허옇게 남고, 그만큼 세로로 길어진다.

               그래서 **사람이 고른다.** 고른 것은 기억한다
               (`AiAskPrefs.ListCols`, 브라우저) — 기기마다 다른 것이 맞는
               값이라 서버가 아니다. 왜 브라우저인지는 그 파일 머리말에.

               자리는 목록 **위 오른쪽**이다. 아래 「더보기」 줄에 붙이면
               **카드가 적을 때 그 줄이 아예 안 서서** 고르는 길이 사라진다.

               글자는 숫자뿐이다. 카드 한 층도 안 되는 높이에 「1단·2단·3단」
               여섯 글자를 밀어 넣을 이유가 없고, 무엇을 고르는 줄인지는
               왼쪽의 「단」이 말한다. 화면 낭독기에는 `title` 이 온 말을
               읽어 준다.

               **좁다고 되돌리지 않는다.** 휴대폰에서 셋을 고른 사람은 제목이
               잘리는 것을 알고 고른 것이다(한눈에 몇 장 보는 쪽을 택했다).
               화면 폭이 그 선택을 말없이 덮으면 「눌렀는데 안 바뀐다」가 된다. *@
            <div class="pm-ask__cols" role="group" aria-label="카드 단 수">
                <span class="pm-ask__cols-label">단</span>

                @foreach (var n in ColChoices)
                {
                    <button type="button" class="pm-ask__col"
                            aria-pressed="@(_cols == n ? "true" : "false")"
                            title="@($"가로 {n}단으로 깔기")"
                            @onclick="@(() => SetCols(n))">@n</button>
                }
            </div>

            @* 단 수는 **격자에 실어 내린다**(`--pm-ask-cols`). 단마다 클래스를
               따로 두면 CSS 가 같은 규칙을 셋으로 베끼고, 넷째 단을 더하는
               날 고칠 자리가 또 둘이 된다. *@
            <ul class="pm-ask__list" style="--pm-ask-cols: @_cols">
                @foreach (var t in _recent)
                {
                    @* 카드 한 장이 건 하나고 **얼굴 하나 + 두 층**이다.

                       왼쪽이 지시자의 얼굴이고(바로 아래 주석), 오른쪽 윗층이
                       「끝났나 · 얼마나 걸렸나」(상태 · 총작업시간), 아랫층이
                       「언제 · 무엇을」(실행일시 · 제목)이다. 중요한 것을 위와
                       왼쪽에 몰아 둔다 — 반 폭 카드에서 잘리는 것은
                       **제목 꼬리뿐**이고, 그 자리는 눌러서 본다.

                       상태는 **카드의 색**이기도 하다(`pm-ask__item--@t.StatusTone`).
                       왼쪽 띠와 상태 글자가 같은 색을 쓰므로 **훑을 때는 색으로,
                       확인할 때는 글자로** 읽는다.

                       윗층 맨 앞의 배지가 **어느 AI 에게 간 건인지**다
                       (`AiRunnerMark`). 글자는 한 자뿐이고 가르는 것은 색이다 —
                       고를 수 있는 AI 가 셋인데 그중 둘(Claude · Copilot)이
                       같은 「C」다. 여기에 이름을 그대로 적으면 **제목이 쓰던
                       폭을 먹는다.** 색을 못 보는 사람을 위해 `title` 로
                       전체 이름을 단다(공통코드에서 읽은 그 이름이다). *@
                    @* 왼쪽에 **지시자의 얼굴**이 선다. 두 층 옆에 세로로
                       가운데를 맞춰 두는 이유는 좁은 카드에서 윗줄에 끼워
                       넣으면 상태·시간과 폭을 다투기 때문이다 — 얼굴은
                       두 층 모두에 걸리는 값(「이 건은 누구 것인가」)이라
                       어느 한 줄에 속하지도 않는다.

                       사진이 없는 사람은 이름 첫 글자다. 헤더의 사용자
                       단추와 같은 규칙이고(`CurrentUser.Initial`), 얼굴을
                       아직 못 읽었을 때도 그 자리는 비지 않는다 —
                       아이디 첫 글자가 대신 선다.

                       그리는 일은 `UserFaceMark` 가 한다 — **카드를 눌러 여는
                       상세도 같은 얼굴을 세우기 때문이다**(`AiTaskView`).
                       받아 오는 일은 여전히 이 화면 몫이다(`LoadRecentAsync`) —
                       카드마다 묻게 두면 화면 하나가 게이트웨이를 넉 장만큼
                       두드린다. *@
                    @* ── 오른쪽으로 밀면 사용자 확인 완료 (2026-09-25) ──

                       이 목록은 **아직 확인 안 한 것만** 받아 온다
                       (`userConfirmed: false`). 그러니 카드가 쌓이는 것을
                       줄이는 길은 하나뿐인데, 여태 그 길이 **카드를 열고 →
                       창이 뜨기를 기다리고 → 「확인」을 누르고 → 창을 닫는**
                       네 걸음이었다(`AiTaskActions`). 끝난 건 열 장을 치우면
                       마흔 번이다.

                       밀어서 치우는 것은 그 넷을 **손짓 하나**로 줄인다.
                       휴대폰에서 목록을 정리하는 흔한 방법이기도 하다.

                       **끝난 건에만 붙인다**(`IsFinal`). 아직 도는 건은
                       확인할 결과가 없고, 밀려 사라지면 **그 건을 다시 볼
                       길이 이 화면에서 없어진다.**

                       `@@key` 를 여기 두는 것이 이 기능의 전제다. 없으면
                       Blazor 가 카드를 차례로 대조해서, 가운데 한 장이 빠질 때
                       **맨 끝 것을 지우고 나머지 글자만 밀어 올린다** —
                       손짓이 붙어 있던 그 DOM 이 다른 건의 카드가 되어
                       스러지는 중이던 모습 그대로 굳는다.

                       밀 수 없는 자리(키보드 · 화면 낭독기)를 위해 카드를
                       열면 나오는 「사용자확인완료」 단추는 그대로 둔다.
                       손짓은 **빠른 길**이지 유일한 길이 아니다. *@
                    <li @key="t.TaskKey"
                        class="pm-ask__item pm-ask__item--@t.StatusTone"
                        data-task="@t.TaskKey" data-swipe="@(t.IsFinal ? "1" : null)">

                        @if (t.IsFinal)
                        {
                            @* 카드 **왼쪽**에서 열리는 띠. 미는 만큼만 넓어지므로
                               (`--pm-ask-swipe`) 가만히 있을 때는 폭이 0 이라
                               보이지 않는다 — 카드 밑에 깔아 두고 덮는 방식이
                               아니라서 **카드에 불투명한 바탕을 깔 필요가 없다**
                               (바탕을 깔면 테마 스물둘에서 판 색과 어긋나는 쪽이
                               반드시 나온다). *@
                            <span class="pm-ask__ack" aria-hidden="true">
                                <span class="pm-ask__ack-mark">✓</span>
                                <span class="pm-ask__ack-text">확인</span>
                            </span>
                        }

                        <button type="button" class="pm-ask__head"
                                @onclick="@(() => Peek(t.TaskKey))">
                            <UserFaceMark LoginId="@t.CreId" />

                            <span class="pm-ask__rows">
                                <span class="pm-ask__line">
                                    <span class="pm-ask__ai pm-ask__ai--@AiRunnerMark.Tone(t.RunnerKind)"
                                          title="@KindName(t.RunnerKind)">@AiRunnerMark.Letter(t.RunnerKind)</span>
                                    <span class="pm-ask__state">@t.StatusText</span>
                                    <span class="pm-ask__span">@AiTaskWhen.Elapsed(t)</span>
                                </span>

                                <span class="pm-ask__line pm-ask__line--sub">
                                    <span class="pm-ask__when">@AiTaskWhen.RunAt(t, compact: true)</span>

                                    @* 파일이 붙어 간 건이라는 표시. **개수만 적는다** —
                                       반 폭 카드에서 이름까지 적으면 제목이 먹는 자리를
                                       빼앗는다. 무엇이 붙었는지는 눌러서 본다. *@
                                    @if (t.FileCount > 0)
                                    {
                                        <span class="pm-ask__clipmark"
                                              title="@($"파일 {t.FileCount}개가 함께 갔습니다")">@t.FileCount</span>
                                    }

                                    @* 관리자가 답을 달았는데 아직 안 읽은 건.
                                       **상태 배지로는 답할 수 없는 물음이다** —
                                       관리자가 말만 남기고 대상·AI 를 아직 안
                                       채웠으면 상태는 그대로 「작성중」이다.

                                       **내가 올린 요청에만 적는다.** 이 목록은
                                       남이 보낸 것도 함께 깔리는데(`LoadRecentAsync`),
                                       「안 읽음」은 **그 건을 올린 사람이
                                       읽었나**라서 남의 카드에 세우면 거짓말이
                                       된다. *@
                                    @if (t.IsUserRequest && t.UnreadNoteCount > 0 && IsMine(t))
                                    {
                                        <span class="pm-ask__new"
                                              title="관리자가 남긴 말이 있습니다">새 남긴말 @t.UnreadNoteCount</span>
                                    }

                                    <span class="pm-ask__title">@t.Title</span>
                                </span>
                            </span>
                        </button>
                    </li>
                }
            </ul>

            @* 넉 장 밖으로 밀린 것을 여기서 꺼낸다. 격자 밖에 두는 이유는
               안에 넣으면 반 폭 칸 하나를 차지해 옆에 빈자리가 생기기 때문이다.
               서버를 다시 부르지 않는다 — 위 머리말 참고. *@
            @if (Rest > 0 || _more > 0)
            {
                <div class="pm-ask__more">
                    @if (Rest > 0)
                    {
                        <DxButton Text="@($"더보기 {Rest}건")"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  CssClass="pm-ask__morego"
                                  Click="@ShowMore" />
                    }

                    @if (_more > 0)
                    {
                        <DxButton Text="접기"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  CssClass="pm-ask__fold"
                                  Click="@Fold" />
                    }
                </div>
            }
        }
    </CommCont>

    @* 카드를 누르면 여기서 연다. 지시 · 결과 · 로그를 탭으로 나눠 담고,
       **휴대폰에서는 화면을 꽉 채운다.** 무엇을 펴서 열지는 그 창이 상태로
       고른다 — 위 머리말 참고. *@
    <AiTaskPeek Item="@PeekItem" Visible="@(_peek is not null)"
                VisibleChanged="@OnPeekVisible"
                OnRetried="@OnPeekRetriedAsync" />
</div>
