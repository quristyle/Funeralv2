@*
    [보낸 한 건에 대고 할 수 있는 일 — 이어서 지시 · 재시도 · 확인 · 자세히]

    설계: docs/ai-task-runner.md

    `AiTaskView`(보여 주는 쪽)와 갈라 둔다. 같은 단추가 서는 자리가 둘인데
    **모양이 다르기** 때문이다 — 창에서는 바닥 띠(`FooterContentTemplate`)에
    서고, 탭으로 열린 화면에서는 본문 끝에 선다. 보여 주는 판과 한 덩어리로
    두면 창의 바닥 단추를 본문 안으로 끌어들이게 된다.

    [상태를 여기서 들고 있지 않는다]

    요청이 끝나면 `OnChanged` 로 알리기만 하고 `Item` 은 부모가 갈아 준다.
    여기서 `Item` 에 새 값을 꽂아 두면 **부모가 5초마다 넘기는 값과 둘이
    어긋난다** — 어긋나는 쪽이 늘 「방금 누른 결과가 사라지는」 쪽이다.

    [묻는 창 둘은 이 부품이 들고 있다]

    재시도와 이어서 지시는 **추가로 적을 것을 받고** 나간다. 그 글상자를
    부모마다 다시 만들면 두 벌이 갈리므로 단추와 함께 둔다.
*@

@inject AiTaskClient Api
@inject NavigationManager Nav

@if (Item is { } t)
{
    @if (t.TaskStatus == "succeeded")
    {
        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_retrying && !_confirming && !_continuing)"
                  Click="@OpenContinueModal">
            <span class="pm-peek__btn-text--full">이어서 지시</span>
            <span class="pm-peek__btn-text--short">이어서</span>
        </DxButton>
    }

    @if (t.CanManualRetry)
    {
        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_retrying && !_confirming && !_continuing)"
                  Click="@OpenRetryModal">
            <span class="pm-peek__btn-text--full">재시도</span>
            <span class="pm-peek__btn-text--short">재시도</span>
        </DxButton>
    }

    @if (t.IsFinal && !t.UserConfirmed)
    {
        <DxButton RenderStyle="ButtonRenderStyle.Success"
                  Enabled="@(!_retrying && !_confirming && !_continuing)"
                  Click="@DoConfirmAsync">
            <span class="pm-peek__btn-text--full">사용자확인완료</span>
            <span class="pm-peek__btn-text--short">확인</span>
        </DxButton>
    }

    @if (ShowDetail)
    {
        @* 자세히 보려면 큰 화면으로 보낸다. 로그 수천 줄과 편집기는 창에
           들어올 것이 아니다.

           **번호를 실어 보낸다**(`?task=`). 안 실으면 저쪽은 맨 앞 건을 열고,
           그러면 방금 보던 건을 목록에서 다시 찾아야 한다. *@
        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => GoDetail(t.TaskKey))">
            <span class="pm-peek__btn-text--full">자세히 보기</span>
            <span class="pm-peek__btn-text--short">자세히</span>
        </DxButton>
    }
}

@* 실패한 작업의 수동 재시도 시 추가 지시사항을 받는 창 *@
<CommPopup @bind-Visible="_retryOpen" HeaderText="수동 재시도"
           Width="min(36rem, calc(100vw - 2rem))"
           CloseOnOutsideClick="false">
    <BodyContentTemplate>
        <PageNotice Tone="NoticeTone.Info"
                    Text="실패한 작업을 다시 요청합니다. 추가 지시사항이 있으면 적으십시오. (비워두면 기존 지시 그대로 다시 시도합니다)" />

        <DxMemo @bind-Text="_retryAddition" Rows="5"
                NullText="추가 지시사항 (선택사항)"
                CssClass="pm-peek__memo" />

        @if (!string.IsNullOrWhiteSpace(_retryError))
        {
            <PageNotice Tone="NoticeTone.Error" Text="@_retryError" />
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="재시도 요청" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!_retrying)"
                  Click="@DoRetryAsync" />
        <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_retrying)"
                  Click="@CloseRetryModal" />
    </FooterContentTemplate>
</CommPopup>

@* 완료된 작업에 이어서 지시하기 *@
<CommPopup @bind-Visible="_continueOpen" HeaderText="이어서 지시"
           Width="min(36rem, calc(100vw - 2rem))"
           CloseOnOutsideClick="false">
    <BodyContentTemplate>
        <PageNotice Tone="NoticeTone.Info"
                    Text="지난 진행(요약과 바뀐 파일)은 서버가 앞에 붙입니다. 여기에는 이번에 더 시킬 일만 적으십시오." />

        <DxMemo @bind-Text="_continueAddition" Rows="5"
                NullText="이번에 더 시킬 일"
                CssClass="pm-peek__memo" />

        @if (!string.IsNullOrWhiteSpace(_continueError))
        {
            <PageNotice Tone="NoticeTone.Error" Text="@_continueError" />
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="이어서 지시 요청" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!string.IsNullOrWhiteSpace(_continueAddition) && !_continuing)"
                  Click="@DoContinueAsync" />
        <DxButton Text="취소" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_continuing)"
                  Click="@CloseContinueModal" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>단추가 걸릴 건. 부모가 갈아 준다.</summary>
    [Parameter] public AiTaskDto? Item { get; set; }

    /// <summary>요청이 나갔다(재시도 · 이어서 지시). 부모가 목록을 다시 읽는다.</summary>
    [Parameter] public EventCallback<AiTaskDto> OnChanged { get; set; }

    /// <summary>
    /// 사용자확인이 끝났다. 창은 <b>닫히고</b> 화면은 그 자리에 남으므로
    /// <see cref="OnChanged"/> 와 따로 둔다.
    /// </summary>
    [Parameter] public EventCallback<AiTaskDto> OnConfirmed { get; set; }

    /// <summary>
    /// 「자세히 보기」를 그리나. <b>「AI 작업」 화면으로 보내는 단추</b>라
    /// 창에서만 뜻이 있다 — 탭으로 열린 화면은 이미 큰 화면이다.
    /// </summary>
    [Parameter] public bool ShowDetail { get; set; } = true;

    private bool _retryOpen;
    private bool _retrying;
    private string? _retryAddition;
    private string? _retryError;

    private bool _continueOpen;
    private bool _continuing;
    private string? _continueAddition;
    private string? _continueError;

    private bool _confirming;

    private void OpenRetryModal()
    {
        _retryAddition = null;
        _retryError = null;
        _retryOpen = true;
    }

    private void CloseRetryModal()
    {
        if (_retrying) return;
        _retryOpen = false;
        _retryAddition = null;
        _retryError = null;
    }

    private async Task DoRetryAsync()
    {
        if (Item is not { } t || _retrying)
        {
            return;
        }

        _retrying = true;
        _retryError = null;

        try
        {
            var updated = await Api.RetryAsync(t.TaskKey, _retryAddition);
            _retryOpen = false;

            if (updated is not null)
            {
                await OnChanged.InvokeAsync(updated);
            }
        }
        catch (ApiException ex)
        {
            _retryError = $"재시도 요청에 실패했습니다: {ex.Message}";
        }
        catch (Exception ex)
        {
            _retryError = $"재시도 요청 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _retrying = false;
        }
    }

    private void OpenContinueModal()
    {
        _continueAddition = null;
        _continueError = null;
        _continueOpen = true;
    }

    private void CloseContinueModal()
    {
        if (_continuing) return;
        _continueOpen = false;
        _continueAddition = null;
        _continueError = null;
    }

    private async Task DoContinueAsync()
    {
        if (Item is not { } t || _continuing)
        {
            return;
        }

        _continuing = true;
        _continueError = null;

        try
        {
            var addition = _continueAddition;
            if (!string.IsNullOrWhiteSpace(addition))
            {
                addition += "\n\n작업에 생성되는 파일이나 변경된 내용이 실제 작성되었는지 다시 확인하고, 모든 작업이 끝나면 반드시 main 브랜치에 commit과 push를 수행해라.";
            }

            var updated = await Api.ContinueAsync(t.TaskKey, addition!);
            if (updated is not null)
            {
                updated = await Api.RequestAsync(t.TaskKey);
                _continueOpen = false;

                if (updated is not null)
                {
                    await OnChanged.InvokeAsync(updated);
                }
            }
        }
        catch (ApiException ex)
        {
            _continueError = $"이어서 지시 요청에 실패했습니다: {ex.Message}";
        }
        catch (Exception ex)
        {
            _continueError = $"이어서 지시 요청 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _continuing = false;
        }
    }

    private async Task DoConfirmAsync()
    {
        if (Item is not { } t || _confirming)
        {
            return;
        }

        _confirming = true;

        try
        {
            var updated = await Api.ConfirmAsync(t.TaskKey);

            if (updated is not null)
            {
                await OnConfirmed.InvokeAsync(updated);
            }
        }
        catch (Exception)
        {
            // 확인 표시 하나 때문에 화면을 깨지 않는다. 다음에 다시 누르면 된다.
        }
        finally
        {
            _confirming = false;
        }
    }

    private void GoDetail(long taskKey) => Nav.NavigateTo($"/projmng/ai/tasks?task={taskKey}");
}
