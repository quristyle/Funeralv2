@*
    [요청 하나에 오가는 남길말]

    설계: docs/ai-task-runner.md · 서버
      microservices/ProjMngServer/Services/AiTaskNoteService.cs
    스키마: deploy/sql/projmng-ai-task-note-2026-09-25.sql

    ────────────────────────────────────────────────────────────
    [무엇을 푸는 자리인가]

    일반 사용자가 「AI 작업 요청」에 적어 올린 지시는 **저장만 되고 아무 데서도
    안 돈다.** 대상과 AI 를 관리자가 채워 줘야 비로소 실행된다. 그 사이가 짧지
    않은데, 관리자가 **「이건 이렇게 하겠습니다」·「무엇을 더 알려 주십시오」**
    를 말할 자리가 없었다. 올린 사람 쪽에서 그것은 **무시당한 것과 구분되지
    않는다.**

    그래서 지시문 옆에 오가는 말을 쌓는다. 적으면 **상대에게 앱푸시**가 가고,
    받은 사람은 눌러 들어와 그 말을 읽는다.

    [지시문(`contents`)에 적지 않는 까닭]

    그 글은 **실행기에게 그대로 가는 글**이다. 거기에 대화를 적으면 AI 가
    그것까지 지시로 읽고, 올린 사람이 적은 원문도 덮인다. 둘은 수명도 다르다 —
    지시문은 한 벌이고 대화는 계속 붙는다.

    ────────────────────────────────────────────────────────────
    [부품 하나가 두 자리에 선다]

    | 어디에 | `Mine` | 부르는 경로 |
    |---|---|---|
    | 「AI 작업 요청」(`AiRequestList`) | 참 | `…/mine/{번호}/notes` |
    | 관리자 상세(`AiTaskView` — 창·탭) | 거짓 | `…/{번호}/notes` |

    **경로를 가르는 것이 요점이다.** 앞엣것은 서버가 「그 요청을 올린
    사람인지」를 먼저 보고 아니면 「없다」로 답한다 — 뒤엣 경로를 일반
    사용자에게 쓰게 두면 번호만 바꿔 남의 요청에 붙은 말을 읽는다.

    [말풍선의 좌우는 **로그인한 사람으로 가르지 않는다**]

    왼쪽이 올린 사람, 오른쪽이 관리자다(`AiTaskNoteDto.IsOwner` — 서버가
    견준다). 「나인가」로 가르면 같은 대화가 두 화면에서 좌우가 뒤집혀 보이고,
    그러면 **누가 무슨 말을 했는지가 화면마다 달라진다.**

    [펴는 순간 읽은 것으로 찍는다 — `Mine` 일 때만]

    올린 사람이 이 판을 여는 것이 곧 읽는 일이다. 줄마다 「읽음」을 따로
    누르게 하면 아무도 누르지 않고, 그러면 목록의 「새 남긴말」 배지가 영영
    안 꺼진다.

    찍고 나면 부모에게 알린다(`OnRead`) — 목록이 들고 있는 건수는 서버에서
    한 번 읽어 온 값이라, 다시 읽지 않으면 배지가 그대로 남는다.
*@

@inject AiTaskClient Api
@inject UserFaceClient Faces
@inject Toasts Toasts

@if (Item is { } t)
{
    <div class="pm-note">
        <h3 class="pm-note__head">
            남긴 말
            @if (_rows.Count > 0)
            {
                <span class="pm-note__count">@_rows.Count</span>
            }
        </h3>

        @if (_rows.Count == 0)
        {
            <p class="pm-note__empty">@EmptyText</p>
        }
        else
        {
            <ul class="pm-note__list">
                @foreach (var n in _rows)
                {
                    @* 올린 사람은 왼쪽, 관리자는 오른쪽이다. 위 머리말 참고. *@
                    <li class="pm-note__item pm-note__item--@(n.IsOwner ? "owner" : "admin")">
                        <UserFaceMark LoginId="@n.CreId" CssClass="pm-note__face" />

                        <div class="pm-note__bubble">
                            <div class="pm-note__meta">
                                <span class="pm-note__who">@Who(n.CreId)</span>
                                <span class="pm-note__when">@n.WhenText</span>

                                @* 아직 안 읽은 줄. **관리자 쪽에서 뜻이 있다** —
                                   「내 말이 닿았나」에 답한다. 올린 사람 화면에서는
                                   펴는 순간 찍히므로 거의 보이지 않는다. *@
                                @if (!n.IsOwner && n.ReadDt is null)
                                {
                                    <span class="pm-note__unread">안 읽음</span>
                                }
                            </div>

                            <pre class="pm-note__text">@n.Contents</pre>
                        </div>
                    </li>
                }
            </ul>
        }

        @* ── 적는 자리 ────────────────────────────────────────
           **목록 아래다.** 위에 두면 새 말이 쌓일수록 방금 적힌 줄이 판
           바깥으로 밀려난다 — 여기는 시간 순으로 읽는 대화다. *@
        <div class="pm-note__write">
            @* `BindValueMode="OnInput"` 이다. 기본값으로 두면 다 적고도
               저장 단추가 회색이다 — 칸을 떠나기 전까지 값이 안 넘어온다
               (`AiRequestList` · `AiAskPanel` 이 같은 함정을 적어 두었다). *@
            <DxMemo @bind-Text="_text"
                    BindValueMode="BindValueMode.OnInput"
                    InputDelay="300"
                    Rows="3"
                    CssClass="pm-note__box"
                    NullText="@WriteHint"
                    Enabled="@(!_busy)" />

            <DxButton Text="남기기"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="pm-note__save"
                      Enabled="@CanSave"
                      Click="@SaveAsync" />
        </div>
    </div>
}

@code {
    /// <summary>말이 붙을 요청. <c>null</c> 이면 판이 통째로 빠진다.</summary>
    [Parameter] public AiTaskDto? Item { get; set; }

    /// <summary>
    /// <b>올린 사람의 자리인가.</b> 참이면 <c>mine</c> 경로를 쓰고, 펴는 순간
    /// 읽은 것으로 찍는다.
    /// </summary>
    [Parameter] public bool Mine { get; set; }

    /// <summary>
    /// 안 읽은 말을 읽은 것으로 찍었을 때 부모에게 알린다.
    /// <b>목록의 배지를 끄는 것이 부모의 일</b>이라서 있다.
    /// </summary>
    [Parameter] public EventCallback OnRead { get; set; }

    /// <summary>말이 하나 붙었다. 부모가 건수를 다시 읽는다.</summary>
    [Parameter] public EventCallback OnAdded { get; set; }

    private IReadOnlyList<AiTaskNoteDto> _rows = [];

    private string? _text;

    /// <summary>저장 중. 두 번 눌러 같은 말이 두 줄 붙는 것을 막는다.</summary>
    private bool _busy;

    /// <summary>지금 읽어 둔 건. <b>부모가 다른 건을 넘겼는지</b> 보는 값이다.</summary>
    private long _shown;

    /// <summary>
    /// 서버가 받는 한 줄의 길이(<c>AiTaskNoteService.MaxLength</c>).
    /// <b>화면도 같은 수로 막는다</b> — 갈라지면 저장을 눌러야만 알게 된다.
    /// </summary>
    private const int MaxLength = 2000;

    private bool CanSave => !_busy
                            && Item is not null
                            && !string.IsNullOrWhiteSpace(_text);

    private string EmptyText => Mine
        ? "아직 오간 말이 없습니다. 덧붙일 말이 있으면 아래에 적어 두십시오."
        : "아직 오간 말이 없습니다.";

    private string WriteHint => Mine
        ? "관리자에게 덧붙일 말을 적으십시오. 남기면 관리자에게 알림이 갑니다."
        : "요청한 사람에게 남길 말을 적으십시오. 남기면 그 사람에게 알림이 갑니다.";

    /// <summary>적은 사람의 이름. 아직 얼굴을 못 읽었으면 아이디다.</summary>
    private string Who(string? loginId) => Faces.Get(loginId)?.Name ?? loginId ?? "-";

    protected override async Task OnParametersSetAsync()
    {
        var key = Item?.TaskKey ?? 0;

        // 부모가 몇 초마다 같은 건을 다시 넘기는 자리가 있다(`AiTaskView` 의
        // 따라가기). **번호가 그대로면 다시 읽지 않는다** — 읽으면 적다 만
        // 글상자가 그릴 때마다 흔들린다.
        if (key == _shown)
        {
            return;
        }

        _shown = key;
        _text = null;
        _rows = [];

        if (key == 0)
        {
            return;
        }

        await LoadAsync(key);
    }

    private async Task LoadAsync(long taskKey)
    {
        try
        {
            _rows = Mine
                ? await Api.MineNotesAsync(taskKey)
                : await Api.NotesAsync(taskKey);
        }
        catch (ApiException ex)
        {
            // 판을 통째로 죽이지 않는다. 지시와 결과는 그대로 읽혀야 한다.
            _rows = [];
            Toasts.Show($"남긴 말을 읽지 못했습니다 — {ex.Message}", NoticeTone.Error);
            return;
        }

        // 얼굴은 **모아서 한 번에** 묻는다. 줄마다 묻게 두면 대화 열 줄짜리
        // 한 건이 게이트웨이를 열 번 두드린다(`UserFaceMark` 머리말).
        await Faces.EnsureAsync(_rows.Select(r => r.CreId));

        await MarkReadAsync(taskKey);
    }

    /// <summary>
    /// 펴는 순간 읽은 것으로 찍는다. <b>올린 사람의 자리에서만</b>이다.
    /// </summary>
    /// <remarks>
    /// <b>안 읽은 것이 있을 때만 부른다.</b> 이 판은 목록에서 줄을 누를 때마다
    /// 서고, 다 읽은 건에까지 쓰기 요청을 보내면 훑어보는 동안 게이트웨이를
    /// 계속 두드리게 된다.
    /// </remarks>
    private async Task MarkReadAsync(long taskKey)
    {
        if (!Mine || !_rows.Any(r => !r.IsOwner && r.ReadDt is null))
        {
            return;
        }

        try
        {
            await Api.ReadMineNotesAsync(taskKey);
        }
        catch (ApiException)
        {
            // **말없이 넘긴다.** 읽음 표시가 늦는 것뿐이고, 사람이 할 수 있는
            // 일이 없는 실패에 경고를 띄우면 읽으러 온 사람만 놀란다.
            return;
        }

        // 손에 쥔 것도 함께 고친다 — 다시 읽지 않으므로 이것을 안 고치면
        // 「안 읽음」 딱지가 화면에 그대로 남는다.
        foreach (var row in _rows.Where(r => !r.IsOwner && r.ReadDt is null))
        {
            row.ReadDt = DateTime.Now;
        }

        await OnRead.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (!CanSave || Item is not { } t)
        {
            return;
        }

        var text = (_text ?? string.Empty).Trim();

        if (text.Length > MaxLength)
        {
            Toasts.Show($"남길 말은 {MaxLength}자까지 적을 수 있습니다.", NoticeTone.Warning);
            return;
        }

        _busy = true;

        try
        {
            if (Mine)
            {
                await Api.AddMineNoteAsync(t.TaskKey, text);
            }
            else
            {
                await Api.AddNoteAsync(t.TaskKey, text);
            }
        }
        catch (ApiException ex)
        {
            Toasts.Show($"남기지 못했습니다 — {ex.Message}", NoticeTone.Error);
            return;
        }
        finally
        {
            _busy = false;
        }

        _text = null;
        Toasts.Show("남겼습니다. 상대에게 알림이 갑니다.");

        // **서버에서 다시 읽는다.** 방금 보낸 것을 손으로 목록에 끼워 넣으면
        // 그 사이에 상대가 남긴 줄이 빠진 채로 그려진다.
        await LoadAsync(t.TaskKey);
        await OnAdded.InvokeAsync();
    }

    /// <summary>
    /// <b>부모가 밖에서 다시 읽게 하는 문</b>. 부모가 목록을 새로 읽어
    /// 같은 건을 그대로 넘길 때는 <see cref="OnParametersSetAsync"/> 가
    /// 번호로 걸러 내므로, 그때는 이것을 불러 준다.
    /// </summary>
    public async Task ReloadAsync()
    {
        if (Item is { } t)
        {
            await LoadAsync(t.TaskKey);
            StateHasChanged();
        }
    }
}
