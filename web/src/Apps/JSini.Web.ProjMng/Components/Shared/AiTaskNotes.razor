@* 요청 하나에 오가는 남길말. 지시문(contents)에 적지 않는다 — 그 글은 실행기에게 그대로 가므로 대화를 적으면 AI 가 지시로 읽는다. 적으면 상대에게 앱푸시가 간다. *@
@* 부품 하나가 두 자리에 선다: 「AI 작업 요청」(Mine=참, …/mine/{번호}/notes)과 관리자 상세(Mine=거짓). 경로를 가르는 것이 요점이다 — 일반 사용자에게 뒤 경로를 주면 번호만 바꿔 남의 요청을 읽는다. 말풍선 좌우는 로그인한 사람이 아니라 IsOwner 로 가른다(화면마다 뒤집히지 않게). 펴는 순간 읽은 것으로 찍는다 — Mine 일 때만이고, 찍고 나면 OnRead 로 부모 건수를 다시 세게 한다. *@

@if (Item is { } t)
{
    <div class="pm-note">
        <h3 class="pm-note__head">
            남긴 말
            @if (_rows.Count > 0)
            {
                <span class="pm-note__count">@_rows.Count</span>
            }
        </h3>

        @if (_rows.Count == 0)
        {
            <p class="pm-note__empty">@EmptyText</p>
        }
        else
        {
            <ul class="pm-note__list">
                @foreach (var n in _rows)
                {
                    @* 올린 사람은 왼쪽, 관리자는 오른쪽이다. *@
                    <li class="pm-note__item pm-note__item--@(n.IsOwner ? "owner" : "admin")">
                        <UserAvatar LoginId="@n.CreId" CssClass="pm-face pm-note__face" />

                        <div class="pm-note__bubble">
                            <div class="pm-note__meta">
                                <span class="pm-note__who">@Who(n.CreId)</span>
                                <span class="pm-note__when">@n.WhenText</span>

                                @* 아직 안 읽은 줄. 관리자 쪽에서 뜻이 있다 — 「내 말이 닿았나」에 답한다. *@
                                @if (!n.IsOwner && n.ReadDt is null)
                                {
                                    <span class="pm-note__unread">안 읽음</span>
                                }
                            </div>

                            <pre class="pm-note__text">@n.Contents</pre>
                        </div>
                    </li>
                }
            </ul>
        }

        @* 목록 아래 — 시간 순으로 읽는 대화라서 적는 자리가 아래에 있다. *@
        <div class="pm-note__write">
            @* BindValueMode="OnInput" 이다 — 기본값이면 다 적고도 저장 단추가 회색이다(칸을 떠나야 값이 넘어온다). *@
            <DxMemo @bind-Text="_text"
                    BindValueMode="BindValueMode.OnInput"
                    InputDelay="300"
                    Rows="3"
                    CssClass="pm-note__box"
                    NullText="@WriteHint"
                    Enabled="@(!_busy)" />

            <DxButton Text="남기기"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="pm-note__save"
                      Enabled="@CanSave"
                      Click="@SaveAsync" />
        </div>
    </div>
}
