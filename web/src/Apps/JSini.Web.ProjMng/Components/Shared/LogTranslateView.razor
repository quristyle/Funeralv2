@using BlazorMonaco.Editor

@*
    줄을 눌러 그 한 줄만 한국어로 옮기는 판. 로그 탭과 「지시와 결과」의 결과문이 같은 판을 쓰고, 다른 점 넷은 파라미터로 가른다.
    휴대폰은 Monaco 를 걷고 줄을 div 로 그린다 — Monaco 의 손가락 굴리기는 본문 스레드가 한 프레임씩 해서 버벅인다. 굴림은 쪽 하나가 맡는다.
    넓은 화면에서도 Monaco 는 손가락 누름을 올리지 않으므로 watchTaps 로 따로 받는다.
*@

@implements IAsyncDisposable

        @* 휴대폰인가 — 창 폭이 아니라 DxLayoutBreakpoint 로 잰다(포털의 다른 화면과 같은 자). *@
<DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall"
                    IsActive="_phone" IsActiveChanged="@OnPhoneChangedAsync" />

<div class="pm-xlat">
        @* 머리띠. 줄바꿈 단추는 여기 없다 — 편집기 칸 이름표의 EditorActions 로 옮겼다(다른 편집기와 손짓을 맞춘다). *@
    <div class="pm-xlat__bar">
            @* 옮긴 줄을 모두 원문으로 되돌린다. 번역을 시키는 자리가 아니다. *@
        @if (_state.DoneLines.Count > 0)
        {
            <DxButton Text="옮긴 줄 비우기"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="@ClearTranslationsAsync" />
        }

        <span class="pm-xlat__stat">@StatusText</span>
    </div>

        @* 칸 이름표. 칸이 하나라 이름도 하나다. 이름 오른쪽에 EditorActions 「…」 메뉴가 선다. 편집기 안에 띄우지 않는 까닭은 로그가 오른쪽 위 귀퉁이에도 글을 두기 때문이다. *@
    <div class="pm-xlat__heads">
        <span class="pm-xlat__head">

            <EditorActions CopyTitle="번역 전체 복사"
                           Text="@OutText"
                           WordWrap="@_wrap"
                           WordWrapChanged="@SetWrapAsync"
                           LineNumbers="@_lineNumbers"
                           LineNumbersChanged="@SetLineNumbersAsync" />
        </span>
    </div>

        @* 로그가 설 자리. 넓은 화면은 높이를 여기서 정한다(Monaco 는 부모 높이를 재서 그린다). 휴대폰 목록은 높이를 받지 않고 내용만큼 길어져 쪽이 구른다. *@
    <div class="pm-xlat__editor" style="@EditorStyle">
        @if (_phone)
        {
             @* 휴대폰 — 줄을 div 로 그린다(Monaco 가 아니다, 굴림을 브라우저에 돌려주려고). 구르는 자리는 쪽 하나다.
                @key 를 줄 번호로 줘서 자라도 켜 둔 불이 옆줄로 옮겨 붙지 않게 한다. *@
            <div class="pm-xlat__list @(_wrap ? null : "pm-xlat__list--nowrap")"
                 @ref="_listEl" role="list" aria-label="@OutAria">
                @for (var i = 0; i < _state.Out.Count; i++)
                {
                    var line = i + 1;

                     @* 줄에 붙는 이름은 미리 지어 둔다 — 속성값 안의 겹따옴표는 Razor 가 속성을 끝낸 것으로 읽는다. *@
                    var cls = RowClass(line);

                    var text = _state.Out[i];
                    var hasRepeat = false;
                    var count = 1;
                    var mainText = text;
                    if (CollapseRepeats && TryGetRepeat(text, out var rCount, out var rText))
                    {
                        hasRepeat = true;
                        count = rCount;
                        mainText = rText;
                    }

                    <div @key="line" role="listitem" class="@cls"
                         @onclick="@(() => OnRowClickedAsync(line))">
                        @if (_lineNumbers)
                        {
                            <span class="pm-xlat__rownum">@line</span>
                        }
                        @if (hasRepeat)
                        {
                            <span class="pm-xlat__repeat-badge">@count</span>
                            <span class="pm-xlat__rowtext">@mainText</span>
                        }
                        else
                        {
                            <span class="pm-xlat__rowtext">@text</span>
                        }
                    </div>
                }
            </div>
        }
        else if (!_loaded)
        {
            @* 첫 그리기는 폭을 아직 몰라 휴대폰도 여기를 지난다 — 그때 편집기를 그리면 영영 안 선다(LoadMonacoAsync). *@
            <div class="pm-xlat__loading">@LoadingText</div>
        }
        else
        {
            @* 다 받은 뒤에야 그린다 — 받기 전에 그리면 window.monaco 가 없어 회로가 통째로 끊긴다.
               커서가 선 줄에 불을 켜고(OnDidChangeCursorPosition), 누름은 따로 받는다(OnMouseDown) — 화살표 키마다 옮기면 LLM 이 줄줄이 돈다. *@
            <StandaloneCodeEditor @ref="_editor"
                                  Id="@_id"
                                  ConstructionOptions="@BuildOptions"
                                  CssClass="pm-xlat__inner"
                                  OnDidInit="@OnEditorReadyAsync"
                                  OnDidChangeCursorPosition="@OnCursorMovedAsync"
                                  OnMouseDown="@OnLineClickedAsync"
                                  OnDidContentSizeChange="@OnSizedAsync" />
        }
    </div>
</div>
