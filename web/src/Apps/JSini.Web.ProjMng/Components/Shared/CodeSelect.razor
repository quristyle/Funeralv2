@*
    공통코드 드롭다운. 코드 ID 로 목록을 채운다. 다중은 DxTagBox 가 체크칸을 못 그려서 DxDropDownBox + DxListBox(ShowCheckboxes) 로 짰다.
    편집 창은 KeepUnknownValue 를 켠다 — 목록에 없는 저장값을 비우면 다른 칸만 고쳐도 그 칸이 지워져 저장된다.
    다중에는 「전체」·자동 선택을 두지 않는다(빈 선택이 이미 「가리지 않음」이다).
*@

    @* 검증을 끈다 — Value/ValueChanged 만 쓰고 ValueExpression 이 없다. EditForm 안에서 던지는 검증 예외가 회로를 끊기 때문이다. *@
@if (Multiple)
{
    @* 칸 글자는 QueryDisplayText 가 이름을 이어 붙여 만든다. 비면 NullText 가 뜬다. *@
    <DxDropDownBox Value="@MultiValue"
                   ValueChanged="@((object? value) => OnDropDownValueChangedAsync(value))"
                   QueryDisplayText="@(_ => MultiText)"
                   NullText="@Placeholder"
                   DropDownWidthMode="DropDownWidthMode.ContentOrEditorWidth"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                   Enabled="@(!Disabled)"
                   ValidationEnabled="false"
                   CssClass="pm-code-select pm-code-select--multi">
        <DropDownBodyTemplate>
            <DxListBox TData="CommonCodeItem" TValue="string"
                       Data="@_items"
                       TextFieldName="@nameof(CommonCodeItem.Name)"
                       ValueFieldName="@nameof(CommonCodeItem.Code)"
                       Values="@SelectedCodes"
                       ValuesChanged="@((IEnumerable<string> values) => OnPickedManyAsync(values))"
                       SelectionMode="ListBoxSelectionMode.Multiple"
                       ShowCheckboxes="true"
                       ValidationEnabled="false"
                       CssClass="pm-code-checks" />
        </DropDownBodyTemplate>
    </DxDropDownBox>
}
else
{
<DxComboBox Data="@_items"
            TextFieldName="@nameof(CommonCodeItem.Name)"
            ValueFieldName="@nameof(CommonCodeItem.Code)"
            Value="@Value"
            ValueChanged="@((string? code) => OnPickedAsync(code))"
            NullText="@Placeholder"
            ClearButtonDisplayMode="@(AllowClear ? DataEditorClearButtonDisplayMode.Auto : DataEditorClearButtonDisplayMode.Never)"
            Enabled="@(!Disabled)"
            ValidationEnabled="false"
            CssClass="pm-code-select" />
}
