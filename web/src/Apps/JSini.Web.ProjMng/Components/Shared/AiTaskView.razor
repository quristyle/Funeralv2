        <span class="pm-peek__cell">
            <span class="pm-peek__label">동작</span>
            <span class="pm-peek__value">@AiTaskWhen.RunAt(t)</span>
        </span>

        <span class="pm-peek__cell">
            <span class="pm-peek__label">작업</span>
            <span class="pm-peek__value">@AiTaskWhen.Elapsed(t)</span>
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(t.LastError))
    {
        <PageNotice Tone="NoticeTone.Error" Text="@t.LastError" />
    }

    @if (!string.IsNullOrWhiteSpace(t.NotifyError))
    {
        <PageNotice Tone="NoticeTone.Warning" Text="@($"결과 알림: {t.NotifyError}")" />
    }

    @* ── 처리 요약 — **탭 줄 위다** (2026-10-11) ─────────────
       한동안 「지시와 결과」 탭 **안**의 맨 위였다. 그러면 로그를 펴는
       순간 요약이 통째로 사라진다 — 돌고 있는 건을 지켜보거나 「어디서
       걸렸나」를 로그에서 되짚는 사람이 **결론을 보려면 탭을 되돌아가야**
       했고, 돌아가면 이번에는 로그에서 읽던 자리를 잃는다(새 줄은 계속
       바닥에 붙는다).

       요약은 성격이 머리띠 쪽이다 — **어느 탭을 펴고 있든 그 건에 대해
       달라지지 않는 결론 한 줌**이고, 탭 안에 남는 것은 고르는 것뿐이다
       (원문 둘이냐, 기계가 찍은 줄이냐). 그래서 머리띠 바로 아래, 탭 줄
       위에 둔다.

       **답이 있는데 요약이 없으면 사정을 적는다** — 위 머리말 참고.
       답조차 없는 건에는 이 칸이 통째로 빠지고, 그때는 탭 줄이 머리띠에
       바로 붙는다(고치기 전과 같은 모습이다). *@
    @if (_summary is { } s)
    {
        <div class="pm-peek__summary">
            <div class="pm-peek__head-row">
                @* **제목이 곧 접는 단추다**(2026-10-12). 제목 옆에 화살표만
                   따로 세우면 누를 자리가 손가락보다 작아, 휴대폰에서 두세 번
                   빗나간다. 제목째로 단추에 담아 줄 전체를 누를 자리로 준다.

                   화살표는 글자 하나(▸)를 돌려서 쓴다 — 펴면 ▾ 다. 두 글자를
                   갈아 끼우지 않는 것은 그 사이에 글자폭이 달라져 제목이
                   좌우로 흔들리기 때문이다. *@
                <h3 class="pm-peek__head">
                    <button type="button" class="pm-peek__fold"
                            @onclick="ToggleSummary"
                            aria-expanded="@(_sumOpen ? "true" : "false")"
                            aria-controls="pm-peek-sum"
                            title="@(_sumOpen ? "처리 요약 접기" : "처리 요약 펴기")">
                        <span class="pm-peek__fold-mark @(_sumOpen ? "pm-peek__fold-mark--open" : null)"
                              aria-hidden="true">▸</span>
                        <span>처리 요약</span>
                    </button>
                </h3>

                @* **접어 두어도 읽어 준다.** 음성은 글을 보지 않는 사람을 위한
                   길이라, 접힌 것을 펴야 눌리게 하면 그 길이 막힌다. *@
                <button type="button"
                        class="pm-peek__speech-btn @(_speaking ? "pm-peek__speech-btn--speaking" : null)"
                        @onclick="ToggleSpeechAsync"
                        title="@(_speaking ? "음성 읽기 중지" : "요약 음성으로 읽어주기")"
                        aria-label="@(_speaking ? "음성 읽기 중지" : "요약 음성으로 읽어주기")">
                    <span class="pm-peek__speech-icon" aria-hidden="true">@(_speaking ? "⏹" : "🔊")</span>
                    <span>@(_speaking ? "읽기 중지" : "음성으로 읽어주기")</span>
                </button>
            </div>

            @* 접으면 **알맹이를 아예 안 그린다** — CSS 로만 숨기면 접어 둔
               뜻(긴 요약이 자리를 덜 먹게)이 회로에서는 그대로 실려 나간다. *@
            @if (_sumOpen)
            {
                <div class="pm-peek__sum" id="pm-peek-sum">
                    @if (s.Headline is { Length: > 0 } headline)
                    {
                        <p class="pm-peek__sum-line">@headline</p>
                    }

                    @if (s.Points.Count > 0)
                    {
                        <ul class="pm-peek__sum-list">
                            @foreach (var point in s.Points)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }

                    @if (s.Checks.Count > 0)
                    {
                        <p class="pm-peek__sum-label">확인할 것</p>

                        <ul class="pm-peek__sum-list pm-peek__sum-list--check">
                            @foreach (var check in s.Checks)
                            {
                                <li>@check</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }
    else if (AwaitingSummary)
    {
        @* 답은 왔는데 요약이 없다. **말없이 비워 두지 않는다** —
           기다리면 오는 것인지, 내가 뭘 해야 하는지를 적는다. *@
        <div class="pm-peek__summary">
            <div class="pm-peek__head-row">
                <h3 class="pm-peek__head">처리 요약</h3>

                <button type="button" class="pm-peek__speech-btn" disabled
                        title="처리 요약을 만드는 중입니다">
                    <span class="pm-peek__speech-icon" aria-hidden="true">🔊</span>
                    <span>음성으로 읽어주기</span>
                </button>
            </div>

            <p class="pm-peek__dim">@SummaryWaitText</p>

            @if (_summaryGaveUp && !_summaryBusy)
            {
                <DxButton Text="지금 만들기" RenderStyle="ButtonRenderStyle.Link"
                          Click="@RemakeSummaryAsync" />
            }
        </div>
    }

    <div class="pm-peek__tabs">
        <DxTabs @bind-ActiveTabIndex="_tab" TabClick="@OnTabClick">
            <DxTabPage Text="지시와 결과">
                <div class="pm-peek__pane">
                    @* ── 물음 ────────────────────────────────────
                       사람이 적어 보낸 그대로다. 실행 줄에도 그때 준 지시문이
                       남지만(`Instruction`), 그것은 서버가 앞뒤를 덧대 만든
                       글이라 **내가 무엇을 적었나**에는 답하지 않는다.

                       **상자 안이 구르지 않는다** — 긴 지시문도 통째로 편다.
                       왜 높이를 묶지 않는지는 CSS 쪽에 적어 두었다. *@
                    <h3 class="pm-peek__head">지시</h3>

                    @if (string.IsNullOrWhiteSpace(t.Contents))
                    {
                        <p class="pm-peek__dim">적어 둔 내용이 없습니다.</p>
                    }
                    else
                    {
                        <pre class="pm-peek__pre pm-peek__pre--ask">@t.Contents</pre>
                    }

                    @* ── 함께 간 파일 ───────────────────────────

                       **지시 바로 아래다.** 이 파일들은 지시의 일부지 결과가
                       아니다 — AI 가 그것을 보고 일했고, 사람이 「무엇을 보고
                       시킨 건이었나」를 되짚는 자리가 여기다.

                       그림은 눌러서 **미리보기로** 연다(`data-imgview-scope`).
                       작은 그림만 두면 글자가 작은 화면 사진에서 아무것도 읽을
                       수 없다. 한동안 새 탭으로 원본을 열었는데, 그쪽은 확대만
                       되고 돌려 볼 수가 없어 옆으로 누운 사진에서 막혔다 —
                       링크는 그대로 두므로(문지기가 `preventDefault` 한다)
                       가운데 단추로 여는 길은 남아 있다. *@
                    @if (_files.Count > 0)
                    {
                        <h3 class="pm-peek__head">함께 보낸 파일 (@_files.Count)</h3>

                        <ul class="pm-peek__files" data-imgview-scope>
                            @foreach (var f in _files)
                            {
                                <li class="pm-peek__file">
                                    <a href="@FileDownload.AiTaskUrlFor(f.FileKey, f.FileNm)"
                                       target="_blank" rel="noopener"
                                       title="@($"{f.FileNm} · {f.SizeText}")">
                                        @if (f.IsImage)
                                        {
                                            <img class="pm-peek__fileimg"
                                                 src="@FileDownload.AiTaskUrlFor(f.FileKey)" alt="@f.FileNm" />
                                        }
                                        else
                                        {
                                            <span class="pm-peek__fileicon" aria-hidden="true"></span>
                                        }

                                        <span class="pm-peek__filename">@f.FileNm</span>
                                        <span class="pm-peek__filesize">@f.SizeText</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }

                    @* ── 답 ─────────────────────────────────────── *@
                    <div class="pm-peek__head-row">
                        <h3 class="pm-peek__head">결과</h3>

                        @if (_summary is not null)
                        {
                            <button type="button"
                                    class="pm-peek__speech-btn @(_speaking ? "pm-peek__speech-btn--speaking" : null)"
                                    @onclick="ToggleSpeechAsync"
                                    title="@(_speaking ? "음성 읽기 중지" : "결과 요약 음성으로 읽어주기")"
                                    aria-label="@(_speaking ? "음성 읽기 중지" : "결과 요약 음성으로 읽어주기")">
                                <span class="pm-peek__speech-icon" aria-hidden="true">@(_speaking ? "⏹" : "🔊")</span>
                                <span>@(_speaking ? "읽기 중지" : "음성으로 요약 듣기")</span>
                            </button>
                        }
                    </div>

                    @if (_result is { Length: > 0 })
                    {
                        <pre class="pm-peek__pre pm-peek__pre--result">@_result</pre>

                        @if (RunHint is { Length: > 0 } hint)
                        {
                            <p class="jsini-hint">@hint</p>
                        }
                    }
                    else if (t.IsBusy)
                    {
                        @* 아직 답이 없다. **여기서 로그로 가는 길을 둔다** —
                           빈 결과 칸을 본 사람이 다음에 할 일이 그것이다. *@
                        <p class="pm-peek__dim">아직 돌고 있습니다.</p>

                        <DxButton Text="로그 보기" RenderStyle="ButtonRenderStyle.Link"
                                  Click="@(() => OpenLogTabAsync())" />
                    }
                    else
                    {
                        <p class="pm-peek__dim">AI 가 남긴 말이 없습니다.</p>
                    }

                    @* ── 오간 말 ───────────────────────────────
                       **일반 사용자가 올린 요청에만 선다**(`IsUserRequest`).
                       그 건은 저장만 되고 아무 데서도 안 돌아, 관리자가
                       대상·AI 를 채워 줄 때까지 올린 사람은 아무 소식을
                       못 듣는다 — 여기 한 줄 적으면 그 사람에게 앱푸시가 간다.

                       「빠른 지시」로 관리자가 스스로 적은 건에는 두지 않는다.
                       거기서 말을 걸 상대는 자기 자신이다. *@
                    @if (t.IsUserRequest)
                    {
                        @* `Mine` 은 **로그인한 사람이 올린 건인가**다. 참이면
                           `mine/…` 경로를 쓰고 펴는 순간 읽은 것으로 찍는다 —
                           위 머리말 참고. *@
                        <AiTaskNotes Item="@t" Mine="@IsMine(t)" />
                    }
                </div>
            </DxTabPage>

            @* ── 처리 파일 — **탭 하나다** (2026-10-12) ─────────
               하루는 요약 바로 아래의 묶음이었다. 거기서 두 가지가 걸렸다.

                 - 수백 줄을 고친 건에서 그 목록이 **지시와 결과를 화면 밖으로
                   밀어낸다.** 그래서 여덟 줄만 펴 두고 나머지를 「N개 더 보기」로
                   접었는데, 그러면 이번에는 **목록을 보러 온 사람이 늘 한 번 더
                   눌러야** 했다. 둘 다 세울 수 없는 자리였다.
                 - 길이가 건마다 10배씩 달라서(한 파일 ↔ 이백 파일) 그 아래
                   탭 줄이 **건마다 다른 높이에** 선다. 카드 넷을 차례로
                   눌러 보는 동안 탭이 위아래로 뛴다.

               탭이면 둘 다 풀린다. **보러 온 사람만 건너오고**(모바일 회선이다),
               건너온 사람은 접힌 것 없이 통째로 본다. 탭 이름에 개수를 적어
               두므로 건너오기 전에도 「몇 개인가」는 알 수 있다 — 요약 아래에서
               그 숫자가 하던 몫이 그것뿐이었다.

               **차례는 지시와 결과 다음이다.** 「무엇을 했나」 다음에 오는 물음이
               「그래서 어디를 건드렸나」고, 로그는 그 둘이 못 미더울 때 펴는
               것이라 맨 끝이다.

               **올린 파일(`pm-peek__files`)과 다른 것이다.** 그쪽은 사람이 지시에
               붙여 넣은 것이라 「지시」 바로 아래에 그대로 둔다. 이쪽은 AI 가
               저장소에 남긴 것이다. *@
            <DxTabPage Text="@FileTabText">
                <div class="pm-peek__pane">
                    @if (_changed.Count > 0)
                    {
                        <ul class="pm-peek__chg">
                            @foreach (var f in _changed)
                            {
                                @* 「외 N개」 줄은 파일이 아니다. 배지도 경로도 없이
                                   한 줄만 적는다 — 배지를 달면 그것이 파일 이름처럼 읽힌다. *@
                                @if (f.Kind == AiRunFileKind.More)
                                {
                                    <li class="pm-peek__chg-row pm-peek__chg-row--more">@f.Path</li>
                                }
                                else
                                {
                                    <li class="pm-peek__chg-row">
                                        @if (f.KindText is { Length: > 0 } word)
                                        {
                                            <span class="pm-peek__chg-mark @f.KindClass">@word</span>
                                        }

                                        <span class="pm-peek__chg-path" title="@f.Path">
                                            @if (f.Folder is { Length: > 0 } folder)
                                            {
                                                <span class="pm-peek__chg-dir">@folder/</span>
                                            }

                                            <span class="pm-peek__chg-name">@f.Name</span>
                                        </span>
                                    </li>
                                }
                            }
                        </ul>

                        @* 가지 · 「몇 줄이 바뀌었나」 · 올린 자리. **이름 목록이
                           말하지 않는 것이 여기 있다** — 결과문 아래의 그 줄과
                           같은 값이고(`RunHint`), 둘 다 이 실행의 것이다. *@
                        @if (RunHint is { Length: > 0 } fileHint)
                        {
                            <p class="jsini-hint">@fileHint</p>
                        }
                    }
                    else
                    {
                        @* **빈 탭을 말없이 두지 않는다.** 「아직인가 · 원래
                           없는 건인가 · 고장인가」가 갈리지 않으면 보는 사람이
                           같은 자리를 몇 번씩 다시 연다. *@
                        <p class="pm-peek__dim">@ChangedEmptyText</p>
                    }
                </div>
            </DxTabPage>

            <DxTabPage Text="@LogTabText">
                @* ── 로그는 한 판으로 본다 ───────────────────────
                   실행기가 찍는 줄은 거의 영어다. 수백 줄에서 「어디서 걸렸나」를
                   찾는 사람에게 그것이 느리게 읽혀, 원문 옆에 한국어를 세운다
                   (`LogTranslateView` — 왼쪽이 원문, 오른쪽이 번역).

                   **보는 법을 고르는 단추가 있었다**(「원문」·「원문·번역 비교」).
                   그러면 원문을 보여 주는 자리가 둘이 된다 — 글상자와 비교 판의
                   왼쪽 칸. 보는 사람에게는 **같은 것이 두 번 서 있는 것**이라,
                   자리를 하나로 합치고 원문은 왼쪽 칸에만 둔다.

                   **열자마자 옮기지는 않는다.** 그 판은 누른 줄 하나만 옮기므로
                   로그를 펴는 값이 예전 글상자와 같다 — 따라 내리는 일까지
                   편집기가 들고 있어(`js/log-tail.js` 가 하던 몫) 여기서 밀어
                   줄 상자가 없다. *@
                <div class="pm-peek__pane">
                    @if (_lines.Count == 0)
                    {
                        <p class="pm-peek__dim">
                            @(t.IsBusy ? "아직 찍힌 줄이 없습니다." : "남은 로그가 없습니다.")
                        </p>
                    }
                    else
                    {
                        @* 열쇠에 건 번호를 넣는다. **옮긴 것은 화면 밖에
                           남으므로**(`AiLogXlatStore`) 열쇠가 같으면 다른
                           지시를 열었을 때 앞 건의 번역이 그대로 보인다. *@
                        <LogTranslateView Lines="@LogLines"
                                          StateKey="@($"ai-task:{t.TaskKey}")"
                                          Active="@(Live && _tab == TabLog)" />
                    }
                </div>
            </DxTabPage>
        </DxTabs>
    </div>
}
else
{
    @* 목록이 다시 읽히면서 이 건이 넷 밖으로 밀려났거나, 주소로 들어왔는데
       그런 건이 없다. **말없이 비워 두지 않는다** — 「고장인가」로 읽힌다. *@
    <PageNotice Tone="NoticeTone.Info" Text="@MissingText" />
}
