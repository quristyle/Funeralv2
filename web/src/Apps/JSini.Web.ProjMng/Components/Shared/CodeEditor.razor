@using BlazorMonaco
@using BlazorMonaco.Editor
@using Microsoft.JSInterop

@* 코드 편집기. Monaco 하나로 통일한다 — 화면 아홉이 SQL·템플릿을 편집하고 구문 강조·접기·찾기바꾸기가 쓰인다. 값은 바깥에서 바뀔 때만 민다(타이핑 중 커서가 튀지 않게). 변경은 debounce(기본 300ms) 뒤에만 올린다 — 회로 왕복이 키 입력마다 나면 안 된다. *@

@implements IAsyncDisposable

@if (!string.IsNullOrWhiteSpace(Placeholder))
{
    @* 편집기 위의 한 줄 — Monaco 에는 자리표시 글자가 없어 여기 적는다. *@
    <div class="pm-editor__hint">@Placeholder</div>
}

<div class="pm-editor" style="height: @Height">
    @if (EffectiveShowActions)
    {
        @* 「…」 메뉴(복사 · 자동 줄바꿈 · 줄 번호)는 EditorActions 가 들고 있다. 복사할 글은 누른 순간 편집기에서 읽는다 — Value 는 debounce 만큼 뒤처져 방금 친 글자가 빠진다. *@
        <EditorActions Floating="true"
                       CopyTitle="내용 복사"
                       TextProvider="@ReadEditorTextAsync"
                       WordWrap="@_wordWrap"
                       WordWrapChanged="@SetWordWrapAsync"
                       LineNumbers="@_lineNumbers"
                       LineNumbersChanged="@SetLineNumbersAsync" />
    }

    @if (_loaded)
    {
        @* 다 받은 뒤에야 그린다 — 스크립트가 없으면 StandaloneCodeEditor 가 회로를 끊는다. *@
        <StandaloneCodeEditor @ref="_editor"
                              Id="@_id"
                              ConstructionOptions="@BuildOptions"
                              OnDidChangeModelContent="@OnEditorChangedAsync"
                              OnKeyDown="@HandleKeyDownAsync"
                              CssClass="pm-editor__inner" />
    }
    else
    {
        <div class="pm-editor__loading">편집기를 불러오는 중…</div>
    }
</div>
