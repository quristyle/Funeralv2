@*
    일정 등록·수정 창. 일정표의 달력·목록·표 보기가 모두 이 한 벌을 연다 — 표의 기본 편집 창과 달력의 창이 갈려 있던 동안
    표에서 연 창에만 프로젝트·구분·진행 상태와 「오늘로 옮겨 저장」·복제·삭제가 없었다.
*@

<CommPopup @bind-Visible="_visible" HeaderText="@(_isNew ? "일정 등록" : "일정 수정")"
           Width="940px" MaxHeight="92vh" Scrollable="true">
    <BodyContentTemplate Context="popup">
        <div class="pm-scheduler-edit">
            <WbsEditForm Item="@_form" Compact="true">
                <Leading>
                    <DxFormLayoutItem Caption="프로젝트" ColSpanMd="6" ColSpanLg="4">
                        <CodeSelect CodeId="projlist" AutoSelectFirst="false" KeepUnknownValue="true"
                                    Value="@(_form.PrjRid?.ToString())"
                                    ValueChanged="@((string? code) => _form.PrjRid = int.TryParse(code, out var rid) ? rid : null)" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="구분" ColSpanMd="6" ColSpanLg="4">
                        @* 저장된 값이 코드표에 없어도 지우지 않는다 — 옛 값이 그대로 남은 줄이 있다. *@
                        <CodeSelect CodeId="schedule_type" AutoSelectFirst="false" KeepUnknownValue="true"
                                    @bind-Value="_form.ScheduleType" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="진행 상태" ColSpanMd="12" ColSpanLg="4">
                        <DxComboBox Data="@StateOptions" TData="ScheduleState" TValue="string" TextFieldName="Name" ValueFieldName="Code"
                                    Value="@_formState" ValueChanged="@OnFormStateChanged"
                                    ValidationEnabled="false" />
                    </DxFormLayoutItem>
                </Leading>
            </WbsEditForm>
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!_busy)"
                  Click="@(() => SaveAsync(false))" />

        @* 원본의 `OnTodayAndSave`. 미뤄 둔 일을 오늘로 끌어오는 한 번 누르기다. *@
        <DxButton Text="오늘로 옮겨 저장" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!_busy)"
                  Click="@(() => SaveAsync(true))" />

        @if (!_isNew)
        {
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="복제" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!_busy)"
                          Click="@DuplicateAsync" />
            </PermissionView>
            <PermissionView Action="MenuAction.Delete">
                <DxButton Text="삭제" RenderStyle="ButtonRenderStyle.Danger" Enabled="@(!_busy)"
                          Click="@DeleteAsync" />
            </PermissionView>
        }

        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@Close" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />
