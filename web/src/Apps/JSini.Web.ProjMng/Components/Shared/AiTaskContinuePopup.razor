@* AI 작업 「이어서 지시」 팝업. 끝난 작업에는 바로, 도는 작업에는 예약으로 이어서 지시하며, 「빠른 지시」와 「AI 작업」이 이 부품을 공유해 같은 UI 를 쓴다. *@

@implements IDisposable

<CommPopup Visible="@_visible"
           VisibleChanged="@OnCommVisibleChanged"
           HeaderText="이어서 지시"
           Width="min(36rem, calc(100vw - 2rem))"
           CloseOnOutsideClick="false">
    <BodyContentTemplate>
        @if (Item?.IsBusy == true)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="@(_hasSavedPending
                            ? $"현재 작업이 '{Item?.StatusText}' 상태입니다. 아래 내용이 예약되어 있어 작업이 끝나면 이어서 실행됩니다."
                            : $"현재 작업이 '{Item?.StatusText}' 상태입니다. 「이어서 요청」을 누르면 예약되어 작업이 끝나는 대로 이어서 실행됩니다.")" />
        }

        @* 이 회차를 맡을 AI 고르개(AiRunnerPick) — 남은 한도가 그 칸 안에 함께 선다. *@
        <div class="pm-peek__field">
            <AiRunnerPick Items="@ContinueKinds" Value="@_continueKind"
                          ValueChanged="@((string? v) => PickContinueKindAsync(v))"
                          ValueExpression="@(() => _continueKind)"
                          CssClass="pm-peek__kind"
                          Enabled="@(!_continuing && ContinueKinds.Count > 1)"
                          Usage="@UsageOf"
                          UsageSeen="@_usageSeen" />
        </div>

        @if (!string.IsNullOrWhiteSpace(ContinueKindNote))
        {
            <p class="jsini-hint">@ContinueKindNote</p>
        }

        @* 글상자를 제 상자로 감싼다 — 치는 대로 적어 두는 JS 가 잡을 수 있게 인스턴스별 ID 를 부여한다. *@
        <div id="@_continueDomId">
            <DxMemo @bind-Text="_continueAddition" Rows="5"
                    BindValueMode="BindValueMode.OnInput"
                    NullText="이번에 더 시킬 일 — 지난 진행은 서버가 앞에 붙입니다"
                    CssClass="pm-peek__memo" />
        </div>

        @if (_continueRestored)
        {
            <div class="pm-ask__draft">
                <span class="pm-ask__draft-text">
                    작성 중이던 내용을 복원했습니다@(_continueSavedAt.HasValue ? $" ({_continueSavedAt.Value.Kst("MM-dd HH:mm")})" : "").
                </span>
                <button type="button" class="pm-ask__draft-clear" @onclick="ClearContinueDraftAsync">
                    내용 비우기
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_continueError))
        {
            <PageNotice Tone="NoticeTone.Error" Text="@_continueError" />
        }
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        @if (Item?.IsBusy == true)
        {
            @* 도는 중에 누르면 서버에 예약해 두고, 끝나는 순간 서버가 이어서 요청한다 — 창이 닫혀 있어도 간다. *@
            <DxButton Text="@(_hasSavedPending ? "예약 내용 수정" : "이어서 요청")"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@(!string.IsNullOrWhiteSpace(_continueAddition) && !_continuing)"
                      Click="@SavePendingContinueAsync" />

            @if (_hasSavedPending)
            {
                <DxButton Text="예약 취소" RenderStyle="ButtonRenderStyle.Danger"
                          Enabled="@(!_continuing)"
                          Click="@CancelPendingContinueAsync" />
            }
        }
        else
        {
            <DxButton Text="이어서 요청" RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@(!string.IsNullOrWhiteSpace(_continueAddition) && !_continuing)"
                      Click="@DoContinueAsync" />
        }
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!_continuing)"
                  Click="@Close" />
    </FooterContentTemplate>
</CommPopup>
