@* 날짜 선택 + 기간 탭. 화면과는 (Preset, Anchor) 두 값으로 바인딩하고 (Start, End) 는 거기서 계산해 RangeChanged 로 올린다 — 구간을 직접 바인딩하면 프리셋과 구간이 어긋난 상태가 생긴다. 최초 조회는 화면의 몫이다(CodeSelect 가 첫 항목을 고를 때 걸린다). 여기서 올리면 두 번 나간다. *@

<div class="pm-dates">
    <div class="pm-dates__tabs" role="tablist">
        @foreach (var preset in Presets)
        {
            var current = preset;
            <button type="button"
                    role="tab"
                    class="pm-dates__tab @(current == Preset ? "pm-dates__tab--on" : null)"
                    @onclick="@(() => SetPresetAsync(current))">
                @TabText(current)
            </button>
        }
    </div>

    <div class="pm-dates__nav">
        <DxButton Text="‹"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  aria-label="이전"
                  Click="@(() => ShiftAsync(-1))" />

        <span class="pm-dates__label">@Label</span>

        <DxButton Text="›"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  aria-label="다음"
                  Click="@(() => ShiftAsync(1))" />
    </div>

    @if (ShowDateEdit)
    {
        <DxDateEdit Date="@Anchor"
                    DateChanged="@((DateTime date) => SetAnchorAsync(date))"
                    CssClass="pm-dates__edit" />
    }
</div>
