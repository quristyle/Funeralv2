@*
    AI 일정 메모 공통 팝업.
    레이아웃 상단 아이콘에서 항상 접근할 수 있으며, 본문작성부와 저장 버튼, 프로젝트 선택 항목을 제공한다.
    저장 시 즉시 팝업이 닫히고, 백그라운드/백엔드에서 AI 가 본문을 분석하여 날짜·시간·제목·요약·요구자·담당자를 자동으로 채워 일정표(dev_wbs)에 저장한다.
*@

<CommPopup Visible="@Reveal.IsOpen"
           VisibleChanged="@OnVisibleChangedAsync"
           HeaderText="AI 일정 메모"
           Width="min(560px, calc(100vw - 2rem))"
           MaxHeight="86vh"
           CssClass="pm-snote-popup"
           CloseOnOutsideClick="false"
           CloseOnEscape="true">
    <BodyContentTemplate Context="bodyContext">
        <DxFormLayout CssClass="pm-editform pm-snote-popup__form">
            <DxFormLayoutItem Caption="프로젝트" ColSpanMd="12">
                <CodeSelect CodeId="projlist" AutoSelectFirst="false" KeepUnknownValue="true"
                            @bind-Value="ProjectCode" />
            </DxFormLayoutItem>

            @* AI 가 짓지 않는다 — 고른 코드가 그대로 일정에 실린다. *@
            <DxFormLayoutItem Caption="추가대상" ColSpanMd="12">
                <CodeSelect CodeId="@AddTargets.CodeId" AutoSelectFirst="false" AllowClear="true" KeepUnknownValue="true"
                            @bind-Value="_addTarget" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="본문" ColSpanMd="12">
                <div class="pm-snote-popup__memo-wrap" @onkeydown="@OnKeyDownAsync">
                    <DxMemo @bind-Text="_body"
                            BindValueMode="BindValueMode.OnInput"
                            Rows="9"
                            Placeholder="일정 내용이나 업무 메모를 작성하세요. 저장 시 즉시 창이 닫히고 AI가 날짜, 시간, 제목, 요약, 요구자, 담당자를 자동으로 분석하여 백그라운드에서 일정에 등록합니다."
                            CssClass="pm-snote-popup__memo" />
                </div>
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="footerContext">
        <DxButton Text="저장"
                  RenderStyle="ButtonRenderStyle.Primary"
                  IconCssClass="jsini-icon-check"
                  Click="@SaveAsync" />

        <DxButton Text="닫기"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CloseAsync" />
    </FooterContentTemplate>
</CommPopup>
