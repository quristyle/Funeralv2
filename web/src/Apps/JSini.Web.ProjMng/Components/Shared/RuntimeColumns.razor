@*
    실행 시점에 칸이 정해지는 표의 칸 목록. CommGrd 의 Columns 안에 넣는다 — 자료는 DataTable 로 받고 칸을 받고 나서 세운다.
    표는 CommGrd 하나만 쓴다(따로 두면 띠·쪽나누기가 두 벌이 된다).
*@

@using System.Data

@* 이벤트 뒤에 다시 그리지 않는다(IHandleEvent). 칸의 입력이 StateHasChanged 를 부르면 DevExpress 칸 설정 렌더 중에 던져 회로가 끊긴다 — 값은 DataRow 가 기억한다. *@
@implements IHandleEvent

@foreach (var name in Names)
{
    @* 글자 칸은 왼쪽으로 둔다 — 긴 글자가 가운데로 몰리면 눈이 첫 글자를 못 찾는다. *@
    if (IsEditable(name))
    {
        var column = name;

        @* 칸 안에서 바로 고친다 — 편집 창을 열지 않는다. 고친 줄은 DataRow 가 스스로 기억한다. *@
        <DxGridDataColumn FieldName="@column" Caption="@column"
                          TextAlignment="GridTextAlignment.Left">
            <CellDisplayTemplate Context="cell">
                @{
                    // **`DataRow` 로 바로 캐스팅하면 안 된다.** 표를 자료로 주면
                    // DevExpress 가 `DataView` 로 감싸므로 셀에 오는 것은
                    // `DataRowView` 다. 캐스팅이 틀리면 **줄을 그리다 던지고
                    // 회로가 끊긴다** — 화면이 통째로 멎는다.
                    var row = RuntimeCell.Row(cell.DataItem)!;
                }
                <DxTextBox Text="@(row[column]?.ToString() ?? string.Empty)"
                           TextChanged="@((string v) => row[column] = v)"
                           BindValueMode="BindValueMode.OnLostFocus"
                           CssClass="pm-cell-edit" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
    }
    else
    {
        <DxGridDataColumn FieldName="@name" Caption="@name" TextAlignment="@Align(name)" />
    }
}
