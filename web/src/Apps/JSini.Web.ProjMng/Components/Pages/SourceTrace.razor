@page "/projmng/source/trace"
@attribute [RouteKey("projmng.source.trace")]
@using System.Data

@*
소스 추적. 서버가 등록된 소스 경로를 훑어 파일 목록을 만들고, 행을 고르면 그 파일 내용을 편집기에 띄운다. 경로 등록은 소스 정보 화면에서 한다.
소스·언어는 공통코드가 아니라 소스 정보 표(REST)가 정본이다. 훑는 것은 서버 장비의 디스크라 경로가 없으면 오류가 아니라 안내로 보여 준다.
*@

@inherits DataPage

<PageTitle>소스 추적 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" SearchText="추적 실행" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => OnProjectChanged())" />
        </CommSchItem>

        <CommSchItem Label="소스">
            <SourceSelect ProjectCode="@_projectCode" @bind-Value="_sourceCode" @bind-Text="_sourceName"
                          OnChanged="@(item => OnSourceChangedAsync(item))" />
        </CommSchItem>

        <CommSchItem Label="확장자">
            <DxComboBox Data="@_extends" Value="@_extend"
                        ValueChanged="@((string? v) => OnExtendChanged(v))" Enabled="@(_extends.Count > 0)"
                        CssClass="pm-code-select" />
        </CommSchItem>
    </Fields>
</CommSch>

<SplitPane Size="45">
    <First>
        @* 칸이 실행 시점에 정해진다 — 소스에 등록한 패턴에 따라 늘고 준다. *@
        <CommCont Title="파일">
            <CommGrd TItem="DataRowView"
                     Data="@_files.Table"
                     ExportName="소스추적"
                     PageSize="30"
                     EmptyText="찾은 파일이 없습니다."
                     Reload="@SearchAsync"
                     SelectedItem="@_pickedFile"
                     SelectedItemChanged="@ShowFileAsync">
                <Columns>
                    <RuntimeColumns Table="@_files.Table" Order="@_files.ColumnOrder" />
                </Columns>
            </CommGrd>
        </CommCont>
    </First>
    <Second>
        @if (_openedPath is null)
        {
            <PageNotice Text="왼쪽에서 파일을 고르면 내용을 보여 줍니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <h2 class="pm-subhead">@_openedPath</h2>

            @* 읽기 전용이다 — 서버 디스크의 파일을 화면에서 덮어쓰는 것은 배포에 속한다. *@
            <CodeEditor Value="@_content" ReadOnly="true" Height="420px" Language="@EditorLanguage" />
        }
    </Second>
</SplitPane>
