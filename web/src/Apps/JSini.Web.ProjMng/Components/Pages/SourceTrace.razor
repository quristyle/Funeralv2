@page "/projmng/source/trace"
@using System.Data

@*
    [소스 추적]

    이력: Vue `views/projmng/develop/source-trace.vue` → 여기.
    프로젝트 소스 코드 간 의존성 및 추적 데이터를 조회한다.
*@

@inject ProjMngClient Client

<PageTitle>소스 추적 · 프로젝트관리</PageTitle>

<h1>소스 추적 <span class="pm-page__scope">프로젝트관리</span></h1>

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="추적 실행" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data" Loading="@_grid.IsLoading" ExportName="소스추적" HideAdd="true" />

@code {
    private ProcGrid _grid = default!;
    private string? _projectCode;

    protected override void OnInitialized()
    {
        _grid = new ProcGrid(Client, "sp_dev_srcinfo_exec");
    }

    private Task SearchAsync() => _grid.LoadAsync(new Dictionary<string, object?> { ["prj_rid"] = _projectCode });
}
