@page "/projmng/wbs/modules"
@attribute [RouteKey("projmng.wbs.modules")]

@*
WBS 모듈별 현황(원본 Modules.vue). 모듈은 서브시스템 코드(systemcode)다.
위는 막대 — 진한 부분을 무엇으로 볼지(완료·개발완료·실적종료 입력) 고른다. 아래는 계획·완료·개발완료·실적일 건수를 한 줄에 두는 표다.
막대나 줄을 누르면 그 모듈로 좁힌 상세 목록으로 넘어간다.
*@

@inherits DataPage

<PageTitle>WBS 모듈별 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="기준일">
            <DxComboBox Data="@WbsBoardOptions.Basis" @bind-Value="_basis"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>
</CommSch>

<section class="pm-wpanel">
    <h2 class="pm-wpanel__head">
        모듈별 건수
        <span class="pm-wpanel__hint">진한 부분 = @OverlayLabel</span>
        <span class="pm-wpanel__spacer"></span>
        <DxComboBox Data="@OverlayOptions" @bind-Value="_overlay"
                    TextFieldName="Text" ValueFieldName="Value" Style="width: 150px" />
    </h2>
    <WbsBarChart Items="@Items" DoneLabel="@OverlayLabel" OnPick="@Drill" />
</section>

<section class="pm-wpanel">
    <h2 class="pm-wpanel__head">
        모듈 상세
    </h2>

    <div class="pm-heat-wrap">
        <table class="pm-wmod">
            <thead>
                <tr>
                    <th rowspan="2">모듈</th>
                    <th rowspan="2">이름</th>
                    <th rowspan="2">건수</th>
                    <th colspan="2" class="pm-wmod__grp pm-wmod__grp--done">완료</th>
                    <th colspan="2" class="pm-wmod__grp pm-wmod__grp--dev">개발완료</th>
                    <th colspan="2" class="pm-wmod__grp pm-wmod__grp--act">실적일 입력</th>
                    <th colspan="2" class="pm-wmod__grp">계획 기간</th>
                    <th colspan="2" class="pm-wmod__grp pm-wmod__grp--act">실적 기간</th>
                </tr>
                <tr class="pm-wmod__sub">
                    <th>건</th><th>율</th>
                    <th>건</th><th>율</th>
                    <th>시작</th><th>종료</th>
                    <th>시작</th><th>종료</th>
                    <th>시작</th><th>종료</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _rows)
                {
                    <tr class="pm-wmod__row" @key="m.Systemcode" @onclick="@(() => Drill(m.Systemcode))">
                        <td class="pm-wmod__code">@m.Systemcode</td>
                        <td class="pm-wmod__name">@m.SystemNm</td>
                        <td class="pm-wmod__num">@m.Cnt</td>

                        <td class="pm-wmod__num @Dim(m.Done)">@Blank(m.Done)</td>
                        <td class="pm-wmod__num pm-wmod__sm @Dim(m.Done)">@(m.Done > 0 ? Pct(m.Done, m.Cnt) : null)</td>

                        <td class="pm-wmod__num pm-wmod__dev @Dim(m.DoneReal)">@Blank(m.DoneReal)</td>
                        <td class="pm-wmod__num pm-wmod__sm pm-wmod__dev @Dim(m.DoneReal)">@(m.DoneReal > 0 ? Pct(m.DoneReal, m.Cnt) : null)</td>

                        <td class="pm-wmod__num pm-wmod__act @Dim(m.ActSdt)">@Blank(m.ActSdt)</td>
                        <td class="pm-wmod__num pm-wmod__act @Dim(m.ActEdt)">@Blank(m.ActEdt)</td>

                        <td class="pm-wmod__date">@(m.MinDt ?? "—")</td>
                        <td class="pm-wmod__date">@(m.MaxDt ?? "—")</td>
                        <td class="pm-wmod__date pm-wmod__act">@(m.MinAct ?? "—")</td>
                        <td class="pm-wmod__date pm-wmod__act">@(m.MaxAct ?? "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">합계</td>
                    <td class="pm-wmod__num">@_rows.Sum(r => r.Cnt)</td>
                    <td class="pm-wmod__num">@_rows.Sum(r => r.Done)</td>
                    <td class="pm-wmod__num pm-wmod__sm">@Pct(_rows.Sum(r => r.Done), _rows.Sum(r => r.Cnt))</td>
                    <td class="pm-wmod__num pm-wmod__dev">@_rows.Sum(r => r.DoneReal)</td>
                    <td class="pm-wmod__num pm-wmod__sm pm-wmod__dev">@Pct(_rows.Sum(r => r.DoneReal), _rows.Sum(r => r.Cnt))</td>
                    <td class="pm-wmod__num pm-wmod__act">@_rows.Sum(r => r.ActSdt)</td>
                    <td class="pm-wmod__num pm-wmod__act">@_rows.Sum(r => r.ActEdt)</td>
                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>

        @if (_rows.Count == 0)
        {
            <p class="jsini-text-muted pm-heat__empty">데이터 없음</p>
        }
    </div>
</section>
