@page "/projmng/ai/task/{TaskKey:long}"
@attribute [RouteKey("projmng.ai.task-view")]
@attribute [ScreenAccess("projmng.ai.tasks")]

@*
보낸 한 건을 펼쳐 보는 화면. 주소가 건마다 있어야 앱알림·메일이 그 건을 바로 가리킨다. 메뉴가 없는 화면이라 탭은 직접 열고, 즐겨찾기로 담지 못하게 막는다.
보여 주는 코드는 휴대폰 쪽과 한 벌이고, 이 화면이 따로 하는 일은 한 건을 스스로 받아 오고 따라가는 것뿐이다.
*@

@inherits DataPage
@implements IDisposable

<PageTitle>@(TabTitle) · 프로젝트관리</PageTitle>

<DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall"
                    IsActive="_isPhone" IsActiveChanged="@OnPhoneChanged" />

<div class="pm-taskview">
    <CommCont>
        <div class="pm-taskview__head">
            <h2 class="pm-taskview__title">@TabTitle</h2>

            @* 다시 읽기. 따라가기가 꺼져 있는 자리를 메운다 — 결과문·처리 파일·요약은 끝난 뒤에도 뒤늦게 적힌다. *@
            <DxButton CssClass="@ReloadCss"
                      RenderStyle="ButtonRenderStyle.Link"
                      IconCssClass="jsini-icon-refresh"
                      Enabled="@(!Loading)"
                      Click="@ReloadAsync"
                      Title="다시 읽기" />
        </div>

        <AiTaskView Item="@_item" Live="true" ReloadTick="@_tick" />

        @if (_item is not null)
        {
            @* jsini-actbar 는 셸에게 하는 말이다 — 바닥 칸을 단추 줄로 쓰니 떠다니는 단추는 그 위로 올라서라. *@
            <div class="pm-taskview__acts jsini-actbar">
                <AiTaskActions Item="@_item"
                               OnChanged="@OnChangedAsync"
                               OnConfirmed="@OnClosedAsync"
                               OnDeleted="@OnClosedAsync"
                               OnClose="@(_isPhone ? EventCallback.Factory.Create(this, ClosePage) : default)" />
            </div>
        }
        else if (_isPhone)
        {
            <div class="pm-taskview__acts jsini-actbar">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@ClosePage">
                    <span class="pm-peek__btn-text--full">닫기</span>
                    <span class="pm-peek__btn-text--short">닫기</span>
                </DxButton>
            </div>
        }
    </CommCont>
</div>
