@page "/projmng/tool/sheet"
@using System.Data

@*
    [프로젝트 시트]

    이력: Vue `views/projmng/proj/sheet.vue` → 여기.
    프로젝트 업무 시트 및 그리드 메타데이터를 조망한다.
*@

@inject ProjMngClient Client

<PageTitle>프로젝트 시트 · 프로젝트관리</PageTitle>

<PageHeading Title="프로젝트 시트" Scope="프로젝트관리" />

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data" Loading="@_grid.IsLoading" ExportName="프로젝트시트" OnRefresh="@SearchAsync" OnSave="@(() => _grid.SaveAsync(Params()))" OnDelete="@(row => _grid.DeleteAsync(row))" />

@code {
    private ProcGrid _grid = default!;
    private string? _projectCode;

    protected override void OnInitialized()
    {
        _grid = new ProcGrid(Client, "sp_dev_proj_exec");
    }

    private Dictionary<string, object?> Params() => new() { ["prj_rid"] = _projectCode ?? string.Empty, ["req_type"] = "sheet" };

    private Task SearchAsync() => _grid.LoadAsync(Params());
}
