@page "/projmng/wbs/period"
@attribute [RouteKey("projmng.wbs.period")]

@*
WBS 기간별 현황(원본 Period.vue). 월·주 막대를 나란히 두고, 막대를 누르면 그 기간으로 좁힌 상세 목록으로 넘어간다.
주는 금요일까지만 센다 — 서버가 주의 끝을 월요일 + 4일로 준다.
*@

@inherits DataPage

<PageTitle>WBS 기간별 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="기준일">
            <DxComboBox Data="@WbsBoardOptions.Basis" @bind-Value="_basis"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>
</CommSch>

<div class="pm-wgrid2">
    <section class="pm-wpanel">
        <h2 class="pm-wpanel__head">
            월단위 건수
        </h2>
        <WbsBarChart Items="@MonthItems" OnPick="@(b => Drill("month", b))" />
    </section>

    <section class="pm-wpanel">
        <h2 class="pm-wpanel__head">
            주단위 건수
            <span class="pm-wpanel__hint">ISO 주 · 월요일 시작</span>
        </h2>
        <WbsBarChart Items="@WeekItems" OnPick="@(b => Drill("week", b))" />
    </section>
</div>
