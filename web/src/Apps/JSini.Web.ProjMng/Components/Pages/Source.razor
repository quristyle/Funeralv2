@page "/projmng/proj/source"
@attribute [RouteKey("projmng.proj.source")]

@*
소스 정보. 왼쪽이 소스 뿌리, 오른쪽이 그 뿌리의 상세(패턴)다 — 소스 추적 화면들이 이 상세를 읽는다.
편집 창은 CommPopup 이고(표가 띄우는 창은 머리를 옮길 수 없다), 저장을 표에 맡기지 않아 OnSave 를 주지 않는다. 편집 모델은 사본이다. 상세의 URL 패턴은 왼쪽 목록에도 올라가므로 함께 다시 읽는다.
*@

@inherits DataPage

<PageTitle>소스 정보 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" ShowAll="true"
                        OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>
    </Fields>

    @* 소스 등록 단추를 여기 직접 두는 이유는 OnSave 를 주지 않아 표의 띠에 등록이 없기 때문이다. 띠에 끼우면 다른 화면과 자리가 어긋나므로 「소스」를 붙여 상세의 「등록」과 가른다. *@
    <Actions>
        <PermissionView Action="MenuAction.Create">
            <DxButton Text="소스 등록" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-plus" Click="@StartNewSource" />
        </PermissionView>
    </Actions>
</CommSch>

<div class="pm-split">
    <CommCont Title="소스 뿌리" CssClass="pm-split__side">
        <CommGrd TItem="SourceInfoDto"
                 Data="@_sources"
                 ExportName="소스정보"
                 PageSize="20"
                 EmptyText="등록된 소스가 없습니다."
                 Reload="@SearchAsync"
                 RowActions="@SourceActions"
                 SelectedItem="@_source"
                 SelectedItemChanged="@PickSourceAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(SourceInfoDto.SrcRid)" Caption="번호" Width="70" />
                <DxGridDataColumn FieldName="@nameof(SourceInfoDto.SrcNick)" Caption="별칭" MinWidth="130"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(SourceInfoDto.SrcLang)" Caption="언어" Width="90" />
                <DxGridDataColumn FieldName="@nameof(SourceInfoDto.PrjName)" Caption="프로젝트" MinWidth="120"
                                  TextAlignment="GridTextAlignment.Left" />
            </Columns>
        </CommGrd>
    </CommCont>

    <CommCont Title="@(_source is null ? "상세" : $"{_source.SrcNick} 의 패턴")"
              CssClass="pm-split__main">
        @if (_source is null)
        {
            <PageNotice Text="왼쪽에서 소스를 고르면 그 패턴이 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <CommGrd TItem="SourceInfoDetailDto"
                     Data="@_details"
                     EditFormTitle="패턴"
                     ExportName="소스상세"
                     PageSize="20"
                     EmptyText="이 소스에 패턴이 없습니다."
                     OnNew="@FillNewDetail"
                     OnSave="@SaveDetailAsync"
                     OnDelete="@DeleteDetailAsync"
                     DeleteConfirm="@(d => $"패턴 「{d.SrcPatternGrp} / {d.SrcExtend}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadDetailsAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(SourceInfoDetailDto.SrcPatternGrp)" Caption="묶음" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(SourceInfoDetailDto.SrcExtend)" Caption="확장자" Width="100" />
                    <DxGridDataColumn FieldName="@nameof(SourceInfoDetailDto.UrlPattern)" Caption="패턴" MinWidth="200"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(SourceInfoDetailDto.SrcPatternComment)" Caption="설명" MinWidth="140"
                                      TextAlignment="GridTextAlignment.Left" />
                </Columns>

                <EditFormTemplate Context="edit">
                    @{
                        var d = (SourceInfoDetailDto)edit.EditModel;
                    }
                    <DxFormLayout CssClass="pm-editform">
                        <DxFormLayoutItem Caption="묶음" ColSpanMd="6">
                            @* `url` 이면 왼쪽 목록의 「URL 패턴」으로 올라간다. *@
                            <DxTextBox @bind-Text="d.SrcPatternGrp" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="확장자" ColSpanMd="6">
                            <DxTextBox @bind-Text="d.SrcExtend" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="패턴" ColSpanMd="12">
                            <DxTextBox @bind-Text="d.UrlPattern" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                            <DxTextBox @bind-Text="d.SrcPatternComment" />
                        </DxFormLayoutItem>

                        @* 옛 화면에서는 **고칠 수 없던 칸**이다(머리말). *@
                        <DxFormLayoutItem Caption="빈 값 대체" ColSpanMd="12">
                            <DxTextBox @bind-Text="d.SrcPatternNullvalue" />
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </CommGrd>
        }
    </CommCont>
</div>

@* 소스 등록·수정 창. 표가 띄우던 창을 대신한다(머리말). *@
<CommPopup @bind-Visible="_editing"
           HeaderText="@(_isNew ? "소스 등록" : "소스 수정")"
           Width="720px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="별칭" ColSpanMd="6">
                <DxTextBox @bind-Text="_form.SrcNick" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="경로" ColSpanMd="6">
                <DxTextBox @bind-Text="_form.SrcPath" />
            </DxFormLayoutItem>

            @* 고르는 칸이다. AutoSelectFirst 를 끈다 — 켜 두면 창을 열기만 해도 언어가 목록 첫 줄로 바뀌어 저장 때 따라 바뀐다. *@
            <DxFormLayoutItem Caption="언어" ColSpanMd="6">
                <CodeSelect CodeId="SOURCE_LANG" @bind-Value="_form.SrcLang"
                            AutoSelectFirst="false" KeepUnknownValue="true" AllowClear="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="OS" ColSpanMd="6">
                <CodeSelect CodeId="SOURCE_OS" @bind-Value="_form.SrcOs"
                            AutoSelectFirst="false" KeepUnknownValue="true" AllowClear="true" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="구분" ColSpanMd="6">
                <DxTextBox @bind-Text="_form.SrcType" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="화면 뿌리" ColSpanMd="6">
                <DxTextBox @bind-Text="_form.SrcUiRoot" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="네임스페이스" ColSpanMd="12">
                <DxTextBox @bind-Text="_form.PrjNamespace" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxTextBox @bind-Text="_form.SrcComm" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveSourceAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>
    /// 관리 칸의 단추. 표가 <c>OnSave</c> 없이도 이 칸을 그리게 하는 것이
    /// 이 조각이다(머리말).
    /// </summary>
    private RenderFragment SourceActions(SourceInfoDto s) =>@<PermissionView Action="MenuAction.Update">
        <DxButton IconCssClass="jsini-icon-edit"
                  Title="수정"
                  RenderStyle="ButtonRenderStyle.Link"
                  Click="@(() => StartEditSource(s))" />
    </PermissionView>;
}
