@page "/proj/source"
@using System.Data

@*
    [프로젝트 소스 정보]

    이력: 옛 Blazor `Pages/Proj/ProjSource.razor` (`/proj-source`)
          → Vue `views/projmng/proj/source.vue` → 여기.
    프로시저: `sp_dev_srcinfo_exec`(소스 묶음), `sp_dev_srcinfo_dtl_exec`(상세)

    프로젝트별 소스 경로·언어 정보를 등록한다. 이 정보가 있어야 소스 추적·
    Glue 추적 화면이 서버에서 파일을 훑을 수 있다.
*@

@inject ProjMngClient Client

<PageTitle>소스 정보 · 프로젝트관리</PageTitle>

<h1>소스 정보</h1>

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<SplitPane Size="45">
    <First>
        <DynamicGrid Data="@_src.Data"
                     Loading="@_src.IsLoading"
                     ExportName="소스정보"
                     OnSave="@(() => _src.SaveAsync())"
                     OnAdd="@FillProject"
                     OnDelete="@(row => _src.DeleteAsync(row))"
                     OnRowClick="@OnSourceSelectedAsync" />
    </First>
    <Second>
        <DynamicGrid Data="@_detail.Data"
                     Loading="@_detail.IsLoading"
                     ExportName="소스정보-상세"
                     HideAdd="@(_selectedSource is null)"
                     OnSave="@(() => _detail.SaveAsync())"
                     OnAdd="@FillSourceKey"
                     OnDelete="@(row => _detail.DeleteAsync(row))" />
    </Second>
</SplitPane>

@code {
    private ProcGrid _src = default!;
    private ProcGrid _detail = default!;

    private string? _projectCode;
    private DataRow? _selectedSource;

    protected override void OnInitialized()
    {
        _src = new ProcGrid(Client, "sp_dev_srcinfo_exec");
        _detail = new ProcGrid(Client, "sp_dev_srcinfo_dtl_exec");
    }

    private async Task SearchAsync()
    {
        _selectedSource = null;
        _detail.Clear();
        await _src.LoadAsync(new Dictionary<string, object?>
        {
            ["prj_rid"] = _projectCode ?? string.Empty,
        });
    }

    private async Task OnSourceSelectedAsync(DataRow? row)
    {
        _selectedSource = row;

        if (row is null)
        {
            _detail.Clear();
            return;
        }

        await _detail.LoadAsync(new Dictionary<string, object?>
        {
            ["src_rid"] = SourceKey(),
        });
    }

    private Task FillProject(DataRow row)
    {
        if (row.Table.Columns.Contains("prj_rid"))
        {
            row["prj_rid"] = _projectCode ?? string.Empty;
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// 상세 행을 새로 만들면 상위 소스 키를 채운다 (옛 <c>OnAddDtlInfo</c>).
    /// 안 채우면 어느 소스의 상세인지 알 수 없어 저장 뒤 목록에서 사라진다.
    /// </summary>
    private Task FillSourceKey(DataRow row)
    {
        if (row.Table.Columns.Contains("src_rid"))
        {
            row["src_rid"] = SourceKey();
        }
        return Task.CompletedTask;
    }

    private string SourceKey()
    {
        if (_selectedSource is null || !_selectedSource.Table.Columns.Contains("src_rid"))
        {
            return string.Empty;
        }

        var value = _selectedSource["src_rid"];
        return value == DBNull.Value ? string.Empty : value.ToString() ?? string.Empty;
    }
}
