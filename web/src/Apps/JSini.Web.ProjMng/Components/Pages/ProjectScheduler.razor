@page "/projmng/proj/scheduler"
@attribute [RouteKey("projmng.proj.scheduler")]

@*
프로젝트 일정표(구글 캘린더 모양). WBS 와 같은 표를 schedule_type 으로 가른다. 월 보기는 주마다 직접 배치하고(BuildWeeks), 주·일 보기는 DxScheduler 를 쓴다.
조회 구간은 보기를 따른다 — 월은 격자(GridSpan) 전체를 읽는다. 구분은 체크로 여럿 고르며 아무것도 안 고르면 전체다. 단축키는 달력에 촛점이 있을 때만 받는다.
*@

@inherits DataPage

<PageTitle>프로젝트 일정표 · 프로젝트관리</PageTitle>

@* 휴대폰인가. 셸의 사이드바 접힘과 같은 경계다 — 같은 기기에서 메뉴는 접혔는데 달력은 데스크톱 모양이면 안 된다. *@
<DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall"
                    IsActive="_isPhone" IsActiveChanged="@OnPhoneChanged" />

<div class="pm-gc">

    @* ── 머리줄 ── 구글과 같은 차례다: 오늘 · ‹ › · 지금 보는 곳 · 보기 고르개. *@
    <div class="pm-gc__bar">
        <button type="button" class="pm-gc__today" title="오늘 (T)" @onclick="@GoTodayAsync">오늘</button>

        <div class="pm-gc__arrows">
            <button type="button" class="pm-gc__arrow" aria-label="이전" title="이전 (←)"
                    @onclick="@(() => ShiftAsync(-1))">
                <i class="jsini-icon-chevron-down pm-gc__chev pm-gc__chev--prev"></i>
            </button>

            <button type="button" class="pm-gc__arrow" aria-label="다음" title="다음 (→)"
                    @onclick="@(() => ShiftAsync(1))">
                <i class="jsini-icon-chevron-down pm-gc__chev pm-gc__chev--next"></i>
            </button>
        </div>

        <h2 class="pm-gc__title">@BarTitle</h2>

        <div class="pm-gc__views" role="tablist" aria-label="보기">
            @foreach (var (view, text, key) in Views)
            {
                var picked = view;

                <button type="button" role="tab"
                        class="pm-gc__view @(view == _view ? "pm-gc__view--on" : null)"
                        aria-selected="@(view == _view ? "true" : "false")"
                        title="@(key is null ? text : $"{text} ({key})")"
                        @onclick="@(() => SetViewAsync(picked))">
                    @text
                </button>
            }
        </div>

        <DxButton Text="메일발송" RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="jsini-icon-mail"
                  CssClass="pm-gc__mail-btn"
                  Click="@OpenMail" />

        <PermissionView Action="MenuAction.Create">
            <DxButton Text="추가" RenderStyle="ButtonRenderStyle.Primary"
                      IconCssClass="jsini-icon-plus"
                      CssClass="pm-gc__add-btn"
                      Click="@(() => StartNew(NewItemStart, NewItemEnd))" />
        </PermissionView>
    </div>

    @* 조회가 도는 동안 머리줄 아래 실선. 달력 보기에서는 이것 말고 「도는 중」을 말할 자리가 없다. *@
    <div class="pm-gc__busy @(Loading ? "pm-gc__busy--on" : null)"></div>

    <div class="pm-gc__body">

        @* ── 왼쪽 기둥 ── 휴대폰에서는 접힌 채로 시작한다 — 가운데는 달력이지 조건이 아니다. *@
        <details class="pm-gc__rail" open="@(!_isPhone)">
            <summary class="pm-gc__rail-summary">
                <span><i class="jsini-icon-filter"></i> 일정 조건</span>
                <i class="jsini-icon-chevron-down pm-gc__rail-chevron"></i>
            </summary>

            <div class="pm-gc__rail-body">
                @if (!_isPhone)
                {
                    <div class="pm-gc-mini">
                        <div class="pm-gc-mini__head">
                            <span class="pm-gc-mini__title">@MiniTitle</span>

                            <button type="button" class="pm-gc-mini__nav" aria-label="이전 달"
                                    @onclick="@(() => StepMiniMonthAsync(-1))">
                                <i class="jsini-icon-chevron-down pm-gc__chev pm-gc__chev--prev"></i>
                            </button>

                            <button type="button" class="pm-gc-mini__nav" aria-label="다음 달"
                                    @onclick="@(() => StepMiniMonthAsync(1))">
                                <i class="jsini-icon-chevron-down pm-gc__chev pm-gc__chev--next"></i>
                            </button>
                        </div>

                        <div class="pm-gc-mini__dow">
                            @foreach (var dow in Weekdays)
                            {
                                <span class="@DowCss(dow)">@DowName(dow)</span>
                            }
                        </div>

                        @* 누르면 그 하루, 끌거나 Shift+누르기면 구간이다. 놓는 것은 격자가 받는다 — 칸 사이 틈에서 떼어도 맺힌다. *@
                        <div class="pm-gc-mini__grid @(_miniDragFrom is not null ? "pm-gc-mini__grid--dragging" : null)"
                             @onmouseup="@OnMiniGridUpAsync"
                             @onmouseleave="@OnMiniGridLeave">
                            @foreach (var day in MiniDays)
                            {
                                var picked = day;
                                var count = MiniCount(day);

                                <button type="button" class="@MiniDayCss(day)"
                                        title="@MiniDayTitle(day, count)"
                                        @onmousedown="@(e => OnMiniDayDownAsync(picked, e))"
                                        @onmouseenter="@(() => OnMiniDayEnter(picked))"
                                        @onclick="@(e => OnMiniDayKeyClickAsync(picked, e))">
                                    <span class="pm-gc-mini__day-num">@day.Day</span>
                                    <span class="pm-gc-mini__count-slot">
                                        @if (count > 0)
                                        {
                                            <span class="pm-gc-mini__count">@(count > 99 ? "99+" : count)</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>

                        @if (MiniRangeText is { } rangeText)
                        {
                            <div class="pm-gc-mini__range" aria-live="polite">
                                <i class="jsini-icon-calendar"></i>
                                <span>@rangeText</span>
                            </div>
                        }
                    </div>
                }

                <CommSch Stacked="true" OnSearch="@SearchAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
                    <Fields>
                        @* 기억해 둔 프로젝트를 읽기 전에 그리면 고르개가 첫 항목을 골라 조회를 먼저 건다.
                           「전체」(또는 지우기)는 내가 참여한 프로젝트 전부다. *@
                        <CommSchItem Label="프로젝트">
                            @if (_projectRestored)
                            {
                                <CodeSelect CodeId="projlist" ShowAll="true" AllowClear="true"
                                            @bind-Value="_projectCode" @bind-Text="_projectName"
                                            OnChanged="@OnProjectChangedAsync" />
                            }
                        </CommSchItem>

                        @* 체크로 여럿 고른다. 아무것도 안 고르면 전체다. *@
                        <CommSchItem Label="구분">
                            <CodeSelect CodeId="schedule_type" Multiple="true"
                                        Values="@_scheduleTypes" @bind-Text="_kindNames"
                                        ValuesChanged="@OnKindsChangedAsync" />
                        </CommSchItem>

                        <CommSchItem Label="진행">
                            <CodeSelect CodeId="compstat" @bind-Value="_completeState" ShowAll="true"
                                        @bind-Text="_completeStateName" />
                        </CommSchItem>

                        @if (_view == CalView.Table)
                        {
                            <CommSchItem Label="시작일">
                                <DxDateEdit Date="@TableStartDateTime"
                                            DateChanged="@((DateTime? d) => OnTableStartChangedAsync(d))"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </CommSchItem>
                            <CommSchItem Label="종료일">
                                <DxDateEdit Date="@TableEndDateTime"
                                            DateChanged="@((DateTime? d) => OnTableEndChangedAsync(d))"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </CommSchItem>
                            @* 읽어 둔 줄을 화면에서 거른다 — 글자마다 서버를 부르지 않는다. *@
                            <CommSchItem Label="내용">
                                <DxTextBox @bind-Text="_keyword"
                                           BindValueMode="BindValueMode.OnInput" InputDelay="300"
                                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                           ValidationEnabled="false" />
                            </CommSchItem>
                        }
                    </Fields>
                </CommSch>

                @* 색은 자료의 일부라 범례가 없으면 빨간 막대가 그냥 「빨간 것」이 된다. 색이 무엇인지 적어 둔다. *@
                <ul class="pm-gc__legend">
                    @foreach (var label in StateLabels)
                    {
                        <li><span class="pm-gc__dot pm-gc__dot--@label.Id"></span>@label.Caption</li>
                    }
                </ul>
            </div>
        </details>

        @* ── 달력 판 ── 단축키는 여기 촛점이 있을 때만 받는다. *@
        <div class="pm-gc__main" tabindex="0" @onkeydown="@OnKeyAsync">

            @if (_view == CalView.Table)
            {
                @* 휴대폰은 표를 카드로 펴서 가로로 굴릴 것이 없다 — 좌우로 쓸면 하루 앞뒤로 간다. *@
                <div class="pm-gc-swipe" @ref="_dayTurnRef" @ontouchstart="@OnTouchStart" @ontouchend="@OnDaySwipeEndAsync">
                <CommCont Title="일정표" Hint="@Hint">
                    @* 입력칸은 <b>고른 줄에만</b> 세운다. 줄마다 DxDateEdit·DxComboBox 를 아홉 개씩 깔면 표로 바꿀 때마다
                       수백 개의 부품이 한꺼번에 서서 화면이 얼어붙는다. 나머지 줄은 글자만 그리고, 줄을 누르면 그 줄이 편집칸이 된다.
                       첫 줄을 저절로 고르지 않는다 — 고르면 열자마자 한 줄이 입력칸으로 서서 그만큼 다시 무거워진다. *@
                    <CommGrd TItem="WbsItemDto"
                             Data="@TableRows"
                             KeyFieldName="@nameof(WbsItemDto.WbsId)"
                             EditFormTitle="일정"
                             ExportName="일정표"
                             PageSize="30"
                             ShowHeader="false"
                             ShowFilterRow="true"
                             EmptyText="그 기간에 일정이 없습니다."
                             AutoSelectFirstRow="false"
                             SelectedItem="@_editRow"
                             SelectedItemChanged="@OnTableRowSelected"
                             OnNew="@FillNew"
                             OnSave="@SaveRowAsync"
                             OnDelete="@DeleteAsync"
                             DeleteConfirm="@(w => $"「{w.ProcNm}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                             Reload="@SearchAsync">
                        <Columns>
                            @* 시작·종료·기간·알림·요청자·담당자·관리 칸만 보인다. 나머지는 숨긴다. *@
                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanSdt)" Caption="시작" Width="150"
                                              FixedPosition="@PinnedColumn">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxDateEdit Date="@w.PlanSdt"
                                                    DateChanged="@((DateTime? d) => OnInlinePlanSdtChangedAsync(w, d))"
                                                    TimeSectionVisible="true"
                                                    DisplayFormat="yyyy-MM-dd HH:mm"
                                                    Format="yyyy-MM-dd HH:mm"
                                                    ValidationEnabled="false"
                                                    CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@w.PlanSdt?.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanEdt)" Caption="종료" Width="150"
                                              FixedPosition="@PinnedColumn">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxDateEdit Date="@w.PlanEdt"
                                                    DateChanged="@((DateTime? d) => OnInlinePlanEdtChangedAsync(w, d))"
                                                    TimeSectionVisible="true"
                                                    DisplayFormat="yyyy-MM-dd HH:mm"
                                                    Format="yyyy-MM-dd HH:mm"
                                                    ValidationEnabled="false"
                                                    CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@w.PlanEdt?.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            @* 기간은 총 시간으로 적는다(하루 24시간, PlanHours). *@
                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanHours)" Caption="기간" Width="95"
                                              TextAlignment="GridTextAlignment.Right"
                                              FixedPosition="@PinnedColumn">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    <span title="@HoursTip(w.PlanHours)">@HoursText(w.PlanHours)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            @* 「전체」로 볼 때만 선다 — 하나를 골랐으면 모든 줄이 같은 값이다. *@
                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PrjRid)" Caption="프로젝트" Width="140"
                                              Visible="@AllProjects">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    <span class="pm-gc-prj" style="--pm-prj: @ProjectColor(w)" title="@ProjectName(w)">@ProjectName(w)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcNm)" Caption="알림" MinWidth="180"
                                              TextAlignment="GridTextAlignment.Left">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxTextBox Text="@w.ProcNm"
                                                   TextChanged="@((string? t) => OnInlineProcNmChangedAsync(w, t))"
                                                   BindValueMode="BindValueMode.OnLostFocus"
                                                   NullText="알림명 입력"
                                                   ValidationEnabled="false"
                                                   CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span title="@w.ProcNm">@w.ProcNm</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ScheduleType)" Caption="구분" Width="110"
                                              Visible="false">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxComboBox Data="@_scheduleTypeCodes"
                                                    TextFieldName="@nameof(CommonCodeItem.Name)"
                                                    ValueFieldName="@nameof(CommonCodeItem.Code)"
                                                    Value="@w.ScheduleType"
                                                    ValueChanged="@((string? s) => OnInlineScheduleTypeChangedAsync(w, s))"
                                                    NullText="구분"
                                                    ValidationEnabled="false"
                                                    CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@GetScheduleTypeName(w.ScheduleType)</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcTp)" Caption="종류" Width="110"
                                              Visible="false">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxTextBox Text="@w.ProcTp"
                                                   TextChanged="@((string? t) => OnInlineProcTpChangedAsync(w, t))"
                                                   BindValueMode="BindValueMode.OnLostFocus"
                                                   NullText="종류 입력"
                                                   ValidationEnabled="false"
                                                   CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@w.ProcTp</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ReqUser)" Caption="요청자" Width="110">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxTextBox Text="@w.ReqUser"
                                                   TextChanged="@((string? t) => OnInlineReqUserChangedAsync(w, t))"
                                                   BindValueMode="BindValueMode.OnLostFocus"
                                                   NullText="요청자 입력"
                                                   ValidationEnabled="false"
                                                   CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@w.ReqUser</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevUser)" Caption="담당자" Width="130">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxComboBox Data="@_userOptions"
                                                    TextFieldName="@nameof(BizOption.Label)"
                                                    ValueFieldName="@nameof(BizOption.Value)"
                                                    Value="@w.DevUser"
                                                    ValueChanged="@((string? u) => OnInlineDevUserChangedAsync(w, u))"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                    AllowUserInput="true"
                                                    NullText="담당자"
                                                    ValidationEnabled="false"
                                                    CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@GetUserDisplayName(w.DevUser)</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.AddTarget)" Caption="추가대상" Width="100">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxComboBox Data="@_addTargetCodes"
                                                    TextFieldName="@nameof(CommonCodeItem.Name)"
                                                    ValueFieldName="@nameof(CommonCodeItem.Code)"
                                                    Value="@w.AddTarget"
                                                    ValueChanged="@((string? s) => OnInlineAddTargetChangedAsync(w, s))"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                    NullText="추가대상"
                                                    ValidationEnabled="false"
                                                    CssClass="pm-inline-edit" />
                                    }
                                    else if (AddTargets.Name(w.AddTarget) is { } target)
                                    {
                                        <span class="jsini-badge jsini-badge--warn">@target</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.WbsState)" Caption="진행" Width="115"
                                              Visible="false">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <div class="pm-inline-state-wrapper">
                                            <DxComboBox Data="@StateOptions" TData="StateOption" TValue="string"
                                                        TextFieldName="Name"
                                                        ValueFieldName="Code"
                                                        Value="@GetInlineStateCode(w)"
                                                        ValueChanged="@((string val) => OnInlineStateChangedAsync(w, val))"
                                                        ValidationEnabled="false"
                                                        CssClass="pm-inline-edit pm-inline-state" />
                                            @if (LabelOf(w, Today) == "OVER")
                                            {
                                                <span class="jsini-badge jsini-badge--err pm-inline-over-badge" title="계획종료일이 지난 지연 상태입니다">지연</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="jsini-badge @StateClass(w)">@StateName(w)</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            @* 좁은 화면에서는 이 넷을 접는다 — 아홉 칸을 그대로 두면 표가 가로로 두 배가 되어 제목조차 안 보인다. *@
                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.Comm)" Caption="메모" MinWidth="140"
                                              TextAlignment="GridTextAlignment.Left"
                                              Visible="false">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxTextBox Text="@w.Comm"
                                                   TextChanged="@((string? t) => OnInlineCommChangedAsync(w, t))"
                                                   BindValueMode="BindValueMode.OnLostFocus"
                                                   NullText="메모 입력"
                                                   ValidationEnabled="false"
                                                   CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span>@w.Comm</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="@nameof(WbsItemDto.BodyText)" Caption="원문" MinWidth="140"
                                              TextAlignment="GridTextAlignment.Left"
                                              Visible="false">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var w = (WbsItemDto)cell.DataItem;
                                    }
                                    @if (IsEditing(w))
                                    {
                                        <DxTextBox Text="@w.BodyText"
                                                   TextChanged="@((string? t) => OnInlineBodyTextChangedAsync(w, t))"
                                                   BindValueMode="BindValueMode.OnLostFocus"
                                                   NullText="원문 없음"
                                                   ValidationEnabled="false"
                                                   CssClass="pm-inline-edit" />
                                    }
                                    else
                                    {
                                        <span title="@w.BodyText">@w.BodyText</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>

                        <EditFormTemplate Context="edit">
                            <WbsEditForm Item="@((WbsItemDto)edit.EditModel)" />
                        </EditFormTemplate>
                    </CommGrd>
                </CommCont>
                </div>
            }
            else if (_view == CalView.Month)
            {
                @* 주 한 줄씩 직접 배치한다 — 여러 날에 걸친 일이 칸을 가로질러 하나의 막대로 흐른다. *@
                <div class="pm-gc-month @(_isPhone ? "pm-gc-month--phone" : null)"
                     data-drag-owner="@_dragOwner"
                     @ref="_monthTurnRef"
                     @ontouchstart="@OnTouchStart"
                     @ontouchend="@OnTouchEndAsync">
                    <div class="pm-gc-month__dow">
                        @foreach (var dow in Weekdays)
                        {
                            <span class="pm-gc-month__dow-cell @DowCss(dow)">@DowName(dow)</span>
                        }
                    </div>

                    @foreach (var week in _weeks)
                    {
                        @* 끌어 옮기기는 gc-month-drag.js 가 받는다 — 놓을 날을 이 줄의 첫날과 가로 자리로 셈한다. *@
                        <div class="pm-gc-week" data-start="@week.Days[0].Date.ToString("yyyy-MM-dd")">
                            <div class="pm-gc-week__days">
                                @foreach (var day in week.Days)
                                {
                                    var here = day;

                                    <div class="@DayCss(day)">
                                        <button type="button" class="pm-gc-day__fill"
                                                aria-label="@DayLabel(day)"
                                                @onclick="@(() => OnDayClickAsync(here.Date))"></button>

                                        <button type="button" class="pm-gc-day__num"
                                                aria-label="@($"{here.Date.Month}월 {here.Date.Day}일 보기")"
                                                @onclick="@(() => OnDayNumberAsync(here.Date))">
                                            @day.Date.Day
                                        </button>
                                    </div>
                                }
                            </div>

                            <div class="pm-gc-week__bars">
                                @foreach (var bar in week.Bars.Where(b => b.Lane < MaxLanes))
                                {
                                    var here = bar;

                                    <button type="button"
                                            class="@BarCss(bar)"
                                            style="@BarStyle(bar)"
                                            title="@BarTip(bar.Item)"
                                            data-wbs="@bar.Item.WbsId"
                                            data-drag="@_canUpdate"
                                            disabled="@(!_canUpdate)"
                                            @onclick="@(() => OnBarClick(week, here))">
                                        @if (ProjectTag(bar.Item) is { } prj)
                                        {
                                            <span class="pm-gc-bar__prj">@prj</span>
                                        }
                                        @Title(bar.Item)
                                    </button>
                                }

                                @for (var col = 0; col < 7; col++)
                                {
                                    var here = col;
                                    var hidden = HiddenAt(week, col);

                                    @if (hidden > 0)
                                    {
                                        @* 휴대폰에서는 칸이 좁아 「+2」만 보이고, 읽어 주는 쪽에는 온전한 말을 남긴다. *@
                                        <button type="button" class="pm-gc-week__more"
                                                style="@MoreStyle(here)"
                                                aria-label="@($"{hidden}개 더보기")"
                                                @onclick="@(() => OnMoreClick(week.Days[here].Date))">
                                            @(_isPhone ? $"+{hidden}" : $"{hidden}개 더보기")
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (_isPhone)
                {
                    @* 격자 아래 고른 날의 목록. 구글 캘린더 앱과 같은 자리다. *@
                    @* 격자를 쓸면 달이, 이 목록을 쓸면 날이 넘어간다. *@
                    <div class="pm-gc-agenda pm-gc-agenda--under"
                         @ref="_dayTurnRef"
                         @ontouchstart="@OnTouchStart"
                         @ontouchend="@OnDaySwipeEndAsync">
                        <div class="pm-gc-agenda__head">
                            <span class="pm-gc-agenda__title">@AgendaTitle</span>

                            <PermissionView Action="MenuAction.Create">
                                <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary"
                                          IconCssClass="jsini-icon-plus"
                                          Click="@(() => StartNew(_selected, _selected))" />
                            </PermissionView>
                        </div>

                        @if (SelectedItems.Count == 0)
                        {
                            <p class="pm-gc-agenda__empty">이 날은 일정이 없습니다.</p>
                        }
                        else
                        {
                            <ul class="pm-gc-agenda__items">
                                @foreach (var w in SelectedItems)
                                {
                                    @ItemRow(w, toggle: true)
                                }
                            </ul>
                        }
                    </div>
                }
            }
            else if (_view == CalView.Agenda || _isPhone)
            {
                @* 일정 목록. 휴대폰의 주·일 보기도 여기로 온다 — 시각 없는 종일 일정은 시간 격자에서 자정 줄에 다 붙는다. *@
                <div class="pm-gc-agenda"
                     @ref="_dayTurnRef"
                     @ontouchstart="@OnTouchStart"
                     @ontouchend="@OnDaySwipeEndAsync">
                    @if (_days.All(d => d.Items.Count == 0))
                    {
                        <p class="pm-gc-agenda__empty">이 기간에 일정이 없습니다.</p>
                    }
                    else
                    {
                        @foreach (var day in _days.Where(d => d.Items.Count > 0))
                        {
                            <div class="pm-gc-agenda__day @(day.Date == Today ? "pm-gc-agenda__day--today" : null)">
                                <div class="pm-gc-agenda__date">
                                    <span class="pm-gc-agenda__dnum">@day.Date.Day</span>
                                    <span class="pm-gc-agenda__dow @DowCss(day.Date.DayOfWeek)">@DowName(day.Date.DayOfWeek)</span>
                                    <span class="pm-gc-agenda__month">@(day.Date.Month)월</span>
                                </div>

                                <ul class="pm-gc-agenda__items">
                                    @foreach (var w in day.Items)
                                    {
                                        @ItemRow(w, toggle: true)
                                    }
                                </ul>
                            </div>
                        }
                    }
                </div>
            }
            else if (_storage is not null)
            {
                <DxScheduler DataStorage="@_storage"
                             StartDate="@_anchor"
                             ActiveViewType="@ViewType"
                             ShowToolbarArea="false"
                             AllowCreateAppointment="false"
                             AllowEditAppointment="@_canUpdate"
                             AllowDeleteAppointment="@_canDelete"
                             AllowDragAppointment="@_canUpdate"
                             AllowResizeAppointment="@_canUpdate"
                             AppointmentFormShowing="@OnFormShowing"
                             AppointmentUpdating="@OnUpdatingAsync"
                             AppointmentRemoving="@OnRemovingAsync"
                             CssClass="pm-sched">
                    <DxSchedulerWeekView />
                    <DxSchedulerDayView />
                </DxScheduler>
            }
        </div>

        @* ── 오른쪽 기둥 ── 월 격자에서 고른 날의 일정. 날을 누르면 펴지고 × 로 접는다. *@
        @if (ShowDayPane)
        {
            <aside class="pm-gc__day" aria-label="@($"{AgendaTitle} 일정")">
                <div class="pm-gc-agenda__head">
                    <span class="pm-gc-agenda__title">@AgendaTitle</span>

                    <span class="pm-gc__day-tools">
                        <PermissionView Action="MenuAction.Create">
                            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary"
                                      IconCssClass="jsini-icon-plus"
                                      Click="@(() => StartNew(_selected, _selected))" />
                        </PermissionView>

                        <button type="button" class="pm-gc__day-close" aria-label="닫기" title="닫기"
                                @onclick="@(() => _dayPane = false)">×</button>
                    </span>
                </div>

                @if (SelectedItems.Count == 0)
                {
                    <p class="pm-gc-agenda__empty">이 날은 일정이 없습니다.</p>
                }
                else
                {
                    <ul class="pm-gc-agenda__items">
                        @foreach (var w in SelectedItems)
                        {
                            @ItemRow(w, toggle: true)
                        }
                    </ul>
                }
            </aside>
        }
    </div>
</div>

@* 달력에서 여는 편집 창. 표의 편집 창과 같은 칸(WbsEditForm)에 이 화면만 필요한 프로젝트·구분·진행 상태를 앞에 얹었다. *@
<CommPopup @bind-Visible="_editing" HeaderText="@(_isNew ? "일정 등록" : "일정 수정")"
           Width="680px" MaxHeight="80vh" Scrollable="true">
    <BodyContentTemplate Context="popup">
        <div class="pm-scheduler-edit">
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="프로젝트" ColSpanMd="6">
                    <CodeSelect CodeId="projlist" AutoSelectFirst="false" KeepUnknownValue="true"
                                Value="@(_form.PrjRid?.ToString())"
                                ValueChanged="@((string? code) => _form.PrjRid = int.TryParse(code, out var rid) ? rid : null)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="구분" ColSpanMd="6">
                    @* 저장된 값이 코드표에 없어도 지우지 않는다 — 옛 값이 그대로 남은 줄이 있다. *@
                    <CodeSelect CodeId="schedule_type" AutoSelectFirst="false" KeepUnknownValue="true"
                                @bind-Value="_form.ScheduleType" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="진행 상태" ColSpanMd="12">
                    <DxComboBox Data="@StateOptions" TData="StateOption" TValue="string" TextFieldName="Name" ValueFieldName="Code"
                                Value="@_formState" ValueChanged="@OnFormStateChanged"
                                ValidationEnabled="false" />
                </DxFormLayoutItem>
            </DxFormLayout>

            <WbsEditForm Item="@_form" />
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popupContext">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => SaveFormAsync(false))" />

        @* 원본의 `OnTodayAndSave`. 미뤄 둔 일을 오늘로 끌어오는 한 번 누르기다. *@
        <DxButton Text="오늘로 옮겨 저장" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => SaveFormAsync(true))" />

        @if (!_isNew)
        {
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="복제" RenderStyle="ButtonRenderStyle.Secondary" Click="@DuplicateFormAsync" />
            </PermissionView>
            <PermissionView Action="MenuAction.Delete">
                <DxButton Text="삭제" RenderStyle="ButtonRenderStyle.Danger" Click="@DeleteFormAsync" />
            </PermissionView>
        }

        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _editing = false)" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />

@* 목록 한 줄. 달력 아래·오른쪽 기둥·일정 보기가 같은 줄을 쓴다 — 셋이 갈리면 같은 일정이 자리마다 달리 적힌다. *@

@code {
    // toggle 이면 상태가 줄 단추 밖의 제 단추가 된다 — 단추 안에 단추를 넣으면 브라우저가 바깥 단추를 둘로 쪼갠다.
    private RenderFragment ItemRow(WbsItemDto w, bool toggle = false) =>
        @<li class="pm-gc-agenda__item pm-gc-agenda__item--@Label(w) @(toggle ? "pm-gc-agenda__item--toggle" : null)">
            <button type="button" class="pm-gc-agenda__btn"
                    disabled="@(!_canUpdate)"
                    @onclick="@(() => StartEdit(w))">
                @if (ProjectTag(w) is { } prj)
                {
                    <span class="pm-gc-prj" style="--pm-prj: @ProjectColor(w)">@prj</span>
                }
                <span class="pm-gc-agenda__top">
                    <span class="pm-gc-agenda__name">@Title(w)</span>
                    @if (!toggle)
                    {
                        <span class="jsini-badge @AgendaStateClass(w)">@AgendaStateName(w)</span>
                    }
                </span>
                @if (!string.IsNullOrWhiteSpace(w.Comm))
                {
                    <span class="pm-gc-agenda__sub">@w.Comm</span>
                }
            </button>
            @if (toggle)
            {
                <button type="button" class="jsini-badge @AgendaStateClass(w) pm-gc-agenda__state"
                        disabled="@(!_canUpdate || _toggling.Contains(w.WbsId))"
                        title="@($"눌러 {NextAgendaStateAction(w)}")"
                        @onclick="@(() => CycleAgendaStateAsync(w))">@AgendaStateName(w)</button>
            }
        </li>;
}
