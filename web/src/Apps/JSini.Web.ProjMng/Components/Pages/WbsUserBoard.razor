@page "/projmng/wbs/users"
@attribute [RouteKey("projmng.wbs.users")]

@*
WBS 개발자별 현황(원본 Users.vue). 월·주 × 담당자·개발자 네 판을 한 화면에 함께 편다 — 담당자(user_bp_id · complate_yn)와
개발자(user_real_id · complate_real_yn)가 다른 줄이 있어, 한쪽만 보면 넘겨받은 일이 어디로 갔는지 안 보인다.
칸을 누르면 그 사람·그 기간으로 좁힌 상세 목록으로 넘어간다.
*@

@inherits DataPage

<PageTitle>WBS 개발자별 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="기준일">
            <DxComboBox Data="@WbsBoardOptions.Basis" @bind-Value="_basis"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>
</CommSch>

<section class="pm-wpanel">
    <h2 class="pm-wpanel__head">
        월단위 담당자별 건수
        <span class="pm-wpanel__hint">@BasisLabel 기준 · 담당자 user_bp_id / 완료 complate_yn · 칸을 누르면 상세 목록으로 이동</span>
    </h2>
    <WbsHeatMatrix Rows="@_planMonth" ColHead="월" OnPick="@(p => Drill("user", "month", p))" />
</section>

<section class="pm-wpanel">
    <h2 class="pm-wpanel__head">
        주단위 담당자별 건수
        <span class="pm-wpanel__hint">@BasisLabel 기준 · ISO 주(월요일 시작) · 머리글 아래는 해당 주 마지막 날</span>
    </h2>
    <WbsHeatMatrix Rows="@_planWeek" Weekly="true" ColHead="주" OnPick="@(p => Drill("user", "week", p))" />
</section>

<section class="pm-wpanel pm-wpanel--real">
    <h2 class="pm-wpanel__head">
        월단위 개발자별 건수
        <span class="pm-wpanel__hint">@BasisLabel 기준 · 개발자 user_real_id / 완료 complate_real_yn</span>
    </h2>
    <WbsHeatMatrix Rows="@_realMonth" ColHead="월" OnPick="@(p => Drill("realUser", "month", p))" />
</section>

<section class="pm-wpanel pm-wpanel--real">
    <h2 class="pm-wpanel__head">
        주단위 개발자별 건수
        <span class="pm-wpanel__hint">@BasisLabel 기준 · ISO 주(월요일 시작)</span>
    </h2>
    <WbsHeatMatrix Rows="@_realWeek" Weekly="true" ColHead="주" OnPick="@(p => Drill("realUser", "week", p))" />
</section>
