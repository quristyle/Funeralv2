@page "/projmng/wbs/users"
@attribute [RouteKey("projmng.wbs.users")]

@*
WBS 개발자별 현황. 사람 × 기간 매트릭스라 칸이 자료에 따라 정해지므로 CommGrd 가 아니라 판을 직접 그린다. 진한 칸일수록 건수가 많고, 누르면 그 사람·기간으로 좁힌 상세 목록으로 넘어간다.
*@

@inherits DataPage

<PageTitle>WBS 개발자별 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="단위">
            <DxComboBox Data="@UnitOptions" @bind-Value="_unit"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 110px" />
        </CommSchItem>

        <CommSchItem Label="기준일">
            <DxComboBox Data="@WbsBoardOptions.Basis" @bind-Value="_basis"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="잣대">
            <DxComboBox Data="@WbsBoardOptions.Who" @bind-Value="_who"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>
</CommSch>

@if (_buckets.Count == 0)
{
    <PageNotice Tone="NoticeTone.Info" Text="보여 줄 자료가 없습니다." />
}
else
{
    <div class="pm-heat-wrap">
        <table class="pm-heat">
            <thead>
                <tr>
                    <th class="pm-heat__name">담당자</th>
                    @foreach (var bucket in _buckets)
                    {
                        <th>@bucket</th>
                    }
                    <th class="pm-heat__total">합계</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="pm-heat__name" title="@row.UserBpId">@row.UserNm</td>

                        @foreach (var bucket in _buckets)
                        {
                            var cell = row.Cell(bucket);

                            <td class="pm-heat__cell @(cell.Cnt == 0 ? "is-empty" : null)"
                                style="@Shade(cell.Cnt)"
                                title="@($"{row.UserNm} · {bucket} · {cell.Cnt}건 중 {cell.Done}건 완료")"
                                @onclick="@(() => DrillAsync(row.UserBpId, bucket))">
                                @if (cell.Cnt > 0)
                                {
                                    <span class="pm-heat__cnt">@cell.Cnt</span>
                                    <span class="pm-heat__done">@cell.Done</span>
                                }
                            </td>
                        }

                        <td class="pm-heat__total">@row.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}
