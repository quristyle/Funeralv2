@page "/projmng/comm/common-code"
@attribute [RouteKey("projmng.comm.common-code")]

@*
공통코드(프로젝트관리). 왼쪽이 묶음, 오른쪽이 그 묶음의 코드이며 같은 표다 — 상위 코드(cm_pcd)가 비면 묶음이다.
포털 공통코드(scom)와는 아무 관계가 없다. 한 건씩 팝업으로 고치고, 묶음을 지울 때 딸린 코드는 외래키가 없어 서버가 센다.
*@

@inherits DataPage

<PageTitle>공통코드 · 프로젝트관리</PageTitle>

<div class="pm-split">
    <CommCont Title="묶음" CssClass="pm-split__side">
        <CommGrd TItem="DevCommonCodeDto"
                 Data="@_groups"
                 EditFormTitle="코드 묶음"
                 ExportName="공통코드묶음"
                 PageSize="20"
                 EmptyText="등록된 묶음이 없습니다."
                 OnNew="@FillNewGroup"
                 OnSave="@SaveAsync"
                 OnDelete="@DeleteGroupAsync"
                 DeleteConfirm="@(g => $"묶음 「{g.CmNm}」({g.CmCd}) 을(를) 지웁니다.\n딸린 코드가 있으면 지워지지 않습니다.")"
                 Reload="@LoadGroupsAsync"
                 SelectedItem="@_group"
                 SelectedItemChanged="@PickGroupAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmCd)" Caption="코드" Width="130"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmNm)" Caption="이름" MinWidth="120"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmSrt)" Caption="순서" Width="70" />
            </Columns>

            <EditFormTemplate Context="edit">
                @CodeForm((DevCommonCodeDto)edit.EditModel, isGroup: true)
            </EditFormTemplate>
        </CommGrd>
    </CommCont>

    <CommCont Title="@(_group is null ? "코드" : $"{_group.CmNm} 의 코드")"
              CssClass="pm-split__main">
        @if (_group is null)
        {
            <PageNotice Text="왼쪽에서 묶음을 고르면 그 코드가 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <CommGrd TItem="DevCommonCodeDto"
                     Data="@_codes"
                     EditFormTitle="코드"
                     ExportName="공통코드"
                     PageSize="20"
                     EmptyText="이 묶음에 코드가 없습니다."
                     OnNew="@FillNewCode"
                     OnSave="@SaveAsync"
                     OnDelete="@DeleteCodeAsync"
                     DeleteConfirm="@(c => $"코드 「{c.CmNm}」({c.CmCd}) 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadCodesAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmCd)" Caption="코드" Width="130"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmNm)" Caption="이름" MinWidth="120"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmVal)" Caption="값" MinWidth="100"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmType)" Caption="구분" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmSrt)" Caption="순서" Width="70" />
                </Columns>

                <EditFormTemplate Context="edit">
                    @CodeForm((DevCommonCodeDto)edit.EditModel, isGroup: false)
                </EditFormTemplate>
            </CommGrd>
        }
    </CommCont>
</div>

@code {
    /// <summary>
    /// 편집 창. <b>묶음과 코드가 같은 표</b>라 같은 폼을 쓴다 — 다른 것은
    /// 상위 코드 칸 하나뿐이고, 그것은 묶음일 때 아예 없다.
    /// </summary>
    private RenderFragment CodeForm(DevCommonCodeDto c, bool isGroup) =>@<text>
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="코드" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmCd" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmNm" />
            </DxFormLayoutItem>

            @if (!isGroup)
            {
                <DxFormLayoutItem Caption="값" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="구분" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmType" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="값2" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal2" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="값3" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal3" />
                </DxFormLayoutItem>
            }

            <DxFormLayoutItem Caption="속성" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmProp" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="순서" ColSpanMd="6">
                @* 비우면 서버가 999 를 넣는다 — 옛 수정이 쓰던 기본값과 같다. *@
                <DxSpinEdit @bind-Value="c.CmSrt" />
            </DxFormLayoutItem>

            @* 옛 프로시저가 읽지도 쓰지도 않던 칸이다. 표에 있으므로 다룬다. *@
            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxTextBox @bind-Text="c.CmRmk" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </text>;
}
