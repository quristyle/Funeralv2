@page "/projmng/comm/common-code"
@attribute [RouteKey("projmng.comm.common-code")]

@*
    [공통코드]

    이력: Vue `views/projmng/comm/common-code` → `DynamicGrid` +
          `sp_devcomm_exec` → **여기 (`CommGrd` + REST)**
    API: `projmng/dev-common-codes`

    왼쪽이 묶음, 오른쪽이 그 묶음의 코드다. **둘은 같은 표**이고 상위
    코드(`cm_pcd`)가 비어 있으면 묶음, 채워져 있으면 코드다.

    ────────────────────────────────────────────────────────────
    [포털 공통코드와 다른 표다]

    이름이 같아 헷갈리기 쉬운데 `scom` 쪽의 공통코드와 **아무 관계가 없다.**
    여기서 고친 값은 포털 화면의 드롭다운에 나타나지 않는다 — 그쪽은
    [포털관리 › 공통코드]다. 클라이언트 이름에 `Dev` 를 붙여 둔 이유이기도 하다.

    [한 건씩 팝업으로 고친다]

    옛 화면은 표 안에서 여러 줄을 고쳐 두었다가 한 번에 저장했다. 코드는
    **한 줄이 곧 한 뜻**이라 여러 줄을 동시에 손보는 일이 드물고, 팝업이면
    칸 이름이 한글로 보인다(표 안 편집은 `cm_val2` 같은 DB 이름 그대로였다).

    [묶음을 지울 때 딸린 코드를 확인한다]

    표에 외래키가 없어 DB 가 막아 주지 않는다. 그냥 지우면 갈 곳 없는 코드가
    남고, 그 코드는 어느 화면에도 안 나오면서 목록 건수만 늘린다.
    **서버가 센다** — 화면에서 세면 방금 다른 사람이 넣은 것을 못 본다.
*@

@inherits DataPage
@inject DevCommonCodeClient Api

<PageTitle>공통코드 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Info"
            Text="프로젝트관리 전용 코드입니다. 포털 화면의 드롭다운은 [포털관리 › 공통코드]에서 정합니다." />

<div class="pm-split">
    <CommCont Title="묶음" Hint="@($"{_groups.Count}건")" CssClass="pm-split__side">
        <CommGrd TItem="DevCommonCodeDto"
                 Data="@_groups"
                 EditFormTitle="코드 묶음"
                 ExportName="공통코드묶음"
                 PageSize="20"
                 EmptyText="등록된 묶음이 없습니다."
                 OnNew="@FillNewGroup"
                 OnSave="@SaveAsync"
                 OnDelete="@DeleteGroupAsync"
                 DeleteConfirm="@(g => $"묶음 「{g.CmNm}」({g.CmCd}) 을(를) 지웁니다.\n딸린 코드가 있으면 지워지지 않습니다.")"
                 Reload="@LoadGroupsAsync"
                 SelectedItem="@_group"
                 SelectedItemChanged="@PickGroupAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmCd)" Caption="코드" Width="130"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmNm)" Caption="이름" MinWidth="120"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmSrt)" Caption="순서" Width="70" />
            </Columns>

            <EditFormTemplate Context="edit">
                @CodeForm((DevCommonCodeDto)edit.EditModel, isGroup: true)
            </EditFormTemplate>
        </CommGrd>
    </CommCont>

    <CommCont Title="@(_group is null ? "코드" : $"{_group.CmNm} 의 코드")"
              Hint="@(_group is null ? string.Empty : $"{_codes.Count}건")"
              CssClass="pm-split__main">
        @if (_group is null)
        {
            <PageNotice Text="왼쪽에서 묶음을 고르면 그 코드가 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <CommGrd TItem="DevCommonCodeDto"
                     Data="@_codes"
                     EditFormTitle="코드"
                     ExportName="공통코드"
                     PageSize="20"
                     EmptyText="이 묶음에 코드가 없습니다."
                     OnNew="@FillNewCode"
                     OnSave="@SaveAsync"
                     OnDelete="@DeleteCodeAsync"
                     DeleteConfirm="@(c => $"코드 「{c.CmNm}」({c.CmCd}) 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadCodesAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmCd)" Caption="코드" Width="130"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmNm)" Caption="이름" MinWidth="120"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmVal)" Caption="값" MinWidth="100"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmType)" Caption="구분" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(DevCommonCodeDto.CmSrt)" Caption="순서" Width="70" />
                </Columns>

                <EditFormTemplate Context="edit">
                    @CodeForm((DevCommonCodeDto)edit.EditModel, isGroup: false)
                </EditFormTemplate>
            </CommGrd>
        }
    </CommCont>
</div>

@code {
    private IReadOnlyList<DevCommonCodeDto> _groups = [];
    private IReadOnlyList<DevCommonCodeDto> _codes = [];

    private DevCommonCodeDto? _group;

    /// <summary>
    /// 편집 창. <b>묶음과 코드가 같은 표</b>라 같은 폼을 쓴다 — 다른 것은
    /// 상위 코드 칸 하나뿐이고, 그것은 묶음일 때 아예 없다.
    /// </summary>
    private RenderFragment CodeForm(DevCommonCodeDto c, bool isGroup) =>@<text>
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="코드" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmCd" NullText="필수" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmNm" />
            </DxFormLayoutItem>

            @if (!isGroup)
            {
                <DxFormLayoutItem Caption="값" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="구분" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmType" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="값2" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal2" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="값3" ColSpanMd="6">
                    <DxTextBox @bind-Text="c.CmVal3" />
                </DxFormLayoutItem>
            }

            <DxFormLayoutItem Caption="속성" ColSpanMd="6">
                <DxTextBox @bind-Text="c.CmProp" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="순서" ColSpanMd="6">
                @* 비우면 서버가 999 를 넣는다 — 옛 수정이 쓰던 기본값과 같다. *@
                <DxSpinEdit @bind-Value="c.CmSrt" NullText="비우면 999" />
            </DxFormLayoutItem>

            @* 옛 프로시저가 읽지도 쓰지도 않던 칸이다. 표에 있으므로 다룬다. *@
            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxTextBox @bind-Text="c.CmRmk" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </text>;

    protected override Task OnInitializedAsync() => LoadGroupsAsync();

    private Task LoadGroupsAsync() => LoadAsync(async () =>
    {
        _groups = await Api.GroupsAsync();

        // 고른 묶음이 사라졌으면(지웠거나) 오른쪽을 비운다.
        if (_group is not null && _groups.All(g => g.CmRid != _group.CmRid))
        {
            _group = null;
            _codes = [];
        }

        return _groups.Count;
    }, "등록된 묶음이 없습니다.", "묶음을 읽지 못했습니다");

    private Task PickGroupAsync(DevCommonCodeDto? group)
    {
        _group = group;

        if (group is null)
        {
            _codes = [];
            return Task.CompletedTask;
        }

        return LoadCodesAsync();
    }

    private Task LoadCodesAsync() => _group is null ? Task.CompletedTask : LoadAsync(async () =>
    {
        _codes = await Api.ChildrenAsync(_group.CmCd ?? string.Empty);
        return _codes.Count;
    }, "이 묶음에 코드가 없습니다.", "코드를 읽지 못했습니다");

    /// <summary>새 묶음은 상위 코드가 없다 — 그것이 묶음의 정의다.</summary>
    private void FillNewGroup(DevCommonCodeDto c) => c.CmPcd = null;

    /// <summary>
    /// 새 코드는 <b>고른 묶음에 붙는다.</b> 사용자가 적게 두면 어느 묶음에도
    /// 안 붙은 줄이 생기고, 그 줄은 어느 화면에도 안 나온다.
    /// </summary>
    private void FillNewCode(DevCommonCodeDto c) => c.CmPcd = _group?.CmCd;

    private async Task SaveAsync((DevCommonCodeDto Item, bool IsNew) e)
    {
        if (e.IsNew)
        {
            await Api.CreateAsync(e.Item);
        }
        else
        {
            await Api.UpdateAsync(e.Item);
        }
    }

    /// <summary>묶음 삭제. 딸린 코드가 있으면 서버가 막는다(머리말).</summary>
    private async Task DeleteGroupAsync(DevCommonCodeDto g)
    {
        await Api.DeleteAsync(g.CmRid, g.CmCd);

        if (_group?.CmRid == g.CmRid)
        {
            _group = null;
            _codes = [];
        }
    }

    private Task DeleteCodeAsync(DevCommonCodeDto c) => Api.DeleteAsync(c.CmRid);
}
