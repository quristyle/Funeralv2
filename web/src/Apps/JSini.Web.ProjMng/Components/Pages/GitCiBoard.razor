@page "/projmng/wbs/ci"
@attribute [RouteKey("projmng.wbs.ci")]

@*
    [빌드 상태]

    이력: 사내망 WBS 대시보드(Vue) `views/Ci.vue` → **여기**
          2026-09-23 에 사내 GitLab 에서 **GitHub Actions** 로 갈아탔다.
    API: `projmng/git/ci`

    저장소마다 **가장 최근 실행 하나**를 본다. 볼 저장소는 서버 설정이
    목록으로 준다(`Git:Projects:{프로젝트번호}:Repos`) — 사내 GitLab 때처럼
    `pmm001`…`pmm018` 이름 규칙으로 만들어 내지 않는다.

    [토큰이 없어도 뜬다]

    공개 저장소는 그대로 읽힌다. 토큰은 시간당 한도를 60회에서 5,000회로
    올릴 뿐이고, 남은 한도를 화면 위에 적어 둔다 — **「왜 갑자기 안 보이나」의
    답이 대개 그것**이라서다.
*@

@inherits DataPage

<PageTitle>빌드 상태 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@StateOptions" @bind-Value="_state"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 140px" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="새로고침"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(!Loading)"
                  Click="@RefreshAsync" />
    </Actions>
</CommSch>

@if (_result is not null && !_result.Configured)
{
    <PageNotice Tone="NoticeTone.Info"
                Text="이 프로젝트에 걸어 둔 저장소가 없습니다. 서버 설정(Git:Projects)에 owner/name 을 적으면 이 화면이 찹니다." />
}

@if (_result is { Configured: true })
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">성공</div>
            <div class="jsini-stat__value">@Count("success")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">실패</div>
            <div class="jsini-stat__value">@Count("failure")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">진행 중</div>
            <div class="jsini-stat__value">@Count("in_progress")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">실행 없음</div>
            <div class="jsini-stat__value">@Count("none")</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">못 읽음</div>
            <div class="jsini-stat__value">@_rows.Count(r => r.Error is not null)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">읽어 온 때</div>
            <div class="jsini-stat__value pm-stat--dates">@_result.LoadedAt</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">남은 한도</div>
            <div class="jsini-stat__value pm-stat--dates">@RateText</div>
        </div>
    </div>

    @if (!_result.Authenticated)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="토큰 없이 읽고 있습니다. 공개 저장소는 그대로 보이지만 시간당 60회까지입니다 — 토큰을 넣으면 5,000회가 됩니다." />
    }
}

<CommGrd TItem="GitRunDto"
         Data="@Filtered"
         ExportName="빌드 상태"
         EmptyText="저장소가 없습니다."
         PageSize="40"
         Reload="@SearchAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(GitRunDto.Repo)" Caption="저장소" MinWidth="200"
                          TextAlignment="GridTextAlignment.Left" />

        <DxGridDataColumn Caption="상태" Width="110">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (GitRunDto)cell.DataItem;
                }
                @if (r.Error is not null)
                {
                    <span class="jsini-badge jsini-badge--warn" title="@r.Error">못 읽음</span>
                }
                else
                {
                    <span class="jsini-badge @GitRunText.Badge(r.Status)">@GitRunText.Of(r.Status)</span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(GitRunDto.WorkflowName)" Caption="워크플로" Width="130" />
        <DxGridDataColumn FieldName="@nameof(GitRunDto.Event)" Caption="계기" Width="110" />
        <DxGridDataColumn FieldName="@nameof(GitRunDto.Branch)" Caption="가지" Width="130" />
        <DxGridDataColumn FieldName="@nameof(GitRunDto.CommitTitle)" Caption="커밋" MinWidth="240"
                          TextAlignment="GridTextAlignment.Left" />
        <DxGridDataColumn FieldName="@nameof(GitRunDto.Actor)" Caption="일으킨이" Width="110" />
        <DxGridDataColumn FieldName="@nameof(GitRunDto.UpdatedAt)" Caption="끝난 때" Width="180" />

        <DxGridDataColumn Caption="걸린 시간" Width="100">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (GitRunDto)cell.DataItem;
                }
                @(r.Duration is null ? "—" : $"{r.Duration:0}초")
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="마지막 성공" Width="180">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (GitRunDto)cell.DataItem;
                }
                @(r.LastSuccess?.At ?? "—")
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="열기" Width="90">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (GitRunDto)cell.DataItem;
                }
                @if (!string.IsNullOrWhiteSpace(r.RunUrl))
                {
                    <a href="@r.RunUrl" target="_blank" rel="noopener">실행</a>
                }
                else if (!string.IsNullOrWhiteSpace(r.RunsUrl))
                {
                    <a href="@r.RunsUrl" target="_blank" rel="noopener">Actions</a>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>
