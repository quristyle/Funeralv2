@page "/projmng/proj/user"
@using System.Data

@*
    [프로젝트 참여자] — DB 메뉴 `/projmng/proj/user`.
    이력: 옛 Blazor `Pages/Proj/ProjUser.razor` → Vue `views/projmng/proj/user.vue` → 여기.
    프로시저: `sp_proj_user_map_list`(참여 현황) · `sp_dev_proj_user_map_exec`(참여 편집)

    왼쪽에서 사람을 고르면 오른쪽에 **그 사람이 참여한 프로젝트**가 나온다.

    [사람이 한 명도 나오지 않았다]

    이 화면은 `sp_dev_proj_user_map_exec` 하나만 프로젝트로 걸러 보여 주고
    있었다. 그런데 그 프로시저가 돌려주는 것은 사람이 아니라 **프로젝트**다
    (`accept_proj` · `prj_rid` · `prj_name` · 기간). 거르는 열쇠도 사람
    (`user_id`)이지 프로젝트가 아니다. 그래서 「담당자」라는 제목 아래에
    프로젝트 한 줄이 떠 있었고, 사람 목록은 어디에도 없었다.

    참여 현황의 정본은 `sp_proj_user_map_list` 다 — 누가 어느 프로젝트에
    참여하는지와 그 사람의 참여 프로젝트 수(`inv_cnt`)를 준다. **그 조회가
    통째로 빠져 있었다.**

    [사람 목록은 포털 계정이다]

    이식 전에는 프로젝트관리가 자기 사용자 표(`projmng.dev_user`)를 들고
    있었지만, 사람의 정본은 포털 한 곳이다. 계정을 만들고 고치는 일도 포털이
    단독으로 맡는다 — 여기 남은 편집은 '누가 어느 프로젝트에 참여하는가'
    (오른쪽)뿐이고, 그건 계정이 아니라 업무 자료다.

    [왼쪽 표의 컬럼은 우리가 만든다]

    포털 계정과 프로젝트관리의 참여 현황을 **합쳐** 그리기 때문에 어느 한쪽
    프로시저의 컬럼 메타로는 표를 세울 수 없다. 셋만 세워 넘긴다.
*@

@inherits DataPage
@inject ProjMngClient Client
@inject BizOptions Accounts

<PageTitle>프로젝트 참여자 · 프로젝트관리</PageTitle>

<PageHeading Title="프로젝트 참여자" Scope="프로젝트관리" />

<PageNotice Tone="NoticeTone.Info"
            Text="왼쪽은 포털 계정 목록입니다. 계정 등록·수정은 [시스템 관리 › 계정 관리]에서 하고, 여기서는 프로젝트 참여만 정합니다." />

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" ShowAll="true"
                    OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<PageNotice Text="@Notice" Tone="@Tone" />

<SplitPane Size="40">
    <First>
        @* 저장·삭제 콜백을 주지 않으면 DynamicGrid 가 그 단추를 아예 그리지 않는다.
           왼쪽은 포털 계정이라 여기서 고치는 길이 없어야 한다. *@
        <DynamicGrid Data="@_people" Loading="@Loading" ExportName="프로젝트참여자"
                     HideAdd="true" PageSize="30" OnRowClick="@OnPersonPickedAsync" />
    </First>
    <Second>
        @if (_person is null)
        {
            <PageNotice Text="왼쪽에서 사람을 고르면 참여한 프로젝트가 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <h2 class="pm-subhead">@_personName 의 참여 프로젝트</h2>

            <DynamicGrid Data="@_map.Data" Loading="@_map.IsLoading" ExportName="사용자-프로젝트"
                         HideAdd="true" OnSave="@SaveMapAsync" OnRefresh="@ReloadMapAsync" />
        }
    </Second>
</SplitPane>

@code {
    /// <summary>
    /// 왼쪽 표의 컬럼 메타. 프로시저가 주는 것이 아니라 여기서 만든다 —
    /// 두 곳(포털 계정 · 참여 현황)에서 온 값을 합치기 때문이다.
    /// </summary>
    private static readonly Dictionary<string, string> PeopleCols = new()
    {
        ["user_id"] = "System.String",
        ["user_name"] = "System.String",
        ["inv_cnt"] = "System.Int32",
    };

    private ProcGrid _map = default!;

    private string? _projectCode;

    private ProjMngTable _people = ProjMngTable.Empty;

    private string? _person;
    private string? _personName;

    protected override void OnInitialized() =>
        _map = new ProcGrid(Client, "sp_dev_proj_user_map_exec");

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync()
    {
        _person = null;
        _personName = null;
        _map.Clear();

        return LoadPeopleAsync();
    }

    private Task LoadPeopleAsync() => LoadAsync(async () =>
    {
        // 둘을 나란히. 서로 기다릴 이유가 없다.
        var accounts = Accounts.GetAsync("portal_account");
        var participation = Client.DbContAsync("sp_proj_user_map_list", new Dictionary<string, object?>
        {
            ["prj_rid"] = _projectCode ?? string.Empty,
        });

        await Task.WhenAll(accounts, participation);

        // 아이디 → 참여 프로젝트 수. 프로젝트를 골랐다면 이 표에 있는 사람이
        // 곧 그 프로젝트의 참여자다.
        var counts = new Dictionary<string, int>(StringComparer.Ordinal);

        foreach (var row in participation.Result.Rows ?? [])
        {
            var id = row.GetValueOrDefault("user_id")?.ToString();
            if (string.IsNullOrWhiteSpace(id)) continue;

            counts[id] = int.TryParse(row.GetValueOrDefault("inv_cnt")?.ToString(), out var n) ? n : 0;
        }

        var narrowed = !string.IsNullOrEmpty(_projectCode);

        var rows = accounts.Result
            .Where(a => !narrowed || counts.ContainsKey(a.Value))
            .Select(a => new ProjMngRow
            {
                ["user_id"] = a.Value,
                ["user_name"] = a.Label,
                ["inv_cnt"] = counts.GetValueOrDefault(a.Value, 0),
            })
            .ToList();

        _people = ProjMngTable.From(new ProjMngResult { Cols = PeopleCols, Rows = rows });

        return _people.Table.Rows.Count;
    }, "그 프로젝트에 참여한 사람이 없습니다.", "참여자를 읽지 못했습니다");

    private Task OnPersonPickedAsync(DataRow? row)
    {
        if (row is null || !row.Table.Columns.Contains("user_id"))
        {
            _person = null;
            _personName = null;
            _map.Clear();
            return Task.CompletedTask;
        }

        _person = row["user_id"]?.ToString();
        _personName = row.Table.Columns.Contains("user_name") ? row["user_name"]?.ToString() : _person;

        return ReloadMapAsync();
    }

    /// <summary>
    /// 고른 사람의 참여 프로젝트.
    ///
    /// 거르는 열쇠가 <b>사람</b>이다. 프로젝트로 거르면(예전에 그랬다) 그
    /// 프로젝트 한 줄만 나오고, 참여를 켜고 끄는 일 자체를 할 수 없다.
    /// </summary>
    private Task ReloadMapAsync() => LoadAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_person))
        {
            return 0;
        }

        await _map.LoadAsync(MapParams());
        return _map.Data.Table.Rows.Count;
    }, "참여할 수 있는 프로젝트가 없습니다.", "참여 현황을 읽지 못했습니다");

    private async Task SaveMapAsync()
    {
        var ok = await RunAsync(
            () => _map.SaveAsync(MapParams()), "저장했습니다.", "저장하지 못했습니다");

        if (ok)
        {
            // 참여 프로젝트 수가 바뀌었을 수 있다. 왼쪽 숫자를 그대로 두면
            // 방금 한 일이 반영되지 않은 것처럼 보인다.
            //
            // **고른 사람은 그대로 둔다.** 조회를 통째로 다시 걸면 선택이
            // 풀려 오른쪽이 닫히고, 무엇을 저장했는지 확인할 수 없다.
            await LoadPeopleAsync();
            await ReloadMapAsync();
        }
    }

    private Dictionary<string, object?> MapParams() => new()
    {
        ["user_id"] = _person ?? string.Empty,
    };
}
