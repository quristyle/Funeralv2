@page "/projmng/todo/list"
@attribute [RouteKey("projmng.todo.list")]

@*
할일. 되풀이 할 일을 날짜·사람 단위로 만든다. 권한은 DB 메뉴(projmng.todo.list)에 걸려 있어 주소를 직접 쳐도 같은 가리개가 선다.
완료 여부는 불리언 하나로 등록·수정·조회가 같은 값을 쓰고, 완료로 바뀌는 순간 완료 일시를 찍는다. 만들기는 고른 사람의 것을 만들며, 이미 만든 날은 다시 만들지 않는다.
*@

@inherits DataPage

<PageTitle>할일 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="날짜">
            <DxDateEdit @bind-Date="_targetDate" Style="width: 150px" />
        </CommSchItem>

        <CommSchItem Label="사람">
            <BizSelect Type="portal_account" @bind-Value="_userCode" ShowAll="true"
                       OnChanged="@(o => _userName = o?.Label)" />
        </CommSchItem>

        <CommSchItem Label="완료">
            <CodeSelect CodeId="yn" @bind-Value="_completeYn" ShowAll="true" @bind-Text="_completeName" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <CodeSelect CodeId="todo_state" @bind-Value="_todoState" ShowAll="true" @bind-Text="_todoStateName" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont Title="할일" Hint="@Hint">
    <CommGrd TItem="HomeTodoDto"
             Data="@_rows"
             EditFormTitle="할일"
             ExportName="할일"
             PageSize="30"
             EmptyText="할일이 없습니다."
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(t => $"「{t.Title}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
             Reload="@SearchAsync">
        <ContextMenuItems>
            <PermissionView Action="MenuAction.Create">
                @* 고른 날짜·사람의 되풀이 할 일을 만든다. *@
                <CommMenuItem Text="되풀이 만들기" IconCssClass="jsini-icon-plus"
                                 Enabled="@CanMake"
                                 Click="@MakeAsync" />
            </PermissionView>
        </ContextMenuItems>

        <Columns>
            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.TargetDay)" Caption="날짜" Width="110"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.TargetUser)" Caption="사람" Width="110" />
            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.Title)" Caption="제목" MinWidth="180"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn Caption="완료" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (HomeTodoDto)cell.DataItem;
                    }
                    <span class="jsini-badge @(t.IsComplete ? "jsini-badge--on" : "jsini-badge--off")">
                        @(t.IsComplete ? "완료" : "미완")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.TodoStateName)" Caption="상태" Width="100" />
            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.FixPoint)" Caption="금액" Width="90"
                              DisplayFormat="#,##0" TextAlignment="GridTextAlignment.Right" />
            <DxGridDataColumn FieldName="@nameof(HomeTodoDto.Comments)" Caption="메모" MinWidth="140"
                              TextAlignment="GridTextAlignment.Left" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var t = (HomeTodoDto)edit.EditModel;
            }
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="제목" ColSpanMd="12">
                    <DxTextBox @bind-Text="t.Title" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="날짜" ColSpanMd="6">
                    <DxDateEdit @bind-Date="t.TargetDay" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="사람" ColSpanMd="6">
                    <BizSelect Type="portal_account" @bind-Value="t.TargetUser" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="상태" ColSpanMd="6">
                    <CodeSelect CodeId="todo_state" @bind-Value="t.TodoState" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="금액" ColSpanMd="6">
                    <DxSpinEdit @bind-Value="t.FixPoint" DisplayFormat="#,##0" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="완료" ColSpanMd="12">
                    @* 켜는 순간 완료 일시가 찍힌다(서버가 한다). *@
                    <DxCheckBox @bind-Checked="t.IsComplete">완료</DxCheckBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="메모" ColSpanMd="12">
                    <DxMemo @bind-Text="t.Comments" Rows="3" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>
