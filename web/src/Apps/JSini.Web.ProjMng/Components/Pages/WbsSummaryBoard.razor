@page "/projmng/wbs/summary"
@attribute [RouteKey("projmng.wbs.summary")]

@*
    [WBS 요약]

    이력: 사내망 WBS 대시보드(Vue) `views/Summary.vue` → **여기**
    API: `projmng/wbs-board/stats/summary` · `…/monthly-by-user`

    원장은 `projmng.wbs_work` 다 — 1줄 = 1화면(메뉴). 프로젝트관리의 WBS
    (`/projmng/wbs`)와 **이름만 같고 다른 표**다. 그쪽은 공정표(1줄 = 1공정)다.

    [대형은 따로 센다]

    `complate_big_yn` 은 같은 줄을 다른 잣대로 한 번 더 세는 값이다. 완료
    건수에 더하면 완료율이 100 을 넘는다 — 그래서 타일을 나란히 두되
    합치지 않는다.

    [휴대폰에서는 조회부가 접힌다]

    조건이 넷이라 좁은 화면에서 네 줄이 되고, 그 아래로 타일 여덟이 이어져
    **정작 보러 온 담당자 표는 화면 두 판 아래**였다. 접기는 `CommSch` 가
    하고 화면은 접힌 줄에 적을 글자만 만든다(`MobileSummary`).
*@

@inherits DataPage

<PageTitle>WBS 요약 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName"
                        OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="기준일">
            <DxComboBox Data="@WbsBoardOptions.Basis" @bind-Value="_basis"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="잣대">
            <DxComboBox Data="@WbsBoardOptions.Who" @bind-Value="_who"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>
</CommSch>

@if (_summary is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">전체</div>
            <div class="jsini-stat__value">@_summary.Total</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">완료(담당자)</div>
            <div class="jsini-stat__value">@_summary.Done</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">완료(개발자)</div>
            <div class="jsini-stat__value">@_summary.DoneReal</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">완료율</div>
            <div class="jsini-stat__value">@WbsBoardOptions.Percent(_summary.Done, _summary.Total)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">모듈</div>
            <div class="jsini-stat__value">@_summary.Modules</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">담당자</div>
            <div class="jsini-stat__value">@_summary.Users</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">대형 완료</div>
            <div class="jsini-stat__value">@_summary.DoneBig</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">기간</div>
            <div class="jsini-stat__value pm-stat--dates">@Period</div>
        </div>
    </div>

    @if (_summary.Total > _summary.Dated)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="@($"{_summary.Total - _summary.Dated}건은 기준일이 비어 있어 기간·월·주 집계에서 빠집니다.")" />
    }
}

<CommGrd TItem="UserRow"
         Data="@_users"
         ExportName="담당자별 진행률"
         EmptyText="담당자별 자료가 없습니다."
         PageSize="20"
         Reload="@SearchAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(UserRow.UserNm)" Caption="담당자" MinWidth="140"
                          TextAlignment="GridTextAlignment.Left" />
        <DxGridDataColumn FieldName="@nameof(UserRow.UserBpId)" Caption="사번" Width="110" />
        <DxGridDataColumn FieldName="@nameof(UserRow.Cnt)" Caption="배정" Width="90" />
        <DxGridDataColumn FieldName="@nameof(UserRow.Done)" Caption="완료" Width="90" />

        <DxGridDataColumn Caption="진행률" MinWidth="180">
            <CellDisplayTemplate Context="cell">
                @{
                    var row = (UserRow)cell.DataItem;
                }
                <div class="pm-bar" title="@($"{row.Done} / {row.Cnt}")">
                    <div class="pm-bar__fill" style="width: @(row.Rate)%"></div>
                    <span class="pm-bar__text">@row.Rate.ToString("0.#")%</span>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</CommGrd>
