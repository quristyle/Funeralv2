@page "/projmng/db/tools"
@attribute [RouteKey("projmng.db.tools")]
@using System.Data

@*
DB 개체 탐색 — 고른 프로젝트 DB 의 테이블·프로시저·함수·본문·앞 10건을 본다(REST, 프로시저 아님).
등록된 질의만 이름으로 부를 수 있어 DB 종류마다 목록이 다르므로, 없는 목록은 오류가 아니라 안내로 보인다. 칸 이름은 실제 응답(procedurename · routine_definition) 기준이다.
이름 거르기는 화면이 한다(param1 을 받는 질의는 EDB 뿐이다). 앞 10건은 서버가 준 이름만 넣은 생 SQL 이다.
*@

@inherits DataPage

<PageTitle>DB 개체 탐색 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@ReloadAsync" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => OnProjectChanged())" />
        </CommSchItem>

        <CommSchItem Label="DB">
            <CodeSelect CodeId="projdb" CodeKey="@_projectCode" EtcFix="true" @bind-Value="_dbCode"
                        OnChanged="@(item => OnDbChanged(item))" />
        </CommSchItem>

        <CommSchItem Label="이름">
            <DxTextBox @bind-Text="_keyword" Style="width: 180px"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </CommSchItem>
    </Fields>
</CommSch>

@if (_dbItem is null)
{
    <PageNotice Text="프로젝트와 DB 를 고르십시오." Tone="NoticeTone.Info" />
}
else
{
    <DxTabs @bind-ActiveTabIndex="_tab">
        <DxTabPage Text="@($"테이블 {_tables.Table.Rows.Count}")">
            <div class="pm-tab-body">
                <SplitPane Size="45">
                    <First>
                        @* 칸이 실행 시점에 정해진다 — 등록된 질의가 DB 종류마다 다르다. *@
                        <CommCont Title="테이블">
                            <CommGrd TItem="DataRowView" Data="@_tables.Table" ExportName="테이블목록"
                                     PageSize="30" EmptyText="테이블이 없습니다." Reload="@ReloadAsync"
                                     SelectedItem="@_pickedTable" SelectedItemChanged="@PreviewAsync">
                                <Columns>
                                    <RuntimeColumns Table="@_tables.Table" Order="@_tables.ColumnOrder" />
                                </Columns>
                            </CommGrd>
                        </CommCont>
                    </First>
                    <Second>
                        @if (_previewOf is null)
                        {
                            <PageNotice Text="테이블을 고르면 앞 10건을 보여 줍니다." Tone="NoticeTone.Info" />
                        }
                        else
                        {
                            <h2 class="pm-subhead">@_previewOf · 앞 10건</h2>
                            <CommGrd TItem="DataRowView" Data="@_preview.Table" ExportName="미리보기"
                                     PageSize="10" EmptyText="줄이 없습니다.">
                                <Columns>
                                    <RuntimeColumns Table="@_preview.Table" Order="@_preview.ColumnOrder" />
                                </Columns>
                            </CommGrd>
                        }
                    </Second>
                </SplitPane>
            </div>
        </DxTabPage>

        <DxTabPage Text="@($"프로시저 {_procs.Table.Rows.Count}")">
            <div class="pm-tab-body">
                <SplitPane Size="45">
                    <First>
                        <CommCont Title="프로시저">
                            <CommGrd TItem="DataRowView" Data="@_procs.Table" ExportName="프로시저목록"
                                     PageSize="30" EmptyText="프로시저가 없습니다." Reload="@ReloadAsync"
                                     SelectedItem="@_pickedRoutine" SelectedItemChanged="@ShowRoutineAsync">
                                <Columns>
                                    @* 본문 칸은 감춘다 — 한 줄이 수천 글자다. *@
                                    <RuntimeColumns Table="@_procs.Table" Order="@_procs.ColumnOrder"
                                                    Hidden="@BodyColumns" />
                                </Columns>
                            </CommGrd>
                        </CommCont>
                    </First>
                    <Second>
                        @if (_routineName is null)
                        {
                            <PageNotice Text="프로시저를 고르면 본문을 보여 줍니다." Tone="NoticeTone.Info" />
                        }
                        else
                        {
                            <h2 class="pm-subhead">@_routineName</h2>

                            @* 읽기 전용이다 — 프로시저를 바꾸는 것은 배포에 속한다. *@
                            <CodeEditor Value="@_routineBody" ReadOnly="true" Height="420px" Language="pgsql" />
                        }
                    </Second>
                </SplitPane>
            </div>
        </DxTabPage>

        <DxTabPage Text="@($"함수 {_funcs.Table.Rows.Count}")">
            <div class="pm-tab-body">
                <SplitPane Size="45">
                    <First>
                        <CommCont Title="함수">
                            <CommGrd TItem="DataRowView" Data="@_funcs.Table" ExportName="함수목록"
                                     PageSize="30" EmptyText="함수가 없습니다." Reload="@ReloadAsync"
                                     SelectedItem="@_pickedRoutine" SelectedItemChanged="@ShowRoutineAsync">
                                <Columns>
                                    <RuntimeColumns Table="@_funcs.Table" Order="@_funcs.ColumnOrder"
                                                    Hidden="@BodyColumns" />
                                </Columns>
                            </CommGrd>
                        </CommCont>
                    </First>
                    <Second>
                        @if (_routineName is null)
                        {
                            <PageNotice Text="함수를 고르면 본문을 보여 줍니다." Tone="NoticeTone.Info" />
                        }
                        else
                        {
                            <h2 class="pm-subhead">@_routineName</h2>
                            <CodeEditor Value="@_routineBody" ReadOnly="true" Height="420px" Language="pgsql" />
                        }
                    </Second>
                </SplitPane>
            </div>
        </DxTabPage>

        <DxTabPage Text="생성 템플릿">
            <div class="pm-tab-body">

                <CodeEditor Value="@_template" ReadOnly="true" Height="440px" Language="pgsql" />
            </div>
        </DxTabPage>
    </DxTabs>
}
