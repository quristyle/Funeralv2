@page "/projmng/ai/targets"
@attribute [RouteKey("projmng.ai.targets")]

@*
AI 작업 대상. 작업 화면은 여기 등록된 것에서 고르기만 하고 경로는 적지 못한다 — 등록은 관리자가, 선택은 작성자가 한다.
경로 검사는 서버가 하고(설정 AllowedRoots), 허용 뿌리도 서버에 물어 보여 준다. 「올리기 허용」은 main push 라 곧 운영 배포다.
*@

@inherits DataPage

<PageTitle>AI 작업 대상 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Warning" Text="@RootsNotice" />

<CommCont Title="대상" Hint="@Hint">
    <CommGrd TItem="AiTargetDto"
             Data="@_rows"
             EditFormTitle="작업 대상"
             ExportName="AI작업대상"
             PageSize="20"
             EmptyText="등록된 대상이 없습니다."
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(t => $"「{t.TargetNm}」 을(를) 목록에서 내립니다.\n이 대상으로 돌린 작업 이력은 남습니다.")"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(AiTargetDto.TargetNm)" Caption="이름" MinWidth="140"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn Caption="종류" Width="80">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (AiTargetDto)cell.DataItem;
                    }
                    <span class="jsini-badge jsini-badge--off">@t.KindText</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(AiTargetDto.TargetPath)" Caption="경로" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn FieldName="@nameof(AiTargetDto.IsolationText)" Caption="격리" Width="90" />

            <DxGridDataColumn FieldName="@nameof(AiTargetDto.RunnerKinds)" Caption="AI" Width="130"
                              TextAlignment="GridTextAlignment.Left" />

            @* 어느 장비가 집을 수 있나. 비면 아무 장비나 집는다 — 경로가 그 장비에 없으면 그대로 실패한다. *@
            <DxGridDataColumn Caption="장비" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (AiTargetDto)cell.DataItem;
                    }
                    @if (string.IsNullOrWhiteSpace(t.RunnerNm))
                    {
                        <span class="pm-ai-dim">아무 장비나</span>
                    }
                    else
                    {
                        @t.RunnerNm
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            @* 이 칸이 켜져 있으면 그 대상의 작업이 운영 배포를 일으킬 수 있다. *@
            <DxGridDataColumn Caption="올리기" Width="80">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (AiTargetDto)cell.DataItem;
                    }
                    <span class="jsini-badge @(t.AllowPush ? "jsini-badge--err" : "jsini-badge--off")">
                        @(t.AllowPush ? "허용" : "안 함")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="쓰임" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (AiTargetDto)cell.DataItem;
                    }
                    <span class="jsini-badge @(t.IsEnabled ? "jsini-badge--on" : "jsini-badge--off")">
                        @(t.IsEnabled ? "사용" : "중지")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var t = (AiTargetDto)edit.EditModel;
            }
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                    <DxTextBox @bind-Text="t.TargetNm" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="종류" ColSpanMd="3">
                    <DxComboBox Data="@Kinds" @bind-Value="t.TargetKind"
                                TextFieldName="@nameof(PickOption.Text)"
                                ValueFieldName="@nameof(PickOption.Value)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="격리" ColSpanMd="3">
                    <DxComboBox Data="@Isolations" @bind-Value="t.IsolationMode"
                                TextFieldName="@nameof(PickOption.Text)"
                                ValueFieldName="@nameof(PickOption.Value)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="경로" ColSpanMd="12">
                    <DxTextBox @bind-Text="t.TargetPath" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="저장소 주소" ColSpanMd="8">
                    <DxTextBox @bind-Text="t.RepoUrl" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="기준 브랜치" ColSpanMd="4">
                    <DxTextBox @bind-Text="t.DefaultRef" />
                </DxFormLayoutItem>

                @* 값이 둘뿐이라 체크칸으로 둔다 — CodeSelect 식 드롭다운은 표의 편집 창(모달) 안에서 펼쳐지지 않는다. *@
                <DxFormLayoutItem Caption="쓸 수 있는 AI" ColSpanMd="6">
                    <div class="pm-ai-kinds">
                        @foreach (var opt in RunnerOptions)
                        {
                            @* ValidationEnabled="false" 를 반드시 준다 — Checked/CheckedChanged 로 주고받으면 DevExpress 가 찾는 CheckedExpression 이 없어, 편집 창(EditForm) 안에서 예외를 던지고 회로가 끊긴다. *@
                            <DxCheckBox Checked="@HasRunner(t, opt.Value)"
                                        CheckedChanged="@((bool on) => ToggleRunner(t, opt.Value, on))"
                                        ValidationEnabled="false">
                                @opt.Text
                            </DxCheckBox>
                        }
                    </div>
                </DxFormLayoutItem>

                @* 경로는 장비마다 다르다 — 비워 두면 아무 실행기나 집어 가는데, 그 장비에 경로가 없으면 대상 폴더가 없다고 실패한다. 장비 이름은 실행기 설정의 Runner:Name 이다. *@
                <DxFormLayoutItem Caption="장비" ColSpanMd="6">
                    <DxComboBox Data="@Runners" @bind-Value="t.RunnerNm"
                                AllowUserInput="true" ValidationEnabled="false"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="복사 상한(MB)" ColSpanMd="3">
                    <DxSpinEdit @bind-Value="t.MaxSizeMb" MinValue="0" MaxValue="102400" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="검사" ColSpanMd="3">
                    <DxComboBox Data="@Gates" @bind-Value="t.GateMode"
                                TextFieldName="@nameof(PickOption.Text)"
                                ValueFieldName="@nameof(PickOption.Value)" />
                </DxFormLayoutItem>

                @* 켜는 순간 작업이 main 에 push 할 수 있게 되고, 이 저장소는 곧 운영 배포다. *@
                <DxFormLayoutItem Caption="올리기" ColSpanMd="6">
                    <DxCheckBox @bind-Checked="t.AllowPush">
                        push 를 허용한다 — 이 대상의 작업이 운영 배포를 일으킬 수 있습니다
                    </DxCheckBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="push 대상" ColSpanMd="3">
                    <DxTextBox @bind-Text="t.PushRef" Enabled="@t.AllowPush" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="쓰임" ColSpanMd="3">
                    <DxCheckBox @bind-Checked="t.IsEnabled">목록에 보인다</DxCheckBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="키 이름" ColSpanMd="6">
                    <DxTextBox @bind-Text="t.CredentialRef" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="메모" ColSpanMd="12">
                    <DxTextBox @bind-Text="t.Comments" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>
