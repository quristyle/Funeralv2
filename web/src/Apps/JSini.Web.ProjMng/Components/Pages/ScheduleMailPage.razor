@page "/projmng/proj/scheduler/mail"
@attribute [RouteKey("projmng.proj.scheduler-mail")]
@attribute [ScreenAccess("projmng.proj.scheduler")]

@*
일정표의 「메일발송」이 탭으로 여는 화면. 조회 조건은 일정표가 ScreenState 로 맡기고, 기간은 여기서 고른다.
탭을 옮겼다 돌아와도 쓰던 그대로이고, 보내거나 닫으면 탭째 닫고 일정표로 돌아간다. 미리보기가 곧 편집기라 보는 그대로 나간다.
*@

@inherits DataPage
@implements IDisposable

<PageTitle>@TabTitle · 프로젝트관리</PageTitle>

@* 왼쪽은 보낼 조건, 오른쪽은 본문 편집기. 경계를 끌어 너비를 고른다. 좁은 화면에서는 분할을 풀어 위아래로 쌓고 쪽이 구른다(projmng.css). *@
<SplitPane Size="38" CssClass="pm-mailpage__split">
    <First>
        <CommCont>
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="대상 일정" ColSpanMd="12">
                    <span class="pm-mailpage__scope">@ScopeText</span>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="받는 사람" ColSpanMd="12">
                    <div class="pm-mail-addr">
                        <DxTextBox @bind-Text="_d.To" BindValueMode="BindValueMode.OnInput" />
                        <DxButton Text="사람 찾기" RenderStyle="ButtonRenderStyle.Secondary"
                                  IconCssClass="jsini-icon-user"
                                  Click="@(() => OpenPickerAsync(MailPickTarget.To))" />
                    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="참조" ColSpanMd="12">
                    <div class="pm-mail-addr">
                        <DxTextBox @bind-Text="_d.Cc" BindValueMode="BindValueMode.OnInput" />
                        <DxButton Text="사람 찾기" RenderStyle="ButtonRenderStyle.Secondary"
                                  IconCssClass="jsini-icon-user"
                                  Click="@(() => OpenPickerAsync(MailPickTarget.Cc))" />
                    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="기간" ColSpanMd="12">
                    <div class="pm-mail-range">
                        <DxDateEdit Date="@_d.From" DateChanged="@((DateOnly d) => _d.From = d)" />
                        <span>~</span>
                        <DxDateEdit Date="@_d.Until" DateChanged="@((DateOnly d) => _d.Until = d)" />
                        <DxButton Text="@(_loading ? "가져오는 중…" : "다시 가져오기")" RenderStyle="ButtonRenderStyle.Secondary"
                                  IconCssClass="jsini-icon-refresh" Enabled="@(!_loading)"
                                  Click="@ReloadItemsAsync" />
                    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="템플릿" ColSpanMd="12">
                    <DxComboBox Data="@_d.Templates"
                                TData="MailTemplateDto" TValue="long"
                                ValueFieldName="@nameof(MailTemplateDto.TplId)"
                                TextFieldName="@nameof(MailTemplateDto.TplNm)"
                                Value="@_d.TplId"
                                ValueChanged="@((long id) => PickTemplateAsync(id))" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="제목" ColSpanMd="12">
                    <DxTextBox Text="@_d.Subject" TextChanged="@((string t) => _d.Subject = t ?? string.Empty)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="인사말" ColSpanMd="12">
                    <DxMemo Text="@_d.Message" TextChanged="@((string? text) => OnMessageChanged(text))" Rows="3" />
                </DxFormLayoutItem>
            </DxFormLayout>

            <p class="jsini-hint">여러 주소는 쉼표로 구분합니다. 인사말을 비우면 기본 인사말이 들어갑니다.</p>
        </CommCont>
    </First>
    <Second>
        <div class="pm-mail-preview pm-mailpage__body">
            <div class="pm-mail-preview__head">
                <span>본문 · @_d.Count 건@(_d.Edited ? " · 직접 고침" : null)</span>
                <DxButton Text="본문 다시 만들기" RenderStyle="ButtonRenderStyle.Link"
                          IconCssClass="jsini-icon-refresh" Click="@RebuildBodyAsync" />
            </div>
            <MailHtmlEditor @ref="_editor" Value="@_d.Body" ValueChanged="@OnBodyEdited" Height="100%" />
        </div>
    </Second>
</SplitPane>

@* jsini-actbar 는 셸에게 하는 말이다 — 바닥 칸을 단추 줄로 쓰니 떠다니는 단추는 그 위로 올라서라. 판 밖에 두어 어느 판의 바닥도 가리지 않는다. *@
<div class="pm-mailpage__acts jsini-actbar">
    <DxButton Text="@(_sending ? "보내는 중…" : "발송")" RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="jsini-icon-mail" Enabled="@(!_sending && _d.Ready)" Click="@SendAsync" />
    <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@ClosePage" />
</div>

@* 받는 사람과 참조가 창 하나를 나눠 쓴다. 고른 주소는 칸에 글자로 더해지므로 손으로 고치거나 지울 수 있다. *@
<CommPopup @bind-Visible="_picking"
           HeaderText="@(_pickTarget == MailPickTarget.To ? "받는 사람 찾기" : "참조 찾기")"
           Width="min(44rem, calc(100vw - 2rem))">
    <BodyContentTemplate Context="pickPopup">
        <div class="pm-mail-pick">
            <DxTextBox Text="@_pickFilter"
                       TextChanged="@((string v) => _pickFilter = v ?? string.Empty)"
                       BindValueMode="BindValueMode.OnInput"
                       NullText="이름 · 아이디 · 주소 · 부서로 찾기, 또는 메일 주소 직접 입력" />

            <CommGrd TItem="ScheduleMailPerson"
                     Data="@PickRows"
                     ShowHeader="false"
                     EmptyText="찾는 사람이 없습니다."
                     AutoSelectFirstRow="false">
                <Columns>
                    <DxGridDataColumn Caption="" Width="56">
                        <CellDisplayTemplate Context="cell">
                            @{ var row = (ScheduleMailPerson)cell.DataItem; }
                            <DxCheckBox Checked="@_pickedIds.Contains(row.LoginId)"
                                        CheckedChanged="@((bool on) => TogglePicked(row.LoginId, on))" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn FieldName="@nameof(ScheduleMailPerson.UserName)" Caption="이름" Width="110"
                                      TextAlignment="GridTextAlignment.Left" />

                    <DxGridDataColumn FieldName="@nameof(ScheduleMailPerson.Email)" Caption="메일 주소" MinWidth="200"
                                      TextAlignment="GridTextAlignment.Left" />

                    <DxGridDataColumn FieldName="@nameof(ScheduleMailPerson.DeptName)" Caption="부서" Width="140"
                                      TextAlignment="GridTextAlignment.Left" />
                </Columns>
            </CommGrd>
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="pickFooter">
        @if (TypedAddress is { } typed)
        {
            <DxButton Text="@($"{typed} 넣기")" RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="jsini-icon-mail" Click="@AddTypedAddress" />
        }

        <DxButton Text="@($"고른 {_pickedIds.Count}명 넣기")" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_pickedIds.Count > 0)" Click="@ApplyPicked" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _picking = false)" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />
