@page "/projmng/sys/db-logic-item"
@attribute [RouteKey("projmng.sys.db-logic-item")]

@*
    [DB 로직 항목]

    이력: 옛 Blazor `Pages/Sys/DbLogicItem.razor` (`/db-logic-item`)
          → Vue `views/projmng/sys/db-logic-item.vue` → `DynamicGrid` +
          `sp_devsqlresp_base_exec` → **여기 (`CommGrd` + REST)**
    API: `projmng/db-logics`

    시스템 질의의 **이름표만** 본다. 어떤 이름의 질의가 있고 몇 가지 DB 종류에
    등록돼 있는지가 한눈에 들어온다.

    ────────────────────────────────────────────────────────────
    [DB 로직 관리와 무엇이 다른가]

    거의 같다. 옛 Vue 가 두 화면을 두었고 **둘 다 같은 프로시저를 아무 조건
    없이 불렀다** — 화면도 글자 하나까지 같았다.

    지금은 [DB 로직 관리]가 이름표 옆에 **그 이름표의 DB 종류별 SQL** 을 함께
    보여 준다. 그쪽이 고치는 자리고, 여기는 **훑어보는 자리**다 — 그래서 여기서
    지울 수 없게 두었다. 지우는 일은 딸린 질의를 함께 봐야 하는 일이다.
*@

@inherits DataPage
@inject DbLogicClient Api

<PageTitle>DB 로직 항목 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Info"
            Text="이름표만 봅니다. DB 종류별 질의를 고치려면 [DB 로직 관리]로 갑니다." />

<PageNotice Text="@Notice" Tone="@Tone" />

<CommCont Title="질의 이름표" Hint="@Hint">
    <CommGrd TItem="DbLogicBaseDto"
             Data="@_rows"
             EditFormTitle="이름표"
             ExportName="DB로직항목"
             PageSize="30"
             EmptyText="등록된 이름표가 없습니다."
             OnSave="@SaveAsync"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.Sort)" Caption="순서" Width="70" />
            <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.DslCd)" Caption="이름" Width="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.Comm)" Caption="설명" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn Caption="등록된 DB 종류" Width="130">
                <CellDisplayTemplate Context="cell">
                    @{
                        var b = (DbLogicBaseDto)cell.DataItem;
                    }
                    @* 0 이면 그 이름으로 물었을 때 어느 DB 에서도 답이 없다는 뜻이다. *@
                    <span class="jsini-badge @(b.QueryCount > 0 ? "jsini-badge--on" : "jsini-badge--off")">
                        @b.QueryCount
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var b = (DbLogicBaseDto)edit.EditModel;
            }
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                    <DxTextBox @bind-Text="b.DslCd" NullText="필수 — tablelist · proclist …" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="순서" ColSpanMd="6">
                    <DxSpinEdit @bind-Value="b.Sort" NullText="비우면 999" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                    <DxTextBox @bind-Text="b.Comm" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    private IReadOnlyList<DbLogicBaseDto> _rows = [];

    private string Hint => $"{_rows.Count(r => r.QueryCount == 0)}건은 질의가 없습니다 / 전체 {_rows.Count}건";

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync() => LoadAsync(async () =>
    {
        _rows = await Api.ListAsync();
        return _rows.Count;
    }, "등록된 이름표가 없습니다.", "이름표를 읽지 못했습니다");

    private Task SaveAsync((DbLogicBaseDto Item, bool IsNew) e) => Api.SaveAsync(e.Item);
}
