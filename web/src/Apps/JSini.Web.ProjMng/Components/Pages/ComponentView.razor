@page "/projmng/tool/component"
@using System.Data

@*
    [프로젝트 컴포넌트]

    이력: Vue `views/projmng/proj/component.vue` → 여기.
    프로젝트에 등록된 컴포넌트 마스터 정보를 관리한다.
*@

@inject ProjMngClient Client

<PageTitle>프로젝트 컴포넌트 · 프로젝트관리</PageTitle>

<h1>프로젝트 컴포넌트 <span class="pm-page__scope">프로젝트관리</span></h1>

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data" Loading="@_grid.IsLoading" ExportName="컴포넌트" OnRefresh="@SearchAsync" OnSave="@(() => _grid.SaveAsync(Params()))" OnDelete="@(row => _grid.DeleteAsync(row))" />

@code {
    private ProcGrid _grid = default!;
    private string? _projectCode;

    protected override void OnInitialized()
    {
        _grid = new ProcGrid(Client, "sp_dev_proj_exec");
    }

    private Dictionary<string, object?> Params() => new() { ["prj_rid"] = _projectCode ?? string.Empty };

    private Task SearchAsync() => _grid.LoadAsync(Params());
}
