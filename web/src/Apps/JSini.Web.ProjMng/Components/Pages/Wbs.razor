@page "/projmng/proj/wbs"
@attribute [RouteKey("projmng.proj.wbs")]

@*
    [프로젝트 WBS]

    이력: 옛 Blazor `Pages/Proj/ProjWbs.razor` (`/proj-wbs`) → Vue
          `views/projmng/proj/wbs.vue` → `DynamicGrid` + `sp_proj_wbs_exec`
          → **여기 (`CommGrd` + REST)**
    API: `projmng/wbs`

    프로젝트를 고르면 그 프로젝트의 일감이 나온다. **일정표와 같은 표**를
    보고 `schedule_type` 하나로 갈린다 — 여기는 `WBS` 다.

    ────────────────────────────────────────────────────────────
    [진행 상태는 적는 칸이 아니다]

    대기·진행·완료는 **개발 시작·종료일로 정해진다.** 시작일이 없으면 대기,
    시작만 있으면 진행, 둘 다 있으면 완료다. 그래서 표에서 고르는 칸이 아니라
    날짜를 넣으면 따라 바뀌는 값이고, 서버가 매긴다.

    [옛 조회가 자료를 고쳤다]

    `sp_proj_wbs_exec` 의 조회 갈래는 목록을 내기 전에 `UPDATE dev_wbs` 를
    돌려 빈 계획 날짜를 개발 종료일로 메웠다. **보기만 하려는 사람이 표를
    바꾸는 셈**이고 되돌릴 수도 없었다. 지금은 쓰지 않고 읽을 때만 메운다 —
    화면에 보이는 값은 그대로다.
*@

@inherits DataPage
@inject WbsClient Api

<PageTitle>WBS · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync">
    <Fields>
        <CommSchItem Label="프로젝트">
            @* 프로젝트가 정해지는 순간 조회한다. 첫 항목이 자동으로 골라지므로
               화면을 열자마자 목록이 찬다 — 옛 화면과 같은 동작이다. *@
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="진행">
            <CodeSelect CodeId="compstat" @bind-Value="_completeState" ShowAll="true" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont Title="WBS" Hint="@Hint">
    <CommGrd TItem="WbsItemDto"
             Data="@_rows"
             EditFormTitle="일감"
             ExportName="WBS"
             PageSize="30"
             EmptyText="일감이 없습니다."
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(w => $"「{w.ProcNm}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcId)" Caption="공정" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.Gb1)" Caption="구분1" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.Gb2)" Caption="구분2" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcTp)" Caption="종류" Width="110" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcNm)" Caption="일감" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevUser)" Caption="담당" Width="90" />

            <DxGridDataColumn Caption="진행" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var w = (WbsItemDto)cell.DataItem;
                    }
                    @* 날짜로 정해지는 값이다(머리말). *@
                    <span class="jsini-badge @w.StateClass">@w.StateName</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanSdt)" Caption="계획 시작" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanEdt)" Caption="계획 종료" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanGap)" Caption="기간" Width="70" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevSdt)" Caption="개발 시작" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevEdt)" Caption="개발 종료" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
        </Columns>

        <EditFormTemplate Context="edit">
            @* 일정표와 같은 폼이다 — 같은 표를 보기 때문이다. *@
            <WbsEditForm Item="@((WbsItemDto)edit.EditModel)" />
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    /// <summary>이 화면이 다루는 일정 종류. 일정표와 표를 나누는 유일한 값이다.</summary>
    private const string Kind = "WBS";

    private IReadOnlyList<WbsItemDto> _rows = [];

    private string? _projectCode;
    private string? _completeState;

    private int? ProjectRid => int.TryParse(_projectCode, out var rid) ? rid : null;

    private string Hint => $"{_rows.Count(w => w.WbsState == "COMP")} / {_rows.Count}건 완료";

    // **화면을 열 때 여기서 조회하지 않는다.** 프로젝트 고르개가 첫 항목을
    // 스스로 고르면서 조회를 건다(`AutoSelectFirst`). 둘 다 하면 **프로젝트를
    // 안 건 조회와 건 조회가 같이 날아가고**, 늦게 돌아온 쪽이 화면에 남는다 —
    // 프로젝트를 골랐는데 목록은 전체인 상태가 된다. 실제로 그렇게 보였다.

    private Task SearchAsync() => LoadAsync(async () =>
    {
        _rows = await Api.ListAsync(ProjectRid, _completeState, [Kind]);
        return _rows.Count;
    }, "일감이 없습니다.", "WBS 를 읽지 못했습니다");

    /// <summary>
    /// 새 일감은 <b>고른 프로젝트와 이 화면의 종류에 붙는다.</b> 안 붙이면
    /// 저장은 되는데 목록에서 사라진다 — 어느 프로젝트 것인지 모르기 때문이다.
    /// </summary>
    private void FillNew(WbsItemDto w)
    {
        w.PrjRid = ProjectRid;
        w.ScheduleType = Kind;
    }

    private async Task SaveAsync((WbsItemDto Item, bool IsNew) e)
    {
        if (e.IsNew)
        {
            await Api.CreateAsync(e.Item);
        }
        else
        {
            await Api.UpdateAsync(e.Item);
        }
    }

    private Task DeleteAsync(WbsItemDto w) => Api.DeleteAsync(w.WbsId);
}
