@page "/projmng/proj/wbs"
@attribute [RouteKey("projmng.proj.wbs")]

@*
프로젝트 WBS. 일정표와 같은 표를 schedule_type 으로 가른 WBS 쪽이다.
진행 상태(대기·진행·완료)는 적는 칸이 아니라 개발 시작·종료일로 서버가 정한다. 조회는 자료를 고치지 않고 읽을 때만 빈 계획 날짜를 메운다.
*@

@inherits DataPage

<PageTitle>WBS · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            @* 프로젝트가 정해지는 순간 조회한다 — 첫 항목이 자동으로 골라지므로 화면을 열자마자 목록이 찬다. *@
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="진행">
            <CodeSelect CodeId="compstat" @bind-Value="_completeState" ShowAll="true"
                        @bind-Text="_completeStateName" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont Title="WBS" Hint="@Hint">
    <CommGrd TItem="WbsItemDto"
             Data="@_rows"
             EditFormTitle="일감"
             ExportName="WBS"
             PageSize="30"
             EmptyText="일감이 없습니다."
             OnNew="@FillNew"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(w => $"「{w.ProcNm}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcId)" Caption="공정" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.Gb1)" Caption="구분1" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.Gb2)" Caption="구분2" Width="90" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcTp)" Caption="종류" Width="110" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.ProcNm)" Caption="일감" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevUser)" Caption="담당" Width="90" />

            <DxGridDataColumn Caption="진행" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var w = (WbsItemDto)cell.DataItem;
                    }
                    @* 날짜로 정해지는 값이다. *@
                    <span class="jsini-badge @w.StateClass">@w.StateName</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanSdt)" Caption="계획 시작" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanEdt)" Caption="계획 종료" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.PlanGap)" Caption="기간" Width="70" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevSdt)" Caption="개발 시작" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
            <DxGridDataColumn FieldName="@nameof(WbsItemDto.DevEdt)" Caption="개발 종료" Width="105"
                              DisplayFormat="yyyy-MM-dd" />
        </Columns>

        <EditFormTemplate Context="edit">
            @* 일정표와 같은 폼이다 — 같은 표를 보기 때문이다. *@
            <WbsEditForm Item="@((WbsItemDto)edit.EditModel)" />
        </EditFormTemplate>
    </CommGrd>
</CommCont>
