@page "/projmng/proj/wbs"
@using System.Data

@*
    [프로젝트 WBS]

    이력: 옛 Blazor `Pages/Proj/ProjWbs.razor` (`/proj-wbs`)
          → Vue `views/projmng/proj/wbs.vue` → 여기.
    프로시저: `sp_proj_wbs_exec` (`schedule_type = 'WBS'` 고정)

    프로젝트를 고르면 그 프로젝트의 WBS 항목이 나온다.
    행을 새로 만들면 프로젝트 키(`prj_rid`)를 자동으로 채운다 —
    안 채우면 저장할 때 어느 프로젝트 것인지 알 수 없어 목록에서 사라진다.
*@

@inherits DataPage
@inject ProjMngClient Client

<PageTitle>WBS · 프로젝트관리</PageTitle>

<PageNotice Text="@Notice" Tone="@Tone" />

<SearchBar>
    <ChildContent>
        @* 프로젝트가 정해지는 순간 조회한다. 첫 항목이 자동으로 골라지므로
           화면을 열자마자 목록이 찬다 — 옛 화면과 같은 동작이다. *@
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        <CodeSelect CodeId="compstat" @bind-Value="_completeState" ShowAll="true" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data"
             Loading="@_grid.IsLoading"
             DropdownCols="schedule_type|schedule_type"
             HiddenCols="prj_rid,proc_lvl,build_user,build_status,build_chk_dt,qc_chk_dt,cre_user,cre_dt,mod_user,mod_dt"
             ExportName="WBS"
             OnRefresh="@SearchAsync"
             OnSave="@SaveAsync"
             OnAdd="@FillProject"
             OnDelete="@DeleteAsync" />

@code {
    private ProcGrid _grid = default!;

    private string? _projectCode;
    private string? _completeState;

    protected override void OnInitialized() => _grid = new ProcGrid(Client, "sp_proj_wbs_exec");

    private Dictionary<string, object?> Params() => new()
    {
        ["prj_rid"] = _projectCode ?? string.Empty,
        ["compstat"] = _completeState ?? string.Empty,
        ["schedule_type"] = "WBS",
    };

    private Task SearchAsync() => LoadAsync(async () =>
    {
        await _grid.LoadAsync(Params());
        return _grid.Data.Table.Rows.Count;
    }, "조회 결과가 없습니다.", "조회하지 못했습니다");

    /// <summary>새 행에 프로젝트 키를 채운다 (옛 <c>NewRowCreate</c>).</summary>
    private Task FillProject(DataRow row)
    {
        if (row.Table.Columns.Contains("prj_rid"))
        {
            row["prj_rid"] = _projectCode ?? string.Empty;
        }
        return Task.CompletedTask;
    }

    private Task DeleteAsync(System.Data.DataRow row) =>
        RunAsync(() => _grid.DeleteAsync(row), "삭제했습니다.", "삭제하지 못했습니다");

    private async Task SaveAsync()
    {
        if (await RunAsync(() => _grid.SaveAsync(Params()), "저장했습니다.", "저장하지 못했습니다"))
        {
            Say(_grid.LastMessage ?? "저장했습니다.");
        }
    }
}
