@page "/projmng/wbs/dev-users"
@attribute [RouteKey("projmng.wbs.dev-users")]

@*
    [WBS 개발자 관리]

    이력: 사내망 WBS 대시보드(Vue) `views/DevUsers.vue`(344줄) → **여기**
    API: `projmng/wbs-board/dev-users`

    원장의 담당자 칸(`user_bp_id`)이 여기 사번을 가리킨다. **이 명부가 비면
    대시보드의 사람 이름이 전부 사번으로 보인다.**

    [명부이면서 장비 대장이다]

    노트북·모니터 세 대의 장비번호와 확인번호, MAC, 옷 치수까지 같은 줄에
    있다. 포털 계정에 그런 칸이 없어서 표를 통째로 계정 쪽에 넘기지 못했고,
    대신 **포털 계정 칸 하나**로 잇는다.

    [고친 것 — 칸을 떠나면 바로 저장하던 것을 창으로 바꿨다]

    원본은 칸에서 포커스가 빠질 때마다 저장했다. 칸이 서른 넷이라 표를 가로로
    구르며 고치는 화면에서는 그 편이 빨랐지만, 포털의 다른 화면 백여 개가
    전부 창으로 고친다 — 한 화면만 다르면 **저장 단추를 찾다가 못 찾는다.**

    [사용 IP 는 이제 권한이 아니다]

    사내에서는 이 칸이 인증 전부였다(접속 IP 를 대조). 포털 안에서는 JWT 와
    역할이 그 일을 하므로 **장비 대장으로만** 남겨 두었다. `super_yn`·`block_yn`
    도 같다 — 값은 보이지만 아무것도 가리지 않는다.
*@

@inherits DataPage
@inject WbsDevUserClient Api

<PageTitle>WBS 개발자 관리 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont Hint="@Hint">
    <CommGrd TItem="WbsDevUserDto"
             Data="@_rows"
             EditFormTitle="개발자"
             ExportName="개발자 명부"
             EmptyText="등록된 개발자가 없습니다."
             PageSize="25"
             OnEditOpen="@RememberKey"
             OnSave="@SaveAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(u => $"「{u.Name} ({u.BpId})」 을(를) 명부에서 지웁니다.\n원장의 담당자 칸은 그대로 남아 이름만 안 보이게 됩니다.")"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.BpId)" Caption="사번" Width="110" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.Name)" Caption="성명" Width="110" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.PositionNm)" Caption="직급" Width="90" />

            <DxGridDataColumn Caption="포털 계정" Width="130">
                <CellDisplayTemplate Context="cell">
                    @{
                        var u = (WbsDevUserDto)cell.DataItem;
                    }
                    @if (string.IsNullOrWhiteSpace(u.LoginId))
                    {
                        <span class="jsini-badge jsini-badge--off" title="아직 포털 계정과 잇지 않았습니다.">미연결</span>
                    }
                    else
                    {
                        @u.LoginId
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.TelNo)" Caption="연락처" Width="130" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.Email)" Caption="메일" MinWidth="180"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.UseIp)" Caption="사용 IP" Width="130" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.NotebookNo)" Caption="노트북" Width="120" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.PvUserId)" Caption="PV 계정" Width="130" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.SummerSize)" Caption="하계" Width="70" />
            <DxGridDataColumn FieldName="@nameof(WbsDevUserDto.WinterSize)" Caption="동계" Width="70" />
        </Columns>

        <EditFormTemplate Context="edit">
            @{
                var u = (WbsDevUserDto)edit.EditModel;
            }
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="사번" ColSpanMd="4">
                    <DxTextBox @bind-Text="u.BpId" ReadOnly="@(!_isNew)" />
                    <div class="jsini-hint">원장의 담당자 칸이 이 값을 가리킵니다. 등록한 뒤에는 바꿀 수 없습니다.</div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="성명" ColSpanMd="4">
                    <DxTextBox @bind-Text="u.Name" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="직급" ColSpanMd="4">
                    <DxTextBox @bind-Text="u.PositionNm" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="포털 계정" ColSpanMd="6">
                    <BizSelect Type="portal_account" @bind-Value="u.LoginId" />
                    <div class="jsini-hint">이으면 화면이 포털에서 이름과 얼굴을 가져옵니다. 비워 두어도 됩니다.</div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="생년월일" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.BirthDt" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="연락처" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.TelNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="비상연락처" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.EmergTelNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="메일" ColSpanMd="12">
                    <DxTextBox @bind-Text="u.Email" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="사용 IP" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.UseIp" />
                    <div class="jsini-hint">장비 대장입니다. 포털에서는 권한을 가리지 않습니다.</div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="MAC" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.MacAddr" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="노트북 번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.NotebookNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="노트북 확인번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.NotebookChkNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터1" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor1No" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터1 확인번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor1ChkNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터2" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor2No" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터2 확인번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor2ChkNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터3" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor3No" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="모니터3 확인번호" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.Monitor3ChkNo" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="하계 치수" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.SummerSize" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="동계 치수" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.WinterSize" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="ProjectView 계정" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.PvUserId" />
                    <div class="jsini-hint">워크플로 담당자를 이름 대신 이 값으로 찾습니다.</div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="허브 · HDMI" ColSpanMd="6">
                    <DxTextBox @bind-Text="u.HubHdmi" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="계정 발급" ColSpanMd="12">
                    <div class="pm-account-grid">
                        <DxTextBox @bind-Text="u.Git" NullText="git" />
                        <DxTextBox @bind-Text="u.Startkit" NullText="startkit" />
                        <DxTextBox @bind-Text="u.Dxb" NullText="dxb" />
                        <DxTextBox @bind-Text="u.VmConn" NullText="vm" />
                        <DxTextBox @bind-Text="u.Aipro" NullText="aipro" />
                        <DxTextBox @bind-Text="u.Claudecode" NullText="claude" />
                        <DxTextBox @bind-Text="u.DevDb" NullText="dev db" />
                        <DxTextBox @bind-Text="u.Wiki" NullText="wiki" />
                        <DxTextBox @bind-Text="u.Projectview" NullText="projectview" />
                        <DxTextBox @bind-Text="u.Svn" NullText="svn" />
                        <DxTextBox @bind-Text="u.Notebook" NullText="notebook" />
                    </div>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditFormTemplate>
    </CommGrd>
</CommCont>

@code {
    private string? _projectCode;
    private IReadOnlyList<WbsDevUserDto> _rows = [];

    /// <summary>지금 창에 있는 것이 새 줄인가. 사번 칸을 잠글지 정한다.</summary>
    private bool _isNew;

    private int? ProjectRid => int.TryParse(_projectCode, out var rid) ? rid : null;

    private string Hint =>
        $"{_rows.Count}명 · 포털 계정 연결 {_rows.Count(u => !string.IsNullOrWhiteSpace(u.LoginId))}명";

    private void RememberKey(WbsDevUserDto user, bool isNew) => _isNew = isNew;

    private Task SearchAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid)
        {
            _rows = [];
            return 0;
        }

        _rows = await Api.ListAsync(rid);
        return _rows.Count;
    }, "등록된 개발자가 없습니다.", "개발자 명부를 읽지 못했습니다");

    private async Task SaveAsync((WbsDevUserDto Item, bool IsNew) e)
    {
        if (ProjectRid is not int rid) return;

        if (e.IsNew)
        {
            await Api.CreateAsync(rid, e.Item);
        }
        else
        {
            await Api.UpdateAsync(rid, e.Item);
        }
    }

    private async Task DeleteAsync(WbsDevUserDto user)
    {
        if (ProjectRid is not int rid || user.BpId is null) return;

        await Api.DeleteAsync(rid, user.BpId);
    }
}
