@page "/projmng/sys/db-logic"
@attribute [RouteKey("projmng.sys.db-logic")]

@*
    [DB 로직 관리]

    이력: Vue `views/projmng/sys/db-logic.vue` → `DynamicGrid` +
          `sp_devsqlresp_base_exec` → **여기 (`CommGrd` + REST)**
    API: `projmng/db-logics` · `…/{dslCd}/queries`

    개발 도구 화면들의 **바닥**이다. 테이블 관리 · 쿼리 테스터 · DB 도구가
    「테이블 목록」이나 「프로시저 목록」을 물으면 서버가 여기 등록된 SQL 을
    꺼내 쓴다. 그래서 **여기가 비면 그 화면들이 통째로 멎는다.**

    왼쪽이 이름표(무엇을 하는 질의인가), 오른쪽이 그 이름표의 **DB 종류별 SQL**
    이다. 같은 「테이블 목록」이라도 PostgreSQL 과 MSSQL 의 질의가 다르다.

    ────────────────────────────────────────────────────────────
    [오른쪽 판은 지금까지 어느 화면에도 없었다]

    옛 프로시저는 이름표(`devsqlresp_base`, 21줄)만 다뤘다. 실제 SQL 을 담은
    표(`devsqlresp`, 48줄)는 **화면에서 열 수 없어** DB 를 직접 만져야 했다.

    [그리고 「삭제」가 아무 일도 안 했다]

    프로시저에 `delete` 갈래가 없어서 목록만 다시 읽고 끝났다. **오류도 안
    났다** — 지운 줄이 그대로 있는 것을 눈으로 봐야 알 수 있었다.

    이름표를 지울 때는 딸린 질의를 센다. 표에 외래키가 없어 DB 가 막아 주지
    않고, 그냥 지우면 이름표 없는 질의가 남아 어디에도 안 보인다.
*@

@inherits DataPage
@inject DbLogicClient Api

<PageTitle>DB 로직 관리 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Info"
            Text="개발 도구 화면(테이블 관리 · 쿼리 테스터 · DB 도구)이 읽는 질의입니다. 고치면 그 화면들의 동작이 바로 바뀝니다." />

<PageNotice Text="@Notice" Tone="@Tone" />

<div class="pm-split">
    <CommCont Title="이름표" Hint="@($"{_bases.Count}건")" CssClass="pm-split__side">
        <CommGrd TItem="DbLogicBaseDto"
                 Data="@_bases"
                 EditFormTitle="이름표"
                 ExportName="DB로직"
                 PageSize="20"
                 EmptyText="등록된 이름표가 없습니다."
                 OnSave="@SaveBaseAsync"
                 OnDelete="@DeleteBaseAsync"
                 DeleteConfirm="@(b => $"「{b.DslCd}」 을(를) 지웁니다.\n딸린 질의가 있으면 지워지지 않습니다.")"
                 Reload="@SearchAsync"
                 SelectedItem="@_base"
                 SelectedItemChanged="@PickBaseAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.DslCd)" Caption="이름" MinWidth="140"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.Comm)" Caption="설명" MinWidth="130"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.QueryCount)" Caption="질의" Width="70" />
                <DxGridDataColumn FieldName="@nameof(DbLogicBaseDto.Sort)" Caption="순서" Width="70" />
            </Columns>

            <EditFormTemplate Context="edit">
                @{
                    var b = (DbLogicBaseDto)edit.EditModel;
                }
                <DxFormLayout CssClass="pm-editform">
                    @* 이름이 곧 열쇠다. 고치면 **새 이름표가 하나 생기고** 옛
                       이름에 딸린 질의는 그대로 남는다 — 고칠 일이 드물다. *@
                    <DxFormLayoutItem Caption="이름" ColSpanMd="6">
                        <DxTextBox @bind-Text="b.DslCd" NullText="필수 — tablelist · proclist …" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="순서" ColSpanMd="6">
                        <DxSpinEdit @bind-Value="b.Sort" NullText="비우면 999" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                        <DxTextBox @bind-Text="b.Comm" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditFormTemplate>
        </CommGrd>
    </CommCont>

    <CommCont Title="@(_base is null ? "질의" : $"{_base.DslCd} 의 질의")"
              Hint="@(_base is null ? string.Empty : $"{_queries.Count}건")"
              CssClass="pm-split__main">
        @if (_base is null)
        {
            <PageNotice Text="왼쪽에서 이름표를 고르면 그 질의가 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <CommGrd TItem="DbLogicQueryDto"
                     Data="@_queries"
                     EditFormTitle="질의"
                     ExportName="DB로직질의"
                     PageSize="20"
                     EmptyText="이 이름표에 등록된 질의가 없습니다."
                     OnNew="@FillNewQuery"
                     OnSave="@SaveQueryAsync"
                     OnDelete="@DeleteQueryAsync"
                     DeleteConfirm="@(q => $"{q.DslType} 질의를 지웁니다.\n그 DB 종류에서 이 기능이 멎습니다.")"
                     Reload="@LoadQueriesAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(DbLogicQueryDto.DslType)" Caption="DB 종류" Width="120" />
                    <DxGridDataColumn Caption="질의" MinWidth="260">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var q = (DbLogicQueryDto)cell.DataItem;
                            }
                            @* 여러 줄짜리 SQL 이라 통째로 그리면 표가 세로로
                               늘어난다. 앞머리만 보여 주고 전체는 편집 창에서. *@
                            <span class="pm-oneline">@Head(q.DslQuery)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(DbLogicQueryDto.Comm)" Caption="설명" MinWidth="120"
                                      TextAlignment="GridTextAlignment.Left" />
                </Columns>

                <EditFormTemplate Context="edit">
                    @{
                        var q = (DbLogicQueryDto)edit.EditModel;
                    }
                    <DxFormLayout CssClass="pm-editform">
                        <DxFormLayoutItem Caption="DB 종류" ColSpanMd="6">
                            <DxComboBox Data="@DbTypes" @bind-Value="q.DslType" NullText="필수" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="설명" ColSpanMd="6">
                            <DxTextBox @bind-Text="q.Comm" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="질의" ColSpanMd="12">
                            <DxMemo @bind-Text="q.DslQuery" Rows="16" />
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </CommGrd>
        }
    </CommCont>
</div>

@code {
    /// <summary>
    /// 고를 수 있는 DB 종류. <b>서버가 접속을 만들 때 보는 값과 같아야 한다</b>
    /// (`ConstInfo.DbTypes` + 실제 등록된 `EDB`).
    /// </summary>
    private static readonly string[] DbTypes = ["POSTGRESQL", "MSSQL", "MYSQL", "EDB"];

    private IReadOnlyList<DbLogicBaseDto> _bases = [];
    private IReadOnlyList<DbLogicQueryDto> _queries = [];

    private DbLogicBaseDto? _base;

    /// <summary>표에 보여 줄 질의의 앞머리. 여러 줄이면 첫 줄만.</summary>
    private static string Head(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var line = value.Split('\n').FirstOrDefault(l => l.Trim().Length > 0)?.Trim() ?? string.Empty;
        return line.Length <= 90 ? line : line[..90] + "…";
    }

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync() => LoadAsync(async () =>
    {
        _bases = await Api.ListAsync();

        // 고른 이름표가 사라졌으면 오른쪽을 비운다.
        if (_base is not null && _bases.All(b => b.DslCd != _base.DslCd))
        {
            _base = null;
            _queries = [];
        }

        return _bases.Count;
    }, "등록된 이름표가 없습니다.", "이름표를 읽지 못했습니다");

    private Task PickBaseAsync(DbLogicBaseDto? item)
    {
        _base = item;

        if (item is null)
        {
            _queries = [];
            return Task.CompletedTask;
        }

        return LoadQueriesAsync();
    }

    private Task LoadQueriesAsync() => _base is null ? Task.CompletedTask : LoadAsync(async () =>
    {
        _queries = await Api.QueriesAsync(_base.DslCd);
        return _queries.Count;
    }, "이 이름표에 등록된 질의가 없습니다.", "질의를 읽지 못했습니다");

    private Task SaveBaseAsync((DbLogicBaseDto Item, bool IsNew) e) => Api.SaveAsync(e.Item);

    /// <summary>이름표 삭제. 딸린 질의가 있으면 서버가 막는다(머리말).</summary>
    private async Task DeleteBaseAsync(DbLogicBaseDto b)
    {
        await Api.DeleteAsync(b.DslCd);

        if (_base?.DslCd == b.DslCd)
        {
            _base = null;
            _queries = [];
        }
    }

    /// <summary>새 질의는 <b>고른 이름표에 붙는다.</b> 서버도 경로로 한 번 더 정한다.</summary>
    private void FillNewQuery(DbLogicQueryDto q) => q.DslCd = _base?.DslCd;

    private async Task SaveQueryAsync((DbLogicQueryDto Item, bool IsNew) e)
    {
        if (_base is null)
        {
            return;
        }

        if (e.IsNew)
        {
            await Api.CreateQueryAsync(_base.DslCd, e.Item);
        }
        else
        {
            await Api.UpdateQueryAsync(_base.DslCd, e.Item);
        }

        // 왼쪽의 「질의」 수가 방금 바뀌었다.
        await SearchAsync();
    }

    private async Task DeleteQueryAsync(DbLogicQueryDto q)
    {
        if (_base is null)
        {
            return;
        }

        await Api.DeleteQueryAsync(_base.DslCd, q.DslId);
        await SearchAsync();
    }
}
