@page "/projmng/sys/db-logic"
@using System.Data

@*
    [DB 로직 메인 관리]

    이력: Vue `views/projmng/sys/db-logic.vue` → 여기.
    시스템 DB 로직 마스터 프로시저 및 응답 규약을 관리한다.
*@

@inherits DataPage
@inject ProjMngClient Client

<PageTitle>DB 로직 관리 · 프로젝트관리</PageTitle>

<PageNotice Text="@Notice" Tone="@Tone" />

<SearchBar>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data" Loading="@_grid.IsLoading" ExportName="DB로직" OnRefresh="@SearchAsync" OnSave="@SaveAsync" OnDelete="@DeleteAsync" />

@code {
    private ProcGrid _grid = default!;

    protected override void OnInitialized()
    {
        _grid = new ProcGrid(Client, "sp_devsqlresp_base_exec");
    }

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync() => LoadAsync(async () =>
    {
        await _grid.LoadAsync();
        return _grid.Data.Table.Rows.Count;
    }, "조회 결과가 없습니다.", "조회하지 못했습니다");

    private async Task SaveAsync()
    {
        if (await RunAsync(() => _grid.SaveAsync(),
                "저장했습니다.", "저장하지 못했습니다"))
        {
            Say(_grid.LastMessage ?? "저장했습니다.");
        }
    }

    private Task DeleteAsync(System.Data.DataRow row) =>
        RunAsync(() => _grid.DeleteAsync(row), "삭제했습니다.", "삭제하지 못했습니다");
}
