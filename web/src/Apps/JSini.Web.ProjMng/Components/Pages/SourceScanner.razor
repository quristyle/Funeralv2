@page "/projmng/source/scaner"
@attribute [RouteKey("projmng.source.scaner")]

@*
    [소스 스캐너]

    이력: 옛 Blazor `Pages/Proj/ProjScaner.razor` (`/proj-scaner`)
          → Vue `views/projmng/proj/scaner.vue` → 여기.
    호출: `md_blazor_scan` (서버가 프로젝트 소스 경로를 훑는다)

    소스에서 화면 목록을 뽑아 보여 준다. 메뉴 관리 화면의
    "파일에서 메뉴 읽기" 가 쓰는 것과 같은 스캔 결과다.

    저장 동작은 없다 — 옛 화면도 그랬고, 등록은 메뉴 관리에서 한다.
    그 사실을 화면에 적어 두어야 사용자가 저장 버튼을 찾지 않는다.

    [실패를 말한다]

    예전에는 실패를 삼켜 빈 표만 남았다. 서버가 훑는 것은 **서버 장비의
    디스크**라 등록된 경로가 그 장비에 없는 일이 흔한데, 그때 「자료가 없다」와
    「못 훑었다」가 같아 보였다.
*@

@using System.Data

@inherits DataPage
@inject ProjMngClient Client

<PageTitle>소스 스캐너 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Info"
            Text="스캔 결과만 보여 줍니다. 화면을 메뉴로 등록하는 일은 포털의 [메뉴 관리]에서 합니다." />

<PageNotice Text="@Notice" Tone="@Tone" />

<CommSch OnSearch="@ScanAsync" SearchText="스캔" Busy="@Loading">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => ScanAsync())" />
        </CommSchItem>

        <CommSchItem Label="소스">
            @* 소스를 고르면 그것을, 안 고르면 그 프로젝트의 첫 소스를 훑는다. *@
            <SourceSelect ProjectCode="@_projectCode" @bind-Value="_sourceCode"
                          OnChanged="@(_ => ScanAsync())" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 칸이 실행 시점에 정해진다 — 훑은 소스의 등록 패턴에 따라 늘고 준다.
   저장·삭제 콜백을 주지 않으므로 표가 그 단추들을 아예 그리지 않는다. *@
<CommCont Title="스캔 결과" Hint="@($"{_data.Table.Rows.Count}건")">
    <CommGrd TItem="DataRowView"
             Data="@_data.Table"
             ExportName="소스스캔"
             PageSize="30"
             EmptyText="훑어서 찾은 화면이 없습니다."
             Reload="@ScanAsync">
        <Columns>
            <RuntimeColumns Table="@_data.Table" Order="@_data.ColumnOrder" />
        </Columns>
    </CommGrd>
</CommCont>

@code {
    private ProjMngTable _data = ProjMngTable.Empty;

    private string? _projectCode;
    private string? _sourceCode;

    /// <summary>
    /// 서버가 등록된 소스 경로를 훑는다.
    ///
    /// 훑는 것은 <b>서버 장비의 디스크</b>다. 등록된 경로가 그 장비에 없으면
    /// 아무것도 안 나온다 — 흔한 일이라 오류가 아니라 안내로 보여 준다.
    /// 예전에는 실패를 삼켜 빈 표만 남았고, 그래서 「자료가 없다」와
    /// 「못 훑었다」가 같아 보였다.
    /// </summary>
    private Task ScanAsync() => LoadAsync(async () =>
    {
        var result = await Client.MdContAsync("md_blazor_scan", new Dictionary<string, object?>
        {
            ["prj_rid"] = _projectCode ?? string.Empty,
            ["src_rid"] = _sourceCode ?? string.Empty,
        });

        if (result.ProcCode < 0)
        {
            throw new ApiException(result.Message ?? "소스를 훑지 못했습니다.");
        }

        _data = ProjMngTable.From(result);
        return _data.Table.Rows.Count;
    }, "훑어서 찾은 화면이 없습니다. 「소스 정보」에 경로가 등록돼 있는지 보십시오.", "소스를 훑지 못했습니다");
}
