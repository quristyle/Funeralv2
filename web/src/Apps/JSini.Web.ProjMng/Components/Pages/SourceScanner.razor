@page "/projmng/source/scaner"
@attribute [RouteKey("projmng.source.scaner")]

@*
소스 스캐너. 서버가 프로젝트 소스 경로를 훑어(md_blazor_scan) 화면 목록을 뽑는다 — 메뉴 관리의 「파일에서 메뉴 읽기」와 같은 결과다.
저장 동작은 없다(등록은 메뉴 관리에서 한다). 훑는 것은 서버 장비의 디스크라 경로가 없으면 오류가 아니라 안내로 보인다 — 실패를 삼키면 「자료가 없다」와 「못 훑었다」가 같아진다.
*@

@using System.Data

@inherits DataPage

<PageTitle>소스 스캐너 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@ScanAsync" SearchText="스캔" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => ScanAsync())" />
        </CommSchItem>

        <CommSchItem Label="소스">
            @* 소스를 고르면 그것을, 안 고르면 그 프로젝트의 첫 소스를 훑는다. *@
            <SourceSelect ProjectCode="@_projectCode" @bind-Value="_sourceCode" @bind-Text="_sourceName"
                          OnChanged="@(_ => ScanAsync())" />
        </CommSchItem>
    </Fields>
</CommSch>

@* 칸이 실행 시점에 정해진다 — 훑은 소스의 등록 패턴에 따라 늘고 준다. 저장·삭제 콜백을 주지 않아 표가 그 단추들을 그리지 않는다. *@
<CommCont Title="스캔 결과">
    <CommGrd TItem="DataRowView"
             Data="@_data.Table"
             ExportName="소스스캔"
             PageSize="30"
             EmptyText="훑어서 찾은 화면이 없습니다."
             Reload="@ScanAsync">
        <Columns>
            <RuntimeColumns Table="@_data.Table" Order="@_data.ColumnOrder" />
        </Columns>
    </CommGrd>
</CommCont>
