@page "/projmng/todo/monitor"
@attribute [RouteKey("projmng.todo.monitor")]

@*
할일 정산 현황. 담당자별 누계(정산)와 그날의 할일 목록을 한 그림에 나란히 둔다 — 탭이면 둘을 견주려고 오갈 때마다 다시 읽는다.
정산은 날짜로 좁히지 않는다(누계, 옛 화면과 같다). 날짜 조건은 오른쪽 할일 목록에만 걸린다. 이 화면은 보기만 하고, 고치는 것은 할일 화면이다.
*@

@inherits DataPage

<PageTitle>할일 정산 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="날짜">
            @* 오른쪽 목록에만 걸린다. *@
            <DxDateEdit @bind-Date="_targetDate" Style="width: 150px" />
        </CommSchItem>

        <CommSchItem Label="사람">
            <BizSelect Type="portal_account" @bind-Value="_userCode" ShowAll="true"
                       OnChanged="@(o => _userName = o?.Label)" />
        </CommSchItem>
    </Fields>
</CommSch>

<div class="pm-split">
    <CommCont Title="정산 집계" Hint="@($"{_pay.Sum(p => p.TotalPay):#,##0}원")" CssClass="pm-split__side">
        <CommGrd TItem="HomeTodoPayDto"
                 Data="@_pay"
                 ExportName="할일정산"
                 PageSize="20"
                 EmptyText="정산할 것이 없습니다."
                 Reload="@SearchAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(HomeTodoPayDto.TargetUser)" Caption="사람" MinWidth="110"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(HomeTodoPayDto.TotalPay)" Caption="누계" Width="110"
                                  DisplayFormat="#,##0" TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(HomeTodoPayDto.TodayPay)" Caption="오늘" Width="100"
                                  DisplayFormat="#,##0" TextAlignment="GridTextAlignment.Right" />
            </Columns>
        </CommGrd>
    </CommCont>

    <CommCont Title="할일 목록" Hint="@TodoHint" CssClass="pm-split__main">
        <CommGrd TItem="HomeTodoDto"
                 Data="@_todos"
                 ExportName="할일목록"
                 PageSize="30"
                 EmptyText="그날 할일이 없습니다."
                 Reload="@SearchAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(HomeTodoDto.TargetUser)" Caption="사람" Width="110" />
                <DxGridDataColumn FieldName="@nameof(HomeTodoDto.Title)" Caption="제목" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn Caption="완료" Width="70">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var t = (HomeTodoDto)cell.DataItem;
                        }
                        <span class="jsini-badge @(t.IsComplete ? "jsini-badge--on" : "jsini-badge--off")">
                            @(t.IsComplete ? "완료" : "미완")
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(HomeTodoDto.TodoStateName)" Caption="상태" Width="100" />
                <DxGridDataColumn FieldName="@nameof(HomeTodoDto.FixPoint)" Caption="금액" Width="90"
                                  DisplayFormat="#,##0" TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(HomeTodoDto.CompDt)" Caption="완료일시" Width="150"
                                  DisplayFormat="yyyy-MM-dd HH:mm" />
            </Columns>
        </CommGrd>
    </CommCont>
</div>
