@page "/projmng/wbs/delay"
@attribute [RouteKey("projmng.wbs.delay")]

@*
    [WBS 지연 현황]

    이력: 사내망 WBS 대시보드(Vue) `views/Delay.vue` → **여기**
    API: `projmng/wbs-board/delay/summary` · `…/by-user` · `…/rows`

    [착수지연과 종료지연은 서로 독립이다]

    한 줄이 둘 다일 수 있어서 **더하면 겹쳐 센다.** 그래서 「둘 다」와
    「하나라도」를 서버가 따로 준다 — 화면에서 빼고 더하지 않는다.

    판정식은 [상세 목록]의 지연 필터와 **같은 한 벌**이다. 갈라 두면 여기서
    눌러 넘어간 목록의 건수가 여기 숫자와 달라진다.
*@

@inherits DataPage

<PageTitle>WBS 지연 현황 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="잣대">
            <DxComboBox Data="@WbsBoardOptions.Who" @bind-Value="_who"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="갈래">
            <DxComboBox Data="@KindOptions" @bind-Value="_kind"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 140px" />
        </CommSchItem>
    </Fields>
</CommSch>

@if (_summary is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">기준일</div>
            <div class="jsini-stat__value pm-stat--dates">@_summary.Asof</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">착수지연</div>
            <div class="jsini-stat__value">@_summary.StartLate</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">종료지연</div>
            <div class="jsini-stat__value">@_summary.FinishLate</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">둘 다</div>
            <div class="jsini-stat__value">@_summary.BothLate</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">하나라도</div>
            <div class="jsini-stat__value">@_summary.AnyLate</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">최장 착수지연</div>
            <div class="jsini-stat__value">@Days(_summary.MaxStartDays)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">최장 종료지연</div>
            <div class="jsini-stat__value">@Days(_summary.MaxFinishDays)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">전체</div>
            <div class="jsini-stat__value">@_summary.Total</div>
        </div>
    </div>
}

<CommGrd TItem="WbsBoardDelayUserDto"
         Data="@_users"
         ExportName="사람별 지연"
         EmptyText="사람별 자료가 없습니다."
         RowActions="@UserActions"
         ActionsWidth="90"
         Reload="@SearchAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.UserNm)" Caption="사람" MinWidth="140"
                          TextAlignment="GridTextAlignment.Left" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.Assigned)" Caption="배정" Width="80" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.StartLate)" Caption="착수지연" Width="100" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.FinishLate)" Caption="종료지연" Width="100" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.AnyLate)" Caption="하나라도" Width="100" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayUserDto.UserBpId)" Caption="사번" Width="110" />
    </Columns>
</CommGrd>

<CommGrd TItem="WbsBoardDelayRowDto"
         Data="@_rows"
         ExportName="지연 상세"
         EmptyText="지연된 항목이 없습니다."
         PageSize="30"
         Reload="@SearchAsync">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.ActivityId)" Caption="액티비티" Width="120" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.Systemcode)" Caption="모듈" Width="100" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.MenuNm)" Caption="화면" MinWidth="200"
                          TextAlignment="GridTextAlignment.Left" />

        <DxGridDataColumn Caption="지연" Width="150">
            <CellDisplayTemplate Context="cell">
                @{
                    var r = (WbsBoardDelayRowDto)cell.DataItem;
                }
                @if (r.StartLate)
                {
                    <span class="jsini-badge jsini-badge--warn" title="계획시작일이 지났는데 실적시작일이 없습니다.">
                        착수 @r.StartDays 일
                    </span>
                }
                @if (r.FinishLate)
                {
                    <span class="jsini-badge jsini-badge--off" title="계획종료일이 지났는데 실적종료일이 없습니다.">
                        종료 @r.FinishDays 일
                    </span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.PlanSdt)" Caption="계획시작" Width="110" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.PlanEdt)" Caption="계획종료" Width="110" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.UserNm)" Caption="담당자" Width="110" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.UserRealNm)" Caption="개발자" Width="110" />
        <DxGridDataColumn FieldName="@nameof(WbsBoardDelayRowDto.ProgType)" Caption="유형" MinWidth="140"
                          TextAlignment="GridTextAlignment.Left" />
    </Columns>
</CommGrd>

@code {
    private RenderFragment<WbsBoardDelayUserDto> UserActions => user => __builder =>
    {
        <DxButton Text="목록"
                  RenderStyle="ButtonRenderStyle.Link"
                  Click="@(() => Drill(user.UserBpId))" />
    };
}
