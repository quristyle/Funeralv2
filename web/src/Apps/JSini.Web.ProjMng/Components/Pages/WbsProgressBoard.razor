@page "/projmng/wbs/progress"
@attribute [RouteKey("projmng.wbs.progress")]

@*
WBS 진척률 현황. 계획 진척률은 날짜가 얼마나 흘렀는지를 세며 실적 완료율과 나란히 둔다 — 둘이 벌어진 만큼이 늦은 것이다. 기준일은 DB 의 오늘이다(브라우저 시각을 쓰면 시차마다 숫자가 달라진다).
사람·모듈 표의 줄을 누르면 아래 항목 목록이 그 줄로 좁혀진다. 원본은 단일 프로젝트라 조건이 사이드바에 있었고 여기서는 조회 판에 둔다.
*@

@inherits DataPage

<PageTitle>WBS 진척률 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>

        <CommSchItem Label="진행 상태">
            <DxComboBox Data="@StatusOptions" @bind-Value="_status"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 170px" />
        </CommSchItem>
    </Fields>
</CommSch>

<div class="wpb">
    @if (_summary is { } s)
    {
        <div class="jsini-stats">
            <div class="jsini-stat">
                <div class="jsini-stat__label">전체 계획진척률</div>
                <div class="jsini-stat__value">@Rate(s.PlanRate)</div>
                <div class="wpb-gauge wpb-gauge--card"><div class="wpb-gauge__bar" style="width: @Width(s.PlanRate)"></div></div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">실적완료율</div>
                <div class="jsini-stat__value wpb-done">@Rate(s.DoneRate) <small class="wpb-sub">@(s.DoneCnt)건</small></div>
                <div class="wpb-gauge wpb-gauge--card"><div class="wpb-gauge__bar wpb-gauge__bar--done" style="width: @Width(s.DoneRate)"></div></div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">대형완료율</div>
                <div class="jsini-stat__value wpb-big">@Rate(s.DoneBigRate) <small class="wpb-sub">@(s.DoneBigCnt)건</small></div>
                <div class="wpb-gauge wpb-gauge--card"><div class="wpb-gauge__bar wpb-gauge__bar--big" style="width: @Width(s.DoneBigRate)"></div></div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">착수 전 (0%)</div>
                <div class="jsini-stat__value">@s.NotStarted</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">진행 중</div>
                <div class="jsini-stat__value">@s.InProgress</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">기간 경과 (100%)</div>
                <div class="jsini-stat__value">@s.Elapsed</div>
            </div>
            <div class="jsini-stat">
                <div class="jsini-stat__label">기준일 (오늘)</div>
                <div class="jsini-stat__value pm-stat--dates">@(s.Asof ?? "—")</div>
            </div>
        </div>

        @if (s.Total > s.Dated)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="@($"{s.Total - s.Dated}건은 계획 일정이 비어 있어 진척률을 낼 수 없습니다.")" />
        }
    }

    <div class="wpb-grid2">
        <DashboardSection Title="담당자별 계획진척률">
            @UserGrid(_byPlan, "plan", "담당자", "담당자별 계획진척률")
        </DashboardSection>

        <DashboardSection Title="개발자별 계획진척률" CssClass="wpb-real">
            @UserGrid(_byReal, "real", "개발자", "개발자별 계획진척률")
        </DashboardSection>
    </div>

    <DashboardSection Title="모듈별 계획진척률">
        <CommGrd TItem="WbsBoardProgressModuleDto"
                 Data="@_byModule"
                 ExportName="모듈별 계획진척률"
                 EmptyText="모듈별 자료가 없습니다."
                 PageSize="20"
                 AutoSelectFirstRow="false"
                 OnRowClick="@(m => PickModuleAsync(m.Systemcode))"
                 RowCssClass="@(m => m.Systemcode == _selModule ? "wpb-on" : "wpb-clk")"
                 Reload="@SearchAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.Systemcode)" Caption="모듈" Width="100">
                    <CellDisplayTemplate Context="cell">
                        <strong>@(((WbsBoardProgressModuleDto)cell.DataItem).Systemcode)</strong>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.SystemNm)" Caption="이름" MinWidth="140"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.Cnt)" Caption="건수" Width="70" />
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.PlanRate)" Caption="계획진척률" MinWidth="200">
                    <CellDisplayTemplate Context="cell">@Gauge(((WbsBoardProgressModuleDto)cell.DataItem).PlanRate, false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.DoneRate)" Caption="실적완료" Width="90">
                    <CellDisplayTemplate Context="cell">@Rate(((WbsBoardProgressModuleDto)cell.DataItem).DoneRate)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.DoneBigRate)" Caption="대형완료" Width="90">
                    <CellDisplayTemplate Context="cell">
                        <span class="wpb-big">@Rate(((WbsBoardProgressModuleDto)cell.DataItem).DoneBigRate)</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressModuleDto.MinDt)" Caption="기간" Width="200">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var m = (WbsBoardProgressModuleDto)cell.DataItem;
                        }
                        <span class="wpb-muted">@m.MinDt ~ @m.MaxDt</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </DashboardSection>

    <DashboardSection Title="항목별 계획진척률" Hint="@ItemsHint">
        <Actions>
            @if (HasSel)
            {
                <DxButton Text="필터 해제" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="@ClearSelAsync" />
            }
            <DxButton Text="상세 목록" IconCssClass="jsini-icon-open-in-new" RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" Click="@Drill" />

            <span class="wpb-sep"></span>

            <span class="wpb-pvpick" title="ProjectView 로 보낼 값">
                <DxComboBox Data="@PvValueOptions" @bind-Value="_pvValue"
                            TextFieldName="Text" ValueFieldName="Value" Style="width: 150px" />
            </span>
            <span title="ProjectView 캐시가 아는 현재값과 다른 건만 보냅니다">
                <DxCheckBox @bind-Checked="_pvDiffOnly" Enabled="@(_pvCache.Count > 0)">바뀐 것만</DxCheckBox>
            </span>
            <DxButton Text="ProjectView 전송 스크립트" RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" Click="@OpenPvScript" />
        </Actions>
        <ChildContent>
            <p class="wpb-pvnote @(_pvCache.Count > 0 ? null : "wpb-pvnote--off")">
                @if (_pvCache.Count > 0)
                {
                    <text>ProjectView 캐시 @(_pvCache.Count)건 사용</text>
                    <span class="wpb-muted wpb-gap">마지막 수집 @(_pvCacheAt ?? "—")</span>
                }
                else
                {
                    <text>ProjectView 캐시가 비어 있어 목록 전체 조회 + 전 건 전송으로 나갑니다.</text>
                }
            </p>

            @if (HasSel)
            {
                <p class="wpb-selnote">필터: @SelText</p>
            }

            <CommGrd @ref="_itemGrid"
                     TItem="WbsProgressItem"
                     Data="@StatusRows"
                     ExportName="항목별 계획진척률"
                     EmptyText="해당 조건의 항목이 없습니다"
                     PageSize="50"
                     ShowHeaderCount="true"
                     AutoSelectFirstRow="false"
                     ShowFilterRow="true"
                     Reload="@ReloadRowsAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.ActivityId)" Caption="Activity ID" Width="110"
                                      FilterRowOperatorType="GridFilterRowOperatorType.Contains">
                        <CellDisplayTemplate Context="cell">@(((WbsProgressItem)cell.DataItem).ActivityId ?? "—")</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.Systemcode)" Caption="모듈" Width="85"
                                      FilterRowOperatorType="GridFilterRowOperatorType.Contains" />
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.MenuNm)" Caption="메뉴명" MinWidth="220"
                                      TextAlignment="GridTextAlignment.Left"
                                      FilterRowOperatorType="GridFilterRowOperatorType.Contains" />
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.PlanSdt)" Caption="시작일" Width="100"
                                      FilterRowOperatorType="GridFilterRowOperatorType.Contains">
                        <CellDisplayTemplate Context="cell">@(((WbsProgressItem)cell.DataItem).PlanSdt ?? "—")</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.PlanEdt)" Caption="종료일" Width="100"
                                      FilterRowOperatorType="GridFilterRowOperatorType.Contains">
                        <CellDisplayTemplate Context="cell">@(((WbsProgressItem)cell.DataItem).PlanEdt ?? "—")</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.SpanDays)" Caption="기간" Width="70"
                                      FilterRowOperatorType="GridFilterRowOperatorType.GreaterOrEqual">
                        <CellDisplayTemplate Context="cell"><span class="wpb-muted">@(((WbsProgressItem)cell.DataItem).SpanDays)일</span></CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.PassedDays)" Caption="경과" Width="70"
                                      FilterRowOperatorType="GridFilterRowOperatorType.GreaterOrEqual">
                        <CellDisplayTemplate Context="cell"><span class="wpb-muted">@(((WbsProgressItem)cell.DataItem).PassedDays)일</span></CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.PlanRate)" Caption="계획진척률" MinWidth="160"
                                      FilterRowOperatorType="GridFilterRowOperatorType.GreaterOrEqual">
                        <CellDisplayTemplate Context="cell">@Gauge(((WbsProgressItem)cell.DataItem).PlanRate, true)</CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.Complate)" Caption="완료" Width="75">
                        <CellDisplayTemplate Context="cell">@Check(((WbsProgressItem)cell.DataItem).Complate)</CellDisplayTemplate>
                        <FilterRowCellTemplate Context="f">@CheckFilter(f)</FilterRowCellTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.UserText)" Caption="담당자" Width="120">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var r = (WbsProgressItem)cell.DataItem;
                            }
                            @if (r.UserNm is not null)
                            {
                                <span class="wpb-nm">@r.UserNm</span>
                            }
                            else
                            {
                                <span class="wpb-muted">—</span>
                            }
                        </CellDisplayTemplate>
                        <FilterRowCellTemplate Context="f">
                            <GridCheckFilter Filter="@f" Options="@UserFilterOptions" />
                        </FilterRowCellTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.UserRealText)" Caption="개발자" Width="120">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var r = (WbsProgressItem)cell.DataItem;
                            }
                            @if (r.UserRealNm is not null)
                            {
                                <span class="wpb-nm">@r.UserRealNm</span>
                            }
                            else
                            {
                                <span class="wpb-unset" title="미할당"></span>
                            }
                        </CellDisplayTemplate>
                        <FilterRowCellTemplate Context="f">
                            <GridCheckFilter Filter="@f" Options="@RealFilterOptions" />
                        </FilterRowCellTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.ComplateReal)" Caption="개발자완료" Width="90">
                        <CellDisplayTemplate Context="cell">@Check(((WbsProgressItem)cell.DataItem).ComplateReal)</CellDisplayTemplate>
                        <FilterRowCellTemplate Context="f">@CheckFilter(f)</FilterRowCellTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(WbsProgressItem.TaskState)" Caption="일감" Width="95">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var r = (WbsProgressItem)cell.DataItem;
                            }
                            <button type="button"
                                    class="pm-wbs-badge @(r.TaskCnt == 0 ? null : r.TaskDone < r.TaskCnt ? "pm-wbs-badge--open" : "pm-wbs-badge--done")"
                                    title="@(r.TaskCnt > 0 ? $"일감 {r.TaskDone}/{r.TaskCnt} 완료 — 누르면 관리" : "일감 없음 — 누르면 추가")"
                                    disabled="@(r.ActivityId is null)"
                                    @onclick="@(() => OpenTasksAsync(r))" @onclick:stopPropagation="true">
                                @(r.TaskCnt > 0 ? $"{r.TaskDone}/{r.TaskCnt}" : "+")
                            </button>
                        </CellDisplayTemplate>
                        <FilterRowCellTemplate Context="f">@TaskFilter(f)</FilterRowCellTemplate>
                    </DxGridDataColumn>
                </Columns>
            </CommGrd>

            <p class="wpb-note">
                계획진척률 = 계획시작일 도래 전 <strong>0%</strong> · 계획종료일 경과 <strong>100%</strong> ·
                그 사이는 <code>경과 ÷ 기간</code> = <code>(오늘 − 시작일) ÷ (종료일 − 시작일)</code>.
                기준일 <strong>@_summary?.Asof</strong> · 시작일=종료일인 1일 작업은 도래 시 100%.
                집계값은 항목별 진척률의 <strong>단순 평균</strong>이며, 격차(p)는 계획진척률 − 실적완료율입니다.
            </p>
            <p class="wpb-note">
                ProjectView 전송: <strong>@(FullAtText)% 이상</strong>은 <strong>@(FullRateText)%</strong> 로 올려 보내며,
                100% 로 올라간 건은 ProjectView 에서 완료로 읽힙니다.
            </p>
        </ChildContent>
    </DashboardSection>
</div>

<WbsTaskPopup @ref="_taskPopup" ProjectRid="@ProjectRid" Changed="@ReloadTaskCountsAsync" />

@* ──────────────── ProjectView 전송 스크립트 ──────────────── *@
<CommPopup @bind-Visible="_pvOpen" HeaderText="ProjectView 전송 스크립트" Width="940px">
    <BodyContentTemplate Context="popup">
        <div class="wpb-pv">
            <div class="wpb-muted">@_pvMeta</div>
            <ol class="wpb-pv__steps">
                <li>아래 스크립트를 복사합니다 (자동 복사가 막히면 <code>Ctrl+C</code>).</li>
                <li><strong>ProjectView 로그인 탭</strong>에서 <code>F12 → Console</code> 에 붙여넣고 Enter
                    → <strong>확인만</strong> 하고 전송하지 않습니다 (DRY RUN).</li>
                <li>출력된 대상·값이 맞으면 콘솔에 <code>pvSend()</code> 를 입력하고 Enter → <strong>실제 전송</strong>.</li>
                <li>전송 후 ProjectView 화면을 <strong>새로고침(F5)</strong> 하면 반영된 값이 보입니다.
                    실패한 건이 있으면 <strong>같은 스크립트를 한 번 더</strong> 돌리면 됩니다 —
                    이미 맞는 값은 건너뜁니다.</li>
            </ol>
            <p class="wpb-pv__sends">바뀌는 값: finishRate · actualProgressRate (ProjectView 기준 실적 진척률) · @(FullAtText)% 이상은 @(FullRateText)% 로 보냅니다</p>
            <textarea class="wpb-pv__code" readonly spellcheck="false" rows="18">@_pvScript</textarea>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popup">
        <DxButton Text="복사" IconCssClass="jsini-icon-copy" RenderStyle="ButtonRenderStyle.Primary" Click="@CopyPvScriptAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _pvOpen = false)" />
    </FooterContentTemplate>
</CommPopup>

@code {
    /// <summary>담당자별 · 개발자별 표. 잣대만 다르고 생김새가 같다.</summary>
    private RenderFragment UserGrid(IReadOnlyList<WbsBoardProgressUserDto> data, string who, string caption, string export) => __builder =>
    {
        <CommGrd TItem="WbsBoardProgressUserDto"
                 Data="@data"
                 ExportName="@export"
                 EmptyText="자료가 없습니다."
                 PageSize="15"
                 AutoSelectFirstRow="false"
                 OnRowClick="@(u => PickUserAsync(who, u.UserBpId))"
                 RowCssClass="@(u => IsPicked(who, u.UserBpId) ? "wpb-on" : "wpb-clk")"
                 Reload="@SearchAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressUserDto.UserNm)" Caption="@caption" MinWidth="130"
                                  TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var u = (WbsBoardProgressUserDto)cell.DataItem;
                        }
                        <span class="wpb-nm">@u.UserNm</span>
                        @if (u.UserNm != u.UserBpId)
                        {
                            <span class="wpb-uid">@u.UserBpId</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressUserDto.Cnt)" Caption="건수" Width="65" />
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressUserDto.PlanRate)" Caption="계획진척률" MinWidth="150">
                    <CellDisplayTemplate Context="cell">@Gauge(((WbsBoardProgressUserDto)cell.DataItem).PlanRate, false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressUserDto.DoneRate)" Caption="실적완료" Width="85">
                    <CellDisplayTemplate Context="cell">@Rate(((WbsBoardProgressUserDto)cell.DataItem).DoneRate)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WbsBoardProgressUserDto.DoneBigRate)" Caption="대형완료" Width="85">
                    <CellDisplayTemplate Context="cell">
                        <span class="wpb-big">@Rate(((WbsBoardProgressUserDto)cell.DataItem).DoneBigRate)</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="격차" Width="75">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var gap = Gap((WbsBoardProgressUserDto)cell.DataItem);
                        }
                        <span class="@(gap >= 80 ? "wpb-bad" : gap >= 50 ? "wpb-warn" : null)">@(gap is null ? "—" : $"{gap:0.#}p")</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    };

    /// <summary>진행 막대 + 비율. 항목 표에서 100% 는 다른 색이다 — 기한을 넘긴 줄이 한눈에 보여야 한다.</summary>
    private RenderFragment Gauge(decimal? rate, bool markFull) => __builder =>
    {
        <span class="wpb-row2">
            <span class="wpb-gauge"><span class="wpb-gauge__bar @(markFull && rate == 100 ? "wpb-gauge__bar--full" : null)" style="width: @Width(rate)"></span></span>
            <span class="wpb-pct">@Rate(rate)</span>
        </span>
    };

    private RenderFragment Check(bool on) => __builder =>
    {
        if (on)
        {
            <span class="wpb-chk">✓</span>
        }
        else
        {
            <span class="wpb-muted">·</span>
        }
    };

    private RenderFragment CheckFilter(GridDataColumnFilterRowCellTemplateContext f) => __builder =>
    {
        <select class="pm-wbs-fsel @(CheckFilterValue(f) is { Length: > 0 } ? "pm-wbs-fsel--on" : null)"
                value="@CheckFilterValue(f)" @onchange="@(e => SetCheckFilter(f, e.Value as string))">
            <option value="">전체</option>
            <option value="y">✓ 완료</option>
            <option value="n">미완료</option>
        </select>
    };

    private RenderFragment TaskFilter(GridDataColumnFilterRowCellTemplateContext f) => __builder =>
    {
        <select class="pm-wbs-fsel @(TaskFilterValue(f) is { Length: > 0 } ? "pm-wbs-fsel--on" : null)"
                value="@TaskFilterValue(f)" @onchange="@(e => SetTaskFilter(f, e.Value as string))">
            <option value="">전체</option>
            <option value="open">미완료 있음</option>
            <option value="done">전부 완료</option>
            <option value="none">일감 없음</option>
        </select>
    };
}
