@page "/projmng/ai/target-status"
@attribute [RouteKey("projmng.ai.target-status")]

@*
AI 작업 대상의 git 상태. 시키기 전·뒤에 들여다보는 자리이고, 실행기가 몇 분마다 적어 둔 스냅샷을 읽으므로 본 시각을 반드시 같이 그린다.
고치는 단추는 두지 않는다 — 보는 것과 고치는 것을 가른다.
*@

@inherits DataPage
@implements IDisposable

<PageTitle>대상 git 상태 · 프로젝트관리</PageTitle>

<PageNotice Tone="NoticeTone.Info" Text="@SnapshotNotice" />

<div class="pm-stack">
    <CommCont Title="대상" Hint="@Hint">
        <Actions>
            @* 확인은 고치는 동작이 아니지만 서버에 자국을 남기므로 Create 권한으로 묶는다(메뉴 SQL 의 use_create). *@
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="모두 다시 확인"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Enabled="@(_rows.Count > 0 && !Loading)"
                          Click="@ProbeAllAsync" />
            </PermissionView>
        </Actions>
        <ChildContent>
            <CommGrd TItem="AiTargetStatusDto"
                     Data="@_rows"
                     ExportName="대상git상태"
                     PageSize="20"
                     EmptyText="등록된 대상이 없습니다."
                     @bind-SelectedItem="@_picked"
                     Reload="@SearchAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(AiTargetStatusDto.TargetNm)" Caption="이름"
                                      MinWidth="130" TextAlignment="GridTextAlignment.Left" />

                    @* 등록된 종류와 실제가 어긋나면 여기서 먼저 말한다 — 작업을 돌려 봐야 드러나던 것이다. *@
                    <DxGridDataColumn Caption="상태" Width="110">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            <span class="jsini-badge jsini-badge--@t.Tone">@t.StateText</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="가지" MinWidth="120"
                                      TextAlignment="GridTextAlignment.Left">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (!t.IsRepo)
                            {
                                <span class="pm-ai-dim">-</span>
                            }
                            else
                            {
                                <span class="pm-gitmono">@t.Branch</span>

                                @* 등록된 기준 가지와 다르면 짚는다. 원본 직접 대상에서는 엉뚱한 가지에 커밋이 쌓인다. *@
                                @if (OffDefault(t))
                                {
                                    <span class="jsini-badge jsini-badge--warn pm-git__tag">기준 @t.DefaultRef</span>
                                }
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 앞섬·뒤처짐은 fetch 없이 센 값이라 위 안내가 그 사실을 적는다. *@
                    <DxGridDataColumn FieldName="@nameof(AiTargetStatusDto.SyncText)" Caption="앞섬/뒤처짐"
                                      Width="100" />

                    <DxGridDataColumn Caption="변경" Width="80">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (!t.IsRepo || !t.Probed)
                            {
                                <span class="pm-ai-dim">-</span>
                            }
                            else if (t.IsClean)
                            {
                                <span class="pm-ai-dim">없음</span>
                            }
                            else
                            {
                                @($"{t.DirtyCount}건")
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 정본에서 걷어낸 변경이 쌓이는 곳이다. 0 이면 흐리게 둔다. *@
                    <DxGridDataColumn Caption="stash" Width="70">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (t.StashCount == 0)
                            {
                                <span class="pm-ai-dim">0</span>
                            }
                            else
                            {
                                <span class="jsini-badge jsini-badge--warn">@t.StashCount</span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="마지막 커밋" MinWidth="200"
                                      TextAlignment="GridTextAlignment.Left">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (t.HeadSha is { Length: > 0 })
                            {
                                <span class="pm-gitmono">@t.ShortSha</span>
                                <span class="pm-oneline pm-git__subject">@t.HeadSubject</span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    @* 이 칸이 이 화면의 양심이다 — 없으면 옛 값이 지금 값으로 읽힌다. *@
                    <DxGridDataColumn Caption="확인" Width="100">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (t.ProbePending)
                            {
                                <span class="jsini-badge jsini-badge--warn">확인 중</span>
                            }
                            else
                            {
                                <span class="@(Stale(t) ? "pm-git__stale" : null)">@Ago(t.ProbedAt)</span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn Caption="장비" Width="100">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var t = (AiTargetStatusDto)cell.DataItem;
                            }
                            @if (t.RunnerNm is { Length: > 0 })
                            {
                                @t.RunnerNm
                            }
                            else if (t.TargetRunnerNm is { Length: > 0 })
                            {
                                <span class="pm-ai-dim">@t.TargetRunnerNm</span>
                            }
                            else
                            {
                                <span class="pm-ai-dim">아무 장비나</span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>

                <RowActions Context="row">
                    <PermissionView Action="MenuAction.Create">
                        <DxButton Text="확인"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  Title="이 대상을 지금 다시 보라고 실행기에 알립니다"
                                  Enabled="@(!row.ProbePending)"
                                  Click="@(() => ProbeAsync(row))" />
                    </PermissionView>
                </RowActions>
            </CommGrd>
        </ChildContent>
    </CommCont>

    @* ── 고른 한 건 ── 경로·원격 주소·커밋 전문·정리되지 않은 파일 목록은 표에 못 넣어 아래로 뺀다. *@
    <CommCont Title="자세히">
        @if (_picked is not { } p)
        {
            <PageNotice Tone="NoticeTone.Info" Text="위에서 대상을 고르십시오." />
        }
        else
        {
            <dl class="pm-git">
                <dt>경로</dt>
                <dd class="pm-gitmono">@p.TargetPath</dd>

                <dt>등록</dt>
                <dd>
                    @p.KindText · 격리 @IsolationText(p) · 기준 @p.DefaultRef
                    @if (p.AllowPush)
                    {
                        <span class="jsini-badge jsini-badge--err pm-git__tag">올리기 허용</span>
                    }
                    @if (!p.IsEnabled)
                    {
                        <span class="jsini-badge jsini-badge--off pm-git__tag">중지</span>
                    }
                </dd>

                @if (p.RemoteUrl is { Length: > 0 })
                {
                    <dt>원격</dt>
                    <dd class="pm-gitmono">@p.RemoteUrl</dd>
                }

                @if (p.IsRepo)
                {
                    <dt>가지</dt>
                    <dd>
                        <span class="pm-gitmono">@p.Branch</span>
                        @if (string.IsNullOrWhiteSpace(p.Upstream))
                        {
                            @* 추적하는 곳이 없으면 앞섬·뒤처짐이 없는 값이다. 0 / 0 으로 보이면 맞춰진 것으로 읽힌다. *@
                            <span class="pm-ai-dim"> — 추적하는 원격 가지가 없습니다</span>
                        }
                        else
                        {
                            <span class="pm-ai-dim"> → @p.Upstream</span>
                            <span> (앞섬 @p.Ahead · 뒤처짐 @p.Behind)</span>
                        }
                    </dd>
                }

                @if (p.HeadSha is { Length: > 0 })
                {
                    <dt>마지막 커밋</dt>
                    <dd>
                        <span class="pm-gitmono">@p.ShortSha</span>
                        @p.HeadSubject
                        <span class="pm-ai-dim"> — @p.HeadAuthor @When(p.HeadDt)</span>
                    </dd>
                }

                @if (p.Probed && p.IsRepo)
                {
                    <dt>정리 안 된 것</dt>
                    <dd>
                        @if (p.IsClean)
                        {
                            <span class="pm-ai-dim">없습니다.</span>
                        }
                        else
                        {
                            <span>
                                색인 @p.Staged · 작업본 @p.Unstaged ·
                                추적 안 함 @p.Untracked · 충돌 @p.Conflicted
                            </span>

                            @* 숫자만으로는 무엇이 빠졌는지 모르므로 앞 스무 줄만 싣는다. *@
                            @if (p.DirtyFiles is { Length: > 0 } files)
                            {
                                <pre class="pm-git__files">@files</pre>
                            }
                        }
                    </dd>
                }

                @if (p.StashCount > 0)
                {
                    <dt>stash</dt>
                    <dd>
                        @p.StashCount 건.
                        <span class="pm-ai-dim">
                            원본 직접으로 돈 작업이 정본에 남긴 변경을 실행기가 여기로 옮깁니다.
                            살릴 것이 있으면 장비에서 <code>git stash list</code> 로 꺼냅니다.
                        </span>
                    </dd>
                }

                @if (p.KindMismatch)
                {
                    <dt>어긋남</dt>
                    <dd class="pm-git__bad">
                        저장소로 등록됐는데 그 경로에 <code>.git</code> 이 없습니다.
                        이 대상의 작업은 준비 단계에서 실패합니다 —
                        대상 관리에서 종류나 경로를 고치십시오.
                    </dd>
                }

                @if (p.ProbeError is { Length: > 0 } err)
                {
                    <dt>확인 실패</dt>
                    <dd class="pm-git__bad">@err</dd>
                }

                <dt>확인 시각</dt>
                <dd>
                    @if (!p.Probed)
                    {
                        <span class="pm-ai-dim">아직 한 번도 확인된 적이 없습니다.</span>
                    }
                    else
                    {
                        @($"{When(p.ProbedAt)} ({Ago(p.ProbedAt)})")

                        @if (p.RunnerNm is { Length: > 0 })
                        {
                            <span class="pm-ai-dim"> · @p.RunnerNm 에서 봄</span>
                        }
                    }
                </dd>
            </dl>
        }
    </CommCont>
</div>
