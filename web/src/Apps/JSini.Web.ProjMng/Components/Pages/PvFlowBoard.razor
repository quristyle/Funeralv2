@page "/projmng/wbs/pv-flow"
@attribute [RouteKey("projmng.wbs.pv-flow")]

@*
    [워크플로 채우기]

    이력: 사내망 WBS 대시보드(Vue) `views/PvFlow.vue`(367줄) → **여기**
    API: `projmng/pv/cache` · `…/tasks`
    스크립트: `wwwroot/js/pv-flow-core.js`(원본 1,003줄 그대로)

    ProjectView 워크플로의 **빈 일자·담당자**를 채우는 화면이다. 여기서는
    무엇이 비어 있는지 보여 주고 채우는 스크립트를 만들어 준다 — 실제로
    채우는 것은 ProjectView 탭의 콘솔이다(그쪽 로그인 쿠키가 필요하다).

    [단계 개수는 우리가 센 값이다]

    수집 스크립트가 단계를 함께 보내면 서버가 직접 세어 담는다. ProjectView 가
    신고한 개수보다 그쪽이 정확하다 — 단계를 지운 뒤에도 옛 개수가 남아 있는
    경우가 있었다.
*@

@inherits DataPage
@inject PvClient Api
@inject IJSRuntime Js

<PageTitle>워크플로 채우기 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="보기">
            <DxComboBox Data="@ViewOptions" @bind-Value="_view"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 150px" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="채우기 스크립트 복사"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CopyFlowAsync" />

        <DxButton Text="기록 스크립트 복사"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CopyRecordAsync" />
    </Actions>
</CommSch>

@if (_status?.Tasks is { } tasks)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">일감</div>
            <div class="jsini-stat__value">@tasks.Tasks</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">단계</div>
            <div class="jsini-stat__value">@tasks.Nodes</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">빈 단계</div>
            <div class="jsini-stat__value">@tasks.NodesEmpty</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">담당자 있음</div>
            <div class="jsini-stat__value">@tasks.Charged</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">단계 표시 있음</div>
            <div class="jsini-stat__value">@tasks.Staged</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">마지막 수집</div>
            <div class="jsini-stat__value pm-stat--dates">@(tasks.LastSeen ?? "—")</div>
        </div>
    </div>

    @if (tasks.Tasks == 0)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="아직 걷어 온 워크플로가 없습니다. [ProjectView 동기화] 화면에서 먼저 수집하십시오." />
    }
}

<CommCont Hint="@Hint">
    <CommGrd TItem="PvTaskDto"
             Data="@Filtered"
             ExportName="워크플로 일감"
             EmptyText="일감이 없습니다."
             PageSize="30"
             SelectedItem="@_selected"
             SelectedItemChanged="@OnSelectedAsync"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.ActivityId)" Caption="액티비티" Width="130" />
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvTaskCode)" Caption="일감 코드" Width="130" />
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvTaskTitle)" Caption="이름" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />

            <DxGridDataColumn Caption="단계" Width="110">
                <CellDisplayTemplate Context="cell">
                    @{
                        var t = (PvTaskDto)cell.DataItem;
                    }
                    <span title="빈 단계 / 전체">@(t.PvNodeEmpty ?? 0) / @(t.PvNodeCnt ?? 0)</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvChargerNm)" Caption="담당자" Width="110" />
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvStatus)" Caption="현재단계" Width="120" />
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvPlanEdt)" Caption="계획종료" Width="110" />
            <DxGridDataColumn FieldName="@nameof(PvTaskDto.PvSeenAt)" Caption="본 때" Width="170" />
        </Columns>
    </CommGrd>
</CommCont>

@if (_selected is not null)
{
    <CommCont Title="@($"단계 · {_selected.PvTaskTitle}")">
        <CommGrd TItem="PvNodeDto"
                 Data="@_nodes"
                 ExportName="워크플로 단계"
                 EmptyText="담아 둔 단계가 없습니다."
                 PageSize="20"
                 Reload="@LoadNodesAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(PvNodeDto.NodeNo)" Caption="차례" Width="70" />
                <DxGridDataColumn FieldName="@nameof(PvNodeDto.StageNm)" Caption="단계" MinWidth="160"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn Caption="일자" Width="120">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var n = (PvNodeDto)cell.DataItem;
                        }
                        @if (n.NodeDt is null)
                        {
                            <span class="jsini-badge jsini-badge--warn">비어 있음</span>
                        }
                        else
                        {
                            @n.NodeDt
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="담당자" MinWidth="140">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var n = (PvNodeDto)cell.DataItem;
                        }
                        @if (n.WorkerId is null)
                        {
                            <span class="jsini-badge jsini-badge--warn">비어 있음</span>
                        }
                        else
                        {
                            @(n.WorkerNm ?? n.WorkerId)
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </CommCont>
}

@code {
    private string? _projectCode;
    private string _view = "empty";

    private PvCacheStatusDto? _status;
    private IReadOnlyList<PvTaskDto> _tasks = [];

    private PvTaskDto? _selected;
    private IReadOnlyList<PvNodeDto> _nodes = [];

    private int? ProjectRid => int.TryParse(_projectCode, out var rid) ? rid : null;

    private static readonly object[] ViewOptions =
    [
        new { Text = "빈 칸 있는 것", Value = "empty" },
        new { Text = "전체", Value = "all" },
    ];

    private IReadOnlyList<PvTaskDto> Filtered =>
        _view == "all" ? _tasks : [.. _tasks.Where(t => (t.PvNodeEmpty ?? 0) > 0)];

    private string Hint =>
        $"{Filtered.Count} / {_tasks.Count}건 · 빈 단계 {_tasks.Sum(t => t.PvNodeEmpty ?? 0)}개";

    private Task SearchAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid)
        {
            _status = null;
            _tasks = [];
            _selected = null;
            _nodes = [];
            return 0;
        }

        var status = Api.StatusAsync(rid);
        var bundle = Api.TasksAsync(rid);

        await Task.WhenAll(status, bundle);

        _status = status.Result;
        _tasks = bundle.Result?.Tasks ?? [];

        return Filtered.Count;
    }, "빈 칸이 있는 일감이 없습니다.", "워크플로를 읽지 못했습니다");

    private async Task OnSelectedAsync(PvTaskDto? task)
    {
        _selected = task;
        await LoadNodesAsync();
    }

    /// <summary>
    /// 고른 일감의 단계. <b>목록 전체에는 싣지 않는다</b> — 펼쳐 볼 때만
    /// 필요한 자료라 한꺼번에 받으면 응답이 몇 배가 된다.
    /// </summary>
    private Task LoadNodesAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid || _selected?.ActivityId is null)
        {
            _nodes = [];
            return 0;
        }

        var bundle = await Api.TasksAsync(rid, _selected.ActivityId);

        _nodes = [.. (bundle?.Nodes ?? []).Where(n => n.PvTaskId == _selected.PvTaskId)];

        return _nodes.Count;
    }, "담아 둔 단계가 없습니다.", "단계를 읽지 못했습니다");

    private Task CopyFlowAsync() => CopyAsync("flow", "채우기");

    private Task CopyRecordAsync() => CopyAsync("record", "기록");

    /// <summary>
    /// ProjectView 콘솔에서 돌릴 스크립트를 클립보드에 담는다.
    /// </summary>
    /// <remarks>
    /// 원본 생성기를 그대로 부른다(<c>wwwroot/js/pv-console.js</c>).
    /// 그 안의 fetch 는 전부 상대 주소라 <b>ProjectView 탭 안에서만</b> 뜻이 있다.
    /// </remarks>
    private async Task CopyAsync(string kind, string label)
    {
        var codes = Filtered.Select(t => t.ActivityId).Where(c => c is not null).Distinct().ToArray();

        await RunAsync(async () =>
        {
            var module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/JSini.Web.ProjMng/js/pv-console.js");

            await using (module)
            {
                var text = await module.InvokeAsync<string>("build", kind, new { codes });
                await module.InvokeAsync<bool>("copy", text);
            }
        }, $"{label} 스크립트를 클립보드에 담았습니다. ProjectView 탭의 콘솔에 붙여넣으십시오.",
           $"{label} 스크립트를 만들지 못했습니다");
    }
}
