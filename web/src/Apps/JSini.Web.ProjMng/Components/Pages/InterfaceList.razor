@page "/projmng/wbs/interfaces"
@attribute [RouteKey("projmng.wbs.interfaces")]

@*
    [인터페이스 관리]

    이력: 사내망 WBS 대시보드(Vue) `views/Interfaces.vue`(778줄) → **여기**
    API: `projmng/interfaces` 와 그 아래 (단계 · 메모 · 관리항목 · 첨부)

    EAI 인터페이스 카탈로그다. 표 일곱과 뷰 넷을 쓰는데, **조회는 뷰가 하고
    편집만 원본 표로 간다** — 뷰가 코드값을 이름으로 풀고 단계·메모 건수까지
    세어 주므로 목록이 조인을 다시 짜지 않는다.

    [상세를 탭으로 나누지 않았다]

    `DxTabs` 안에 표를 넣으면 탭의 상자 둘이 안쪽보다 작아지지 않아 아래
    단추가 화면 밖으로 밀려난다(web/CLAUDE.md). 단계·메모가 둘 다 표라
    그 함정에 정확히 걸리는 모양이어서, 창 안에 **세로로 쌓고** 창 본문만
    구르게 두었다.

    [선택목록이 비면 표만 있고 화면이 안 돈다]

    방향·상태·주기·단계유형이 전부 `if_code` 에서 온다. 표를 만들면서 그
    자료(43건)를 안 넣으면 드롭다운이 통째로 빈다 —
    `deploy/sql/projmng-wbs-2026-09-23.sql` 이 함께 넣는다.
*@

@inherits DataPage
@inject InterfaceClient Api

<PageTitle>인터페이스 관리 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="상태">
            <DxComboBox Data="@_statusOptions" @bind-Value="_status"
                        TextFieldName="Text" ValueFieldName="Value"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Style="width: 150px" />
        </CommSchItem>

        <CommSchItem Label="사용">
            <DxComboBox Data="@UseOptions" @bind-Value="_useYn"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 120px" />
        </CommSchItem>

        <CommSchItem Label="검색어">
            <DxTextBox @bind-Text="_q" Style="width: 220px" />
        </CommSchItem>
    </Fields>
</CommSch>

<CommCont Hint="@Hint">
    <CommGrd TItem="IfMasterDto"
             Data="@_rows"
             ExportName="인터페이스"
             EmptyText="인터페이스가 없습니다."
             PageSize="25"
             RowActions="@RowActions"
             ActionsWidth="80"
             Reload="@SearchAsync"
             OnDelete="@DeleteAsync"
             DeleteConfirm="@(m => $"「{m.IfCd} {m.IfNm}」 을(를) 지웁니다.\n처리 단계와 메모도 함께 지워집니다.\n되돌릴 수 없습니다.")">
        <FooterLeft>
            <PermissionView Action="MenuAction.Create">
                <DxButton Text="인터페이스 등록"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@OpenNewAsync" />
            </PermissionView>
        </FooterLeft>

        <Columns>
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.IfCd)" Caption="코드" Width="130" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.IfNm)" Caption="이름" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.DirectionNm)" Caption="방향" Width="80" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.SrcSystemNm)" Caption="송신" Width="140" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.TgtSystemNm)" Caption="수신" Width="140" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.StatusNm)" Caption="상태" Width="80" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.CycleNm)" Caption="주기" Width="90" />

            <DxGridDataColumn Caption="단계" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (IfMasterDto)cell.DataItem;
                    }
                    @(m.StepCnt == 0 ? "—" : m.StepCnt.ToString())
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="이슈" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (IfMasterDto)cell.DataItem;
                    }
                    @if (m.OpenIssueCnt > 0)
                    {
                        <span class="jsini-badge jsini-badge--warn" title="아직 안 끝난 이슈">@m.OpenIssueCnt</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="첨부" Width="70">
                <CellDisplayTemplate Context="cell">
                    @{
                        var m = (IfMasterDto)cell.DataItem;
                    }
                    @(m.FileCnt == 0 ? "" : m.FileCnt.ToString())
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(IfMasterDto.Flow)" Caption="흐름" MinWidth="280"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(IfMasterDto.OwnerNm)" Caption="담당" Width="100" />
        </Columns>
    </CommGrd>
</CommCont>

<CommPopup @bind-Visible="_detailOpen" HeaderText="@DetailTitle" Width="960px">
    @* `CommPopup` 은 `ChildContent` 를 안 받는다(WbsRowList 주석). *@
    <BodyContentTemplate Context="popup">
        @if (_master is not null)
        {
            <DxFormLayout CssClass="pm-editform">
                <DxFormLayoutItem Caption="코드" ColSpanMd="4">
                    <DxTextBox @bind-Text="_master.IfCd" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="이름" ColSpanMd="8">
                    <DxTextBox @bind-Text="_master.IfNm" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="방향" ColSpanMd="4">
                    <DxComboBox Data="@_directionOptions" @bind-Value="_master.DirectionCd"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="상태" ColSpanMd="4">
                    <DxComboBox Data="@_statusOptions" @bind-Value="_master.StatusCd"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="주기" ColSpanMd="4">
                    <DxComboBox Data="@_cycleOptions" @bind-Value="_master.CycleCd"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="송신 시스템" ColSpanMd="6">
                    <DxComboBox Data="@_systemOptions" @bind-Value="_master.SrcSystemId"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="수신 시스템" ColSpanMd="6">
                    <DxComboBox Data="@_systemOptions" @bind-Value="_master.TgtSystemId"
                                TextFieldName="Text" ValueFieldName="Value" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="업무 영역" ColSpanMd="4">
                    <DxTextBox @bind-Text="_master.DomainCd" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="담당자" ColSpanMd="4">
                    <DxTextBox @bind-Text="_master.OwnerNm" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="담당 사번" ColSpanMd="4">
                    <DxTextBox @bind-Text="_master.OwnerBpId" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                    <DxMemo @bind-Text="_master.IfDesc" Rows="2" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                    <DxMemo @bind-Text="_master.Remark" Rows="2" />
                </DxFormLayoutItem>
            </DxFormLayout>

            <div class="jsini-toolbar">
                <DxButton Text="기본정보 저장"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Click="@SaveMasterAsync" />
            </div>

            @if (_attrs.Count > 0)
            {
                <h4 class="pm-section">추가 관리항목</h4>

                <DxFormLayout CssClass="pm-editform">
                    @foreach (var attr in _attrs)
                    {
                        var key = attr.AttrDefId.ToString();

                        <DxFormLayoutItem Caption="@attr.AttrNm" ColSpanMd="6">
                            <DxTextBox Text="@GetAttr(key)" TextChanged="@(v => _attrEdits[key] = v)" />
                        </DxFormLayoutItem>
                    }
                </DxFormLayout>

                <div class="jsini-toolbar">
                    <DxButton Text="관리항목 저장"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              Click="@SaveAttrsAsync" />
                </div>
            }

            <h4 class="pm-section">처리 단계</h4>

            <CommGrd TItem="IfStepDto"
                     Data="@_steps"
                     EditFormTitle="처리 단계"
                     ExportName="처리 단계"
                     EmptyText="처리 단계가 없습니다."
                     PageSize="10"
                     OnSave="@SaveStepAsync"
                     OnDelete="@DeleteStepAsync"
                     DeleteConfirm="@(s => $"{s.StepNo}번 단계를 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadDetailAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.StepNo)" Caption="차례" Width="70" />
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.StepNm)" Caption="이름" MinWidth="160"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.StepTypeNm)" Caption="유형" Width="120" />
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.SystemNm)" Caption="시스템" Width="130" />
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.ObjectFullNm)" Caption="대상" MinWidth="180"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(IfStepDto.ObjectType)" Caption="종류" Width="100" />
                </Columns>

                <EditFormTemplate Context="edit">
                    @{
                        var s = (IfStepDto)edit.EditModel;
                    }
                    <DxFormLayout CssClass="pm-editform">
                        <DxFormLayoutItem Caption="차례" ColSpanMd="3">
                            <DxSpinEdit @bind-Value="s.StepNo" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="이름" ColSpanMd="9">
                            <DxTextBox @bind-Text="s.StepNm" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="유형" ColSpanMd="6">
                            <DxComboBox Data="@_stepTypeOptions" @bind-Value="s.StepTypeCd"
                                        TextFieldName="Text" ValueFieldName="Value" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="대상 종류" ColSpanMd="6">
                            <DxComboBox Data="@_objectTypeOptions" @bind-Value="s.ObjectType"
                                        TextFieldName="Text" ValueFieldName="Value" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="소유자" ColSpanMd="6">
                            <DxTextBox @bind-Text="s.ObjectOwner" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="대상 이름" ColSpanMd="6">
                            <DxTextBox @bind-Text="s.ObjectNm" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                            <DxMemo @bind-Text="s.StepDesc" Rows="3" />
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </CommGrd>

            <h4 class="pm-section">메모 · 이슈</h4>

            <CommGrd TItem="IfNoteDto"
                     Data="@_notes"
                     EditFormTitle="메모"
                     ExportName="메모"
                     EmptyText="메모가 없습니다."
                     PageSize="10"
                     OnNew="@FillNewNote"
                     OnSave="@SaveNoteAsync"
                     OnDelete="@DeleteNoteAsync"
                     DeleteConfirm="@(n => $"「{n.Title}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadDetailAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(IfNoteDto.NoteTypeNm)" Caption="갈래" Width="100" />
                    <DxGridDataColumn FieldName="@nameof(IfNoteDto.Title)" Caption="제목" MinWidth="180"
                                      TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(IfNoteDto.NoteDt)" Caption="날짜" Width="110" />
                    <DxGridDataColumn FieldName="@nameof(IfNoteDto.WriterNm)" Caption="적은이" Width="100" />

                    <DxGridDataColumn Caption="상태" Width="80">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var n = (IfNoteDto)cell.DataItem;
                            }
                            <span class="jsini-badge @(n.DoneYn == "Y" ? "jsini-badge--on" : "jsini-badge--off")">
                                @(n.DoneYn == "Y" ? "완료" : "열림")
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>

                <EditFormTemplate Context="edit">
                    @{
                        var n = (IfNoteDto)edit.EditModel;
                    }
                    <DxFormLayout CssClass="pm-editform">
                        <DxFormLayoutItem Caption="갈래" ColSpanMd="6">
                            <DxComboBox Data="@_noteTypeOptions" @bind-Value="n.NoteTypeCd"
                                        TextFieldName="Text" ValueFieldName="Value" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="적은이" ColSpanMd="6">
                            <DxTextBox @bind-Text="n.WriterNm" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="제목" ColSpanMd="12">
                            <DxTextBox @bind-Text="n.Title" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="내용" ColSpanMd="12">
                            <DxMemo @bind-Text="n.Content" Rows="4" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="완료" ColSpanMd="12">
                            <DxCheckBox @bind-Checked="n.Done">처리 끝남</DxCheckBox>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </CommGrd>

            <h4 class="pm-section">첨부</h4>

            <CommGrd TItem="IfFileDto"
                     Data="@_files"
                     ExportName="첨부"
                     EmptyText="첨부가 없습니다."
                     PageSize="10"
                     OnDelete="@DeleteFileAsync"
                     DeleteConfirm="@(f => $"「{f.Name}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                     Reload="@LoadFilesAsync">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(IfFileDto.Name)" Caption="이름" MinWidth="240"
                                      TextAlignment="GridTextAlignment.Left" />

                    <DxGridDataColumn Caption="크기" Width="110">
                        <CellDisplayTemplate Context="cell">
                            @{
                                var f = (IfFileDto)cell.DataItem;
                            }
                            @Size(f.Size)
                        </CellDisplayTemplate>
                    </DxGridDataColumn>

                    <DxGridDataColumn FieldName="@nameof(IfFileDto.Modified)" Caption="올린 때" Width="140" />
                </Columns>
            </CommGrd>

            <PageNotice Tone="NoticeTone.Info"
                        Text="첨부 올리기는 아직 옮기지 않았습니다. 지우기와 목록만 됩니다." />
        }
    </BodyContentTemplate>
</CommPopup>

@code {
    private string? _projectCode;
    private string? _status;
    private string? _useYn = "Y";
    private string? _q;

    private IReadOnlyList<IfMasterDto> _rows = [];

    private bool _detailOpen;
    private IfMasterDetailDto? _master;
    private IReadOnlyList<IfStepDto> _steps = [];
    private IReadOnlyList<IfNoteDto> _notes = [];
    private IReadOnlyList<IfAttrDto> _attrs = [];
    private IReadOnlyList<IfFileDto> _files = [];

    /// <summary>고친 관리항목. <b>고친 것만 보낸다</b> — 안 건드린 칸을 함께 보내면 덮인다.</summary>
    private readonly Dictionary<string, string?> _attrEdits = [];

    private object[] _statusOptions = [];
    private object[] _directionOptions = [];
    private object[] _cycleOptions = [];
    private object[] _stepTypeOptions = [];
    private object[] _objectTypeOptions = [];
    private object[] _noteTypeOptions = [];
    private object[] _systemOptions = [];

    private int? ProjectRid => int.TryParse(_projectCode, out var rid) ? rid : null;

    private string Hint =>
        $"{_rows.Count}건 · 이슈 {_rows.Sum(r => r.OpenIssueCnt)}건";

    private string DetailTitle =>
        _master is null ? "인터페이스"
        : _master.IfId == 0 ? "인터페이스 등록"
        : $"인터페이스 · {_master.IfCd} {_master.IfNm}";

    private static readonly object[] UseOptions =
    [
        new { Text = "사용", Value = "Y" },
        new { Text = "미사용", Value = "N" },
        new { Text = "전체", Value = (string?)null },
    ];

    // **`switch` 의 관계 패턴(`< 1024`)을 쓰면 안 된다.** 갈래 자리는 Razor 가
    // markup 이 시작될 수 있는 곳으로 보는데, 거기의 `<` 를 여는 태그로 읽고
    // 그 뒤의 `@code` 를 통째로 잘못 자른다. 그러면 이 파일의 오류가 173개로
    // 쏟아지고 **엉뚱한 줄을 가리킨다** — 실제로 밟았다.
    private static string Size(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";

        return $"{bytes / 1024.0 / 1024.0:0.#} MB";
    }

    private string? GetAttr(string key) =>
        _attrEdits.TryGetValue(key, out var v)
            ? v
            : _attrs.FirstOrDefault(a => a.AttrDefId.ToString() == key)?.AttrVal;

    private RenderFragment<IfMasterDto> RowActions => row => __builder =>
    {
        <DxButton Text="상세"
                  RenderStyle="ButtonRenderStyle.Link"
                  Click="@(() => OpenDetailAsync(row.IfId))" />
    };

    protected override Task OnInitializedAsync() => LoadCodesAsync();

    /// <summary>
    /// 선택목록을 한 번만 읽는다. 갈래가 여섯이라 창을 열 때마다 읽으면
    /// 왕복이 여섯씩 늘고, <b>바뀌지 않는 자료</b>다.
    /// </summary>
    private async Task LoadCodesAsync()
    {
        var codes = await Api.CodesAsync();

        object[] Group(string grp) =>
        [
            .. codes.Where(c => c.CodeGrp == grp)
                    .Select(c => new { Text = c.CodeNm, Value = c.Code })
        ];

        _statusOptions = Group("IF_STATUS");
        _directionOptions = Group("IF_DIRECTION");
        _cycleOptions = Group("IF_CYCLE");
        _stepTypeOptions = Group("STEP_TYPE");
        _objectTypeOptions = Group("OBJECT_TYPE");
        _noteTypeOptions = Group("NOTE_TYPE");
    }

    private Task SearchAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid)
        {
            _rows = [];
            return 0;
        }

        var rows = Api.ListAsync(rid, _status, null, _q, _useYn);
        var counts = Api.FileCountsAsync(rid);
        var systems = Api.SystemsAsync(rid);

        await Task.WhenAll(rows, counts, systems);

        _rows = rows.Result;

        var byId = counts.Result.ToDictionary(c => c.IfId, c => c.Cnt);

        foreach (var row in _rows)
        {
            if (byId.TryGetValue(row.IfId, out var cnt)) row.FileCnt = cnt;
        }

        _systemOptions =
        [
            new { Text = "(없음)", Value = (int?)null },
            .. systems.Result.Select(s => new { Text = s.SystemNm, Value = (int?)s.SystemId })
        ];

        return _rows.Count;
    }, "인터페이스가 없습니다.", "인터페이스를 읽지 못했습니다");

    // ──────────────────────────────────────────── 상세

    private async Task OpenNewAsync()
    {
        if (ProjectRid is null) return;

        _master = new IfMasterDetailDto { StatusCd = "DESIGN", UseYn = "Y" };
        _steps = [];
        _notes = [];
        _attrs = [];
        _files = [];
        _attrEdits.Clear();
        _detailOpen = true;

        await Task.CompletedTask;
    }

    private async Task OpenDetailAsync(int ifId)
    {
        _detailOpen = true;
        _ifId = ifId;
        _attrEdits.Clear();

        await LoadDetailAsync();
        await LoadFilesAsync();
    }

    private int _ifId;

    private Task LoadDetailAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid || _ifId == 0) return 0;

        var detail = await Api.DetailAsync(rid, _ifId);

        _master = detail?.Master;
        _steps = detail?.Steps ?? [];
        _notes = detail?.Notes ?? [];
        _attrs = detail?.Attrs ?? [];

        return 1;
    }, "상세를 찾지 못했습니다.", "상세를 읽지 못했습니다");

    private Task LoadFilesAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid || _ifId == 0)
        {
            _files = [];
            return 1;
        }

        _files = await Api.FilesAsync(rid, _ifId);
        return 1;
    }, "첨부가 없습니다.", "첨부를 읽지 못했습니다");

    private async Task SaveMasterAsync()
    {
        if (ProjectRid is not int rid || _master is null) return;

        var body = new Dictionary<string, object?>
        {
            ["if_cd"] = _master.IfCd,
            ["if_nm"] = _master.IfNm,
            ["if_desc"] = _master.IfDesc,
            ["direction_cd"] = _master.DirectionCd,
            ["src_system_id"] = _master.SrcSystemId,
            ["tgt_system_id"] = _master.TgtSystemId,
            ["domain_cd"] = _master.DomainCd,
            ["cycle_cd"] = _master.CycleCd,
            ["status_cd"] = _master.StatusCd,
            ["owner_nm"] = _master.OwnerNm,
            ["owner_bp_id"] = _master.OwnerBpId,
            ["remark"] = _master.Remark,
            ["use_yn"] = _master.UseYn ?? "Y",
        };

        var saved = _master.IfId == 0
            ? await RunAsync(() => Api.CreateAsync(rid, body), "등록했습니다.", "등록하지 못했습니다")
            : await RunAsync(() => Api.UpdateAsync(rid, _master.IfId, body), "저장했습니다.", "저장하지 못했습니다");

        if (!saved) return;

        _detailOpen = false;
        await SearchAsync();
    }

    private async Task DeleteAsync(IfMasterDto row)
    {
        if (ProjectRid is not int rid) return;

        await Api.DeleteAsync(rid, row.IfId);
    }

    // ──────────────────────────────────────────── 단계 · 메모 · 항목

    private async Task SaveStepAsync((IfStepDto Item, bool IsNew) e)
    {
        if (ProjectRid is not int rid || _ifId == 0) return;

        var body = new Dictionary<string, object?>
        {
            ["step_no"] = e.Item.StepNo,
            ["step_nm"] = e.Item.StepNm,
            ["step_type_cd"] = e.Item.StepTypeCd,
            ["object_owner"] = e.Item.ObjectOwner,
            ["object_nm"] = e.Item.ObjectNm,
            ["object_type"] = e.Item.ObjectType,
            ["step_desc"] = e.Item.StepDesc,
        };

        if (e.IsNew)
        {
            // 차례를 안 주면 서버가 맨 뒤에 붙인다. 새 줄에 0 이 들어가 있으면
            // 그 뜻이 「0번」이 되어 버리므로 빼고 보낸다.
            if (e.Item.StepNo == 0) body.Remove("step_no");

            await Api.CreateStepAsync(rid, _ifId, body);
        }
        else
        {
            await Api.UpdateStepAsync(rid, _ifId, e.Item.StepId, body);
        }
    }

    private async Task DeleteStepAsync(IfStepDto step)
    {
        if (ProjectRid is not int rid || _ifId == 0) return;

        await Api.DeleteStepAsync(rid, _ifId, step.StepId);
    }

    private void FillNewNote(IfNoteDto note)
    {
        note.NoteTypeCd = "MEMO";
        note.DoneYn = "N";
        note.NoteDt = DateTime.Today.ToString("yyyy-MM-dd");
    }

    private async Task SaveNoteAsync((IfNoteDto Item, bool IsNew) e)
    {
        if (ProjectRid is not int rid || _ifId == 0) return;

        var body = new Dictionary<string, object?>
        {
            ["note_type_cd"] = e.Item.NoteTypeCd,
            ["title"] = e.Item.Title,
            ["content"] = e.Item.Content,
            ["writer_nm"] = e.Item.WriterNm,
            ["note_dt"] = e.Item.NoteDt,
            ["done_yn"] = e.Item.DoneYn ?? "N",
        };

        if (e.IsNew)
        {
            await Api.CreateNoteAsync(rid, _ifId, body);
        }
        else
        {
            await Api.UpdateNoteAsync(rid, _ifId, e.Item.NoteId, body);
        }
    }

    private async Task DeleteNoteAsync(IfNoteDto note)
    {
        if (ProjectRid is not int rid || _ifId == 0) return;

        await Api.DeleteNoteAsync(rid, _ifId, note.NoteId);
    }

    private async Task SaveAttrsAsync()
    {
        if (ProjectRid is not int rid || _ifId == 0 || _attrEdits.Count == 0) return;

        var saved = await RunAsync(
            () => Api.SaveAttrsAsync(rid, _ifId, _attrEdits),
            "관리항목을 저장했습니다.", "관리항목을 저장하지 못했습니다");

        if (saved)
        {
            _attrEdits.Clear();
            await LoadDetailAsync();
        }
    }

    private async Task DeleteFileAsync(IfFileDto file)
    {
        if (ProjectRid is not int rid || _ifId == 0 || file.FileId is null) return;

        await Api.DeleteFileAsync(rid, _ifId, file.FileId);
    }
}
