@page "/projmng/wbs/interfaces"
@attribute [RouteKey("projmng.wbs.interfaces")]

@*
    [인터페이스 관리]

    이력: 사내망 WBS 대시보드(Vue) `views/Interfaces.vue`(778줄) → **여기**
          2026-09-23 에 원본과 다시 대조해 일곱 군데를 고쳤다(아래).
    API: `projmng/interfaces` 와 그 아래 (단계 · 메모 · 관리항목 · 첨부)

    EAI 인터페이스 카탈로그다. **코드값과 추가 관리항목은 DB 에서 읽어 그린다**
    — 방향·상태·주기·단계유형을 화면에 박아 두지 않는다. `if_code` 43건이
    비면 드롭다운이 통째로 빈다.

    ────────────────────────────────────────────────────────────
    [처음 옮길 때 어긋났던 것 일곱]

    1. **목록과 상세가 한 화면이다.** 상세를 창으로 띄웠었는데 원본은 모드를
       바꿔 전체를 쓴다. 상세에 다섯 구역(기본정보 · 관리항목 · 단계 · 메모 ·
       첨부)이 들어가서 창에 넣으면 아래가 늘 잘린다.
    2. **등록은 넷만 받는다**(코드 · 이름 · 방향 · 상태). 전체 폼을 빈 채로
       열면 무엇이 필수인지 알 수 없다. 만든 뒤 바로 상세로 들어간다.
    3. **단계 차례를 위아래로 옮긴다.** 서버에 재배치 통로를 만들어 두고도
       화면에서 안 쓰고 있었다.
    4. **`params` 는 JSON 이다.** 저장 전에 검사해 막는다 — 안 막으면 서버가
       `22P02` 로 끊고 그 문구는 사람에게 아무것도 말해 주지 않는다.
    5. **관리항목은 타입마다 입력이 다르다**(YN · CODE · DATE · NUMBER · JSON).
       전부 글자칸으로 두면 `Y`/`N` 을 손으로 적게 된다.
    6. **필수 관리항목이 비면 막는다.** `required_yn` 이 그 뜻인데 서버는
       강제하지 않는다 — 화면이 안 막으면 아무도 안 막는다.
    7. **메모 완료는 목록에서 바로 켠다.** 창을 열었다 닫는 값이 아니다.

    [삭제 문구를 그대로 옮겼다]

    「보관이 목적이라면 사용여부를 N 으로」 — 지우면 단계·메모·항목이 함께
    사라지는데, 실제로 필요한 것은 대개 감추기다.
*@

@inherits DataPage

<PageTitle>인터페이스 관리 · 프로젝트관리</PageTitle>

@if (_mode == "list")
{
    <CommSch OnSearch="@SearchAsync" MobileSummary="@ConditionSummary">
        <Fields>
            <CommSchItem Label="프로젝트">
                <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" OnChanged="@(_ => SearchAsync())" />
            </CommSchItem>

            <CommSchItem Label="상태">
                <DxComboBox Data="@_statusOptions" @bind-Value="_status"
                            TextFieldName="Text" ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            Style="width: 150px" />
            </CommSchItem>

            <CommSchItem Label="업무 영역">
                <DxComboBox Data="@_domainOptions" @bind-Value="_domain"
                            TextFieldName="Text" ValueFieldName="Value"
                            Style="width: 150px" />
            </CommSchItem>

            <CommSchItem Label="사용">
                <DxComboBox Data="@UseOptions" @bind-Value="_useYn"
                            TextFieldName="Text" ValueFieldName="Value" Style="width: 120px" />
            </CommSchItem>

            <CommSchItem Label="검색어">
                <DxTextBox @bind-Text="_q" Style="width: 220px" />
            </CommSchItem>
        </Fields>
    </CommSch>

    <CommCont Hint="@Hint">
        <CommGrd TItem="IfMasterDto"
                 Data="@_rows"
                 ExportName="인터페이스"
                 EmptyText="인터페이스가 없습니다."
                 PageSize="25"
                 RowActions="@RowActions"
                 ActionsWidth="80"
                 Reload="@SearchAsync">
            <ContextMenuItems>
                <PermissionView Action="MenuAction.Create">
                    <CommMenuItem Text="인터페이스 등록" IconCssClass="jsini-icon-plus"
                                     Enabled="@(ProjectRid is not null)"
                                     Click="@StartNew" />
                </PermissionView>
            </ContextMenuItems>

            <Columns>
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.IfCd)" Caption="코드" Width="130" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.IfNm)" Caption="이름" MinWidth="200"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.DirectionNm)" Caption="방향" Width="80" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.SrcSystemNm)" Caption="송신" Width="140" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.TgtSystemNm)" Caption="수신" Width="140" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.StatusNm)" Caption="상태" Width="80" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.CycleNm)" Caption="주기" Width="90" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.DomainCd)" Caption="영역" Width="100" />

                <DxGridDataColumn Caption="단계" Width="70">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var m = (IfMasterDto)cell.DataItem;
                        }
                        @(m.StepCnt == 0 ? "—" : m.StepCnt.ToString())
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="이슈" Width="70">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var m = (IfMasterDto)cell.DataItem;
                        }
                        @if (m.OpenIssueCnt > 0)
                        {
                            <span class="jsini-badge jsini-badge--warn" title="아직 안 끝난 이슈">@m.OpenIssueCnt</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn Caption="첨부" Width="70">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var m = (IfMasterDto)cell.DataItem;
                        }
                        @(m.FileCnt == 0 ? "" : m.FileCnt.ToString())
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(IfMasterDto.Flow)" Caption="흐름" MinWidth="280"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(IfMasterDto.UseYn)" Caption="사용" Width="70" />
            </Columns>
        </CommGrd>
    </CommCont>
}
else if (_master is not null)
{
    <div class="jsini-toolbar">
        <DxButton Text="← 목록"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@BackToListAsync" />

        <span class="pm-detail-title">@_master.IfCd · @_master.IfNm</span>
    </div>

    <CommCont Title="기본정보" Hint="@($"고친 때 {_master.UpdatedAt} · {_master.UpdatedBy}")">
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="코드" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.IfCd" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="이름" ColSpanMd="8">
                <DxTextBox @bind-Text="_master.IfNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="방향" ColSpanMd="4">
                <DxComboBox Data="@_directionOptions" @bind-Value="_master.DirectionCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="상태" ColSpanMd="4">
                <DxComboBox Data="@_statusOptions" @bind-Value="_master.StatusCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="주기" ColSpanMd="4">
                <DxComboBox Data="@_cycleOptions" @bind-Value="_master.CycleCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="송신 시스템" ColSpanMd="6">
                <DxComboBox Data="@_systemOptions" @bind-Value="_master.SrcSystemId"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="수신 시스템" ColSpanMd="6">
                <DxComboBox Data="@_systemOptions" @bind-Value="_master.TgtSystemId"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="업무 영역" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.DomainCd" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="계기" ColSpanMd="4">
                <DxComboBox Data="@_triggerOptions" @bind-Value="_master.TriggerCd"
                            TextFieldName="Text" ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="사용" ColSpanMd="4">
                <DxComboBox Data="@UseYnOptions" @bind-Value="_master.UseYn"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="담당자" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.OwnerNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="담당 사번" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.OwnerBpId" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="차례" ColSpanMd="4">
                <DxSpinEdit @bind-Value="_master.SortOrder" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="계획시작" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.PlanSdt" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="계획종료" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.PlanEdt" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="오픈일" ColSpanMd="4">
                <DxTextBox @bind-Text="_master.OpenDt" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="_master.IfDesc" Rows="2" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="비고" ColSpanMd="12">
                <DxMemo @bind-Text="_master.Remark" Rows="2" />
            </DxFormLayoutItem>
        </DxFormLayout>

        <div class="jsini-toolbar">
            <PermissionView Action="MenuAction.Update">
                <DxButton Text="기본정보 저장"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Click="@SaveMasterAsync" />
            </PermissionView>

            <PermissionView Action="MenuAction.Delete">
                <DxButton Text="이 인터페이스 지우기"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@DeleteMasterAsync" />
            </PermissionView>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flow))
        {
            <div class="jsini-hint">흐름 : @_flow</div>
        }
    </CommCont>

    <CommCont Title="추가 관리항목">
        @if (_attrs.Count == 0)
        {
            <PageNotice Tone="NoticeTone.Info"
                        Text="정의된 추가 항목이 없습니다. 프로젝트마다 다르게 두는 값이라 비어 있는 것이 정상입니다." />
        }
        else
        {
            <DxFormLayout CssClass="pm-editform">
                @foreach (var attr in _attrs)
                {
                    <DxFormLayoutItem Caption="@attr.Caption" ColSpanMd="6">
                        @if (attr.AttrType == "YN")
                        {
                            <DxCheckBox @bind-Checked="attr.Flag">예</DxCheckBox>
                        }
                        else if (attr.AttrType == "CODE")
                        {
                            <DxComboBox Data="@CodeOptions(attr.CodeGrp)" @bind-Value="attr.Value"
                                        TextFieldName="Text" ValueFieldName="Value"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        }
                        else if (attr.AttrType == "JSON")
                        {
                            <DxMemo @bind-Text="attr.Value" Rows="3" CssClass="pm-paste" />
                        }
                        else
                        {
                            <DxTextBox @bind-Text="attr.Value" />
                        }

                        <div class="jsini-hint">@attr.AttrCd · @attr.AttrType</div>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>

            <div class="jsini-toolbar">
                <PermissionView Action="MenuAction.Update">
                    <DxButton Text="관리항목 저장"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              Click="@SaveAttrsAsync" />
                </PermissionView>
            </div>
        }
    </CommCont>

    <CommCont Title="처리 단계" Hint="차례는 위아래 단추로 바꿉니다.">
        <CommGrd TItem="IfStepDto"
                 Data="@_steps"
                 ExportName="처리 단계"
                 EmptyText="처리 단계가 없습니다."
                 PageSize="10"
                 RowActions="@StepActions"
                 ActionsWidth="170"
                 Reload="@LoadDetailAsync">
            <ContextMenuItems>
                <PermissionView Action="MenuAction.Create">
                    <CommMenuItem Text="단계 추가" IconCssClass="jsini-icon-plus" Click="@StartNewStep" />
                </PermissionView>
            </ContextMenuItems>

            <Columns>
                <DxGridDataColumn FieldName="@nameof(IfStepDto.StepNo)" Caption="차례" Width="70" />
                <DxGridDataColumn FieldName="@nameof(IfStepDto.StepNm)" Caption="이름" MinWidth="160"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(IfStepDto.StepTypeNm)" Caption="유형" Width="120" />
                <DxGridDataColumn FieldName="@nameof(IfStepDto.SystemNm)" Caption="시스템" Width="130" />
                <DxGridDataColumn FieldName="@nameof(IfStepDto.ObjectFullNm)" Caption="대상" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(IfStepDto.ObjectType)" Caption="종류" Width="100" />
            </Columns>
        </CommGrd>
    </CommCont>

    <CommCont Title="메모 · 이슈">
        <CommGrd TItem="IfNoteDto"
                 Data="@_notes"
                 ExportName="메모"
                 EmptyText="메모가 없습니다."
                 PageSize="10"
                 RowActions="@NoteActions"
                 ActionsWidth="180"
                 Reload="@LoadDetailAsync">
            <ContextMenuItems>
                <PermissionView Action="MenuAction.Create">
                    <CommMenuItem Text="메모 추가" IconCssClass="jsini-icon-plus" Click="@StartNewNote" />
                </PermissionView>
            </ContextMenuItems>

            <Columns>
                <DxGridDataColumn FieldName="@nameof(IfNoteDto.NoteTypeNm)" Caption="갈래" Width="100" />
                <DxGridDataColumn FieldName="@nameof(IfNoteDto.Title)" Caption="제목" MinWidth="180"
                                  TextAlignment="GridTextAlignment.Left" />
                <DxGridDataColumn FieldName="@nameof(IfNoteDto.StepNm)" Caption="붙은 단계" Width="130" />
                <DxGridDataColumn FieldName="@nameof(IfNoteDto.NoteDt)" Caption="날짜" Width="110" />
                <DxGridDataColumn FieldName="@nameof(IfNoteDto.WriterNm)" Caption="적은이" Width="100" />

                <DxGridDataColumn Caption="상태" Width="80">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var n = (IfNoteDto)cell.DataItem;
                        }
                        <span class="jsini-badge @(n.Done ? "jsini-badge--on" : "jsini-badge--off")">
                            @(n.Done ? "완료" : "열림")
                        </span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </CommGrd>
    </CommCont>

    <CommCont Title="첨부">
        <CommGrd TItem="IfFileDto"
                 Data="@_files"
                 ExportName="첨부"
                 EmptyText="첨부가 없습니다."
                 PageSize="10"
                 OnDelete="@DeleteFileAsync"
                 DeleteConfirm="@(f => $"「{f.Name}」 을(를) 지웁니다.\n되돌릴 수 없습니다.")"
                 Reload="@LoadFilesAsync">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(IfFileDto.Name)" Caption="이름" MinWidth="240"
                                  TextAlignment="GridTextAlignment.Left" />

                <DxGridDataColumn Caption="크기" Width="110">
                    <CellDisplayTemplate Context="cell">
                        @{
                            var f = (IfFileDto)cell.DataItem;
                        }
                        @Size(f.Size)
                    </CellDisplayTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(IfFileDto.Modified)" Caption="올린 때" Width="140" />
            </Columns>
        </CommGrd>

        <PermissionView Action="MenuAction.Create">
            <FilePicker @ref="_picker"
                        MaxFiles="20"
                        MaxBytes="@(25L * 1024 * 1024)"
                        Hint="첨부할 파일을 고르세요 (한 번에 20개 · 한 개 25MB). 고른 뒤 [올리기] 를 누릅니다."
                        FilesChanged="@(files => _picked = files)" />

            <div class="jsini-toolbar">
                <DxButton Text="올리기"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Enabled="@(_picked.Count > 0)"
                          Click="@UploadAsync" />
            </div>
        </PermissionView>
    </CommCont>
}

<CommPopup @bind-Visible="_newOpen" HeaderText="인터페이스 등록" Width="520px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="코드" ColSpanMd="12">
                <DxTextBox @bind-Text="_new.IfCd" />
                <div class="jsini-hint">프로젝트 안에서 하나여야 합니다.</div>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="이름" ColSpanMd="12">
                <DxTextBox @bind-Text="_new.IfNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="방향" ColSpanMd="6">
                <DxComboBox Data="@_directionOptions" @bind-Value="_new.DirectionCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="상태" ColSpanMd="6">
                <DxComboBox Data="@_statusOptions" @bind-Value="_new.StatusCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>
        </DxFormLayout>

        <PageNotice Tone="NoticeTone.Info" Text="나머지 칸은 만든 뒤 상세에서 채웁니다." />
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" Click="@CreateAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _newOpen = false)" />
    </FooterContentTemplate>
</CommPopup>

<CommPopup @bind-Visible="_stepOpen" HeaderText="처리 단계" Width="640px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="이름" ColSpanMd="12">
                <DxTextBox @bind-Text="_step.StepNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="유형" ColSpanMd="6">
                <DxComboBox Data="@_stepTypeOptions" @bind-Value="_step.StepTypeCd"
                            TextFieldName="Text" ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="시스템" ColSpanMd="6">
                <DxComboBox Data="@_systemOptions" @bind-Value="_stepSystemId"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="대상 소유자" ColSpanMd="6">
                <DxTextBox @bind-Text="_step.ObjectOwner" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="대상 이름" ColSpanMd="6">
                <DxTextBox @bind-Text="_step.ObjectNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="대상 종류" ColSpanMd="6">
                <DxComboBox Data="@_objectTypeOptions" @bind-Value="_step.ObjectType"
                            TextFieldName="Text" ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="설명" ColSpanMd="12">
                <DxMemo @bind-Text="_step.StepDesc" Rows="3" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="params" ColSpanMd="12">
                <DxMemo @bind-Text="_step.Params" Rows="3" CssClass="pm-paste" />
                <div class="jsini-hint">JSON 입니다. 비워 두면 빈 객체로 들어갑니다.</div>
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveStepAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _stepOpen = false)" />
    </FooterContentTemplate>
</CommPopup>

<CommPopup @bind-Visible="_noteOpen" HeaderText="메모 · 이슈" Width="640px">
    <BodyContentTemplate Context="popup">
        <DxFormLayout CssClass="pm-editform">
            <DxFormLayoutItem Caption="갈래" ColSpanMd="6">
                <DxComboBox Data="@_noteTypeOptions" @bind-Value="_note.NoteTypeCd"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="적은이" ColSpanMd="6">
                <DxTextBox @bind-Text="_note.WriterNm" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="붙일 단계" ColSpanMd="12">
                <DxComboBox Data="@StepOptions" @bind-Value="_noteStepId"
                            TextFieldName="Text" ValueFieldName="Value" />
                <div class="jsini-hint">비우면 인터페이스 전체에 붙습니다.</div>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="제목" ColSpanMd="12">
                <DxTextBox @bind-Text="_note.Title" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="내용" ColSpanMd="12">
                <DxMemo @bind-Text="_note.Content" Rows="5" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>

    <FooterContentTemplate Context="popup">
        <DxButton Text="저장" RenderStyle="ButtonRenderStyle.Primary" Click="@SaveNoteAsync" />
        <DxButton Text="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _noteOpen = false)" />
    </FooterContentTemplate>
</CommPopup>

<ConfirmDialog @ref="_confirm" />

@code {
    private RenderFragment<IfMasterDto> RowActions => row => __builder =>
    {
        <DxButton Text="상세"
                  RenderStyle="ButtonRenderStyle.Link"
                  Click="@(() => OpenDetailAsync(row.IfId))" />
    };

    /// <summary>
    /// 단계의 관리 칸 — 위·아래로 옮기기와 편집·삭제.
    /// </summary>
    /// <remarks>
    /// 차례를 바꾸는 길이 이것뿐이다. 서버는 통째로 다시 매기는 통로를 가지고
    /// 있고(<c>steps/reorder</c>), 여기서는 이웃과 자리를 바꿔 보낸다.
    /// </remarks>
    private RenderFragment<IfStepDto> StepActions => step => __builder =>
    {
        var index = IndexOfStep(step);

        <PermissionView Action="MenuAction.Update">
            <DxButton Text="↑" Title="위로"
                      RenderStyle="ButtonRenderStyle.Link"
                      Enabled="@(index > 0)"
                      Click="@(() => MoveStepAsync(index, -1))" />

            <DxButton Text="↓" Title="아래로"
                      RenderStyle="ButtonRenderStyle.Link"
                      Enabled="@(index >= 0 && index < _steps.Count - 1)"
                      Click="@(() => MoveStepAsync(index, 1))" />

            <DxButton Text="수정"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => EditStep(step))" />
        </PermissionView>

        <PermissionView Action="MenuAction.Delete">
            <DxButton Text="삭제"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => DeleteStepAsync(step))" />
        </PermissionView>
    };

    private RenderFragment<IfNoteDto> NoteActions => note => __builder =>
    {
        <PermissionView Action="MenuAction.Update">
            <DxButton Text="@(note.Done ? "되돌리기" : "완료")"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => ToggleNoteAsync(note))" />

            <DxButton Text="수정"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => EditNote(note))" />
        </PermissionView>

        <PermissionView Action="MenuAction.Delete">
            <DxButton Text="삭제"
                      RenderStyle="ButtonRenderStyle.Link"
                      Click="@(() => DeleteNoteAsync(note))" />
        </PermissionView>
    };
}
