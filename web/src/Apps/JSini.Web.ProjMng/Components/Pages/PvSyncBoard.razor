@page "/projmng/wbs/pv-sync"
@attribute [RouteKey("projmng.wbs.pv-sync")]

@*
    [ProjectView 동기화]

    이력: 사내망 WBS 대시보드(Vue) `views/PvSync.vue`(670줄) +
          `components/PvCollectDialog.vue` → **여기**
    API: `projmng/pv/cache` · `…/ingest` · `…/sync/preview` · `…/sync/apply`
    스크립트: `wwwroot/js/pv-script-core.js`(원본 1,592줄 그대로)

    [왜 붙여넣는가]

    ProjectView 는 사내망 안에 있고 로그인 쿠키가 HttpOnly 다. 서버도 이 화면도
    직접 부를 수 없다. ProjectView 탭의 콘솔에서 스크립트를 돌리면 그 쿠키가
    저절로 붙는다 — 걷은 결과를 여기 붙여넣으면 서버가 캐시에 담는다.

    [원본의 엑셀 경로는 옮기지 않았다]

    사내 대시보드는 ProjectView 의 Excel Export 파일을 읽는 길도 가지고 있었다.
    그 엑셀이 **HHI DRM 으로 잠겨 있어** 프로그램이 직접 못 열고, 원본은
    Windows 의 Excel COM(`tools/export2csv.ps1`)으로 CSV 를 만든 뒤
    `%USERPROFILE%\Downloads` 를 뒤졌다. 포털은 리눅스 컨테이너에서 돌고
    브라우저의 내려받기 폴더 같은 것이 없어 **성립하지 않는 길**이다.

    걷어 온 JSON 으로 가는 길은 그대로라, 화면에서 달라지는 것은
    「파일로 읽기」 단추가 없다는 것뿐이다.

    [반영은 두 걸음이다]

    무엇이 바뀌는지 먼저 보이고(미리보기 — DB 를 안 건드린다) 그다음에 넣는다.
    날짜의 기준이 ProjectView 쪽이라 **저쪽이 비면 이쪽도 비우는 것이 기본**이다.
*@

@inherits DataPage
@inject PvClient Api
@inject IJSRuntime Js

<PageTitle>ProjectView 동기화 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@SearchAsync">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
        </CommSchItem>

        <CommSchItem Label="범위">
            <DxComboBox Data="@WbsBoardOptions.Scope" @bind-Value="_scope"
                        TextFieldName="Text" ValueFieldName="Value" Style="width: 130px" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton Text="수집 스크립트 복사"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@CopyCollectAsync" />

        <DxButton Text="캐시 비우기"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@ClearAsync" />
    </Actions>
</CommSch>

@if (_status is not null)
{
    <div class="jsini-stats">
        <div class="jsini-stat">
            <div class="jsini-stat__label">수집 대상</div>
            <div class="jsini-stat__value">@(_status.Works?.Targets ?? 0)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">신원 확보</div>
            <div class="jsini-stat__value">@(_status.Works?.Identified ?? 0)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">현재값 보유</div>
            <div class="jsini-stat__value">@(_status.Works?.Snapshot ?? 0)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">일감</div>
            <div class="jsini-stat__value">@(_status.Tasks?.Tasks ?? 0)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">빈 단계</div>
            <div class="jsini-stat__value">@(_status.Tasks?.NodesEmpty ?? 0)</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">떠도는 건</div>
            <div class="jsini-stat__value">@_status.Orphan</div>
        </div>
        <div class="jsini-stat">
            <div class="jsini-stat__label">마지막 수집</div>
            <div class="jsini-stat__value pm-stat--dates">@(_status.Works?.LastSeen ?? "—")</div>
        </div>
    </div>

    @if (_status.Orphan > 0)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="@($"캐시에만 있고 원장에 없는 건이 {_status.Orphan}건입니다. 프로젝트에서 빠졌거나 액티비티 번호가 바뀐 것입니다 — 지우지 않고 세기만 합니다.")" />
    }
}

<CommCont Title="걷어 온 자료 담기">
    <div class="jsini-hint">
        ProjectView 탭의 콘솔에서 위의 「수집 스크립트 복사」로 받은 글자를 돌린 뒤,
        찍혀 나온 JSON 을 아래에 붙여넣습니다.
    </div>

    <DxMemo @bind-Text="_ingestText" Rows="8" CssClass="pm-paste" />

    <div class="jsini-toolbar">
        <DxButton Text="담기"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(!string.IsNullOrWhiteSpace(_ingestText))"
                  Click="@IngestAsync" />
    </div>

    @if (_ingested is not null)
    {
        <PageNotice Tone="NoticeTone.Info" Text="@IngestSummary" />
    }
</CommCont>

<CommCont Title="원장 반영" Hint="@PreviewHint">
    <div class="jsini-toolbar">
        <DxCheckBox @bind-Checked="_clearEmpty">ProjectView 가 비었으면 원장도 비운다</DxCheckBox>

        <DxButton Text="미리보기"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(_items.Count > 0)"
                  Click="@PreviewAsync" />

        <DxButton Text="반영"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(_preview is { Changed: > 0 })"
                  Click="@ApplyAsync" />
    </div>

    @if (_items.Count == 0)
    {
        <PageNotice Tone="NoticeTone.Info"
                    Text="위에서 자료를 담으면 그 값으로 원장과 견줍니다." />
    }

    <CommGrd TItem="PvSyncDiffRowDto"
             Data="@(_preview?.Rows ?? [])"
             ExportName="반영 미리보기"
             EmptyText="바뀌는 것이 없습니다."
             PageSize="20"
             Reload="@PreviewAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PvSyncDiffRowDto.ActivityId)" Caption="액티비티" Width="130" />
            <DxGridDataColumn FieldName="@nameof(PvSyncDiffRowDto.Systemcode)" Caption="모듈" Width="100" />
            <DxGridDataColumn FieldName="@nameof(PvSyncDiffRowDto.MenuNm)" Caption="화면" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(PvSyncDiffRowDto.Summary)" Caption="바뀌는 것" MinWidth="320"
                              TextAlignment="GridTextAlignment.Left" />
        </Columns>
    </CommGrd>
</CommCont>

<CommCont Title="액티비티별 캐시">
    <CommGrd TItem="PvRowDto"
             Data="@_rows"
             ExportName="ProjectView 캐시"
             EmptyText="캐시가 비어 있습니다."
             PageSize="30"
             Reload="@SearchAsync">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(PvRowDto.ActivityId)" Caption="액티비티" Width="130" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.MenuNm)" Caption="화면" MinWidth="200"
                              TextAlignment="GridTextAlignment.Left" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PvWorkId)" Caption="PV 번호" Width="150" />

            <DxGridDataColumn Caption="PV 진척" Width="90">
                <CellDisplayTemplate Context="cell">
                    @{
                        var r = (PvRowDto)cell.DataItem;
                    }
                    @(r.PvFinishRate is null ? "—" : $"{r.PvFinishRate:0.#}%")
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="@nameof(PvRowDto.PlanSdt)" Caption="원장 시작" Width="105" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PvPlanSdt)" Caption="PV 시작" Width="105" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PlanEdt)" Caption="원장 종료" Width="105" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PvPlanEdt)" Caption="PV 종료" Width="105" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PvStatus)" Caption="현재단계" Width="110" />
            <DxGridDataColumn FieldName="@nameof(PvRowDto.PvSnapshotAt)" Caption="담은 때" Width="170" />
        </Columns>
    </CommGrd>
</CommCont>

@code {
    private string? _projectCode;
    private string _scope = "dev";

    private PvCacheStatusDto? _status;
    private IReadOnlyList<PvRowDto> _rows = [];

    private string? _ingestText;
    private PvIngestResultDto? _ingested;

    /// <summary>붙여넣은 자료에서 뽑아 둔 항목. 미리보기와 반영이 이것을 쓴다.</summary>
    private List<PvSyncItemDto> _items = [];

    private bool _clearEmpty = true;
    private PvSyncPreviewDto? _preview;

    private int? ProjectRid => int.TryParse(_projectCode, out var rid) ? rid : null;

    private string IngestSummary =>
        _ingested is null ? ""
        : $"원장 {_ingested.Works}건 · 일감 {_ingested.Tasks}건 · 단계 {_ingested.Nodes}건을 담았습니다."
          + (_ingested.SkippedNoCode > 0 ? $" 번호 없는 {_ingested.SkippedNoCode}건은 건너뛰었습니다." : "")
          + (_ingested.Duplicated > 0 ? $" 겹친 {_ingested.Duplicated}건은 첫 것만 담았습니다." : "")
          + (_ingested.UnknownCount > 0 ? $" 원장에 없는 번호가 {_ingested.UnknownCount}건 있습니다." : "");

    private string PreviewHint =>
        _preview is null ? ""
        : $"읽음 {_preview.Read} · 맞춤 {_preview.Matched} · 바뀜 {_preview.Changed} · 그대로 {_preview.Same}"
          + (_preview.UnknownCount > 0 ? $" · 모르는 번호 {_preview.UnknownCount}" : "")
          + (_preview.MissingCount > 0 ? $" · 안 온 건 {_preview.MissingCount}" : "");

    private Task SearchAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid)
        {
            _status = null;
            _rows = [];
            return 0;
        }

        var status = Api.StatusAsync(rid, _scope);
        var rows = Api.RowsAsync(rid, _scope);

        await Task.WhenAll(status, rows);

        _status = status.Result;
        _rows = rows.Result;

        return _rows.Count;
    }, "캐시가 비어 있습니다.", "캐시 현황을 읽지 못했습니다");

    /// <summary>
    /// ProjectView 콘솔에서 돌릴 스크립트를 클립보드에 담는다.
    /// </summary>
    /// <remarks>
    /// 원본 생성기를 그대로 부른다(<c>wwwroot/js/pv-console.js</c>). 그 안의
    /// fetch 는 전부 상대 주소라 <b>ProjectView 탭 안에서만</b> 뜻이 있다.
    /// </remarks>
    private async Task CopyCollectAsync()
    {
        var codes = _rows.Select(r => r.ActivityId).Where(c => c is not null).ToArray();

        var copied = await RunAsync(async () =>
        {
            var module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/JSini.Web.ProjMng/js/pv-console.js");

            await using (module)
            {
                var text = await module.InvokeAsync<string>("build", "collect", new { codes });
                await module.InvokeAsync<bool>("copy", text);
            }
        }, "수집 스크립트를 클립보드에 담았습니다. ProjectView 탭의 콘솔에 붙여넣으십시오.",
           "스크립트를 만들지 못했습니다");

        _ = copied;
    }

    private async Task IngestAsync()
    {
        if (ProjectRid is not int rid || string.IsNullOrWhiteSpace(_ingestText)) return;

        System.Text.Json.JsonElement body;

        try
        {
            body = System.Text.Json.JsonDocument.Parse(_ingestText).RootElement.Clone();
        }
        catch (System.Text.Json.JsonException e)
        {
            // 붙여넣기가 잘린 것이 가장 잦다. 서버까지 보내면 500 으로 돌아와
            // 「서버가 이상하다」로 읽힌다.
            Say($"붙여넣은 글자가 JSON 이 아닙니다: {e.Message}", NoticeTone.Warning);
            return;
        }

        var done = await RunAsync(
            async () => _ingested = await Api.IngestAsync(rid, body),
            "담았습니다.", "담지 못했습니다");

        if (!done) return;

        _items = Extract(body);
        _preview = null;

        await SearchAsync();
    }

    /// <summary>
    /// 담은 자료에서 <b>원장에 반영할 값</b>만 뽑는다. 캐시에 담는 것과
    /// 원장을 고치는 것은 다른 일이라 걸음을 나눈다.
    /// </summary>
    private static List<PvSyncItemDto> Extract(System.Text.Json.JsonElement body)
    {
        var items = new List<PvSyncItemDto>();

        if (!body.TryGetProperty("works", out var works)
            || works.ValueKind != System.Text.Json.JsonValueKind.Array)
        {
            return items;
        }

        foreach (var w in works.EnumerateArray())
        {
            string? Str(string name) =>
                w.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String
                    ? v.GetString()
                    : null;

            var code = Str("code");
            if (string.IsNullOrWhiteSpace(code)) continue;

            items.Add(new PvSyncItemDto
            {
                Code = code,
                PlanStartDate = Str("planStartDate"),
                PlanEndDate = Str("planEndDate"),
                ActualStartDate = Str("actualStartDate"),
                ActualEndDate = Str("actualEndDate"),
            });
        }

        return items;
    }

    private Task PreviewAsync() => LoadAsync(async () =>
    {
        if (ProjectRid is not int rid || _items.Count == 0)
        {
            _preview = null;
            return 0;
        }

        _preview = await Api.PreviewAsync(rid, new PvSyncRequestDto
        {
            Items = _items,
            ClearEmpty = _clearEmpty,
        });

        return _preview?.Changed ?? 0;
    }, "바뀌는 것이 없습니다.", "미리보기를 만들지 못했습니다");

    private async Task ApplyAsync()
    {
        if (ProjectRid is not int rid || _items.Count == 0) return;

        PvSyncAppliedDto? applied = null;

        var done = await RunAsync(
            async () => applied = await Api.ApplyAsync(rid, new PvSyncRequestDto
            {
                Items = _items,
                ClearEmpty = _clearEmpty,
            }),
            "원장에 반영했습니다.", "반영하지 못했습니다");

        if (!done) return;

        Say($"{applied?.Applied ?? 0}건을 고쳤습니다.");

        _preview = null;
        await SearchAsync();
    }

    private async Task ClearAsync()
    {
        if (ProjectRid is not int rid) return;

        var done = await RunAsync(
            () => Api.ClearAsync(rid),
            "캐시를 비웠습니다. 대시보드는 그대로 돌아갑니다.", "캐시를 비우지 못했습니다");

        if (done) await SearchAsync();
    }
}
