@page "/projmng/design/table-lineage"
@attribute [RouteKey("projmng.design.table-lineage")]

@*
테이블 계통도. 고른 DB 접속(= DB 하나 · 스키마 하나)의 표들이 어떤 순서로 자료를 주고받는지 칸과 선으로 그리고 고친다.
도면은 그 접속의 DB 속성(dev_db_prop · table_lineage)에 담기고, 업무항목은 옆 줄(table_lineage_items)에 따로 담긴다.
대상 DB 에는 객체 목록(objectlist — 표·뷰·프로시저·함수)만 묻는다 — 못 붙어도(폐쇄망 DB) 저장된 도면은 그대로 열린다. 캔버스는 wwwroot/js/table-lineage.js.
*@

@inherits DataPage
@implements IAsyncDisposable

<PageTitle>테이블 계통도 · 프로젝트관리</PageTitle>

<CommSch OnSearch="@LoadDiagramAsync" SearchText="불러오기" Busy="@Loading" MobileSummary="@ConditionSummary">
    <Fields>
        <CommSchItem Label="프로젝트">
            <CodeSelect CodeId="projlist" @bind-Value="_projectCode" @bind-Text="_projectName" />
        </CommSchItem>

        <CommSchItem Label="DB">
            <CodeSelect CodeId="projdb" CodeKey="@(_projectCode ?? string.Empty)" @bind-Value="_dbCode"
                        EtcFix="true" OnChanged="@(item => _dbItem = item)" />
        </CommSchItem>
    </Fields>

    <Actions>
        <DxButton IconCssClass="jsini-icon-subtract" Title="축소" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => CallAsync("zoomOut"))" />
        <DxButton IconCssClass="jsini-icon-plus" Title="확대" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => CallAsync("zoomIn"))" />
        <DxButton IconCssClass="jsini-icon-expand" Title="전체 보기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => CallAsync("fit"))" />
        <DxCheckBox Checked="@_mapOn" CheckedChanged="@((bool on) => ToggleMapAsync(on))">미니맵</DxCheckBox>

        <PermissionView Action="MenuAction.Update">
            <DxButton IconCssClass="jsini-icon-child-plus" Title="객체 놓기" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(_loaded is not null)" Click="@OpenPickerAsync" />

            <DxButton IconCssClass="jsini-icon-link" Title="@(_linking ? "잇는 중 — 누르면 멈춥니다" : "잇기")"
                      RenderStyle="@(_linking ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                      Enabled="@(_loaded is not null)" Click="@ToggleLinkAsync" />
            <DxComboBox Data="@LineageGraph.EdgeKinds" Value="@NewKind"
                        ValueChanged="@((LineageKind? k) => SetNewKindAsync(k))"
                        TextFieldName="@nameof(LineageKind.Text)" ValidationEnabled="false"
                        CssClass="tl-kindpick" />

            <DxButton IconCssClass="jsini-icon-trash" Title="선택 지우기" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(_selNode is not null || _selEdge is not null)" Click="@RemoveSelectionAsync" />

            <DxButton IconCssClass="jsini-icon-arrange" Title="보기 좋게 펼치기 — 보이는 표를 선 방향대로 단을 나눠 다시 놓습니다"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@((_summary?.Nodes ?? 0) > 1)" Click="@ArrangeAsync" />
            @if (_canUndoArrange)
            {
                <DxButton IconCssClass="jsini-icon-undo" Title="펼치기 전 배치로" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@UndoArrangeAsync" />
            }

            @if (_seed is not null)
            {
                @* 두 번 눌러야 버린다 — 무장된 동안만 글자를 붙여 다음 누름이 무엇인지 보인다. *@
                <DxButton IconCssClass="jsini-icon-undo" Text="@(_resetArmed ? "한 번 더" : null)"
                          Title="@(_resetArmed ? "한 번 더 누르면 지금 배치를 버립니다" : "기본 배치로")"
                          RenderStyle="@(_resetArmed ? ButtonRenderStyle.Danger : ButtonRenderStyle.Secondary)"
                          Click="@ResetToSeedAsync" />
            }

            <DxButton IconCssClass="jsini-icon-check" Text="@(Dirty ? "•" : null)"
                      Title="@(Dirty ? "저장 — 저장 안 한 변경이 있습니다" : "저장")" RenderStyle="ButtonRenderStyle.Success"
                      CssClass="@(Dirty ? "pm-save--dirty" : null)"
                      Enabled="@(_loaded is not null && !Loading)" Click="@SaveAsync" />
        </PermissionView>
    </Actions>
</CommSch>

@if (_loaded is not null && _dbNotice is not null)
{
    <PageNotice Tone="NoticeTone.Warning" Text="@_dbNotice" />
}

<div class="pm-palette tl-bar">
    <span class="tl-bar__find" @onkeydown="@OnFindKeyAsync">
        <DxTextBox Text="@_q" TextChanged="@((string t) => SetQueryAsync(t))"
                   BindValueMode="BindValueMode.OnInput" InputDelay="250"
                   NullText="표 찾기 — 이름·설명"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
    </span>
    @if (Found.Count > 0)
    {
        <span class="tl-bar__hits">@Found.Count 개</span>
        <DxButton IconCssClass="jsini-icon-search" Title="찾아가기 — 누를 때마다 다음 표로" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@GoFoundAsync" />
    }

    <span class="pm-palette__label">선 보기</span>
    @foreach (var k in LineageGraph.EdgeKinds)
    {
        var on = _kinds.Contains(k.Value);
        var count = _summary?.EdgeCounts.GetValueOrDefault(k.Value) ?? 0;
        <button type="button" class="tl-chip @(on ? "is-on" : null)" disabled="@(count == 0)"
                title="@($"'{k.Text}' 선 {count}개")" @onclick="@(() => ToggleKindAsync(k.Value))">
            <i style="background:@k.Color"></i>@k.Text <small>@count</small>
        </button>
    }
    @{ var allOff = _kinds.Count < LineageGraph.EdgeKinds.Count; }
    <button type="button" class="tl-chip tl-chip--icon" title="@(allOff ? "선 모두 켜기" : "선 모두 끄기")"
            @onclick="@(() => SetAllKindsAsync(allOff))">
        <span class="@(allOff ? "jsini-icon-eye" : "jsini-icon-eye-off")" aria-hidden="true"></span>
    </button>
    <DxCheckBox Checked="@_onlyLinked" Enabled="@(_kinds.Count > 0)"
                CheckedChanged="@((bool on) => SetOnlyLinkedAsync(on))">선 있는 칸만</DxCheckBox>
    <DxCheckBox Checked="@_hover" CheckedChanged="@((bool on) => SetHoverAsync(on))">올려놓아 보기</DxCheckBox>

    @if (_summary?.Flows.Count > 0)
    {
        <span class="pm-palette__label">흐름</span>
        @foreach (var f in _summary.Flows)
        {
            <button type="button" class="tl-chip @(_flows.Contains(f.Id) ? "is-on" : null)"
                    title="@($"{f.Name} — 표 {f.Count}개")" @onclick="@(() => ToggleFlowAsync(f.Id))">
                @f.Name
            </button>
        }
    }

    @if (_lane is { } lane)
    {
        <button type="button" class="tl-chip is-on" title="단계 거르기를 풉니다" @onclick="@(() => SetLaneAsync(null))">
            단계 @LaneName(lane) ✕
        </button>
    }

    @if (HasFilter)
    {
        <DxButton IconCssClass="jsini-icon-filter-off" Title="거르기 풀기" RenderStyle="ButtonRenderStyle.Link"
                  Click="@ClearFiltersAsync" />
    }
</div>

<div class="tl-body @(_panelOpen ? null : "tl-body--folded")">
    <div class="tl-stage">
        @if (Loading)
        {
            <div class="pm-diagram-loading">불러오는 중…</div>
        }
        @if (_loaded is null && !Loading)
        {
            <div class="tl-empty">프로젝트와 DB 를 고르고 「불러오기」를 누르십시오.</div>
        }
        <div class="tl-host" @ref="_host"></div>
    </div>

    @* 오른쪽 판: 업무항목과 고른 것(표·선)을 탭 둘로 모은다. 접으면 탭 단추 띠만 남아 도면이 가로를 다 쓴다. *@
    <aside class="tl-panel">
        <div class="tl-panel__tabs" role="tablist">
            <button type="button" class="tl-panel__fold" title="@(_panelOpen ? "오른쪽 판 접기" : "오른쪽 판 펴기")"
                    aria-expanded="@(_panelOpen ? "true" : "false")" @onclick="@(() => _panelOpen = !_panelOpen)">
                <span class="@(_panelOpen ? "jsini-icon-chevron-right" : "jsini-icon-chevron-left")" aria-hidden="true"></span>
            </button>
            <button type="button" role="tab" class="tl-panel__tab @(_tab == PanelTab.Items ? "is-on" : null)"
                    aria-selected="@(_tab == PanelTab.Items ? "true" : "false")" title="업무항목"
                    @onclick="@(() => OpenTab(PanelTab.Items))">
                <span class="jsini-icon-tab-list" aria-hidden="true"></span>
                <span class="tl-panel__label">업무항목</span> <small>@_items.Items.Count</small>
            </button>
            <button type="button" role="tab" class="tl-panel__tab @(_tab == PanelTab.Detail ? "is-on" : null)"
                    aria-selected="@(_tab == PanelTab.Detail ? "true" : "false")" title="@DetailTabTitle"
                    @onclick="@(() => OpenTab(PanelTab.Detail))">
                <span class="jsini-icon-edit" aria-hidden="true"></span>
                <span class="tl-panel__label">@DetailTabTitle</span>
            </button>
        </div>

        @if (_panelOpen)
        {
            @* 업무항목 — 고르면 그 표들과 그 사이 선만 그린다. 편집모드에서는 전부 그리고 칸을 눌러 넣고 뺀다. *@
            <div class="tl-side @(_tab == PanelTab.Items ? null : "is-hidden")" role="tabpanel">
                <DxTextBox @bind-Text="_itemFilter" BindValueMode="BindValueMode.OnInput" NullText="거르기"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <ul class="tl-items">
                    @foreach (var it in ShownItems)
                    {
                        var picked = it.Id == _itemId;
                        <li class="tl-items__row @(picked ? "is-on" : null)">
                            @if (_renaming == it.Id)
                            {
                                <DxTextBox @bind-Text="_renameText" CssClass="tl-items__rename" />
                                <button type="button" class="tl-ib" title="이름 바꾸기" @onclick="@(() => RenameItem(it))"><span class="jsini-icon-check" aria-hidden="true"></span></button>
                                <button type="button" class="tl-ib" title="그만두기" @onclick="@(() => _renaming = null)"><span class="jsini-icon-close" aria-hidden="true"></span></button>
                            }
                            else
                            {
                                <button type="button" class="tl-items__pick" title="@($"{it.Name} — 표 {it.Tables.Count}개")"
                                        @onclick="@(() => PickItemAsync(it.Id))">
                                    <span>@it.Name</span><small>@it.Tables.Count</small>
                                </button>
                                @if (CanEdit)
                                {
                                    <button type="button" class="tl-ib" title="이름 바꾸기"
                                            @onclick="@(() => { _renaming = it.Id; _renameText = it.Name; })"><span class="jsini-icon-edit" aria-hidden="true"></span></button>
                                    <button type="button" class="tl-ib tl-ib--rm" title="이 업무항목을 지웁니다 (도면의 표는 그대로)"
                                            @onclick="@(() => DropItemAsync(it))"><span class="jsini-icon-trash" aria-hidden="true"></span></button>
                                }
                            }
                        </li>
                    }
                </ul>

                @if (_itemId is not null && CanEdit)
                {
                    <DxCheckBox Checked="@_picking" CheckedChanged="@((bool on) => SetPickingAsync(on))">칸을 눌러 담기</DxCheckBox>
                }

                @if (CanEdit && _loaded is not null)
                {
                    <div class="tl-items__add">
                        <DxTextBox @bind-Text="_newItem" NullText="새 업무항목 이름" />
                        <DxButton IconCssClass="jsini-icon-plus" Title="업무항목 추가" RenderStyle="ButtonRenderStyle.Secondary"
                                  Enabled="@(!string.IsNullOrWhiteSpace(_newItem))" Click="@AddItemAsync" />
                    </div>
                }
            </div>

            <div class="tl-side @(_tab == PanelTab.Detail ? null : "is-hidden")" role="tabpanel">
                @if (_selNode is { } n)
                {
                    <div class="tl-side__head"><b>@n.Id</b> <small>@KindText(n.Kind)</small></div>
                    <div class="tl-form">
                        <label>이름</label>
                        <DxTextBox @bind-Text="_editId" Enabled="@CanEdit" />
                        <label>설명</label>
                        <DxTextBox @bind-Text="_edit.Kr" Enabled="@CanEdit" />
                        <label>종류</label>
                        <DxComboBox Data="@LineageGraph.NodeKinds" @bind-Value="_edit.Kind"
                                    ValueFieldName="@nameof(LineageKind.Value)" TextFieldName="@nameof(LineageKind.Text)"
                                    ValidationEnabled="false" Enabled="@CanEdit" />
                        <label>PK</label>
                        <DxTextBox @bind-Text="_edit.Pk" Enabled="@CanEdit" />
                        <label>스키마 꼬리표</label>
                        <DxTextBox @bind-Text="_edit.Owner" Enabled="@CanEdit" />
                        <label>메모</label>
                        <DxMemo @bind-Text="_edit.Note" Rows="3" Enabled="@CanEdit" />
                        <label>주의</label>
                        <DxTextBox @bind-Text="_edit.Warn" Enabled="@CanEdit" />
                        <DxCheckBox @bind-Checked="_editStar" Enabled="@CanEdit">별표(핵심 표)</DxCheckBox>
                        @if (n.Rows is { } rows)
                        {
                            <div class="tl-form__meta">행 수 @rows.ToString("N0")</div>
                        }
                        @if (!string.IsNullOrEmpty(n.Trg))
                        {
                            <div class="tl-form__meta">트리거 @n.Trg</div>
                        }
                        @if (n.Writers is { Count: > 0 } writers)
                        {
                            <div class="tl-form__meta">쓰는 곳 @string.Join(" / ", writers)</div>
                        }
                        @if (CanEdit)
                        {
                            <DxButton IconCssClass="jsini-icon-check" Title="적용" RenderStyle="ButtonRenderStyle.Primary"
                                      Click="@ApplyNodeAsync" />
                        }
                    </div>

                    <div class="tl-side__head"><b>이어진 표</b> <small>@n.Links.Count</small></div>
                    <ul class="tl-links">
                        @foreach (var l in n.Links.OrderBy(l => l.Out).ThenBy(l => l.Other))
                        {
                            <li>
                                <span class="tl-links__dir">@(l.Out ? "→" : "←")</span>
                                <button type="button" class="tl-links__go" @onclick="@(() => GoToAsync(l.Other))">@l.Other</button>
                                <small>@KindText(l.Ty, true)@(string.IsNullOrEmpty(l.Label) ? null : $" · {l.Label}")</small>
                                <button type="button" class="tl-ib" title="이 선을 고릅니다" @onclick="@(() => SelectEdgeAsync(l.Edge))"><span class="jsini-icon-more" aria-hidden="true"></span></button>
                            </li>
                        }
                    </ul>
                }
                else if (_selEdge is { } e)
                {
                    <div class="tl-side__head"><b>선</b> <small>@e.Id</small></div>
                    <div class="tl-form">
                        <div class="tl-form__route">
                            <button type="button" class="tl-links__go" @onclick="@(() => GoToAsync(e.Source))">@e.Source</button>
                            →
                            <button type="button" class="tl-links__go" @onclick="@(() => GoToAsync(e.Target))">@e.Target</button>
                        </div>
                        <label>글귀</label>
                        <DxTextBox @bind-Text="_edgeEdit.Label" Enabled="@CanEdit" />
                        <label>종류</label>
                        <DxComboBox Data="@LineageGraph.EdgeKinds" @bind-Value="_edgeEdit.Ty"
                                    ValueFieldName="@nameof(LineageKind.Value)" TextFieldName="@nameof(LineageKind.Text)"
                                    ValidationEnabled="false" Enabled="@CanEdit" />
                        <DxCheckBox @bind-Checked="_edgeEdit.Key" Enabled="@CanEdit">주요 흐름(굵게)</DxCheckBox>
                        <label>흐름 순번 (0 이면 없음)</label>
                        <DxSpinEdit @bind-Value="_edgeEdit.Seq" MinValue="0" MaxValue="99" Enabled="@CanEdit" />
                        <label>순번 갈래</label>
                        <DxComboBox Data="@SeqFlows" @bind-Value="_edgeEdit.Flow"
                                    ValueFieldName="@nameof(SeqFlow.Value)" TextFieldName="@nameof(SeqFlow.Text)"
                                    ValidationEnabled="false" Enabled="@(CanEdit && _edgeEdit.Seq > 0)" />
                        <label>출발 면 · 도착 면</label>
                        <div class="tl-form__pair">
                            <DxComboBox Data="@LineageGraph.Sides" @bind-Value="_edgeEdit.SourceHandle"
                                        ValueFieldName="@nameof(LineageKind.Value)" TextFieldName="@nameof(LineageKind.Text)"
                                        ValidationEnabled="false" Enabled="@CanEdit" />
                            <DxComboBox Data="@LineageGraph.Sides" @bind-Value="_edgeEdit.TargetHandle"
                                        ValueFieldName="@nameof(LineageKind.Value)" TextFieldName="@nameof(LineageKind.Text)"
                                        ValidationEnabled="false" Enabled="@CanEdit" />
                        </div>
                        @if (CanEdit)
                        {
                            <div class="tl-form__row">
                                <DxButton IconCssClass="jsini-icon-check" Title="적용" RenderStyle="ButtonRenderStyle.Primary"
                                          Click="@ApplyEdgeAsync" />
                                <DxButton IconCssClass="jsini-icon-refresh" Title="방향 뒤집기" RenderStyle="ButtonRenderStyle.Secondary"
                                          Click="@(() => PatchEdgeAsync(new { flip = true }))" />
                                <DxButton IconCssClass="jsini-icon-close-circle" Text="@(e.Pts > 0 ? e.Pts.ToString() : null)"
                                          Title="@($"경유점 지우기 ({e.Pts})")" RenderStyle="ButtonRenderStyle.Secondary"
                                          Enabled="@(e.Pts > 0)" Click="@(() => PatchEdgeAsync(new { clearPts = true }))" />
                            </div>
                        }
                    </div>
                }
                else if (_loaded is not null)
                {
                    <div class="tl-side__head"><b>@_loaded.Nick</b> <small>@_loaded.Schema</small></div>
                    <div class="tl-form__meta">표 @(_summary?.Nodes ?? 0) · 선 @(_summary?.Edges ?? 0)</div>
                    @if (_dbTables is not null)
                    {
                        <div class="tl-form__meta">대상 DB 의 객체 @_dbTables.Count 개 · 도면에 없는 것 @Unplaced 개</div>
                        @if (Missing > 0)
                        {
                            <div class="tl-form__meta tl-form__meta--warn">점선 칸 @Missing 개는 대상 DB 에 없는 이름입니다.</div>
                        }
                    }
                }
            </div>
        }
    </aside>
</div>

@* 대상 DB 의 객체(표·뷰·프로시저·함수)를 골라 놓는다. 못 붙으면 모아 둔 카탈로그에서, 그것도 없으면 이름을 적어 놓는다. *@
<CommPopup @bind-Visible="_pickerOpen" HeaderText="객체 놓기" Width="760px">
    <BodyContentTemplate>
        @if (_dbNotice is not null)
        {
            <PageNotice Tone="NoticeTone.Warning"
                        Text="@(_dbTables is null ? $"{_dbNotice} 이름을 직접 적어 놓으십시오." : _dbNotice)" />
        }

        <div class="tl-pick__bar">
            <DxTextBox @bind-Text="_pickFilter" BindValueMode="BindValueMode.OnInput" NullText="이름·설명 거르기"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            <DxCheckBox @bind-Checked="_pickHidePlaced">이미 놓은 것 감추기</DxCheckBox>
            <DxButton IconCssClass="jsini-icon-refresh" Text="@(_rereading ? "읽는 중…" : null)"
                      Title="DB 에서 다시 읽기" RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!_rereading)" Click="@RereadObjectsAsync" />
        </div>

        @if (_dbTables is not null)
        {
            <div class="tl-pick__types">
                <button type="button" class="tl-chip @(_pickType is null ? "is-on" : null)" @onclick="@(() => _pickType = null)">
                    전체 <small>@_dbTables.Count</small>
                </button>
                @foreach (var g in LineageObjectTypes.Groups)
                {
                    var count = TypeCount(g.Value);
                    <button type="button" class="tl-chip @(_pickType == g.Value ? "is-on" : null)" disabled="@(count == 0)"
                            @onclick="@(() => _pickType = _pickType == g.Value ? null : g.Value)">
                        @g.Text <small>@count</small>
                    </button>
                }
            </div>

            <CommGrd TItem="LineageDbTable" Data="@PickRows" PageSize="12" ShowFooterActions="false"
                     EmptyText="고를 객체가 없습니다." AutoSelectFirstRow="false"
                     SelectionMode="GridSelectionMode.Multiple"
                     SelectedItems="@_picked"
                     SelectedItemsChanged="@((IReadOnlyList<LineageDbTable> items) => _picked = items)">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(LineageDbTable.TypeText)" Caption="종류" Width="90" />
                    <DxGridDataColumn FieldName="@nameof(LineageDbTable.Name)" Caption="이름" Width="220" TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(LineageDbTable.Description)" Caption="설명" TextAlignment="GridTextAlignment.Left" />
                    <DxGridDataColumn FieldName="@nameof(LineageDbTable.Placed)" Caption="놓임" Width="70" />
                </Columns>
            </CommGrd>
        }

        <div class="tl-pick__manual">
            <span class="pm-palette__label">직접 적기</span>
            <DxTextBox @bind-Text="_manualId" NullText="이름" />
            <DxTextBox @bind-Text="_manualKr" NullText="설명" />
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate Context="pickerPopup">
        <span class="tl-pick__kind">
            놓을 종류
            <DxComboBox Data="@PickKinds" @bind-Value="_pickKind"
                        ValueFieldName="@nameof(LineageKind.Value)" TextFieldName="@nameof(LineageKind.Text)"
                        ValidationEnabled="false" />
        </span>
        @if (_dbTables is not null && EmptyComments > 0)
        {
            <DxButton IconCssClass="jsini-icon-edit" Text="@EmptyComments.ToString()"
                      Title="@($"빈 설명 채우기 ({EmptyComments})")" RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@FillCommentsAsync" />
        }
        <DxButton IconCssClass="jsini-icon-child-plus" Text="@PickCount.ToString()"
                  Title="@($"고른 {PickCount}개 놓기")" RenderStyle="ButtonRenderStyle.Primary"
                  Enabled="@(PickCount > 0)" Click="@PlaceAsync" />
        <DxButton IconCssClass="jsini-icon-close" Title="닫기" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => _pickerOpen = false)" />
    </FooterContentTemplate>
</CommPopup>
