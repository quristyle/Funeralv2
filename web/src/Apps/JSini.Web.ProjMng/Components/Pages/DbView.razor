@page "/projmng/db/list"
@using System.Data

@*
    [프로젝트 DB · 속성] — DB 메뉴 `/projmng/db/list`.
    이력: 옛 Blazor `Pages/Proj/ProjDb.razor` → Vue `views/projmng/proj/db.vue` → 여기.

    프로시저: `sp_projdblist`(DB 목록) · `sp_projdbsave`/`sp_projdbdel`(저장·삭제) ·
    `sp_dev_db_prop_exec`(DB 속성)

    [엉뚱한 프로시저를 부르고 있었다]

    이 화면이 `sp_dev_proj_exec` 에 `req_type=db` 를 실어 보내고 있었다.
    그 프로시저는 **프로젝트 목록**을 돌려준다 — 실제로 DB 12건이 아니라
    프로젝트 7건이 보이고 있었다. 이름과 칸이 그럴듯해서 표만 보고는 알기
    어려웠다.

    그리고 **속성 판이 통째로 없었다.** 이 화면의 요점이 그쪽이다 —
    속성값이 다른 화면들의 재료이기 때문이다. `db_pkey='erd'` 는 ERD 그림,
    `db_pkey='sp_fmt'` 는 프로시저 생성 템플릿, `db_pkey='flow'` 는 업무 흐름도다.
    그것을 고치는 곳이 여기뿐인데 열 수가 없었다.

    [세 단계로 파고든다]

        왼쪽   DB 목록          — 고르면
        가운데 그 DB 의 속성     — 고르면
        아래   속성값 편집기     (주로 SQL·템플릿이라 코드 편집기다)

    [목록과 속성이 저장 프로시저가 다르다]

    DB 목록은 `sp_projdbsave`/`sp_projdbdel` 로, 속성은 `sp_dev_db_prop_exec`
    자체로 저장한다. 옛 화면부터 그랬다 — 한 프로시저로 합치면 목록 저장과
    속성 저장의 파라미터가 섞인다.
*@

@inherits DataPage
@inject ProjMngClient Client

<PageTitle>프로젝트 DB · 프로젝트관리</PageTitle>

<PageHeading Title="프로젝트 DB" Scope="프로젝트관리" />

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<PageNotice Text="@Notice" Tone="@Tone" />

<SplitPane Size="42">
    <First>
        <h2 class="pm-subhead">DB 목록</h2>

        @* 비밀번호는 감춘다. 화면에 그대로 두면 어깨너머로 새고, 엑셀로
           내보내면 파일에 남는다. 고칠 때는 편집 칸에서 보인다. *@
        <DynamicGrid Data="@_dbs.Data"
                     Loading="@_dbs.IsLoading"
                     HiddenCols="cre_user,cre_dt,mod_user,mod_dt"
                     ExportName="프로젝트DB"
                     PageSize="20"
                     OnRefresh="@SearchAsync"
                     OnSave="@SaveDbsAsync"
                     OnAdd="@FillNewDb"
                     OnDelete="@DeleteDbAsync"
                     OnRowClick="@SelectDbAsync" />
    </First>

    <Second>
        @if (_dbRid is null)
        {
            <PageNotice Text="왼쪽에서 DB 를 고르면 속성이 나옵니다." Tone="NoticeTone.Info" />
        }
        else
        {
            <h2 class="pm-subhead">@_dbName 의 속성</h2>

            <DynamicGrid Data="@_props.Data"
                         Loading="@_props.IsLoading"
                         HiddenCols="db_prid,cre_user,cre_dt,mod_user,mod_dt,db_pvalue"
                         ExportName="DB속성"
                         PageSize="15"
                         OnRefresh="@LoadPropsAsync"
                         OnSave="@SavePropsAsync"
                         OnAdd="@FillNewProp"
                         OnDelete="@DeletePropAsync"
                         OnRowClick="@SelectPropAsync" />

            @if (_propKey is not null)
            {
                <h2 class="pm-subhead">@_propKey</h2>

                @* 값이 대개 SQL 이나 템플릿이라 코드 편집기로 연다.
                   표 안에서 고치면 여러 줄이 한 줄로 뭉개진다. *@
                <CodeEditor @bind-Value="_propValue" Height="260px" Language="sql"
                            Placeholder="이 속성의 값 — SQL 또는 템플릿" />

                <div class="jsini-toolbar">
                    <div class="jsini-toolbar__spacer"></div>
                    <PermissionView Action="MenuAction.Update">
                        <DxButton Text="값 저장" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                                  Click="@SavePropValueAsync" />
                    </PermissionView>
                </div>
            }
        }
    </Second>
</SplitPane>

@code {
    private const string DbListProc = "sp_projdblist";
    private const string DbSaveProc = "sp_projdbsave";
    private const string DbDeleteProc = "sp_projdbdel";
    private const string PropProc = "sp_dev_db_prop_exec";

    private ProcGrid _dbs = default!;
    private ProcGrid _props = default!;

    private string? _projectCode;

    /// <summary>고른 DB. 속성 조회의 열쇠다.</summary>
    private string? _dbRid;
    private string? _dbName;

    /// <summary>고른 속성. 편집기가 이 값을 연다.</summary>
    private string? _propKey;
    private string? _propValue;

    protected override void OnInitialized()
    {
        _dbs = new ProcGrid(Client, DbListProc);
        _props = new ProcGrid(Client, PropProc);
    }

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync() => LoadAsync(async () =>
    {
        // 프로젝트를 바꾸면 오른쪽을 비운다. 안 비우면 다른 프로젝트의 DB
        // 속성이 그대로 남아 있는다.
        ClearSelection();

        await _dbs.LoadAsync(new Dictionary<string, object?>
        {
            ["proj_rid"] = _projectCode ?? string.Empty,
        });

        return _dbs.Data.Table.Rows.Count;
    }, "등록된 DB 가 없습니다.", "DB 목록을 읽지 못했습니다");

    private void ClearSelection()
    {
        _dbRid = null;
        _dbName = null;
        _propKey = null;
        _propValue = null;
        _props.Clear();
    }

    // ── DB 목록 ─────────────────────────────────────────────

    /// <summary>
    /// DB 목록 저장.
    ///
    /// 조회와 <b>다른 프로시저</b>다(`sp_projdbsave`). 옛 화면부터 그랬다 —
    /// 한 프로시저로 합치면 목록 저장과 속성 저장의 파라미터가 섞인다.
    /// </summary>
    private Task SaveDbsAsync() => RunAsync(async () =>
    {
        var changed = _dbs.Data.ChangedRows();

        if (changed.Count == 0)
        {
            throw new ApiException("수정 대상이 없습니다.");
        }

        await Client.DbSaveAsync(DbSaveProc, changed, new Dictionary<string, object?>
        {
            ["proj_rid"] = _projectCode ?? string.Empty,
        });

        await _dbs.ReloadAsync();
    }, "저장했습니다.", "저장하지 못했습니다");

    private Task DeleteDbAsync(DataRow row) => RunAsync(async () =>
    {
        await Client.DbDeleteAsync(DbDeleteProc, ToParams(row));
        await _dbs.ReloadAsync();

        // 지운 DB 를 고른 채로 두면 없는 DB 의 속성을 계속 들고 있는다.
        ClearSelection();
    }, "지웠습니다.", "지우지 못했습니다");

    /// <summary>새 DB 행에 프로젝트 키를 채운다. 안 채우면 목록에서 사라진다.</summary>
    private Task FillNewDb(DataRow row)
    {
        if (row.Table.Columns.Contains("proj_rid"))
        {
            row["proj_rid"] = _projectCode ?? string.Empty;
        }

        return Task.CompletedTask;
    }

    private async Task SelectDbAsync(DataRow? row)
    {
        if (row is null)
        {
            ClearSelection();
            return;
        }

        _dbRid = Value(row, "db_rid");
        _dbName = Value(row, "db_database") ?? Value(row, "db_ip");

        _propKey = null;
        _propValue = null;

        await LoadPropsAsync();
    }

    // ── DB 속성 ─────────────────────────────────────────────

    private Task LoadPropsAsync() => LoadAsync(async () =>
    {
        if (_dbRid is null)
        {
            _props.Clear();
            return 0;
        }

        await _props.LoadAsync(new Dictionary<string, object?> { ["db_rid"] = _dbRid });

        return _props.Data.Table.Rows.Count;
    }, "이 DB 에 등록된 속성이 없습니다.", "속성을 읽지 못했습니다");

    private Task SavePropsAsync() => RunAsync(
        () => _props.SaveAsync(new Dictionary<string, object?> { ["db_rid"] = _dbRid ?? string.Empty }),
        "저장했습니다.", "저장하지 못했습니다");

    private Task DeletePropAsync(DataRow row) => RunAsync(async () =>
    {
        await _props.DeleteAsync(row);

        _propKey = null;
        _propValue = null;
    }, "지웠습니다.", "지우지 못했습니다");

    private Task FillNewProp(DataRow row)
    {
        if (row.Table.Columns.Contains("db_rid"))
        {
            row["db_rid"] = _dbRid ?? string.Empty;
        }

        return Task.CompletedTask;
    }

    private Task SelectPropAsync(DataRow? row)
    {
        _propKey = row is null ? null : Value(row, "db_pkey");
        _propValue = row is null ? null : Value(row, "db_pvalue");

        return Task.CompletedTask;
    }

    /// <summary>
    /// 편집기의 값을 저장한다.
    ///
    /// 표가 아니라 편집기에서 고쳤으므로 <b>행을 거치지 않고</b> 프로시저에
    /// 바로 보낸다 — 표에 되먹이면 여러 줄 값이 한 줄로 뭉개진다.
    /// </summary>
    private Task SavePropValueAsync() => RunAsync(async () =>
    {
        if (_dbRid is null || _propKey is null)
        {
            throw new ApiException("고른 속성이 없습니다.");
        }

        await Client.DbContAsync(PropProc, new Dictionary<string, object?>
        {
            ["db_rid"] = _dbRid,
            ["db_pkey"] = _propKey,
            ["db_pvalue"] = _propValue ?? string.Empty,
        }, procType: "save");

        await LoadPropsAsync();
    }, "값을 저장했습니다.", "값을 저장하지 못했습니다");

    private static string? Value(DataRow row, string column) =>
        row.Table.Columns.Contains(column) ? row[column]?.ToString() : null;

    private static Dictionary<string, object?> ToParams(DataRow row) =>
        row.Table.Columns
            .Cast<DataColumn>()
            .ToDictionary(c => c.ColumnName, c => row[c] is DBNull ? null : row[c]);
}
