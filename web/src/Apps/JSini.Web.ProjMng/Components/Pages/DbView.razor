@page "/projmng/db/list"
@using System.Data

@*
    [프로젝트 DB 관리]

    이력: Vue `views/projmng/proj/db.vue` → 여기.
    프로젝트별 외부/내부 DB 접속 정보 및 스키마 속성을 관리한다.
*@

@inject ProjMngClient Client

<PageTitle>프로젝트 DB · 프로젝트관리</PageTitle>

<h1>프로젝트 DB <span class="pm-page__scope">프로젝트관리</span></h1>

<SearchBar>
    <ChildContent>
        <CodeSelect CodeId="projlist" @bind-Value="_projectCode" OnChanged="@(_ => SearchAsync())" />
    </ChildContent>
    <Actions>
        <PermissionView Action="MenuAction.Search">
            <DxButton Text="조회" RenderStyle="ButtonRenderStyle.Primary" Click="@SearchAsync" />
        </PermissionView>
    </Actions>
</SearchBar>

<DynamicGrid Data="@_grid.Data" Loading="@_grid.IsLoading" ExportName="프로젝트DB" OnRefresh="@SearchAsync" OnSave="@(() => _grid.SaveAsync(Params()))" OnDelete="@(row => _grid.DeleteAsync(row))" />

@code {
    private ProcGrid _grid = default!;
    private string? _projectCode;

    protected override void OnInitialized()
    {
        _grid = new ProcGrid(Client, "sp_dev_proj_exec");
    }

    private Dictionary<string, object?> Params() => new() { ["prj_rid"] = _projectCode ?? string.Empty, ["req_type"] = "db" };

    private Task SearchAsync() => _grid.LoadAsync(Params());
}
