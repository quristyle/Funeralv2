{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 회로에서 터진 예외를 브라우저까지 내려보낸다.
  //
  // 없으면 콘솔에 "There was an unhandled exception on the current circuit" 만
  // 남고 무엇이 터졌는지 알 수 없다. 서버 창을 볼 수 없는 상황(창이 따로 뜨는
  // dev.bat 기동)에서 특히 답답하다.
  //
  // **Development 파일에만 둔다.** 예외 본문에는 경로·타입 이름이 그대로 들어
  // 있어서 운영에서 켜면 그것이 브라우저로 나간다.
  "DetailedErrors": true
}
