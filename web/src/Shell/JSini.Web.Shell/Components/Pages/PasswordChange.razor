@page "/password/change"
@layout BareLayout

@*
    [비밀번호 변경] — 사용 기간이 지나 갇힌 사람이 오는 자리.

    [이 주소는 있었는데 화면이 없었다]

    Login.razor 가 예전부터 `result.PasswordExpired` 일 때 여기로 보내고 있었다.
    그런데 이 경로를 가진 화면이 어디에도 없어서 **만료된 사람은 로그인 직후
    "페이지를 찾을 수 없습니다" 를 만났다.** 게이트웨이는 이미 그 사람의 다른
    요청을 전부 403 으로 막고 있으므로, 사실상 나갈 길이 없는 상태였다.

    [왜 셸이 갖는가 — /admin/profile 로 보낼 수 없다]

    비밀번호를 바꾸는 폼은 포털관리의 「내 정보」에도 있다. 하지만 그 화면은
    `auth/user/activity` 를 함께 읽는데 그 경로는 게이트웨이 허용 목록에 없다.
    만료 상태에서는 그 조회가 403 이고, DataPage 가 화면을 통째로 실패로 돌려
    **비밀번호 폼 자체가 그려지지 않는다.** 갇힌 사람을 위한 자리는 갇힌 상태에서
    도는 것만 불러야 한다 — 로그인 화면이 셸에 있는 것과 같은 이유다.

    [BareLayout 인 이유]

    MainLayout 은 메뉴·권한·즐겨찾기를 함께 읽는다. 허용 목록에 없는 것이 섞여
    있어 갇힌 상태에서 안내 없이 어긋난다. 대신 토큰 초기화를 레이아웃이 해 주지
    않으므로 이 화면이 직접 한다.

    [바꾼 뒤에 다시 로그인해야 하는 이유]

    게이트웨이는 **토큰의 `PwdChangedAt` 클레임**으로 만료를 판정하는데,
    `auth/user/change-password` 는 DB 만 고치고 새 토큰을 주지 않는다. 그래서
    바꾸자마자 그대로 쓰면 게이트웨이는 여전히 옛 시각을 보고 막는다.
    새 토큰을 받는 길(`auth/refresh`)도 허용 목록 밖이라, 여기서는 로그아웃하고
    다시 들어오게 한다. 한 번 더 로그인하는 값으로 「바꿨는데 아직 막힌다」를 없앤다.
*@

@inject GatewayClient Gateway
@inject ITokenStore Tokens
@inject AuthenticationStateProvider AuthState

<PageTitle>비밀번호 변경 · JSini 포털</PageTitle>

<div class="jsini-login">
    <div class="jsini-login__card">
        <h1 class="jsini-login__title">비밀번호 변경</h1>

        @if (_changed)
        {
            <p class="jsini-hint">
                비밀번호를 바꿨습니다. <b>다시 로그인해야</b> 다른 화면이 열립니다.
            </p>

            @* 로그아웃은 POST 다(CSRF). 헤더의 로그아웃과 같은 길을 쓴다. *@
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="jsini-login__submit">다시 로그인</button>
            </form>
        }
        else
        {
            <p class="jsini-hint">
                비밀번호를 바꾼 지 오래되었거나, 관리자가 발급한 첫 비밀번호를
                쓰고 있습니다. 바꾸기 전에는 다른 화면이 열리지 않습니다.
            </p>

            @if (_error is not null)
            {
                <div class="jsini-login__error" role="alert">@_error</div>
            }

            <label class="jsini-login__label" for="old">지금 비밀번호</label>
            <input id="old" type="password" class="jsini-login__input"
                   autocomplete="current-password"
                   @bind="_oldPassword" @bind:event="oninput" />

            <label class="jsini-login__label" for="new">새 비밀번호</label>
            <input id="new" type="password" class="jsini-login__input"
                   autocomplete="new-password"
                   @bind="_newPassword" @bind:event="oninput" />

            <label class="jsini-login__label" for="confirm">새 비밀번호 확인</label>
            <input id="confirm" type="password" class="jsini-login__input"
                   autocomplete="new-password"
                   @bind="_confirmPassword" @bind:event="oninput"
                   @onkeydown="@OnKeyDownAsync" />

            <button type="button" class="jsini-login__submit"
                    disabled="@_busy" @onclick="@SubmitAsync">
                @(_busy ? "바꾸는 중…" : "비밀번호 바꾸기")
            </button>
        }
    </div>
</div>

@code {
    private string? _oldPassword;
    private string? _newPassword;
    private string? _confirmPassword;

    private string? _error;
    private bool _busy;
    private bool _changed;

    /// <summary>
    /// 토큰을 손에 쥔다. <b>BareLayout 은 이 일을 해 주지 않는다</b> —
    /// 원래 로그인 전 화면용이라 토큰이 없는 것이 정상인 레이아웃이다.
    /// 여기서 하지 않으면 게이트웨이 호출이 전부 401 이 된다.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        Tokens.Initialize(state.User);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_oldPassword) || string.IsNullOrEmpty(_newPassword))
        {
            _error = "지금 비밀번호와 새 비밀번호를 모두 넣으십시오.";
            return;
        }

        // 서버는 두 값이 같은지 알 방법이 없다. 여기서만 잡을 수 있다.
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _error = "새 비밀번호와 확인이 다릅니다.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            // 실패 이유는 서버가 구분해 준다(이전 비밀번호 불일치 · 지금 것과
            // 같음 · 빈 값). 뭉뚱그리면 무엇을 고쳐야 할지 알 수 없다.
            await Gateway.PostAsync(
                "auth/user/change-password",
                new { oldPassword = _oldPassword, newPassword = _newPassword });

            _changed = true;
        }
        catch (ApiException ex)
        {
            _error = $"비밀번호를 바꾸지 못했습니다 — {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
