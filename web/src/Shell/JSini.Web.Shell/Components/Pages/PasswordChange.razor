@page "/password/change"
@layout BareLayout

@*
    [비밀번호 변경] — 90일 만료로 **끌려온 사람이 가장 먼저 만나는** 화면.
    이력: Vue `views/_core/profile/password-setting.vue` → 여기.

    [이 화면이 없어서 만료된 사람이 갇혀 있었다]

    `Login.razor` 는 로그인 응답의 `passwordExpired` 가 참이면 여기로 보낸다
    (자동 로그인과 폼 제출, 두 곳). 그런데 **이 주소를 가진 화면이 없었다.**
    업무 모듈의 포괄 라우트는 자기 접두사 안에서만 잡으므로
    (`/admin/{*rest}`) `/password/change` 는 어디에도 걸리지 않고 셸의
    `NotFound` 로 떨어졌다.

    되돌아갈 곳도 없다는 것이 진짜 문제였다 — 만료된 계정은 게이트웨이가
    거의 모든 경로를 403 으로 막는다(`ApiGateway/Program.cs` 의
    `passwordExpiryAllowList`). 로그인은 되는데 아무것도 못 하는 상태다.

    [셸에 두는 이유]

    업무가 아니라 로그인 흐름의 일부다. 그리고 셸은 업무 모듈을 이름으로
    알지 못하므로(web/CLAUDE.md) `Login.razor` 가 `/admin/profile` 로 보낼 수 없다.

    [BareLayout 인 이유]

    만료 상태에서 열려 있는 경로는 열 개 남짓이고 공지 팝업이 부르는
    `auth/notices/popup` 은 거기 없다. MainLayout 을 쓰면 이 화면을 그릴 때마다
    403 을 한 번씩 맞는다. 팝업이 삼키므로 눈에 보이지는 않지만, 어차피 사이드바의
    메뉴도 전부 막혀 있어 **바꿀 것만 남기는 편**이 이 화면의 목적에 맞다.

    [바꾼 뒤에는 반드시 다시 로그인시킨다]

    **여기가 이 화면에서 가장 틀리기 쉬운 곳이다.** 만료 판정은 토큰의
    `PwdChangedAt` 클레임으로 하는데, 지금 들고 있는 토큰에는 **바꾸기 전**
    시각이 들어 있다. 비밀번호만 바꾸고 그대로 두면 게이트웨이는 계속 막는다 —
    사용자에게는 「바꿨는데도 안 된다」로 보인다. 미리 바꿔 둔 사람도 마찬가지로
    옛 시각 기준으로 며칠 뒤 갑자기 막힌다.

    새 토큰을 받는 가장 확실한 길이 재로그인이다. Vue 도 같은 이유로
    바꾼 직후 로그아웃시켰다(`password-setting.vue` 의 주석).

    [토큰은 이 화면이 직접 챙긴다]

    게이트웨이를 부르려면 `ITokenStore` 에 사용자가 들어가 있어야 하는데,
    그 일을 하는 것은 `MainLayout` 이다. 이 화면은 BareLayout 이라 아무도
    해 주지 않는다. 회로에는 HttpContext 가 없으므로 넘겨주지 않으면
    **토큰 없이 나가 401 을 맞는다.**
*@

@using Microsoft.Extensions.Logging

@inherits DataPage
@inject GatewayClient Gateway
@inject ITokenStore Tokens
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@inject ILogger<PasswordChange> Log

<PageTitle>비밀번호 변경 · JSini 포털</PageTitle>

<div class="jsini-login__card">
    <h1 class="jsini-login__title">비밀번호 변경</h1>

    <PageNotice Text="@_expiryText" Tone="@_expiryTone" />
    <PageNotice Text="@Notice" Tone="@Tone" />

    @if (_changed)
    {
        @* 바꾼 뒤에는 폼을 치운다. 여기서 할 일이 하나뿐이기 때문이다 —
           방금 바꾼 값을 또 칠 이유가 없고, 다시 로그인하지 않으면
           옛 토큰 때문에 계속 막힌다(머리말 참고). *@
        <button type="button" class="jsini-login__submit" @onclick="@ReloginAsync">
            로그인 화면으로
        </button>
    }
    else
    {
        <label class="jsini-login__label" for="old-password">지금 비밀번호</label>
        <input id="old-password" type="password" class="jsini-login__input"
               autocomplete="current-password" @bind="_old" />

        <label class="jsini-login__label" for="new-password">새 비밀번호</label>
        <input id="new-password" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_new" />

        @* 확인 칸은 서버로 보내지 않는다. 서버는 두 값이 같은지 알 방법이
           없으므로 오타는 여기서만 잡을 수 있다. *@
        <label class="jsini-login__label" for="confirm-password">새 비밀번호 확인</label>
        <input id="confirm-password" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_confirm" />

        <button type="button" class="jsini-login__submit"
                disabled="@Loading" @onclick="@SubmitAsync">
            비밀번호 바꾸기
        </button>

        @if (!_forced)
        {
            @* 만료되어 끌려온 사람에게는 이 길을 주지 않는다. 눌러 봐야
               게이트웨이가 403 으로 막아 되돌아오게 되고, 그러면 「나가는
               길이 있는 것처럼 보였다」는 것만 남는다. *@
            <a class="jsini-password__back" href="/">나중에 하기</a>
        }
    }
</div>

@* 감춰 둔 로그아웃 폼. 위 단추가 이것을 제출한다.
   로그아웃은 POST 여야 한다(셸 `Program.cs` — GET 이면 이미지 태그 하나로
   남을 로그아웃시킬 수 있다). 그래서 링크로 만들 수 없다. *@
<form id="jsini-password-logout" action="/logout" method="post" class="jsini-hidden">
    <AntiforgeryToken />
</form>

@code {
    private string? _old;
    private string? _new;
    private string? _confirm;

    /// <summary>바꾸기에 성공했는가. 참이면 폼 대신 재로그인 단추를 보인다.</summary>
    private bool _changed;

    /// <summary>만료되어 끌려온 사람인가. 참이면 빠져나갈 링크를 감춘다.</summary>
    private bool _forced;

    private string? _expiryText;
    private NoticeTone _expiryTone = NoticeTone.Info;

    /// <summary>
    /// 토큰을 챙기고 만료 안내를 읽는다. <b>순서가 중요하다</b> —
    /// 토큰을 넘기기 전에 게이트웨이를 부르면 401 이 난다.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        Tokens.Initialize(state.User);

        await LoadExpiryAsync();
    }

    /// <summary>
    /// 「며칠 지났는지 · 며칠 남았는지」를 읽어 안내 줄을 만든다.
    ///
    /// <para>
    /// <c>auth/user/info</c> 는 만료 상태에서도 열려 있는 몇 안 되는 경로다.
    /// 그래도 실패를 삼키는 이유는, 안내를 못 띄우는 것과 비밀번호를 못 바꾸는
    /// 것의 무게가 다르기 때문이다. <b>안내가 없어도 바꾸는 일은 되어야 한다.</b>
    /// </para>
    /// </summary>
    private async Task LoadExpiryAsync()
    {
        PasswordStatus? status;

        try
        {
            status = await Gateway.GetOneAsync<PasswordStatus>("auth/user/info");
        }
        catch (ApiException ex)
        {
            Log.LogWarning(ex, "비밀번호 만료 안내를 읽지 못했습니다.");
            return;
        }

        if (status is null)
        {
            return;
        }

        if (status.PasswordExpired)
        {
            _forced = true;
            _expiryTone = NoticeTone.Error;
            _expiryText = status.PasswordExpiryDays is int days
                ? $"비밀번호를 바꾼 지 {days}일이 지났습니다. 지금 바꿔야 다른 화면을 쓸 수 있습니다."
                : "비밀번호 사용 기간이 지났습니다. 지금 바꿔야 다른 화면을 쓸 수 있습니다.";
        }
        else if (status.PasswordDaysRemaining is int left && left <= 7)
        {
            // 이레는 Vue 때와 같은 값이다. 미리 알려 주지 않으면 어느 날
            // 갑자기 막히는 것으로 보인다.
            _expiryTone = NoticeTone.Warning;
            _expiryText = $"비밀번호 사용 기간이 {left}일 남았습니다.";
        }
    }

    /// <summary>
    /// 비밀번호를 바꾼다. 서버로 가기 전에 세 가지를 먼저 본다.
    /// </summary>
    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_old) || string.IsNullOrEmpty(_new))
        {
            Say("지금 비밀번호와 새 비밀번호를 모두 넣으십시오.", NoticeTone.Warning);
            return;
        }

        if (!string.Equals(_new, _confirm, StringComparison.Ordinal))
        {
            Say("새 비밀번호와 확인이 다릅니다.", NoticeTone.Warning);
            return;
        }

        if (string.Equals(_old, _new, StringComparison.Ordinal))
        {
            // 서버도 거부한다. 여기서 한 번 더 보는 이유는, 90일마다 바꾸라면서
            // 같은 값을 받아 주면 정책이 아무 일도 하지 않는 셈이기 때문이다.
            Say("지금 쓰는 비밀번호와 다른 값으로 넣으십시오.", NoticeTone.Warning);
            return;
        }

        _changed = await RunAsync(
            () => Gateway.PostAsync(
                "auth/user/change-password",
                new { oldPassword = _old, newPassword = _new }),
            "비밀번호를 바꿨습니다. 새 비밀번호로 다시 로그인해 주십시오.",
            "비밀번호를 바꾸지 못했습니다");

        if (_changed)
        {
            _old = null;
            _new = null;
            _confirm = null;
        }
    }

    /// <summary>
    /// 로그아웃 폼을 제출해 로그인 화면으로 보낸다. 왜 그냥 두면 안 되는지는
    /// 머리말의 「바꾼 뒤에는 반드시 다시 로그인시킨다」에 있다.
    /// </summary>
    private Task ReloginAsync() =>
        Js.InvokeVoidAsync("document.getElementById('jsini-password-logout').submit").AsTask();

    /// <summary>
    /// <c>auth/user/info</c> 에서 만료 안내에 필요한 칸만 꺼낸다.
    ///
    /// <para>
    /// 포털관리의 <c>UserInfoDto</c> 를 쓰지 않는 이유가 둘이다. 셸은 업무
    /// 모듈의 타입을 이름으로 알지 않고(web/CLAUDE.md), 그쪽 DTO 에는 이 세
    /// 칸이 아예 없다. 쓰는 곳이 셋이 되면 그때 <c>Models</c> 로 올린다.
    /// </para>
    /// </summary>
    private sealed class PasswordStatus
    {
        /// <summary>만료로 보는 기간(일). 설정 <c>Auth:PasswordExpiryDays</c> 값이다.</summary>
        public int? PasswordExpiryDays { get; set; }

        /// <summary>남은 날. 이미 지났으면 음수일 수 있다.</summary>
        public int? PasswordDaysRemaining { get; set; }

        /// <summary>지금 막혀 있는가.</summary>
        public bool PasswordExpired { get; set; }
    }
}
