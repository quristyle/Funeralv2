@page "/password/change"
@attribute [ScreenAccess(ScreenAccessKind.Open, Reason = "본인 비밀번호를 바꾼다. 누구에게나 있어야 하는 자리다.")]
@layout BareLayout

@*
    비밀번호 변경. 90일 만료로 끌려온 사람이 처음 만나는 화면이다. 업무가 아니라 로그인 흐름의 일부라 셸에 둔다.
    바꾼 뒤에는 반드시 다시 로그인시킨다. 만료 판정은 토큰의 PwdChangedAt 클레임으로 하므로, 들고 있는 토큰으로는 게이트웨이가 계속 막는다.
    BareLayout 이라 MainLayout 이 하던 토큰 전달을 여기서 직접 한다(없으면 401).
*@

@using Microsoft.Extensions.Logging

@*
    안내는 토스트가 아니라 PageNotice 로 그린다. BareLayout 에는 토스트 판이 없어 결과가 안 보인다. 위는 화면의 상태(기간), 아래는 방금 한 일의 결과다.
*@

<PageTitle>비밀번호 변경 · JSini 포털</PageTitle>

<AuthShell Title="비밀번호 변경"
           Sub="@(_changed ? "다 됐습니다." : "지금 비밀번호를 대고 새 비밀번호를 정합니다.")"
           Lead="90일마다 비밀번호를 바꿔 주셔야 합니다.">

    @* 화면의 상태 — 기간이 얼마나 남았는가. 사라지면 안 된다. *@
    <PageNotice Text="@_expiryText" Tone="@_expiryTone" />

    @if (_changed)
    {
        @* 바꾼 뒤에는 폼을 치운다. 다시 로그인하지 않으면 옛 토큰 때문에 계속 막힌다. *@
        <PageNotice Text="비밀번호를 바꿨습니다. 새 비밀번호로 다시 로그인해 주십시오." />

        <button type="button" class="jsini-login__submit" @onclick="@ReloginAsync">
            로그인 화면으로
        </button>
    }
    else
    {
        @* 방금 한 일의 결과. *@
        <PageNotice Text="@_notice" Tone="@_tone" />

        @* 엔터로 넘어가게 폼으로 감싼다. 회로가 붙기 전에는 단추를 잠근다(잠그지 않으면 브라우저가 GET 으로 제출해 주소의 토큰을 잃는다). *@
        <form @onsubmit="@SubmitAsync" @onsubmit:preventDefault>
            <div class="jsini-login__field">
                <label class="jsini-login__label" for="old-password">지금 비밀번호</label>
                <input id="old-password" type="password" class="jsini-login__input"
                       autocomplete="current-password" @bind="_old" />
            </div>

            <div class="jsini-login__field">
                <label class="jsini-login__label" for="new-password">새 비밀번호</label>
                <input id="new-password" type="password" class="jsini-login__input"
                       autocomplete="new-password" @bind="_new" />
            </div>

            @* 확인 칸은 서버로 보내지 않는다. 오타는 여기서만 잡을 수 있다. *@
            <div class="jsini-login__field">
                <label class="jsini-login__label" for="confirm-password">새 비밀번호 확인</label>
                <input id="confirm-password" type="password" class="jsini-login__input"
                       autocomplete="new-password" @bind="_confirm" />
            </div>

            <button type="submit" class="jsini-login__submit" disabled="@Blocked">
                @(_busy ? "바꾸는 중…" : "비밀번호 바꾸기")
            </button>
        </form>

        @if (!_forced)
        {
                @* 만료된 사람에게는 이 길을 주지 않는다. 눌러 봐야 게이트웨이가 403 으로 막는다. *@
            <a class="jsini-password__back" href="/">나중에 하기</a>
        }
    }
</AuthShell>

@* 감춰 둔 로그아웃 폼. 로그아웃은 POST 여야 하므로 링크로 만들 수 없다. *@
<form id="jsini-password-logout" action="/logout" method="post" class="jsini-hidden">
    <AntiforgeryToken />
</form>
