@page "/register"
@layout BareLayout
@attribute [AllowAnonymous]

@*
    [가입 신청] — 로그인 화면의 「가입 신청」이 여기로 온다.
    이력: Vue `views/_core/authentication/register.vue` → 여기.

    [옛 화면은 아무 일도 하지 않았다]

    Vue 쪽 화면은 vben 템플릿을 그대로 둔 것이라 제출 함수가 `void value;`
    한 줄이었다 — 다 채우고 눌러도 아무 데도 가지 않았다. 백엔드에도 가입
    경로가 없었다. `POST auth/signup` 과 승인 처리는 이번에 함께 만들었다.

    [신청이지 가입이 아니다]

    누르면 계정이 **승인 대기(PENDING) 상태로** 만들어지고, 관리자가 계정
    관리에서 승인해야 로그인할 수 있다. 로그인이 그 상태를 보고 막는다
    (`AuthEndpoints`) — 그 검사가 이 화면을 열어 두는 전제다.

    사내 업무 포털이라 아무나 들어와서는 안 되고, 그렇다고 관리자가 계정을
    다 만들어 주는 것도 번거로워 신청·승인으로 정했다.

    [부서와 역할 칸이 없다]

    신청자가 자기 부서와 역할을 고르게 두면 **스스로 권한을 정하는** 셈이다.
    소속과 역할은 승인하는 사람이 계정 관리에서 붙인다. 대신 「하실 말씀」을
    두어 누구인지 적을 수 있게 했고, 그 값이 승인 화면에 그대로 보인다.

    [이메일을 반드시 받는다]

    승인·거절 안내가 그 주소로 가고, 나중에 비밀번호를 잊었을 때도 그 값이
    유일한 열쇠다. 비워 두면 승인해 놓고도 알려 줄 길이 없다.

    [소셜로도 신청할 수 있다]

    구글 · 네이버 · 카카오 단추가 아래에 선다. 누르면 공급자에 다녀와서
    **여기 폼을 채운 것과 똑같은 승인 대기 계정**이 만들어진다 — 아이디·이름·
    이메일을 공급자에게서 받아 오므로 일곱 칸을 채우지 않아도 된다.

    같은 단추가 로그인 화면에도 있다. 거기서는 「로그인」이라고 부르고
    여기서는 「신청」이라고 부르는데, **서버가 하는 일은 하나다** — 연결된
    계정이 있으면 로그인이고 없으면 신청이다. 이름을 자리에 맞게 부를 뿐이다.
*@

@inherits DataPage
@inject AccountClient Accounts
@inject LoginService Auth

<PageTitle>가입 신청 · JSini 포털</PageTitle>

<div class="jsini-login__card jsini-login__card--wide">
    <h1 class="jsini-login__title">가입 신청</h1>

    @if (_sent)
    {
        <p class="jsini-hint">
            관리자가 승인하면 신청하실 때 적으신 이메일로 알려 드립니다.
            승인 전에는 로그인하실 수 없습니다.
        </p>

        <a class="jsini-password__back" href="/login">로그인 화면으로</a>
    }
    else
    {
        <label class="jsini-login__label" for="reg-id">아이디</label>
        <input id="reg-id" class="jsini-login__input"
               autocomplete="username" @bind="_input.LoginId" />

        <label class="jsini-login__label" for="reg-name">이름</label>
        <input id="reg-name" class="jsini-login__input"
               autocomplete="name" @bind="_input.UserName" />

        <label class="jsini-login__label" for="reg-email">이메일</label>
        <input id="reg-email" type="email" class="jsini-login__input"
               autocomplete="email" @bind="_input.Email" />

        <label class="jsini-login__label" for="reg-phone">연락처 (없어도 됩니다)</label>
        <input id="reg-phone" class="jsini-login__input"
               autocomplete="tel" @bind="_input.Phone" />

        <label class="jsini-login__label" for="reg-pw">비밀번호</label>
        <input id="reg-pw" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_input.Password" />

        <label class="jsini-login__label" for="reg-confirm">비밀번호 확인</label>
        <input id="reg-confirm" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_input.Confirm" />

        <label class="jsini-login__label" for="reg-note">하실 말씀 (소속 · 담당 업무 등)</label>
        <textarea id="reg-note" class="jsini-login__input jsini-login__textarea"
                  rows="3" @bind="_input.Note"></textarea>

        <button type="button" class="jsini-login__submit"
                disabled="@Loading" @onclick="@SubmitAsync">
            신청하기
        </button>

        @*
            ── 소셜 계정으로 신청 ──────────────────────────────

            **폼 밖의 평범한 링크다.** 공급자에 다녀오는 왕복이라 폼 제출로는
            할 수 없고, 위 칸들과 함께 보낼 것도 없다 — 이름·이메일을 공급자가
            알려 준다.

            로그인 화면과 같은 마크업·같은 CSS 를 쓴다. 두 벌로 두면 다음에
            공급자를 하나 더 켰을 때 **한 화면에만 단추가 선다.**
        *@
        @if (_socialProviders.Count > 0)
        {
            <div class="jsini-login__social">
                <div class="jsini-login__or"><span>소셜 계정으로 신청</span></div>

                <div class="jsini-login__social-btns">
                    @foreach (var provider in _socialProviders)
                    {
                        <a class="jsini-login__social-btn"
                           href="@($"/social/{provider.Key}/start")">@provider.DisplayName</a>
                    }
                </div>

                <p class="jsini-login__social-note">
                    누르시면 이름과 이메일을 공급자에게서 받아 신청서를 대신 채웁니다.
                    승인 절차는 위와 같습니다.
                </p>
            </div>
        }

        <a class="jsini-password__back" href="/login">로그인 화면으로</a>
    }
</div>

@code {
    private readonly SignupInput _input = new();

    /// <summary>신청을 보냈는가. 참이면 폼 대신 안내만 보인다.</summary>
    private bool _sent;

    /// <summary>그릴 소셜 단추들. 서버가 알려 준 것만 들어 있다.</summary>
    private IReadOnlyList<SocialProvider> _socialProviders = [];

    /// <summary>
    /// 소셜 단추 목록을 받아 둔다. <b>실패해도 화면은 그대로 뜬다</b> —
    /// 단추가 없을 뿐이고 손으로 채우는 신청은 그대로 되어야 한다.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _socialProviders = await Auth.GetSocialProvidersAsync();
    }

    /// <summary>
    /// 신청을 보낸다.
    ///
    /// <para>
    /// 서버도 같은 것을 검사한다. 여기서 한 번 더 보는 이유는 <b>왕복 없이
    /// 알려 주려는 것</b>뿐이고, 진짜 판정은 언제나 서버가 한다 —
    /// 아이디 중복처럼 화면이 알 수 없는 것도 있다.
    /// </para>
    /// </summary>
    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.LoginId)
            || string.IsNullOrWhiteSpace(_input.UserName)
            || string.IsNullOrWhiteSpace(_input.Email))
        {
            Say("아이디 · 이름 · 이메일은 반드시 넣어야 합니다.", NoticeTone.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_input.Password))
        {
            Say("비밀번호를 넣으십시오.", NoticeTone.Warning);
            return;
        }

        if (!string.Equals(_input.Password, _input.Confirm, StringComparison.Ordinal))
        {
            // 서버는 두 값이 같은지 알 방법이 없다. 여기서만 잡을 수 있다.
            Say("비밀번호와 확인이 다릅니다.", NoticeTone.Warning);
            return;
        }

        _sent = await RunAsync(
            () => Accounts.SignupAsync(_input),
            "가입 신청을 받았습니다. 관리자 승인 뒤에 로그인하실 수 있습니다.",
            "신청을 보내지 못했습니다");
    }
}
