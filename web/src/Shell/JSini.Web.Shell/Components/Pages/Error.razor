@page "/error"
@attribute [ScreenAccess(ScreenAccessKind.Open, Reason = "오류 안내다. 막으면 오류가 차단 안내로 바뀌어 원인이 숨는다.")]
@layout BareLayout
@attribute [AllowAnonymous]

@*
    처리하지 못한 예외. 운영에서만 보인다. 추적 번호를 보여 주는 것이 요점이다. 관리자는 포털관리 「오류 추적」에서 그 번호로 예외와 스택을 바로 펴 본다.
    번호는 PortalErrorHandler 가 같은 값으로 표에 적는다. 복사 단추는 회로가 없을 수도 있어 인라인 스크립트다.
*@

@using System.Diagnostics

<PageTitle>오류</PageTitle>

<div class="jsini-message">
    <h1>오류가 발생했습니다</h1>
    <p>잠시 뒤 다시 시도해 주세요. 계속되면 아래 번호와 함께 알려 주세요.</p>

    @if (_requestId is not null)
    {
        <p class="jsini-message__trace">
            추적 번호: <code id="jsini-trace">@_requestId</code>
            <button type="button" class="jsini-message__copy"
                    onclick="navigator.clipboard?.writeText(document.getElementById('jsini-trace').textContent).then(() =&gt; this.textContent = '복사됨')">
                복사
            </button>
        </p>
    }

    <a href="/">첫 화면으로</a>
</div>
