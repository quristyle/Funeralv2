@page "/password/reset"
@layout BareLayout
@attribute [AllowAnonymous]

@*
    [비밀번호 다시 정하기] — 메일로 받은 링크가 여기로 온다.

    주소는 `/password/reset?token=…` 이고, 그 토큰을 만든 곳은
    AuthServer 의 `PasswordResetService` 다. 링크 수명은 기본 30분이고
    한 번 쓰면 죽는다.

    [`/password/change` 와 무엇이 다른가]

    이름이 닮아서 헷갈리기 쉬운데 **신원을 무엇으로 증명하느냐**가 다르다.

      · `/password/change` — 로그인한 사람이 **지금 비밀번호**를 대고 바꾼다.
      · `/password/reset`  — 잊은 사람이 **메일함을 열 수 있다**는 것으로 대신한다.

    그래서 이 화면은 익명이고 지금 비밀번호를 묻지 않는다.

    [토큰이 없으면 폼을 그리지 않는다]

    주소를 손으로 친 사람이 새 비밀번호를 다 채우고 누른 뒤에야 「링크가
    올바르지 않다」를 보는 것은 나쁘다. 애초에 넣을 칸을 주지 않는다.

    [바꾼 뒤 자동으로 로그인시키지 않는다]

    토큰 하나로 화면까지 열어 준 참이라, 거기서 세션까지 만들어 주면 메일을
    엿본 사람이 곧바로 들어온다. 새 비밀번호로 **직접** 로그인하게 둔다.
*@

@inherits DataPage
@inject AccountClient Accounts

<PageTitle>비밀번호 다시 정하기 · JSini 포털</PageTitle>

<div class="jsini-login__card">
    <h1 class="jsini-login__title">비밀번호 다시 정하기</h1>

    <PageNotice Text="@Notice" Tone="@Tone" />

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <p class="jsini-hint">
            링크가 올바르지 않습니다. 메일에 있는 주소를 그대로 열어 주십시오.
            주소가 두 줄로 잘렸다면 두 줄을 이어 붙여야 합니다.
        </p>

        <a class="jsini-password__back" href="/password/forgot">비밀번호 찾기 다시 하기</a>
    }
    else if (_done)
    {
        <a class="jsini-login__submit jsini-password__go" href="/login">로그인 화면으로</a>
    }
    else
    {
        <label class="jsini-login__label" for="reset-new">새 비밀번호</label>
        <input id="reset-new" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_new" />

        @* 확인 칸은 서버로 보내지 않는다. 서버는 두 값이 같은지 알 방법이 없다. *@
        <label class="jsini-login__label" for="reset-confirm">새 비밀번호 확인</label>
        <input id="reset-confirm" type="password" class="jsini-login__input"
               autocomplete="new-password" @bind="_confirm" />

        <button type="button" class="jsini-login__submit"
                disabled="@Loading" @onclick="@SubmitAsync">
            비밀번호 정하기
        </button>
    }
</div>

@code {
    /// <summary>메일 링크가 실어 온 토큰. 없으면 폼을 그리지 않는다.</summary>
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private string? _new;
    private string? _confirm;

    /// <summary>다시 정했는가. 참이면 로그인 화면으로 가는 길만 보인다.</summary>
    private bool _done;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_new))
        {
            Say("새 비밀번호를 넣으십시오.", NoticeTone.Warning);
            return;
        }

        if (!string.Equals(_new, _confirm, StringComparison.Ordinal))
        {
            Say("새 비밀번호와 확인이 다릅니다.", NoticeTone.Warning);
            return;
        }

        // 실패 이유는 서버가 구분해 준다(시간 지남 · 이미 씀 · 지금 것과 같음).
        // 그 문구가 그대로 붙어 나온다 — 다시 요청해야 하는지, 다른 값을
        // 넣어야 하는지가 갈리기 때문이다.
        _done = await RunAsync(
            () => Accounts.ResetPasswordAsync(Token!, _new!),
            "비밀번호를 다시 정했습니다. 새 비밀번호로 로그인해 주십시오.",
            "비밀번호를 다시 정하지 못했습니다");

        if (_done)
        {
            _new = null;
            _confirm = null;
        }
    }
}
