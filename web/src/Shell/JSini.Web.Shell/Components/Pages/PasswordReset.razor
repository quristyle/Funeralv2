@page "/password/reset"
@layout BareLayout
@attribute [AllowAnonymous]

@*
    [비밀번호 다시 정하기] — 메일로 받은 링크가 여기로 온다.

    주소는 `/password/reset?token=…` 이고, 그 토큰을 만든 곳은
    AuthServer 의 `PasswordResetService` 다. 링크 수명은 기본 30분이고
    한 번 쓰면 죽는다.

    [`/password/change` 와 무엇이 다른가]

    이름이 닮아서 헷갈리기 쉬운데 **신원을 무엇으로 증명하느냐**가 다르다.

      · `/password/change` — 로그인한 사람이 **지금 비밀번호**를 대고 바꾼다.
      · `/password/reset`  — 잊은 사람이 **메일함을 열 수 있다**는 것으로 대신한다.

    그래서 이 화면은 익명이고 지금 비밀번호를 묻지 않는다.

    [토큰이 없으면 폼을 그리지 않는다]

    주소를 손으로 친 사람이 새 비밀번호를 다 채우고 누른 뒤에야 「링크가
    올바르지 않다」를 보는 것은 나쁘다. 애초에 넣을 칸을 주지 않는다.

    [바꾼 뒤 자동으로 로그인시키지 않는다]

    토큰 하나로 화면까지 열어 준 참이라, 거기서 세션까지 만들어 주면 메일을
    엿본 사람이 곧바로 들어온다. 새 비밀번호로 **직접** 로그인하게 둔다.

    ────────────────────────────────────────────────────────────
    [말한 것이 아무 데도 안 뜨고 있었다]

    이 화면은 `DataPage` 를 상속하고 있었다. 그러면 `Say` · `RunAsync` 가 결과를
    **토스트**로 띄우는데, 토스트 판(`DxToastProvider`)은 `MainLayout` 에만 있고
    이 화면은 `BareLayout` 이다 — 즉 「새 비밀번호와 확인이 다릅니다」도, 서버가
    준 실패 이유도 **한 글자도 안 보였다.** 단추를 눌러도 아무 일이 없는 것처럼
    보이는 것이 이 화면에서 가장 큰 문제였다.

    그래서 `DataPage` 를 떼고 결과를 화면이 직접 들어 `PageNotice` 로 그린다.
    여기서는 안내가 사라지면 안 되기도 한다 — 링크가 만료됐다는 말은 **다시
    요청해야 한다**는 뜻이라 읽고 움직일 때까지 남아 있어야 한다.
*@

@inject AccountClient Accounts

<PageTitle>비밀번호 다시 정하기 · JSini 포털</PageTitle>

<AuthShell Title="비밀번호 다시 정하기"
           Sub="@Sub"
           Lead="새 비밀번호를 정하시면 곧바로 로그인하실 수 있습니다.">

    @if (string.IsNullOrWhiteSpace(Token))
    {
        @* 토큰이 없다. 칸을 주지 않는다(머리말).

           **글자만 넘긴다.** `PageNotice` 의 안쪽은 `display: flex` 라
           (아이콘 자리를 왼쪽에 두려고 그렇다) 마크업을 넣으면 `<strong>`
           하나가 제 칸을 차지해 글이 세로로 갈라진다 — 실제로 그렇게
           읽을 수 없는 줄이 나왔다. *@
        <PageNotice Tone="NoticeTone.Warning"
                    Text="링크가 올바르지 않습니다. 메일에 있는 주소를 그대로 열어 주십시오. 주소가 두 줄로 잘렸다면 두 줄을 이어 붙여야 합니다." />

        <a class="jsini-login__submit jsini-password__go" href="/password/forgot">
            비밀번호 찾기 다시 하기
        </a>
    }
    else if (_done)
    {
        <PageNotice Text="비밀번호를 다시 정했습니다. 새 비밀번호로 로그인해 주십시오." />

        <a class="jsini-login__submit jsini-password__go" href="/login">로그인 화면으로</a>
    }
    else
    {
        <PageNotice Text="@_notice" Tone="@_tone" />

        @* 링크가 죽은 경우(만료·이미 씀)에는 여기서 다시 넣어 봐야 같은 답만
           돌아온다. 폼을 남겨 두면 사용자가 그것을 두세 번 확인하게 된다. *@
        @if (_dead)
        {
            <a class="jsini-login__submit jsini-password__go" href="/password/forgot">
                비밀번호 찾기 다시 하기
            </a>
        }
        else
        {
            @* 폼으로 감싸는 것은 **엔터로 넘어가게** 하려는 것이다.

               [회로가 붙기 전에는 단추를 잠가 둔다] (실제로 밟음)

               `@@onsubmit:preventDefault` 는 회로가 붙은 뒤에만 듣는다.
               프리렌더된 HTML 을 받은 순간 누르면 **브라우저가 평범한 GET
               으로 제출**해 버리고, 칸에 `name` 이 없으니 주소가 `?token=…`
               을 잃은 채 다시 열린다 — 사용자에게는 「링크가 올바르지
               않습니다」로 보인다. 링크를 받아 곧바로 누른 사람이 정확히
               그 창에 걸리고, 그 사람은 **아직 멀쩡한 링크를 손에 들고도**
               다시 받으러 가게 된다.

               잠가 두면 그 창이 닫힌다. 엔터도 함께 막힌다 — 브라우저는
               잠긴 기본 단추로는 암묵 제출을 하지 않는다. *@
            <form @onsubmit="@SubmitAsync" @onsubmit:preventDefault>
                <div class="jsini-login__field">
                    <label class="jsini-login__label" for="reset-new">새 비밀번호</label>
                    <input id="reset-new" type="password" class="jsini-login__input"
                           autocomplete="new-password" @bind="_new" />
                </div>

                @* 확인 칸은 서버로 보내지 않는다. 서버는 두 값이 같은지 알 방법이 없다. *@
                <div class="jsini-login__field">
                    <label class="jsini-login__label" for="reset-confirm">새 비밀번호 확인</label>
                    <input id="reset-confirm" type="password" class="jsini-login__input"
                           autocomplete="new-password" @bind="_confirm" />
                </div>

                <button type="submit" class="jsini-login__submit" disabled="@Blocked">
                    @(_busy ? "정하는 중…" : "비밀번호 정하기")
                </button>
            </form>

            <a class="jsini-password__back" href="/login">로그인 화면으로</a>
        }
    }
</AuthShell>

@code {
    /// <summary>메일 링크가 실어 온 토큰. 없으면 폼을 그리지 않는다.</summary>
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private string? _new;
    private string? _confirm;

    /// <summary>다시 정했는가. 참이면 로그인 화면으로 가는 길만 보인다.</summary>
    private bool _done;

    /// <summary>
    /// 링크가 죽었는가(시간이 지났거나 이미 썼다). 참이면 폼 대신
    /// 「다시 요청」 길만 준다 — 같은 링크로는 무엇을 넣어도 안 된다.
    /// </summary>
    private bool _dead;

    /// <summary>보내는 중인가. 두 번 눌러 토큰을 태우지 않게 막는다.</summary>
    private bool _busy;

    /// <summary>
    /// 지금 단추를 잠가야 하는가 — 보내는 중이거나 <b>아직 회로가 안 붙었다</b>.
    /// 뒤엣것이 왜 필요한지는 폼 위의 주석에 있다.
    /// </summary>
    private bool Blocked => _busy || !RendererInfo.IsInteractive;

    /// <summary>
    /// 화면에 남겨 둘 안내. <b>토스트를 쓰지 않는 이유는 머리말에 있다.</b>
    /// </summary>
    private string? _notice;

    private NoticeTone _tone = NoticeTone.Info;

    /// <summary>제목 밑 한 줄. 상태마다 할 말이 다르다.</summary>
    private string Sub =>
        string.IsNullOrWhiteSpace(Token) ? "받으신 메일의 링크로 들어와 주십시오."
        : _done ? "다 됐습니다."
        : "새로 쓰실 비밀번호를 정해 주십시오.";

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_new))
        {
            Warn("새 비밀번호를 넣으십시오.");
            return;
        }

        if (!string.Equals(_new, _confirm, StringComparison.Ordinal))
        {
            Warn("새 비밀번호와 확인이 다릅니다.");
            return;
        }

        _notice = null;
        _tone = NoticeTone.Info;
        _busy = true;

        // 실패 이유는 서버가 구분해 준다(시간 지남 · 이미 씀 · 지금 것과 같음).
        // 그 문구를 그대로 띄운다 — 다시 요청해야 하는지, 다른 값을 넣어야
        // 하는지가 갈리기 때문이다.
        try
        {
            await Accounts.ResetPasswordAsync(Token!, _new!);

            _done = true;
            _new = null;
            _confirm = null;
        }
        catch (ApiException ex)
        {
            _notice = ex.Message;
            _tone = NoticeTone.Error;

            // 링크가 죽은 것이면 폼을 치운다. 어느 코드가 죽은 것인지는
            // `PasswordResetEndpoints` 가 정한다.
            _dead = ex.Code is "EXPIRED" or "USED";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>서버까지 가지 않고 막은 것. 화면에 남겨 둔다.</summary>
    private void Warn(string text)
    {
        _notice = text;
        _tone = NoticeTone.Warning;
    }
}
