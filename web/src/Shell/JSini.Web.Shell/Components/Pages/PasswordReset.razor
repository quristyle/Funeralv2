@page "/password/reset"
@attribute [ScreenAccess(ScreenAccessKind.Open, Reason = "메일로 받은 링크로 들어온다. 로그인 전이다.")]
@layout BareLayout
@attribute [AllowAnonymous]

@*
    메일로 받은 링크가 여기로 온다(/password/reset?token=…). 신원은 메일함을 열 수 있다는 것으로 증명하므로 익명이고 지금 비밀번호를 묻지 않는다(변경은 /password/change).
    토큰이 없으면 폼을 그리지 않는다. 바꾼 뒤 자동으로 로그인시키지 않는다(토큰으로 세션까지 만들면 메일을 엿본 사람이 들어온다).
    안내는 토스트가 아니라 PageNotice 로 그린다(BareLayout 에는 토스트 판이 없다).
*@

<PageTitle>비밀번호 다시 정하기 · JSini 포털</PageTitle>

<AuthShell Title="비밀번호 다시 정하기"
           Sub="@Sub"
           Lead="새 비밀번호를 정하시면 곧바로 로그인하실 수 있습니다.">

    @if (string.IsNullOrWhiteSpace(Token))
    {
        @* 토큰이 없다. 칸을 주지 않는다. PageNotice 안쪽은 flex 라 글자만 넘긴다. *@
        <PageNotice Tone="NoticeTone.Warning"
                    Text="링크가 올바르지 않습니다. 메일에 있는 주소를 그대로 열어 주십시오. 주소가 두 줄로 잘렸다면 두 줄을 이어 붙여야 합니다." />

        <a class="jsini-login__submit jsini-password__go" href="/password/forgot">
            비밀번호 찾기 다시 하기
        </a>
    }
    else if (_done)
    {
        <PageNotice Text="비밀번호를 다시 정했습니다. 새 비밀번호로 로그인해 주십시오." />

        <a class="jsini-login__submit jsini-password__go" href="/login">로그인 화면으로</a>
    }
    else
    {
        <PageNotice Text="@_notice" Tone="@_tone" />

            @* 링크가 죽었으면 다시 넣어 봐야 같은 답이다. 폼을 남기지 않는다. *@
        @if (_dead)
        {
            <a class="jsini-login__submit jsini-password__go" href="/password/forgot">
                비밀번호 찾기 다시 하기
            </a>
        }
        else
        {
            @* 엔터로 넘어가게 폼으로 감싼다. 회로가 붙기 전에는 단추를 잠근다(잠그지 않으면 브라우저가 GET 으로 제출해 토큰을 잃는다). *@
            <form @onsubmit="@SubmitAsync" @onsubmit:preventDefault>
                <div class="jsini-login__field">
                    <label class="jsini-login__label" for="reset-new">새 비밀번호</label>
                    <input id="reset-new" type="password" class="jsini-login__input"
                           autocomplete="new-password" @bind="_new" />
                </div>

                @* 확인 칸은 서버로 보내지 않는다. 서버는 두 값이 같은지 알 방법이 없다. *@
                <div class="jsini-login__field">
                    <label class="jsini-login__label" for="reset-confirm">새 비밀번호 확인</label>
                    <input id="reset-confirm" type="password" class="jsini-login__input"
                           autocomplete="new-password" @bind="_confirm" />
                </div>

                <button type="submit" class="jsini-login__submit" disabled="@Blocked">
                    @(_busy ? "정하는 중…" : "비밀번호 정하기")
                </button>
            </form>

            <a class="jsini-password__back" href="/login">로그인 화면으로</a>
        }
    }
</AuthShell>
