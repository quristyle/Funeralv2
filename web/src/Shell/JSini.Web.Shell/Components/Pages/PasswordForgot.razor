@page "/password/forgot"
@layout BareLayout
@attribute [AllowAnonymous]

@*
    [비밀번호 찾기] — 로그인 화면의 「비밀번호를 잊으셨나요?」가 여기로 온다.
    이력: Vue `views/_core/authentication/forget-password.vue` → 여기.

    [옛 화면은 아무 일도 하지 않았다]

    Vue 쪽에 같은 이름의 화면이 있었지만 vben 템플릿을 그대로 둔 것이라
    제출 함수가 `void value;` 한 줄이었다. 이메일을 넣고 눌러도 아무 데도
    가지 않았다는 뜻이다. 백엔드에도 재설정 경로가 없었다 —
    `POST auth/password/forgot` 과 재설정 표는 이번에 함께 만들었다.

    [아이디를 함께 받는다]

    한 사람이 계정을 둘 이상 가진 경우가 있어(업무용·시험용) 이메일만으로는
    어느 계정인지 정할 수 없다. 덤으로 두 값을 다 알아야 메일이 나가므로
    이메일 하나만 아는 사람이 남의 계정으로 메일을 보낼 수 없다.

    [무엇을 넣든 같은 답을 보여 준다]

    **이것이 이 화면에서 가장 틀리기 쉬운 곳이다.** 「그런 아이디가 없습니다」를
    보여 주면 이 화면이 아이디 목록을 확인해 주는 도구가 된다 — 로그인 화면이
    「아이디 또는 비밀번호가 잘못되었습니다」로 뭉뚱그려 막아 둔 것을 옆문으로
    여는 셈이다. 서버도 같은 이유로 언제나 성공으로 답한다.

    그래서 「메일이 안 온다」는 문의가 오면 **화면이 아니라 AuthServer 로그**를
    본다. 거기에는 아이디가 없었는지 · 이메일이 달랐는지 · 계정에 이메일이
    아예 없었는지 · 발송이 실패했는지가 남는다.
*@

@inherits DataPage
@inject AccountClient Accounts

<PageTitle>비밀번호 찾기 · JSini 포털</PageTitle>

<div class="jsini-login__card">
    <h1 class="jsini-login__title">비밀번호 찾기</h1>

    <PageNotice Text="@Notice" Tone="@Tone" />

    @if (_sent)
    {
        @* 보낸 뒤에는 폼을 치운다. 같은 값으로 또 누르면 앞서 보낸 링크가
           죽고 새 링크가 가는데(서버가 그렇게 한다), 그 사이 먼저 온 메일을
           연 사람은 「방금 받은 링크가 안 먹는다」를 겪는다. *@
        <p class="jsini-hint">
            메일이 오지 않으면 스팸함을 확인해 주십시오. 계정에 등록된 이메일이
            없거나 다르면 메일이 가지 않습니다 — 그럴 때는 관리자에게 문의해 주십시오.
        </p>

        <a class="jsini-password__back" href="/login">로그인 화면으로</a>
    }
    else
    {
        <p class="jsini-hint">
            아이디와 계정에 등록된 이메일을 넣으시면, 비밀번호를 다시 정할 수
            있는 링크를 메일로 보내 드립니다.
        </p>

        <label class="jsini-login__label" for="forgot-id">아이디</label>
        <input id="forgot-id" class="jsini-login__input"
               autocomplete="username" @bind="_loginId" />

        <label class="jsini-login__label" for="forgot-email">이메일</label>
        <input id="forgot-email" type="email" class="jsini-login__input"
               autocomplete="email" @bind="_email" />

        <button type="button" class="jsini-login__submit"
                disabled="@Loading" @onclick="@SubmitAsync">
            링크 받기
        </button>

        <a class="jsini-password__back" href="/login">로그인 화면으로</a>
    }
</div>

@code {
    private string? _loginId;
    private string? _email;

    /// <summary>보냈는가. 참이면 폼 대신 안내만 보인다.</summary>
    private bool _sent;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_loginId) || string.IsNullOrWhiteSpace(_email))
        {
            Say("아이디와 이메일을 모두 넣으십시오.", NoticeTone.Warning);
            return;
        }

        // 서버가 언제나 성공으로 답하므로 이 문구는 사실상 늘 나온다.
        // 실패 문구는 게이트웨이에 닿지 못했을 때(서버가 꺼져 있음)만 나온다.
        _sent = await RunAsync(
            () => Accounts.RequestPasswordResetAsync(_loginId!.Trim(), _email!.Trim()),
            "입력하신 정보와 맞는 계정이 있으면 안내 메일을 보냈습니다.",
            "요청을 보내지 못했습니다");
    }
}
