@page "/password/forgot"
@attribute [ScreenAccess(ScreenAccessKind.Open, Reason = "비밀번호 찾기다. 로그인 전에 연다.")]
@layout BareLayout
@attribute [AllowAnonymous]

@*
    비밀번호 찾기. 로그인 화면의 「비밀번호를 잊으셨나요?」가 여기로 온다. 아이디와 이메일을 둘 다 받는다(계정을 둘 가질 수 있고, 두 값을 알아야 메일이 나가 남의 계정으로 메일을 보낼 수 없다).
    무엇을 넣든 같은 답을 보인다. 「그런 아이디가 없다」를 보이면 아이디 확인 도구가 된다. 「메일이 안 온다」는 문의는 AuthServer 로그에서 원인을 본다.
    안내는 토스트가 아니라 PageNotice 로 그린다(BareLayout 에는 토스트 판이 없다). 안내는 읽고 자리를 뜰 때까지 남아야 한다.
*@

<PageTitle>비밀번호 찾기 · JSini 포털</PageTitle>

<AuthShell Title="비밀번호 찾기"
           Sub="@(_sent ? "메일함을 확인해 주십시오." : "계정에 등록된 이메일로 링크를 보내 드립니다.")"
           Lead="비밀번호를 잊으셨어도 메일함만 여실 수 있으면 됩니다.">

    @if (_sent)
    {
        @* 보낸 뒤에는 폼을 치운다. 같은 값으로 또 누르면 앞서 보낸 링크가 죽으므로, 먼저 온 메일을 연 사람이 링크가 안 먹는 것을 겪는다. *@
        <PageNotice Text="입력하신 정보와 맞는 계정이 있으면 안내 메일을 보냈습니다." />

        <ol class="jsini-steps">
            <li>메일함에서 <strong>[JSini 포털] 비밀번호 다시 정하기</strong> 를 찾습니다.</li>
            <li>메일 안의 <strong>비밀번호 다시 정하기</strong> 단추를 누릅니다.</li>
            <li>열린 화면에서 새 비밀번호를 정합니다.</li>
        </ol>

        <p class="jsini-hint">
            메일이 오지 않으면 스팸함을 확인해 주십시오. 계정에 등록된 이메일이
            없거나 다르면 메일이 가지 않습니다 — 그럴 때는 관리자에게 문의해 주십시오.
        </p>

        <a class="jsini-login__submit jsini-password__go" href="/login">로그인 화면으로</a>
    }
    else
    {
        <PageNotice Text="@_notice" Tone="@_tone" />

        @* 엔터로 넘어가게 폼으로 감싼다. 회로가 붙기 전에는 단추를 잠근다(잠그지 않으면 브라우저가 GET 으로 제출한다). *@
        <form @onsubmit="@SubmitAsync" @onsubmit:preventDefault>
            <div class="jsini-login__field">
                <label class="jsini-login__label" for="forgot-id">아이디</label>
                <input id="forgot-id" class="jsini-login__input"
                       autocomplete="username" @bind="_loginId" />
            </div>

            <div class="jsini-login__field">
                <label class="jsini-login__label" for="forgot-email">이메일</label>
                <input id="forgot-email" type="email" class="jsini-login__input"
                       autocomplete="email" @bind="_email" />
                <p class="jsini-hint">계정에 등록된 이메일이어야 메일이 갑니다.</p>
            </div>

            <button type="submit" class="jsini-login__submit" disabled="@Blocked">
                @(_busy ? "보내는 중…" : "링크 받기")
            </button>
        </form>

        <a class="jsini-password__back" href="/login">로그인 화면으로</a>
    }
</AuthShell>
