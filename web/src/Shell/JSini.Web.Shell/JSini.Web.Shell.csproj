<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    포털 셸. 사용자는 모두 여기로 들어온다.

    [셸이 하는 일은 넷뿐이다]
      · 로그인·로그아웃 (인증 쿠키를 굽는 유일한 곳)
      · 업무 경로를 MFE 로 넘기기 (YARP)
      · 첫 화면과 오류 화면
      · 진단 (어느 MFE 가 붙어 있나)

    [셸이 하지 않는 일]
      업무 화면을 그리지 않는다. 업무 API 를 부르지 않는다.
      업무 앱을 참조하지 않는다 — 애초에 별도 프로세스라 참조할 수도 없고,
      목록은 설정(PortalApps)에서 읽는다.

    레이아웃·권한·메뉴는 JSini.Web.Components(Blazor Common)에 있다.
    셸과 업무 앱 일곱이 같은 껍데기를 그려야 하기 때문이다.
  -->

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>jsini-web-shell</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\JSini.Web.Abstractions\JSini.Web.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Components\JSini.Web.Components.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Http\JSini.Web.Http.csproj" />
    <ProjectReference Include="..\..\Shared\JSini.Web.Models\JSini.Web.Models.csproj" />
  </ItemGroup>

</Project>
