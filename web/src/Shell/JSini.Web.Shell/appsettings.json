{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 프록시가 어디로 넘겼는지 보이지 않으면 404 의 원인을 좇을 수 없다.
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  // 게이트웨이 주소. 셸은 로그인과 메뉴·권한만 부른다 —
  // 업무 API 는 각 MFE 가 직접 부른다.
  "Gateway": {
    "BaseUrl": "http://localhost:5265/api/"
  },

  // 인증 쿠키를 일곱 앱이 함께 풀려면 키 링을 공유해야 한다.
  // 운영(docker compose)에서는 같은 볼륨을 일곱 컨테이너에 마운트한다.
  "DataProtection": {
    "KeyRingPath": "../../../.keys"
  },

  // 업무 MFE 목록. 셸이 이 표로 YARP 라우트와 클러스터를 함께 만든다
  // (PortalProxy.cs) — 두 곳에 적으면 하나를 고치고 다른 하나를 잊는다.
  //
  // RoutePrefix 는 각 앱의 IPortalModule.RoutePrefix 와 **같아야 한다.**
  // 어긋나면 셸은 넘기는데 앱이 자기 경로가 아니라며 404 를 낸다.
  // 아키텍처 테스트가 이 대조를 한다.
  "PortalApps": [
    { "Key": "funeral",  "DisplayName": "장례식장",     "RoutePrefix": "/funeral",  "Address": "http://localhost:5561/" },
    { "Key": "helpdesk", "DisplayName": "헬프데스크",   "RoutePrefix": "/helpdesk", "Address": "http://localhost:5562/" },
    { "Key": "admin",    "DisplayName": "포털관리",     "RoutePrefix": "/admin",    "Address": "http://localhost:5563/" },
    { "Key": "site",     "DisplayName": "소개사이트·AI", "RoutePrefix": "/site",     "Address": "http://localhost:5564/" },
    { "Key": "life",     "DisplayName": "생활과환경",   "RoutePrefix": "/life",     "Address": "http://localhost:5565/" },
    { "Key": "projmng",  "DisplayName": "프로젝트관리", "RoutePrefix": "/projmng",  "Address": "http://localhost:5566/" }
  ]
}
