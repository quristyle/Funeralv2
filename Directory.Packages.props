<Project>

  <!--
    NuGet 중앙 패키지 관리(CPM).

    패키지 버전은 여기서만 정한다. 각 csproj 의 PackageReference 에는 Version 을 적지 않는다.
    이렇게 모으기 전에는 같은 패키지가 서비스마다 다른 버전이었다 — JwtBearer 만 해도
    8.0.0 / 8.0.11 / 8.0.13 / 8.0.20 네 가지가 돌아다녔다. 서비스가 열 개가 넘는데
    버전을 각자 들고 있으면 올릴 때 반드시 하나를 빠뜨린다.

    전이 의존성까지 고정하지는 않는다(CentralPackageTransitivePinningEnabled 기본값 false).
    켜면 패키지가 스스로 정한 하위 의존성까지 이 목록이 덮어써서, 여기 없는 조합이 생긴다.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- ── ASP.NET Core / EF Core : 런타임 버전에 묶인 것들 ──────────────
         프레임워크를 올릴 때 이 묶음도 같은 메이저로 함께 올려야 한다. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- EF 두 개는 항상 같은 버전으로 맞춘다. Npgsql 제공자는 자기보다 낮은 EF 를
         거부하므로, EF 쪽이 낮으면 NU1605(다운그레이드) 로 빌드가 막힌다.
         Npgsql 제공자는 EF 본체와 패치 번호가 따로 논다(10.0.3 vs 10.0.11). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- ── 데이터 접근 ─────────────────────────────────────────────
         ProjMngServer 만 EF 를 쓰지 않는다. Dapper + 생 Npgsql 로 PostgreSQL 과
         SQL Server 양쪽에 붙는 이식 코드다. -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />

    <!-- ── 로깅 · 콘솔 ───────────────────────────────────────────── -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />

    <!-- ── API 문서 ──────────────────────────────────────────────
         Swashbuckle 6.x 는 ASP.NET Core 9 이후와 맞지 않는다. .NET 10 대응은 10.x 다. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- ── 게이트웨이 ───────────────────────────────────────────── -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- ── 메시징 · 알림 ─────────────────────────────────────────
         7.x 에서 동기 API 가 전부 사라졌다. IModel → IChannel 이 되고 CreateConnection ·
         CreateModel · QueueDeclare · BasicPublish 가 모두 async 판으로 바뀌었으며,
         ConnectionFactory.DispatchConsumersAsync 는 없어졌다(항상 async 다).
         고친 곳: AuthServer/ReleaseService, HelpDeskServer/Program · EMailUtil,
                  NotificationServer/EmailQueueSender -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <!--
      WebPush 이 Newtonsoft.Json 10.0.3 을 끌고 온다. 그 버전에는 높음 심각도 취약점이
      있다(GHSA-5crp-9r3c-p9vr, NU1903). WebPush 최신인 1.0.13 도 여전히 그 버전을
      요구하므로, 여기서 13.0.4 를 직접 참조해 전이 의존성을 덮어쓴다.
      WebPush 를 쓰는 HelpDeskServer · NotificationServer 두 곳에만 건다.
    -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- ── 그 밖 ────────────────────────────────────────────────
      ImageSharp 은 FileServer 2.1.9 · HelpDeskServer 3.1.12 로 갈려 있었다.
      2.1.9 에 높음 심각도 취약점이 있어(GHSA-2cmq-823j-5qj8) 그대로 둘 수 없었고,
      4.1.1 로 합쳤다.

      ※ 라이선스 확인 필요: 3.x 부터 Apache 2.0 이 아니라 Six Labors Split License 다.
        회사 매출 규모에 따라 상용 라이선스가 필요할 수 있다. 취약점 때문에 2.x 에
        머무를 수는 없으므로 올렸지만, 라이선스 조건은 별도로 검토해야 한다.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.1" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <!-- System.Net.Http.Json 은 net10.0 프레임워크에 들어 있어 참조하지 않는다(NU1510). -->
  </ItemGroup>

</Project>
