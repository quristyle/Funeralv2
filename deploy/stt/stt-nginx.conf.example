# 받아쓰기 서버로 가는 nginx 자리 — 장비의 `/etc/nginx/sites-available/lmstudio`
# 안, 추론(`/v1/`)·임베딩(`/embed/`) 과 같은 server 블록에 **덧붙인다.**
#
# **정본이 아니라 본보기다.** 그 파일에는 Bearer 토큰이 평문으로 들어 있어
# 저장소에 두지 않는다(deploy/llm/README.md 와 같은 까닭). 여기 있는 것은
# 붙일 자리의 모양뿐이다.

location /stt/ {
    # 추론·임베딩과 **같은 토큰**으로 가른다. 받아쓰기만 다른 키를 쓰면
    # AIAgentServer 가 설정을 둘 들고 있어야 하고, 그 둘이 어긋나는 날이 온다.
    if ($http_authorization != "Bearer <추론과 같은 토큰>") {
        return 401;
    }

    proxy_pass http://127.0.0.1:11437/;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # **소리를 통째로 모았다가 보내지 않는다.** 기본값이면 nginx 가 본문을
    # 디스크에 떨어뜨렸다가 넘기는데, 받아쓰기는 그 한 번의 왕복이 곧
    # 사람이 기다리는 시간이다.
    proxy_request_buffering off;

    # 한 마디는 수십 KB 지만 2분짜리 녹음도 받는다. AIAgentServer 쪽
    # 상한(SpeechClient.MaxBytes)이 10MB 라 그것에 맞춘다.
    client_max_body_size 10m;

    # CPU 로 돌 때 긴 녹음은 오래 걸린다. AIAgentServer 가 3분에서 끊으므로
    # 여기는 그보다 넉넉해야 한다 — 여기가 먼저 끊으면 504 가 되고,
    # 화면에는 까닭을 알 수 없는 오류만 뜬다.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
