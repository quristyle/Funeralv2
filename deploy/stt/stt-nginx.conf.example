# 받아쓰기 서버로 가는 nginx 자리 — 장비의 `/etc/nginx/sites-available/lmstudio`
# 안, 추론(`/`)·임베딩(`/embed/`)·자동완성(`/fim/`) 과 같은 server 블록에 덧붙인다.
#
# **정본이 아니라 본보기다.** 그 파일에는 Bearer 토큰이 평문으로 들어 있어
# 저장소에 두지 않는다(deploy/llm/README.md 와 같은 까닭). 여기 있는 것은
# 붙일 자리의 모양뿐이다.
#
# [반드시 `location /` 보다 **앞에** 둔다]
#
# 그 블록이 나머지를 전부 llama-server(11433)로 넘긴다. 뒤에 두면 받아쓰기
# 요청이 추론 서버로 가고, 거기서 **llama.cpp 모양의 404**가 돌아온다 —
# `{"error":{"message":"File Not Found","type":"not_found_error","code":404}}`.
# 이 404 를 보면 자리를 안 냈거나 차례가 뒤집힌 것이다.

location /stt/ {
    # **토큰은 `if` 로 직접 비교하지 않는다.** 그 파일은 맨 위의
    # `map $http_authorization $llm_client` 하나로 가르고 있고, 블록마다
    # 토큰 글자를 다시 적으면 키를 바꾸는 날 **고친 자리와 안 고친 자리**가
    # 생긴다. 같은 관용을 그대로 쓴다.
    if ($llm_client = "") {
        return 401 '{"error":"Unauthorized"}';
    }

    proxy_pass http://127.0.0.1:11437/;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;

    # **소리를 통째로 모았다가 보내지 않는다.** 기본값이면 nginx 가 본문을
    # 디스크에 떨어뜨렸다가 넘기는데, 받아쓰기는 그 한 번의 왕복이 곧
    # 사람이 기다리는 시간이다.
    proxy_request_buffering off;
    proxy_buffering off;

    # 한 마디는 수십 KB 지만 2분짜리 녹음도 받는다. AIAgentServer 쪽
    # 상한(SpeechClient.MaxBytes)이 10MB 라 그것에 맞춘다.
    client_max_body_size 10m;

    # CPU 로 돌 때 긴 녹음은 오래 걸린다. AIAgentServer 가 3분에서 끊으므로
    # 여기는 그보다 넉넉해야 한다 — 여기가 먼저 끊으면 504 가 되고,
    # 화면에는 까닭을 알 수 없는 오류만 뜬다.
    proxy_connect_timeout 60;
    proxy_send_timeout    300;
    proxy_read_timeout    300;
}
