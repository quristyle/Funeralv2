# ============================================================
# 프로젝트관리 DB 이관 — 접속 정보 (템플릿)
# ============================================================
#
# 쓰는 법
#   cp scripts/projmng-db-migration/dsn.env.example scripts/projmng-db-migration/dsn.env
#   아래 값을 채운다
#
# dsn.env 는 .gitignore 대상이라 저장소에 올라가지 않는다.
# 환경변수로 준 값이 이 파일보다 우선한다.

# ── ASIS (원본) ─────────────────────────────────────────────
# 이 스크립트들은 ASIS 를 read-only 트랜잭션으로만 연다.
# 서버가 쓰기를 거부하므로 실수로도 원본이 바뀌지 않는다.
PROJMNG_ASIS_HOST=jsini.co.kr
PROJMNG_ASIS_PORT=15432
PROJMNG_ASIS_DB=jsini
PROJMNG_ASIS_USER=
PROJMNG_ASIS_PASSWORD=

# ── TOBE (대상) ─────────────────────────────────────────────
PROJMNG_TOBE_HOST=jin114.co.kr
PROJMNG_TOBE_PORT=31015
PROJMNG_TOBE_DB=projmng
PROJMNG_TOBE_USER=
PROJMNG_TOBE_PASSWORD=
