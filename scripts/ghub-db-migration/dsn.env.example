# ============================================================
# GHUB(생활과환경) DB 이관 — 접속 정보 (템플릿)
# ============================================================
#
# 쓰는 법
#   cp scripts/ghub-db-migration/dsn.env.example scripts/ghub-db-migration/dsn.env
#   아래 값을 채운다
#
# dsn.env 는 .gitignore 대상이라 저장소에 올라가지 않는다.
# 환경변수로 준 값이 이 파일보다 우선한다.

# ── ASIS (원본, SK가스 지허브) ──────────────────────────────
# migrate.py 는 ASIS 를 read-only 세션으로만 연다.
# 서버가 쓰기를 거부하므로 실수로도 원본이 바뀌지 않는다.
GHUB_ASIS_HOST=jin114.co.kr
GHUB_ASIS_PORT=45750
GHUB_ASIS_DB=ghub
GHUB_ASIS_USER=
GHUB_ASIS_PASSWORD=

# ── TOBE (대상, 포털 DB 인스턴스의 ghub DB) ─────────────────
GHUB_TOBE_HOST=jin114.co.kr
GHUB_TOBE_PORT=31015
GHUB_TOBE_DB=ghub
GHUB_TOBE_USER=
GHUB_TOBE_PASSWORD=
