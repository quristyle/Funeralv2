<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiTaskRunner</RootNamespace>
    <!-- 공유 프로젝트를 하나도 참조하지 않는다. **이 프로그램은 장비에서 돌고
         서버와는 HTTP 로만 말한다** — 참조를 붙이면 서버를 고칠 때마다 장비의
         것도 함께 배포해야 한다. 오가는 약속은 JSON 한 벌뿐이다. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- **장비마다 다른 설정이 말려 올라가지 않게 한다.** 이 프로그램은
         개발 장비에서 self-contained 로 말아 운영에 통째로 rsync 한다
         (deploy/ai-runner/README.md). 기본 규칙대로 두면 publish 산출물에
         개발 장비의 appsettings.Local.json 이 함께 실려 가서, **운영의 장비
         토큰과 작업공간 경로를 개발 장비 것으로 덮어쓴다** — 실행기가 제
         이름을 quri-dev 로 말하기 시작하고 집어가기가 거절된다.
         bin 에는 그대로 둔다(개발 장비에서 빌드한 것을 바로 돌릴 수 있게). -->
    <Content Update="appsettings.Local.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
