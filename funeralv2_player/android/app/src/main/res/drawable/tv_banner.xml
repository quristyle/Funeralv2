<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV 런처에 뜨는 배너 (권장 320x180).

    TV 런처는 아이콘이 아니라 이 배너를 쓴다. 없으면 앱 이름만 있는 빈 칸으로 보인다.
    이미지 파일을 새로 만들지 않고, 이미 있는 런처 아이콘을 어두운 배경 가운데에
    올려 배너 모양으로 조립한다 — XML 이라 해상도에 맞춰 그려진다.

    디자인이 정해지면 320x180 PNG 를 drawable-xhdpi/tv_banner.png 로 넣으면
    이 파일보다 그쪽이 쓰인다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 앱의 다크 테마와 맞춘 배경 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111214"/>
        </shape>
    </item>

    <!-- 가운데에 런처 아이콘 -->
    <item
        android:gravity="center"
        android:width="72dp"
        android:height="72dp">
        <bitmap android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
